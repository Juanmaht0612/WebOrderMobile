52511>>>    // This can be used to show and hide buttons based on context.
52511>>>    // This can be called any time the view is active.
52511>>>    Procedure SetActionButtons
52514>>>        tWebNavigateData NavigateData
52514>>>        tWebNavigateData NavigateData
52514>>>        Boolean bHasRecord
52514>>>        Handle hoDD
52514>>>
52514>>>        Get Server to hoDD
52515>>>        Get GetNavigateData to NavigateData
52516>>>        
52516>>>        If (hoDD) Begin
52518>>>            Get HasRecord of hoDD to bHasRecord
52519>>>        End
52519>>>>
52519>>>        Else Begin
52520>>>            Move False to bHasRecord
52521>>>        End
52521>>>>
52521>>>
52521>>>        // let's hide all buttons and then show the ones we want
52521>>>        WebSet pbRender of oEditBtn to False 
52522>>>        WebSet pbRender of oSaveBtn to False
52523>>>        WebSet pbRender of oCancelChangesBtn to False
52524>>>        WebSet pbRender of oDeleteBtn to False
52525>>>
52525>>>        If (NavigateData.bReadOnly) Begin 
52527>>>            WebSet pbRender of oEditBtn to True 
52528>>>        End
52528>>>>
52528>>>        Else Begin
52529>>>            WebSet pbRender of oSaveBtn to True
52530>>>            WebSet pbRender of oCancelChangesBtn to True
52531>>>            WebSet pbRender of oDeleteBtn to bHasRecord
52532>>>        End
52532>>>>
52532>>>    End_Procedure
52533>>>
52533>>>    // this will close the view after a save
52533>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
52536>>>        Send NavigateClose Self
52537>>>    End_Procedure
52538>>>
52538>>>    // this will close the view after a delete
52538>>>    Procedure OnViewDeleted Handle hoDDO
52541>>>        Send NavigateClose Self
52542>>>    End_Procedure
52543>>>
52543>>>    // Add code to customize your Zoom View based on how it was invoked.
52543>>>    // Use NavigateData to determine the context this view will be used in.
52543>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
52546>>>
52546>>>        // if this view is being used in multiple contexts, you may need a block of code
52546>>>        // like this to handle customizations. This would include hiding rows and buttons
52546>>>        // (WebSet pbRender) and changing the values of various captions.
52546>>>        Case Begin
52546>>>            Case (NavigateData.eNavigateType = nfFromMain)
52548>>>                // If from main, this is a probably a main file Select to Zoom.
52548>>>                // This is the most typical way to navigate to a zoom.
52548>>>                Case Break
52549>>>                
52549>>>            Case (NavigateData.eNavigateType = nfFromParent)
52552>>>                // If from parent, this is a constrained drill down.
52552>>>                // If needed, you could check NavigateData.iTable to determine the constraining parent.
52552>>>                // This would be unusual - normally you drill down from a parent to a list (Select view).
52552>>>                Case Break
52553>>>                
52553>>>            Case (NavigateData.eNavigateType = nfFromChild)
52556>>>                // If from child, this is a probably a parent Zoom from a Zoom. 
52556>>>                // This is unusual, but it might be used for adding a new child record.
52556>>>                Case Break
52557>>>                
52557>>>            Case Else // must be nfUndefined
52557>>>                // This may be the start of a query or this may be used for some kind of custom operation.
52557>>>                // You may want to check NavigateData.NamedValues.
52557>>>                  
52557>>>        Case End
52557>>>
52557>>>        // Action buttons can be changed dynamically during a Zoom's display lifetime.
52557>>>        // It's best to set these buttons in their own procedure so you can change later.
52557>>>        Send SetActionButtons
52558>>>
52558>>>    End_Procedure
52559>>>
52559>>>End_Object
