29347>>>>>>>        Handle hoJson
29347>>>>>>>        UChar[] ucData
29348>>>>>>>        
29348>>>>>>>        //  Set headers & status
29348>>>>>>>        Send SetResponseStatus usStatusCode sReason sDescription
29349>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29350>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29351>>>>>>>        
29351>>>>>>>        //  Generate JSON response header
29351>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
29352>>>>>>>        Send InitializeJsonType of hoJson jsonTypeObject
29353>>>>>>>        
29353>>>>>>>        Send SetMemberValue of hoJson "errorCode" jsonTypeString "soap:Server"
