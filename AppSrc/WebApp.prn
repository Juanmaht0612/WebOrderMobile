50979>>>    // This can be used to show and hide buttons based on context. This can be called
50979>>>    // any time the view is active.
50979>>>    Procedure SetActionButtons
50982>>>        tWebNavigateData NavigateData
50982>>>        tWebNavigateData NavigateData
50982>>>        Boolean bHasRecord
50982>>>        Handle hoDD
50982>>>        
50982>>>        Get Server to hoDD
50983>>>        Get GetNavigateData to NavigateData
50984>>>        
50984>>>        If (hoDD) Begin
50986>>>            Get HasRecord of hoDD to bHasRecord
50987>>>        End
50987>>>>
50987>>>        Else Begin
50988>>>            Move False to bHasRecord
50989>>>        End
50989>>>>
50989>>>        
50989>>>        // let's hide all buttons and then show the ones we want
50989>>>        WebSet pbRender of oEditBtn to False
50990>>>        WebSet pbRender of oSaveBtn to False
50991>>>        WebSet pbRender of oCancelChangesBtn to False
50992>>>        WebSet pbRender of oDeleteBtn to False
50993>>>        
50993>>>        If (NavigateData.bReadOnly) Begin
50995>>>            WebSet pbRender of oEditBtn to True
50996>>>        End
50996>>>>
50996>>>        Else Begin
50997>>>            WebSet pbRender of oSaveBtn to True
50998>>>            WebSet pbRender of oCancelChangesBtn to True
50999>>>            WebSet pbRender of oDeleteBtn to bHasRecord
51000>>>        End
51000>>>>
51000>>>    End_Procedure
51001>>>    
51001>>>    // this will close the view after a save
51001>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
