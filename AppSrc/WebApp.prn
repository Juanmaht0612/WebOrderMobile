37148>>>>>>>    // Serializes the container to a tWebValueTree.
37148>>>>>>>    Function SerializeContainer Returns Handle
37150>>>>>>>        Integer iIndex icObjects iObject icBuffers iBuffer iSize
37150>>>>>>>        String sDynamicObjectId
37150>>>>>>>        Handle hoObj
37150>>>>>>>        tWebDynamicObject tDynamicObject
37150>>>>>>>        tWebDynamicObject tDynamicObject
37150>>>>>>>        tWebDynamicObject[] aDynamicObjects
37150>>>>>>>        tWebDynamicObject[] aDynamicObjects
37151>>>>>>>        String[] aObjectList
37152>>>>>>>        
37152>>>>>>>        Handle[] aClasses
37153>>>>>>>        Handle hjWrapper hjClasses hjObjects hjObjectDef
37153>>>>>>>        
37153>>>>>>>        
37153>>>>>>>        Get Create (RefClass(cJsonObject)) to hjWrapper
37154>>>>>>>        Get Create (RefClass(cJsonObject)) to hjClasses
37155>>>>>>>        Get Create (RefClass(cJsonObject)) to hjObjects
37156>>>>>>>        Send InitializeJsonType of hjWrapper jsonTypeObject
37157>>>>>>>        Send InitializeJsonType of hjClasses jsonTypeArray
37158>>>>>>>        Send InitializeJsonType of hjObjects jsonTypeArray
37159>>>>>>>        
37159>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37160>>>>>>>        
37160>>>>>>>        Move "" to tDynamicObject.sId
37161>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
37162>>>>>>>        If (iIndex <> -1) Begin
37164>>>>>>>            Move aDynamicObjects[iIndex].aChildren to aObjectList
37165>>>>>>>            
37165>>>>>>>            Move (SizeOfArray(aObjectList)) to icObjects
37166>>>>>>>            For iObject from 0 to (icObjects - 1)
37172>>>>>>>>
37172>>>>>>>                Get DynamicObject aObjectList[iObject] to hoObj
37173>>>>>>>                Get DoSerializeObject of hoObj hjClasses (&aClasses) to hjObjectDef 
37174>>>>>>>                Send AddMember of hjObjects hjObjectDef
37175>>>>>>>                Send Destroy of hjObjectDef
37176>>>>>>>            Loop
37177>>>>>>>>
37177>>>>>>>        End
37177>>>>>>>>
37177>>>>>>>        
37177>>>>>>>        Send SetMember of hjWrapper "aClasses" hjClasses
37178>>>>>>>        Send SetMember of hjWrapper "aObjects" hjObjects
37179>>>>>>>        Send Destroy of hjClasses
37180>>>>>>>        Send Destroy of hjObjects
37181>>>>>>>        
37181>>>>>>>        Function_Return hjWrapper
37182>>>>>>>    End_Function
37183>>>>>>>    
37183>>>>>>>    
