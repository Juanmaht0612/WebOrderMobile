34061>>>>>>>                Move (Character(13)+Character(10)) to sCRLF
34062>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound + " Set psLoadViewOnClick to '" + sViewName + "'" + sCRLF + sCRLF + "A reference to this object cannot be located. Check that the object name is correct.",sViewName)) 
34063>>>>>>>>
34063>>>>>>>            End
34063>>>>>>>>
34063>>>>>>>        End
