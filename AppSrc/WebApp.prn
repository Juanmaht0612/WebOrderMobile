22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>// Sync Props Arrays
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>Global_Variable tWebSyncProps[][] gaSyncProps   // This is the main web properties buffer.
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>// gaSyncChangedProps: Changed properties. There is an array member for each object in 
22204>>>>>>>>>>>>>>>// gaSyncProps. If an Object has changed properties then the pbChanged flag is Set to True.
22204>>>>>>>>>>>>>>>Global_Variable tWebChangedProps[][] gaSyncChangedProps
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>// gaSyncObjectHandles: This stores the object handle for each member of gaSyncProps. Used as an index
22204>>>>>>>>>>>>>>>// to gaSyncProps (and gaSyncChangedProps). C_WebUnresolvedObject is stored for an unresolved object handle.
22204>>>>>>>>>>>>>>>Global_Variable Handle[][] gaSyncObjectHandles
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>// gaAdvSyncProps: This is the buffer for advanced web properties.
22204>>>>>>>>>>>>>>>Global_Variable tWebCacheAdvProp[][] gaAdvSyncProps
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>// The basic web property handler implementation that has logic for storing and maintaining web 
22204>>>>>>>>>>>>>>>// properties in set of global variables. The global variables are used as an optimization as 
22204>>>>>>>>>>>>>>>// storing structs in web properties is inefficient in memory management. The subclasses 
22204>>>>>>>>>>>>>>>// (cWebServerPropHandler and cWebClientPropHandler) will actually store and load the web properties.
22204>>>>>>>>>>>>>>>
22204>>>>>>>>>>>>>>>Class cWebBasePropHandler is a cObject
22205>>>>>>>>>>>>>>>    
22205>>>>>>>>>>>>>>>    Procedure Construct_Object
22207>>>>>>>>>>>>>>>        Integer iIndex
22207>>>>>>>>>>>>>>>        
22207>>>>>>>>>>>>>>>        Forward Send Construct_Object
22209>>>>>>>>>>>>>>>        
22209>>>>>>>>>>>>>>>        //  Reserve index in global stores
22209>>>>>>>>>>>>>>>        Move (SizeOfArray(gaSyncProps)) to iIndex
22210>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncProps, iIndex + 1)) to gaSyncProps
22211>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps, iIndex + 1)) to gaSyncChangedProps
22212>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles, iIndex + 1)) to gaSyncObjectHandles
22213>>>>>>>>>>>>>>>        Move (ResizeArray(gaAdvSyncProps, iIndex + 1)) to gaAdvSyncProps
22214>>>>>>>>>>>>>>>        Property Integer piStoreIndex iIndex
22215>>>>>>>>>>>>>>>        
22215>>>>>>>>>>>>>>>        Property Boolean pbErrorObjNotFound True
22216>>>>>>>>>>>>>>>        
22216>>>>>>>>>>>>>>>        // Sync Props Arrays - Allocation Optimization Properties
22216>>>>>>>>>>>>>>>        // In order to optimize web properties we allocate in advance empty array 
22216>>>>>>>>>>>>>>>        // slots in gaSyncProps, gaSyncChangedProps and gaSyncObjectHandles.
22216>>>>>>>>>>>>>>>        
22216>>>>>>>>>>>>>>>        // piSize: This is a pointer to the last object in the gaSyncObjectHandles, gaSyncProps
22216>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. When this value equals the size of the arrays then more space
22216>>>>>>>>>>>>>>>        // is allocated in these arrays.
22216>>>>>>>>>>>>>>>        Property Integer piSize 0
22217>>>>>>>>>>>>>>>        
22217>>>>>>>>>>>>>>>        // piCapacity: This is the actual size of the gaSyncObjectHandles, gaSyncProps and gaSyncChangedProps
22217>>>>>>>>>>>>>>>        // arrays. When piObjectCount equals this value, more space is allocated in these arrays.
22217>>>>>>>>>>>>>>>        Property Integer piCapacity 0
22218>>>>>>>>>>>>>>>        
22218>>>>>>>>>>>>>>>        // piGrowthFactor: This is the size of the next jump in size of the gaSyncObjectHandles, gaSyncProps
22218>>>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. This value is used to double the size increase each time more space
22218>>>>>>>>>>>>>>>        // is allocated in the arrays.
22218>>>>>>>>>>>>>>>        Property Integer piGrowthFactor 0
22219>>>>>>>>>>>>>>>        
22219>>>>>>>>>>>>>>>        // pbActive: When False, all calls to get or set a web property are ignored.
22219>>>>>>>>>>>>>>>        // This ensures that web properties are only accessed during an AJAX call.
22219>>>>>>>>>>>>>>>        // Otherwise, attempting to access web properties outside an AJAX call can 
22219>>>>>>>>>>>>>>>        // corrupt the web properties system.
22219>>>>>>>>>>>>>>>        Property Boolean pbActive False
22220>>>>>>>>>>>>>>>        
22220>>>>>>>>>>>>>>>        Property Handle phoWebControlLocator 0
22221>>>>>>>>>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject
22222>>>>>>>>>>>>>>>    End_Procedure
22223>>>>>>>>>>>>>>>    
22223>>>>>>>>>>>>>>>    
22223>>>>>>>>>>>>>>>    //
22223>>>>>>>>>>>>>>>    // Adds the passed object to the global web properties arrays. It is assumed that the object is a cWebObject.
22223>>>>>>>>>>>>>>>    //
22223>>>>>>>>>>>>>>>    // Returns:
22223>>>>>>>>>>>>>>>    //      The object's index to the global sync props array.
22223>>>>>>>>>>>>>>>    Function AddObjectToSyncProps Handle hoObject Returns Integer
22225>>>>>>>>>>>>>>>        String sObjectName
22225>>>>>>>>>>>>>>>        Integer iStoreIndex iSize iCapacity iGrowthFactor iObjectIndex
22225>>>>>>>>>>>>>>>        
22225>>>>>>>>>>>>>>>        Move -1 to iObjectIndex
22226>>>>>>>>>>>>>>>        
22226>>>>>>>>>>>>>>>        If (hoObject > 0) Begin
22228>>>>>>>>>>>>>>>            Get piStoreIndex to iStoreIndex
22229>>>>>>>>>>>>>>>            Get piSize to iSize
22230>>>>>>>>>>>>>>>            Get piCapacity to iCapacity
22231>>>>>>>>>>>>>>>            Get piGrowthFactor to iGrowthFactor
22232>>>>>>>>>>>>>>>            Get WebObjectName of hoObject to sObjectName
22233>>>>>>>>>>>>>>>            
22233>>>>>>>>>>>>>>>            // Determine if we need to increase the array sizes....
22233>>>>>>>>>>>>>>>            If (iSize = iCapacity) Begin
22235>>>>>>>>>>>>>>>                Move (iGrowthFactor + iGrowthFactor) to iGrowthFactor    // double the growth factor
22236>>>>>>>>>>>>>>>                Move (iCapacity + iGrowthFactor) to iCapacity            // increase the capacity
22237>>>>>>>>>>>>>>>    
22237>>>>>>>>>>>>>>>                Set piCapacity to iCapacity
22238>>>>>>>>>>>>>>>                Set piGrowthFactor to iGrowthFactor
22239>>>>>>>>>>>>>>>                
22239>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iCapacity)) to gaSyncProps[iStoreIndex]
22240>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]
22241>>>>>>>>>>>>>>>                Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]
22242>>>>>>>>>>>>>>>            End
22242>>>>>>>>>>>>>>>>
22242>>>>>>>>>>>>>>>            
22242>>>>>>>>>>>>>>>            // Add the passed object to gaSyncObjectHandles....
22242>>>>>>>>>>>>>>>            Set piSize       to (iSize + 1)
22243>>>>>>>>>>>>>>>            Move iSize       to iObjectIndex
22244>>>>>>>>>>>>>>>            Move hoObject    to gaSyncObjectHandles[iStoreIndex][iObjectIndex]
22245>>>>>>>>>>>>>>>            Move False       to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges    // False so far because we did not find the property yet
22246>>>>>>>>>>>>>>>            Move sObjectName to gaSyncProps[iStoreIndex][iObjectIndex].sO
22247>>>>>>>>>>>>>>>        End
22247>>>>>>>>>>>>>>>>
22247>>>>>>>>>>>>>>>        
22247>>>>>>>>>>>>>>>        Function_Return iObjectIndex
22248>>>>>>>>>>>>>>>    End_Function
