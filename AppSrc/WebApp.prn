46074>>>>>>>>>    Function TransitionDateTimeForYear tWinSystemTime TransitionTimeIn Integer iYear Returns String
46076>>>>>>>>>        Date dtFindDay
46076>>>>>>>>>        Integer iOccurance iDecimalSeparator
46076>>>>>>>>>        String sFormattedTime sFormattedDate
46076>>>>>>>>>        Boolean bStop
46076>>>>>>>>>
46076>>>>>>>>>        If (TransitionTimeIn.wMonth > 0) Begin
46078>>>>>>>>>            Move 1/1/2000 to dtFindDay // a fixed date to make it a date
46079>>>>>>>>>            Move (DateSetYear (dtFindDay, iYear)) to dtFindDay
46080>>>>>>>>>            Move (DateSetMonth (dtFindDay, TransitionTimeIn.wMonth)) to dtFindDay
46081>>>>>>>>>
46081>>>>>>>>>            // Now we have the first day of the month so progress through the month to find the N-th occurance,
46081>>>>>>>>>            // present in the wDay member, of the weekday. When wDay is 5 it indicates the last occurance and
46081>>>>>>>>>            // not the 5th occurance.
46081>>>>>>>>>            If (TransitionTimeIn.wDay = 5) Begin
46083>>>>>>>>>                Move (DateAddMonth (dtFindDay, 1)) to dtFindDay
46084>>>>>>>>>                While (not (bStop))
46088>>>>>>>>>                    Move (DateAddDay (dtFindDay, -1)) to dtFindDay
46089>>>>>>>>>                    // DateGetDayOfWeek returns 1 for Sunday but in the TransitionDatetime this is a 0.
46089>>>>>>>>>                    Move ((DateGetDayOfWeek (dtFindDay) - 1) = TransitionTimeIn.wDayOfWeek) to bStop
46090>>>>>>>>>                Loop
46091>>>>>>>>>>
46091>>>>>>>>>            End
46091>>>>>>>>>>
46091>>>>>>>>>            Else Begin
46092>>>>>>>>>                While (not (bStop))
46096>>>>>>>>>                    // DateGetDayOfWeek returns 1 for Sunday but in the TransitionDatetime this is a 0.
46096>>>>>>>>>                    If ((DateGetDayOfWeek (dtFindDay) - 1) = TransitionTimeIn.wDayOfWeek) Begin
46098>>>>>>>>>                        Increment iOccurance
46099>>>>>>>>>                        Move (iOccurance = TransitionTimeIn.wDay) to bStop
46100>>>>>>>>>                    End
46100>>>>>>>>>>
46100>>>>>>>>>                    If (not (bStop)) Begin
46102>>>>>>>>>                        Move (DateAddDay (dtFindDay, 1)) to dtFindDay
46103>>>>>>>>>                    End
46103>>>>>>>>>>
46103>>>>>>>>>                Loop
46104>>>>>>>>>>
46104>>>>>>>>>            End
46104>>>>>>>>>>
46104>>>>>>>>>
46104>>>>>>>>>            Move (DateGetDay (dtFindDay)) to TransitionTimeIn.wDay
46105>>>>>>>>>            Move iYear to TransitionTimeIn.wYear
46106>>>>>>>>>
46106>>>>>>>>>            Get FormatSystemTimeToDate TransitionTimeIn to sFormattedDate
46107>>>>>>>>>            Get FormatSystemTimeToTime TransitionTimeIn to sFormattedTime
46108>>>>>>>>>            If (TransitionTimeIn.wMilliseconds > 0) Begin
46110>>>>>>>>>                Get_Attribute DF_DECIMAL_SEPARATOR to iDecimalSeparator
46113>>>>>>>>>                Move (sFormattedTime + Character (iDecimalSeparator) + Cast (TransitionTimeIn.wMilliseconds, String)) to sFormattedTime
46114>>>>>>>>>            End
46114>>>>>>>>>>
46114>>>>>>>>>
46114>>>>>>>>>            Function_Return (sFormattedDate * sFormattedTime)
46115>>>>>>>>>        End
46115>>>>>>>>>>
46115>>>>>>>>>
46115>>>>>>>>>        Function_Return ""
46116>>>>>>>>>    End_Function
