34490>>>>>>>    // Seeds data and finds a record. Returns true if a seed/find succeeded.
34490>>>>>>>    Function SeedData Handle hoUpdateColumn Handle hoInitialColumn Returns Boolean
34492>>>>>>>        Handle hoInvokingObject hoInvokingServer hoServer
34492>>>>>>>        Handle hmSeedBuffer
34492>>>>>>>        Integer iField iFile eUpdateMode iStat iOrdering
34492>>>>>>>        Boolean bAutoSeed bReadRecord bChanged bSeeded bReverseOrdering bAutoServer
34492>>>>>>>        String sValue
34492>>>>>>>
34492>>>>>>>        WebGet peUpdateMode to eUpdateMode
34493>>>>>>>        Get GetInvokingObject to hoInvokingObject
34494>>>>>>>        WebGet pbAutoSeed to bAutoSeed
34495>>>>>>>        Get phmPromptSeedBufferCallback to hmSeedBuffer
34496>>>>>>>        Get pbAutoServer to bAutoServer
34497>>>>>>>        
34497>>>>>>>        Get ReadingServer to hoServer
34498>>>>>>>        Get Main_File of hoServer to iFile
34499>>>>>>>        Get Server of hoInvokingObject to hoInvokingServer
34500>>>>>>>        
34500>>>>>>>        // if autoserver, we need to make sure the file buffers are set for
34500>>>>>>>        // the invoking DDOs. This may be needed for relates-to constraints
34500>>>>>>>        If (bAutoServer) Begin
34502>>>>>>>            Send Refind_Records of hoInvokingServer
34503>>>>>>>        End
34503>>>>>>>>
34503>>>>>>>        // if a seed message is created, we assume that this should override anything else and that
34503>>>>>>>        // you will use this and only this for seeding
34503>>>>>>>        If (eUpdateMode<>umPromptNonInvoking and hmSeedBuffer) Begin
34505>>>>>>>            Clear iFile    // First clear the main_file buffer
34506>>>>>>>            Send hmSeedBuffer of hoInvokingObject Self
34507>>>>>>>            // if we come back with a non-edited, record we assume the seed did a find
34507>>>>>>>            // and we will use that record. Otherwise we want to do a find
34507>>>>>>>            Get_Attribute DF_FILE_STATUS of iFile to iStat
34510>>>>>>>            If (iStat=DF_FILE_ACTIVE) Begin
34512>>>>>>>                Move True to bSeeded
34513>>>>>>>            End
34513>>>>>>>>
34513>>>>>>>            Else Begin             
34514>>>>>>>                Move True to bReadRecord
34515>>>>>>>            End
34515>>>>>>>>
34515>>>>>>>        End
34515>>>>>>>>
34515>>>>>>>        // if relational we will seed if autoseed and if it really is relational
34515>>>>>>>        Else If (eUpdateMode=umPromptRelational and bAutoSeed) Begin
34518>>>>>>>            Clear iFile    // First clear the main_file buffer
34519>>>>>>>            // Default action is to perform an entry update just like a find
34519>>>>>>>            // key would do. If we have a server allow the server to control this.
34519>>>>>>>            Send Request_Entry_Update to hoInvokingServer iFile 1
34520>>>>>>>            Move True to bReadRecord
34521>>>>>>>        End
34521>>>>>>>>
34521>>>>>>>        // if value or custom, we seed if auto seed and we have an update column
34521>>>>>>>        Else If (bAutoSeed and hoUpdateColumn) Begin
34524>>>>>>>            WebGet psSeedValue to sValue
34525>>>>>>>            Get Data_File of hoUpdateColumn to iFile
34526>>>>>>>            Get Data_Field of hoUpdateColumn to iField
34527>>>>>>>            Clear iFile    // First clear the main_file buffer
34528>>>>>>>            Set_Field_Value iFile iField to sValue 
34531>>>>>>>            Move True to bReadRecord
34532>>>>>>>        End
34532>>>>>>>>
34532>>>>>>>        
34532>>>>>>>        // only find a record if there is a change. If the buffer is unchanged we leave
34532>>>>>>>        // it as is. This uncleared always start at the top of the list and if a custom
34532>>>>>>>        // seed was used to find the record, we will use that id
34532>>>>>>>        If bReadRecord Begin
34534>>>>>>>            Get_Attribute DF_FILE_CHANGED of iFile to bChanged
34537>>>>>>>            If bChanged Begin
34539>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34540>>>>>>>                Get IndexOrder to iOrdering
34541>>>>>>>                Get ReadDDRecordInBuffer hoServer iOrdering bReverseOrdering to bSeeded
34542>>>>>>>            End
34542>>>>>>>>
34542>>>>>>>        End
34542>>>>>>>>
34542>>>>>>>        
34542>>>>>>>        Function_Return bSeeded
34543>>>>>>>    End_Function
34544>>>>>>>    
34544>>>>>>>    Procedure RestoreDefaults
34546>>>>>>>        Integer iVal
34546>>>>>>>        String sVal
34546>>>>>>>        
34546>>>>>>>        Get piSortColumn to iVal
34547>>>>>>>        WebSet piSortColumn to iVal
34548>>>>>>>
34548>>>>>>>        Get peUpdateMode to iVal
34549>>>>>>>        WebSet peUpdateMode to iVal
34550>>>>>>>        
34550>>>>>>>        Get piInitialColumn to iVal
34551>>>>>>>        WebSet piInitialColumn to iVal
34552>>>>>>>        
34552>>>>>>>        Get piUpdateColumn to iVal
34553>>>>>>>        WebSet piUpdateColumn to iVal
34554>>>>>>>        
34554>>>>>>>        Get psSeedValue to sVal
34555>>>>>>>        WebSet psSeedValue to sVal
34556>>>>>>>
34556>>>>>>>        Get pbAutoSeed to iVal
34557>>>>>>>        WebSet pbAutoSeed to iVal
34558>>>>>>>
34558>>>>>>>        Get psPromptUpdateCallback to sVal
34559>>>>>>>        WebSet psPromptUpdateCallback to sVal
34560>>>>>>>    End_Procedure
