39857>>>>>    //  Validates if the field contains a valid email address (it allows empty values too).
39857>>>>>    Function ValidateEmail Integer iColumn String sValue Returns Boolean
39859>>>>>        Integer iAt iDot
39859>>>>>        Boolean bResult
39859>>>>>        
39859>>>>>        If (Trim(sValue) <> "") Begin
39861>>>>>            Move (Pos("@", sValue)) to iAt
39862>>>>>            Move (RightPos(".", sValue)) to iDot
39863>>>>>            
39863>>>>>            If (not(iAt > 1 and iDot > 0 and iDot > iAt + 1 and iDot < Length(sValue))) Begin
39865>>>>>                Send Data_set_error iColumn DFERR_OPERATOR "Please enter a valid email address"
39866>>>>>                Move True to bResult
39867>>>>>            End
39867>>>>>>
39867>>>>>        End
39867>>>>>>
39867>>>>>        
39867>>>>>        Function_Return bResult
39868>>>>>    End_Function
39869>>>>>    
39869>>>>>End_Class
