30795>>>>>>>                
30795>>>>>>>                If (not(bOK)) Begin
30797>>>>>>>                    Error DFERR_CANT_CREATE_FILE (SFormat(C_$WebAppReportCacheCreateError, sPath))
30798>>>>>>>>
30798>>>>>>>                    Function_Return ""
30799>>>>>>>                End
30799>>>>>>>>
30799>>>>>>>            End
30799>>>>>>>>
30799>>>>>>>            Else Begin
30800>>>>>>>                // test if the filename exists as something other than a directory
30800>>>>>>>                If (not(IsFlagIn(FILE_ATTRIBUTE_DIRECTORY, iAttributes))) Begin
30802>>>>>>>                    Error DFERR_CANT_CREATE_FILE (SFormat(C_$WebAppReportCacheCreateError, sPath))
30803>>>>>>>>
30803>>>>>>>                    Function_Return ""
30804>>>>>>>                End
30804>>>>>>>>
30804>>>>>>>            End
30804>>>>>>>>
30804>>>>>>>        End
30804>>>>>>>>
30804>>>>>>>        
30804>>>>>>>        Function_Return sPath
30805>>>>>>>    End_Function
