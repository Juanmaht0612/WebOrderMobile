54696>>>>>>>    Function InitDevNames Returns Handle
54698>>>>>>>        String sDriverName sDeviceName sOutputName sDefaultPrinter
54698>>>>>>>        WString wDriverName wDeviceName wOutputName
54698>>>>>>>        Integer iResult iSize iBytes iMemorySize
54698>>>>>>>        Pointer pDevNames
54698>>>>>>>        Handle hDevNames
54698>>>>>>>        DEVNAMES dn
54698>>>>>>>        DEVNAMES dn
54698>>>>>>>        tPrintDialogDevNameData PrintDialogDevNames
54698>>>>>>>        tPrintDialogDevNameData PrintDialogDevNames
54698>>>>>>>
54698>>>>>>>        // Clear error
54698>>>>>>>        Move (SetLastError(0)) to iResult
54699>>>>>>>
54699>>>>>>>        // Free previously allocated memory
54699>>>>>>>        Get phDevNames to hDevNames
54700>>>>>>>        If (hDevNames) Begin
54702>>>>>>>            Move (GlobalFree (hDevNames)) to iResult
54703>>>>>>>            Set phDevNames to 0
54704>>>>>>>        End
54704>>>>>>>>
54704>>>>>>>
54704>>>>>>>        // Retrieve the private structure to find out if the device name was changed by program logic
54704>>>>>>>        Get private_pPrintDialogDevNames to PrintDialogDevNames
54705>>>>>>>        If (PrintDialogDevNames.bChanged) Begin
54707>>>>>>>            If (PrintDialogDevNames.bDriverNameChanged) Begin
54709>>>>>>>                // Value need to be a WSTRING
54709>>>>>>>                Move PrintDialogDevNames.sDriverName to wDriverName
54710>>>>>>>            End
54710>>>>>>>>
54710>>>>>>>            If (PrintDialogDevNames.bDeviceNameChanged) Begin
54712>>>>>>>                // Value need to be a WSTRING
54712>>>>>>>                Move PrintDialogDevNames.sDeviceName to wDeviceName
54713>>>>>>>            End
54713>>>>>>>>
54713>>>>>>>            If (PrintDialogDevNames.bOutputNameChanged) Begin
54715>>>>>>>                // Value need to be a WSTRING
54715>>>>>>>                Move PrintDialogDevNames.sOutputName to wOutputName
54716>>>>>>>            End
54716>>>>>>>>
54716>>>>>>>
54716>>>>>>>            Move ((SizeOfWString (wDriverName) * 2) + (SizeOfWString (wDeviceName) * 2) + (SizeOfWString (wOutputName) * 2)) to iMemorySize
54717>>>>>>>            Move (SizeOfType (DEVNAMES)) to iSize
54718>>>>>>>            Move (iSize + iMemorySize + 6) to iMemorySize // at 6 bytes for \0 space
54719>>>>>>>
54719>>>>>>>            // Allocate memory for DEVNAMES structure
54719>>>>>>>            Move (GlobalAlloc (GHND, iMemorySize)) to hDevNames
54720>>>>>>>            If (hDevNames = 0) Begin
54722>>>>>>>                Move (ShowLastError ()) to iResult
54723>>>>>>>                Function_Return -1
54724>>>>>>>            End
54724>>>>>>>>
54724>>>>>>>
54724>>>>>>>            // Lock allocated memory
54724>>>>>>>            Move (GlobalLock (hDevNames)) to pDevNames
54725>>>>>>>            If (pDevNames = 0) Begin
54727>>>>>>>                Move (ShowLastError ()) to iResult
54728>>>>>>>                Move (GlobalFree (hDevNames)) to iResult
54729>>>>>>>                Function_Return -1
54730>>>>>>>            End
54730>>>>>>>>
54730>>>>>>>
54730>>>>>>>            // Copy the driver, device and output names in the extension of the struct
54730>>>>>>>            Move (iSize / 2) to dn.wDriverOffset // wDriverOffset is offset in characters
54731>>>>>>>            Move (SizeOfWString (wDriverName) * 2) to iBytes
54732>>>>>>>            If (iBytes > 0) Begin
54734>>>>>>>                Move (CopyMemory (pDevNames + iSize, AddressOf (wDriverName), iBytes)) to iResult
54735>>>>>>>            End
54735>>>>>>>>
54735>>>>>>>
54735>>>>>>>            Move (iSize + iBytes + 2) to iSize // This is in bytes
54736>>>>>>>            Move (dn.wDriverOffset + SizeOfWString (wDriverName) + 1) to dn.wDeviceOffset // This is in code units
54737>>>>>>>            Move (SizeOfWString (wDeviceName) * 2) to iBytes
54738>>>>>>>            If (iBytes > 0) Begin
54740>>>>>>>                Move (CopyMemory (pDevNames + iSize, AddressOf (wDeviceName), iBytes)) to iResult
54741>>>>>>>            End
54741>>>>>>>>
54741>>>>>>>
54741>>>>>>>            Move (iSize + iBytes + 2) to iSize
54742>>>>>>>            Move (dn.wDeviceOffset + SizeOfWString (wDeviceName) + 1) to dn.wOutputOffset
54743>>>>>>>            Move (SizeOfWString (wOutputName) * 2) to iBytes
54744>>>>>>>            If (iBytes > 0) Begin
54746>>>>>>>                Move (CopyMemory (pDevNames + iSize, AddressOf (wOutputName), iBytes)) to iResult
54747>>>>>>>            End
54747>>>>>>>>
54747>>>>>>>
54747>>>>>>>            Get DefaultPrinter to sDefaultPrinter
54748>>>>>>>            Move wDeviceName to sDeviceName
54749>>>>>>>            Move (sDefaultPrinter = sDeviceName) to dn.wDefault
54750>>>>>>>
54750>>>>>>>            // Copy the DEVNAMES structure part over the allocated memory and then unlock memory
54750>>>>>>>            Move (CopyMemory (pDevNames, AddressOf (dn), SizeOfType (DEVNAMES))) to iResult
54751>>>>>>>            Move (GlobalUnlock (hDevNames)) to iResult
54752>>>>>>>        End
54752>>>>>>>>
54752>>>>>>>
54752>>>>>>>        // Store the memory handle
54752>>>>>>>        Set phDevNames to hDevNames
54753>>>>>>>
54753>>>>>>>        Function_Return hDevNames
54754>>>>>>>    End_Function
54755>>>>>>>
54755>>>>>>>    Procedure InitPageRanges Integer iLastPage
54757>>>>>>>        PRINTPAGERANGE[] PageRanges
54757>>>>>>>        PRINTPAGERANGE[] PageRanges
54758>>>>>>>        Integer iPageRangeElements iPageRangeElement
54758>>>>>>>
54758>>>>>>>        Get pPageRanges to PageRanges
54759>>>>>>>        Move (SizeOfArray (PageRanges)) to iPageRangeElements
54760>>>>>>>        If (iPageRangeElements <= 1) Begin
54762>>>>>>>            Move 1 to PageRanges[0].nFromPage
54763>>>>>>>            Move iLastPage to PageRanges[0].nToPage
54764>>>>>>>        End
54764>>>>>>>>
54764>>>>>>>        Else Begin
54765>>>>>>>            Decrement iPageRangeElements
54766>>>>>>>            For iPageRangeElement from 0 to iPageRangeElements
54772>>>>>>>>
54772>>>>>>>                If (PageRanges[iPageRangeElement].nToPage > iLastPage) Begin
54774>>>>>>>                    Move iLastPage to PageRanges[iPageRangeElement].nToPage
54775>>>>>>>                End
54775>>>>>>>>
54775>>>>>>>                If (PageRanges[iPageRangeElement].nFromPage > iLastPage) Begin
54777>>>>>>>                    Move iLastPage to PageRanges[iPageRangeElement].nFromPage
54778>>>>>>>                End
54778>>>>>>>>
54778>>>>>>>                // Avoid that page 5-4 is put in the page ranges
54778>>>>>>>                If (PageRanges[iPageRangeElement].nFromPage > PageRanges[iPageRangeElement].nToPage) Begin
54780>>>>>>>                    Move PageRanges[iPageRangeElement].nToPage to PageRanges[iPageRangeElement].nFromPage
54781>>>>>>>                End
54781>>>>>>>>
54781>>>>>>>            Loop
54782>>>>>>>>
54782>>>>>>>        End
54782>>>>>>>>
54782>>>>>>>        Set pPageRanges to PageRanges
54783>>>>>>>    End_Procedure
