59463>>>>>
59463>>>>>    Function DataFlexTableName Handle hTable Returns String
59465>>>>>        String sDriver sTableName
59465>>>>>
59465>>>>>        Get_Attribute DF_FILE_DRIVER of hTable to sDriver
59468>>>>>        Case Begin
59468>>>>>            Case (sDriver = "DATAFLEX")
59470>>>>>                // DataFlex Reports works with the tablename on disk
59470>>>>>                Get_Attribute DF_FILE_ROOT_NAME of hTable to sTableName
59473>>>>>                Case Break
59474>>>>>            Case (sDriver = "MSSQLDRV")
59477>>>>>            Case (sDriver = "DB2_DRV")
59480>>>>>            Case (sDriver = "ODBC_DRV")
59483>>>>>                // Returns the name of the table specified in the INT file
59483>>>>>                Get_Attribute DF_FILE_TABLE_NAME of hTable to sTableName
59486>>>>>                Case Break
59487>>>>>            Case (sDriver = "DFBTRDRV")
59490>>>>>                // rootname most likely contains DFBTRDRV or .INT
59490>>>>>                Get_Attribute DF_FILE_LOGICAL_NAME of hTable to sTableName
59493>>>>>                Case Break
59494>>>>>        Case End
59494>>>>>
59494>>>>>        Function_Return sTableName
59495>>>>>    End_Function
59496>>>>>
