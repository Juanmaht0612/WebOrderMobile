43693>>>>>>>>>    Function VerifyConfigurablePropValue tWidgetConfigProp ConfigProp Variant vValue Returns Boolean
43695>>>>>>>>>        // Check variant type
43695>>>>>>>>>        // check if variant within acceptable range of values
43695>>>>>>>>>        Integer iType iVals i
43695>>>>>>>>>        Number nCur
43695>>>>>>>>>        
43695>>>>>>>>>        If (not(ConfigProp.Settings.bOptValidateValue)) Begin
43697>>>>>>>>>            Function_Return True
43698>>>>>>>>>        End
43698>>>>>>>>>>
43698>>>>>>>>>        
43698>>>>>>>>>        Get VariantType vValue to iType
43699>>>>>>>>>        Move ((SizeOfArray(ConfigProp.Settings.asOptValues)) -1) to iVals
43700>>>>>>>>>        
43700>>>>>>>>>        If (iType = OLE_VT_I4 or iType = OLE_VT_I8 or ;            iType = OLE_VT_R4 or iType = OLE_VT_I8) Begin
43702>>>>>>>>>            // compare min, max and allowed vals
43702>>>>>>>>>            If (vValue >= ConfigProp.Settings.iOptMinValue and vValue =< ConfigProp.Settings.iOptMaxValue) Begin
43704>>>>>>>>>                // check step size
43704>>>>>>>>>                If (ConfigProp.Settings.iOptStepSize > 0) Begin
43706>>>>>>>>>                    Move ConfigProp.Settings.iOptMinValue to nCur
43707>>>>>>>>>                    While (nCur <= ConfigProp.Settings.iOptMaxValue)
43711>>>>>>>>>                        If (vValue = nCur) Begin
43713>>>>>>>>>                            Function_Return True
43714>>>>>>>>>                        End
43714>>>>>>>>>>
43714>>>>>>>>>                        Move (nCur + ConfigProp.Settings.iOptStepSize) to nCur
43715>>>>>>>>>                    Loop
43716>>>>>>>>>>
43716>>>>>>>>>                End
43716>>>>>>>>>>
43716>>>>>>>>>                Else Begin
43717>>>>>>>>>                    Function_Return True
43718>>>>>>>>>                End
43718>>>>>>>>>>
43718>>>>>>>>>            End
43718>>>>>>>>>>
43718>>>>>>>>>            
43718>>>>>>>>>            For i from 0 to iVals
43724>>>>>>>>>>
43724>>>>>>>>>                If (vValue = ConfigProp.Settings.asOptValues[i]) Begin
43726>>>>>>>>>                    Function_Return True
43727>>>>>>>>>                End
43727>>>>>>>>>>
43727>>>>>>>>>            Loop
43728>>>>>>>>>>
43728>>>>>>>>>        End
43728>>>>>>>>>>
43728>>>>>>>>>        If (iType = OLE_VT_Bstr) Begin
43730>>>>>>>>>            // compare allowed values
43730>>>>>>>>>            If (iVals <= 0) Begin
43732>>>>>>>>>                Function_Return True
43733>>>>>>>>>            End
43733>>>>>>>>>>
43733>>>>>>>>>            
43733>>>>>>>>>            For i from 0 to iVals
43739>>>>>>>>>>
43739>>>>>>>>>                If (vValue = ConfigProp.Settings.asOptValues[i]) Begin
43741>>>>>>>>>                    Function_Return True
43742>>>>>>>>>                End
43742>>>>>>>>>>
43742>>>>>>>>>            Loop
43743>>>>>>>>>>
43743>>>>>>>>>        End
43743>>>>>>>>>>
43743>>>>>>>>>        
43743>>>>>>>>>        
43743>>>>>>>>>        
43743>>>>>>>>>        Function_Return False
43744>>>>>>>>>    End_Function
