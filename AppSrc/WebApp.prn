63655>>>
63655>>>    // Respond to this event to hide or show the controls that can be used to change the results
63655>>>    // of the report.
63655>>>    // In a mobile landscape mode there is not enough space to show both the options and order by controls and the report results
63655>>>    // and thus the results will be shown in a new window.
63655>>>    // In a mobile portrait mode there would not be enough space to show the full height of the two group objects with options
63655>>>    // and order by controls together with the results and we use the webaccordioncontainer/cards to make space.
63655>>>    // In all other situations the view has enough size for the controlling options and the results
63655>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
63658>>>        Integer eMode
63658>>>
63658>>>        Forward Send OnResizeWindow iWindowWidth iWindowHeight
63660>>>
63660>>>        WebGet peMode of ghoWebApp to eMode
63661>>>        Case Begin
63661>>>            Case (eMode = rmMobilePortrait)
63663>>>                WebSet pbRender of oMainPanelOptionsGroup to False
63664>>>                WebSet pbRender of oMainPanelSortOrderGroup to False
63665>>>                WebSet pbRender of oMainPanelViewer to False
63666>>>                WebSet pbRender of oMobileDeviceContainer to True
63667>>>                WebSet pbRender of oRunReportMenuItem to False
63668>>>                Send Show of oMobileDeviceResultsCard
63669>>>                Send RunReport of oMainPanel
63670>>>                Case Break
63671>>>            Case (eMode = rmMobileLandscape)
63674>>>                WebSet pbRender of oMainPanelOptionsGroup to True
63675>>>                WebSet pbRender of oMainPanelSortOrderGroup to True
63676>>>                WebSet pbRender of oRunReportMenuItem to True
63677>>>                WebSet pbRender of oMainPanelViewer to False
63678>>>                WebSet pbRender of oMobileDeviceContainer to False
63679>>>                Case Break
63680>>>            Case Else
63680>>>                WebSet pbRender of oMobileDeviceContainer to False
63681>>>                WebSet pbRender of oMainPanelOptionsGroup to True
63682>>>                WebSet pbRender of oMainPanelSortOrderGroup to True
63683>>>                WebSet pbRender of oRunReportMenuItem to False
63684>>>                WebSet pbRender of oMainPanelViewer to True
63685>>>                Send RunReport of oMainPanel
63686>>>        Case End
63686>>>    End_Procedure
63687>>>End_Object
