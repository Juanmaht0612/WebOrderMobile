42096>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
42099>>>        String sTask
42099>>>        Boolean bFound
42099>>>        
42099>>>        // turns all buttons on
42099>>>        WebSet pbRender of oNewButton to True
42100>>>        WebSet pbRender of oDetailButton to True
42101>>>        Send SetBreadcrumbCaption "Sales Persons"
42102>>>        Send SetHeaderCaption     "Sales Person Select"
42103>>>        
42103>>>        Case Begin
42103>>>            Case (NavigateData.eNavigateType = nfFromMain)
42105>>>                // a main-file lookup
42105>>>                // not used yet
42105>>>                WebSet pbRender of oNewButton to False
42106>>>                WebSet pbRender of oDetailButton to False
42107>>>                Case Break
42108>>>            Case (NavigateData.eNavigateType = nfFromChild)
42111>>>                // a parent lookup
42111>>>                Case Break
42112>>>            Case (NavigateData.eNavigateType = nfFromParent)
42115>>>                // A parent query
42115>>>                // not used yet
42115>>>                Case Break
42116>>>            Case Else
42116>>>                // either a start of a drill down query or a main file query
42116>>>                Get NamedValueGet NavigateData.NamedValues "task" to sTask
42117>>>                If (sTask="maint") Begin
42119>>>                    // main file query
42119>>>                    WebSet pbRender of oDetailButton to False
42120>>>                End
42120>>>>
42120>>>        Case End
42120>>>    End_Procedure
