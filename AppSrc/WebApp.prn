44846>>>>>    Procedure InitializeWidgetAdministration
44848>>>>>        tWidgetRegistration[] aWidgets
44848>>>>>        tWidgetRegistration[] aWidgets
44849>>>>>        Integer iWidget
44849>>>>>        Handle hoStaticInstance
44849>>>>>        
44849>>>>>        //  First determine default config, as this might fill in some of the static instances or add new widgets
44849>>>>>        Send DetermineDefaultConfig
44850>>>>>        
44850>>>>>        //  Loop over widgets and 
44850>>>>>        Get paRegisteredWidgets to aWidgets
44851>>>>>        For iWidget from 0 to (SizeOfArray(aWidgets) - 1)
44857>>>>>>
44857>>>>>            If (aWidgets[iWidget].hoStaticInstance = C_WebUnresolvedObject) Begin
44859>>>>>                Get CreateNamed aWidgets[iWidget].hClass ('StatWid-' + String(iWidget)) to hoStaticInstance
44860>>>>>                Move hoStaticInstance to aWidgets[iWidget].hoStaticInstance
44861>>>>>                
44861>>>>>                //  Configure web objects to act as ghosts
44861>>>>>                Send MarkGhost of hoStaticInstance
44862>>>>>            End
44862>>>>>>
44862>>>>>            Else ;                Move aWidgets[iWidget].hoStaticInstance to hoStaticInstance
44864>>>>>                
44864>>>>>        
44864>>>>>           
44864>>>>>            Get psWidgetName of hoStaticInstance to aWidgets[iWidget].sName
44865>>>>>            Get piDefaultColSpan of hoStaticInstance to  aWidgets[iWidget].iColSpan
44866>>>>>            Get piDefaultRowSpan of hoStaticInstance to  aWidgets[iWidget].iRowSpan
44867>>>>>        Loop
44868>>>>>>
44868>>>>>        
44868>>>>>        Move (SortArray(aWidgets, False)) to aWidgets
44869>>>>>        Set paRegisteredWidgets to aWidgets
44870>>>>>    End_Procedure
44871>>>>>
44871>>>>>    
44871>>>>>    Procedure DetermineDefaultConfig
44873>>>>>        tContainerDef DefaultContainerDef
44873>>>>>        tContainerDef DefaultContainerDef
44873>>>>>        tWidgetRegistration[] aWidgets
44873>>>>>        tWidgetRegistration[] aWidgets
44874>>>>>        tWidgetRegistration searchItem
44874>>>>>        tWidgetRegistration searchItem
44874>>>>>        tWidgetConfigProp[] aProps
44874>>>>>        tWidgetConfigProp[] aProps
44875>>>>>        tWidgetConfigPropValue[] aPropVals
44875>>>>>        tWidgetConfigPropValue[] aPropVals
44876>>>>>        
44876>>>>>        Handle hoWidget
44876>>>>>        Handle[] aDefaultWidgets
44877>>>>>        Integer iWidget iRegIndex i iProps iActualObjectClass
44877>>>>>        tWebPropMetaData PropMeta
44877>>>>>        tWebPropMetaData PropMeta
44877>>>>>        Variant vPropVal
44877>>>>>        
44877>>>>>        
44877>>>>>        Get paDefaultWidgets to aDefaultWidgets
44878>>>>>        Get paRegisteredWidgets to aWidgets
44879>>>>>        
44879>>>>>        For iWidget from 0 to (SizeOfArray(aDefaultWidgets) - 1)
44885>>>>>>
44885>>>>>            Move aDefaultWidgets[iWidget] to hoWidget
44886>>>>>            
44886>>>>>            //  Add to default configuration
44886>>>>>            Move ("DefWid-" + String(iWidget)) to DefaultContainerDef.aWidgets[iWidget].sDynId
44887>>>>>            Get piRowIndex of hoWidget to DefaultContainerDef.aWidgets[iWidget].iRowIndex
44888>>>>>            Get piRowSpan of hoWidget to DefaultContainerDef.aWidgets[iWidget].iRowSpan
44889>>>>>            Get piColumnIndex of hoWidget to DefaultContainerDef.aWidgets[iWidget].iColIndex
44890>>>>>            Get piColumnSpan of hoWidget to DefaultContainerDef.aWidgets[iWidget].iColSpan
44891>>>>>            Get psWidgetName of hoWidget to DefaultContainerDef.aWidgets[iWidget].sName
44892>>>>>            Get pbFillHeight of hoWidget to DefaultContainerDef.aWidgets[iWidget].bFillHeight
44893>>>>>            Get paPubPropertyRules of hoWidget to DefaultContainerDef.aWidgets[iWidget].aResponsivePropRules
44894>>>>>            
44894>>>>>            // Configurable props
44894>>>>>            Get GetConfigurableProps of hoWidget to aProps
44895>>>>>            Move ((SizeOfArray(aProps)) - 1) to iProps
44896>>>>>            
44896>>>>>            For i from 0 to iProps
44902>>>>>>
44902>>>>>                // For now, we only support top level config props in the default
44902>>>>>                If (aProps[i].sObjName = "") Begin
44904>>>>>                    Get FindWebPropertyMetaByName of hoWidget aProps[i].sPropName to PropMeta
44905>>>>>                    If (PropMeta.hmGetter <> 0) Begin
44907>>>>>                        Get GetSyncProp of hoWidget hoWidget PropMeta.hmSetter PropMeta.sName to vPropVal
44908>>>>>                        Move aProps[i].sObjName     to DefaultContainerDef.aWidgets[iWidget].aConfig[i].sObjName
44909>>>>>                        Move aProps[i].sPropName    to DefaultContainerDef.aWidgets[iWidget].aConfig[i].sPropName
44910>>>>>                        Move vPropVal               to DefaultContainerDef.aWidgets[iWidget].aConfig[i].sValue
44911>>>>>                    End
44911>>>>>>
44911>>>>>                End            
44911>>>>>>
44911>>>>>            Loop
44912>>>>>>
44912>>>>>            
44912>>>>>            //  Configure web objects to act as ghosts
44912>>>>>            Send MarkGhost of hoWidget
44913>>>>>            
44913>>>>>            
44913>>>>>            //  Check missing behavior if the inheriting class is not the same as the actual object class.
44913>>>>>            //  In other words the object def has additional functional logic.
44913>>>>>            Get ObjectClass of hoWidget to searchItem.hClass
44914>>>>>            Get Class of hoWidget to iActualObjectClass
44915>>>>>            
44915>>>>>            If (searchItem.hClass <> iActualObjectClass) Begin
44917>>>>>                Error DFERR_PROGRAM "It is not allowed to define procedures and/or functions on default widgets, please define those in a Class/Composite abstraction."
44918>>>>>>
44918>>>>>            End
44918>>>>>>
44918>>>>>            
44918>>>>>            //  Add to default config
44918>>>>>            Move (SearchArray(searchItem, aWidgets, Self, RefFunc(CompareClassId))) to iRegIndex
44919>>>>>            If (iRegIndex = -1) Begin
44921>>>>>                Move (SizeOfArray(aWidgets)) to iRegIndex
44922>>>>>                Move hoWidget to aWidgets[iRegIndex].hoStaticInstance
44923>>>>>                Get ObjectClass of hoWidget to aWidgets[iRegIndex].hClass
44924>>>>>            End
44924>>>>>>
44924>>>>>            Else If (aWidgets[iRegIndex].hoStaticInstance = C_WebUnresolvedObject) Begin
44927>>>>>                Move hoWidget to aWidgets[iRegIndex].hoStaticInstance
44928>>>>>            End
44928>>>>>>
44928>>>>>        Loop
44929>>>>>>
44929>>>>>        
44929>>>>>        Set ptDefaultContainerDef of (phoInternalWidgetContainer(Self)) to DefaultContainerDef
44930>>>>>        Set paRegisteredWidgets to aWidgets
44931>>>>>    End_Procedure
