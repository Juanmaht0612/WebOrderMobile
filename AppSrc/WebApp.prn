43264>>>    Procedure OnLoad
43267>>>        String sPrevStateHash sView
43267>>>        
43267>>>        Forward Send OnLoad
43269>>>        
43269>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
43269>>>        Get StateHash of (Host(Self)) to sPrevStateHash
43270>>>        Send ParseViewStateHash sPrevStateHash (&sView)
43271>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
43273>>>            WebSet psPrevStateHash to sPrevStateHash
43274>>>        End
43274>>>>
43274>>>        
43274>>>    End_Procedure
