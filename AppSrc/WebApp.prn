25240>>>>>>>>>>>>>    Function StrSplitToArrayUnescapedWithTrim String sStr String sDel Returns String[]
25242>>>>>>>>>>>>>        Integer iCounter iLast iLength iDelLength iEscapedLength
25242>>>>>>>>>>>>>        String sEscapedDel
25242>>>>>>>>>>>>>        String[] aValues
25243>>>>>>>>>>>>>        
25243>>>>>>>>>>>>>        Move 1 to iLast
25244>>>>>>>>>>>>>        Move (Length(sStr)) to iLength
25245>>>>>>>>>>>>>        Move (Length(sDel)) to iDelLength
25246>>>>>>>>>>>>>        Move ("\" + sDel) to sEscapedDel
25247>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25248>>>>>>>>>>>>>        
25248>>>>>>>>>>>>>        If (iLength = 0) Begin
25250>>>>>>>>>>>>>             Function_Return aValues
25251>>>>>>>>>>>>>        End
25251>>>>>>>>>>>>>>
25251>>>>>>>>>>>>>        
25251>>>>>>>>>>>>>        For iCounter from 1 to iLength
25257>>>>>>>>>>>>>>
25257>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sDel and ;                Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25259>>>>>>>>>>>>>                Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25260>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25261>>>>>>>>>>>>>            End
25261>>>>>>>>>>>>>>
25261>>>>>>>>>>>>>        Loop
25262>>>>>>>>>>>>>>
25262>>>>>>>>>>>>>        Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
25263>>>>>>>>>>>>>        Function_Return aValues
25264>>>>>>>>>>>>>    End_Function
25265>>>>>>>>>>>>>    
25265>>>>>>>>>>>>>    Function StrReplacesUnescaped String sReplace String sStr String sWith Returns String
25267>>>>>>>>>>>>>        Integer iCounter iLast iDelLength iEscapedLength
25267>>>>>>>>>>>>>        String sEscapedDel sPre sPost
25267>>>>>>>>>>>>>        
25267>>>>>>>>>>>>>        Move 1 to iLast
25268>>>>>>>>>>>>>        Move (Length(sReplace)) to iDelLength
25269>>>>>>>>>>>>>        Move ("\" + sReplace) to sEscapedDel
25270>>>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
25271>>>>>>>>>>>>>        
25271>>>>>>>>>>>>>        If ((Length(sStr)) = 0) Begin
25273>>>>>>>>>>>>>            Function_Return sStr
25274>>>>>>>>>>>>>        End
25274>>>>>>>>>>>>>>
25274>>>>>>>>>>>>>        
25274>>>>>>>>>>>>>        While (iCounter <= Length(sStr))
25278>>>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sReplace and Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
25280>>>>>>>>>>>>>                Move (Left(sStr, iCounter - iDelLength) + sWith + Mid(sStr, (Length(sStr)) - iCounter, iCounter + 1)) to sStr
25281>>>>>>>>>>>>>                Move (iCounter + iEscapedLength - 1) to iCounter
25282>>>>>>>>>>>>>                Move (iCounter + 1) to iLast
25283>>>>>>>>>>>>>            End
25283>>>>>>>>>>>>>>
25283>>>>>>>>>>>>>            Increment iCounter
25284>>>>>>>>>>>>>        Loop
25285>>>>>>>>>>>>>>
25285>>>>>>>>>>>>>        Function_Return sStr
25286>>>>>>>>>>>>>    End_Function
