35704>>>>>>>        
35704>>>>>>>        // Assert that the WebApp has a view stack object
35704>>>>>>>        If (ViewStack(Self) = C_WebUnresolvedObject) Begin
35706>>>>>>>            Error DFERR_PROGRAM "View stack object missing in application using the breadcrumb control." 
