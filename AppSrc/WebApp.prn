26030>>>>>>>>>>>
26030>>>>>>>>>>>    // special Request_Find logic for web-lists. cWebColumn will direct a Request_Find
26030>>>>>>>>>>>    // to here. This understands non-data aware and static lists and ignores those
26030>>>>>>>>>>>    // requests. It also understands peRequestFindMode which can filter out finds that
26030>>>>>>>>>>>    // don't make sense in a grid.
26030>>>>>>>>>>>    
26030>>>>>>>>>>>    Procedure Request_Find Integer eFindMode
26032>>>>>>>>>>>        Integer iFile iField iIndex iMain iRelField 
26032>>>>>>>>>>>        Integer eRequestFindMode eDbGridType
26032>>>>>>>>>>>        Boolean bFound
26032>>>>>>>>>>>        Handle hoServer
26032>>>>>>>>>>>        Boolean bAllowSwitch bDataAware
26032>>>>>>>>>>>        
26032>>>>>>>>>>>        // only data aware grids process request_find
26032>>>>>>>>>>>        Get pbDataAware to bDataAware
26033>>>>>>>>>>>        If not bDataAware Begin
26035>>>>>>>>>>>            Move False to Found
26036>>>>>>>>>>>            Procedure_Return
26037>>>>>>>>>>>        End
26037>>>>>>>>>>>>
26037>>>>>>>>>>>        
26037>>>>>>>>>>>        // find mode determines what kind of finding is supported
26037>>>>>>>>>>>        Get peRequestFindMode to eRequestFindMode
26038>>>>>>>>>>>        
26038>>>>>>>>>>>        // if finding not allowed at all, no find
26038>>>>>>>>>>>        If (eRequestFindMode=rfmFindNone) Begin
26040>>>>>>>>>>>            Move False to Found
26041>>>>>>>>>>>            Procedure_Return
26042>>>>>>>>>>>        End
26042>>>>>>>>>>>>
26042>>>>>>>>>>>
26042>>>>>>>>>>>        Get peDbGridType to eDbGridType
26043>>>>>>>>>>>        Get Server to hoServer
26044>>>>>>>>>>>        Get Data_File to iFile
26045>>>>>>>>>>>        Get Data_Field to iField
26046>>>>>>>>>>>
26046>>>>>>>>>>>        If (hoServer=0 or iFile=0) Begin
26048>>>>>>>>>>>            Move False to Found
26049>>>>>>>>>>>            Procedure_Return
26050>>>>>>>>>>>        End
26050>>>>>>>>>>>>
26050>>>>>>>>>>>
26050>>>>>>>>>>>        Get Main_File of hoServer to iMain
26051>>>>>>>>>>>        
26051>>>>>>>>>>>        // if no finding index, no find
26051>>>>>>>>>>>        Get File_Field_Index of hoServer iFile iField to iIndex
26052>>>>>>>>>>>        If (iIndex=-1) Begin
26054>>>>>>>>>>>            Move False to Found
26055>>>>>>>>>>>            Procedure_Return
26056>>>>>>>>>>>        End
26056>>>>>>>>>>>>
26056>>>>>>>>>>>            
26056>>>>>>>>>>>        // if this is a main file find we will ignore it if main-file finds are
26056>>>>>>>>>>>        // not allowed or the grid is static. If Static, you should not be doing finds
26056>>>>>>>>>>>        // on the mainfile as it will cause the data to all be reloaded.
26056>>>>>>>>>>>        If (iFile=iMain and ( (eRequestFindMode=rfmFindParentOnly) or (eDbGridType<>gtAutomatic) ) ) Begin
26058>>>>>>>>>>>            Move False to Found
26059>>>>>>>>>>>            Procedure_Return
26060>>>>>>>>>>>        End
26060>>>>>>>>>>>>
26060>>>>>>>>>>>        // if main or find all or findparentonly (with a parent find)
26060>>>>>>>>>>>        Else If (iFile=iMain or eRequestFindMode=rfmFindAll or eRequestFindMode=rfmFindParentOnly ) Begin
26063>>>>>>>>>>>            Send Item_Find of hoServer eFindMode iFile iField True True False
26064>>>>>>>>>>>            Move (Found) to bFound
26065>>>>>>>>>>>        End
26065>>>>>>>>>>>>
26065>>>>>>>>>>>        // if parent with find mainonly
26065>>>>>>>>>>>        Else If (eRequestFindMode=rfmFindMainOnly) Begin
26068>>>>>>>>>>>           Move False to Found
26069>>>>>>>>>>>           Procedure_Return 
26070>>>>>>>>>>>        End
26070>>>>>>>>>>>>
26070>>>>>>>>>>>        // is parent with find superfind logic (used by prompt lists)
26070>>>>>>>>>>>        Else Begin
26071>>>>>>>>>>>           Get RelatingField iFile to iRelField
26072>>>>>>>>>>>           If (iRelField=-1) Begin
26074>>>>>>>>>>>               Move False to Found
26075>>>>>>>>>>>               Procedure_Return   
26076>>>>>>>>>>>           End
26076>>>>>>>>>>>>
26076>>>>>>>>>>>           
26076>>>>>>>>>>>           // if superfind mode, which means this is a prompt list we want to be able to change the
26076>>>>>>>>>>>           // parent, even if committed w/ no parent switch set. 
26076>>>>>>>>>>>           //So Clear that parentNoSwitch for the main-dd for this parent Find and then restore it
26076>>>>>>>>>>>           Get ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26077>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to False
26078>>>>>>>>>>>           Send Item_Find of hoServer eFindMode iFile iField True True False
26079>>>>>>>>>>>           Move (Found) to bFound
26080>>>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
26081>>>>>>>>>>>           If ( (bFound) ) Begin
26083>>>>>>>>>>>                Send Item_Find to hoServer GE iMain iRelField True True False
26084>>>>>>>>>>>                Move (Found) to bFound
26085>>>>>>>>>>>           End
26085>>>>>>>>>>>>
26085>>>>>>>>>>>        End
26085>>>>>>>>>>>>
26085>>>>>>>>>>>        
26085>>>>>>>>>>>        Move bFound to Found
26086>>>>>>>>>>>            
26086>>>>>>>>>>>    End_Procedure
