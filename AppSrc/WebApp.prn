34707>>>>>>>        WebSet pbChanged of hoInvokingObject to True
34708>>>>>>>    End_Procedure
34709>>>>>>>
34709>>>>>>>    Procedure OnMoveValueOutByCustom Handle hoInvokingObject
34711>>>>>>>    End_Procedure
34712>>>>>>>
34712>>>>>>>    // This is only called in a successful close
34712>>>>>>>    Procedure ClosePromptList
34714>>>>>>>        Handle hoInvokingObject hoServer
34714>>>>>>>        Handle hmCallBack
34714>>>>>>>        Integer iFile eUpdateMode
34714>>>>>>>        RowID rRowId
34714>>>>>>>        String sRowId sCallBack
34714>>>>>>>        Boolean bOldExt bDataAware bSuccess
34714>>>>>>>        
34714>>>>>>>        Get pbDataAware to bDataAware
34715>>>>>>>        If bDataAware Begin
34717>>>>>>>            // update DD with the current selected record
34717>>>>>>>            WebGet psCurrentRowID to sRowId
34718>>>>>>>            Move (DeserializeRowID(sRowId)) to rRowId            
34719>>>>>>>            Get Server to hoServer
34720>>>>>>>            Get Main_File of hoServer to iFile
34721>>>>>>>            If (not(IsNullRowID(rRowId))) Begin
34723>>>>>>>                Get pbNotifyingExternalDD to bOldExt
34724>>>>>>>                Set pbNotifyingExternalDD to True // refresh will not try to fill the grid
34725>>>>>>>                Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
34726>>>>>>>                // this is very unlikely
34726>>>>>>>                If not bSuccess Begin
34728>>>>>>>                    Error DFERR_CANT_REFIND_RECORD
34729>>>>>>>>
34729>>>>>>>                End
34729>>>>>>>>
34729>>>>>>>                Set pbNotifyingExternalDD to bOldExt
34730>>>>>>>            End
34730>>>>>>>>
34730>>>>>>>        End
34730>>>>>>>>
34730>>>>>>>        
34730>>>>>>>        WebGet peUpdateMode to eUpdateMode
34731>>>>>>>        // If non-invoking there is by definition, no Move value out
34731>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34733>>>>>>>            Get GetInvokingObject to hoInvokingObject            
34734>>>>>>>            
34734>>>>>>>            If not hoInvokingObject Begin
34736>>>>>>>                Error DFERR_PROGRAM "Assert: hoInvokingObject is 0"
34737>>>>>>>>
34737>>>>>>>                Procedure_Return
34738>>>>>>>            End
34738>>>>>>>>
34738>>>>>>>            
34738>>>>>>>            If (eUpdateMode=umPromptRelational) Begin
34740>>>>>>>                Send OnMoveValueOutByRelational hoInvokingObject
34741>>>>>>>            End
34741>>>>>>>>
34741>>>>>>>            Else If (eUpdateMode=umPromptValue) Begin
34744>>>>>>>                Send OnMoveValueOutByValue hoInvokingObject
34745>>>>>>>            End
34745>>>>>>>>
34745>>>>>>>            Else If (eUpdateMode=umPromptCustom) Begin
34748>>>>>>>                Send OnMoveValueOutByCustom hoInvokingObject
34749>>>>>>>            End
34749>>>>>>>>
34749>>>>>>>            WebGet psPromptUpdateCallback to sCallBack
34750>>>>>>>            If sCallBack Begin
34752>>>>>>>                Get WebMethodByName of hoInvokingObject sCallBack to hmCallBack
34753>>>>>>>                If hmCallBack Begin
34755>>>>>>>                    Send hmCallBack of hoInvokingObject Self
34756>>>>>>>                End
34756>>>>>>>>
34756>>>>>>>            End
34756>>>>>>>>
34756>>>>>>>        End
34756>>>>>>>>
34756>>>>>>>    End_Procedure
34757>>>>>>>
34757>>>>>>>    Procedure Cancel
34759>>>>>>>        Integer eViewStyle
34759>>>>>>>        Get peWebViewStyle to eViewStyle
34760>>>>>>>        
34760>>>>>>>        // if drilldown we do a NavigateCancel instead of a Hide.
34760>>>>>>>        // We use NavigateCancel instead of NavigateClose because the prompt
34760>>>>>>>        // list has already updated the invoking object.
34760>>>>>>>        // If it is a dialog we call CloseDialog and let the dialog decide how it needs to be closed
34760>>>>>>>        If (eViewStyle=wvsDrillDown) Begin
34762>>>>>>>            Send NavigateCancel
34763>>>>>>>        End
34763>>>>>>>>
34763>>>>>>>        Else If (eViewStyle=wvsDialog) Begin
34766>>>>>>>            Send CloseDialog
34767>>>>>>>        End
34767>>>>>>>>
34767>>>>>>>        Else Begin
34768>>>>>>>            Send Hide
34769>>>>>>>        End
34769>>>>>>>>
34769>>>>>>>    End_Procedure
34770>>>>>>>
34770>>>>>>>    Procedure Ok
34772>>>>>>>        Send ClosePromptList
34773>>>>>>>        Send Cancel
34774>>>>>>>        Send NotifyCloseModalDialog
34775>>>>>>>    End_Procedure
34776>>>>>>>    
34776>>>>>>>    // Returns server to use for reading and constraints.
34776>>>>>>>    // If pbAutoServer is set, return the matching DD from the invoking DEO's view.
34776>>>>>>>    // if not set, the server is also the reading server.
34776>>>>>>>    Function ReadingServer Returns Handle
34778>>>>>>>        Handle hoDD hoInvokingDEO hoInvokingDD
34778>>>>>>>        Integer iMain
34778>>>>>>>        Boolean bAutoServer
34778>>>>>>>
34778>>>>>>>        Get Server to hoDD
34779>>>>>>>
34779>>>>>>>        Get pbAutoServer to bAutoServer
34780>>>>>>>        If bAutoServer Begin           
34782>>>>>>>            Get GetInvokingObject to hoInvokingDEO
34783>>>>>>>            If hoInvokingDEO Begin
34785>>>>>>>                Get Main_File of hoDD to iMain
34786>>>>>>>                Get Server of hoInvokingDEO to hoInvokingDD
34787>>>>>>>                Get Which_Data_Set of hoInvokingDD iMain to hoInvokingDD
34788>>>>>>>                If hoInvokingDD Begin
34790>>>>>>>                    Move hoInvokingDD to hoDD
34791>>>>>>>                End
34791>>>>>>>>
34791>>>>>>>            End
34791>>>>>>>>
34791>>>>>>>        End
34791>>>>>>>>
34791>>>>>>>        Function_Return hoDD
34792>>>>>>>    End_Function
34793>>>>>>>
34793>>>>>>>    // this must be augmented to handle auto-server searches
34793>>>>>>>    Procedure OnSearch String sSearchText
34795>>>>>>>        Integer iCol 
34795>>>>>>>        Boolean bReverseOrdering bFound bAutoServer
34795>>>>>>>        Integer iOrdering iFile
34795>>>>>>>        Handle hoCol hoServer hoReadingServer
34795>>>>>>>        
34795>>>>>>>        Get pbAutoServer to bAutoServer
34796>>>>>>>        If not bAutoServer Begin
34798>>>>>>>            Forward Send OnSearch sSearchText
34800>>>>>>>        End
34800>>>>>>>>
34800>>>>>>>        Else Begin
34801>>>>>>>            WebGet piSortColumn to iCol
34802>>>>>>>            
34802>>>>>>>            If (iCol>=0) Begin
34804>>>>>>>                Get GetColumnObject iCol to hoCol
34805>>>>>>>                Get Server to hoServer               // the prompt lists server
34806>>>>>>>                Get ReadingServer to hoReadingServer // invoking server used for constained reads
34807>>>>>>>                If (hoServer=0) Begin
34809>>>>>>>                    Procedure_Return
34810>>>>>>>                End
34810>>>>>>>>
34810>>>>>>>                            
34810>>>>>>>                Send DDSetChangedValue of hoCol sSearchText
34811>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
34812>>>>>>>                Get IndexOrder to iOrdering
34813>>>>>>>                Get Main_File of hoServer to iFile
34814>>>>>>>                
34814>>>>>>>                // entry update based on the prompt list server (that's where the search value is)
34814>>>>>>>                Send Request_Entry_Update of hoServer iFile 1
34815>>>>>>>                
34815>>>>>>>                // read record for reading server (the invoking server)
34815>>>>>>>                Get ReadDDRecordInBuffer hoReadingServer iOrdering bReverseOrdering to bFound
34816>>>>>>>                
34816>>>>>>>                If bFound Begin
34818>>>>>>>                    // tell prompt list server about this record. This will update the list
34818>>>>>>>                    Send Request_Assign of hoServer
34819>>>>>>>                End
34819>>>>>>>>
34819>>>>>>>            End
34819>>>>>>>>
34819>>>>>>>        End
34819>>>>>>>>
34819>>>>>>>    End_Procedure
34820>>>>>>>End_Class
