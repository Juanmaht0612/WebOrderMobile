54302>>>    Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData
54305>>>        String[] sCustomerCustomerNumbers
54306>>>        String[] sCustomerNames
54307>>>        String sReportId sSortField
54307>>>        Boolean bSortDescending
54307>>>
54307>>>        WebGet psValue of oFromCustomerCustomerNumber to sCustomerCustomerNumbers[0]
54308>>>        WebGet psValue of oToCustomerCustomerNumber to sCustomerCustomerNumbers[1]
54309>>>
54309>>>        If (sCustomerCustomerNumbers[0] <> "") Begin
54311>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerCustomerNumberFrom" sCustomerCustomerNumbers[0] to NavigateData.NamedValues
54312>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerCustomerNumberFromMode" C_drGreaterThanOrEqual to NavigateData.NamedValues
54313>>>        End
54313>>>>
54313>>>        If (sCustomerCustomerNumbers[1] <> "") Begin
54315>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerCustomerNumberTo" sCustomerCustomerNumbers[1] to NavigateData.NamedValues
54316>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerCustomerNumberToMode" C_drLessThanOrEqual to NavigateData.NamedValues
54317>>>        End
54317>>>>
54317>>>
54317>>>        WebGet psValue of oFromCustomerName to sCustomerNames[0]
54318>>>        WebGet psValue of oToCustomerName to sCustomerNames[1]
54319>>>
54319>>>        If (sCustomerNames[0] <> "") Begin
54321>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerNameFrom" sCustomerNames[0] to NavigateData.NamedValues
54322>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerNameFromMode" C_drGreaterThanOrEqual to NavigateData.NamedValues
54323>>>        End
54323>>>>
54323>>>        If (sCustomerNames[1] <> "") Begin
54325>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerNameTo" sCustomerNames[1] to NavigateData.NamedValues
54326>>>            Get NamedValueAdd NavigateData.NamedValues "CustomerNameToMode" C_drLessThanOrEqual to NavigateData.NamedValues
54327>>>        End
54327>>>>
54327>>>
54327>>>        WebGet psValue of oSortOnCombo to sSortField
54328>>>        Get GetChecked of oSortDescending to bSortDescending
54329>>>        If (bSortDescending) Begin
54331>>>            Get NamedValueAdd NavigateData.NamedValues "SortDirection" C_drDescending to NavigateData.NamedValues
54332>>>        End
54332>>>>
54332>>>        Else Begin
54333>>>            Get NamedValueAdd NavigateData.NamedValues "SortDirection" C_drAscending to NavigateData.NamedValues
54334>>>        End
54334>>>>
54334>>>        Get NamedValueAdd NavigateData.NamedValues "SortField" sSortField to NavigateData.NamedValues
54335>>>    End_Procedure
54336>>>End_Object
