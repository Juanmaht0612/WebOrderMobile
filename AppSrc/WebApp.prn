29755>>>>>>>>>    //  Registers a folder as being allowed to stream files from. Even through the download URL's 
29755>>>>>>>>>    //  should be secure this provides an extra layer of security on top of the encryption.
29755>>>>>>>>>    //
29755>>>>>>>>>    //  Params:
29755>>>>>>>>>    //      sPath   The absolute path to this folder (relative paths will not work!).
29755>>>>>>>>>    Procedure RegisterDownloadFolder String sPath
29757>>>>>>>>>        String[] aFolders
29758>>>>>>>>>        
29758>>>>>>>>>        Get paDownloadFolders to aFolders
29759>>>>>>>>>        
29759>>>>>>>>>        //  Convert relative paths into a full path and lowercase for comparison
29759>>>>>>>>>        Get FullPathName sPath to sPath
29760>>>>>>>>>        Move (Lowercase(sPath)) to sPath
29761>>>>>>>>>        
29761>>>>>>>>>        //  Add trailing "\" to prevent "Picture" sharing also "Pictures" mistake
29761>>>>>>>>>        If (Right(sPath, 1) <> "\") Begin
29763>>>>>>>>>            Move (sPath + "\") to sPath
29764>>>>>>>>>        End
29764>>>>>>>>>>
29764>>>>>>>>>        
29764>>>>>>>>>        //  Prevent duplicates
29764>>>>>>>>>        If (SearchArray(sPath, aFolders) >= 0) Begin
29766>>>>>>>>>            Procedure_Return 
29767>>>>>>>>>        End
29767>>>>>>>>>>
29767>>>>>>>>>        
29767>>>>>>>>>        //  Add path
29767>>>>>>>>>        Move sPath to aFolders[SizeOfArray(aFolders)]
29768>>>>>>>>>        Set paDownloadFolders to aFolders
29769>>>>>>>>>    End_Procedure
