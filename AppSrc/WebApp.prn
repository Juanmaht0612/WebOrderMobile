33807>>>>>>>    End_Procedure
33808>>>>>>>    
33808>>>>>>>    // Delete Logic to delete the current row pointed to by psCurrentRowId.
33808>>>>>>>    // returns True if the delete was successful.
33808>>>>>>>    Function DeleteSelectedRow Returns Integer
33810>>>>>>>        Handle hmVerify
33810>>>>>>>        Boolean bContinue
33810>>>>>>>        
33810>>>>>>>        Get pbAllowDeleteRow to bContinue
33811>>>>>>>        If (not(bContinue)) Begin
33813>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33814>>>>>>>>
33814>>>>>>>            Procedure_Return
33815>>>>>>>        End
33815>>>>>>>>
33815>>>>>>>        
33815>>>>>>>        Get Verify_Delete_msg to hmVerify
33816>>>>>>>        If (hmVerify) Begin
33818>>>>>>>            WebSet pbDeleteCallbackActive to True
33819>>>>>>>            Send VerifyRequest (RefProc(RequestDeleteCallBack)) (RefFunc(Verify_Delete_Msg))
33820>>>>>>>            Function_Return sroPending
33821>>>>>>>        End
33821>>>>>>>>
33821>>>>>>>        Else Begin
33822>>>>>>>            Send RequestDeleteExec
33823>>>>>>>            // we actually don't know if this will work or not, since this finds another row. For now, we say success
33823>>>>>>>        End
33823>>>>>>>>
33823>>>>>>>        Function_Return sroSucceed
33824>>>>>>>    End_Function
33825>>>>>>>    
33825>>>>>>>    Procedure RequestDeleteExec
33827>>>>>>>        Handle hoDD
33827>>>>>>>        RowID riSelectedRow
33827>>>>>>>        String[] aSelection
33828>>>>>>>        Integer iIndex iMainFile iOrdering
33828>>>>>>>        Boolean bDataAware bContinue bReverseOrdering
33828>>>>>>>
33828>>>>>>>        Get ListSelection to aSelection
33829>>>>>>>        If (SizeOfArray(aSelection) = 0) Begin
33831>>>>>>>            Procedure_Return
33832>>>>>>>        End
33832>>>>>>>>
33832>>>>>>>        
33832>>>>>>>        Get pbAllowDeleteRow to bContinue
33833>>>>>>>        If (not(bContinue)) Begin
33835>>>>>>>            Error DFERR_OPERATION_NOT_ALLOWED
33836>>>>>>>>
33836>>>>>>>            Procedure_Return
33837>>>>>>>        End
33837>>>>>>>>
33837>>>>>>>        
33837>>>>>>>        Get pbDataAware to bDataAware
33838>>>>>>>        
33838>>>>>>>        If (bDataAware) Begin
33840>>>>>>>            // Perform the db-aware delete
33840>>>>>>>            Get ReadingServer to hoDD
33841>>>>>>>            Get Main_File of hoDD to iMainFile
33842>>>>>>>                
33842>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33846>>>>>>>                Move (DeserializeRowID(aSelection[iIndex])) to riSelectedRow
33847>>>>>>>                
33847>>>>>>>                Get FindByRowIdEx of hoDD iMainFile riSelectedRow to bContinue
33848>>>>>>>                If (bContinue) Begin
33850>>>>>>>                    Get OnDeleteRow aSelection[iIndex] to bContinue
33851>>>>>>>                    If (bContinue) Begin
33853>>>>>>>                        Send Request_Delete to hoDD       // Perform the delete
33854>>>>>>>                        If (not(Err)) Begin
33856>>>>>>>                            Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33857>>>>>>>                            Move (RemoveFromArray(aSelection, iIndex)) to aSelection
33858>>>>>>>                        End
33858>>>>>>>>
33858>>>>>>>                        Else Begin
33859>>>>>>>                            Increment iIndex
33860>>>>>>>                        End
33860>>>>>>>>
33860>>>>>>>                    End
33860>>>>>>>>
33860>>>>>>>                    Else Begin
33861>>>>>>>                        Increment iIndex
33862>>>>>>>                    End
33862>>>>>>>>
33862>>>>>>>                End
33862>>>>>>>>
33862>>>>>>>                Else Begin
33863>>>>>>>                    Increment iIndex
33864>>>>>>>                End
33864>>>>>>>>
33864>>>>>>>            Loop
33865>>>>>>>>
33865>>>>>>>            
33865>>>>>>>            // Select the next logical row
33865>>>>>>>            Get IndexOrder to iOrdering
33866>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
33867>>>>>>>    
33867>>>>>>>            If (bReverseOrdering) Begin
33869>>>>>>>                Send Establish_Find_Direction of hoDD LT iMainFile iOrdering 
33870>>>>>>>            End
33870>>>>>>>>
33870>>>>>>>            Else Begin
33871>>>>>>>                Send Establish_Find_Direction of hoDD GT iMainFile iOrdering 
33872>>>>>>>            End
33872>>>>>>>>
33872>>>>>>>            
33872>>>>>>>            Send Locate_Next of hoDD    // Try to find the row below the deleted row.
33873>>>>>>>            
33873>>>>>>>            If (not(Found)) Begin
33875>>>>>>>                // If the row below the deleted row was not found then it means we deleted the
33875>>>>>>>                // last row. Now we will try to load the new last row. If there are no remaining
33875>>>>>>>                // rows in the dataset then the buffer will be automatically cleared (which is 
33875>>>>>>>                // what we want)
33875>>>>>>>                If (bReverseOrdering) Begin
33877>>>>>>>                    Send Request_Read of hoDD FIRST_RECORD iMainFile iOrdering
33878>>>>>>>                End
33878>>>>>>>>
33878>>>>>>>                Else Begin
33879>>>>>>>                    Send Request_Read of hoDD LAST_RECORD iMainFile iOrdering
33880>>>>>>>                End
33880>>>>>>>>
33880>>>>>>>            End
33880>>>>>>>>
33880>>>>>>>            
33880>>>>>>>            If (Found) Begin
33882>>>>>>>                Send Request_Assign of hoDD iMainFile
33883>>>>>>>            End
33883>>>>>>>>
33883>>>>>>>            Else Begin
33884>>>>>>>                Send ClearGrid
33885>>>>>>>            End
33885>>>>>>>>
33885>>>>>>>            
33885>>>>>>>            Send UpdateCurrentRowID
33886>>>>>>>        End
33886>>>>>>>>
33886>>>>>>>        Else Begin
33887>>>>>>>            While (iIndex < SizeOfArray(aSelection))
33891>>>>>>>                Get OnDeleteRow aSelection[iIndex] to bContinue
33892>>>>>>>                If (bContinue) Begin
33894>>>>>>>                    Send RemoveRow aSelection[iIndex]      // Tell the client to remove the deleted row.
33895>>>>>>>                    Move (RemoveFromArray(aSelection, iIndex)) to aSelection
33896>>>>>>>                End
33896>>>>>>>>
33896>>>>>>>                Else Begin
33897>>>>>>>                    Increment iIndex
33898>>>>>>>                End
33898>>>>>>>>
33898>>>>>>>            Loop
33899>>>>>>>>
33899>>>>>>>        End
33899>>>>>>>>
33899>>>>>>>            
33899>>>>>>>        If (iIndex) Begin
33901>>>>>>>            Send OnMultipleRowsDeletionError aSelection
33902>>>>>>>        End
33902>>>>>>>>
33902>>>>>>>        
33902>>>>>>>        WebSet pbAllSelected to False
33903>>>>>>>        Set ListSelection to aSelection
33904>>>>>>>    End_Procedure
33905>>>>>>>    
33905>>>>>>>    Procedure OnMultipleRowsDeletionError String[] aNonDeletedSelection
33907>>>>>>>        If (pbThrowErrorIfDeleteFails(Self)) Begin
33909>>>>>>>            Error DFERR_CANT_DELETE_RECORD (SFormat(C_$FailedToDeleteNrRecords, SizeOfArray(aNonDeletedSelection)))
33910>>>>>>>>
33910>>>>>>>        End
33910>>>>>>>>
33910>>>>>>>    End_Procedure
33911>>>>>>>
33911>>>>>>>End_Class
