54337>>>>>>>>>>>// This package contains the functions for creating and
54337>>>>>>>>>>>// maintaining global memory objects (Ulbe Stellema)
54337>>>>>>>>>>>
54337>>>>>>>>>>>// GlobalAlloc Flags constants:
54337>>>>>>>>>>>Define GMEM_FIXED          for |CI$0000
54337>>>>>>>>>>>Define GMEM_MOVEABLE       for |CI$0002
54337>>>>>>>>>>>Define GMEM_NOCOMPACT      for |CI$0010
54337>>>>>>>>>>>Define GMEM_NODISCARD      for |CI$0020
54337>>>>>>>>>>>Define GMEM_ZEROINIT       for |CI$0040
54337>>>>>>>>>>>Define GMEM_MODIFY         for |CI$0080
54337>>>>>>>>>>>Define GMEM_DISCARDABLE    for |CI$0100
54337>>>>>>>>>>>Define GMEM_NOT_BANKED     for |CI$1000
54337>>>>>>>>>>>Define GMEM_SHARE          for |CI$2000
54337>>>>>>>>>>>Define GMEM_DDESHARE       for |CI$2000
54337>>>>>>>>>>>Define GMEM_NOTIFY         for |CI$4000
54337>>>>>>>>>>>Define GMEM_LOWER          for GMEM_NOT_BANKED
54337>>>>>>>>>>>
54337>>>>>>>>>>>// The GlobalAlloc function allocates the specified number of bytes from the
54337>>>>>>>>>>>// heap. The 'Flags' parameter specifies how to allocate memory. If zero is
54337>>>>>>>>>>>// specified, the default is GMEM_FIXED. Except for the incompatible
54337>>>>>>>>>>>// combinations that are specifically noted, any combination of the following
54337>>>>>>>>>>>// flags can be used. To indicate whether the function allocates fixed or
54337>>>>>>>>>>>// movable memory, specify one of the first four flags.
54337>>>>>>>>>>>External_Function GlobalAlloc "GlobalAlloc" KERNEL32.DLL ;    Integer Flags Longptr Bytes Returns Handle
54338>>>>>>>>>>>
54338>>>>>>>>>>>// The GlobalDiscard function discards the specified global memory block. The
54338>>>>>>>>>>>// lock count of the memory object must be zero.
54338>>>>>>>>>>>External_Function GlobalDiscard "GlobalDiscard" KERNEL32.DLL ;    Handle MemObject Returns Handle
54339>>>>>>>>>>>
54339>>>>>>>>>>>// The GlobalFlags function returns information about the specified global
54339>>>>>>>>>>>// memory object.
54339>>>>>>>>>>>External_Function GlobalFlags "GlobalFlags" KERNEL32.DLL ;    Handle MemObject Returns Integer
54340>>>>>>>>>>>
54340>>>>>>>>>>>// The GlobalFree function frees the specified global memory object and
54340>>>>>>>>>>>// invalidates its handle.
54340>>>>>>>>>>>External_Function GlobalFree "GlobalFree" KERNEL32.DLL ;    Handle MemObject Returns Handle
54341>>>>>>>>>>>
54341>>>>>>>>>>>// The GlobalHandle function retrieves the handle associated with the
54341>>>>>>>>>>>// specified pointer to a global memory block.
54341>>>>>>>>>>>External_Function GlobalHandle "GlobalHandle" KERNEL32.DLL ;    Pointer MemObject Returns Handle
54342>>>>>>>>>>>
54342>>>>>>>>>>>// The GlobalLock function locks a global memory object and returns a pointer
54342>>>>>>>>>>>// to the first byte of the object's memory block. The memory block associated
54342>>>>>>>>>>>// with a locked memory object cannot be moved or discarded. For memory
54342>>>>>>>>>>>// objects allocated with the GMEM_MOVEABLE flag, the function increments the
54342>>>>>>>>>>>// lock count associated with the memory object.
54342>>>>>>>>>>>External_Function GlobalLock "GlobalLock" KERNEL32.DLL ;    Handle MemObject Returns Pointer
54343>>>>>>>>>>>
54343>>>>>>>>>>>// The GlobalReAlloc function changes the size or attributes of a specified
54343>>>>>>>>>>>// global memory object. The size can increase or decrease.
54343>>>>>>>>>>>External_Function GlobalReAlloc "GlobalReAlloc" KERNEL32.DLL ;    Handle MemObject Longptr Bytes Integer Flags Returns Handle
54344>>>>>>>>>>>
54344>>>>>>>>>>>// The GlobalSize function retrieves the current size, in bytes, of the
54344>>>>>>>>>>>// specified global memory object.
54344>>>>>>>>>>>External_Function GlobalSize "GlobalSize" KERNEL32.DLL ;    Handle MemObject Returns Longptr
54345>>>>>>>>>>>
54345>>>>>>>>>>>// The GlobalUnlock function decrements the lock count associated with a
54345>>>>>>>>>>>// memory object that was allocated with the GMEM_MOVEABLE flag. This function
54345>>>>>>>>>>>// has no effect on memory objects allocated with the GMEM_FIXED flag.
54345>>>>>>>>>>>External_Function GlobalUnlock "GlobalUnlock" KERNEL32.DLL ;    Handle MemObject Returns Integer
