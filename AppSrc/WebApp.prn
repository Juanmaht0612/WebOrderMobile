22848>>>>>>>>>>>    // Server-Action
22848>>>>>>>>>>>    //
22848>>>>>>>>>>>    // Part of the CallAction interface. Used to return a view's object definition to the client.
22848>>>>>>>>>>>    // Returns a structure of objects and properties for nested DDO and cWebObjects
22848>>>>>>>>>>>    // These are returned to the client as serialized JSON.
22848>>>>>>>>>>>    // sViewName     - Is the name of the view to be loaded
22848>>>>>>>>>>>    // sInvokingView - Is the name of the view that triggered the LoadView call. This is mostly used
22848>>>>>>>>>>>    //                 in the cWebDialog class when activating a modal dialog.
22848>>>>>>>>>>>    Function LoadView String sViewName String sInvokingView Returns Boolean
22850>>>>>>>>>>>        Handle hoView
22850>>>>>>>>>>>        Handle[] aDDOViews
22851>>>>>>>>>>>        String[] aLoadedViews asParams
22853>>>>>>>>>>>        Boolean bAllowAccess bLoaded bHandled
22853>>>>>>>>>>>        Handle hjObjectDef
22853>>>>>>>>>>>        tWebDDODef DDODef
22853>>>>>>>>>>>        tWebDDODef DDODef
22853>>>>>>>>>>>        String sPreLoad
22853>>>>>>>>>>>
22853>>>>>>>>>>>        // Get a handle to the view we are loading....
22853>>>>>>>>>>>        Get GetAjaxWebAppView of (phoWebControlLocator(Self)) sViewName to hoView
22854>>>>>>>>>>>        
22854>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
22856>>>>>>>>>>>            
22856>>>>>>>>>>>            // Set up the web properties system to allow WebGet to access this view....
22856>>>>>>>>>>>            Set phoLoadView to hoView
22857>>>>>>>>>>>            Send ProcessLoadViewClientSyncProps hoView
22858>>>>>>>>>>>            
22858>>>>>>>>>>>            // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22858>>>>>>>>>>>            // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22858>>>>>>>>>>>            // test AllowViewAccess of the view that is processing the call (this might be different).
22858>>>>>>>>>>>            Get AllowViewAccess hoView to bAllowAccess
22859>>>>>>>>>>>    
22859>>>>>>>>>>>            If (bAllowAccess) Begin
22861>>>>>>>>>>>                // Add to the list of views to synchronize back to the client....
22861>>>>>>>>>>>                Get paDDOViews to aDDOViews
22862>>>>>>>>>>>                If (SearchArray(hoView, aDDOViews) < 0) Begin
22864>>>>>>>>>>>                    Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22865>>>>>>>>>>>                End
22865>>>>>>>>>>>>
22865>>>>>>>>>>>                Set paDDOViews to aDDOViews
22866>>>>>>>>>>>
22866>>>>>>>>>>>                //  Perform initialization (clear, set constraints)
22866>>>>>>>>>>>                Send InitForShow of hoView                    
22867>>>>>>>>>>>                
22867>>>>>>>>>>>                // we want view sync before OnLoad
22867>>>>>>>>>>>                Send NotifySyncWebApp of hoView
22868>>>>>>>>>>>                    
22868>>>>>>>>>>>                // Serialize the view to JSON....
22868>>>>>>>>>>>                Get SerializeObject of hoView to hjObjectDef
22869>>>>>>>>>>>                Send ClientActionEarly "createView" asParams hjObjectDef    
22870>>>>>>>>>>>                Send Destroy of hjObjectDef           
22871>>>>>>>>>>>
22871>>>>>>>>>>>                // Set the psInvokingView web property. We need this to be set already during LoadView
22871>>>>>>>>>>>                // if we are loading a Modal Dialog...
22871>>>>>>>>>>>                //WebSet psInvokingView of hoView to sInvokingView
22871>>>>>>>>>>>                Send InitInvokingView to hoView sInvokingView
22872>>>>>>>>>>>                
22872>>>>>>>>>>>                Set phoLoadView to C_WebUnresolvedObject
22873>>>>>>>>>>>                
22873>>>>>>>>>>>                //  Mark view as loaded
22873>>>>>>>>>>>                WebGet paLoadedViews to aLoadedViews
22874>>>>>>>>>>>                If (SearchArray(Uppercase(sViewName), aLoadedViews) = -1) Begin
22876>>>>>>>>>>>                    Move (Uppercase(sViewName)) to aLoadedViews[SizeOfArray(aLoadedViews)]
22877>>>>>>>>>>>                    WebSet paLoadedViews to aLoadedViews
22878>>>>>>>>>>>                End            
22878>>>>>>>>>>>>
22878>>>>>>>>>>>                
22878>>>>>>>>>>>                Function_Return True
22879>>>>>>>>>>>            End
22879>>>>>>>>>>>>
22879>>>>>>>>>>>            Else Begin
22880>>>>>>>>>>>                Get ViewAccessDenied hoView False to bHandled
22881>>>>>>>>>>>            End
22881>>>>>>>>>>>>
22881>>>>>>>>>>>        End
22881>>>>>>>>>>>>
22881>>>>>>>>>>>        
22881>>>>>>>>>>>        Function_Return False
22882>>>>>>>>>>>    End_Function
22883>>>>>>>>>>>    
22883>>>>>>>>>>>    //  Loads and initializes a view asynchronously (the loading is done via a separate round-trip).
22883>>>>>>>>>>>    //  This is used for performance reasons when restoring the application state from a URL path.
22883>>>>>>>>>>>    //
22883>>>>>>>>>>>    //  Note: Should only be used when the view is not loaded to the client!!
22883>>>>>>>>>>>    //  
22883>>>>>>>>>>>    //  - hoView        Handle to the view.
22883>>>>>>>>>>>    Procedure DelayLoadview Handle hoView
22885>>>>>>>>>>>        String[] aParams
22886>>>>>>>>>>>        Handle[] aDDOViews
22887>>>>>>>>>>>        
22887>>>>>>>>>>>        // Add to the list of views to synchronize back to the client....
22887>>>>>>>>>>>        Get paDDOViews to aDDOViews
22888>>>>>>>>>>>        If (SearchArray(hoView, aDDOViews) < 0) Begin
22890>>>>>>>>>>>            Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
22891>>>>>>>>>>>        End
22891>>>>>>>>>>>>
22891>>>>>>>>>>>        Set paDDOViews to aDDOViews
22892>>>>>>>>>>>
22892>>>>>>>>>>>        //  Add load view client action
22892>>>>>>>>>>>        Get WebObjectName of hoView to aParams[0]
22893>>>>>>>>>>>        Move 1 to aParams[1]
22894>>>>>>>>>>>        Send ClientAction "loadView" aParams
22895>>>>>>>>>>>        
22895>>>>>>>>>>>        //  Initialize view
22895>>>>>>>>>>>        Send InitForShow of hoView
22896>>>>>>>>>>>        WebSet pbPreLoaded of hoView to True
22898>>>>>>>>>>>
22898>>>>>>>>>>>        //  We want view sync before OnLoad
22898>>>>>>>>>>>        Send NotifySyncWebApp of hoView
22899>>>>>>>>>>>        
22899>>>>>>>>>>>
22899>>>>>>>>>>>    End_Procedure
22900>>>>>>>>>>>      
22900>>>>>>>>>>>    
22900>>>>>>>>>>>    //  Shows a view and loads it (if nessecary). If a view is loaded and synchronized it will be 
22900>>>>>>>>>>>    //  shown directly (when returned to the client) and processing can continue. If a view is 
22900>>>>>>>>>>>    //  loaded to the client but not synchronized it depends on pbOverrideStateOnShow what happens.
22900>>>>>>>>>>>    //  If pbOverrideStateOnShow is false it will go back to the client before it continues and this 
22900>>>>>>>>>>>    //  makes the message asynchronous. If pbOverridestateOnShow is true it will continue and 
22900>>>>>>>>>>>    //  instruct the client to reinitialize the view before rendering it. If the view is not loaded
22900>>>>>>>>>>>    //  it will load the view (add the definitions to the response) and show it directly. The
22900>>>>>>>>>>>    //  optional handler message needs to be published and the object needs to be a web object.
22900>>>>>>>>>>>    //
22900>>>>>>>>>>>    //  - hoView                Handle of the view to be shown.
22900>>>>>>>>>>>    //  - hmOptCallBackMsg      (optional) Callback message executed when the view is initialized.
22900>>>>>>>>>>>    //  - hoOptCallbackObj      (optional) Object to which the callback message should be sent.
22900>>>>>>>>>>>    Procedure ShowView Handle hoView Handle hmOptCallbackMsg Handle hoOptCallbackObj
22902>>>>>>>>>>>        Boolean bIsLoaded bInSync bAllowAccess bShowDirect
22902>>>>>>>>>>>        String sView
22902>>>>>>>>>>>        String[] aParams
22903>>>>>>>>>>>        tWebClientAction tClientAction
22903>>>>>>>>>>>        tWebClientAction tClientAction
22903>>>>>>>>>>>        tWebClientAction[] aClientActions
22903>>>>>>>>>>>        tWebClientAction[] aClientActions
22904>>>>>>>>>>>        Handle hmCallbackMsg hoCallbackObj
22904>>>>>>>>>>>        Boolean bHandled
22904>>>>>>>>>>>        
22904>>>>>>>>>>>        If (num_arguments > 2) Begin
22906>>>>>>>>>>>            Move hmOptCallbackMsg to hmCallbackMsg
22907>>>>>>>>>>>            Move hoOptCallbackObj to hoCallbackObj
22908>>>>>>>>>>>        End
22908>>>>>>>>>>>>
22908>>>>>>>>>>>        
22908>>>>>>>>>>>        Move False to bShowDirect
22909>>>>>>>>>>>        
22909>>>>>>>>>>>        Get WebObjectName of hoView to sView
22910>>>>>>>>>>>                
22910>>>>>>>>>>>        // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
22910>>>>>>>>>>>        // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
22910>>>>>>>>>>>        // test AllowViewAccess of the view that is processing the call (this might be different).
22910>>>>>>>>>>>        Get AllowViewAccess hoView to bAllowAccess
22911>>>>>>>>>>>        If (not(bAllowAccess)) Begin
22913>>>>>>>>>>>            Get ViewAccessDenied hoView False to bHandled
22914>>>>>>>>>>>            Procedure_Return
22915>>>>>>>>>>>        End
22915>>>>>>>>>>>>
22915>>>>>>>>>>>        
22915>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22916>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22917>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22919>>>>>>>>>>>            //  If the view is not loaded we load it now
22919>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22920>>>>>>>>>>>            If (bIsLoaded) Begin
22922>>>>>>>>>>>                Move True to bShowDirect
22923>>>>>>>>>>>            End
22923>>>>>>>>>>>>
22923>>>>>>>>>>>        End
22923>>>>>>>>>>>>
22923>>>>>>>>>>>        Else Begin
22924>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22925>>>>>>>>>>>            If (bInSync) Begin
22927>>>>>>>>>>>                Move True to bShowDirect
22928>>>>>>>>>>>            End
22928>>>>>>>>>>>>
22928>>>>>>>>>>>            Else Begin
22929>>>>>>>>>>>                If (pbOverrideStateOnShow(hoView)) Begin
22931>>>>>>>>>>>                    //  If pbOverrideStateOnShow is true we can override it by unloading it on the client and simply loading it fresh (we used to do sneaky things here before 20.0)
22931>>>>>>>>>>>                    
22931>>>>>>>>>>>                    //  Add an early executed action to unload the view
22931>>>>>>>>>>>                    Move "unloadView"   to tClientAction.sName
22932>>>>>>>>>>>                    Move ""             to tClientAction.sTarget
22933>>>>>>>>>>>                    Move ctExecEarly    to tClientAction.eType
22934>>>>>>>>>>>                    Move sView          to tClientAction.aParams[0]
22935>>>>>>>>>>>                    
22935>>>>>>>>>>>                    Get paClientActions to aClientActions
22936>>>>>>>>>>>                    Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
22937>>>>>>>>>>>                    Set paClientActions to aClientActions
22938>>>>>>>>>>>                    
22938>>>>>>>>>>>                    //  Load the view fresh and show when succesfull
22938>>>>>>>>>>>                    Get LoadView sView 0 to bIsLoaded
22939>>>>>>>>>>>                    If (bIsLoaded) Begin
22941>>>>>>>>>>>                        Move True to bShowDirect
22942>>>>>>>>>>>                    End
22942>>>>>>>>>>>>
22942>>>>>>>>>>>                End
22942>>>>>>>>>>>>
22942>>>>>>>>>>>                Else Begin
22943>>>>>>>>>>>                    //  We need to go to the client first
22943>>>>>>>>>>>                    Move sView to aParams[0]
22944>>>>>>>>>>>                    
22944>>>>>>>>>>>                    If (hmCallbackMsg > 0) Begin
22946>>>>>>>>>>>                        Get WebMethodName of hoCallbackObj hmCallbackMsg to aParams[1]
22947>>>>>>>>>>>                        Get WebObjectName of hoCallbackObj to aParams[2]
22948>>>>>>>>>>>                    End
22948>>>>>>>>>>>>
22948>>>>>>>>>>>                    
22948>>>>>>>>>>>                    Send ClientAction "showView" aParams
22949>>>>>>>>>>>                End
22949>>>>>>>>>>>>
22949>>>>>>>>>>>            End
22949>>>>>>>>>>>>
22949>>>>>>>>>>>        End
22949>>>>>>>>>>>>
22949>>>>>>>>>>>        
22949>>>>>>>>>>>        If (bShowDirect) Begin
22951>>>>>>>>>>>            // Do callback
22951>>>>>>>>>>>            If (hmCallbackMsg > 0) Begin
22953>>>>>>>>>>>                Send hmCallbackMsg of hoCallbackObj hoView
22954>>>>>>>>>>>            End
22954>>>>>>>>>>>>
22954>>>>>>>>>>>            
22954>>>>>>>>>>>            // Directly show the view
22954>>>>>>>>>>>            Send ShowView_Exec hoView False
22955>>>>>>>>>>>        End    
22955>>>>>>>>>>>>
22955>>>>>>>>>>>    End_Procedure
22956>>>>>>>>>>>    
22956>>>>>>>>>>>    
22956>>>>>>>>>>>    //  Actually shows the view by sending doShow and performing the renderView client action.
22956>>>>>>>>>>>    //
22956>>>>>>>>>>>    //  - hoView        Handle of the view object to the be shown.
22956>>>>>>>>>>>    //  - bStandalone   If true this is a standalone view (oWebApp.displayView(..)) and not 
22956>>>>>>>>>>>    //                  rendered by renderview.
22956>>>>>>>>>>>    Procedure ShowView_Exec Handle hoView Boolean bStandalone
22958>>>>>>>>>>>        String[] aParams
22959>>>>>>>>>>>        String sView
22959>>>>>>>>>>>        Handle hoInvokingView
22959>>>>>>>>>>>        
22959>>>>>>>>>>>        //  Check if the showview is not overriden by a different ShowView call inside OnNavigateForward, phoCurrentShowView should be set before this function is called
22959>>>>>>>>>>>        If (phoCurrentShowView(Self) = hoView or (phoCurrentShowView(Self) <> C_WebUnresolvedObject and IsDialog(phoCurrentShowView(Self)))) Begin
22961>>>>>>>>>>>            Send DoShow of hoView
22962>>>>>>>>>>>            Get WebObjectName of hoView to sView
22963>>>>>>>>>>>            
22963>>>>>>>>>>>            WebSet psCurrentView to sView
22964>>>>>>>>>>>            
22964>>>>>>>>>>>            If (not(bStandalone)) Begin
22966>>>>>>>>>>>                Move sView to aParams[0]
22967>>>>>>>>>>>                Send ClientAction "renderView" aParams
22968>>>>>>>>>>>            End
22968>>>>>>>>>>>>
22968>>>>>>>>>>>            
22968>>>>>>>>>>>            Set phoCurrentShowView to C_WebUnresolvedObject
22969>>>>>>>>>>>        End
22969>>>>>>>>>>>>
22969>>>>>>>>>>>    End_Procedure
22970>>>>>>>>>>>    
22970>>>>>>>>>>>    
22970>>>>>>>>>>>    //  Server-Action
22970>>>>>>>>>>>    //
22970>>>>>>>>>>>    //  Called by the JavaScript Engine to show a view. This can either be initiated by the server 
22970>>>>>>>>>>>    //  via ShowView (view was loaded to the client but not in sync) or be initiated from the 
22970>>>>>>>>>>>    //  client like with cWebMenuItemLoadView.
22970>>>>>>>>>>>    //
22970>>>>>>>>>>>    //  - sView         Name of the view.
22970>>>>>>>>>>>    //  - bStandalone   True if the view is shown separately (oWebApp.displayView).
22970>>>>>>>>>>>    //  - sOptCallbackMsg   (optional) String with the published procedure that needs to be called 
22970>>>>>>>>>>>    //                      when the view is initialized.
22970>>>>>>>>>>>    //  - sOptCallback      (optional) Name of the web object handling the callback message.
22970>>>>>>>>>>>    Procedure ShowView_FromClient String sView Boolean bStandalone String sOptCallbackMsg String sOptCallbackObj
22972>>>>>>>>>>>        Handle hoView hmCallbackMsg hoCallbackObj
22972>>>>>>>>>>>        Boolean bIsLoaded bInSync
22972>>>>>>>>>>>        
22972>>>>>>>>>>>        If (num_arguments > 3) Begin
22974>>>>>>>>>>>            Get WebObjectByName sOptCallbackObj to hoCallbackObj
22975>>>>>>>>>>>            If (hoCallbackObj > 0) Begin
22977>>>>>>>>>>>                Get WebMethodByName of hoCallbackObj sOptCallbackMsg to hmCallbackMsg
22978>>>>>>>>>>>            End
22978>>>>>>>>>>>>
22978>>>>>>>>>>>        End
22978>>>>>>>>>>>>
22978>>>>>>>>>>>        
22978>>>>>>>>>>>        Get WebObjectByName sView to hoView
22979>>>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
22980>>>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
22981>>>>>>>>>>>        
22981>>>>>>>>>>>        If (not(bIsLoaded)) Begin
22983>>>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
22984>>>>>>>>>>>            If (bIsLoaded) Begin
22986>>>>>>>>>>>                
22986>>>>>>>>>>>                // Do callback
22986>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22988>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
22989>>>>>>>>>>>                End
22989>>>>>>>>>>>>
22989>>>>>>>>>>>                
22989>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
22990>>>>>>>>>>>            End
22990>>>>>>>>>>>>
22990>>>>>>>>>>>        End
22990>>>>>>>>>>>>
22990>>>>>>>>>>>        Else Begin
22991>>>>>>>>>>>            Get IsViewInSync hoView to bInSync
22992>>>>>>>>>>>            If (bInSync) Begin
22994>>>>>>>>>>>                // Do callback
22994>>>>>>>>>>>                If (hmCallbackMsg > 0) Begin
22996>>>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
22997>>>>>>>>>>>                End
22997>>>>>>>>>>>>
22997>>>>>>>>>>>                
22997>>>>>>>>>>>                Send ShowView_Exec hoView bStandalone
22998>>>>>>>>>>>            End
22998>>>>>>>>>>>>
22998>>>>>>>>>>>            Else Begin
22999>>>>>>>>>>>                Error DFERR_OPERATOR "ShowView_FromClient requires view to be synchronized if loaded."
23000>>>>>>>>>>>>
23000>>>>>>>>>>>            End
23000>>>>>>>>>>>>
23000>>>>>>>>>>>        End
23000>>>>>>>>>>>>
23000>>>>>>>>>>>    End_Procedure
23001>>>>>>>>>>>    
23001>>>>>>>>>>>    
23001>>>>>>>>>>>    // Client Action: Sends unloadView to the client to remove the passed view and its web properties.
23001>>>>>>>>>>>    // An Unloaded view must be reloaded from the server before it can be displayed again (using LoadView). 
23001>>>>>>>>>>>    // Note, unloading a view is more secure than hiding it because its data is removed from the client.
23001>>>>>>>>>>>    // See also "Unload" method of cWebView.
23001>>>>>>>>>>>    // See also "LoadView"
23001>>>>>>>>>>>    Procedure UnloadView Handle hoView
23003>>>>>>>>>>>        String sViewName
23003>>>>>>>>>>>        String[] aParams
23004>>>>>>>>>>>        
23004>>>>>>>>>>>        Get Object_Label of hoView to sViewName
23005>>>>>>>>>>>        Move sViewName      to aParams[0]   // Pass the view name as the 1st parameter.
23006>>>>>>>>>>>        Move True           to aParams[1]
23007>>>>>>>>>>>        Send ClientAction "unloadView" aParams
23008>>>>>>>>>>>    End_Procedure
23009>>>>>>>>>>>    
23009>>>>>>>>>>>    
23009>>>>>>>>>>>    // Triggers when the page title is automatically updated and concatenates the the application 
23009>>>>>>>>>>>    // title with the view title. Can be augmented / overriden to 
23009>>>>>>>>>>>    //
23009>>>>>>>>>>>    // Params:
23009>>>>>>>>>>>    //      ByRef sTitle    Contains the page title when coming in, should receive the full title.
23009>>>>>>>>>>>    //      hoView          Handle to the current view (can be C_WebUnresolvedObject).
23009>>>>>>>>>>>    //      sViewTitle      Current caption of the view (can be "").
23009>>>>>>>>>>>    Procedure OnGeneratePageTitle String ByRef sTitle Handle hoView String sViewTitle
23011>>>>>>>>>>>        If (Trim(sViewTitle) <> "") Begin
23013>>>>>>>>>>>            Move (sTitle + " - " + sViewTitle) to sTitle
23014>>>>>>>>>>>        End
23014>>>>>>>>>>>>
23014>>>>>>>>>>>    End_Procedure
23015>>>>>>>>>>>    
23015>>>>>>>>>>>    
23015>>>>>>>>>>>    // Updates the page title by generating the full title based on the passed view title.
23015>>>>>>>>>>>    //
23015>>>>>>>>>>>    // Params:
23015>>>>>>>>>>>    //      hoView      Handle to the current view (can be C_WebUnresolvedObject).
23015>>>>>>>>>>>    //      sViewTitle  Current view caption.
23015>>>>>>>>>>>    Procedure UpdatePageTitle Handle hoView String sViewTitle
23017>>>>>>>>>>>        String sTitle
23017>>>>>>>>>>>        Boolean bUpdate
23017>>>>>>>>>>>        
23017>>>>>>>>>>>        WebGet pbUpdateApplicationTitle to bUpdate
23018>>>>>>>>>>>        
23018>>>>>>>>>>>        If (bUpdate) Begin
23020>>>>>>>>>>>            WebGet psApplicationTitle to sTitle
23021>>>>>>>>>>>            
23021>>>>>>>>>>>            Send OnGeneratePageTitle (&sTitle) hoView sViewTitle
23022>>>>>>>>>>>            
23022>>>>>>>>>>>            Send SetPageTitle sTitle
23023>>>>>>>>>>>        End
23023>>>>>>>>>>>>
23023>>>>>>>>>>>    End_Procedure
23024>>>>>>>>>>>
23024>>>>>>>>>>>
23024>>>>>>>>>>>    // This can be sent to any child object to retrieve the object handle of the parent view via delegation.
23024>>>>>>>>>>>    // If delegation reaches here it means there is no view object so we return C_WebUnresolvedObject.
23024>>>>>>>>>>>    Function ViewObject Returns Handle
23026>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23027>>>>>>>>>>>    End_Function
23028>>>>>>>>>>>    
23028>>>>>>>>>>>    
23028>>>>>>>>>>>    // Locate_Server and Server are used so that child objects can resolve 
23028>>>>>>>>>>>    // that a server does not exit.
23028>>>>>>>>>>>    Function Locate_Server Returns Handle
23030>>>>>>>>>>>        Function_Return 0
23031>>>>>>>>>>>    End_Function
23032>>>>>>>>>>>    
23032>>>>>>>>>>>    
23032>>>>>>>>>>>    Function Server Returns Handle
23034>>>>>>>>>>>        Function_Return 0
23035>>>>>>>>>>>    End_Function
23036>>>>>>>>>>>
23036>>>>>>>>>>>    // Determines if an initial view (like a login dialog) needs to be shown. Overriden in
23036>>>>>>>>>>>    // cWebSessionHost_mixin to handle showing of a login view.
23036>>>>>>>>>>>    //
23036>>>>>>>>>>>    // Returns:
23036>>>>>>>>>>>    //  Handle to the initial view that needs to be shown (C_WebUnresolvedObject if none)
23036>>>>>>>>>>>    Function ForcedInitialView Returns Handle
23038>>>>>>>>>>>        Function_Return C_WebUnresolvedObject
23039>>>>>>>>>>>    End_Function
23040>>>>>>>>>>>
23040>>>>>>>>>>>    // returns the default view, which is normally phoDefaultView.
23040>>>>>>>>>>>    // Is provided for augmentation so developers can specify the default view dynamically
23040>>>>>>>>>>>    Function GetDefaultView Returns Handle
23042>>>>>>>>>>>        Handle hoView
23042>>>>>>>>>>>        Get phoDefaultView to hoView
23043>>>>>>>>>>>        Function_Return hoView
23044>>>>>>>>>>>    End_Function
23045>>>>>>>>>>>
23045>>>>>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
23045>>>>>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
23045>>>>>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
23045>>>>>>>>>>>    // of each view referenced in the aDDODefs collection
23045>>>>>>>>>>>    //
23045>>>>>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
23045>>>>>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
23045>>>>>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
23047>>>>>>>>>>>        Integer i icDDODef
23047>>>>>>>>>>>        Handle[] aDDOViews
23048>>>>>>>>>>>        Handle hoInvokingObject
23048>>>>>>>>>>>        
23048>>>>>>>>>>>        Send NotifySyncWebApp         
23049>>>>>>>>>>>        
23049>>>>>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
23049>>>>>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
23050>>>>>>>>>>>        
23050>>>>>>>>>>>        //  First get all the object references
23050>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23056>>>>>>>>>>>>
23056>>>>>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
23056>>>>>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
23057>>>>>>>>>>>        Loop
23058>>>>>>>>>>>>
23058>>>>>>>>>>>        
23058>>>>>>>>>>>        Set paDDOViews to aDDOViews
23059>>>>>>>>>>>        
23059>>>>>>>>>>>        //  Now update data bindings (note that this needs to happen after paDDOViews is set for accessibility checks
23059>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23065>>>>>>>>>>>>
23065>>>>>>>>>>>            // Process the synchronized psValue and pbChanged properties for each control that has a data binding
23065>>>>>>>>>>>            Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
23067>>>>>>>>>>>            
23067>>>>>>>>>>>            // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
23067>>>>>>>>>>>            Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
23068>>>>>>>>>>>        Loop
23069>>>>>>>>>>>>
23069>>>>>>>>>>>    End_Procedure
23070>>>>>>>>>>>
23070>>>>>>>>>>>    Procedure Call_PostOnCallEnd tWebCallContext ByRef cctx
23072>>>>>>>>>>>        Integer i icDDODef
23072>>>>>>>>>>>        Handle[] aDDOViews
23073>>>>>>>>>>>        
23073>>>>>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
23073>>>>>>>>>>>        Get paDDOViews to aDDOViews
23074>>>>>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
23075>>>>>>>>>>>        
23075>>>>>>>>>>>        For i from 0 to (icDDODef - 1)
23081>>>>>>>>>>>>
23081>>>>>>>>>>>            Send TriggerOnCallEnd of aDDOViews[i]
23082>>>>>>>>>>>        Loop
23083>>>>>>>>>>>>
23083>>>>>>>>>>>        
23083>>>>>>>>>>>        Send TriggerOnCallEnd
23084>>>>>>>>>>>    End_Procedure
23085>>>>>>>>>>>    
23085>>>>>>>>>>>    // This event is sent for every AJAX call to this view. This can be used by your
23085>>>>>>>>>>>    // security rights management system to set various global rights and roles constraints
23085>>>>>>>>>>>    // properties during each AJAX call.
23085>>>>>>>>>>>    // Note: You should not use web properties for this purpose since synchronized
23085>>>>>>>>>>>    // properties are sync'ed to the client and thus considered insecure.
23085>>>>>>>>>>>    Procedure OnSyncWebApp
23087>>>>>>>>>>>    End_Procedure
23088>>>>>>>>>>>    
23088>>>>>>>>>>>    Procedure NotifySyncWebApp
23090>>>>>>>>>>>        Send OnSyncWebApp
23091>>>>>>>>>>>    End_Procedure
23092>>>>>>>>>>>
23092>>>>>>>>>>>    Procedure End_Construct_cWebViewHost_mixin
23094>>>>>>>>>>>        WebPublishFunction LoadView
23095>>>>>>>>>>>        WebPublishProcedure LoadViewCallBack_CallBack
23096>>>>>>>>>>>        WebPublishProcedure ShowView_FromClient
23097>>>>>>>>>>>    End_Procedure
23098>>>>>>>>>>>
23098>>>>>>>>>>>End_Class
23099>>>>>>>>>
23099>>>>>>>>>Register_Procedure OnUpdateViewStack
23099>>>>>>>>>
23099>>>>>>>>>// Singleton stack object. Store and manipulates information about the stack of views
23099>>>>>>>>>// in a drill-down navigation architecture.
23099>>>>>>>>>Class cWebViewStack is a cWebObject
23100>>>>>>>>>    
23100>>>>>>>>>    Procedure Construct_Object
23102>>>>>>>>>        Forward Send Construct_Object
23104>>>>>>>>>        
23104>>>>>>>>>        // Global handle is deprecated.
23104>>>>>>>>>        Move Self to ghoWebViewStack
23105>>>>>>>>>        // Set the viewstack of the cWebApp or cLocalWebControlHost to this object
23105>>>>>>>>>        Set phoViewStack of (Host(Self)) to Self
23106>>>>>>>>>        
23106>>>>>>>>>        Property tWebViewInfo[] paViewStack    // The stack of current views navigated to in the drill-down view stack.
23109>>>>>>>>>        
23109>>>>>>>>>        Property Handle[] paClientControls     // Array of client web controls that are notified whenever the view stack is modified
23110>>>>>>>>>    End_Procedure 
23111>>>>>>>>>
23111>>>>>>>>>    
23111>>>>>>>>>    // Returns the total number of views currently in the view stack.
23111>>>>>>>>>    Function ViewStackSize Returns Integer
23113>>>>>>>>>        Integer iCount
23113>>>>>>>>>        tWebViewInfo[] aViewStack
23113>>>>>>>>>        tWebViewInfo[] aViewStack
23114>>>>>>>>>        WebGet paViewStack to aViewStack
23115>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23116>>>>>>>>>        Function_Return iCount
23117>>>>>>>>>    End_Function
23118>>>>>>>>>
23118>>>>>>>>>        
23118>>>>>>>>>    // Adds a new client object to the set of listening client objects.
23118>>>>>>>>>    // See also NotifyClients
23118>>>>>>>>>    Procedure AddClient Handle hoClient
23120>>>>>>>>>        Integer iCount
23120>>>>>>>>>        Handle[] aClientControls
23121>>>>>>>>>        
23121>>>>>>>>>        Get paClientControls to aClientControls
23122>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23123>>>>>>>>>        Move hoClient to aClientControls[iCount]
23124>>>>>>>>>        Set paClientControls to aClientControls
23125>>>>>>>>>    End_Procedure
23126>>>>>>>>>
23126>>>>>>>>>
23126>>>>>>>>>
23126>>>>>>>>>    // sReason - [Out] Passes back the reason why Pop View is not allowed.
23126>>>>>>>>>    // Returns true if you can pop the passed View. 
23126>>>>>>>>>    // Returns False if the view is not at the top of the stack
23126>>>>>>>>>    Function CanPopView Handle hoView String ByRef sReason Returns Boolean
23128>>>>>>>>>        Integer iCount
23128>>>>>>>>>        String sViewName
23128>>>>>>>>>        tWebViewInfo[] aViewStack
23128>>>>>>>>>        tWebViewInfo[] aViewStack
23129>>>>>>>>>        
23129>>>>>>>>>        //Send DeserializeViewStack
23129>>>>>>>>>        WebGet paViewStack to aViewStack
23130>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
23131>>>>>>>>>        Get WebObjectName of hoView to sViewName
23132>>>>>>>>>        
23132>>>>>>>>>        If (iCount > 0 and sViewName = aViewStack[iCount-1].sViewName) Begin
23134>>>>>>>>>            Function_Return True
23135>>>>>>>>>        End
23135>>>>>>>>>>
23135>>>>>>>>>        Else Begin
23136>>>>>>>>>            Move "This is not the top view." to sReason
23137>>>>>>>>>            Function_Return False
23138>>>>>>>>>        End
23138>>>>>>>>>>
23138>>>>>>>>>    End_Function
23139>>>>>>>>>    
23139>>>>>>>>>    // sReason - [Out] Passes back the reason why Push View is not allowed.
23139>>>>>>>>>    // Returns true if you can push the passed View. 
23139>>>>>>>>>    // Returns False If the view is already on the view stack.
23139>>>>>>>>>    Function CanPushView Handle hoView String ByRef sReason Returns Boolean
23141>>>>>>>>>        Integer iIndex
23141>>>>>>>>>        Boolean bOK
23141>>>>>>>>>        
23141>>>>>>>>>        Get GetViewIndex hoView to iIndex
23142>>>>>>>>>        Move (iIndex = -1) to bOK
23143>>>>>>>>>        If (not(bOK)) Begin
23145>>>>>>>>>            Move "View is already in the view stack." to sReason        
23146>>>>>>>>>        End
23146>>>>>>>>>>
23146>>>>>>>>>        Function_Return bOK
23147>>>>>>>>>    End_Function
23148>>>>>>>>>
23148>>>>>>>>>    
23148>>>>>>>>>    // Returns the index in the view stack of the passed view handle. 
23148>>>>>>>>>    // Returns -1 if the view is not in the stack
23148>>>>>>>>>    Function GetViewIndex Handle hoView Returns Integer
23150>>>>>>>>>        Integer i iCount
23150>>>>>>>>>        String sViewName
23150>>>>>>>>>        tWebViewInfo[] aViewStack
23150>>>>>>>>>        tWebViewInfo[] aViewStack
23151>>>>>>>>>
23151>>>>>>>>>        If (hoView <> 0) Begin        
23153>>>>>>>>>            WebGet paViewStack to aViewStack
23154>>>>>>>>>            Move (SizeOfArray(aViewStack)) to iCount
23155>>>>>>>>>            Get WebObjectName of hoView to sViewName
23156>>>>>>>>>            
23156>>>>>>>>>            For i from 0 to (iCount-1)
23162>>>>>>>>>>
23162>>>>>>>>>                If (sViewName = aViewStack[i].sViewName) Begin
23164>>>>>>>>>                    Function_Return i
23165>>>>>>>>>                End
23165>>>>>>>>>>
23165>>>>>>>>>            Loop
23166>>>>>>>>>>
23166>>>>>>>>>        End
23166>>>>>>>>>>
23166>>>>>>>>>        
23166>>>>>>>>>        Function_Return -1
23167>>>>>>>>>    End_Function
23168>>>>>>>>>
23168>>>>>>>>>
23168>>>>>>>>>    // Returns the view handle of the view below the top of stack. 
23168>>>>>>>>>    // Returns 0 If there are less than two views in the stack.
23168>>>>>>>>>    // See also TopViewHandle.
23168>>>>>>>>>    Function InvokingViewHandle Returns Handle
23170>>>>>>>>>        Integer iTop
23170>>>>>>>>>        Handle hoView
23170>>>>>>>>>        tWebViewInfo[] aViewStack
23170>>>>>>>>>        tWebViewInfo[] aViewStack
23171>>>>>>>>>
23171>>>>>>>>>        // Update the stack
23171>>>>>>>>>        //Send DeserializeViewStack
23171>>>>>>>>>        WebGet paViewStack to aViewStack
23172>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23173>>>>>>>>>            
23173>>>>>>>>>        If (iTop < 2) Begin
23175>>>>>>>>>            Function_Return 0
23176>>>>>>>>>        End
23176>>>>>>>>>>
23176>>>>>>>>>        Else Begin
23177>>>>>>>>>            Get WebObjectByName aViewStack[iTop-2].sViewName to hoView
23178>>>>>>>>>            Function_Return hoView
23179>>>>>>>>>        End
23179>>>>>>>>>>
23179>>>>>>>>>    End_Function
23180>>>>>>>>>    
23180>>>>>>>>>    // Returns the view handle of the invoking view of a specific view that is on the stack. 
23180>>>>>>>>>    // Returns C_WebUnresolvedObject if the view is not found on the stack.
23180>>>>>>>>>    Function InvokingViewHandleByView Handle hoView Returns Handle
23182>>>>>>>>>        Integer iIndex
23182>>>>>>>>>
23182>>>>>>>>>        tWebViewInfo[] aViewStack
23182>>>>>>>>>        tWebViewInfo[] aViewStack
23183>>>>>>>>>
23183>>>>>>>>>        // Update the stack
23183>>>>>>>>>        //Send DeserializeViewStack
23183>>>>>>>>>        WebGet paViewStack to aViewStack
23184>>>>>>>>>        
23184>>>>>>>>>        Get GetViewIndex hoView to iIndex
23185>>>>>>>>>        If (iIndex > 0) Begin
23187>>>>>>>>>       
23187>>>>>>>>>            Get WebObjectByName aViewStack[iIndex-1].sViewName to hoView
23188>>>>>>>>>            Function_Return hoView
23189>>>>>>>>>        End
23189>>>>>>>>>>
23189>>>>>>>>>        
23189>>>>>>>>>        Function_Return C_WebUnresolvedObject
23190>>>>>>>>>    End_Function
23191>>>>>>>>>    
23191>>>>>>>>>    
23191>>>>>>>>>    // Returns the view in the stack after the passed view. So the view of which the passed view is
23191>>>>>>>>>    // the invoking view. If the passed view is not in the stack or is the top view then
23191>>>>>>>>>    // C_WebUnresolvedObject will be returned.
23191>>>>>>>>>    Function NextViewHandleByView Handle hoView Returns Handle
23193>>>>>>>>>        Integer iIndex
23193>>>>>>>>>
23193>>>>>>>>>        tWebViewInfo[] aViewStack
23193>>>>>>>>>        tWebViewInfo[] aViewStack
23194>>>>>>>>>
23194>>>>>>>>>        // Update the stack
23194>>>>>>>>>        //Send DeserializeViewStack
23194>>>>>>>>>        WebGet paViewStack to aViewStack
23195>>>>>>>>>        
23195>>>>>>>>>        Get GetViewIndex hoView to iIndex
23196>>>>>>>>>        If (iIndex < SizeOfArray(aViewStack) - 1) Begin
23198>>>>>>>>>       
23198>>>>>>>>>            Get WebObjectByName aViewStack[iIndex+1].sViewName to hoView
23199>>>>>>>>>            Function_Return hoView
23200>>>>>>>>>        End
23200>>>>>>>>>>
23200>>>>>>>>>        
23200>>>>>>>>>        Function_Return C_WebUnresolvedObject
23201>>>>>>>>>    End_Function
23202>>>>>>>>>
23202>>>>>>>>>    
23202>>>>>>>>>    // Notifies all listening client objects that the view stack has changed.
23202>>>>>>>>>    // These objects must understand the OnUpdateViewStack event.
23202>>>>>>>>>    // See also AddClient
23202>>>>>>>>>    Procedure NotifyClients
23204>>>>>>>>>        Integer i iCount
23204>>>>>>>>>        Handle[] aClientControls
23205>>>>>>>>>        
23205>>>>>>>>>        Get paClientControls to aClientControls
23206>>>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
23207>>>>>>>>>        
23207>>>>>>>>>        For i from 0 to (iCount-1)
23213>>>>>>>>>>
23213>>>>>>>>>            Send OnUpdateViewStack to aClientControls[i]
23214>>>>>>>>>        Loop
23215>>>>>>>>>>
23215>>>>>>>>>    End_Procedure
23216>>>>>>>>>    
23216>>>>>>>>>    
23216>>>>>>>>>    // Pops all members of the stack down to the passed view handle. If the view is
23216>>>>>>>>>    // not on the stack then nothing is removed.
23216>>>>>>>>>    Procedure PopDownToView Handle hoView
23218>>>>>>>>>        Integer iIndex iTopOfStack
23218>>>>>>>>>        tWebViewInfo[] aViewStack
23218>>>>>>>>>        tWebViewInfo[] aViewStack
23219>>>>>>>>>
23219>>>>>>>>>        Get GetViewIndex hoView to iIndex
23220>>>>>>>>>        
23220>>>>>>>>>        If (iIndex <> -1) Begin
23222>>>>>>>>>            // Update the stack
23222>>>>>>>>>            WebGet paViewStack to aViewStack
23223>>>>>>>>>            Move (ResizeArray(aViewStack, iIndex+1)) to aViewStack
23224>>>>>>>>>            WebSet paViewStack to aViewStack        
23225>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23226>>>>>>>>>        End
23226>>>>>>>>>>
23226>>>>>>>>>    End_Procedure
23227>>>>>>>>>
23227>>>>>>>>>
23227>>>>>>>>>    // Pops a view off the top of the view stack.
23227>>>>>>>>>    Procedure PopView
23229>>>>>>>>>        Integer iTop
23229>>>>>>>>>        tWebViewInfo[] aViewStack
23229>>>>>>>>>        tWebViewInfo[] aViewStack
23230>>>>>>>>>
23230>>>>>>>>>        // Update the stack
23230>>>>>>>>>        WebGet paViewStack to aViewStack
23231>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23232>>>>>>>>>        
23232>>>>>>>>>        If (iTop = 0) Begin
23234>>>>>>>>>            Error DFERR_PROGRAM "View Stack Error: Pop past end of stack"
23235>>>>>>>>>>
23235>>>>>>>>>        End
23235>>>>>>>>>>
23235>>>>>>>>>        Else Begin
23236>>>>>>>>>            Move (ResizeArray(aViewStack, iTop - 1)) to aViewStack
23237>>>>>>>>>            WebSet paViewStack to aViewStack        
23238>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23239>>>>>>>>>        End
23239>>>>>>>>>>
23239>>>>>>>>>    End_Procedure
23240>>>>>>>>>
23240>>>>>>>>>    
23240>>>>>>>>>    // Pushes a new view to the top of the view stack (Note: we assume hoView's web properties are in scope).
23240>>>>>>>>>    Procedure PushView Handle hoView Integer eNavigateType
23242>>>>>>>>>        Handle hoMainDD
23242>>>>>>>>>        Integer iTop
23242>>>>>>>>>        tWebViewInfo ViewInfo
23242>>>>>>>>>        tWebViewInfo ViewInfo
23242>>>>>>>>>        tWebViewInfo[] aViewStack
23242>>>>>>>>>        tWebViewInfo[] aViewStack
23243>>>>>>>>>        RowID riId
23243>>>>>>>>>        // Before pushing any new view onto the stack we want 
23243>>>>>>>>>        // to retrieve the latest "Should_Save state of the
23243>>>>>>>>>        // current top view...
23243>>>>>>>>>        Send UpdateShouldSave
23244>>>>>>>>>        
23244>>>>>>>>>        // Populate the ViewInfo struct
23244>>>>>>>>>        Get WebObjectName of hoView  to ViewInfo.sViewName
23245>>>>>>>>>        WebGet psCaption of hoView   to ViewInfo.sCaption
23246>>>>>>>>>        Move ViewInfo.sCaption       to ViewInfo.sHeaderCaption    // by default these are both set to the same value
23247>>>>>>>>>        Get peViewType of hoView     to ViewInfo.eViewType
23248>>>>>>>>>        Move eNavigateType           to ViewInfo.eNavigateType 
23249>>>>>>>>>        
23249>>>>>>>>>        Get Main_DD of hoView to hoMainDD
23250>>>>>>>>>        If (hoMainDD <> 0) Begin
23252>>>>>>>>>            Get Main_File of hoMainDD to ViewInfo.iMainTable
23253>>>>>>>>>            Get CurrentRowId of hoMainDD to riId
23254>>>>>>>>>            Move riId to ViewInfo.riMainTable
23255>>>>>>>>>//            Move (SerializeRowID(riId)) to ViewInfo.sMainTableRowID
23255>>>>>>>>>        End
23255>>>>>>>>>>
23255>>>>>>>>>        
23255>>>>>>>>>        // Update the stack
23255>>>>>>>>>        WebGet paViewStack to aViewStack
23256>>>>>>>>>        Move (InsertInArray(aViewStack,-1,ViewInfo)) to aViewStack
23257>>>>>>>>>        WebSet paViewStack to aViewStack        
23258>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23259>>>>>>>>>    End_Procedure
23260>>>>>>>>>    
23260>>>>>>>>>    // returns handle of object we can close up to
23260>>>>>>>>>    // hoCloseToView is the view you want to close to. If 0, it's all.
23260>>>>>>>>>    // bSkipTop deremines if you should skip the top of the stack, which sometimes gets special
23260>>>>>>>>>    // treatment.
23260>>>>>>>>>    Function CanCloseViews Handle hoCloseToView Boolean bSkipTop Returns Handle
23262>>>>>>>>>        tWebViewInfo[] aViewStack
23262>>>>>>>>>        tWebViewInfo[] aViewStack
23263>>>>>>>>>        Integer iStackViews eCloseAction
23263>>>>>>>>>        Handle hoView
23263>>>>>>>>>        Boolean bStop
23263>>>>>>>>>        Send UpdateShouldSave to (ViewStack(Self))
23264>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
23265>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackViews
23266>>>>>>>>>        If bSkipTop Begin
23268>>>>>>>>>            Decrement iStackViews
23269>>>>>>>>>        End
23269>>>>>>>>>>
23269>>>>>>>>>        While (iStackViews and not(bStop))
23273>>>>>>>>>            Decrement iStackViews
23274>>>>>>>>>            Get WebObjectByName aViewStack[iStackViews].sViewName to hoView
23275>>>>>>>>>            If (hoView=hoCloseToView) Begin
23277>>>>>>>>>                Move 0 to iStackViews
23278>>>>>>>>>            End
23278>>>>>>>>>>
23278>>>>>>>>>            Else If (aViewStack[iStackViews].bShouldSave) Begin
23281>>>>>>>>>                Get GetChangedViewExitAction of hoView to eCloseAction 
23282>>>>>>>>>                // we only allow a close if it is a pure adandon changes.
23282>>>>>>>>>                If (eCloseAction<>cveAbandonChanges) Begin
23284>>>>>>>>>                   Function_Return hoView 
23285>>>>>>>>>                End
23285>>>>>>>>>>
23285>>>>>>>>>            End
23285>>>>>>>>>>
23285>>>>>>>>>        Loop
23286>>>>>>>>>>
23286>>>>>>>>>        Function_Return hoCloseToView
23287>>>>>>>>>    End_Function
23288>>>>>>>>>    
23288>>>>>>>>>    // Clears the view stack.
23288>>>>>>>>>    // bDefaultView - Pass True if the default view should be pushed onto the
23288>>>>>>>>>    //                view stack automatically after it is reset.
23288>>>>>>>>>    // Returns - True if the Reset succeeded.
23288>>>>>>>>>    //           False if the View stack could not be reset (usually due to unsaved changes in
23288>>>>>>>>>    //           one of the current views in the stack).
23288>>>>>>>>>    Function Reset Boolean bDefaultView Boolean bUnconditional Returns Boolean
23290>>>>>>>>>        Handle hoShouldSaveView 
23290>>>>>>>>>        Handle hoTopView hoDefaultView
23290>>>>>>>>>        Integer iDefaultViewIndex
23290>>>>>>>>>        tWebViewInfo[] aViewStack
23290>>>>>>>>>        tWebViewInfo[] aViewStack
23291>>>>>>>>>        String sReason
23291>>>>>>>>>        
23291>>>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefaultView
23292>>>>>>>>>        Get TopViewHandle to hoTopView
23293>>>>>>>>>        
23293>>>>>>>>>        // First see if it is OK to close all of the current views down
23293>>>>>>>>>        // to the current first view.
23293>>>>>>>>>        If bUnconditional Begin
23295>>>>>>>>>            Move hoDefaultView to hoShouldSaveView
23296>>>>>>>>>        End
23296>>>>>>>>>>
23296>>>>>>>>>        Else Begin
23297>>>>>>>>>            Get CanCloseViews hoDefaultView False to hoShouldSaveView
23298>>>>>>>>>        End
23298>>>>>>>>>>
23298>>>>>>>>>        If (hoShouldSaveView<>hoDefaultView) Begin
23300>>>>>>>>>            If (hoShouldSaveView <> hoTopView) Begin
23302>>>>>>>>>                Send ShowView to (Host(Self)) hoShouldSaveView
23303>>>>>>>>>            End
23303>>>>>>>>>>
23303>>>>>>>>>            Send PopDownToView of (ViewStack(Self)) hoShouldSaveView
23304>>>>>>>>>            Send UpdateInvokingViewDrillDownStyle to hoShouldSaveView
23305>>>>>>>>>            Send CantCloseChangedViewError
23306>>>>>>>>>            Function_Return False
23307>>>>>>>>>        End
23307>>>>>>>>>>
23307>>>>>>>>>        
23307>>>>>>>>>        // If we got here then we can reset the stack...
23307>>>>>>>>>        If (hoTopView <> 0) Begin
23309>>>>>>>>>            If (hoDefaultView <> hoTopView or not(bDefaultView)) Begin
23311>>>>>>>>>                Send Hide to hoTopView    // First hide the current view
23312>>>>>>>>>            End
23312>>>>>>>>>>
23312>>>>>>>>>        End
23312>>>>>>>>>>
23312>>>>>>>>>        
23312>>>>>>>>>        // Make sure we do not clear the default view off the stack
23312>>>>>>>>>        If (bDefaultView and hoDefaultView <> 0) Begin
23314>>>>>>>>>            // Test that the default view is the first view in the stack
23314>>>>>>>>>            Get GetViewIndex hoDefaultView to iDefaultViewIndex
23315>>>>>>>>>            
23315>>>>>>>>>            If (iDefaultViewIndex = 0) Begin
23317>>>>>>>>>                WebGet paViewStack to aViewStack
23318>>>>>>>>>                Move (ResizeArray(aViewStack, 1)) to aViewStack
23319>>>>>>>>>            End
23319>>>>>>>>>>
23319>>>>>>>>>        End
23319>>>>>>>>>>
23319>>>>>>>>>        
23319>>>>>>>>>        // Clear the stack
23319>>>>>>>>>        WebSet paViewStack to aViewStack        
23320>>>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
23321>>>>>>>>>        
23321>>>>>>>>>        Function_Return True
23322>>>>>>>>>    End_Function
23323>>>>>>>>>
23323>>>>>>>>>
23323>>>>>>>>>//    // Returns the view handle of the top most view that has a should save flag 
23323>>>>>>>>>//    // set to True. Returns 0 if there are no views with should save = True.
23323>>>>>>>>>//    // hoAboveView - Only checks views in the view stack above this view handle
23323>>>>>>>>>//    //               pass 0 to check the entire stack
23323>>>>>>>>>//    Function TopShouldSaveViewHandles Handle hoAboveView Returns Handle[]
23323>>>>>>>>>//        Handle[] hoShouldSaveViews
23323>>>>>>>>>//        Integer i iCount iAboveView iChanged
23323>>>>>>>>>//        tWebViewInfo[] aViewStack
23323>>>>>>>>>//        
23323>>>>>>>>>//        // search the view stack....
23323>>>>>>>>>//        
23323>>>>>>>>>//        Get GetViewIndex hoAboveView to iAboveView
23323>>>>>>>>>//        //Send DeserializeViewStack
23323>>>>>>>>>//        WebGet paViewStack to aViewStack
23323>>>>>>>>>//        Move (SizeOfArray(aViewStack)) to iCount
23323>>>>>>>>>//        Increment iAboveView
23323>>>>>>>>>//        For i from iAboveView to (iCount-1)
23323>>>>>>>>>//            If (aViewStack[i].bShouldSave) Begin
23323>>>>>>>>>//                Get WebObjectByName aViewStack[i].sViewName to hoShouldSaveViews[iChanged]
23323>>>>>>>>>//                Increment iChanged
23323>>>>>>>>>//            End
23323>>>>>>>>>//        Loop
23323>>>>>>>>>//        Function_Return hoShouldSaveViews
23323>>>>>>>>>//    End_Function
23323>>>>>>>>>
23323>>>>>>>>>
23323>>>>>>>>>    // Returns the view handle of the top of stack. Returns 0 if the Stack is empty.
23323>>>>>>>>>    // See also InvokingViewHandle.
23323>>>>>>>>>    Function TopViewHandle Returns Handle
23325>>>>>>>>>        Integer iTop
23325>>>>>>>>>        Handle hoView
23325>>>>>>>>>        tWebViewInfo[] aViewStack
23325>>>>>>>>>        tWebViewInfo[] aViewStack
23326>>>>>>>>>
23326>>>>>>>>>        // Update the stack
23326>>>>>>>>>        WebGet paViewStack to aViewStack
23327>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23328>>>>>>>>>            
23328>>>>>>>>>        If (iTop = 0) Begin
23330>>>>>>>>>            Function_Return C_WebUnresolvedObject
23331>>>>>>>>>        End
23331>>>>>>>>>>
23331>>>>>>>>>        Else Begin
23332>>>>>>>>>            Get WebObjectByName aViewStack[iTop-1].sViewName to hoView
23333>>>>>>>>>            Function_Return hoView
23334>>>>>>>>>        End
23334>>>>>>>>>>
23334>>>>>>>>>    End_Function
23335>>>>>>>>>    
23335>>>>>>>>>    
23335>>>>>>>>>    // Updates the Should Save value of the top view in the view stack
23335>>>>>>>>>    Procedure UpdateShouldSave
23337>>>>>>>>>        Integer iTop
23337>>>>>>>>>        Handle hoView hoMain_DD
23337>>>>>>>>>        tWebViewInfo[] aViewStack
23337>>>>>>>>>        tWebViewInfo[] aViewStack
23338>>>>>>>>>
23338>>>>>>>>>        // Update the stack
23338>>>>>>>>>        //Send DeserializeViewStack
23338>>>>>>>>>        WebGet paViewStack to aViewStack
23339>>>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
23340>>>>>>>>>            
23340>>>>>>>>>        If (iTop > 0) Begin
23342>>>>>>>>>            Get WebObjectByName aViewStack[iTop-1].sViewName to hoView
23343>>>>>>>>>            Get IsViewChanged of hoView to aViewStack[iTop-1].bShouldSave
23344>>>>>>>>>            WebSet paViewStack to aViewStack
23345>>>>>>>>>        End
23345>>>>>>>>>>
23345>>>>>>>>>    End_Procedure
23346>>>>>>>>>    
23346>>>>>>>>>    // dynamically change the breadcrumb caption for a view
23346>>>>>>>>>    Procedure SetCaption Handle hoView String sCaption
23348>>>>>>>>>        tWebViewInfo[] aViewStack
23348>>>>>>>>>        tWebViewInfo[] aViewStack
23349>>>>>>>>>        Integer iIndex
23349>>>>>>>>>        Get GetViewIndex hoView to iIndex
23350>>>>>>>>>        If (iIndex>=0) Begin
23352>>>>>>>>>            WebGet paViewStack to aViewStack 
23353>>>>>>>>>            Move sCaption to aViewStack[iIndex].sCaption
23354>>>>>>>>>            WebSet paViewStack to aViewStack 
23355>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23356>>>>>>>>>        End
23356>>>>>>>>>>
23356>>>>>>>>>    End_Procedure
23357>>>>>>>>>
23357>>>>>>>>>    // get breadcrumb caption for this view
23357>>>>>>>>>    Function GetCaption Handle hoView Returns String
23359>>>>>>>>>        tWebViewInfo[] aViewStack
23359>>>>>>>>>        tWebViewInfo[] aViewStack
23360>>>>>>>>>        Integer iIndex
23360>>>>>>>>>        Get GetViewIndex hoView to iIndex
23361>>>>>>>>>        If (iIndex>=0) Begin
23363>>>>>>>>>            WebGet paViewStack to aViewStack 
23364>>>>>>>>>            Function_Return aViewStack[iIndex].sCaption
23365>>>>>>>>>        End
23365>>>>>>>>>>
23365>>>>>>>>>    End_Function
23366>>>>>>>>>    
23366>>>>>>>>>    // dynamically change the "header" caption for a view
23366>>>>>>>>>    Procedure SetHeaderCaption Handle hoView String sCaption
23368>>>>>>>>>        tWebViewInfo[] aViewStack
23368>>>>>>>>>        tWebViewInfo[] aViewStack
23369>>>>>>>>>        Integer iIndex
23369>>>>>>>>>        Get GetViewIndex hoView to iIndex
23370>>>>>>>>>        If (iIndex>=0) Begin
23372>>>>>>>>>            WebGet paViewStack to aViewStack 
23373>>>>>>>>>            Move sCaption to aViewStack[iIndex].sHeaderCaption
23374>>>>>>>>>            WebSet paViewStack to aViewStack 
23375>>>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
23376>>>>>>>>>        End
23376>>>>>>>>>>
23376>>>>>>>>>    End_Procedure
23377>>>>>>>>>
23377>>>>>>>>>    // get header caption for this view
23377>>>>>>>>>    Function GetHeaderCaption Handle hoView Returns String
23379>>>>>>>>>        tWebViewInfo[] aViewStack
23379>>>>>>>>>        tWebViewInfo[] aViewStack
23380>>>>>>>>>        Integer iIndex
23380>>>>>>>>>        Get GetViewIndex hoView to iIndex
23381>>>>>>>>>        If (iIndex>=0) Begin
23383>>>>>>>>>            WebGet paViewStack to aViewStack 
23384>>>>>>>>>            Function_Return aViewStack[iIndex].sHeaderCaption
23385>>>>>>>>>        End
23385>>>>>>>>>>
23385>>>>>>>>>    End_Function
23386>>>>>>>>>
23386>>>>>>>>>    // Send this to the stack view to Navigate Back down the View Stack to this view.
23386>>>>>>>>>    // The target view can be in any position in the current view stack, but 
23386>>>>>>>>>    // it must belong to the current view stack.
23386>>>>>>>>>    //
23386>>>>>>>>>    // Each view in the view stack, above the target view, will be tested for
23386>>>>>>>>>    // data loss (pending saves). If one of the higher views requires a save
23386>>>>>>>>>    // then it will be activated instead and the "save changes" message will
23386>>>>>>>>>    // be shown.
23386>>>>>>>>>    //
23386>>>>>>>>>    // Typically, this message will be called by a breadcrumb navigation control.
23386>>>>>>>>>    //
23386>>>>>>>>>    Procedure NavigateBack Handle hoTargetView Boolean bUnconditional
23388>>>>>>>>>        Handle hoView hoInvokingView hoTopView  
23388>>>>>>>>>        Integer iIndex
23388>>>>>>>>>        Boolean bTopChanged
23388>>>>>>>>>        Integer iStackViews
23388>>>>>>>>>        tWebViewInfo[] aViewStack
23388>>>>>>>>>        tWebViewInfo[] aViewStack
23389>>>>>>>>>        
23389>>>>>>>>>        Get TopViewHandle to hoTopView
23390>>>>>>>>>        If not hoTopView Begin
23392>>>>>>>>>            Procedure_Return
23393>>>>>>>>>        End
23393>>>>>>>>>>
23393>>>>>>>>>        
23393>>>>>>>>>        Get GetViewIndex hoTargetView to iIndex
23394>>>>>>>>>        If (iIndex=-1) Begin
23396>>>>>>>>>            Error DFERR_PROGRAM "Target view not in view stack"
23397>>>>>>>>>>
23397>>>>>>>>>            Procedure_Return
23398>>>>>>>>>        End
23398>>>>>>>>>>
23398>>>>>>>>>
23398>>>>>>>>>        If bUnconditional Begin
23400>>>>>>>>>            Move hoTargetView to hoView
23401>>>>>>>>>        End
23401>>>>>>>>>>
23401>>>>>>>>>        Else Begin
23402>>>>>>>>>            Get InvokingViewHandle to hoInvokingView
23403>>>>>>>>>    
23403>>>>>>>>>            If (hoTargetView = hoInvokingView) Begin
23405>>>>>>>>>                Send NavigateCancel of hoTopView
23406>>>>>>>>>                Procedure_Return
23407>>>>>>>>>            End
23407>>>>>>>>>>
23407>>>>>>>>>    
23407>>>>>>>>>            // If we are not the current top then make sure we are not popping off
23407>>>>>>>>>            // any views that have pending changes (should save)...
23407>>>>>>>>>            Get IsViewChanged of hoTopView to bTopChanged
23408>>>>>>>>>            Get CanCloseViews hoTargetView True to hoView
23409>>>>>>>>>            If (hoView = hoTargetView and bTopChanged) Begin
23411>>>>>>>>>               Send NavigateCancelTo of hoTopView hoView 
23412>>>>>>>>>               Procedure_Return
23413>>>>>>>>>            End
23413>>>>>>>>>>
23413>>>>>>>>>            Else If (bTopChanged) Begin
23416>>>>>>>>>               Move hoTopView to hoView 
23417>>>>>>>>>            End
23417>>>>>>>>>>
23417>>>>>>>>>    
23417>>>>>>>>>            If (hoView <> hoTargetView) Begin
23419>>>>>>>>>                Send CantCloseChangedViewError
23420>>>>>>>>>            End
23420>>>>>>>>>>
23420>>>>>>>>>        End
23420>>>>>>>>>>
23420>>>>>>>>>        // finish the navigation back to the view
23420>>>>>>>>>        If (hoView <> hoTopView) Begin
23422>>>>>>>>>            Send NavigateBackToHere of hoView True 0
23423>>>>>>>>>        End
23423>>>>>>>>>>
23423>>>>>>>>>    End_Procedure
23424>>>>>>>>>
23424>>>>>>>>>    // navigate back to named view.
23424>>>>>>>>>    Procedure NavigateBackByName String sViewName
23426>>>>>>>>>        Handle hoView hoTopView
23426>>>>>>>>>        If (sViewName <> "") Begin
23428>>>>>>>>>            Get WebObjectByName sViewName to hoView
23429>>>>>>>>>            Get TopViewHandle to hoTopView
