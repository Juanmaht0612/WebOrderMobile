37092>>>>>>>    // =========================
37092>>>>>>>    // DYNAMIC OBJECTS RENDERING
37092>>>>>>>    // =========================
37092>>>>>>>   
37092>>>>>>>    // This function either loads all dynamic objects for the first time, 
37092>>>>>>>    // or it performs an incremental update by inserting a new object.
37092>>>>>>>    Procedure Activate
37094>>>>>>>        Boolean bActivated
37094>>>>>>>        Integer iIndex
37094>>>>>>>        String[] aEmptyArray aChildren
37096>>>>>>>        Handle hoQueuedSyncPropsJson hoObjectsJson
37096>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
37096>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
37097>>>>>>>        tWebDynamicObject tDynamicObject
37097>>>>>>>        tWebDynamicObject tDynamicObject
37097>>>>>>>        tWebDynamicObject[] aDynamicObjects
37097>>>>>>>        tWebDynamicObject[] aDynamicObjects
37098>>>>>>>        
37098>>>>>>>        WebGet pbActivated to bActivated
37099>>>>>>>        
37099>>>>>>>        If (not(bActivated)) Begin
37101>>>>>>>            Send ConnectRadioButtons
37102>>>>>>>            
37102>>>>>>>            Get SerializeContainer to hoObjectsJson 
37103>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
37104>>>>>>>            
37104>>>>>>>            // Send objects to client
37104>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
37105>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
37106>>>>>>>
37106>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
37107>>>>>>>            Send ClientActionEx "loadDynamicObjects" aEmptyArray hoObjectsJson
37108>>>>>>>            
37108>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
37109>>>>>>>            Send Destroy of hoObjectsJson
37110>>>>>>>              
37110>>>>>>>            // Finish rendering
37110>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
37111>>>>>>>            Move "" to tDynamicObject.sId
37112>>>>>>>            
37112>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
37113>>>>>>>            If (iIndex <> -1) Begin
37115>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
37116>>>>>>>                Send FinishRendering aChildren
37117>>>>>>>            End
37117>>>>>>>>
37117>>>>>>>        End
37117>>>>>>>>
37117>>>>>>>    End_Procedure
37118>>>>>>>    
37118>>>>>>>    
