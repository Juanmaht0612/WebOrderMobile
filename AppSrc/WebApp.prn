30672>>>>>>>    // Your user login system should call this whenever the logged-in user changes, or their rights & roles are
30672>>>>>>>    // modified.
30672>>>>>>>    //
30672>>>>>>>    // This sends NotifyChangeRights to the command bar (which will create its own cascade or NotifyChangeRights/OnChangeRights)
30672>>>>>>>    // and then sends OnChangeRights.
30672>>>>>>>    Procedure FireNotifyChangeRights
30674>>>>>>>        Handle hoCommandBar
30674>>>>>>>        Integer i iCount
30674>>>>>>>        Handle[] aClients
30675>>>>>>>        
30675>>>>>>>        // Notify all listners....
30675>>>>>>>        Get paChangeRightsClients to aClients
30676>>>>>>>        Move (SizeOfArray(aClients)) to iCount
30677>>>>>>>        
30677>>>>>>>        For i from 0 to (iCount-1)
30683>>>>>>>>
30683>>>>>>>            Send NotifyChangeRights of aClients[i]
30684>>>>>>>        Loop
30685>>>>>>>>
30685>>>>>>>        
30685>>>>>>>        // Notify the command bar...
30685>>>>>>>        Get phoCommandBar to hoCommandBar
30686>>>>>>>        If (hoCommandBar) Begin
30688>>>>>>>            Send NotifyChangeRights of hoCommandBar
30689>>>>>>>        End
30689>>>>>>>>
30689>>>>>>>
30689>>>>>>>        // Review: Determine if we should also send NotifyChangeRights/OnChangeRights to all views.
30689>>>>>>>        
30689>>>>>>>        Send OnChangeRights    // Send to self
30690>>>>>>>    End_Procedure
