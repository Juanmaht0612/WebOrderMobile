24051>>>>>>>>>>>>>>>>>>>    
24051>>>>>>>>>>>>>>>>>>>    // This function returns the object id of the database agent of this object, or 0.
24051>>>>>>>>>>>>>>>>>>>    // If this object's Server is 0, this object's parent's Server is returned, if any.
24051>>>>>>>>>>>>>>>>>>>    // This function is used to allow nested data-entry objects to use the
24051>>>>>>>>>>>>>>>>>>>    // database agent defined by their parent object.
24051>>>>>>>>>>>>>>>>>>>    Function Server Returns Integer
24053>>>>>>>>>>>>>>>>>>>        Integer hoServer
24053>>>>>>>>>>>>>>>>>>>        Get private_Server to hoServer
24054>>>>>>>>>>>>>>>>>>>        If (hoServer = 0) Begin
24056>>>>>>>>>>>>>>>>>>>            Function_Return (Locate_Server(parent(Self)))
24057>>>>>>>>>>>>>>>>>>>        End
24057>>>>>>>>>>>>>>>>>>>>
24057>>>>>>>>>>>>>>>>>>>        Function_Return hoServer
24058>>>>>>>>>>>>>>>>>>>    End_Function
24059>>>>>>>>>>>>>>>>>>>    
24059>>>>>>>>>>>>>>>>>>>    // This procedure sets the value of the Server property of this object,
24059>>>>>>>>>>>>>>>>>>>    // notifying child-objects of the change, and destroying and creating
24059>>>>>>>>>>>>>>>>>>>    // connections with database agents, as required.
24059>>>>>>>>>>>>>>>>>>>    // If the Server of this object is changed while this object is inactive,
24059>>>>>>>>>>>>>>>>>>>    // no notification of child-objects is required or performed.
24059>>>>>>>>>>>>>>>>>>>    Procedure Set Server Integer newVal
24061>>>>>>>>>>>>>>>>>>>        Integer oldVal
24061>>>>>>>>>>>>>>>>>>>        
24061>>>>>>>>>>>>>>>>>>>        Set Explicit_Server_State to (newVal <> 0)
24062>>>>>>>>>>>>>>>>>>>        Get Server to oldVal
24063>>>>>>>>>>>>>>>>>>>        
24063>>>>>>>>>>>>>>>>>>>        If (newVal <> 0) Begin
24065>>>>>>>>>>>>>>>>>>>            Set private_Server to (object_id(newVal))
24066>>>>>>>>>>>>>>>>>>>        End
24066>>>>>>>>>>>>>>>>>>>>
24066>>>>>>>>>>>>>>>>>>>        Else Begin
24067>>>>>>>>>>>>>>>>>>>            Set private_Server to newVal
24068>>>>>>>>>>>>>>>>>>>        End
24068>>>>>>>>>>>>>>>>>>>>
24068>>>>>>>>>>>>>>>>>>>        
24068>>>>>>>>>>>>>>>>>>>        If (Active_State(Self)) Begin
24070>>>>>>>>>>>>>>>>>>>            Broadcast Send server_changed oldVal newVal
24072>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) Begin
24074>>>>>>>>>>>>>>>>>>>                Send Remove_DEO_From_Server  // detach from current server
24075>>>>>>>>>>>>>>>>>>>            End
24075>>>>>>>>>>>>>>>>>>>>
24075>>>>>>>>>>>>>>>>>>>            If (newval <> 0) Begin
24077>>>>>>>>>>>>>>>>>>>                Send Attach_Deo_To_Server    // attach to new server
24078>>>>>>>>>>>>>>>>>>>            End
24078>>>>>>>>>>>>>>>>>>>>
24078>>>>>>>>>>>>>>>>>>>        End
24078>>>>>>>>>>>>>>>>>>>>
24078>>>>>>>>>>>>>>>>>>>    End_Procedure
24079>>>>>>>>>>>>>>>>>>>    
24079>>>>>>>>>>>>>>>>>>>    //   This procedure servers as notification of a change in the connection
24079>>>>>>>>>>>>>>>>>>>    //   of this object's parent to its database agent.  If this object uses
24079>>>>>>>>>>>>>>>>>>>    //   its parent's database agent by default (see the Server and Find_Server
24079>>>>>>>>>>>>>>>>>>>    //   functions, above), it must disconnect from the old agent and connect
24079>>>>>>>>>>>>>>>>>>>    //   with the new agent.
24079>>>>>>>>>>>>>>>>>>>    Procedure Server_Changed Integer oldVal Integer newVal
24081>>>>>>>>>>>>>>>>>>>        Integer oldSrvr
24081>>>>>>>>>>>>>>>>>>>        
24081>>>>>>>>>>>>>>>>>>>        Get private_Server to oldSrvr
24082>>>>>>>>>>>>>>>>>>>        If (oldSrvr = 0) Begin  //assumes Server(self) = oldVal by deleg
24084>>>>>>>>>>>>>>>>>>>            If (oldVal <> 0) ;                Send remove_user_interface to oldVal Self
24087>>>>>>>>>>>>>>>>>>>            If (newVal <> 0) ;                Send add_user_interface to newVal Self
24090>>>>>>>>>>>>>>>>>>>        End
24090>>>>>>>>>>>>>>>>>>>>
24090>>>>>>>>>>>>>>>>>>>    End_Procedure
24091>>>>>>>>>>>>>>>>>>>    
24091>>>>>>>>>>>>>>>>>>>    // return the DEO that sets the server
24091>>>>>>>>>>>>>>>>>>>    Function ServerDEO Returns Handle
24093>>>>>>>>>>>>>>>>>>>        Handle hoServer hoServerDeo
24093>>>>>>>>>>>>>>>>>>>        Boolean bExplicitServer
24093>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
24094>>>>>>>>>>>>>>>>>>>        If (hoServer) Begin
24096>>>>>>>>>>>>>>>>>>>            Get Explicit_Server_State to bExplicitServer
24097>>>>>>>>>>>>>>>>>>>            If (bExplicitServer) Begin
24099>>>>>>>>>>>>>>>>>>>                Move Self to hoServerDeo
24100>>>>>>>>>>>>>>>>>>>            End
24100>>>>>>>>>>>>>>>>>>>>
24100>>>>>>>>>>>>>>>>>>>            Else Begin
24101>>>>>>>>>>>>>>>>>>>                Delegate Get ServerDEO to hoServerDeo
24103>>>>>>>>>>>>>>>>>>>            End
24103>>>>>>>>>>>>>>>>>>>>
24103>>>>>>>>>>>>>>>>>>>        End
24103>>>>>>>>>>>>>>>>>>>>
24103>>>>>>>>>>>>>>>>>>>        Function_Return hoServerDeo
24104>>>>>>>>>>>>>>>>>>>    End_Function
