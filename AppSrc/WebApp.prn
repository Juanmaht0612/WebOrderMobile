24482>>>>>>>>>>>>>>>>>    
24482>>>>>>>>>>>>>>>>>    Function CheckAllEntryItem String[] ByRef aValues String sSearch Boolean bCase Boolean bFullText Boolean bValidationTable Returns Boolean
24484>>>>>>>>>>>>>>>>>        Integer iFile iField iCount iLen iMainFile iParentField
24484>>>>>>>>>>>>>>>>>        Boolean bRetVal
24484>>>>>>>>>>>>>>>>>        String sValue sLowSearch
24484>>>>>>>>>>>>>>>>>        Handle hoServer
24484>>>>>>>>>>>>>>>>>        Integer[] iaDataFiles iaDataFields
24486>>>>>>>>>>>>>>>>>        String[] aEntryValues
24487>>>>>>>>>>>>>>>>>        
24487>>>>>>>>>>>>>>>>>        Move (Length(sSearch)) to iLen
24488>>>>>>>>>>>>>>>>>        
24488>>>>>>>>>>>>>>>>>        If (not (bValidationTable)) Begin
24490>>>>>>>>>>>>>>>>>            Get Server to hoServer
24491>>>>>>>>>>>>>>>>>            Get Main_File of hoServer to iMainFile
24492>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaDataFiles
24493>>>>>>>>>>>>>>>>>            Get piaDataFields to iaDataFields
24494>>>>>>>>>>>>>>>>>            
24494>>>>>>>>>>>>>>>>>            Move (Lowercase(sSearch)) to sLowSearch
24495>>>>>>>>>>>>>>>>>            Move False to bRetVal
24496>>>>>>>>>>>>>>>>>            
24496>>>>>>>>>>>>>>>>>            For iCount from 0 to (SizeOfArray(iaDataFiles) - 1)
24502>>>>>>>>>>>>>>>>>>
24502>>>>>>>>>>>>>>>>>                Move iaDataFiles[iCount] to iFile
24503>>>>>>>>>>>>>>>>>                Move iaDataFields[iCount] to iField
24504>>>>>>>>>>>>>>>>>                
24504>>>>>>>>>>>>>>>>>                If (iMainFile = iFile) Begin
24506>>>>>>>>>>>>>>>>>                    Get_Field_Value iFile iField to sValue
24509>>>>>>>>>>>>>>>>>                    Move (Trim(sValue)) to sValue
24510>>>>>>>>>>>>>>>>>                    
24510>>>>>>>>>>>>>>>>>                    If (not(bRetVal)) Begin
24512>>>>>>>>>>>>>>>>>                        If (not (bFullText)) Begin
24514>>>>>>>>>>>>>>>>>                            If ((not(bCase) and Lowercase(Left(sValue, iLen)) = sLowSearch) or (bCase and Left(sValue, iLen) = sSearch)) Begin
24516>>>>>>>>>>>>>>>>>                                Move True to bRetVal
24517>>>>>>>>>>>>>>>>>                            End
24517>>>>>>>>>>>>>>>>>>
24517>>>>>>>>>>>>>>>>>                        End
24517>>>>>>>>>>>>>>>>>>
24517>>>>>>>>>>>>>>>>>                        Else Begin
24518>>>>>>>>>>>>>>>>>                            If ((bCase and sValue contains sSearch) or (not(bCase) and Lowercase(sValue) contains sLowSearch)) Begin
24520>>>>>>>>>>>>>>>>>                                Move True to bRetVal
24521>>>>>>>>>>>>>>>>>                            End
24521>>>>>>>>>>>>>>>>>>
24521>>>>>>>>>>>>>>>>>                        End
24521>>>>>>>>>>>>>>>>>>
24521>>>>>>>>>>>>>>>>>                    End
24521>>>>>>>>>>>>>>>>>>
24521>>>>>>>>>>>>>>>>>                    
24521>>>>>>>>>>>>>>>>>                    If (SearchArray(sValue, aEntryValues) = -1) Begin
24523>>>>>>>>>>>>>>>>>                        Move sValue to aEntryValues[-1]
24524>>>>>>>>>>>>>>>>>                    End
24524>>>>>>>>>>>>>>>>>>
24524>>>>>>>>>>>>>>>>>                End
24524>>>>>>>>>>>>>>>>>>
24524>>>>>>>>>>>>>>>>>            Loop
24525>>>>>>>>>>>>>>>>>>
24525>>>>>>>>>>>>>>>>>            
24525>>>>>>>>>>>>>>>>>            If (bRetVal) Begin
24527>>>>>>>>>>>>>>>>>                Move aEntryValues to aValues
24528>>>>>>>>>>>>>>>>>            End
24528>>>>>>>>>>>>>>>>>>
24528>>>>>>>>>>>>>>>>>        End
24528>>>>>>>>>>>>>>>>>>
24528>>>>>>>>>>>>>>>>>        Else Begin
24529>>>>>>>>>>>>>>>>>            Move (Lowercase(sSearch)) to sLowSearch
24530>>>>>>>>>>>>>>>>>            Move False to bRetVal
24531>>>>>>>>>>>>>>>>>
24531>>>>>>>>>>>>>>>>>            For iCount from 0 to (SizeOfArray(aValues) - 1)
24537>>>>>>>>>>>>>>>>>>
24537>>>>>>>>>>>>>>>>>                Move aValues[iCount] to sValue
24538>>>>>>>>>>>>>>>>>                If ((bFullText and ((bCase and sValue contains sSearch) or ;                    (not(bCase) and Lowercase(sValue) contains sLowSearch))) or ;                    (not(bFullText) and ((bCase and Left(sValue, iLen) = sSearch) or ;                    (not(bCase) and Lowercase(Left(sValue, iLen)) = sLowSearch)))) Begin
24540>>>>>>>>>>>>>>>>>                    Move True to bRetVal
24541>>>>>>>>>>>>>>>>>                End
24541>>>>>>>>>>>>>>>>>>
24541>>>>>>>>>>>>>>>>>            Loop
24542>>>>>>>>>>>>>>>>>>
24542>>>>>>>>>>>>>>>>>        End
24542>>>>>>>>>>>>>>>>>>
24542>>>>>>>>>>>>>>>>>        
24542>>>>>>>>>>>>>>>>>        Function_Return bRetVal
24543>>>>>>>>>>>>>>>>>    End_Function
24544>>>>>>>>>>>>>>>>>    
24544>>>>>>>>>>>>>>>>>    Procedure FindIncremental tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24546>>>>>>>>>>>>>>>>>        Integer iIndex iLen eType iLength iDec iFile iField iItemIndex
24546>>>>>>>>>>>>>>>>>        Boolean bCase bOldRelate bNeedsRelate bSuccess bBreak bAllData bSupportsFilters bOrigActive bFilterApplied bOk bScanAll
24546>>>>>>>>>>>>>>>>>        String sLowSearch sRowId sValue sOrigFilter
24546>>>>>>>>>>>>>>>>>        String[] aEntryValues
24547>>>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
24549>>>>>>>>>>>>>>>>>        RowID riTest
24549>>>>>>>>>>>>>>>>>        Handle hoServer
24549>>>>>>>>>>>>>>>>>        
24549>>>>>>>>>>>>>>>>>        Get Server to hoServer
24550>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24551>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24552>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24553>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24554>>>>>>>>>>>>>>>>>        
24554>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24556>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24557>>>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
24558>>>>>>>>>>>>>>>>>            
24558>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to eType
24561>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iLength
24564>>>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_PRECISION of iFile iField to iDec
24567>>>>>>>>>>>>>>>>>            
24567>>>>>>>>>>>>>>>>>            Move (iLength - iDec) to iLength
24568>>>>>>>>>>>>>>>>>            
24568>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24573>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24576>>>>>>>>>>>>>>>>>            
24576>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24577>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24578>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24579>>>>>>>>>>>>>>>>>            
24579>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24579>>>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
24580>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24581>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24582>>>>>>>>>>>>>>>>>            Move (SizeOfArray(iaFiles) > 1) to bScanAll
24583>>>>>>>>>>>>>>>>>                            
24583>>>>>>>>>>>>>>>>>            Move (Length(sFilter)) to iLen
24584>>>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
24585>>>>>>>>>>>>>>>>>            Move False to bSuccess
24586>>>>>>>>>>>>>>>>>            
24586>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24586>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24588>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24589>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24591>>>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
24592>>>>>>>>>>>>>>>>>                End
24592>>>>>>>>>>>>>>>>>>
24592>>>>>>>>>>>>>>>>>            End
24592>>>>>>>>>>>>>>>>>>
24592>>>>>>>>>>>>>>>>>            
24592>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24594>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24596>>>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24597>>>>>>>>>>>>>>>>>                End
24597>>>>>>>>>>>>>>>>>>
24597>>>>>>>>>>>>>>>>>                If (bScanAll or bFilterApplied) Begin
24599>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24600>>>>>>>>>>>>>>>>>                End
24600>>>>>>>>>>>>>>>>>>
24600>>>>>>>>>>>>>>>>>                Else Begin
24601>>>>>>>>>>>>>>>>>                    Set_Field_Value iFile iField to sFilter
24604>>>>>>>>>>>>>>>>>                    Send Request_Read of hoServer GE iFile iIndex
24605>>>>>>>>>>>>>>>>>                End
24605>>>>>>>>>>>>>>>>>>
24605>>>>>>>>>>>>>>>>>            End
24605>>>>>>>>>>>>>>>>>>
24605>>>>>>>>>>>>>>>>>            Else Begin
24606>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24607>>>>>>>>>>>>>>>>>            End
24607>>>>>>>>>>>>>>>>>>
24607>>>>>>>>>>>>>>>>>            
24607>>>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData) and not(bBreak))
24611>>>>>>>>>>>>>>>>>                Move False to bBreak
24612>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24613>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase False False to bOk
24614>>>>>>>>>>>>>>>>>                If (bOk) Begin
24616>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24617>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24618>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0]) 
24619>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24620>>>>>>>>>>>>>>>>>                End
24620>>>>>>>>>>>>>>>>>>
24620>>>>>>>>>>>>>>>>>                Else Begin
24621>>>>>>>>>>>>>>>>>                    If (bScanAll or bFilterApplied) Begin
24623>>>>>>>>>>>>>>>>>                        Move False to bBreak
24624>>>>>>>>>>>>>>>>>                    End
24624>>>>>>>>>>>>>>>>>>
24624>>>>>>>>>>>>>>>>>                    Else Begin
24625>>>>>>>>>>>>>>>>>                        Move True to bBreak
24626>>>>>>>>>>>>>>>>>                    End
24626>>>>>>>>>>>>>>>>>>
24626>>>>>>>>>>>>>>>>>                    If (bBreak and eType = DF_BCD and Length(sFilter) < iLength) Begin
24628>>>>>>>>>>>>>>>>>                        Move (GetRowID(iFile)) to riTest
24629>>>>>>>>>>>>>>>>>                        
24629>>>>>>>>>>>>>>>>>                        Repeat
24629>>>>>>>>>>>>>>>>>>
24629>>>>>>>>>>>>>>>>>                            Move (sFilter + "0") to sFilter
24630>>>>>>>>>>>>>>>>>                            If (Length(sFilter) >= iLength) ;                                Break
24633>>>>>>>>>>>>>>>>>                            
24633>>>>>>>>>>>>>>>>>                            Set_Field_Value iFile iField to sFilter
24636>>>>>>>>>>>>>>>>>                            Send Request_Read of hoServer GE iFile iIndex
24637>>>>>>>>>>>>>>>>>                            Move (IsSameRowID(riTest, GetRowID(iFile))) to bBreak
24638>>>>>>>>>>>>>>>>>                        Until (not(bBreak))
24640>>>>>>>>>>>>>>>>>                    End                    
24640>>>>>>>>>>>>>>>>>>
24640>>>>>>>>>>>>>>>>>                End
24640>>>>>>>>>>>>>>>>>>
24640>>>>>>>>>>>>>>>>>
24640>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
24641>>>>>>>>>>>>>>>>>            Loop
24642>>>>>>>>>>>>>>>>>>
24642>>>>>>>>>>>>>>>>>            Move (not(Found) or bBreak) to bLast
24643>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24644>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24645>>>>>>>>>>>>>>>>>        End
24645>>>>>>>>>>>>>>>>>>
24645>>>>>>>>>>>>>>>>>    End_Procedure
24646>>>>>>>>>>>>>>>>>    
24646>>>>>>>>>>>>>>>>>    Procedure FindFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24648>>>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
24648>>>>>>>>>>>>>>>>>        Boolean bCase bOldRelate bNeedsRelate bAllData bSuccess bSupportsFilters bOrigActive bFilterApplied bOk
24648>>>>>>>>>>>>>>>>>        String sLowSearch sRowId sValue sOrigFilter
24648>>>>>>>>>>>>>>>>>        String[] aEntryValues
24649>>>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
24651>>>>>>>>>>>>>>>>>        Handle hoServer
24651>>>>>>>>>>>>>>>>>        RowID riTest
24651>>>>>>>>>>>>>>>>>        
24651>>>>>>>>>>>>>>>>>        Get Server to hoServer
24652>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24653>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24654>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24655>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24656>>>>>>>>>>>>>>>>>
24656>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24658>>>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
24659>>>>>>>>>>>>>>>>>            
24659>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24660>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24665>>>>>>>>>>>>>>>>>            If (iIndex <= 0);                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24668>>>>>>>>>>>>>>>>>            
24668>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24669>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24670>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24671>>>>>>>>>>>>>>>>>            
24671>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24671>>>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
24672>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24673>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24674>>>>>>>>>>>>>>>>>            
24674>>>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
24675>>>>>>>>>>>>>>>>>            Move False to bSuccess
24676>>>>>>>>>>>>>>>>>            
24676>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24676>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24678>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24679>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24681>>>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
24682>>>>>>>>>>>>>>>>>                End
24682>>>>>>>>>>>>>>>>>>
24682>>>>>>>>>>>>>>>>>            End
24682>>>>>>>>>>>>>>>>>>
24682>>>>>>>>>>>>>>>>>            
24682>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24684>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24686>>>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24687>>>>>>>>>>>>>>>>>                End
24687>>>>>>>>>>>>>>>>>>
24687>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24688>>>>>>>>>>>>>>>>>            End
24688>>>>>>>>>>>>>>>>>>
24688>>>>>>>>>>>>>>>>>            Else Begin
24689>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24690>>>>>>>>>>>>>>>>>            End
24690>>>>>>>>>>>>>>>>>>
24690>>>>>>>>>>>>>>>>>            
24690>>>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData))
24694>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24695>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase True False to bOk
24696>>>>>>>>>>>>>>>>>                If (bOk) Begin
24698>>>>>>>>>>>>>>>>>                    
24698>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24699>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24700>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
24701>>>>>>>>>>>>>>>>>                    
24701>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24702>>>>>>>>>>>>>>>>>                End
24702>>>>>>>>>>>>>>>>>>
24702>>>>>>>>>>>>>>>>>                
24702>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex 
24703>>>>>>>>>>>>>>>>>            Loop
24704>>>>>>>>>>>>>>>>>>
24704>>>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
24705>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24706>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24707>>>>>>>>>>>>>>>>>        End
24707>>>>>>>>>>>>>>>>>>
24707>>>>>>>>>>>>>>>>>    End_Procedure
24708>>>>>>>>>>>>>>>>>
24708>>>>>>>>>>>>>>>>>    Procedure FindFilteredFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24710>>>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
24710>>>>>>>>>>>>>>>>>        Boolean bOrigActive bOldRelate bNeedsRelate bAllData bSuccess bOk bFilterApplied
24710>>>>>>>>>>>>>>>>>        String sOrigFilter sFile sField sRowId sValue
24710>>>>>>>>>>>>>>>>>        String[] aEntryValues
24711>>>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
24713>>>>>>>>>>>>>>>>>        Handle hoServer
24713>>>>>>>>>>>>>>>>>        RowID riTest
24713>>>>>>>>>>>>>>>>>        
24713>>>>>>>>>>>>>>>>>        Get Server to hoServer
24714>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24715>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24716>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24717>>>>>>>>>>>>>>>>>
24717>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24719>>>>>>>>>>>>>>>>>            
24719>>>>>>>>>>>>>>>>>            // make sure we send DD messages to owner DDO
24719>>>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoServer
24720>>>>>>>>>>>>>>>>>            If (hoServer=0) Begin
24722>>>>>>>>>>>>>>>>>                Procedure_Return
24723>>>>>>>>>>>>>>>>>            End
24723>>>>>>>>>>>>>>>>>>
24723>>>>>>>>>>>>>>>>>            
24723>>>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
24724>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24729>>>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24732>>>>>>>>>>>>>>>>>            
24732>>>>>>>>>>>>>>>>>            //  Determine current filter settings
24732>>>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
24733>>>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
24734>>>>>>>>>>>>>>>>>            Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
24735>>>>>>>>>>>>>>>>>            
24735>>>>>>>>>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
24735>>>>>>>>>>>>>>>>>            // need a post-relate test, we will disabled relates for this
24735>>>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
24736>>>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
24737>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
24738>>>>>>>>>>>>>>>>>            
24738>>>>>>>>>>>>>>>>>            Move False to bSuccess
24739>>>>>>>>>>>>>>>>>            
24739>>>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
24739>>>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
24741>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
24742>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
24744>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile riTest to bSuccess
24745>>>>>>>>>>>>>>>>>                End
24745>>>>>>>>>>>>>>>>>>
24745>>>>>>>>>>>>>>>>>            End
24745>>>>>>>>>>>>>>>>>>
24745>>>>>>>>>>>>>>>>>            
24745>>>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
24747>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
24748>>>>>>>>>>>>>>>>>            End
24748>>>>>>>>>>>>>>>>>>
24748>>>>>>>>>>>>>>>>>            Else Begin
24749>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
24750>>>>>>>>>>>>>>>>>            End
24750>>>>>>>>>>>>>>>>>>
24750>>>>>>>>>>>>>>>>>            
24750>>>>>>>>>>>>>>>>>            While (Found and not(iItemIndex >= iPageSize))
24754>>>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
24755>>>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter False True False to bOk
24756>>>>>>>>>>>>>>>>>                If (bOk) Begin
24758>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
24759>>>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
24760>>>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
24761>>>>>>>>>>>>>>>>>                    
24761>>>>>>>>>>>>>>>>>                    Increment iItemIndex
24762>>>>>>>>>>>>>>>>>                End
24762>>>>>>>>>>>>>>>>>>
24762>>>>>>>>>>>>>>>>>                    
24762>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
24763>>>>>>>>>>>>>>>>>            Loop
24764>>>>>>>>>>>>>>>>>>
24764>>>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
24765>>>>>>>>>>>>>>>>>            
24765>>>>>>>>>>>>>>>>>            //  Restore filters
24765>>>>>>>>>>>>>>>>>            Send Clear of hoServer
24766>>>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
24767>>>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
24768>>>>>>>>>>>>>>>>>        End
24768>>>>>>>>>>>>>>>>>>
24768>>>>>>>>>>>>>>>>>    End_Procedure
24769>>>>>>>>>>>>>>>>>
24769>>>>>>>>>>>>>>>>>    Procedure FindValidation Boolean bFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24771>>>>>>>>>>>>>>>>>        Handle hoTable hoServer
24771>>>>>>>>>>>>>>>>>        Integer iCount iFound iLen iFile iField iItemIndex
24771>>>>>>>>>>>>>>>>>        Variant[][] aData
24772>>>>>>>>>>>>>>>>>        Boolean bCaseSensitive bAllData bOk
24772>>>>>>>>>>>>>>>>>        String sValue sDescription sCompareValue sCompareDescription
24772>>>>>>>>>>>>>>>>>        
24772>>>>>>>>>>>>>>>>>        Get Server to hoServer
24773>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24774>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24775>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24776>>>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
24777>>>>>>>>>>>>>>>>>
24777>>>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
24779>>>>>>>>>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
24780>>>>>>>>>>>>>>>>>            If (hoTable <> 0) Begin
24782>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24783>>>>>>>>>>>>>>>>>        
24783>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive  
24784>>>>>>>>>>>>>>>>>            
24784>>>>>>>>>>>>>>>>>                If (not(bCaseSensitive)) Begin
24786>>>>>>>>>>>>>>>>>                    Move (Lowercase(sFilter)) to sFilter
24787>>>>>>>>>>>>>>>>>                End
24787>>>>>>>>>>>>>>>>>>
24787>>>>>>>>>>>>>>>>>                
24787>>>>>>>>>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
24788>>>>>>>>>>>>>>>>>                Move (Length(sFilter)) to iLen
24789>>>>>>>>>>>>>>>>>                
24789>>>>>>>>>>>>>>>>>                If (iPage > 0 and prevItem.sRowId > 0);                    Move (prevItem.sRowId + 1) to iFound
24792>>>>>>>>>>>>>>>>>            
24792>>>>>>>>>>>>>>>>>                While (iFound < iCount and (not(iItemIndex >= iPageSize) or bAllData))
24796>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][0])) to sValue
24797>>>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][1])) to sDescription
24798>>>>>>>>>>>>>>>>>                    Get Find_Code_Description of hoTable sValue to sDescription
24799>>>>>>>>>>>>>>>>>                    Move sValue to sCompareValue
24800>>>>>>>>>>>>>>>>>                    Move sDescription to sCompareDescription
24801>>>>>>>>>>>>>>>>>                    If (not(bCaseSensitive)) Begin
24803>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareValue)) to sCompareValue
24804>>>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareDescription)) to sCompareDescription
24805>>>>>>>>>>>>>>>>>                    End
24805>>>>>>>>>>>>>>>>>>
24805>>>>>>>>>>>>>>>>>                    Move False to bOk
24806>>>>>>>>>>>>>>>>>                    If (bFullText) Begin
24808>>>>>>>>>>>>>>>>>                        Move (sCompareValue contains sFilter or sCompareDescription contains sFilter) to bOk
24809>>>>>>>>>>>>>>>>>                    End
24809>>>>>>>>>>>>>>>>>>
24809>>>>>>>>>>>>>>>>>                    Else Begin
24810>>>>>>>>>>>>>>>>>                        Move (Left(sCompareValue, iLen) = sFilter or Left(sCompareDescription, iLen) = sFilter) to bOk
24811>>>>>>>>>>>>>>>>>                    End
24811>>>>>>>>>>>>>>>>>>
24811>>>>>>>>>>>>>>>>>                    
24811>>>>>>>>>>>>>>>>>                    If (bOk) Begin
24813>>>>>>>>>>>>>>>>>                        Move (String(iFound)) to aItems[iItemIndex].sRowId
24814>>>>>>>>>>>>>>>>>                        Move sValue to aItems[iItemIndex].aValues[0]
24815>>>>>>>>>>>>>>>>>                        Move sDescription to aItems[iItemIndex].aValues[1]
24816>>>>>>>>>>>>>>>>>                        
24816>>>>>>>>>>>>>>>>>                        Increment iItemIndex
24817>>>>>>>>>>>>>>>>>                    End
24817>>>>>>>>>>>>>>>>>>
24817>>>>>>>>>>>>>>>>>                    
24817>>>>>>>>>>>>>>>>>                    Increment iFound
24818>>>>>>>>>>>>>>>>>                Loop
24819>>>>>>>>>>>>>>>>>>
24819>>>>>>>>>>>>>>>>>                Move (iFound >= iCount) to bLast
24820>>>>>>>>>>>>>>>>>            End
24820>>>>>>>>>>>>>>>>>>
24820>>>>>>>>>>>>>>>>>        End
24820>>>>>>>>>>>>>>>>>>
24820>>>>>>>>>>>>>>>>>    End_Procedure
24821>>>>>>>>>>>>>>>>>
24821>>>>>>>>>>>>>>>>>    Function RefindByRowIdentification String sRowIdentification tSelectionItem ByRef tOut Returns Boolean
24823>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24823>>>>>>>>>>>>>>>>>        Integer iFile iField iRow
24823>>>>>>>>>>>>>>>>>        Variant[][] aData
24824>>>>>>>>>>>>>>>>>        Boolean bSuccess bCaseSensitive bIsValidationTable
24824>>>>>>>>>>>>>>>>>        RowID rRowId
24824>>>>>>>>>>>>>>>>>        
24824>>>>>>>>>>>>>>>>>        Get Server to hoServer
24825>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24826>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24827>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24828>>>>>>>>>>>>>>>>>                
24828>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24830>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24832>>>>>>>>>>>>>>>>>                Move (DeserializeRowID(sRowIdentification)) to rRowId    
24833>>>>>>>>>>>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
24835>>>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
24836>>>>>>>>>>>>>>>>>                End
24836>>>>>>>>>>>>>>>>>>
24836>>>>>>>>>>>>>>>>>                If (bSuccess) Begin
24838>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24839>>>>>>>>>>>>>>>>>                    Get_Field_Value iFile iField to tOut.aValues[0]
24842>>>>>>>>>>>>>>>>>                    Move (Trim(tOut.aValues[0])) to tOut.aValues[0]
24843>>>>>>>>>>>>>>>>>                    Function_Return True
24844>>>>>>>>>>>>>>>>>                End
24844>>>>>>>>>>>>>>>>>>
24844>>>>>>>>>>>>>>>>>            End
24844>>>>>>>>>>>>>>>>>>
24844>>>>>>>>>>>>>>>>>            Else Begin
24845>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24846>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24847>>>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive
24848>>>>>>>>>>>>>>>>>            
24848>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24854>>>>>>>>>>>>>>>>>>
24854>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sRowIdentification or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = sRowIdentification)) Begin
24856>>>>>>>>>>>>>>>>>                        If (not(bCaseSensitive)) Begin
24858>>>>>>>>>>>>>>>>>                            Move (Lowercase(aData[iRow][0])) to tOut.sRowId
24859>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][0]))) to tOut.aValues[0]
24860>>>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][1]))) to tOut.aValues[1]
24861>>>>>>>>>>>>>>>>>                        End
24861>>>>>>>>>>>>>>>>>>
24861>>>>>>>>>>>>>>>>>                        Else Begin
24862>>>>>>>>>>>>>>>>>                            Move aData[iRow][0] to tOut.sRowId
24863>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24864>>>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24865>>>>>>>>>>>>>>>>>                        End
24865>>>>>>>>>>>>>>>>>>
24865>>>>>>>>>>>>>>>>>                        Function_Return True
24866>>>>>>>>>>>>>>>>>                    End
24866>>>>>>>>>>>>>>>>>>
24866>>>>>>>>>>>>>>>>>                Loop
24867>>>>>>>>>>>>>>>>>>
24867>>>>>>>>>>>>>>>>>            End
24867>>>>>>>>>>>>>>>>>>
24867>>>>>>>>>>>>>>>>>        End
24867>>>>>>>>>>>>>>>>>>
24867>>>>>>>>>>>>>>>>>        Function_Return False
24868>>>>>>>>>>>>>>>>>    End_Function
24869>>>>>>>>>>>>>>>>>
24869>>>>>>>>>>>>>>>>>    Function RefindByValue String sValue tSelectionItem ByRef tOut Returns Boolean
24871>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24871>>>>>>>>>>>>>>>>>        String sDBValue
24871>>>>>>>>>>>>>>>>>        Integer iFile iField iRow iIndex
24871>>>>>>>>>>>>>>>>>        Variant[][] aData
24872>>>>>>>>>>>>>>>>>        Boolean bFound bCaseSensitive bIsValidationTable
24872>>>>>>>>>>>>>>>>>        
24872>>>>>>>>>>>>>>>>>        Get Server to hoServer
24873>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24874>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24875>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24876>>>>>>>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
24877>>>>>>>>>>>>>>>>>        
24877>>>>>>>>>>>>>>>>>        Get piFindIndex to iIndex
24878>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
24883>>>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Error DFERR_PROGRAM C_$CouldNotFindAnIndex
24886>>>>>>>>>>>>>>>>>                
24886>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
24888>>>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
24890>>>>>>>>>>>>>>>>>                Send Request_Clear of hoServer
24891>>>>>>>>>>>>>>>>>                Set_Field_Value iFile iField to sValue
24894>>>>>>>>>>>>>>>>>                Send Request_Read of hoServer GE iFile iIndex
24895>>>>>>>>>>>>>>>>>                Get_Field_Value iFile iField to sDBValue
24898>>>>>>>>>>>>>>>>>                
24898>>>>>>>>>>>>>>>>>                If (Found and (sDBValue = sValue or (not(bCaseSensitive) and Lowercase(sDBValue) = Lowercase(sValue)))) Begin
24900>>>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
24901>>>>>>>>>>>>>>>>>                    Move (Trim(sValue)) to tOut.aValues[0]
24902>>>>>>>>>>>>>>>>>                    Function_Return True
24903>>>>>>>>>>>>>>>>>                End
24903>>>>>>>>>>>>>>>>>>
24903>>>>>>>>>>>>>>>>>            End
24903>>>>>>>>>>>>>>>>>>
24903>>>>>>>>>>>>>>>>>            Else Begin
24904>>>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
24905>>>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
24906>>>>>>>>>>>>>>>>>        
24906>>>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
24912>>>>>>>>>>>>>>>>>>
24912>>>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sValue or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = Lowercase(sValue))) Begin
24914>>>>>>>>>>>>>>>>>                        Move aData[iRow][0] to tOut.sRowId
24915>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][0])) to tOut.aValues[0]
24916>>>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][1])) to tOut.aValues[1]
24917>>>>>>>>>>>>>>>>>                        Function_Return True
24918>>>>>>>>>>>>>>>>>                    End
24918>>>>>>>>>>>>>>>>>>
24918>>>>>>>>>>>>>>>>>                Loop
24919>>>>>>>>>>>>>>>>>>
24919>>>>>>>>>>>>>>>>>            End
24919>>>>>>>>>>>>>>>>>>
24919>>>>>>>>>>>>>>>>>        End
24919>>>>>>>>>>>>>>>>>>
24919>>>>>>>>>>>>>>>>>        Function_Return False
24920>>>>>>>>>>>>>>>>>    End_Function
24921>>>>>>>>>>>>>>>>>    
24921>>>>>>>>>>>>>>>>>    Function CreateItem tSelectionItem ByRef oOut String sValue Returns String
24923>>>>>>>>>>>>>>>>>        Boolean bFound bErr
24923>>>>>>>>>>>>>>>>>        Integer iFile iField
24923>>>>>>>>>>>>>>>>>        Handle hoServer hoTable
24923>>>>>>>>>>>>>>>>>        
24923>>>>>>>>>>>>>>>>>        Get RefindByValue sValue (&oOut) to bFound
24924>>>>>>>>>>>>>>>>>        If (bFound) ;            Function_Return True
24927>>>>>>>>>>>>>>>>>        
24927>>>>>>>>>>>>>>>>>        Get Server to hoServer
24928>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24929>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24930>>>>>>>>>>>>>>>>>        Get File_Field_Table_Object of hoServer iFile iField to hoTable
24931>>>>>>>>>>>>>>>>>        
24931>>>>>>>>>>>>>>>>>        If (hoTable <> 0) Begin
24933>>>>>>>>>>>>>>>>>            Error DFERR_PROGRAM C_$CannotInsertIntoValidationTable
24934>>>>>>>>>>>>>>>>>>
24934>>>>>>>>>>>>>>>>>            Function_Return False
24935>>>>>>>>>>>>>>>>>        End
24935>>>>>>>>>>>>>>>>>>
24935>>>>>>>>>>>>>>>>>        Else Begin
24936>>>>>>>>>>>>>>>>>            Send Request_Clear of hoServer
24937>>>>>>>>>>>>>>>>>            Set Field_Changed_Value of hoServer iField to sValue
24938>>>>>>>>>>>>>>>>>            Get Request_Validate of hoServer to bErr
24939>>>>>>>>>>>>>>>>>            If (bErr) Begin 
24941>>>>>>>>>>>>>>>>>                Error DFERR_PROGRAM C_$ErrorWhileSavingNewItem
24942>>>>>>>>>>>>>>>>>>
24942>>>>>>>>>>>>>>>>>                Function_Return False
24943>>>>>>>>>>>>>>>>>            End
24943>>>>>>>>>>>>>>>>>>
24943>>>>>>>>>>>>>>>>>            Send Request_Save of hoServer
24944>>>>>>>>>>>>>>>>>        
24944>>>>>>>>>>>>>>>>>            Move (SerializeRowID(GetRowID(iFile))) to oOut.sRowId
24945>>>>>>>>>>>>>>>>>            Move sValue to oOut.aValues[0]
24946>>>>>>>>>>>>>>>>>        End
24946>>>>>>>>>>>>>>>>>>
24946>>>>>>>>>>>>>>>>>        Function_Return True
24947>>>>>>>>>>>>>>>>>    End_Function
24948>>>>>>>>>>>>>>>>>
24948>>>>>>>>>>>>>>>>>    Procedure End_Construct_Object
24950>>>>>>>>>>>>>>>>>        Forward Send End_Construct_Object
24952>>>>>>>>>>>>>>>>>        
24952>>>>>>>>>>>>>>>>>        Boolean bIsTrapped
24952>>>>>>>>>>>>>>>>>        Get IsTrapped of Error_Object_id DFERR_BAD_MESSAGE to bIsTrapped
24953>>>>>>>>>>>>>>>>>        If (bIsTrapped) Begin
24955>>>>>>>>>>>>>>>>>            Send Ignore_Error of Error_Object_id DFERR_BAD_MESSAGE
24956>>>>>>>>>>>>>>>>>        End
24956>>>>>>>>>>>>>>>>>>
24956>>>>>>>>>>>>>>>>>        Delegate Set SelectionSource to Self
24958>>>>>>>>>>>>>>>>>        If (bIsTrapped) Begin
24960>>>>>>>>>>>>>>>>>            Send Trap_Error of Error_Object_id DFERR_BAD_MESSAGE
24961>>>>>>>>>>>>>>>>>        End
24961>>>>>>>>>>>>>>>>>>
24961>>>>>>>>>>>>>>>>>    End_Procedure
