22132>>>>>>>>>>>>>    // Converts a state hash into a URL. By default the hash is added to the URL a location hash 
22132>>>>>>>>>>>>>    // (behind the #). Override when a customized URL format is used.
22132>>>>>>>>>>>>>    //
