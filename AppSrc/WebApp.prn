39657>>>>>    //  This function is called by the cWebResourceManagerProxy when handling a file upload with the hash key to determine where the file should be stored.
39657>>>>>    Function FileUpload String sFileName String sHash String ByRef sPath Integer ByRef iHttpErr String ByRef sError Returns Boolean
39659>>>>>        String sSessionKey sKey
39659>>>>>        Boolean bRes
39659>>>>>        String[] aKey
39660>>>>>        
39660>>>>>        Get ReadSessionKey of (Host(Self)) to sSessionKey
39661>>>>>        
39661>>>>>        //  Validate the session key from the cookie
39661>>>>>        Get ValidateSession of (SessionManager(Self)) sSessionKey to bRes
39662>>>>>        If (bRes) Begin
39664>>>>>            
39664>>>>>            //  Decript the resource key
39664>>>>>            Get DecryptKey sHash to sKey
39665>>>>>            Get StrSplit sKey "||" to aKey
39666>>>>>            If (SizeOfArray(aKey) = 2) Begin
39668>>>>>                
39668>>>>>                //  Compare session key in hash
39668>>>>>                If (aKey[0] = sSessionKey) Begin
39670>>>>>                    Get IsAllowedUploadFolder aKey[1] to bRes
39671>>>>>                    If (bRes) Begin
39673>>>>>                        Move aKey[1] to sPath
39674>>>>>                        Function_Return True
39675>>>>>                    End
39675>>>>>>
39675>>>>>                    Else Begin
39676>>>>>                        //  Report the error directly to the log as the upload script will report the error to the client in a custom format
39676>>>>>                        Send ReportErrorEvent to ghInetSession DFERR_PROGRAM (SFormat("Attempt to upload to an unregistered upload folder ('%1')", aKey[1])) 0 0 0
39677>>>>>                        Move 400 to iHttpErr
39678>>>>>                        Move "Invalid download key" to sError
39679>>>>>                        Function_Return False
39680>>>>>                    End
39680>>>>>>
39680>>>>>                End
39680>>>>>>
39680>>>>>            
39680>>>>>            End
39680>>>>>>
39680>>>>>            
39680>>>>>        End
39680>>>>>>
39680>>>>>        Else Begin
39681>>>>>            Move 401 to iHttpErr
39682>>>>>            Move "Invalid session" to sError
39683>>>>>            Function_Return False
39684>>>>>        End
39684>>>>>>
39684>>>>>        
39684>>>>>        Move 400 to iHttpErr
39685>>>>>        Move "Invalid key" to sError
39686>>>>>        Function_Return False
39687>>>>>    End_Function
