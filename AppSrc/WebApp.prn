39249>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
39251>>>>>        DateTime dtLastAccess dtCurrent
39251>>>>>        TimeSpan tsDiff
39251>>>>>        Integer iErr iSessionTimeout iSpanMinutes
39251>>>>>        Boolean bResult bCreatingNewSession
39251>>>>>        Boolean bLogWebSession bLoadWebApp
39251>>>>>        Integer eLoginMode
39251>>>>>        String sTime
39251>>>>>        Handle hoSessionDD hoUserDD       
39251>>>>>        
39251>>>>>        Move False to bLoadWebApp
39252>>>>>        If (num_arguments >= 2) Begin
39254>>>>>            Move bOptLoadWebApp to bLoadWebApp
39255>>>>>        End
39255>>>>>>
39255>>>>>        
39255>>>>>        Get phoSessionDD to hoSessionDD
39256>>>>>        Get phoUserDD to hoUserDD
39257>>>>>        
39257>>>>>        Get pbLogWebSession to bLogWebSession
39258>>>>>        Get peLoginMode to eLoginMode
39259>>>>>        
39259>>>>>        // for this object, you can only disable logging if login completely is disabled
39259>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
39261>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
39262>>>>>>
39262>>>>>            Function_Return False
39263>>>>>        End
39263>>>>>>
39263>>>>>
39263>>>>>        //  Clear session properties
39263>>>>>        Set psSessionKey to ""
39264>>>>>        Send UpdateSessionProperties True
39265>>>>>        
39265>>>>>        If not bLogWebSession Begin
39267>>>>>            Forward Get ValidateSession sSessionKey to bResult
39269>>>>>            Function_Return bResult
39270>>>>>        End        
39270>>>>>>
39270>>>>>        
39270>>>>>        Move False to bResult
39271>>>>>        Get piSessionTimeout to iSessionTimeout 
39272>>>>>        
39272>>>>>        //  Check if session exists
39272>>>>>        Send Clear of hoSessionDD
39273>>>>>        Move sSessionKey to WebAppSession.SessionKey
39274>>>>>        Send Find of hoSessionDD EQ Index.1
39275>>>>>            
39275>>>>>        If (Found) Begin
39277>>>>>            //  Calculate timespan between now and last access time
39277>>>>>            Move (CurrentDateTime()) to dtCurrent
39278>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
39279>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
39280>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
39281>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
39282>>>>>            
39282>>>>>            //  Check if session didn't time out
39282>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
39284>>>>>                Forward Get ValidateSession sSessionKey to bResult
39286>>>>>                   
39286>>>>>                If (bResult) Begin
39288>>>>>                    //  Update session record
39288>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
39289>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
39290>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
39291>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
39292>>>>>                    Get Request_Validate of hoSessionDD to iErr
39293>>>>>                    If (iErr) Begin
39295>>>>>                        // this should not happen. If it does its a programming error
39295>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
39296>>>>>>
39296>>>>>                        Function_Return False
39297>>>>>                    End
39297>>>>>>
39297>>>>>                    Send Request_Save of hoSessionDD
39298>>>>>                    
39298>>>>>                    //  Update user properties
39298>>>>>                    Send UpdateSessionProperties False
39299>>>>>                End
39299>>>>>>
39299>>>>>            End
39299>>>>>>
39299>>>>>            Else Begin
39300>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
39300>>>>>                Get pbCreatingNewSession to bCreatingNewSession
39301>>>>>                
39301>>>>>                If (not(bCreatingNewSession)) Begin
39303>>>>>                    If (not(bLoadWebApp)) Begin
39305>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
39306>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
39307>>>>>>
39307>>>>>                        Send NavigateRefresh of (Host(Self))          // refresh the WebApp at the client (triggers a login)
39308>>>>>                    End
39308>>>>>>
39308>>>>>                    Else Begin
39309>>>>>                        Set pbCreatingNewSession to True                    
39310>>>>>                        Get RecreateSession of (Host(Self)) to bResult 
39311>>>>>                        Set pbCreatingNewSession to False                        
39312>>>>>                    End
39312>>>>>>
39312>>>>>                End
39312>>>>>>
39312>>>>>            End
39312>>>>>>
39312>>>>>        End
39312>>>>>>
39312>>>>>        Else Begin
39313>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
39314>>>>>>
39314>>>>>        End
39314>>>>>>
39314>>>>>        
39314>>>>>        Function_Return bResult
39315>>>>>    End_Function
