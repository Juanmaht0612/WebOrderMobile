29570>>>>>>>>>>>    //  Determines if parsing should continue based on the information in the parsedata struct.
29570>>>>>>>>>>>    Function ShouldParseContinue tMultipartParsingData ByRef parsedata Returns Boolean
29572>>>>>>>>>>>        Function_Return (not(parsedata.bAbort) and (not(parsedata.bEndOfReq) or (parsedata.iChunkRead + parsedata.iChunkOffset < parsedata.iSize)))
29573>>>>>>>>>>>    End_Function
