39688>>>>>    
39688>>>>>    
39688>>>>>    // Splits a string into an array of strings using the given delimeter.
39688>>>>>    //
39688>>>>>    // Params:
39688>>>>>    //     sString     The string to split.
39688>>>>>    //     sDel        The delimiter (like "," or "|")
39688>>>>>    // Returns:
39688>>>>>    //     Array of strings (not including the delimiters itself.
39688>>>>>    Function StrSplit String sString String sDel Returns String[]
39690>>>>>        String[] asResult
39691>>>>>        Integer iStart iEnd iDel
39691>>>>>        
39691>>>>>        If (sString <> "") Begin
39693>>>>>            
39693>>>>>            Move 1 to iStart
39694>>>>>            
39694>>>>>            If (sDel  <> "") Begin
39696>>>>>                Move (Length(sDel)) to iDel
39697>>>>>                Move (Pos(sDel, sString, iStart)) to iEnd
39698>>>>>                
39698>>>>>                While (iEnd > 0)
39702>>>>>                    Move (Mid(sString,  iEnd - iStart, iStart)) to asResult[SizeOfArray(asResult)]
39703>>>>>                    
39703>>>>>                    Move (iEnd + iDel) to iStart
39704>>>>>                    Move (Pos(sDel, sString, iStart)) to iEnd
39705>>>>>                Loop
39706>>>>>>
39706>>>>>                
39706>>>>>                Move (Right(sString,  Length(sString) - iStart + 1)) to asResult[SizeOfArray(asResult)]
39707>>>>>            End
39707>>>>>>
39707>>>>>            Else Begin
39708>>>>>                Move sString to asResult[SizeOfArray(asResult)]
39709>>>>>            End
39709>>>>>>
39709>>>>>            
39709>>>>>        End
39709>>>>>>
39709>>>>>        
39709>>>>>        
39709>>>>>        Function_Return asResult
39710>>>>>    End_Function
39711>>>>>    
39711>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
39711>>>>>    //
39711>>>>>    // Params:
39711>>>>>    //   sPlainText     String to encrypt.
39711>>>>>    // Returns:
39711>>>>>    //   Base64 encoded hash.
39711>>>>>    Function EncryptKey String sPlainText Returns String
39713>>>>>        String sEncryptPassword sBase64
39713>>>>>        UChar[] ucBinary
39714>>>>>        Address pBase64
39714>>>>>        Integer iVoid
39714>>>>>        
39714>>>>>        //  Encrypt Key
39714>>>>>        Get psEncryptPassword of (Host(Self)) to sEncryptPassword
39715>>>>>        If (sEncryptPassword = "") Begin
39717>>>>>            Error DFERR_PROGRAM "No encryption password set" 
39718>>>>>>
39718>>>>>        End
39718>>>>>>
39718>>>>>        
39718>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
39719>>>>>        
39719>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
39721>>>>>            Error DFERR_PROGRAM "Unable to generate download key"
39722>>>>>>
39722>>>>>            Function_Return ""
39723>>>>>        End
39723>>>>>>
39723>>>>>        
39723>>>>>        //  Encode binary hash to Base64
39723>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
39724>>>>>        Move (PointerToString(pBase64)) to sBase64
39725>>>>>        Move (Free(pBase64)) to iVoid
39726>>>>>        
39726>>>>>        //  Replace URL sensitive characters
39726>>>>>        Move (Replaces("/", sBase64, "-")) to sBase64
39727>>>>>        Move (Replaces("+", sBase64, "_")) to sBase64
39728>>>>>        Move (Replaces("=", sBase64, "~")) to sBase64
39729>>>>>        
39729>>>>>        Function_Return sBase64
39730>>>>>    End_Function
39731>>>>>    
39731>>>>>    
39731>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
39731>>>>>    //
39731>>>>>    // Params:
39731>>>>>    //   sKey       Encrypted hash.
39731>>>>>    // Returns:
39731>>>>>    //   Readable string.
39731>>>>>    Function DecryptKey String sKey Returns String
39733>>>>>        String sEncryptPassword 
39733>>>>>        UChar[] ucBinary ucPlainKey
39735>>>>>        Boolean bIsHex
39735>>>>>        Integer iLen iVoid
39735>>>>>        Address pBinary
39735>>>>>        
39735>>>>>        If (sKey <> "") Begin
39737>>>>>            //  Replace URL sensitive characters back
39737>>>>>            Move (Replaces("-", sKey, "/")) to sKey
39738>>>>>            Move (Replaces("_", sKey, "+")) to sKey
39739>>>>>            Move (Replaces("~", sKey, "=")) to sKey
39740>>>>>            
39740>>>>>            //  Decode from Base64
39740>>>>>            Move (Base64Decode(AddressOf(sKey), &iLen)) to pBinary
39741>>>>>            
39741>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
39742>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
39743>>>>>            
39743>>>>>            Move (Free(pBinary)) to iVoid
39744>>>>>    
39744>>>>>            //  Encrypted binary hash to string
39744>>>>>            Get psEncryptPassword of (Host(Self)) to sEncryptPassword
39745>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlainKey
39746>>>>>        End
39746>>>>>>
39746>>>>>        
39746>>>>>        Function_Return (UCharArrayToString(ucPlainKey))
39747>>>>>    End_Function
