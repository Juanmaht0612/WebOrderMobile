38191>>>>>>>Class cWebSelectionForm is a cWebBaseSelectionForm
38192>>>>>>>    
38192>>>>>>>    Procedure Construct_Object
38194>>>>>>>        Forward Send Construct_Object
38196>>>>>>>                
38196>>>>>>>        Set psAutoComplete to "off"                 // Turn off browser autocompletion
38197>>>>>>>        Set psJSClass to "df.WebSelectionForm"
38198>>>>>>>    End_Procedure
38199>>>>>>>    
38199>>>>>>>    Procedure OnSelectSuggestion tSuggestion Suggestion
38201>>>>>>>        Handle hoServer hoSelectionSource
38201>>>>>>>        Integer iFile
38201>>>>>>>        Boolean bSuccess bSourceIsValidationTable
38201>>>>>>>        RowID rRowId
38201>>>>>>>        
38201>>>>>>>        Get Server to hoServer
38202>>>>>>>        
38202>>>>>>>        If ((hoServer <> 0)) Begin
38204>>>>>>>            Get Data_File to iFile     
38205>>>>>>>            Get phoSelectionSource to hoSelectionSource 
38206>>>>>>>            Get pbSourceIsValidationTable of hoSelectionSource to bSourceIsValidationTable
38207>>>>>>>            
38207>>>>>>>            If (not(bSourceIsValidationTable) and (iFile <> 0)) Begin
38209>>>>>>>                Move (DeserializeRowID(Suggestion.sRowId)) to rRowId    
38210>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
38212>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
38213>>>>>>>                    // this is very unlikely
38213>>>>>>>                    If (not (bSuccess)) Begin
38215>>>>>>>                        Error DFERR_CANT_REFIND_RECORD
38216>>>>>>>>
38216>>>>>>>                    End
38216>>>>>>>>
38216>>>>>>>                End
38216>>>>>>>>
38216>>>>>>>            End
38216>>>>>>>>
38216>>>>>>>            Else Begin
38217>>>>>>>                WebSet psValue to Suggestion.aValues[0]
38218>>>>>>>                WebSet pbChanged to True
38219>>>>>>>            End 
38219>>>>>>>>
38219>>>>>>>        End
38219>>>>>>>>
38219>>>>>>>        Else Begin
38220>>>>>>>            WebSet psValue to Suggestion.aValues[0]
38221>>>>>>>            WebSet pbChanged to True
38222>>>>>>>        End
38222>>>>>>>>
38222>>>>>>>    End_Procedure
38223>>>>>>>    
38223>>>>>>>    Procedure OnPostCreate tSelectionItem NewItem
38225>>>>>>>        tSuggestion Suggestion
38225>>>>>>>        tSuggestion Suggestion
38225>>>>>>>        
38225>>>>>>>        Move NewItem.sRowId to Suggestion.sRowId
38226>>>>>>>        Move NewItem.aValues to Suggestion.aValues
38227>>>>>>>        Send OnSelectSuggestion Suggestion
38228>>>>>>>    End_Procedure
38229>>>>>>>    
38229>>>>>>>    Procedure SelectSuggestion String sSearch
38231>>>>>>>        tSuggestion[] aData
38231>>>>>>>        tSuggestion[] aData
38232>>>>>>>        Handle hoJson hoAdvancedSearchView
38232>>>>>>>        
38232>>>>>>>        //  Deserialize the sent row
38232>>>>>>>        Get phoActionJsonData to hoJson
38233>>>>>>>        Get JsonToDataType of hoJson to aData
38234>>>>>>>        
38234>>>>>>>        If (SizeOfArray(aData) = 1) Begin
38236>>>>>>>            Send OnSelectSuggestion aData[0]
38237>>>>>>>        End
38237>>>>>>>>
38237>>>>>>>    End_Procedure
38238>>>>>>>        
38238>>>>>>>    Procedure End_Construct_Object
38240>>>>>>>        Forward Send End_Construct_Object
38242>>>>>>>        
38242>>>>>>>        WebPublishProcedure SelectSuggestion
38243>>>>>>>    End_Procedure
38244>>>>>>>
38244>>>>>>>End_Class
