55872>>>>>    // Redirect to local error handler or Restore the global error handler
55872>>>>>    Procedure RedirectErrorsToLocalHandler Boolean bRedirect
55874>>>>>        Integer iLocalErrorRedirectCount
55874>>>>>        String sStackDump
55874>>>>>
55874>>>>>        Get piLocalErrorRedirectCount to iLocalErrorRedirectCount
55875>>>>>        If (bRedirect) Begin
55877>>>>>            If (iLocalErrorRedirectCount = 0) Begin
55879>>>>>                Set phOldErrorObject to Error_Object_Id
55880>>>>>                Move Self to Error_Object_Id
55881>>>>>            End
55881>>>>>>
55881>>>>>            Increment iLocalErrorRedirectCount
55882>>>>>            Set piLocalErrorRedirectCount to iLocalErrorRedirectCount
55883>>>>>        End
55883>>>>>>
55883>>>>>        Else Begin
55884>>>>>            If (iLocalErrorRedirectCount = 1) Begin
55886>>>>>                Get phOldErrorObject to Error_Object_Id
55887>>>>>                Set phOldErrorObject to 0
55888>>>>>            End
55888>>>>>>
55888>>>>>            Decrement iLocalErrorRedirectCount
55889>>>>>            If (iLocalErrorRedirectCount < 0) Begin
55891>>>>>                CallStackDump sStackDump
55892>>>>>                Send ShowInfoBox ("RedirectErrorsToLocalHandler\nThis should not happen!\n\nPlease report to Data Access Europe\n\n" + sStackDump) C_$DRDataFlexReports
55893>>>>>            End
55893>>>>>>
55893>>>>>            Set piLocalErrorRedirectCount to iLocalErrorRedirectCount
55894>>>>>        End
55894>>>>>>
55894>>>>>    End_Procedure
