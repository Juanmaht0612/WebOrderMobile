35709>>>>>>>    // Send this method to fire a client action to refresh the breadcrumb items.
35709>>>>>>>    Procedure FullRefresh
35711>>>>>>>        Integer i iCount
35711>>>>>>>        tWebViewInfo[] aViewStack
35711>>>>>>>        tWebViewInfo[] aViewStack
35712>>>>>>>        tWebBreadcrumbItem[] aItems
35712>>>>>>>        tWebBreadcrumbItem[] aItems
35713>>>>>>>        String[] aParams
35714>>>>>>>        
35714>>>>>>>        //  Load the items
35714>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
35715>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
35716>>>>>>>        
35716>>>>>>>        For i from 0 to (iCount-1)
35722>>>>>>>>
35722>>>>>>>            Move aViewStack[i].sViewName      to aItems[i].sViewName
35723>>>>>>>            Move aViewStack[i].sCaption       to aItems[i].sCrumbCaption
35724>>>>>>>            Move aViewStack[i].sHeaderCaption to aItems[i].sHeadCaption
35725>>>>>>>        Loop
35726>>>>>>>>
35726>>>>>>>        
35726>>>>>>>        Send CancelClientAction "refresh"
35727>>>>>>>        Send CancelClientAction "clear"
35728>>>>>>>
35728>>>>>>>        //  Add client message
35728>>>>>>>        If (iCount > 0) Begin
35730>>>>>>>            Move "" to aParams[0]        
35731>>>>>>>            Send ClientAction "refresh" aParams aItems
35732>>>>>>>        End
35732>>>>>>>>
35732>>>>>>>        Else Begin
35733>>>>>>>            Send ClientAction "clear"
35734>>>>>>>        End        
35734>>>>>>>>
35734>>>>>>>    End_Procedure
