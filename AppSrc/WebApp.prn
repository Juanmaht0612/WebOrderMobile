30626>>>>>>>    
30626>>>>>>>    // This function is called by the framework to read a session key. By default the session key 
30626>>>>>>>    // is read from the cookie. Overriding this procedure allows the developer to customize this 
30626>>>>>>>    // behavior.
30626>>>>>>>    //
30626>>>>>>>    // WARNING: Note that this method can also be called when the WebApp is out of sync (Web 
30626>>>>>>>    // Properties are not available at that point). This happens in case of a file download.
30626>>>>>>>    Function ReadSessionKey Returns String
30628>>>>>>>        String sSessionKey
30628>>>>>>>        
30628>>>>>>>        Get GetCookie (psSessionCookieName(SessionManager(Self))) to sSessionKey
30629>>>>>>>        
30629>>>>>>>        Function_Return sSessionKey
30630>>>>>>>    End_Function
30631>>>>>>>
30631>>>>>>>    // This procedure is called whenever a session key is stored by the framework. By default the 
30631>>>>>>>    // session key is stored in a cookie and the settings (cookie name,  timeout, path) are read 
30631>>>>>>>    // from the SessionManager. Overriding this procedure allows the developer to customize
30631>>>>>>>    // this behavior.
30631>>>>>>>    //
30631>>>>>>>    // Params:
30631>>>>>>>    //   sSessionKey   The new session key. "" if the session is cleared.
30631>>>>>>>    Procedure StoreSessionKey String sSessionKey
30633>>>>>>>        String sPath
30633>>>>>>>        Integer iPos
30633>>>>>>>        Handle hoSessionManager
30633>>>>>>>        
30633>>>>>>>        Get SessionManager to hoSessionManager
30634>>>>>>>        Get psSessionCookiePath of hoSessionManager to sPath
30635>>>>>>>        
30635>>>>>>>        //  If the path is empty we determine the current path where the cookie should be set, we can't leave it blank as the client interprets /CallAction/JSON in the URL as part of the path
30635>>>>>>>        If (Trim(sPath) = "") Begin
30637>>>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "SCRIPT_NAME" to sPath
30638>>>>>>>            
30638>>>>>>>            Move (Pos("WebServiceDispatcher.wso", sPath)) to iPos
30639>>>>>>>            If (iPos > 0) Begin
30641>>>>>>>                Move (Left(sPath, iPos - 1)) to sPath
30642>>>>>>>            End
30642>>>>>>>>
30642>>>>>>>            
30642>>>>>>>            Move (RightPos("/", sPath)) to iPos    
30643>>>>>>>            If (iPos > 0) Begin
30645>>>>>>>                Move (Left(sPath, iPos)) to sPath
30646>>>>>>>            End
30646>>>>>>>>
30646>>>>>>>        End
30646>>>>>>>>
30646>>>>>>>        
30646>>>>>>>        Send SetCookie (psSessionCookieName(hoSessionManager)) sSessionKey (piSessionCookieTimeout(hoSessionManager)) sPath (psSessionCookieDomain(hoSessionManager)) (pbSessionCookieSecure(hoSessionManager)) (pbSessionCookieHttpOnly(hoSessionManager)) (psSessionCookieSameSite(hoSessionManager))
30647>>>>>>>    End_Procedure    
30648>>>>>>>
30648>>>>>>>    // Determines if a login is required to access this web application. If so it will determine if
30648>>>>>>>    // the current session is logged in by asking the session manager. This function is called by 
30648>>>>>>>    // views as a first level security test.
30648>>>>>>>    //
30648>>>>>>>    // Returns: 
30648>>>>>>>    //      True if a login is not required or if login is required and the session is logged in.
30648>>>>>>>    //      False if the login is required and the session is nog logged in.
30648>>>>>>>    Function ValidLogin Returns Boolean
30650>>>>>>>        Boolean bIsLoggedIn 
30650>>>>>>>        Integer eLoginMode
30650>>>>>>>        Get peLoginMode to eLoginMode
30651>>>>>>>        If (eLoginMode=lmLoginRequired) Begin
30653>>>>>>>            Get IsLoggedIn of (SessionManager(Self)) to bIsLoggedIn
30654>>>>>>>            Function_Return (bIsLoggedIn)
30655>>>>>>>        End
30655>>>>>>>>
30655>>>>>>>        Function_Return True
30656>>>>>>>    End_Function
