46695>>>>>>>    Procedure OnPopulateWizard tWidgetConfigProp[] aConfigurableProps tWidgetConfigPropValue[] aCurPropValues
46698>>>>>>>        Integer eNavType
46698>>>>>>>        String sUrl sTitle sButtonColor sAction
46698>>>>>>>        
46698>>>>>>>        Get GetPropValue aCurPropValues '' "psAction" to sAction
46699>>>>>>>        Get GetPropValue aCurPropValues '' "psTitle" to sTitle
46700>>>>>>>        Get GetPropValue aCurPropValues '' "psUrl" to sUrl
46701>>>>>>>        Get GetPropValue aCurPropValues '' "peNavType" to eNavType
46702>>>>>>>        Get GetPropValue aCurPropValues '' "psButtonColor" to sButtonColor
46703>>>>>>>     
46703>>>>>>>        WebSet psValue of oButtonTitle to sTitle
46704>>>>>>>        WebSet psValue of oUrlForm to sUrl
46705>>>>>>>        WebSet psValue of oNavigationTypeRadio1 to eNavType
46706>>>>>>>        
46706>>>>>>>        If (sButtonColor = "") Begin
46708>>>>>>>            WebSet psValue of oColorPicker to "#348EE6"
46709>>>>>>>        End
46709>>>>>>>>
46709>>>>>>>        Else Begin
46710>>>>>>>            WebSet psValue of oColorPicker to sButtonColor
46711>>>>>>>        End
46711>>>>>>>>
46711>>>>>>>        
46711>>>>>>>        If (sAction = "Custom") Begin
46713>>>>>>>            WebSet pbRender of oInternal to False
46714>>>>>>>            WebSet pbRender of oCustom to True
46715>>>>>>>            WebSet psValue of oSwitchType to True
46716>>>>>>>        End
46716>>>>>>>>
46716>>>>>>>        Else Begin
46717>>>>>>>            WebSet pbRender of oInternal to True
46718>>>>>>>            WebSet pbRender of oCustom to False
46719>>>>>>>            WebSet psValue of oActionRadio1 to sAction
46720>>>>>>>            WebSet psValue of oSwitchType to False
46721>>>>>>>        End
46721>>>>>>>>
46721>>>>>>>        
46721>>>>>>>        
46721>>>>>>>    End_Procedure
46722>>>>>>>    
46722>>>>>>>    Procedure OnGetConfigValues tWidgetConfigPropValue[] ByRef aNewPropValues
46725>>>>>>>        Integer eNavType
46725>>>>>>>        String sUrl sTitle sButtonColor sAction
46725>>>>>>>        Boolean bCustom
46725>>>>>>>        
46725>>>>>>>        WebGet psValue of oButtonTitle to sTitle
46726>>>>>>>        WebGet psValue of oUrlForm to sUrl
46727>>>>>>>        WebGet psValue of oNavigationTypeRadio1 to eNavType
46728>>>>>>>        WebGet psValue of oColorPicker to sButtonColor
46729>>>>>>>        
46729>>>>>>>        Get GetChecked of oSwitchType to bCustom
46730>>>>>>>        If (bCustom) Begin
46732>>>>>>>            Move "Custom" to sAction
46733>>>>>>>        End
46733>>>>>>>>
46733>>>>>>>        Else Begin
46734>>>>>>>            WebGet psValue of oActionRadio1 to sAction
46735>>>>>>>        End
46735>>>>>>>>
46735>>>>>>>        
46735>>>>>>>        Send SetPropValue (&aNewPropValues) "" "psAction" sAction
46736>>>>>>>        Send SetPropValue (&aNewPropValues) "" "psTitle" sTitle
46737>>>>>>>        Send SetPropValue (&aNewPropValues) "" "psUrl" sUrl
46738>>>>>>>        Send SetPropValue (&aNewPropValues) "" "peNavType" eNavType
46739>>>>>>>        Send SetPropValue (&aNewPropValues) "" "psButtonColor" sButtonColor
46740>>>>>>>    End_Procedure
46741>>>>>>>End_Object
