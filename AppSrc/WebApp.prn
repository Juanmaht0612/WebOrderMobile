25021>>>>>>>>>>>>>>>    Procedure ValidateSuggestionMode Boolean bAllData Boolean bSuggestions Boolean bPaged
25023>>>>>>>>>>>>>>>        If ((bAllData and bSuggestions) or (bAllData and bPaged) or (bSuggestions and bPaged)) ;            Error DFERR_PROGRAM "Invalid suggestion mode."
25026>>>>>>>>>>>>>>>    End_Procedure
25027>>>>>>>>>>>>>>>    
25027>>>>>>>>>>>>>>>    Procedure PreSerializeObject
25029>>>>>>>>>>>>>>>        Boolean bFullText bIsValidationTable bCaseSensetive bAllData bSuggestions bPaged
25029>>>>>>>>>>>>>>>        Handle hoSelectionSource
25029>>>>>>>>>>>>>>>        
25029>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25030>>>>>>>>>>>>>>>        
25030>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25032>>>>>>>>>>>>>>>            Get pbCaseSensitive of hoSelectionSource to bCaseSensetive            
25033>>>>>>>>>>>>>>>            Get pbFullText of hoSelectionSource to bFullText
25034>>>>>>>>>>>>>>>            Get pbAllData of hoSelectionSource to bAllData
25035>>>>>>>>>>>>>>>            Get pbSuggestions of hoSelectionSource to bSuggestions
25036>>>>>>>>>>>>>>>            Get pbPaged of hoSelectionSource to bPaged
25037>>>>>>>>>>>>>>>            
25037>>>>>>>>>>>>>>>            Set pbFullText to bFullText
25038>>>>>>>>>>>>>>>            Get pbUseValidationTable of hoSelectionSource to bIsValidationTable
25039>>>>>>>>>>>>>>>            Set pbSourceIsValidationTable to bIsValidationTable
25040>>>>>>>>>>>>>>>            
25040>>>>>>>>>>>>>>>            Send ValidateSuggestionMode bAllData bSuggestions bPaged
25041>>>>>>>>>>>>>>>            
25041>>>>>>>>>>>>>>>            Set pbAllData to bAllData
25042>>>>>>>>>>>>>>>            Set pbSuggestions to bSuggestions
25043>>>>>>>>>>>>>>>            Set pbPaged to bPaged
25044>>>>>>>>>>>>>>>            Set pbCaseSensitive to bCaseSensetive
25045>>>>>>>>>>>>>>>        End
25045>>>>>>>>>>>>>>>>
25045>>>>>>>>>>>>>>>    End_Procedure
