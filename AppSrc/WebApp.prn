21103>>>>>>>>>
21103>>>>>>>>>    // Returns the translations in an array of name value structs. The translations are currently 
21103>>>>>>>>>    // coming from the symbols which means that they are replaced at compile time. Augment this 
21103>>>>>>>>>    // method to add additional translations.
21103>>>>>>>>>    Function ClientTranslations Returns tWebNameValue[]
21105>>>>>>>>>        tWebNameValue[] aTranslations
21105>>>>>>>>>        tWebNameValue[] aTranslations
21106>>>>>>>>>        tWebNameValue Trans
21106>>>>>>>>>        tWebNameValue Trans
21106>>>>>>>>>        
21106>>>>>>>>>        //  Generic                 
21106>>>>>>>>>        Move "ok"                   to Trans.sN
21107>>>>>>>>>        Move C_$OK                  to Trans.sV
21108>>>>>>>>>        Move Trans                  to aTranslations[-1]
21109>>>>>>>>>                                    
21109>>>>>>>>>        Move "cancel"               to Trans.sN
21110>>>>>>>>>        Move C_$Cancel              to Trans.sV
21111>>>>>>>>>        Move Trans                  to aTranslations[-1]
21112>>>>>>>>>                                    
21112>>>>>>>>>        Move "yes"                  to Trans.sN
21113>>>>>>>>>        Move C_$Yes                 to Trans.sV
21114>>>>>>>>>        Move Trans                  to aTranslations[-1]
21115>>>>>>>>>        
21115>>>>>>>>>        Move "no"                   to Trans.sN
21116>>>>>>>>>        Move C_$No                  to Trans.sV
21117>>>>>>>>>        Move Trans                  to aTranslations[-1]
21118>>>>>>>>>                                    
21118>>>>>>>>>        Move "search"               to Trans.sN
21119>>>>>>>>>        Move C_$Search              to Trans.sV
21120>>>>>>>>>        Move Trans                  to aTranslations[-1]
21121>>>>>>>>>                                    
21121>>>>>>>>>        Move "loading"              to Trans.sN
21122>>>>>>>>>        Move C_$Loading             to Trans.sV
21123>>>>>>>>>        Move Trans                  to aTranslations[-1]
21124>>>>>>>>>                                    
21124>>>>>>>>>        Move "back"                 to Trans.sN
21125>>>>>>>>>        Move C_$Back                to Trans.sV
21126>>>>>>>>>        Move Trans                  to aTranslations[-1]
21127>>>>>>>>>                                    
21127>>>>>>>>>        //  Calendar                
21127>>>>>>>>>        Move "todayIs"              to Trans.sN
21128>>>>>>>>>        Move C_$TodayIs             to Trans.sV
21129>>>>>>>>>        Move Trans                  to aTranslations[-1]
21130>>>>>>>>>                                    
21130>>>>>>>>>        Move "wk"                   to Trans.sN
21131>>>>>>>>>        Move C_$Wk                  to Trans.sV
21132>>>>>>>>>        Move Trans                  to aTranslations[-1]
21133>>>>>>>>>        
21133>>>>>>>>>        //  Months short            
21133>>>>>>>>>        Move "jan"                  to Trans.sN
21134>>>>>>>>>        Move C_$Jan                 to Trans.sV
21135>>>>>>>>>        Move Trans                  to aTranslations[-1]
21136>>>>>>>>>                                    
21136>>>>>>>>>        Move "feb"                  to Trans.sN
21137>>>>>>>>>        Move C_$Feb                 to Trans.sV
21138>>>>>>>>>        Move Trans                  to aTranslations[-1]
21139>>>>>>>>>                                    
21139>>>>>>>>>        Move "mar"                  to Trans.sN
21140>>>>>>>>>        Move C_$Mar                 to Trans.sV
21141>>>>>>>>>        Move Trans                  to aTranslations[-1]
21142>>>>>>>>>                                    
21142>>>>>>>>>        Move "apr"                  to Trans.sN
21143>>>>>>>>>        Move C_$Apr                 to Trans.sV
21144>>>>>>>>>        Move Trans                  to aTranslations[-1]
21145>>>>>>>>>        //  May is not shorter than May
21145>>>>>>>>>        Move "mayShort"             to Trans.sN   
21146>>>>>>>>>        Move C_$MayShort            to Trans.sV
21147>>>>>>>>>        Move Trans                  to aTranslations[-1]
21148>>>>>>>>>                                    
21148>>>>>>>>>        Move "jun"                  to Trans.sN
21149>>>>>>>>>        Move C_$Jun                 to Trans.sV
21150>>>>>>>>>        Move Trans                  to aTranslations[-1]
21151>>>>>>>>>                                    
21151>>>>>>>>>        Move "jul"                  to Trans.sN
21152>>>>>>>>>        Move C_$Jul                 to Trans.sV
21153>>>>>>>>>        Move Trans                  to aTranslations[-1]
21154>>>>>>>>>                                    
21154>>>>>>>>>        Move "aug"                  to Trans.sN
21155>>>>>>>>>        Move C_$Aug                 to Trans.sV
21156>>>>>>>>>        Move Trans                  to aTranslations[-1]
21157>>>>>>>>>                                    
21157>>>>>>>>>        Move "sep"                  to Trans.sN
21158>>>>>>>>>        Move C_$Sep                 to Trans.sV
21159>>>>>>>>>        Move Trans                  to aTranslations[-1]
21160>>>>>>>>>                                    
21160>>>>>>>>>        Move "oct"                  to Trans.sN
21161>>>>>>>>>        Move C_$Oct                 to Trans.sV
21162>>>>>>>>>        Move Trans                  to aTranslations[-1]
21163>>>>>>>>>                                    
21163>>>>>>>>>        Move "nov"                  to Trans.sN
21164>>>>>>>>>        Move C_$Nov                 to Trans.sV
21165>>>>>>>>>        Move Trans                  to aTranslations[-1]
21166>>>>>>>>>                                    
21166>>>>>>>>>        Move "dec"                  to Trans.sN
21167>>>>>>>>>        Move C_$Dec                 to Trans.sV
21168>>>>>>>>>        Move Trans                  to aTranslations[-1]
21169>>>>>>>>>        
21169>>>>>>>>>        //  Months long
21169>>>>>>>>>        Move "january"              to Trans.sN
21170>>>>>>>>>        Move C_$January             to Trans.sV
21171>>>>>>>>>        Move Trans                  to aTranslations[-1]
21172>>>>>>>>>                                    
21172>>>>>>>>>        Move "february"             to Trans.sN
21173>>>>>>>>>        Move C_$February            to Trans.sV
21174>>>>>>>>>        Move Trans                  to aTranslations[-1]
21175>>>>>>>>>        
21175>>>>>>>>>        Move "march"                to Trans.sN
21176>>>>>>>>>        Move C_$March               to Trans.sV
21177>>>>>>>>>        Move Trans                  to aTranslations[-1]
21178>>>>>>>>>                                    
21178>>>>>>>>>        Move "april"                to Trans.sN
21179>>>>>>>>>        Move C_$April               to Trans.sV
21180>>>>>>>>>        Move Trans                  to aTranslations[-1]
21181>>>>>>>>>        
21181>>>>>>>>>        Move "may"                  to Trans.sN
21182>>>>>>>>>        Move C_$MayShort            to Trans.sV
21183>>>>>>>>>        Move Trans                  to aTranslations[-1]
21184>>>>>>>>>                                    
21184>>>>>>>>>        Move "june"                 to Trans.sN
21185>>>>>>>>>        Move C_$June                to Trans.sV
21186>>>>>>>>>        Move Trans                  to aTranslations[-1]
21187>>>>>>>>>                                    
21187>>>>>>>>>        Move "july"                 to Trans.sN
21188>>>>>>>>>        Move C_$July                to Trans.sV
21189>>>>>>>>>        Move Trans                  to aTranslations[-1]
21190>>>>>>>>>        
21190>>>>>>>>>        Move "august"               to Trans.sN
21191>>>>>>>>>        Move C_$August              to Trans.sV
21192>>>>>>>>>        Move Trans                  to aTranslations[-1]
21193>>>>>>>>>        
21193>>>>>>>>>        Move "september"            to Trans.sN
21194>>>>>>>>>        Move C_$September           to Trans.sV
21195>>>>>>>>>        Move Trans                  to aTranslations[-1]
21196>>>>>>>>>        
21196>>>>>>>>>        Move "october"              to Trans.sN
