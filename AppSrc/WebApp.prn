55486>>>>>>>// Returns a 'random' Universally Unique Identifier string as a 32 digit hex number.
55486>>>>>>>Function RandomHexUUID Global Returns String
55488>>>>>>>    Pointer pUUID pUUIDStr
55488>>>>>>>    Integer iRetval iOffset iChar
55488>>>>>>>    String sUUID
55488>>>>>>>    
55488>>>>>>>    Move (Alloc(16)) to pUUID
55489>>>>>>>    
55489>>>>>>>    Move (WinAPI_UuidCreate (pUUID)) to iRetval
55490>>>>>>>    
55490>>>>>>>    If (iRetval = 0) Begin
55492>>>>>>>        Move 0 to pUUIDStr
55493>>>>>>>        
55493>>>>>>>        Move (WinAPI_UuidToString (pUUID, AddressOf(pUUIDStr))) to iRetval
55494>>>>>>>        If (iRetval = 0) Begin
55496>>>>>>>            Move (PointerToWString(pUUIDStr)) to sUUID
55497>>>>>>>            Move (WinAPI_RpcStringFree (AddressOf (pUUIDStr))) to iRetval
55498>>>>>>>            
55498>>>>>>>            Move (Uppercase (sUUID)) to sUUID
55499>>>>>>>        End
55499>>>>>>>>
55499>>>>>>>    End
55499>>>>>>>>
55499>>>>>>>    
55499>>>>>>>    Move (Free(pUUID)) to iRetval
55500>>>>>>>    
55500>>>>>>>    Function_Return sUUID
55501>>>>>>>End_Function
