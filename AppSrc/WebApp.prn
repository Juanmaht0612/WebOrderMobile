29681>>>>>>>>>>>                            Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk))) to ucChunk
29682>>>>>>>>>>>                            Send OnFileChunk sFieldname (&ucChunk)
29683>>>>>>>>>>>                        End
29683>>>>>>>>>>>>
29683>>>>>>>>>>>                        Else If (SizeOfArray(parsedata.ucCurrentChunk) > 0) Begin
29686>>>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
29687>>>>>>>>>>>                        End
29687>>>>>>>>>>>>
29687>>>>>>>>>>>                    End
29687>>>>>>>>>>>>
29687>>>>>>>>>>>                    
29687>>>>>>>>>>>                    //  The file is done
