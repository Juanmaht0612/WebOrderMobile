64053>>>        If (sValue = "") Begin
64055>>>            Move "1" to sValue
64056>>>        End
64056>>>>
64056>>>        Get NamedValueAdd NavigateData.NamedValues "CorporateLogoNum" sValue to NavigateData.NamedValues
64057>>>
64057>>>        WebGet psValue of oPageLayerColorParameterForm to sValue
64058>>>        If (sValue = "") Begin
64060>>>            Move "2" to sValue
64061>>>        End
64061>>>>
