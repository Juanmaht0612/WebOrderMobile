39499>>>>>
39499>>>>>/*The resource manager facilitates file streaming for files outside of the AppHtml folder. It can generate URLs that allow downloading of files that are not server directly by IIS. These URLs can be bound to a specific session (so they will only work for that specific browser session). Note that folders need to be registered before download URLs or upload keys can be generated.*/
39499>>>>>Class cWebResourceManager is a cWebComponent
39500>>>>>    
39500>>>>>    Procedure Construct_Object
39502>>>>>        Forward Send Construct_Object
39504>>>>>        
39504>>>>>        Send Define_cWebResourceManager_mixin
39505>>>>>        
39505>>>>>        Move Self to ghoWebResourceManager
39506>>>>>        Delegate Set phoResourceManager to Self
39508>>>>>        
39508>>>>>        //  Used for encryption of the keys by EncryptKey & DecryptKey
39508>>>>>        Object oDataCrypter is a cCryptographerEx
39510>>>>>            Set piHash to CALG_SHA_256
39511>>>>>            Set piCipher to CALG_AES_256
39512>>>>>            Set psProvider to ""    //  Not providing a specific provider gives the default provider for the provider type
39513>>>>>            Set piProvider to PROV_RSA_AES
39514>>>>>        End_Object
39515>>>>>        
39515>>>>>        Property Integer piDownloadTimeout 0                //  The number of hours that the download URL stays valid (0 = infinite)
39516>>>>>        Property Boolean pbDownloadBindSession True         //  If true the download URL will only work for this session
39517>>>>>        
39517>>>>>        Property Boolean pbAllowNonSessionDownloads False   //  If true non session bound download URLs are allowed
39518>>>>>    End_Procedure
39519>>>>>    
39519>>>>>    Import_Class_Protocol cWebResourceManager_mixin
39520>>>>>    
39520>>>>>    // Generates a download URL for a local file. This URL will point to a handler that will 
39520>>>>>    // stream the file to the client.
39520>>>>>    //
39520>>>>>    // Params:
39520>>>>>    //      sPath   The absolute local file path.
39520>>>>>    Function DownloadURL String sPath Returns String
39522>>>>>        String sUrl
39522>>>>>        Integer iTimout
39522>>>>>        Boolean bBindSession
39522>>>>>        
39522>>>>>        Get piDownloadTimeout to iTimout
39523>>>>>        Get pbDownloadBindSession to bBindSession
39524>>>>>        
39524>>>>>        Get CustomDownloadURL sPath False "" bBindSession iTimout to sUrl
39525>>>>>        
39525>>>>>        Function_Return sUrl
39526>>>>>    End_Function
39527>>>>>    
39527>>>>>    // Advanced method for generating a download URL for a local file. This URL will point to a 
39527>>>>>    // handler that will stream the file to the client.
39527>>>>>    //
39527>>>>>    // {psResourceUrl}/{sDownloadFileName}?attach={bAttachment}&key={hash}  
39527>>>>>    //
39527>>>>>    // Params:
39527>>>>>    //      sPath               The absolute local file path.
39527>>>>>    //      bAttachment         Determines if the file will be streamed as attachment or inline. 
39527>>>>>    //                          Streaming as attachment will show the 'save as' dialog.
39527>>>>>    //      sDownloadFileName   Allows to send the file with a custom name instead of a default 
39527>>>>>    //                          file name.
39527>>>>>    //      bBindSession        If true the download URL will only work for the current session.
39527>>>>>    //      iTimeout            Number of hours that the URL stays valid.
39527>>>>>    //
39527>>>>>    Function CustomDownloadURL String sPath Boolean bAttachment String sDownloadFileName Boolean bBindSession Integer iTimeout Returns String
39529>>>>>        String sVal sCode sKey sResource sUrl
39529>>>>>        DateTime dtTimeout
39529>>>>>        Date dChanged
39529>>>>>        TimeSpan tsDiff
39529>>>>>        Boolean bExists bValid
39529>>>>>        Integer iH iM iSec iTime iPos
39529>>>>>        
39529>>>>>        //  Check if exists
39529>>>>>        File_Exist sPath bExists
39530>>>>>        If (not(pbAllowInvalidDownloadUrl(Self))) Begin
39532>>>>>            If (not(bExists)) Begin
39534>>>>>                Error DFERR_PROGRAM "Generating url for file that does not exist"
39535>>>>>>
39535>>>>>                Function_Return ""
39536>>>>>            End
39536>>>>>>
39536>>>>>            
39536>>>>>            //  Check if valid download folder
39536>>>>>            Get IsAllowedDownloadFolder sPath to bValid
39537>>>>>            If (not(bValid)) Begin
39539>>>>>                Error DFERR_PROGRAM "Generating url for unregistered download folder"
39540>>>>>>
39540>>>>>                Function_Return ""
39541>>>>>            End
39541>>>>>>
39541>>>>>        End
39541>>>>>>
39541>>>>>        
39541>>>>>        //  If the resource is session bound we add the session key to the hash for verificiation
39541>>>>>        If (bBindSession) Begin
39543>>>>>            Move "1" to sCode
39544>>>>>            Get psSessionKey of (SessionManager(Self)) to sVal
39545>>>>>                         
39545>>>>>            Move (sVal + "||") to sKey
39546>>>>>        End
39546>>>>>>
39546>>>>>        Else Begin
39547>>>>>            Move "0" to sCode
39548>>>>>        End
39548>>>>>>
39548>>>>>        
39548>>>>>        //  If the resource is only temporary available we add the expiration date & time
39548>>>>>        If (iTimeout > 0) Begin
39550>>>>>            Move (sCode + "1") to sCode    
39551>>>>>            Move (DateSetDay(tsDiff, iTimeout / 24)) to tsDiff
39552>>>>>            Move (DateSetHour(tsDiff, Mod(iTimeout, 24))) to tsDiff
39553>>>>>            Move (CurrentDateTime() + tsDiff) to dtTimeout
39554>>>>>            Move (sKey + String(dtTimeout) + "||") to sKey
39555>>>>>        End
39555>>>>>>
39555>>>>>        Else Begin
39556>>>>>            Move (sCode + "0") to sCode
39557>>>>>        End
39557>>>>>>
39557>>>>>        
39557>>>>>        
39557>>>>>        //  Add code to the key
39557>>>>>        Move (sCode + "||" + sKey + sPath) to sKey
39558>>>>>        
39558>>>>>        
39558>>>>>        //  Add file changed date-time to the key to prevent caching issues
39558>>>>>        If (bExists) Begin
39560>>>>>            Get_File_Mod_Time sPath to dChanged iH iM iSec
39564>>>>>            Move ((iH * 3600) + (iM * 60) + iSec) to iTime
39565>>>>>        End
39565>>>>>>
39565>>>>>        Move (sKey + "||" + String(Integer(dChanged)) + "-" + String(iTime)) to sKey
39566>>>>>                
39566>>>>>        //  Encrypt the key
39566>>>>>        Get EncryptKey sKey to sResource
39567>>>>>        
39567>>>>>        //  If no download name is given we use actual name
39567>>>>>        If (sDownloadFileName = "") Begin
39569>>>>>            Move (RightPos("\", sPath)) to iPos
39570>>>>>            Move (Right(sPath, Length(sPath) - iPos)) to sDownloadFileName
39571>>>>>        End
39571>>>>>>
39571>>>>>        
39571>>>>>        //  Assemble URL
39571>>>>>        Get psResourceUrl to sUrl
39572>>>>>        If (Right(sUrl, 1) <> "/") Begin
39574>>>>>            Move (sUrl + "/") to sUrl
39575>>>>>        End
39575>>>>>>
39575>>>>>        
39575>>>>>        Function_Return (sUrl + sDownloadFileName + "?" + If(bAttachment, "attach=true&", "") + "key=" + sResource)
39576>>>>>    End_Function
39577>>>>>    
39577>>>>>    
39577>>>>>    //  This function is called by the cWebResourceManagerProxy to parse the resource string and retrieve the local file path.
39577>>>>>    Function FileDownload String sResource String ByRef sPath Integer ByRef iHttpErr String ByRef sHttpError Returns Boolean
39579>>>>>        Boolean bRes
39579>>>>>        String sKey sSessionKey
39579>>>>>        String[] aKey
39580>>>>>        Integer iSegment
39580>>>>>        DateTime dtTimeout
39580>>>>>        
39580>>>>>        Move 1 to iSegment
39581>>>>>        
39581>>>>>        //  Decript the resource key
39581>>>>>        Get DecryptKey sResource to sKey
39582>>>>>        Get StrSplit sKey "||" to aKey
39583>>>>>        If (SizeOfArray(aKey) >= 2) Begin
39585>>>>>            //  Validate session            
39585>>>>>            If (Left(aKey[0], 1) = "1") Begin
39587>>>>>                Get ReadSessionKey of (Host(Self)) to sSessionKey
39588>>>>>                
39588>>>>>                //  Validate the session key from the cookie
39588>>>>>                Get ValidateSession of (SessionManager(Self)) sSessionKey to bRes    
39589>>>>>                
39589>>>>>                If (aKey[iSegment] <> sSessionKey) Begin
39591>>>>>                    Move False to bRes
39592>>>>>                End
39592>>>>>>
39592>>>>>                
39592>>>>>                Increment iSegment
39593>>>>>            End
39593>>>>>>
39593>>>>>            Else Begin
39594>>>>>                Get pbAllowNonSessionDownloads to bRes
39595>>>>>            End
39595>>>>>>
39595>>>>>            
39595>>>>>            If (bRes) Begin            
39597>>>>>                If (SizeOfArray(aKey) > iSegment) Begin
39599>>>>>                    
39599>>>>>                    //  Validate expiration date & time
39599>>>>>                    If (Right(aKey[0], 1) = "1") Begin
39601>>>>>                        Move (aKey[iSegment]) to dtTimeout
39602>>>>>                        
39602>>>>>                        If (not(IsDateValid(dtTimeout)) or dtTimeout < CurrentDateTime()) Begin
39604>>>>>                            Move 410 to iHttpErr
39605>>>>>                            Move "URL Expired" to sHttpError
39606>>>>>                
39606>>>>>                            Function_Return False
39607>>>>>                        End
39607>>>>>>
39607>>>>>                        
39607>>>>>                        Increment iSegment
39608>>>>>                    End
39608>>>>>>
39608>>>>>                    
39608>>>>>                    //  Return the file path if succesfull
39608>>>>>                    If (SizeOfArray(aKey) > iSegment) Begin
39610>>>>>                        Get IsAllowedDownloadFolder aKey[iSegment] to bRes
39611>>>>>                        
39611>>>>>                        If (bRes) Begin
39613>>>>>                            File_Exist aKey[iSegment] bRes
39614>>>>>                            If (not(bRes)) Begin
39616>>>>>                                Move 404 to iHttpErr
39617>>>>>                                Move "File not found" to sHttpError
39618>>>>>                                
39618>>>>>                                Function_Return False
39619>>>>>                            End
39619>>>>>>
39619>>>>>                            
39619>>>>>                            Move aKey[iSegment] to sPath
39620>>>>>                            Function_Return True
39621>>>>>                        End
39621>>>>>>
39621>>>>>                        Else Begin
39622>>>>>                            //  Report error directly to the error log as the file streaming script will give an HTTP error (that would be disturbed if the error system would write html)
39622>>>>>                            Send ReportErrorEvent to ghInetSession DFERR_PROGRAM (SFormat("Attempt to download from unregistered download folder ('%1')", aKey[iSegment])) 0 0 0
39623>>>>>                            Move 403 to iHttpErr
39624>>>>>                            Move "Invalid download folder" to sHttpError
39625>>>>>                            Function_Return False
39626>>>>>                        End
39626>>>>>>
39626>>>>>                    End
39626>>>>>>
39626>>>>>                End    
39626>>>>>>
39626>>>>>            End
39626>>>>>>
39626>>>>>            Else Begin
39627>>>>>                Move 401 to iHttpErr
39628>>>>>                Move "Invalid session" to sHttpError
39629>>>>>                Function_Return False
39630>>>>>            End
39630>>>>>>
39630>>>>>        End
39630>>>>>>
39630>>>>>        
39630>>>>>        Move 400 to iHttpErr
39631>>>>>        Move "Invalid key" to sHttpError
39632>>>>>        Function_Return False
39633>>>>>    End_Function
