26616>>>>>>>>>
26616>>>>>>>>>
26616>>>>>>>>>    // Send this message to fire an action on the client telling it to refresh the grid.
26616>>>>>>>>>    Procedure GridRefresh
26618>>>>>>>>>        Boolean bFirst bLast
26618>>>>>>>>>        tWebListData listData
26618>>>>>>>>>        tWebListData listData
26618>>>>>>>>>        String[] asParams
26619>>>>>>>>>        Handle hoJsonData
26619>>>>>>>>>                
26619>>>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
26619>>>>>>>>>        Send CancelClientAction "gridRefresh"
26620>>>>>>>>>        
26620>>>>>>>>>        // Forward call to the load data
26620>>>>>>>>>        Get LoadData "page" "" (&bFirst) (&bLast) to listData
26621>>>>>>>>>        WebSet pbUnOrdered to False
26622>>>>>>>>>        
26622>>>>>>>>>        //  Convert data to JSON
26622>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
26623>>>>>>>>>        Send DataTypeToJson of hoJsonData listData
26624>>>>>>>>>
26624>>>>>>>>>        //  Call client action with new data page
26624>>>>>>>>>        Move bFirst         to asParams[0]
26625>>>>>>>>>        Move bLast          to asParams[1]
26626>>>>>>>>>        Send ClientActionEx "gridRefresh" asParams hoJsonData
26627>>>>>>>>>        
26627>>>>>>>>>        Send Destroy of hoJsonData
26628>>>>>>>>>    End_Procedure
26629>>>>>>>>>
26629>>>>>>>>>    
26629>>>>>>>>>    // Does a empty grid refresh
26629>>>>>>>>>    Procedure EmptyGridRefresh
26631>>>>>>>>>        String[] asParams
26632>>>>>>>>>        tWebListData listData
26632>>>>>>>>>        tWebListData listData
26632>>>>>>>>>        
26632>>>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
26632>>>>>>>>>        Send CancelClientAction "gridRefresh"
26633>>>>>>>>>        
26633>>>>>>>>>        //  Call client action with empty data set
26633>>>>>>>>>        Move True to asParams[0]
26634>>>>>>>>>        Move True to asParams[1]
26635>>>>>>>>>        Send ClientAction "gridRefresh" asParams listData
26636>>>>>>>>>    End_Procedure
26637>>>>>>>>>    
26637>>>>>>>>>    
26637>>>>>>>>>    // This message is sent by the client to load a page of data. Usually caused by the user 
26637>>>>>>>>>    // scrolling to the end of the virtual list.
26637>>>>>>>>>    Procedure LoadDataPage String sType String sStartRowID
26639>>>>>>>>>        Boolean bFirst bLast
26639>>>>>>>>>        tWebListData listData
26639>>>>>>>>>        tWebListData listData
26639>>>>>>>>>        Handle hoJsonData
26639>>>>>>>>>        String[] asParams
26640>>>>>>>>>        
26640>>>>>>>>>        //  Forward call to the load data
26640>>>>>>>>>        Get LoadData sType sStartRowID (&bFirst) (&bLast) to listData
26641>>>>>>>>>        
26641>>>>>>>>>        //  Convert data to JSON
26641>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
26642>>>>>>>>>        Send DataTypeToJson of hoJsonData listData
26643>>>>>>>>>        
26643>>>>>>>>>        //  Call client action with new data page
26643>>>>>>>>>        Move sType          to asParams[0]
26644>>>>>>>>>        Move sStartRowId    to asParams[1]
26645>>>>>>>>>        Move bFirst         to asParams[2]
26646>>>>>>>>>        Move bLast          to asParams[3]
26647>>>>>>>>>        Send ClientActionEx "handleDataPage" asParams hoJsonData
26648>>>>>>>>>        
26648>>>>>>>>>        Send Destroy of hoJsonData
26649>>>>>>>>>    End_Procedure
26650>>>>>>>>>    
26650>>>>>>>>>    // OnManualLoadData is False - DDO LoadData
26650>>>>>>>>>    // Returns a set of data to be passed back to the client side grid.
26650>>>>>>>>>    // sType - is the type of data to be loaded. Options are: 
26650>>>>>>>>>    //         "page": returns a set of records around (above and below) the current row
26650>>>>>>>>>    //         "first": loads the first page of data
26650>>>>>>>>>    //         "last": loads the last page of data
26650>>>>>>>>>    //         "next": loads the next page of data relative to the passed sStartRowID
26650>>>>>>>>>    //         "prev": loads the previous page of data relative to the passed sStartRowID
26650>>>>>>>>>    //         Note that these values are case sensitive.
26650>>>>>>>>>    // sStartRowID - Is the server table's RowID to begin from when loading "next" or "prev" pages.
26650>>>>>>>>>    // bFirst - [out] True if the returned data is the first page in the total data set.
26650>>>>>>>>>    // bLast - [out] true if the returned data is the last page in the total data set.
26650>>>>>>>>>    //
26650>>>>>>>>>    // OnManualLoadData is True - Manual Load Data
26650>>>>>>>>>    // Populates list via OnManualLoadData and sets bFirst & bLast to True
26650>>>>>>>>>    //
26650>>>>>>>>>    // Returns - the requested page of data.
26650>>>>>>>>>    Function LoadData String sType String sStartRowID Boolean ByRef bFirst Boolean ByRef bLast Returns tWebListData
26652>>>>>>>>>        tWebListData listData
26652>>>>>>>>>        tWebListData listData
26652>>>>>>>>>        Handle hoDD
26652>>>>>>>>>        Integer iMainFile iPageSize iHalfPageSize iOrdering
26652>>>>>>>>>        Integer iRow iCol icColumn iFile iField iLimit
26652>>>>>>>>>        RowID riRowID
26652>>>>>>>>>        String sValue sRowID
26652>>>>>>>>>        Boolean bUsePageSize bReverseOrdering bDataAware bLastFound bScrollable
26652>>>>>>>>>        Integer eDBGridType
26652>>>>>>>>>        Variant vFilterState
26652>>>>>>>>>
26652>>>>>>>>>        // Test if OnManualLoadData has been agumented. If this event returns True then we
26652>>>>>>>>>        // will use that to populate the grid and the DDO (data-aware) grid loading will be
26652>>>>>>>>>        // skipped.  
26652>>>>>>>>>        Get pbDataAware to bDataAware
26653>>>>>>>>>        Get peDbGridType to eDBGridType
26654>>>>>>>>>        Get pbScroll to bScrollable
26655>>>>>>>>>        
26655>>>>>>>>>        // Data is loaded manually if the data is not-data aware or if
26655>>>>>>>>>        // it is data aware and manual loaded.
26655>>>>>>>>>        If (not(bDataAware) or (eDBGridType=gtManual)) Begin      
26657>>>>>>>>>            WebGet psCurrentRowId to sRowID
26658>>>>>>>>>                
26658>>>>>>>>>            Send OnManualLoadData (&listData.aRows) (&sRowID) (&listData.aGroups) (&listData.aGroupHeaders)
26659>>>>>>>>>        
26659>>>>>>>>>            Move True to bFirst
26660>>>>>>>>>            Move True to bLast
26661>>>>>>>>>            WebSet psCurrentRowId to sRowID
26662>>>>>>>>>            Function_Return listData 
26663>>>>>>>>>        End
26663>>>>>>>>>>
26663>>>>>>>>>        
26663>>>>>>>>>        Get ReadingServer to hoDD
26664>>>>>>>>>        Get IndexOrder to iOrdering
26665>>>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
26666>>>>>>>>>        WebGet piLimitRows to iLimit
26667>>>>>>>>>
26667>>>>>>>>>        Move False to bFirst
26668>>>>>>>>>        Move False to bLast
26669>>>>>>>>>
26669>>>>>>>>>        If (hoDD) Begin
26671>>>>>>>>>            Send ApplyFilter hoDD (&vFilterState)
26672>>>>>>>>>            Move 0 to iRow
26673>>>>>>>>>            Get piPageSize to iPageSize
26674>>>>>>>>>            Move (eDBGridType=gtAutomatic and bScrollable and (iPageSize > 0)) to bUsePageSize
26675>>>>>>>>>            Get Main_File of hoDD to iMainFile
26676>>>>>>>>>            
26676>>>>>>>>>            WebGet psCurrentRowId to sRowID    // Get the RowID of the current row
26677>>>>>>>>>            Move (DeserializeRowID(sRowID)) to riRowID
26678>>>>>>>>>            If (IsNullRowID(riRowID)) Begin
26680>>>>>>>>>                // if no row id, we don't do anything. We return an empty set of rows
26680>>>>>>>>>                // and indicate that we have all the records we can find
26680>>>>>>>>>                Move True to bFirst
26681>>>>>>>>>                Move True to bLast
26682>>>>>>>>>            End
26682>>>>>>>>>>
26682>>>>>>>>>            Else Begin
26683>>>>>>>>>                // Handle the different request "types"
26683>>>>>>>>>                
26683>>>>>>>>>                // "page" request type (usually initial request) returns records 
26683>>>>>>>>>                // above and below the current row
26683>>>>>>>>>                If (sType = "page") Begin
26685>>>>>>>>>                    
26685>>>>>>>>>                    // Find half a page reading backwards from the current row
26685>>>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID     // Read the current row
26686>>>>>>>>>    
26686>>>>>>>>>                    Send EstablishDDFindMode LT hoDD iOrdering bReverseOrdering
26687>>>>>>>>>                    Send Locate_Next to hoDD
26688>>>>>>>>>                    Move Found to bLastFound
26689>>>>>>>>>                    Move (iPageSize / 2) to iHalfPageSize
26690>>>>>>>>>                                        
26690>>>>>>>>>                    While (bLastFound and (not(bUsePageSize) or (iRow < iHalfPageSize)) and (iLimit = 0 or iRow < iLimit))
26694>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26696>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26697>>>>>>>>>                            Increment iRow
26698>>>>>>>>>                        End
26698>>>>>>>>>>
26698>>>>>>>>>                        
26698>>>>>>>>>                        Send Locate_Next to hoDD
26699>>>>>>>>>                        Move Found to bLastFound    //  Store Found value since LoadGridRow triggers user events that might change the Found indicator
26700>>>>>>>>>                    Loop
26701>>>>>>>>>>
26701>>>>>>>>>                    
26701>>>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and iRow >= iLimit)) to bFirst              // Determine 'bFirst'
26702>>>>>>>>>                    Move (ReverseArray(listData.aRows)) to listData.aRows  // Now reverse the array and add the rows below the current row
26703>>>>>>>>>    
26703>>>>>>>>>                    // load the current record
26703>>>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID
26704>>>>>>>>>                    Move Found to bLastFound
26705>>>>>>>>>                    If (OnCheckCustomConstrains(Self)) Begin
26707>>>>>>>>>                        Get LoadGridRow to listData.aRows[iRow]
26708>>>>>>>>>                        Increment iRow
26709>>>>>>>>>                    End
26709>>>>>>>>>>
26709>>>>>>>>>    
26709>>>>>>>>>                    // Find the remaining records
26709>>>>>>>>>                    Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
26710>>>>>>>>>                    While ((not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
26714>>>>>>>>>                        Send Locate_Next to hoDD
26715>>>>>>>>>                        Move Found to bLastFound
26716>>>>>>>>>                        If (not(Found)) ;                            Break
26719>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26721>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26722>>>>>>>>>                            Increment iRow
26723>>>>>>>>>                        End
26723>>>>>>>>>>
26723>>>>>>>>>                    Loop
26724>>>>>>>>>>
26724>>>>>>>>>                    
26724>>>>>>>>>                    // Set the bLast flag
26724>>>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) to bLast      
26725>>>>>>>>>                End
26725>>>>>>>>>>
26725>>>>>>>>>                Else Begin
26726>>>>>>>>>                    Case Begin
26726>>>>>>>>>                        Case (sType = "first")
26728>>>>>>>>>                            //  Load the first record
26728>>>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
26728>>>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
26728>>>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
26728>>>>>>>>>                            Get ReadDDFirstRecord hoDD iOrdering bReverseOrdering to riRowID
26729>>>>>>>>>                            Move True to bFirst
26730>>>>>>>>>                            Case Break
26731>>>>>>>>>                        
26731>>>>>>>>>                        Case (sType = "last")
26734>>>>>>>>>                            //  Load the last record
26734>>>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
26734>>>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
26734>>>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
26734>>>>>>>>>                            Get ReadDDLastRecord hoDD iOrdering bReverseOrdering to riRowID
26735>>>>>>>>>                            Move True to bLast
26736>>>>>>>>>                            Case Break
26737>>>>>>>>>                    
26737>>>>>>>>>                        Case (sType = "next")
26740>>>>>>>>>                            //  Load the start record
26740>>>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
26741>>>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
26742>>>>>>>>>                            Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
26743>>>>>>>>>                            Send Locate_Next of hoDD
26744>>>>>>>>>                            Case Break
26745>>>>>>>>>                    
26745>>>>>>>>>                        Case (sType = "prev")
26748>>>>>>>>>                            //  Load the start record
26748>>>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
26749>>>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
26750>>>>>>>>>                            Send EstablishDDFindMode LT  hoDD iOrdering bReverseOrdering
26751>>>>>>>>>                            Send Locate_Next of hoDD
26752>>>>>>>>>                    Case End
26752>>>>>>>>>                    Move Found to bLastFound
26753>>>>>>>>>                    
26753>>>>>>>>>                    //  Find remaining records
26753>>>>>>>>>                    While (Found and (not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
26757>>>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
26759>>>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
26760>>>>>>>>>                            Increment iRow
26761>>>>>>>>>                        End
26761>>>>>>>>>>
26761>>>>>>>>>                        Send Locate_Next to hoDD
26762>>>>>>>>>                        Move Found to bLastFound
26763>>>>>>>>>                    Loop
26764>>>>>>>>>>
26764>>>>>>>>>                
26764>>>>>>>>>                    // Set the bLast and bFirst flags
26764>>>>>>>>>                    If (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) Begin
26766>>>>>>>>>                        If (sType = "next" or sType = "first") Begin
26768>>>>>>>>>                            Move True to bLast
26769>>>>>>>>>                        End
26769>>>>>>>>>>
26769>>>>>>>>>                        Else Begin
26770>>>>>>>>>                            Move True to bFirst
26771>>>>>>>>>                        End
26771>>>>>>>>>>
26771>>>>>>>>>                    End            
26771>>>>>>>>>>
26771>>>>>>>>>                End
26771>>>>>>>>>>
26771>>>>>>>>>            End
26771>>>>>>>>>>
26771>>>>>>>>>
26771>>>>>>>>>            Send DisregardFilter vFilterState
26772>>>>>>>>>        End
26772>>>>>>>>>>
26772>>>>>>>>>        Else Begin
26773>>>>>>>>>            //  Stop the list from trying to find records while there is no DD
26773>>>>>>>>>            Move True to bLast
26774>>>>>>>>>            Move True to bFirst
26775>>>>>>>>>        End
26775>>>>>>>>>>
26775>>>>>>>>>
26775>>>>>>>>>        Function_Return listData
26776>>>>>>>>>    End_Function
26777>>>>>>>>>    
26777>>>>>>>>>    
26777>>>>>>>>>    // Sent by LoadData. User hook to manually populate the grid. To use this create some loop where each
26777>>>>>>>>>    // iteration populates one row of the grid.
26777>>>>>>>>>    // aTheRows      - [out] Array of tWebRow members to be populated. This is the grid data. 
26777>>>>>>>>>    //                 The aValues member should contain one array member for each column, starting with
26777>>>>>>>>>    //                 array member 1 for column one. aValues[0] should be populated with a unique RowID.
26777>>>>>>>>>    // sCurrentRowID - [out] Set this to the unique rowID of the row you wish to become the currently 
26777>>>>>>>>>    //                 selected row after the grid data is sent to the client.
26777>>>>>>>>>    Procedure OnManualLoadData tWebRow[] ByRef aTheRows String ByRef sCurrentRowID tWebGroupConfig[] ByRef aTheGroups tWebGroupHeader[] ByRef aTheGroupHeaders
26779>>>>>>>>>        
26779>>>>>>>>>    End_Procedure
26780>>>>>>>>>
26780>>>>>>>>>    
26780>>>>>>>>>    // Populates a single row of data.
26780>>>>>>>>>    // This is sent by LoadData when loading data from DDO server.
26780>>>>>>>>>    // It assumes that the global record buffers contain the grid row data that we want to display
26780>>>>>>>>>    // in the returned tWebGridRow.s
26780>>>>>>>>>
26780>>>>>>>>>    Function LoadGridRow Returns tWebRow
26782>>>>>>>>>        Boolean bDataAware
26782>>>>>>>>>        RowID riRowID
26782>>>>>>>>>        Integer iFile iField iCol icColumn eDataType iMainFile
26782>>>>>>>>>        String sValue
26782>>>>>>>>>        Handle hoDD
26782>>>>>>>>>        Handle[] aColumns
26783>>>>>>>>>        tWebRow tRow
26783>>>>>>>>>        tWebRow tRow
26783>>>>>>>>>        
26783>>>>>>>>>        Get pbDataAware to bDataAware
26784>>>>>>>>>        Get Server to hoDD
26785>>>>>>>>>        
26785>>>>>>>>>        Get phoColumnObjects to aColumns
26786>>>>>>>>>        Move (SizeOfArray(aColumns)) to icColumn
26787>>>>>>>>>        Move (ResizeArray(tRow.aCells, icColumn)) to tRow.aCells
26788>>>>>>>>>        Move -1 to tRow.iGroupHeaderIndex
26789>>>>>>>>>        
26789>>>>>>>>>        If (bDataAware) Begin
26791>>>>>>>>>            Get Main_File of hoDD to iMainFile
26792>>>>>>>>>            
26792>>>>>>>>>            Move (GetRowID(iMainFile)) to riRowID
26793>>>>>>>>>            Move (SerializeRowID(riRowID)) to tRow.sRowID
26794>>>>>>>>>            
26794>>>>>>>>>            // Iterate the grid columns
26794>>>>>>>>>            For iCol from 0 to (icColumn-1)
26800>>>>>>>>>>
26800>>>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
26801>>>>>>>>>            Loop
26802>>>>>>>>>>
26802>>>>>>>>>        End
26802>>>>>>>>>>
26802>>>>>>>>>        Else Begin
26803>>>>>>>>>            WebGet psCurrentRowId to tRow.sRowID
26804>>>>>>>>>            
26804>>>>>>>>>            //  Determine if a value was changed
26804>>>>>>>>>            For iCol from 0 to (icColumn-1)
26810>>>>>>>>>>
26810>>>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
26811>>>>>>>>>            Loop
26812>>>>>>>>>>
26812>>>>>>>>>        End
26812>>>>>>>>>>
26812>>>>>>>>>        
26812>>>>>>>>>        Send OnDefineRowCssClass (&tRow.sCssClassName)
26813>>>>>>>>>        
26813>>>>>>>>>        Function_Return tRow
26814>>>>>>>>>    End_Function 
26815>>>>>>>>>    
26815>>>>>>>>>    
26815>>>>>>>>>    // Loads the row posted from the action data into the buffer. It gets the row from a the 
26815>>>>>>>>>    // paActionData property and updates the psValue from the colums with its values. It also sets 
26815>>>>>>>>>    // the psCurrentRowId to the new row.
26815>>>>>>>>>    Procedure FillFromActionData
26817>>>>>>>>>        Handle[] aColumns
26818>>>>>>>>>        tWebRow[] aActionData
26818>>>>>>>>>        tWebRow[] aActionData
26819>>>>>>>>>        Handle hoJson
26819>>>>>>>>>        tWebRow tSelectRow
26819>>>>>>>>>        tWebRow tSelectRow
26819>>>>>>>>>        Integer iCol
26819>>>>>>>>>        String sValue
26819>>>>>>>>>        Boolean bCol
26819>>>>>>>>>        
26819>>>>>>>>>        //  Get the row from the action data
26819>>>>>>>>>        Get phoActionJsonData to hoJson
26820>>>>>>>>>        Get JsonToDataType of hoJson to aActionData
26821>>>>>>>>>        
26821>>>>>>>>>        If (SizeOfArray(aActionData) > 0) Begin
26823>>>>>>>>>            Move aActionData[0] to tSelectRow
26824>>>>>>>>>            
26824>>>>>>>>>            //  Update rowid
26824>>>>>>>>>            WebSet psCurrentRowId to tSelectRow.sRowID
26825>>>>>>>>>            
26825>>>>>>>>>            //  Update the DEO's (columns)
26825>>>>>>>>>            Get phoColumnObjects to aColumns
26826>>>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
26832>>>>>>>>>>
26832>>>>>>>>>                Get pbIsWebColumn of aColumns[iCol] to bCol
26833>>>>>>>>>                If (bCol) Begin
26835>>>>>>>>>                    Get ConvertFromTransport of aColumns[iCol] (RefFunc(psValue)) tSelectRow.aCells[iCol].sValue cArgStr to sValue
26836>>>>>>>>>                    WebSet psValue of aColumns[iCol] to sValue
26837>>>>>>>>>                    
26837>>>>>>>>>                    WebSet pbChanged of aColumns[iCol] to False
26838>>>>>>>>>                End
26838>>>>>>>>>>
26838>>>>>>>>>            Loop
26839>>>>>>>>>>
26839>>>>>>>>>                            
26839>>>>>>>>>        End
26839>>>>>>>>>>
26839>>>>>>>>>        Else Begin
26840>>>>>>>>>            Error DFERR_PROGRAM "Assert: No row data in a action data."
26841>>>>>>>>>>
26841>>>>>>>>>        End
26841>>>>>>>>>>
26841>>>>>>>>>    End_Procedure
26842>>>>>>>>>    
26842>>>>>>>>>    // Sent by ChangeCurrentRow. User hook to perform processing when when the client navigates the
26842>>>>>>>>>    // focus from one row to another.
26842>>>>>>>>>    Procedure OnChangeCurrentRow String sFromRowID String sToRowID
26844>>>>>>>>>        
26844>>>>>>>>>    End_Procedure
26845>>>>>>>>>    
26845>>>>>>>>>    
26845>>>>>>>>>    // Alternative name for piOrdering (depreciated). Used for concistency with VDF Windows classes. See also piOrdering
26845>>>>>>>>>    Procedure Set Ordering Integer iOrdering
26847>>>>>>>>>        Set piOrdering to iOrdering
26848>>>>>>>>>    End_Procedure
26849>>>>>>>>>    
26849>>>>>>>>>    Function Ordering Returns Integer
26851>>>>>>>>>        Integer iOrdering
26851>>>>>>>>>        Get piOrdering to iOrdering
26852>>>>>>>>>        Function_Return iOrdering
26853>>>>>>>>>    End_Function
