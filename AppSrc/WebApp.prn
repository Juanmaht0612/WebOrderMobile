42937>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
42940>>>        Integer iMode iIndex
42940>>>        Handle hoView
42940>>>        Boolean bFound
42940>>>        String sValue sTask
42940>>>        
42940>>>        Get ViewObject to hoView
42941>>>        Move NavigateData.eNavigateType to iMode
42942>>>        WebSet pbRender of oNewButton to True
42943>>>        WebSet pbRender of oDetailButton to True
42944>>>        WebSet pbRender of oHeader to False
42945>>>        
42945>>>        Case Begin
42945>>>            Case (NavigateData.eNavigateType = nfFromMain)
42947>>>                // a main-file lookup
42947>>>                // not currently used
42947>>>                Case Break
42948>>>            Case (NavigateData.eNavigateType = nfFromChild)
42951>>>                // a parent lookup
42951>>>                Get NamedValueIndex NavigateData.NamedValues "InventoryHeader" to iIndex
42952>>>                If (iIndex<>-1) Begin
42954>>>                    WebSet pbRender of oHeader to True
42955>>>                    WebSet psCaption of oHeader to NavigateData.NamedValues[iIndex].sValue
42956>>>                End
42956>>>>
42956>>>                Case Break
42957>>>            Case (NavigateData.eNavigateType = nfFromParent)
42960>>>                // a drill down query
42960>>>                // not currently used
42960>>>                Case Break
42961>>>            Case (NavigateData.eNavigateType = nfUndefined)
42964>>>                // simple maintenance select -> zoom
42964>>>                Get NamedValueGet NavigateData.NamedValues "task" to sTask
42965>>>                If (sTask="maint") Begin
42967>>>                    WebSet pbRender of oNewButton to True
42968>>>                    WebSet pbRender of oDetailButton to False
42969>>>                End
42969>>>>
42969>>>                Else Begin
42970>>>                    // current not used
42970>>>                End
42970>>>>
42970>>>        Case End
42970>>>    End_Procedure
42971>>>    
42971>>>    
42971>>>End_Object
