30719>>>>>>>    Procedure Define_cWebSyncHost_mixin
30721>>>>>>>        
30721>>>>>>>    End_Procedure
30722>>>>>>>    
30722>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
30722>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
30722>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
30722>>>>>>>    // of each view referenced in the aDDODefs collection
30722>>>>>>>    //
30722>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
30722>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
30722>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
30724>>>>>>>        Boolean bAllowAccess
30724>>>>>>>        Integer i icDDODef
30724>>>>>>>        String sViewName
30724>>>>>>>        Handle[] aDDOViews
30725>>>>>>>        Handle hoInvokingObject
30725>>>>>>>         
30725>>>>>>>        Set pbSynchronizing to True
30726>>>>>>>        
30726>>>>>>>        Send NotifySyncWebApp
30727>>>>>>>         
30727>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
30727>>>>>>>        Move True to bAllowAccess
30728>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
30729>>>>>>>        
30729>>>>>>>        //  First get all the object references
30729>>>>>>>        For i from 0 to (icDDODef - 1)
30735>>>>>>>>
30735>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
30735>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
30736>>>>>>>        Loop
30737>>>>>>>>
30737>>>>>>>        Set paDDOViews to aDDOViews
30738>>>>>>>        
30738>>>>>>>        //  Now we can do the rest of the work
30738>>>>>>>        For i from 0 to (icDDODef - 1)
30744>>>>>>>>
30744>>>>>>>            If (aDDOViews[i] <> C_WebUnresolvedObject) Begin
30746>>>>>>>                // Test if access is allowed to the view...
30746>>>>>>>                Get Object_Label of aDDOViews[i] to sViewName
30747>>>>>>>                Get AllowViewAccess of (SessionManager(Self)) aDDOViews[i] sViewName to bAllowAccess
30748>>>>>>>
30748>>>>>>>                If (not(bAllowAccess)) Begin
30750>>>>>>>                    Error DFERR_WEBAPP_ACCESS_DENIED
30751>>>>>>>>
30751>>>>>>>                    Move True to cctx.bCancel
30752>>>>>>>                    Function_Return False
30753>>>>>>>                End
30753>>>>>>>>
30753>>>>>>>                
30753>>>>>>>                // Synchronize the view's DDOs with the DDOs in the request header
30753>>>>>>>                Get SyncDDOs of aDDOViews[i] to bAllowAccess
30754>>>>>>>                If (not(bAllowAccess)) Begin
30756>>>>>>>                    Move True to cctx.bCancel
30757>>>>>>>                    Function_Return False
30758>>>>>>>                End
30758>>>>>>>>
30758>>>>>>>                                
30758>>>>>>>                // Process the synchronized psValue and pbChanged properties for each control that has a data binding
30758>>>>>>>                Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
30760>>>>>>>                
30760>>>>>>>                // Send the Rights & Roles event hook to the view....
30760>>>>>>>                Send NotifySyncWebApp to aDDOViews[i]
30761>>>>>>>                
30761>>>>>>>                // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
30761>>>>>>>                Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
30762>>>>>>>            End
30762>>>>>>>>
30762>>>>>>>        Loop 
30763>>>>>>>>
30763>>>>>>>        
30763>>>>>>>        Set pbSynchronizing to False
30764>>>>>>>    End_Procedure
30765>>>>>>>    
30765>>>>>>>    Procedure Call_PostSync tWebCallContext ByRef cctx
30767>>>>>>>        Integer i icDDODef
30767>>>>>>>        Handle[] aDDOViews
30768>>>>>>>        
30768>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
30768>>>>>>>        Get paDDOViews to aDDOViews
30769>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
30770>>>>>>>        
30770>>>>>>>        For i from 0 to (icDDODef - 1)
30776>>>>>>>>
30776>>>>>>>            Send StoreDDOStates of aDDOViews[i]
30777>>>>>>>        Loop
30778>>>>>>>>
30778>>>>>>>    End_Procedure
30779>>>>>>>
30779>>>>>>>End_Class
