24394>>>>>>>>>>>>>>>>>    Procedure Bind_Data Integer iFile Integer iField
24396>>>>>>>>>>>>>>>>>        Integer iDataFile iDataField
24396>>>>>>>>>>>>>>>>>        Integer[] iaDataFiles iaDataFields
24398>>>>>>>>>>>>>>>>>        
24398>>>>>>>>>>>>>>>>>        Get Data_File to iDataFile
24399>>>>>>>>>>>>>>>>>        Get Data_Field to iDataField
24400>>>>>>>>>>>>>>>>>        
24400>>>>>>>>>>>>>>>>>        If (iDataFile = 0 and iDataField = 0) Begin
24402>>>>>>>>>>>>>>>>>            Set Data_File to iFile
24403>>>>>>>>>>>>>>>>>            Set Data_Field to iField
24404>>>>>>>>>>>>>>>>>        End
24404>>>>>>>>>>>>>>>>>>
24404>>>>>>>>>>>>>>>>>        
24404>>>>>>>>>>>>>>>>>        Get piaDataFiles to iaDataFiles
24405>>>>>>>>>>>>>>>>>        Get piaDataFields to iaDataFields
24406>>>>>>>>>>>>>>>>>        
24406>>>>>>>>>>>>>>>>>        Move iFile to iaDataFiles[-1]
24407>>>>>>>>>>>>>>>>>        Move iField to iaDataFields[-1]   
24408>>>>>>>>>>>>>>>>>        
24408>>>>>>>>>>>>>>>>>        Set piaDataFiles to iaDataFiles
24409>>>>>>>>>>>>>>>>>        Set piaDataFields to iaDataFields
24410>>>>>>>>>>>>>>>>>    End_Procedure
24411>>>>>>>>>>>>>>>>>    
24411>>>>>>>>>>>>>>>>>    Procedure AfterAttachDDO
24413>>>>>>>>>>>>>>>>>        Boolean bAllData bSuggestions bPaged
24413>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24414>>>>>>>>>>>>>>>>>        Get pbSuggestions to bSuggestions
24415>>>>>>>>>>>>>>>>>        Get pbPaged to bPaged
24416>>>>>>>>>>>>>>>>>        
24416>>>>>>>>>>>>>>>>>        If (not(bAllData) and not(bSuggestions)) Begin
24418>>>>>>>>>>>>>>>>>            Set pbPaged to True
24419>>>>>>>>>>>>>>>>>            Move True to bPaged
24420>>>>>>>>>>>>>>>>>        End
24420>>>>>>>>>>>>>>>>>>
24420>>>>>>>>>>>>>>>>>
24420>>>>>>>>>>>>>>>>>        If ((bAllData and bSuggestions) or (bAllData and bPaged) or (bSuggestions and bPaged)) ;            Error DFERR_PROGRAM "Invalid suggestion mode."
24423>>>>>>>>>>>>>>>>>    End_Procedure
24424>>>>>>>>>>>>>>>>>    
24424>>>>>>>>>>>>>>>>>    Procedure FetchItems tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
24426>>>>>>>>>>>>>>>>>        Boolean bFullText bResult bSupportsFilters bIsValidationTable bDataAware bAllData bSuggestions bPaged
24426>>>>>>>>>>>>>>>>>        Integer iFile iField
24426>>>>>>>>>>>>>>>>>        Handle hoServer
24426>>>>>>>>>>>>>>>>>        Integer[] iaDataFiles iaDataFields
24428>>>>>>>>>>>>>>>>>        
24428>>>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
24429>>>>>>>>>>>>>>>>>        Get pbFullText to bFullText
24430>>>>>>>>>>>>>>>>>        Get pbAllData to bAllData
24431>>>>>>>>>>>>>>>>>        Get pbSuggestions to bSuggestions
24432>>>>>>>>>>>>>>>>>        Get pbPaged to bPaged
24433>>>>>>>>>>>>>>>>>        Get Server to hoServer
24434>>>>>>>>>>>>>>>>>        Get Data_File to iFile
24435>>>>>>>>>>>>>>>>>        Get Data_Field to iField
24436>>>>>>>>>>>>>>>>>        Move True to bLast
24437>>>>>>>>>>>>>>>>>
24437>>>>>>>>>>>>>>>>>        If ((bAllData and bSuggestions) or (bAllData and bPaged) or (bSuggestions and bPaged)) ;            Error DFERR_PROGRAM "Invalid suggestion mode."
24440>>>>>>>>>>>>>>>>>
24440>>>>>>>>>>>>>>>>>        If (not(bPaged)) Begin
24442>>>>>>>>>>>>>>>>>            Move 0 to iPage
24443>>>>>>>>>>>>>>>>>            Move (ResizeArray(prevItem.aValues, 0)) to prevItem.aValues
24444>>>>>>>>>>>>>>>>>            Move "" to prevItem.sRowId
24445>>>>>>>>>>>>>>>>>            Move "" to prevItem.sCssClassName
24446>>>>>>>>>>>>>>>>>            Move False to prevItem.bServer
24447>>>>>>>>>>>>>>>>>        End
24447>>>>>>>>>>>>>>>>>>
24447>>>>>>>>>>>>>>>>>        
24447>>>>>>>>>>>>>>>>>        If (hoServer = 0 or (iFile = 0 and iField = 0)) Begin
24449>>>>>>>>>>>>>>>>>            If (bAllData) Begin
24451>>>>>>>>>>>>>>>>>                Send OnLoadAllItems (&aItems)
24452>>>>>>>>>>>>>>>>>            End
24452>>>>>>>>>>>>>>>>>>
24452>>>>>>>>>>>>>>>>>            Else Begin
24453>>>>>>>>>>>>>>>>>                Send OnLoadItems (&aItems) (&bLast) sFilter prevItem iPageSize iPage
24454>>>>>>>>>>>>>>>>>                If (bSuggestions) Begin
24456>>>>>>>>>>>>>>>>>                    Move True to bLast
24457>>>>>>>>>>>>>>>>>                End
24457>>>>>>>>>>>>>>>>>>
24457>>>>>>>>>>>>>>>>>            End
24457>>>>>>>>>>>>>>>>>>
24457>>>>>>>>>>>>>>>>>            Procedure_Return
24458>>>>>>>>>>>>>>>>>        End
24458>>>>>>>>>>>>>>>>>>
24458>>>>>>>>>>>>>>>>>        
24458>>>>>>>>>>>>>>>>>        If (not(bIsValidationTable)) Begin
24460>>>>>>>>>>>>>>>>>            If (not(bFullText)) Begin
24462>>>>>>>>>>>>>>>>>                Send FindIncremental (&aItems) (&bLast) sFilter prevItem iPageSize iPage
24463>>>>>>>>>>>>>>>>>            End
24463>>>>>>>>>>>>>>>>>>
24463>>>>>>>>>>>>>>>>>            Else Begin
24464>>>>>>>>>>>>>>>>>                Get SupportsFilterExpressions hoServer to bSupportsFilters
24465>>>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
24467>>>>>>>>>>>>>>>>>                    Send FindFilteredFullText (&aItems) (&bLast) sFilter prevItem iPageSize iPage
24468>>>>>>>>>>>>>>>>>                End
24468>>>>>>>>>>>>>>>>>>
24468>>>>>>>>>>>>>>>>>                Else Begin
24469>>>>>>>>>>>>>>>>>                    Send FindFullText (&aItems) (&bLast) sFilter prevItem iPageSize iPage
24470>>>>>>>>>>>>>>>>>                End
24470>>>>>>>>>>>>>>>>>>
24470>>>>>>>>>>>>>>>>>            End
24470>>>>>>>>>>>>>>>>>>
24470>>>>>>>>>>>>>>>>>        End
24470>>>>>>>>>>>>>>>>>>
24470>>>>>>>>>>>>>>>>>        Else Begin
24471>>>>>>>>>>>>>>>>>            Send FindValidation bFullText (&aItems) (&bLast) sFilter prevItem iPageSize iPage
24472>>>>>>>>>>>>>>>>>        End
24472>>>>>>>>>>>>>>>>>>
24472>>>>>>>>>>>>>>>>>        If (bSuggestions) Begin
24474>>>>>>>>>>>>>>>>>            Move True to bLast
24475>>>>>>>>>>>>>>>>>        End
24475>>>>>>>>>>>>>>>>>>
24475>>>>>>>>>>>>>>>>>    End_Procedure
24476>>>>>>>>>>>>>>>>>    
