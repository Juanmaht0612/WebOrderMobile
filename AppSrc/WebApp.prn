30787>>>>>>>            Move (Left(sHome, Length(sHome)-1)) to sHome
30788>>>>>>>        End
30788>>>>>>>>
30788>>>>>>>
30788>>>>>>>        Move (sHome - sSep - "Reports" - sSep - "Cache") to sPath    // i.e. sPath = "<home>\Reports\Cache"
30789>>>>>>>        Move (GetFileAttributes(sPath)) to iAttributes
30790>>>>>>>
30790>>>>>>>        // Test if this is an existing directory
30790>>>>>>>        If (bCreate) Begin
30792>>>>>>>            If (iAttributes = -1) Begin
30794>>>>>>>                // There is no such directory, try to create.
