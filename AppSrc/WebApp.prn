29359>>>>>>>    
29359>>>>>>>    // Generates a fatal error listing DataFlex errors that occurred.
29359>>>>>>>    Procedure ReportDataFlexErrors
29361>>>>>>>        String sMessage sError
29361>>>>>>>        Integer iErrs iIndex iError
29361>>>>>>>        
29361>>>>>>>        Move "Unexpected DataFlex Errors." to sMessage
29362>>>>>>>        
29362>>>>>>>        // handle any errors
29362>>>>>>>        Get ErrorCount to iErrs // any errors
29363>>>>>>>        
29363>>>>>>>        For iIndex from 0 to (iErrs - 1)   
29369>>>>>>>>
29369>>>>>>>            Get ErrorNumber iIndex to iError   
29370>>>>>>>            Get ErrorMessage iIndex to sError 
29371>>>>>>>            Move (sMessage + C_NewLine + String(iError) + ": " + sError) to sMessage
29372>>>>>>>        Loop
29373>>>>>>>>
29373>>>>>>>        
29373>>>>>>>        Send ReportFatalError 500 "Internal server error" 0 sMessage
29374>>>>>>>    End_Procedure
29375>>>>>>>    
29375>>>>>>>    // Handles API calls made by the JavaScript Engine. It parses the incoming JSON and performs several validations. 
29375>>>>>>>    //
29375>>>>>>>    // HTTP errors will be returned on:
29375>>>>>>>    //  - Bad request format (couldn't parse JSON)
29375>>>>>>>    //  - Invalid JSON format
29375>>>>>>>    //  - Version check fails
29375>>>>>>>    //  - Other DataFlex errors occurred
29375>>>>>>>    //
29375>>>>>>>    // When succesfull CallAction on ghoWebApp is triggered to do framework processing.
29375>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType Integer iSize
29377>>>>>>>        UChar[] ucData ucEmpty
29379>>>>>>>        Boolean bSuccess bOrigEV bLogErrors
29379>>>>>>>        String sReason
29379>>>>>>>        Integer iErrorCount
29379>>>>>>>        
29379>>>>>>>        tWebCallContext cctx
29379>>>>>>>        tWebCallContext cctx
29379>>>>>>>        
29379>>>>>>>        Delegate Get pbLogInvalidRequests to bLogErrors 
29381>>>>>>>        
29381>>>>>>>        Send ErrorQueueStart 
29382>>>>>>>        Get pbAllErrorsToEventLog to bOrigEV
29383>>>>>>>        Set pbAllErrorsToEventLog to bLogErrors
29384>>>>>>>        
29384>>>>>>>        Move 0 to cctx.iFatalErrorCode
29385>>>>>>>        Move False to cctx.bCancel
29386>>>>>>>        
29386>>>>>>>        If (Lowercase(sContentType) contains "application/json") Begin
29388>>>>>>>        
29388>>>>>>>            //  Retrieve and parse JSON request
29388>>>>>>>            Get RequestDataUChar -1 to ucData
29389>>>>>>>            If (SizeOfArray(ucData) > 0) Begin
29391>>>>>>>                Get Create (RefClass(cJsonObject)) to cctx.hoJsonRequest
29392>>>>>>>            
29392>>>>>>>                //  Parse & validate request JSON
29392>>>>>>>                Get ParseUtf8 of cctx.hoJsonRequest ucData to bSuccess
29393>>>>>>>                If (bSuccess) Begin
29395>>>>>>>                    Move ucEmpty to ucData
29396>>>>>>>                
29396>>>>>>>                    //  Assemble the response JSON
29396>>>>>>>                    Get Create (RefClass(cJsonObject)) to cctx.hoJsonResponse
29397>>>>>>>                    Send InitializeJsonType of cctx.hoJsonResponse jsonTypeObject
29398>>>>>>>                    
29398>>>>>>>                    Send ErrorQueueEnd
29399>>>>>>>                    Get ErrorCount to iErrorCount
29400>>>>>>>                    
29400>>>>>>>                    If (iErrorCount = 0) Begin
29402>>>>>>>                        //  Reset error logging before going into application code
29402>>>>>>>                        Set pbAllErrorsToEventLog to bOrigEV
29403>>>>>>>                        
29403>>>>>>>                        Send ProcessRequest of (Host(Self)) (&cctx)
29404>>>>>>>                        
29404>>>>>>>                        //  Restart error queuing and logging after application code
29404>>>>>>>                        Send ErrorQueueStart 
29405>>>>>>>                        Set pbAllErrorsToEventLog to bLogErrors
29406>>>>>>>                        
29406>>>>>>>                        
29406>>>>>>>                        If (cctx.iFatalErrorCode= 0) Begin
29408>>>>>>>                            Send AddHttpResponseHeader "Cache-Control" "no-cache"
29409>>>>>>>                            Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29410>>>>>>>                            
29410>>>>>>>                            Get StringifyUtf8 of cctx.hoJsonResponse to ucData
29411>>>>>>>                            Send OutputUChar ucData  
29412>>>>>>>                        End
29412>>>>>>>>
29412>>>>>>>                        Else Begin
29413>>>>>>>                            Send ReportFatalError cctx.iFatalErrorCode "Fatal error"  0 cctx.sFatalError
29414>>>>>>>                        End
29414>>>>>>>>
29414>>>>>>>                    
29414>>>>>>>                        Send Destroy of cctx.hoJsonResponse
29415>>>>>>>                    End
29415>>>>>>>>
29415>>>>>>>                    Else  Begin
29416>>>>>>>                        Send ReportDataFlexErrors 
29417>>>>>>>                    End
29417>>>>>>>>
29417>>>>>>>                End
29417>>>>>>>>
29417>>>>>>>                Else Begin
29418>>>>>>>                    Get psParseError of cctx.hoJsonRequest to sReason
29419>>>>>>>                    Send ReportFatalError 400 "Bad request" 0 ("Unable to parse request data: " + sReason)
29420>>>>>>>                    
29420>>>>>>>                    If (bLogErrors) Begin
29422>>>>>>>                        Error DFERR_WEBAPP_BAD_REQUEST ("Unable to parse request data: " + sReason)
29423>>>>>>>>
29423>>>>>>>                    End
29423>>>>>>>>
29423>>>>>>>                End
29423>>>>>>>>
29423>>>>>>>                
29423>>>>>>>                Send Destroy of cctx.hoJsonRequest
29424>>>>>>>            End
29424>>>>>>>>
29424>>>>>>>            Else Begin
29425>>>>>>>                Send ReportFatalError 400 "Bad request" 0 "No request body"
29426>>>>>>>                
29426>>>>>>>                If (bLogErrors) Begin
29428>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST "No request body"
29429>>>>>>>>
29429>>>>>>>                End
29429>>>>>>>>
29429>>>>>>>            End
29429>>>>>>>>
29429>>>>>>>        End
29429>>>>>>>>
29429>>>>>>>        Else Begin
29430>>>>>>>            Send ReportFatalError 400 "Bad request" 0 "Unexpected content-type header value."
29431>>>>>>>            If (bLogErrors) Begin
29433>>>>>>>                Error DFERR_WEBAPP_BAD_REQUEST "Unexpected content-type header value."
29434>>>>>>>>
29434>>>>>>>            End
29434>>>>>>>>
29434>>>>>>>        End
29434>>>>>>>>
29434>>>>>>>        
29434>>>>>>>        //  Cleanup
29434>>>>>>>        Send ErrorQueueEnd
29435>>>>>>>        Send ClearErrors
29436>>>>>>>        Set pbAllErrorsToEventLog to bOrigEV
29437>>>>>>>        
29437>>>>>>>    End_Procedure
