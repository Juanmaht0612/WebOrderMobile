37425>>>>>>>    //  Procedure GeoQuery_Callback Integer iErr Number nLatitude Number nLongitude Number nAccuracy Number nSpeed Number nHeading
37425>>>>>>>    //
37425>>>>>>>    // Example usage:
37425>>>>>>>    //  Procedure GeoQuery_Callback Integer iErr Number nLatitude Number nLongitude Number nAccuracy Number nSpeed Number nHeading
37425>>>>>>>    //      If (not(iErr)) Begin
37425>>>>>>>    //          Send ShowInfoBox (SFormat("Lat: %1 Long: %2 Acc: %3 Speed: %4 Head: %5", nLatitude, nLongitude, nAccuracy, nSpeed, nHeading))
37425>>>>>>>    //      End
37425>>>>>>>    //  End_Procedure
37425>>>>>>>    //  
37425>>>>>>>    //  WebPublishProcedure GeoQuery_Callback
37425>>>>>>>    //  
37425>>>>>>>    //  Procedure OnClick
37425>>>>>>>    //      Send QueryLocation of oWebGeoLocation1 (RefProc(GeoQuery_Callback)) Self
37425>>>>>>>    //  End_Procedure
37425>>>>>>>    Procedure QueryLocation Handle hmCallbackMsg Handle hoCallbackObject
