29477>>>>>>>>>>>// This class is capable of parsing multipart/form-data requests. These requests are used to post
29477>>>>>>>>>>>// binary data and usually files. The WAF file upload uses this class. Because it works in chunks
29477>>>>>>>>>>>// are used this class is capable of handling large files.
29477>>>>>>>>>>>
29477>>>>>>>>>>>// Data used while parsing the request. Passed arround by reference for performance reasons (properties would be copied in memory).
29477>>>>>>>>>>>Struct tMultipartParsingData
29477>>>>>>>>>>>    UChar[] ucBoundary      //  Multipart boundary string (received from the client)
29477>>>>>>>>>>>    UChar[] ucCurrentChunk  //  Current chunk being handled
29477>>>>>>>>>>>    UChar[] ucNextChunk     //  Next chunk (already loaded for peeking ahead)
29477>>>>>>>>>>>    Integer iChunkOffset    //  Offset in bytes of the current chunk from the beginning of the request
29477>>>>>>>>>>>    Integer iChunkRead      //  Parsing position within the current chunk
29477>>>>>>>>>>>    DWord iSize             //  Size of the full request known so far (only if bEndOfReq is true it is complete)
29477>>>>>>>>>>>    Integer iBoundPos       //  Position of the next boundary in the current chunk (if available)
29477>>>>>>>>>>>    Boolean bEndOfReq       //  End of request reached
29477>>>>>>>>>>>    Boolean bAbort          //  If true something is wrong and we should abot
29477>>>>>>>>>>>End_Struct
29477>>>>>>>>>>>
29477>>>>>>>>>>>//  These functions are defined in the class using this mixin or one of its base classes
29477>>>>>>>>>>>Register_Function RequestDataUChar Integer iSize Returns UChar[]
29477>>>>>>>>>>>Register_Function GetContentType Returns String
29477>>>>>>>>>>>Register_Function ConvertRequestDataToString UChar[] ucData Returns String
29477>>>>>>>>>>>
29477>>>>>>>>>>>Class cWebHttpMultipartFormdataHandler_mixin is a Mixin
29478>>>>>>>>>>>    Procedure Define_cWebHttpMultipartFormdataHandler_mixin
29480>>>>>>>>>>>        Property String psParseError ""
29481>>>>>>>>>>>        Property Integer piParseErrorCode 0
29482>>>>>>>>>>>    End_Procedure
29483>>>>>>>>>>>    
29483>>>>>>>>>>>    //  Parses newline characters 
29483>>>>>>>>>>>    Procedure SkipNewLine tMultipartParsingData ByRef parsedata
29485>>>>>>>>>>>        //  Skip carriage return
29485>>>>>>>>>>>        If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 13) Begin
29487>>>>>>>>>>>            Increment parsedata.iChunkRead
29488>>>>>>>>>>>            If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29490>>>>>>>>>>>                Send ReadChunk (&parsedata)
29491>>>>>>>>>>>            End
29491>>>>>>>>>>>>
29491>>>>>>>>>>>        
29491>>>>>>>>>>>            //  Skip line feed
29491>>>>>>>>>>>            If (parsedata.iChunkRead < SizeOfArray(parsedata.ucCurrentChunk) and parsedata.ucCurrentChunk[parsedata.iChunkRead] = 10) Begin
29493>>>>>>>>>>>                Increment parsedata.iChunkRead
29494>>>>>>>>>>>                If (parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29496>>>>>>>>>>>                    Send ReadChunk (&parsedata)
29497>>>>>>>>>>>                End
29497>>>>>>>>>>>>
29497>>>>>>>>>>>            End
29497>>>>>>>>>>>>
29497>>>>>>>>>>>        End
29497>>>>>>>>>>>>
29497>>>>>>>>>>>    End_Procedure
29498>>>>>>>>>>>    
29498>>>>>>>>>>>    //  Moves to the next chunk by updating the parsing data. It reads the next chunk for peeking ahead.
29498>>>>>>>>>>>    Procedure ReadChunk tMultipartParsingData ByRef parsedata
29500>>>>>>>>>>>        //  Move to next chunk (already in cache)
29500>>>>>>>>>>>        Move (parsedata.iChunkOffset + SizeOfArray(parsedata.ucCurrentChunk)) to parsedata.iChunkOffset
29501>>>>>>>>>>>        Move parsedata.ucNextChunk to parsedata.ucCurrentChunk
29502>>>>>>>>>>>        Move 0 to parsedata.iChunkRead
29503>>>>>>>>>>>        
29503>>>>>>>>>>>        //  Update the boundpos
29503>>>>>>>>>>>        Get FindToken (&parsedata) parsedata.ucBoundary False False to parsedata.iBoundPos
29504>>>>>>>>>>>        
29504>>>>>>>>>>>        //  Cache the next chunk
29504>>>>>>>>>>>        If (not(parsedata.bEndOfReq)) Begin
29506>>>>>>>>>>>            Get RequestDataUChar HTTP_DEFAULT_CHUNK_SIZE to parsedata.ucNextChunk
29507>>>>>>>>>>>            Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
29508>>>>>>>>>>>            Move (parsedata.iSize + SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
29509>>>>>>>>>>>        End
29509>>>>>>>>>>>>
29509>>>>>>>>>>>    End_Procedure
29510>>>>>>>>>>>    
29510>>>>>>>>>>>    //  Extracts a value from the request (like content-type, filename, field name). The current 
29510>>>>>>>>>>>    //  position (iChunkRead) will be moved until the end of the value.
29510>>>>>>>>>>>    //  
29510>>>>>>>>>>>    //  Params:
