64236>>>                Set psLabel to "Top N Amount"
64237>>>                Set peLabelAlign to alignLeft
64238>>>                Set peLabelPosition to lpTop
64239>>>                Set piColumnSpan to 3
64240>>>                Set psToolTip to 'Select a Value for the TOP N Amount to be Displayed'
64241>>>
64241>>>                WebSetResponsive piColumnSpan rmMobile to 0
64242>>>
64242>>>                Procedure OnFill
64245>>>                    Send AddComboItem 10 'Top 10'
64246>>>                    Send AddComboItem 5 'Top 5'
64247>>>                    Send AddComboItem 3 'Top 3'
64248>>>                End_Procedure
64249>>>
64249>>>                Set psValue to 10
64250>>>            End_Object
