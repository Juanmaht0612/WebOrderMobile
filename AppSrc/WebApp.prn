21053>>>>>>>>>
21053>>>>>>>>>    // Server-Action
21053>>>>>>>>>    //
21053>>>>>>>>>    // Server action that is called by the JavaScript engine opun initialization. It makes sure 
21053>>>>>>>>>    // that the object definitions of the global object and the initial view (phoLoginView or 
21053>>>>>>>>>    // phoDefaultView) including its DDO state. Also makes sure that translations are sent to the 
21053>>>>>>>>>    // client.
21053>>>>>>>>>    //
21053>>>>>>>>>    // Params:
21053>>>>>>>>>    //  bLoadInitial     If true (or not passed) the default (or login) view is loaded immediately 
21053>>>>>>>>>    //          and sent to the client. If displayView is used on the client this will be false.
21053>>>>>>>>>    // Returns:
21053>>>>>>>>>    //      The name of the initial view or dialog.
21053>>>>>>>>>    Function LoadWebApp Boolean bLoadInitial Returns String
21055>>>>>>>>>        String[] asBrowserLanguages asParams
21057>>>>>>>>>        Integer eAppStyle iBrowserTimezoneOffset iWidth iHeight
21057>>>>>>>>>        Boolean bIsLoggedIn bAllowAccess bOverrideState bOnResize
21057>>>>>>>>>        Handle hoView hoDefaultView hjObjectDef hjTranslations
21057>>>>>>>>>        tWebNameValue[] aTranslations
21057>>>>>>>>>        tWebNameValue[] aTranslations
21058>>>>>>>>>        
21058>>>>>>>>>        //  Trigger event allowing application to initialize things based on the client locales
21058>>>>>>>>>        WebGet pasBrowserLanguages to asBrowserLanguages
21059>>>>>>>>>        WebGet piBrowserTimezoneOffset to iBrowserTimezoneOffset
21060>>>>>>>>>        
21060>>>>>>>>>        Send OnInitializeLocales (If(SizeOfArray(asBrowserLanguages) > 0, asBrowserLanguages[0], "")) iBrowserTimezoneOffset
21061>>>>>>>>>        
21061>>>>>>>>>        //  Load translations (mark as 'early' client action so it executes before anything else)
21061>>>>>>>>>        Get ClientTranslations to aTranslations
21062>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjTranslations
21063>>>>>>>>>        Send DataTypeToJson of hjTranslations aTranslations 
21064>>>>>>>>>        Send ClientActionEarly "initTranslations" asParams hjTranslations
21065>>>>>>>>>        Send Destroy of hjTranslations
21066>>>>>>>>>        
21066>>>>>>>>>        //  Trigger resize event
21066>>>>>>>>>        Get pbServerOnResizeWindow to bOnResize
21067>>>>>>>>>        If (bOnResize) Begin
21069>>>>>>>>>            WebGet piWindowWidth to iWidth
21070>>>>>>>>>            WebGet piWindowHeight to iHeight
21071>>>>>>>>>            
21071>>>>>>>>>            Send OnResizeWindow iWidth iHeight
21072>>>>>>>>>        End
21072>>>>>>>>>>
21072>>>>>>>>>        
21072>>>>>>>>>        //  Serialize Global Objects
21072>>>>>>>>>        Get SerializeObject to hjObjectDef
21073>>>>>>>>>        Send ClientActionEarly "createWebApp" asParams hjObjectDef 
21074>>>>>>>>>        Send Destroy of hjObjectDef
21075>>>>>>>>>        
21075>>>>>>>>>        WebSet pbIsLoaded to True
21076>>>>>>>>>        
21076>>>>>>>>>        If (bLoadInitial) Begin
21078>>>>>>>>>            Send Load_InitialView
21079>>>>>>>>>        End
21079>>>>>>>>>>
21079>>>>>>>>>         
21079>>>>>>>>>        Function_Return ""
21080>>>>>>>>>    End_Function
21081>>>>>>>>>    
21081>>>>>>>>>    //  Empty stub, called from loadWebApp, implemented in cWebViewHost_mixin
21081>>>>>>>>>    Procedure Load_InitialView
21083>>>>>>>>>        
21083>>>>>>>>>    End_Procedure
21084>>>>>>>>>    
