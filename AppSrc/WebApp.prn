55766>>>>>    // All errors are directed to this method.
55766>>>>>    Procedure Error_Report Integer iErrNum Integer iErrLine String sErrMsg
55768>>>>>        Handle hoError
55768>>>>>        Boolean bInError bDisplayError bCancelIfError
55768>>>>>
55768>>>>>        Get pbInError to bInError
55769>>>>>        If (not (bInError)) Begin
55771>>>>>            Set pbInError to True // prevents recursion
55772>>>>>            Set pbHasErrors to True  // an error has occurred in the report
55773>>>>>            Send OnError iErrNum iErrLine sErrMsg
55774>>>>>            Get pbDisplayError to bDisplayError
55775>>>>>            If (bDisplayError) Begin // if we display, direct to old error object
55777>>>>>                Get phOldErrorObject to hoError
55778>>>>>                If (hoError <> 0) Begin
55780>>>>>                    Send Error_Report of hoError iErrNum iErrLine sErrMsg
55781>>>>>                End
55781>>>>>>
55781>>>>>                Else Begin
55782>>>>>                    Send Error_Report of Desktop iErrNum iErrLine sErrMsg
55783>>>>>                End
55783>>>>>>
55783>>>>>            End
55783>>>>>>
55783>>>>>            Get pbCancelIfError to bCancelIfError
55784>>>>>            If (bCancelIfError) Begin
55786>>>>>                Send CancelReport // Sets pbCanceled to true
55787>>>>>            End
55787>>>>>>
55787>>>>>            Set pbInError to False
55788>>>>>        End
55788>>>>>>
55788>>>>>    End_Procedure
