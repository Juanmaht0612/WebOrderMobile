44075>>>>>>>                        If (iProps > 0) Begin
44077>>>>>>>                            Get GetConfigurableProps of hoWidget to aProps
44078>>>>>>>                            
44078>>>>>>>                            For p from 0 to (iProps - 1)
44084>>>>>>>>
44084>>>>>>>                                Send InitConfigurableProp hoWidget aProps CurWidget.aConfig[p].sObjName CurWidget.aConfig[p].sPropName CurWidget.aConfig[p].sValue
44085>>>>>>>                            Loop
44086>>>>>>>>
44086>>>>>>>                        End
44086>>>>>>>>
44086>>>>>>>                        
44086>>>>>>>                        // Responsive rules
44086>>>>>>>                        Move ((SizeOfArray(CurWidget.aResponsivePropRules)) - 1) to iPropRules
44087>>>>>>>                        
44087>>>>>>>                        For p from 0 to iPropRules
44093>>>>>>>>
44093>>>>>>>                            Send SetWidgetPropertyRules hoWidget CurWidget.aResponsivePropRules[p]
44094>>>>>>>                        Loop
44095>>>>>>>>
44095>>>>>>>                        
44095>>>>>>>                        Send InitWidget of hoWidget
44096>>>>>>>                    End
44096>>>>>>>>
44096>>>>>>>                End
44096>>>>>>>>
44096>>>>>>>            End
44096>>>>>>>>
44096>>>>>>>        Loop
44097>>>>>>>>
44097>>>>>>>        
44097>>>>>>>        Send Activate
44098>>>>>>>    End_Procedure
44099>>>>>>>    
44099>>>>>>>    Procedure SetWidgetPropertyRules Handle hoWidget tWebPropRule PropRule
44101>>>>>>>        tWebPropMetaData PropMeta
44101>>>>>>>        tWebPropMetaData PropMeta
44101>>>>>>>        Integer i iRules
44101>>>>>>>        
44101>>>>>>>        Get FindWebPropertyMetaByName of hoWidget PropRule.sName to PropMeta
44102>>>>>>>        
44102>>>>>>>        Move (SizeOfArray(PropRule.aModeRules) - 1) to iRules
44103>>>>>>>        
44103>>>>>>>        For i from 0 to iRules
44109>>>>>>>>
44109>>>>>>>            // Handle hmGetter String sPropName Integer eMode Variant vValue
44109>>>>>>>            Send SetPropertyRuleEx of hoWidget PropMeta.hmSetter PropMeta.sName PropRule.aModeRules[i].eMode PropRule.aModeRules[i].vValue
44110>>>>>>>        Loop
44111>>>>>>>>
44111>>>>>>>        
44111>>>>>>>    End_Procedure
44112>>>>>>>    
44112>>>>>>>    Procedure InitConfigurableProp Handle hoWidget tWidgetConfigProp[] aProps String sObjName String sPropName String sPropVal
44114>>>>>>>        Handle hoObj
44114>>>>>>>        Boolean bConfigPropExists
44114>>>>>>>        tWebPropMetaData PropMeta
44114>>>>>>>        tWebPropMetaData PropMeta
44114>>>>>>>        tWidgetConfigProp CurProp
44114>>>>>>>        tWidgetConfigProp CurProp
44114>>>>>>>        
44114>>>>>>>        Get TruncateName sObjName to sObjName
44115>>>>>>>        If (sObjName <> '') Begin
44117>>>>>>>            Get DynamicObject sObjName to hoObj // Should be in memory as it's just created
44118>>>>>>>        End
44118>>>>>>>>
44118>>>>>>>        Else Begin
44119>>>>>>>            Move hoWidget to hoObj
44120>>>>>>>        End
44120>>>>>>>>
44120>>>>>>>        
44120>>>>>>>        If (hoObj <> 0) Begin
44122>>>>>>>            Move sObjName  to CurProp.sObjName
44123>>>>>>>            Move sPropName to CurProp.sPropName
44124>>>>>>>            Get ConfigurablePropExistsEx of hoWidget aProps CurProp to bConfigPropExists
44125>>>>>>>            
44125>>>>>>>            If (bConfigPropExists) Begin
44127>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to PropMeta
44128>>>>>>>                If (PropMeta.hmGetter <> 0) Begin
44130>>>>>>>                    Send InitDynamicProp of hoObj sPropName sPropVal 
44131>>>>>>>                End
44131>>>>>>>>
44131>>>>>>>            End
44131>>>>>>>>
44131>>>>>>>        End
44131>>>>>>>>
44131>>>>>>>    End_Procedure
44132>>>>>>>    
44132>>>>>>>    Procedure SaveConfiguration Boolean bToggleEditMode
44134>>>>>>>        String[] aParams
44135>>>>>>>     
44135>>>>>>>        If (num_arguments > 0) Begin
44137>>>>>>>            Move bToggleEditMode to aParams[-1]
44138>>>>>>>        End
44138>>>>>>>>
44138>>>>>>>        
44138>>>>>>>        Send ClientAction "saveConfiguration" aParams
44139>>>>>>>    End_Procedure
44140>>>>>>>    
44140>>>>>>>    Procedure ServerOnSaveConfiguration
44142>>>>>>>        tContainerDef ContainerDef ContainerConfig
44142>>>>>>>        tContainerDef ContainerDef ContainerConfig
44142>>>>>>>        tWidgetConfigPropValue[] aPropValues
44142>>>>>>>        tWidgetConfigPropValue[] aPropValues
44143>>>>>>>        Handle hoJson
44143>>>>>>>        Integer i iWidgets
44143>>>>>>>        String sWidgetId
44143>>>>>>>        Handle hoWidget
44143>>>>>>>        Boolean bUseCustomConfigurationStorage
44143>>>>>>>        
44143>>>>>>>        Get phoActionJsonData to hoJson
44144>>>>>>>        Set pbRequireAllMembers of hoJson to False
44145>>>>>>>        Get JsonToDataType of hoJson to ContainerConfig
44146>>>>>>>        
44146>>>>>>>        // Translate to def
44146>>>>>>>        Move ContainerConfig.sConfigVersionCode to ContainerDef.sConfigVersionCode
44147>>>>>>>        
44147>>>>>>>        // Get configurable widget props
44147>>>>>>>        Move ((SizeOfArray(ContainerConfig.aWidgets)) - 1) to iWidgets
44148>>>>>>>        
44148>>>>>>>        For i from 0 to iWidgets
44154>>>>>>>>
44154>>>>>>>            Move ContainerConfig.aWidgets[i].sDynId to sWidgetId
44155>>>>>>>            Get DynamicObject sWidgetId to hoWidget
44156>>>>>>>            Get GetConfigurablePropValues of hoWidget to aPropValues
44157>>>>>>>            
44157>>>>>>>            Move ContainerConfig.aWidgets[i] to ContainerDef.aWidgets[i]
44158>>>>>>>            Move aPropValues to ContainerDef.aWidgets[i].aConfig
44159>>>>>>>        Loop
44160>>>>>>>>
44160>>>>>>>        
44160>>>>>>>        Get UseCustomConfigurationStorage to bUseCustomConfigurationStorage
44161>>>>>>>        
44161>>>>>>>        If (bUseCustomConfigurationStorage) Begin
44163>>>>>>>            Send OnSaveCustomConfiguration ContainerDef
44164>>>>>>>        End
44164>>>>>>>>
44164>>>>>>>        Else Begin
44165>>>>>>>            // Local storage save
44165>>>>>>>            Send SaveConfigurationToLocalStorage ContainerDef
44166>>>>>>>        End
44166>>>>>>>>
44166>>>>>>>    End_Procedure
44167>>>>>>>    
44167>>>>>>>    Procedure SaveConfigurationToLocalStorage tContainerDef ContainerDef
44169>>>>>>>        String[] aParams
44170>>>>>>>        Handle hoJsonContainerDef
44170>>>>>>>        
44170>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonContainerDef
44171>>>>>>>        
44171>>>>>>>        Send DataTypeToJson of hoJsonContainerDef ContainerDef
44172>>>>>>>        
44172>>>>>>>        Send ClientActionEx 'saveConfigurationToLocalStorage' aParams hoJsonContainerDef
44173>>>>>>>    End_Procedure
44174>>>>>>>    
44174>>>>>>>    Procedure DoResetConfiguration
44176>>>>>>>        Boolean bUseCustomConfigurationStorage
44176>>>>>>>        
44176>>>>>>>        Get UseCustomConfigurationStorage to bUseCustomConfigurationStorage
44177>>>>>>>        If (bUseCustomConfigurationStorage) Begin
44179>>>>>>>            Send OnResetConfiguration
44180>>>>>>>        End
44180>>>>>>>>
44180>>>>>>>        Else Begin
44181>>>>>>>            // Local storage reset
44181>>>>>>>            Send ResetLocalConfiguration
44182>>>>>>>        End
44182>>>>>>>>
44182>>>>>>>        
44182>>>>>>>        // Call reload to reload configuration using the default
44182>>>>>>>        Send Reload
44183>>>>>>>    End_Procedure
