35378>>>>>>>    Procedure DisplayExistingFile String sPath
35380>>>>>>>        Boolean bExists
35380>>>>>>>        Integer iChnl iSize iPos
35380>>>>>>>        String sFileName
35380>>>>>>>        
35380>>>>>>>        Move 0 to iSize
35381>>>>>>>        
35381>>>>>>>        File_Exist sPath bExists
35382>>>>>>>        
35382>>>>>>>        Move (RightPos("\", sPath)) to iPos
35383>>>>>>>        Move (Right(sPath, Length(sPath) - iPos)) to sFileName
35384>>>>>>>        
35384>>>>>>>        
35384>>>>>>>        If (bExists) Begin
35386>>>>>>>            //  Determine file size
35386>>>>>>>            Move (Seq_New_Channel()) to iChnl
35387>>>>>>>            If (iChnl >= 0) Begin
35389>>>>>>>                Direct_Input channel iChnl sPath
35391>>>>>>>                Get_Channel_Size iChnl to iSize
35392>>>>>>>                Close_Input iChnl
35393>>>>>>>                Send Seq_Release_Channel iChnl
35394>>>>>>>            End
35394>>>>>>>>
35394>>>>>>>            Else If (iChnl = -1) Begin
35397>>>>>>>                Error DFErr_Program "I/O Channel Error"
35398>>>>>>>>
35398>>>>>>>            End
35398>>>>>>>>
35398>>>>>>>            Else If (iChnl = -2) Begin
35401>>>>>>>                Error DFErr_Program "No I/O Channel Available"
35402>>>>>>>>
35402>>>>>>>            End
35402>>>>>>>>
35402>>>>>>>        End
35402>>>>>>>>
35402>>>>>>>        
35402>>>>>>>        WebSet psFileName to sFileName
35403>>>>>>>        WebSet piFileSize to iSize
35404>>>>>>>        WebSet psFileMime to ""
35405>>>>>>>        WebSet peState to ciUploadStateDisplay
35406>>>>>>>        
35406>>>>>>>        Send ClientAction "updateDetails"
35407>>>>>>>    End_Procedure
