43241>>>    Procedure DoLogin
43244>>>        String sLoginName sPassword sPrevStateHash
43244>>>        Boolean bResult
43244>>>        
43244>>>        WebGet psValue of oLoginName to sLoginName
43245>>>        WebGet psValue of oPassword to sPassword
43246>>>        
43246>>>        Get UserLogin of (SessionManager(Self)) sLoginName sPassword to bResult
43247>>>        
43247>>>        If (bResult) Begin
43249>>>            Send Hide of oLogin
43250>>>            WebSet psCSSClass of (Host(Self)) to ""
43251>>>            
43251>>>            WebGet psPrevStateHash to sPrevStateHash
43252>>>            Send NavigateToStateHash of (Host(Self)) sPrevStateHash True
43253>>>            
43253>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
43253>>>            WebSet psValue of oLoginName to ""
43254>>>            WebSet psValue of oPassword  to ""
43255>>>            WebSet pbVisible of oWarning to False
43256>>>        End
43256>>>>
43256>>>        Else Begin
43257>>>            WebSet pbVisible of oWarning to True
43258>>>        End
43258>>>>
43258>>>    End_Procedure
43259>>>    
43259>>>    Procedure OnSubmit
43262>>>        Send DoLogin
43263>>>    End_Procedure
