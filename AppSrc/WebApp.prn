29326>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body.
29326>>>>>>>    Procedure ReportFatalError UShort usStatusCode String sReason UShort usStatusSubCode String sDescription
29328>>>>>>>        Handle hoJson hoJsonErr
29328>>>>>>>        UChar[] ucData
29329>>>>>>>        
29329>>>>>>>        //  Set headers & status
29329>>>>>>>        Send SetResponseStatus usStatusCode sReason usStatusSubCode
29330>>>>>>>        Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
29331>>>>>>>        Send AddHttpResponseHeader "Cache-Control" "no-cache"
29332>>>>>>>        
29332>>>>>>>        //  Generate JSON response header
29332>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
29333>>>>>>>        Send InitializeJsonType of hoJson jsonTypeObject
29334>>>>>>>        
29334>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonErr
29335>>>>>>>        Send InitializeJsonType of hoJsonErr jsonTypeObject
29336>>>>>>>        Send SetMember of hoJson "error" hoJsonErr
29337>>>>>>>        
29337>>>>>>>        Send SetMemberValue of hoJsonErr "status" jsonTypeString usStatusCode
29338>>>>>>>        Send SetMemberValue of hoJsonErr "reason" jsonTypeString sReason
29339>>>>>>>        Send SetMemberValue of hoJsonErr "message" jsonTypeString sDescription
29340>>>>>>>        
29340>>>>>>>        Get StringifyUtf8 of hoJson to ucData
29341>>>>>>>        Send OutputUChar ucData
29342>>>>>>>        
29342>>>>>>>        Send Destroy of hoJsonErr
29343>>>>>>>        Send Destroy of hoJson
29344>>>>>>>    End_Procedure
29345>>>>>>>    
29345>>>>>>>    // Generates a fatal error (HTTP error) with JSON in the body in the style of cWebService so 
29345>>>>>>>    // that older JavaScript Engines can parse them.
