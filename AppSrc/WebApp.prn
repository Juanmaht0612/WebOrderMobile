31516>>>>>>>>>                // if we we debugging, thereis no point in doing this
31516>>>>>>>>>                If (not(bDebugging) and bLocal) Begin
31518>>>>>>>>>                    Send MessageBoxError (sFullError + "\n\n" + sStack) // 1 means critical
31519>>>>>>>>>                End
31519>>>>>>>>>>
31519>>>>>>>>>                
31519>>>>>>>>>                // log the critical error to the event log
31519>>>>>>>>>                // if debugging, this can be an unhandled error
31519>>>>>>>>>                If bDebugging Begin
31521>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
31522>>>>>>>>>                End
31522>>>>>>>>>>
31522>>>>>>>>>                Else Begin
31523>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack  iLine iErrFile iErrField
31524>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError C_$CriticalErrorProgramHalted iLine 0 0
31525>>>>>>>>>                End
31525>>>>>>>>>>
31525>>>>>>>>>                // and end it all
31525>>>>>>>>>                Abort
31526>>>>>>>>>>
31526>>>>>>>>>            End
31526>>>>>>>>>>
31526>>>>>>>>>            
31526>>>>>>>>>            // if we are passing errors to VDF console, report the error
31526>>>>>>>>>            If bLocal Begin
31528>>>>>>>>>                Send MessageBoxError sFullError 0 // 0 means non-critical
31529>>>>>>>>>            End
31529>>>>>>>>>>
31529>>>>>>>>>            
31529>>>>>>>>>            // we make the following assumptions:
31529>>>>>>>>>            // If errors are queue
31529>>>>>>>>>            //    We assume the error is expected, and controlled
31529>>>>>>>>>            //    Write error to queue
31529>>>>>>>>>            //    Ddo not write to Event Log unless we are logging all errors.
31529>>>>>>>>>            //
31529>>>>>>>>>            // if errors are not queued
31529>>>>>>>>>            //    We assume the error is unexpected, and must be controlled
31529>>>>>>>>>            //    Display HTML error to browser unless this is disabled
31529>>>>>>>>>            //    Send to the event log (under the assumption that the error is unexpected).
31529>>>>>>>>>            CallStackDump sStack
31530>>>>>>>>>            Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
31531>>>>>>>>>            Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
31532>>>>>>>>>                
31532>>>>>>>>>            If bQueueErrors Begin
31534>>>>>>>>>                Send Set_Error iError sSystemErr sFullError iLine iErrFile iErrField
31535>>>>>>>>>                If bLogAllErrors Begin
31537>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
31538>>>>>>>>>                End
31538>>>>>>>>>>
31538>>>>>>>>>            End
31538>>>>>>>>>>
31538>>>>>>>>>            Else Begin
31539>>>>>>>>>                If bHtmlErrors Begin
31541>>>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
31541>>>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
31541>>>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
31541>>>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
31542>>>>>>>>>                End
31542>>>>>>>>>>
31542>>>>>>>>>                If bDebugging  Begin
31544>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
31545>>>>>>>>>                End
31545>>>>>>>>>>
31545>>>>>>>>>                Else Begin
31546>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
31547>>>>>>>>>                End
31547>>>>>>>>>>
31547>>>>>>>>>            End
31547>>>>>>>>>>
31547>>>>>>>>>        End
31547>>>>>>>>>>
31547>>>>>>>>>        
31547>>>>>>>>>        
31547>>>>>>>>>    End_Procedure
31548>>>>>>>>>
31548>>>>>>>>>    //  Is called by df on errors. It searches additional information and
31548>>>>>>>>>    //  saves the error. The main part of this is the error handler for AJAX framework
31548>>>>>>>>>    // applications If a basic or a legacy webapp, this Error is "forwarded" to BasicErrorReport.
31548>>>>>>>>>    //
31548>>>>>>>>>    Procedure HandleError Integer iErrNum Integer iErrLine String sErrText
31550>>>>>>>>>        String sSystemErr  sCaption  sExtErr
31550>>>>>>>>>        Boolean bUserError bDisplayControl
31550>>>>>>>>>        Boolean bOldAllErrorsToHtml bAllErrorstoEventLog bInRecording bTrapped
31550>>>>>>>>>        Integer iErrFile iErrField iSrc iTxtlen
31550>>>>>>>>>        Handle hoCurrentView hoTargetControl hoInetSession
31550>>>>>>>>>        
31550>>>>>>>>>                
31550>>>>>>>>>        Get phoInetSession to hoInetSession
31551>>>>>>>>>        Get pbInErrorRecording to bInRecording
31552>>>>>>>>>        
31552>>>>>>>>>        // This means is not happening during an AJAX style Request or it means that this is an
31552>>>>>>>>>        // old webapp style error. If hoInetSession is 0, it is fatal
31552>>>>>>>>>        If (not(bInRecording)) Begin
31554>>>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
31555>>>>>>>>>        End
31555>>>>>>>>>>
31555>>>>>>>>>        Else If (hoInetSession=0) Begin
31558>>>>>>>>>            // this should not be possible at this point.
31558>>>>>>>>>            // If it is, it's fatal and program will abort
31558>>>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
31559>>>>>>>>>            // will abort
31559>>>>>>>>>        End
31559>>>>>>>>>>
31559>>>>>>>>>        Else Begin
31560>>>>>>>>>            
31560>>>>>>>>>            // process an error that occurs during an AJAX Server request
31560>>>>>>>>>            
31560>>>>>>>>>            Move False to bDisplayControl
31561>>>>>>>>>            
31561>>>>>>>>>            // the caption normally used for handled user errors
31561>>>>>>>>>            Get psUserErrorCaption to sCaption
31562>>>>>>>>>            // if an operator error this may be a Procedure UserError situation where the
31562>>>>>>>>>            // caption is passed in the error text. If so, get the caption
31562>>>>>>>>>            If (iErrNum=DFERR_OPERATOR) Begin
31564>>>>>>>>>                Move (pos(C_ErrorCaption,sErrText)) to iSrc
31565>>>>>>>>>                If iSrc Begin
31567>>>>>>>>>                    Move (length(C_ErrorCaption)) to  iTxtLen
31568>>>>>>>>>                    Move (remove(sErrText, 1, iSrc-1 + iTxtLen )) to sCaption
31569>>>>>>>>>                    Move (Left(sErrText,iSrc-1)) to sErrText
31570>>>>>>>>>                End
31570>>>>>>>>>>
31570>>>>>>>>>            End
31570>>>>>>>>>>
31570>>>>>>>>>            
31570>>>>>>>>>            // Get the message....
31570>>>>>>>>>            Get Error_Description iErrNum sErrText to sSystemErr
31571>>>>>>>>>            
31571>>>>>>>>>            // Get file and field (of data dictionary error) if available
31571>>>>>>>>>            // and use this to determine the target control by searching
31571>>>>>>>>>            // for the first control with the same data binding....
31571>>>>>>>>>            If (ghoErrorSource <> 0) Begin
31573>>>>>>>>>                Get Extended_Error_file  of ghoErrorSource to iErrFile
31574>>>>>>>>>                Get Extended_Error_Field of ghoErrorSource to iErrField
31575>>>>>>>>>                
31575>>>>>>>>>                If (iErrFile > 0) Begin
31577>>>>>>>>>                    Get DetermineCurrentView to hoCurrentView
31578>>>>>>>>>                    Move False to bDisplayControl
31579>>>>>>>>>                    If (iErrField > 0 and hoCurrentView <> C_WebUnresolvedObject) Begin
31581>>>>>>>>>                        Get FirstControlWithDataBinding of hoCurrentView iErrFile iErrField to hoTargetControl
31582>>>>>>>>>                        
31582>>>>>>>>>                        If (hoTargetControl <> C_WebUnresolvedObject) Begin
31584>>>>>>>>>                            //  Try to display local error balloon
31584>>>>>>>>>                            Get ShowControlError of hoTargetControl iErrNum sSystemErr to bDisplayControl
31585>>>>>>>>>                        End
31585>>>>>>>>>>
31585>>>>>>>>>                    End
31585>>>>>>>>>>
31585>>>>>>>>>                    //  If no control found (or capable of showing errors) then we extend the error message with file and field name
31585>>>>>>>>>                    If (not(bDisplayControl)) Begin
31587>>>>>>>>>                        Get Extended_Error_Message of ghoErrorSource to sExtErr
31588>>>>>>>>>                        Move (sErrText + "\n" + sExtErr) to sErrText
31589>>>>>>>>>                        Move (sSystemErr + "\n" + sExtErr) to sSystemErr
31590>>>>>>>>>                        Move (Replaces("\n",sSystemErr,"\n\r")) to sSystemErr
31591>>>>>>>>>                    End
31591>>>>>>>>>>
31591>>>>>>>>>                End
31591>>>>>>>>>>
31591>>>>>>>>>            End
31591>>>>>>>>>>
31591>>>>>>>>>            
31591>>>>>>>>>            // Test if this is a user error or an unhandled error (i.e. "find past end of file")....
31591>>>>>>>>>            Get IsUserError iErrNum to bUserError
31592>>>>>>>>>            If not bUserError Begin
31594>>>>>>>>>                Get psUnhandledErrorCaption to sCaption
31595>>>>>>>>>            End
31595>>>>>>>>>>
31595>>>>>>>>>            
31595>>>>>>>>>            //  Forward the error to the webapp object (if not already handled by the contorl)
31595>>>>>>>>>            If (phoWebHost(Self) > 0) Begin
31597>>>>>>>>>                If (not(bDisplayControl)) Begin
31599>>>>>>>>>                    Send ShowError of (phoWebHost(Self)) iErrNum iErrLine sSystemErr sCaption bUserError
31600>>>>>>>>>                End
31600>>>>>>>>>>
31600>>>>>>>>>            End
31600>>>>>>>>>>
31600>>>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bAllErrorstoEventLog
31601>>>>>>>>>            If (not(bUserError) or bAllErrorstoEventLog) Begin
31603>>>>>>>>>                Send BasicErrorReport iErrNum iErrLine sErrText
31604>>>>>>>>>            End
31604>>>>>>>>>>
31604>>>>>>>>>        End
31604>>>>>>>>>>
31604>>>>>>>>>    End_Procedure
31605>>>>>>>>>    
31605>>>>>>>>>    // FinishRecording:
31605>>>>>>>>>    
31605>>>>>>>>>    // Stops fetching the error by resetting the origional error handler.
31605>>>>>>>>>    //
31605>>>>>>>>>    // Returns - Array with error structs of occurred errors
31605>>>>>>>>>    Procedure FinishRecording
31607>>>>>>>>>        Boolean bInErrorRecording
31607>>>>>>>>>        Get pbInErrorRecording to bInErrorRecording
31608>>>>>>>>>        If bInErrorRecording Begin
31610>>>>>>>>>            Set pbInErrorRecording to False
31611>>>>>>>>>        End
31611>>>>>>>>>>
31611>>>>>>>>>    End_Procedure
31612>>>>>>>>>    
31612>>>>>>>>>    
31612>>>>>>>>>    // Starts fetching the errors by setting this object as the error handler
31612>>>>>>>>>    // and clearing the error array.
31612>>>>>>>>>    Procedure StartRecording Handle hoHost
31614>>>>>>>>>        Boolean bInErrorRecording
31614>>>>>>>>>        
31614>>>>>>>>>        Get pbInErrorRecording to bInErrorRecording
31615>>>>>>>>>        If (not(bInErrorRecording)) Begin
31617>>>>>>>>>            Set pbInErrorRecording to True
31618>>>>>>>>>        End
31618>>>>>>>>>>
31618>>>>>>>>>        
31618>>>>>>>>>        Set phoWebHost to hoHost
31619>>>>>>>>>    End_Procedure
