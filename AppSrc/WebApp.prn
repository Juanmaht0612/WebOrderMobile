30226>>>>>>>>>>>    
30226>>>>>>>>>>>    // Acquire key container handle
30226>>>>>>>>>>>    Function AcquireContext Returns Handle
30228>>>>>>>>>>>        Integer iProvider
30228>>>>>>>>>>>        WString wProvider
30228>>>>>>>>>>>        Handle hProv
30228>>>>>>>>>>>        Boolean bOk
30228>>>>>>>>>>>        Pointer pProv
30228>>>>>>>>>>>        
30228>>>>>>>>>>>        Move 0 to hProv
30229>>>>>>>>>>>        Get piProvider to iProvider
30230>>>>>>>>>>>        Get psProvider to wProvider
30231>>>>>>>>>>>        
30231>>>>>>>>>>>        //  Determine address to be passed as provider
30231>>>>>>>>>>>        If (Trim(wProvider) <> "") Begin
30233>>>>>>>>>>>            Move (AddressOf(wProvider)) to pProv
30234>>>>>>>>>>>        End
30234>>>>>>>>>>>>
30234>>>>>>>>>>>        Else Begin
30235>>>>>>>>>>>            Move 0 to pProv
30236>>>>>>>>>>>        End
30236>>>>>>>>>>>>
30236>>>>>>>>>>>        
30236>>>>>>>>>>>        //  Acquire Crypto Context. Note: pProv is pointer to UTF16 string.
30236>>>>>>>>>>>        Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_VERIFYCONTEXT)) to bOk
30237>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30239>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET ior CRYPT_VERIFYCONTEXT)) to bOk
30240>>>>>>>>>>>        End
30240>>>>>>>>>>>>
30240>>>>>>>>>>>        
30240>>>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
30242>>>>>>>>>>>            // Fallback to original
30242>>>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,0)) to bOk
30243>>>>>>>>>>>            
30243>>>>>>>>>>>            If (not(bOk) or hProv = 0) Begin
30245>>>>>>>>>>>                Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET)) to bOk
30246>>>>>>>>>>>            End
30246>>>>>>>>>>>>
30246>>>>>>>>>>>        End
30246>>>>>>>>>>>>
30246>>>>>>>>>>>        Set Private_phProv to hProv
30247>>>>>>>>>>>        
30247>>>>>>>>>>>        Function_Return hProv
30248>>>>>>>>>>>    End_Function
