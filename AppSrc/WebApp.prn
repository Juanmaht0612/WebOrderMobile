30275>>>>>>>>>>>    // Imports a plain text key
30275>>>>>>>>>>>    Function ImportPlainTextKey Handle hProv UChar[] ucaKey Returns Handle
30277>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30277>>>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
30277>>>>>>>>>>>        Boolean   bSuccess
30277>>>>>>>>>>>        Handle    hKey
30277>>>>>>>>>>>        Integer   iHeadSize iKeySize
30277>>>>>>>>>>>        UChar[]   ucaKeyblob
30278>>>>>>>>>>>        Integer iVoid
