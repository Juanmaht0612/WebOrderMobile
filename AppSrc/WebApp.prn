62198>>>            Get NamedValueIndex NavigateData.NamedValues "OrderHeaderOrderTotalMode" to iOrderHeaderOrderTotalMode
62199>>>
62199>>>            If (iOrderHeaderOrderTotalMode > -1 and iOrderHeaderOrderTotal > -1) Begin
62201>>>                Send AddFilter sReportId "{OrderHeader.Order_Total}" NavigateData.NamedValues[iOrderHeaderOrderTotalMode].sValue NavigateData.NamedValues[iOrderHeaderOrderTotal].sValue
62202>>>            End
