27286>>>>>>>>>    // Scrolls a column into the view by scrolling horizontally. Can only be used when 
27286>>>>>>>>>    // pbAutoColumnSizing is false and pbScroll is true.
27286>>>>>>>>>    Procedure ScrollToColumnObject Handle hoColumn
27288>>>>>>>>>        Handle[] aColumnObjects
27289>>>>>>>>>        Integer iColumnIndex
27289>>>>>>>>>        String[] aParams
27290>>>>>>>>>        
27290>>>>>>>>>        Get phoColumnObjects to aColumnObjects
27291>>>>>>>>>        
27291>>>>>>>>>        Move (SearchArray(hoColumn, aColumnObjects)) to iColumnIndex
27292>>>>>>>>>        
27292>>>>>>>>>        If (iColumnIndex >= 0) Begin
27294>>>>>>>>>            Move iColumnIndex to aParams[0]    
27295>>>>>>>>>        
27295>>>>>>>>>            Send ClientAction "scrollToCol" aParams
27296>>>>>>>>>        End
27296>>>>>>>>>>
27296>>>>>>>>>        Else Begin
27297>>>>>>>>>            Error DFERR_PROGRAM "Invalid column handle!"
27298>>>>>>>>>>
27298>>>>>>>>>        End
27298>>>>>>>>>>
27298>>>>>>>>>    End_Procedure
