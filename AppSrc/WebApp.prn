46814>>>>>        Procedure OnClick
46817>>>>>            String sAction sUrl
46817>>>>>            Integer eNavType
46817>>>>>            
46817>>>>>            WebGet psAction of (Widget(Self)) to sAction
46818>>>>>            
46818>>>>>            If (sAction = "Custom") Begin
46820>>>>>                WebGet psUrl of (Widget(Self)) to sUrl
46821>>>>>                WebGet peNavType of (Widget(Self)) to eNavType
46822>>>>>                
46822>>>>>                If (sUrl <> "") Begin
46824>>>>>                    Send NavigateToPage sUrl eNavType
46825>>>>>                End                
46825>>>>>>
46825>>>>>            End
46825>>>>>>
46825>>>>>            Else Begin
46826>>>>>                Case Begin
46826>>>>>                    Case (sAction = "CustomerQuery")
46828>>>>>                        Send NavigateForward of oSelectOrdersByCustomer Self
46829>>>>>                        Break
46830>>>>>                    Case (sAction = "OrdersQuery")
46833>>>>>                        Send NavigateForward of oSelectOrder Self
46834>>>>>                        Break
46835>>>>>                    Case (sAction = "SalesPersonQuery")
46838>>>>>                        Send NavigateForward of oSelectSalesPerson Self
46839>>>>>                        Break
46840>>>>>                    Case (sAction = "NewCustomer")
46843>>>>>                        Send NavigateForward of oZoomCustomer Self
46844>>>>>                        Break
46845>>>>>                    Case (sAction = "NewOrder")
46848>>>>>                        Send NavigateForward of oZoomOrder Self
46849>>>>>                        Break
46850>>>>>                    Case (sAction = "ProductQuery")
46853>>>>>                        Send NavigateForward of oDemoGrouping Self
46854>>>>>                        Break
46855>>>>>                    Case Else
46855>>>>>                        Error DFERR_PROGRAM "Unimplemented action"
46856>>>>>>
46856>>>>>                Case End
46856>>>>>            End
46856>>>>>>
46856>>>>>        End_Procedure
