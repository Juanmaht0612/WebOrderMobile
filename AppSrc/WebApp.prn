29750>>>>>>>>>        Property Boolean pbRegisterUploadsFolder True       //  If true the default uploads folder (UploadFolder on cWebApp) will be registered as valid upload folder
29751>>>>>>>>>        Property Boolean pbAllowInvalidDownloadUrl False    //  Set to true if you need to generate download urls for files that do not exist yet
