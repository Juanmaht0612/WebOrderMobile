49227>>>        Procedure UpdateFilterDetail String sFilter
49230>>>            DateTime dtStart dtEnd dtCompStart dtCompEnd
49230>>>            String sDetail sMonth
49230>>>            Integer iYear iCompYear
49230>>>            Integer iWeek iCompWeek
49230>>>            Integer iMonth iCompMonth
49230>>>        
49230>>>            Get StartDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtStart
49231>>>            Get EndDateByFilterType   of oWidgetFilterAndDateFormatHandler sFilter to dtEnd
49232>>>            Get CompareStartDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtCompStart
49233>>>            Get CompareEndDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtCompEnd
49234>>>        
49234>>>            Case Begin
49234>>>                Case (sFilter = "year")
49236>>>                    Move (DateGetYear(dtStart))     to iYear
49237>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49238>>>        
49238>>>                    Move (SFormat("Compares: %1 to %2", iYear, iCompYear)) to sDetail
49239>>>                    Case Break
49240>>>        
49240>>>                Case (sFilter = "month")
49243>>>                    Move (DateGetYear(dtStart))     to iYear
49244>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49245>>>                    Move (DateGetMonth(dtStart))    to iMonth
49246>>>                    Get DateGetMonthShortName of oWidgetFilterAndDateFormatHandler iMonth to sMonth
49247>>>        
49247>>>                    Move (SFormat("Compares: %1 %2 to %1 %3", sMonth, iYear, iCompYear)) to sDetail
49248>>>                    Case Break
49249>>>        
49249>>>                Case (sFilter = "week")
49252>>>                    Move (DateGetWeekOfYearISO(dtStart))     to iWeek
49253>>>                    Move (DateGetWeekOfYearISO(dtCompStart)) to iCompWeek
49254>>>                    Move (DateGetYear(dtStart))     to iYear
49255>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49256>>>        
49256>>>                    Move (SFormat("Compares: Week %1 (%2) to Week %3 (%4)", iWeek, iYear, iCompWeek, iCompYear)) to sDetail
49257>>>                    Case Break
49258>>>        
49258>>>                Case (sFilter = "last_year")
49261>>>                    Move (DateGetYear(dtStart))     to iYear
49262>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49263>>>        
49263>>>                    Move (SFormat("Compares: %1 to %2", iYear, iCompYear)) to sDetail
49264>>>                    Case Break
49265>>>        
49265>>>                Case (sFilter = "last_month")
49268>>>                    Move (DateGetMonth(dtStart)) to iMonth
49269>>>                    Move (DateGetYear(dtStart))  to iYear
49270>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49271>>>                    Get DateGetMonthShortName of oWidgetFilterAndDateFormatHandler iMonth to sMonth
49272>>>                    
49272>>>                    Move (SFormat("Compares: %1 %2 to %1 %3", sMonth, iYear, iCompYear)) to sDetail
49273>>>                    Case Break
49274>>>        
49274>>>                Case (sFilter = "last_week")
49277>>>                    Move (DateGetWeekOfYearISO(dtStart))     to iWeek
49278>>>                    Move (DateGetWeekOfYearISO(dtCompStart)) to iCompWeek
49279>>>                    Move (DateGetYear(dtStart))     to iYear
49280>>>                    Move (DateGetYear(dtCompStart)) to iCompYear
49281>>>        
49281>>>                    Move (SFormat("Compares: Week %1 (%2) to Week %3 (%4)", iWeek, iYear, iCompWeek, iCompYear)) to sDetail
49282>>>                    Case Break
49283>>>        
49283>>>                // fallback (if ever needed)
49283>>>                Case Else
49283>>>                    Move (SFormat("Compares: %1 - %2 to %3 - %4", dtStart, dtEnd, dtCompStart, dtCompEnd)) to sDetail
49284>>>            Case End
49284>>>        
49284>>>            WebSet psCaption of oFilterCompareDetailLabel to sDetail
49285>>>        End_Procedure
