34038>>>>>>>    Procedure SetMenuViewAccess Boolean bAllowAccess
34040>>>>>>>        // used to handle access view menus. By default it disables items where access is not allowed. Depending
34040>>>>>>>        // on the value of pbHideViewWhenNoAccess this will either enable or render menu items. If you need to
34040>>>>>>>        // do other things, augment OnChangeRights
34040>>>>>>>        Boolean bEnabled bHideViewWhenNoAccess
34040>>>>>>>
34040>>>>>>>        Get pbHideViewWhenNoAccess to bHideViewWhenNoAccess
34041>>>>>>>        // if a view menu item set pbEnabled or pbRendered based on the views AllowAccess
34041>>>>>>>        // If you want to do something else, like hide it, you can augment this or
34041>>>>>>>        // augment OnChangeRights
34041>>>>>>>        If bHideViewWhenNoAccess Begin
34043>>>>>>>            WebGet pbRender to bEnabled
34044>>>>>>>            If (bEnabled <> bAllowAccess) Begin
34046>>>>>>>                WebSet pbRender to bAllowAccess
34047>>>>>>>            End
34047>>>>>>>>
34047>>>>>>>        End
34047>>>>>>>>
34047>>>>>>>        Else Begin
34048>>>>>>>            WebGet pbEnabled to bEnabled
34049>>>>>>>            If (bEnabled <> bAllowAccess) Begin
34051>>>>>>>                WebSet pbEnabled to bAllowAccess
34052>>>>>>>            End
34052>>>>>>>>
34052>>>>>>>        End
34052>>>>>>>>
34052>>>>>>>    End_Procedure
