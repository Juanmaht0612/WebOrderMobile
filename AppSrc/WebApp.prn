51011>>>    // Add code to customize your Zoon View based on how it was invoked.
51011>>>    // Use NavigateData to determine the context this view will be used in.
51011>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
51014>>>        
51014>>>        // if this view is being used in multiple contexts you may need a block of code
51014>>>        // like this to handle customizations. This would include hiding rows and buttons
51014>>>        // (WebSet pbRender) and changing the values of various captions.
51014>>>        Case Begin
51014>>>            Case (NavigateData.eNavigateType=nfFromMain)
51016>>>                // If from main, this is a propbably a main file Select to Zoom.
51016>>>                // This is the most typical way to navigate to a zoom.
51016>>>                Case Break
51017>>>            
51017>>>            Case (NavigateData.eNavigateType=nfFromParent)
51020>>>                // If from parent, this is a constrained drill down.
51020>>>                // If needed you could check NaviateData.iTable to determine the constraining parent.
51020>>>                // This would be unusual - normally you drill down from a parent to a list (Select view).
51020>>>                Case Break
51021>>>            
51021>>>            Case (NavigateData.eNavigateType=nfFromChild)
51024>>>                // If from child, this is a probably a parent Zoom from a Zoom.
51024>>>                // This is unusual but it might be used for adding a new child record.
51024>>>                Case Break
51025>>>            
51025>>>            Case Else // must be nfUndefined
51025>>>                // This may be the start of a query or this may be used for some kind of
51025>>>                // custom operation. You may want to check NavigateData.NamedValues.
51025>>>                
51025>>>        Case End
51025>>>        
51025>>>        // Action buttons can be changed dynamically during a Zoom's display lifetime. It is
51025>>>        // best to set these buttons in their own procedure so you can change later.
51025>>>        Send SetActionButtons
51026>>>        
51026>>>    End_Procedure
51027>>>    
51027>>>End_Object
