32262>>>>>>>>>        Get pbAddEmptyItem to bAddEmptyItem
32263>>>>>>>>>
32263>>>>>>>>>        Set paComboItems to atEmpty
32264>>>>>>>>>        Set private_paRowIDs to (ResizeArray(private_paRowIDs(Self),0))    // zero the row IDs array
32265>>>>>>>>>
32265>>>>>>>>>        Get Server to hoServer
32266>>>>>>>>>        Get Data_File  to iFile
32267>>>>>>>>>        Get Data_Field to iField
32268>>>>>>>>>
32268>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
32270>>>>>>>>>            //  Do security check
32270>>>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
32272>>>>>>>>>                Procedure_Return
32273>>>>>>>>>            End
32273>>>>>>>>>>
32273>>>>>>>>>            
32273>>>>>>>>>            // if your DD does not have a default value you need to include an empty value. Even if you have a default
32273>>>>>>>>>            // it is fine to allow a blank line, which will probably fail upon validation (unless the DD allows blanks)
32273>>>>>>>>>            If (bAddEmptyItem) Begin
32275>>>>>>>>>                Get psEmptyItemDescription to sEmptyItemDescription
32276>>>>>>>>>                Send ComboFillItem 0 "" sEmptyItemDescription 0 (NullRowID()) 
32277>>>>>>>>>            End
32277>>>>>>>>>>
32277>>>>>>>>>            
32277>>>>>>>>>            Send File_Field_Fill_List to hoServer iFile iField Self msg_ComboFillItem
32278>>>>>>>>>        End
32278>>>>>>>>>>
32278>>>>>>>>>    End_Procedure
