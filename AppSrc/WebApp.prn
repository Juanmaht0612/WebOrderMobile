34679>>>>>>>    // by default this raises an error. If you want a failed relational list to not raise an
34679>>>>>>>    // error but to default to a different mode such as umPromptValue, just remove the error and
34679>>>>>>>    // set peUpdateMode.
34679>>>>>>>    Procedure OnRelationalPromptListError
34681>>>>>>>        Error DFERR_PROGRAM C_$PromptListCannotbeRelational
34682>>>>>>>>
34682>>>>>>>    End_Procedure
34683>>>>>>>    
34683>>>>>>>    // called for relational update. DD should contain selected record
34683>>>>>>>    Procedure OnMoveValueOutByRelational Handle hoInvokingObject
34685>>>>>>>        RowID rRowId
34685>>>>>>>        Handle hoInvokingServer hoServer
34685>>>>>>>        Integer iFile 
34685>>>>>>>        Boolean bDataAware bSuccess
34685>>>>>>>
34685>>>>>>>        Get pbDataAware to bDataAware
34686>>>>>>>        If not bDataAware Begin
34688>>>>>>>            // this should have already been tested and should not be possible
34688>>>>>>>            Error DFERR_PROGRAM "Assert: OnMoveValueOutByRelational called by non data aware grid list can not be used as a relational prompt list for this object"
34689>>>>>>>>
34689>>>>>>>            Procedure_Return
34690>>>>>>>        End
34690>>>>>>>>
34690>>>>>>>
34690>>>>>>>        Get Server to hoServer
34691>>>>>>>        Get Main_File of hoServer to iFile
34692>>>>>>>        Get CurrentRowId of hoServer to rRowId
34693>>>>>>>        If (not(IsNullRowID(rRowId))) Begin
34695>>>>>>>            Get Server of hoInvokingObject to hoInvokingServer
34696>>>>>>>            Get FindByRowIdEx of hoInvokingServer iFile rRowId to bSuccess
34697>>>>>>>            // this is very unlikely
34697>>>>>>>            If not bSuccess Begin
34699>>>>>>>                Error DFERR_CANT_REFIND_RECORD
34700>>>>>>>>
34700>>>>>>>            End
34700>>>>>>>>
34700>>>>>>>        End
34700>>>>>>>>
34700>>>>>>>    End_Procedure
34701>>>>>>>
34701>>>>>>>    // called for move value out update. DD and web column objects should contain selected record
34701>>>>>>>    Procedure OnMoveValueOutByValue Handle hoInvokingObject
34703>>>>>>>        String sValue
34703>>>>>>>        Handle hoCol
34703>>>>>>>        Integer iCol
34703>>>>>>>
34703>>>>>>>        WebGet piUpdateColumn to iCol
34704>>>>>>>        Get GetColumnObject iCol to hoCol
34705>>>>>>>        
