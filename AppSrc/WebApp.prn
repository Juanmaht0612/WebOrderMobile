30371>>>>>>>>>>>    // Creates a key
30371>>>>>>>>>>>    Function CreateKey Handle hProv Returns Handle
30373>>>>>>>>>>>        Integer iAlg iType iByte iLength iSize
30373>>>>>>>>>>>        CryptoBlob keyBlob
30373>>>>>>>>>>>        CryptoBlob keyBlob
30373>>>>>>>>>>>        Boolean bOk
30373>>>>>>>>>>>        Handle hKey
30373>>>>>>>>>>>        UChar[] aKey
30374>>>>>>>>>>>
30374>>>>>>>>>>>        Get paKey to aKey
30375>>>>>>>>>>>        Get piKeyAlg to iAlg
30376>>>>>>>>>>>        Get piKeyType to iType
30377>>>>>>>>>>>        Move iAlg                   to keyBlob.header.bType
30378>>>>>>>>>>>        Move CUR_BLOB_VERSION       to keyBlob.header.bVersion
30379>>>>>>>>>>>        Move iType                  to keyBlob.header.aiKeyAlg
30380>>>>>>>>>>>        Move (SizeOfArray(aKey))    to keyBlob.cbKeySize
30381>>>>>>>>>>>        
30381>>>>>>>>>>>        Move (SizeOfArray(aKey)-1) to iLength
30382>>>>>>>>>>>        For iByte from 0 to iLength
30388>>>>>>>>>>>>
30388>>>>>>>>>>>            Move aKey[iByte] to keyBlob.rgbKeyData[iByte]
30389>>>>>>>>>>>        Loop
30390>>>>>>>>>>>>
30390>>>>>>>>>>>        
30390>>>>>>>>>>>        Move 0 to hKey
30391>>>>>>>>>>>        Move (CryptImportKey(hProv,AddressOf(keyBlob),SizeOfType(CryptoBlob),0,0,AddressOf(hKey))) to bOk
30392>>>>>>>>>>>        Function_Return hKey
30393>>>>>>>>>>>    End_Function
30394>>>>>>>>>>>    
30394>>>>>>>>>>>    // Sets the key parameters
30394>>>>>>>>>>>    Function SetKeyParameters Handle hKey Returns Boolean
30396>>>>>>>>>>>        Integer iPadding iMode
30396>>>>>>>>>>>        Boolean bOk
30396>>>>>>>>>>>        UChar[] aIV
30397>>>>>>>>>>>        
30397>>>>>>>>>>>        //Move (SizeOfArray(aIV)-1) to iLength
30397>>>>>>>>>>>        //For iByte from 0 to iLength
30397>>>>>>>>>>>        //    Move iByte to aIV[iByte]
30397>>>>>>>>>>>        //Loop
30397>>>>>>>>>>>
30397>>>>>>>>>>>        // Set initialization vector
30397>>>>>>>>>>>        Get paIV to aIV
30398>>>>>>>>>>>        Move (CryptSetKeyParam(hKey,KP_IV,AddressOf(aIV),0)) to bOk
30399>>>>>>>>>>>        If (bOk) Begin
30401>>>>>>>>>>>            // Set padding
30401>>>>>>>>>>>            Get piKeyPadding to iPadding
30402>>>>>>>>>>>            Move (CryptSetKeyParam(hKey,KP_PADDING,AddressOf(iPadding),0)) to bOk
30403>>>>>>>>>>>            If (bOk) Begin
30405>>>>>>>>>>>                // Set move
30405>>>>>>>>>>>                Get piKeyMode to iMode
30406>>>>>>>>>>>                Move (CryptSetKeyParam(hKey,KP_MODE,AddressOf(iMode),0)) to bOk
30407>>>>>>>>>>>            End
30407>>>>>>>>>>>>
30407>>>>>>>>>>>        End
30407>>>>>>>>>>>>
30407>>>>>>>>>>>        Function_Return bOk        
30408>>>>>>>>>>>    End_Function
30409>>>>>>>>>>>    
30409>>>>>>>>>>>    // Encrypts using block cipher
30409>>>>>>>>>>>    Function BlockEncrypt UChar[] ucData Returns UChar[]
30411>>>>>>>>>>>        Handle hProv hKey
30411>>>>>>>>>>>        Integer iLen iSize iBlocks
30411>>>>>>>>>>>        Boolean bOk
30411>>>>>>>>>>>        
30411>>>>>>>>>>>        Get AcquireContext to hProv
30412>>>>>>>>>>>        If (hProv) Begin
30414>>>>>>>>>>>            // Create key
30414>>>>>>>>>>>            Get CreateKey hProv to hKey
30415>>>>>>>>>>>            If (hKey) Begin
30417>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30418>>>>>>>>>>>                If (bOk) Begin
30420>>>>>>>>>>>                    // Buffer for block ciphers can be up to block length larger
30420>>>>>>>>>>>                    Get piBlockSize to iSize
30421>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30422>>>>>>>>>>>                    
30422>>>>>>>>>>>                    Move ((iLen/iSize)+1) to iBlocks
30423>>>>>>>>>>>                    Move (ResizeArray(ucData,iBlocks*iSize)) to ucData
30424>>>>>>>>>>>                    Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen),SizeOfArray(ucData))) to bOk
30425>>>>>>>>>>>                End
30425>>>>>>>>>>>>
30425>>>>>>>>>>>                Get DestroyKey hKey to bOk
30426>>>>>>>>>>>            End
30426>>>>>>>>>>>>
30426>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30427>>>>>>>>>>>        End
30427>>>>>>>>>>>>
30427>>>>>>>>>>>        Function_Return ucData
30428>>>>>>>>>>>    End_Function
30429>>>>>>>>>>>    
30429>>>>>>>>>>>    // Decrypts using block cipher
30429>>>>>>>>>>>    Function BlockDecrypt UChar[] ucData Returns UChar[]
30431>>>>>>>>>>>        Handle hProv hKey
30431>>>>>>>>>>>        Integer iLen
30431>>>>>>>>>>>        Boolean bOk
30431>>>>>>>>>>>        
30431>>>>>>>>>>>        Get AcquireContext to hProv
30432>>>>>>>>>>>        If (hProv) Begin
30434>>>>>>>>>>>            // Create key
30434>>>>>>>>>>>            Get CreateKey hProv to hKey
30435>>>>>>>>>>>            If (hKey) Begin
30437>>>>>>>>>>>                Get SetKeyParameters hKey to bOk
30438>>>>>>>>>>>                If (bOk) Begin
30440>>>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
30441>>>>>>>>>>>                    Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen))) to bOk
30442>>>>>>>>>>>                    Move (ResizeArray(ucData,iLen)) to ucData
30443>>>>>>>>>>>                End
30443>>>>>>>>>>>>
30443>>>>>>>>>>>                Get DestroyKey hKey to bOk
30444>>>>>>>>>>>            End
30444>>>>>>>>>>>>
30444>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30445>>>>>>>>>>>        End
30445>>>>>>>>>>>>
30445>>>>>>>>>>>        Function_Return ucData
30446>>>>>>>>>>>    End_Function
