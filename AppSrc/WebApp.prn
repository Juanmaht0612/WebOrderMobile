55299>>>>>>>    Procedure ReadDevMode
55301>>>>>>>        Integer iResult
55301>>>>>>>        Handle hDevMode
55301>>>>>>>        Pointer pDevMode
55301>>>>>>>        DEVMODEW dm
55301>>>>>>>        DEVMODEW dm
55301>>>>>>>
55301>>>>>>>        Get phDevMode to hDevMode
55302>>>>>>>        If (hDevMode = 0) Begin
55304>>>>>>>            Procedure_Return
55305>>>>>>>        End
55305>>>>>>>>
55305>>>>>>>
55305>>>>>>>        // Lock allocated memory
55305>>>>>>>        Move (GlobalLock (hDevmode)) to pDevMode
55306>>>>>>>        If (pDevmode = 0) Begin
55308>>>>>>>            Procedure_Return
55309>>>>>>>        End
55309>>>>>>>>
55309>>>>>>>
55309>>>>>>>        // Copy the information from the memory pointer
55309>>>>>>>        Move (CopyMemory (AddressOf (dm), pDevMode, SizeOfType (DEVMODEW))) to iResult
55310>>>>>>>
55310>>>>>>>        // Copy the devmode data to properties of the cPrintDialog object
55310>>>>>>>        Send ReadDevModeData dm
55311>>>>>>>
55311>>>>>>>        // Unlock the memory
55311>>>>>>>        Move (GlobalUnlock (hDevMode)) to iResult
55312>>>>>>>    End_Procedure
