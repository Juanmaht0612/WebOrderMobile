21359>>>>>>>>>    Procedure Define_cWebDDOSync_mixin
21361>>>>>>>>>        Property Handle Main_DD 0
21362>>>>>>>>>
21362>>>>>>>>>        /*        This array is used to cache the DDO structure of the view. It is initialized during         End_Construct_Object and is sorted alphabetically. The name is generated using the         DDIdentity which makes it unique within the view. Used for fast searches of DDO object name         to DDO handle.        */
21362>>>>>>>>>        Property tNameHandlePair[] paDDOIndex
21363>>>>>>>>>        
21363>>>>>>>>>        // This array is used for traversing the DDO structure in order of Main DD, then the child DDO structure followed by the parent DDO structure.
21363>>>>>>>>>        Property Handle[] paDDOHandlesTree  // Handle to each DDO in the DDO Structure - sorted by: Main DD, Child DD tree, Parent DD tree
21364>>>>>>>>>        
21364>>>>>>>>>        // This array stores the Main_DD of one or more alternative DDO structures. This is used to
21364>>>>>>>>>        // append multiple DDO structures to the set of DDO structures that are synchronized at the client.
21364>>>>>>>>>        // Note: you do not need to add the View's Main_DD to this array. Its DDO structure is automatically
21364>>>>>>>>>        // added to the synchronized list.
21364>>>>>>>>>        Property Handle[] paAdditionalDDOStructures
21365>>>>>>>>>        
21365>>>>>>>>>        Property tWebDDODef ptDDOStates
21368>>>>>>>>>    End_Procedure
21369>>>>>>>>>    
21369>>>>>>>>>    Procedure AddDDOStructure Handle hoMain_DD
21371>>>>>>>>>        // If your view has two or more independant DDO Structures then send this message to add
21371>>>>>>>>>        // each additional DDO structure to the set of DDO structures that are synchronized with
21371>>>>>>>>>        // the client. Do not Send this to add the view's main DDO structure, that will be added
21371>>>>>>>>>        // automatically. Pass the Main_DD of the DDO structure as the parameter.
21371>>>>>>>>>        Handle[] aAdditionalDDOStructures
21372>>>>>>>>>        
21372>>>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
21373>>>>>>>>>        Move hoMain_DD to aAdditionalDDOStructures[SizeOfArray(aAdditionalDDOStructures)]
21374>>>>>>>>>        Set paAdditionalDDOStructures to aAdditionalDDOStructures
21375>>>>>>>>>    End_Procedure
21376>>>>>>>>>    
21376>>>>>>>>>    
21376>>>>>>>>>     Procedure FindDataDictionaries Handle hoCurrentDD Handle[] ByRef aDDOHandles
21378>>>>>>>>>        // Recursive function to iterate the structure of data dictionary objects in this view
21378>>>>>>>>>        // returning an array of DD object handles in the ByRef parameter.
21378>>>>>>>>>        //
21378>>>>>>>>>        // To start the search call this method with hoCurrentDD set to the view's Main DD
21378>>>>>>>>>        // and hDataDictionaries passed as an empty array.
21378>>>>>>>>>        //
21378>>>>>>>>>        // Returns an array of DDO object handles: first the Main DD, followed by the child DD tree, then the parent DD tree
21378>>>>>>>>>        Handle hoNextDD
21378>>>>>>>>>        Integer iCounter iCount
21378>>>>>>>>>        
21378>>>>>>>>>        // Append the passed data dictionary to the array.....
21378>>>>>>>>>        Move hoCurrentDD to aDDOHandles[(SizeOfArray(aDDOHandles))]
21379>>>>>>>>>    
21379>>>>>>>>>        // Add the client ddo's....
21379>>>>>>>>>        Get Data_Set_Client_Count of hoCurrentDD to iCount
21380>>>>>>>>>        
21380>>>>>>>>>        For iCounter from 0 to (iCount - 1)
21386>>>>>>>>>>
21386>>>>>>>>>            Get Data_Set_Client of hoCurrentDD iCounter to hoNextDD
21387>>>>>>>>>            
21387>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21389>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21390>>>>>>>>>            End
21390>>>>>>>>>>
21390>>>>>>>>>        Loop
21391>>>>>>>>>>
21391>>>>>>>>>        
21391>>>>>>>>>        // Add the server ddo's....
21391>>>>>>>>>        Get Data_Set_Server_Count of hoCurrentDD to iCount
21392>>>>>>>>>        
21392>>>>>>>>>        For iCounter from 0 to (iCount-1)
21398>>>>>>>>>>
21398>>>>>>>>>            Get Data_Set_Server of hoCurrentDD iCounter to hoNextDD
21399>>>>>>>>>    
21399>>>>>>>>>            If (SearchArray(hoNextDD, aDDOHandles) < 0) Begin
21401>>>>>>>>>               Send FindDataDictionaries hoNextDD (&aDDOHandles)
21402>>>>>>>>>            End
21402>>>>>>>>>>
21402>>>>>>>>>        Loop
21403>>>>>>>>>>
21403>>>>>>>>>    End_Procedure
21404>>>>>>>>>    
21404>>>>>>>>>    /*    Returns unique name for DDO object within this view, which is basically the long object name     not including the view name. This allows duplicate DD object names (as long as they are not     siblings!). This name is used in the synchronization logic.    */
21404>>>>>>>>>    Function DDIdentity Handle hoDD Returns String
21406>>>>>>>>>        Function_Return (Right(Name(hoDD), Length(Name(hoDD)) - Length(Name(Self)) - 1))
21407>>>>>>>>>    End_Function
21408>>>>>>>>>    
