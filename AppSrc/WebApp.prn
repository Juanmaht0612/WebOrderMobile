30319>>>>>>>>>>>    // Encrypts data
30319>>>>>>>>>>>    Function Encrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30321>>>>>>>>>>>        Handle hProv hHash hKey
30321>>>>>>>>>>>        Integer iAlgorithm iDataLen iCipherLen iErr
30321>>>>>>>>>>>        Boolean bOk
30321>>>>>>>>>>>        
30321>>>>>>>>>>>        Get AcquireContext to hProv
30322>>>>>>>>>>>        If (hProv) Begin
30324>>>>>>>>>>>            Get CreateHash hProv to hHash
30325>>>>>>>>>>>            If (hHash) Begin
30327>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30328>>>>>>>>>>>                If (bOk) Begin
30330>>>>>>>>>>>                    Get piCipher to iAlgorithm
30331>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30332>>>>>>>>>>>                End
30332>>>>>>>>>>>>
30332>>>>>>>>>>>                Get DestroyHash hHash to bOk
30333>>>>>>>>>>>            End
30333>>>>>>>>>>>>
30333>>>>>>>>>>>            
30333>>>>>>>>>>>            If (hKey) Begin
30335>>>>>>>>>>>                //  First call to determine resulting data size
30335>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30336>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iCipherLen
30337>>>>>>>>>>>                Move (CryptEncrypt(hKey, 0, True, 0, 0, AddressOf(iCipherLen), iDataLen)) to bOk
30338>>>>>>>>>>>                
30338>>>>>>>>>>>                //  Reserve space in string
30338>>>>>>>>>>>                If (iDataLen < iCipherLen) Begin
30340>>>>>>>>>>>                    Move (ResizeArray(ucData, iCipherLen, 0)) to ucData
30341>>>>>>>>>>>                End
30341>>>>>>>>>>>>
30341>>>>>>>>>>>                
30341>>>>>>>>>>>                //  Call to really decrypt
30341>>>>>>>>>>>                Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen),SizeOfArray(ucData))) to bOk
30342>>>>>>>>>>>                //If (not(bOk)) Begin
30342>>>>>>>>>>>                //Move "" to sData
30342>>>>>>>>>>>                //Move (GetLastError()) to iErr
30342>>>>>>>>>>>                //End
30342>>>>>>>>>>>                
30342>>>>>>>>>>>                Get DestroyKey hKey to bOk
30343>>>>>>>>>>>            End 
30343>>>>>>>>>>>>
30343>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30344>>>>>>>>>>>        End 
30344>>>>>>>>>>>>
30344>>>>>>>>>>>        Function_Return ucData
30345>>>>>>>>>>>    End_Function
30346>>>>>>>>>>>    
30346>>>>>>>>>>>    // Decrypts data
30346>>>>>>>>>>>    Function Decrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
30348>>>>>>>>>>>        Handle hProv hHash hKey
30348>>>>>>>>>>>        Integer iAlgorithm iDataLen
30348>>>>>>>>>>>        Boolean bOk
30348>>>>>>>>>>>        
30348>>>>>>>>>>>        Get AcquireContext to hProv
30349>>>>>>>>>>>        If (hProv) Begin
30351>>>>>>>>>>>            Get CreateHash hProv to hHash
30352>>>>>>>>>>>            If (hHash) Begin
30354>>>>>>>>>>>                Get HashData hHash ucPassword to bOk
30355>>>>>>>>>>>                If (bOk) Begin
30357>>>>>>>>>>>                    Get piCipher to iAlgorithm
30358>>>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
30359>>>>>>>>>>>                End
30359>>>>>>>>>>>>
30359>>>>>>>>>>>                Get DestroyHash hHash to bOk
30360>>>>>>>>>>>            End
30360>>>>>>>>>>>>
30360>>>>>>>>>>>            
30360>>>>>>>>>>>            If (hKey) Begin
30362>>>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
30363>>>>>>>>>>>                Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen))) to bOk
30364>>>>>>>>>>>                //  Resulting data can be shorter as the input string, in that case we shorten the result string
30364>>>>>>>>>>>                If (SizeOfArray (ucData) > iDataLen) Begin
30366>>>>>>>>>>>                    Move (ResizeArray(ucData, iDataLen)) to ucData
30367>>>>>>>>>>>                End
30367>>>>>>>>>>>>
30367>>>>>>>>>>>                
30367>>>>>>>>>>>                Get DestroyKey hKey to bOk
30368>>>>>>>>>>>            End
30368>>>>>>>>>>>>
30368>>>>>>>>>>>            Get ReleaseContext hProv to bOk
30369>>>>>>>>>>>        End
30369>>>>>>>>>>>>
30369>>>>>>>>>>>        Function_Return ucData
30370>>>>>>>>>>>    End_Function
