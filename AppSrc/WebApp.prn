31040>>>>>>>>>    //
31040>>>>>>>>>    // Calculates when a set of web properties expires by looking at the piSessionTimeout property
31040>>>>>>>>>    // of the session manager. This is only stored for cleanup purposes.
31040>>>>>>>>>    //
31040>>>>>>>>>    Function CalculateExpires Returns DateTime
31042>>>>>>>>>        DateTime dtExpires
31042>>>>>>>>>        Integer iTimeout
31042>>>>>>>>>        
31042>>>>>>>>>        Get piSessionTimeout of (SessionManager(Self)) to iTimeout
31043>>>>>>>>>        Move (DateAddMinute(CurrentDateTime(), iTimeout)) to dtExpires
31044>>>>>>>>>        
31044>>>>>>>>>        
31044>>>>>>>>>        Function_Return dtExpires
31045>>>>>>>>>    End_Function
31046>>>>>>>>>    
31046>>>>>>>>>    //
31046>>>>>>>>>    //  Converts the given time to an string that can be saved in the database.
31046>>>>>>>>>    //
31046>>>>>>>>>    //  Params:
31046>>>>>>>>>    //      dtTime  Time to convert
31046>>>>>>>>>    //  Returns:
31046>>>>>>>>>    //      String with "HH:MM:SS" format
31046>>>>>>>>>    //
31046>>>>>>>>>    Function TimeToString DateTime dtTime Returns String
31048>>>>>>>>>        String sHours sMinutes sSeconds sMillis
31048>>>>>>>>>        
31048>>>>>>>>>        //  Extract parts
31048>>>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
31049>>>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
31050>>>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
31051>>>>>>>>>        Move (String(DateGetMillisecond(dtTime))) to sMillis
31052>>>>>>>>>        
31052>>>>>>>>>        //  Fill out with 0
31052>>>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
31055>>>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
31058>>>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
31061>>>>>>>>>        Move (Right("00" + sMillis, 3)) to sMillis
31062>>>>>>>>>        
31062>>>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds + "." + sMillis)
31063>>>>>>>>>    End_Function
31064>>>>>>>>>
31064>>>>>>>>>
31064>>>>>>>>>    //
31064>>>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
31064>>>>>>>>>    //
31064>>>>>>>>>    //  Params:
31064>>>>>>>>>    //      dtTime  Datetime variable to add time to
31064>>>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
31064>>>>>>>>>    //  Returns:
31064>>>>>>>>>    //      dtDateTime with the loaded time
31064>>>>>>>>>    //
31064>>>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
31066>>>>>>>>>        String sHours sMinutes sSeconds sMillis
31066>>>>>>>>>        
31066>>>>>>>>>        //  Extract parts
31066>>>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
31067>>>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
31068>>>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
31069>>>>>>>>>        Move (Right(sTimeString, 3)) to sMillis
31070>>>>>>>>>        
31070>>>>>>>>>        //  Set to DateTime
31070>>>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours))))   to dtTime
31071>>>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
31072>>>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
31073>>>>>>>>>        Move (DateSetMillisecond(dtTime, (Integer(sMillis)))) to dtTime
31074>>>>>>>>>        
31074>>>>>>>>>        Function_Return dtTime
31075>>>>>>>>>    End_Function
31076>>>>>>>>>    
