30281>>>>>>>>>>>        Move CUR_BLOB_VERSION   to blobhead.hdr.bVersion
30282>>>>>>>>>>>        Get piCipher            to blobhead.hdr.aiKeyAlg
30283>>>>>>>>>>>        Move iKeySize           to blobhead.dwKeySize
30284>>>>>>>>>>>        
30284>>>>>>>>>>>        Move (ResizeArray(ucaKeyblob, iHeadSize)) to ucaKeyblob
30285>>>>>>>>>>>        Move (CopyMemory(AddressOf(ucaKeyblob), AddressOf(blobhead), iHeadSize)) to iVoid
30286>>>>>>>>>>>        Move (AppendArray(ucaKeyblob, ucaKey)) to ucaKeyblob
30287>>>>>>>>>>>        
30287>>>>>>>>>>>        Move 0 to hKey
30288>>>>>>>>>>>        Move (CryptImportKey(hProv, AddressOf(ucaKeyblob), SizeOfArray(ucaKeyblob), 0, 0, AddressOf(hKey))) to bSuccess
30289>>>>>>>>>>>        If (not(bSuccess)) Begin
30291>>>>>>>>>>>            Move (ShowLastError()) to iVoid
30292>>>>>>>>>>>        End
30292>>>>>>>>>>>>
30292>>>>>>>>>>>        
30292>>>>>>>>>>>        Function_Return hKey
30293>>>>>>>>>>>    End_Function
