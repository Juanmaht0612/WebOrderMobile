35932>>>>>>>    
35932>>>>>>>    // Adds a client action to the queue of client actions. Used to keep track
35932>>>>>>>    // of client actions that are executed before the objects actually 
35932>>>>>>>    // exist on the client.
35932>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
35934>>>>>>>        String sName
35934>>>>>>>        Integer iIndex
35934>>>>>>>        tWebDynamicObject tDynamicObject
35934>>>>>>>        tWebDynamicObject tDynamicObject
35934>>>>>>>        tWebDynamicObject[] aDynamicObjects
35934>>>>>>>        tWebDynamicObject[] aDynamicObjects
35935>>>>>>>        tWebClientAction[] aClientActionsQueue 
35935>>>>>>>        tWebClientAction[] aClientActionsQueue 
35936>>>>>>>        
35936>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35937>>>>>>>        
35937>>>>>>>        // This simply removes parentage from the name of the object
35937>>>>>>>        Get TruncateName tClientAction.sTarget to tDynamicObject.sId
35938>>>>>>>        
35938>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35939>>>>>>>        If (iIndex <> -1) Begin
35941>>>>>>>            If (aDynamicObjects[iIndex].bRendered) Begin
35943>>>>>>>                Send AddClientAction of (Owner(Self)) tClientAction
35944>>>>>>>            End 
35944>>>>>>>>
35944>>>>>>>            Else Begin
35945>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35946>>>>>>>                Move tClientAction to aClientActionsQueue[SizeOfArray(aClientActionsQueue)]
35947>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
35948>>>>>>>            End
35948>>>>>>>>
35948>>>>>>>        End
35948>>>>>>>>
35948>>>>>>>        Else Begin
35949>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, tDynamicObject.sId))
35950>>>>>>>>
35950>>>>>>>        End
35950>>>>>>>>
35950>>>>>>>    End_Procedure
35951>>>>>>>    
35951>>>>>>>    // Cancels a client action that was scheduled.
35951>>>>>>>    // tClientAction    - Is the action to be executed
35951>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
35953>>>>>>>        Integer iIndex
35953>>>>>>>        Boolean bRendered
35953>>>>>>>        tWebDynamicObject tDynamicObject
35953>>>>>>>        tWebDynamicObject tDynamicObject
35953>>>>>>>        tWebDynamicObject[] aDynamicObjects
35953>>>>>>>        tWebDynamicObject[] aDynamicObjects
35954>>>>>>>        tWebClientAction[] aClientActionsQueue
35954>>>>>>>        tWebClientAction[] aClientActionsQueue
35955>>>>>>>        String sFullName
35955>>>>>>>        
35955>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35956>>>>>>>        
35956>>>>>>>        // This simply removes parentage from the name of the object
35956>>>>>>>        Get WebObjectName of hoWO to sFullName
35957>>>>>>>        Get TruncateName sFullName to tDynamicObject.sId
35958>>>>>>>        
35958>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
35959>>>>>>>        If (iIndex <> -1) Begin
35961>>>>>>>            Move aDynamicObjects[iIndex].bRendered to bRendered
35962>>>>>>>            
35962>>>>>>>            If (bRendered) Begin
35964>>>>>>>                Send OwnerCancelClientAction of (Owner(Self)) hoWO sName
35965>>>>>>>            End 
35965>>>>>>>>
35965>>>>>>>            Else Begin
35966>>>>>>>                Get paClientActionsQueue to aClientActionsQueue 
35967>>>>>>>                For iIndex from 0 to (SizeOfArray(aClientActionsQueue) - 1)
35973>>>>>>>>
35973>>>>>>>                    If (aClientActionsQueue[iIndex].sTarget = sFullName and aClientActionsQueue[iIndex].sName = sName) Begin
35975>>>>>>>                        Move (RemoveFromArray(aClientActionsQueue, iIndex)) to aClientActionsQueue
35976>>>>>>>                        Decrement iIndex
35977>>>>>>>                    End
35977>>>>>>>>
35977>>>>>>>                Loop
35978>>>>>>>>
35978>>>>>>>                Set paClientActionsQueue to aClientActionsQueue
35979>>>>>>>                
35979>>>>>>>                
35979>>>>>>>            End
35979>>>>>>>>
35979>>>>>>>        End
35979>>>>>>>>
35979>>>>>>>    End_Procedure
35980>>>>>>>    
35980>>>>>>>    
35980>>>>>>>    // Signals that the dynamic objects of this container have been loaded.
35980>>>>>>>    // Sends all queued client actions to the client to be executed ands
35980>>>>>>>    // marks all dynamic objects as being rendered.
35980>>>>>>>    Procedure FinishRendering String[] aObjects
35982>>>>>>>        Integer icObjects iObject iObjectIndex
35982>>>>>>>        tWebDynamicObject tDynamicObject
35982>>>>>>>        tWebDynamicObject tDynamicObject
35982>>>>>>>        tWebDynamicObject[] aDynamicObjects
35982>>>>>>>        tWebDynamicObject[] aDynamicObjects
35983>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
35983>>>>>>>        tWebClientAction[] aClientActions aClientActionsQueue
35985>>>>>>>        
35985>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
35986>>>>>>>        
35986>>>>>>>        Get paClientActions of (Host(Self)) to aClientActions
35987>>>>>>>        Get paClientActionsQueue to aClientActionsQueue
35988>>>>>>>        Move (AppendArray(aClientActions, aClientActionsQueue)) to aClientActions
35989>>>>>>>        Set paClientActions of (Host(Self)) to aClientActions
35990>>>>>>>        
35990>>>>>>>        Move (ResizeArray(aClientActionsQueue, 0)) to aClientActionsQueue
35991>>>>>>>        Set paClientActionsQueue to aClientActionsQueue
35992>>>>>>>        
35992>>>>>>>        Move (SizeOfArray(aObjects)) to icObjects
35993>>>>>>>        For iObject from 0 to (icObjects - 1)
35999>>>>>>>>
35999>>>>>>>            Send SetRendered aObjects[iObject] True (&aDynamicObjects) True
36000>>>>>>>        Loop
36001>>>>>>>>
36001>>>>>>>        
36001>>>>>>>        WebSet paDynamicObjects to aDynamicObjects
36002>>>>>>>        WebSet pbActivated to True
36003>>>>>>>    End_Procedure
36004>>>>>>>    
36004>>>>>>>    
36004>>>>>>>    // =====================================
36004>>>>>>>    // DYNAMIC OBJECT CREATION & DESTRUCTION
36004>>>>>>>    // =====================================
36004>>>>>>>    
36004>>>>>>>    // Registers a dynamic object
36004>>>>>>>    Function CreateDynamicObject Integer iClassId String sDynamicObjectId String sParentId Returns Handle
36006>>>>>>>        Integer iIndex
36006>>>>>>>        Handle hoObj
36006>>>>>>>        tWebDynamicObject tDynamicObject
36006>>>>>>>        tWebDynamicObject tDynamicObject
36006>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36006>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36007>>>>>>>        
36007>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36008>>>>>>>
36008>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36009>>>>>>>
36009>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36010>>>>>>>        If (iIndex = -1) Begin                 
36012>>>>>>>            // Dynamic object has not been registered before, so append it  
36012>>>>>>>            Move (BinarySearchInsertPos()) to iIndex 
36013>>>>>>>            
36013>>>>>>>            //  Check for illegal characters in the id
36013>>>>>>>            If (Pos("#", sDynamicObjectId) > 0 or Pos("$", sDynamicObjectId) > 0) Begin
36015>>>>>>>                Error DFERR_PROGRAM (SFormat("# and $ characters are not allowed in sDynamicObjectId ('%1').", sDynamicObjectId))
36016>>>>>>>>
36016>>>>>>>                Function_Return C_WebUnresolvedObject 
36017>>>>>>>            End
36017>>>>>>>>
36017>>>>>>>            
36017>>>>>>>            Move sParentId to tDynamicObject.sParentId
36018>>>>>>>            Move iClassId to tDynamicObject.iClassId
36019>>>>>>>            Move False to tDynamicObject.bRendered
36020>>>>>>>            
36020>>>>>>>            Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36021>>>>>>>            
36021>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36022>>>>>>>            
36022>>>>>>>            // Create the object
36022>>>>>>>            Set pbIsCreating to True
36023>>>>>>>            Get CreateLocal sDynamicObjectId to hoObj
36024>>>>>>>            Set pbIsCreating to False
36025>>>>>>>            
36025>>>>>>>            // Insert object at end of parent's child structure
36025>>>>>>>            Send AppendToSiblings sDynamicObjectId
36026>>>>>>>        End        
36026>>>>>>>>
36026>>>>>>>        Else Begin
36027>>>>>>>            // Object has been registered before, so throw an error
36027>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectAlreadyExists, sDynamicObjectId))
36028>>>>>>>>
36028>>>>>>>        End
36028>>>>>>>>
36028>>>>>>>        
36028>>>>>>>        Function_Return hoObj
36029>>>>>>>    End_Function
36030>>>>>>>    
36030>>>>>>>    
36030>>>>>>>    // Moves a dynamic object to a different location, after another specified dynamic object.
36030>>>>>>>    Procedure MoveDynamicObject String sDynamicObjectId String sInsertAfter
36032>>>>>>>        String sParentId sName
36032>>>>>>>        String[] aParams aChildren
36034>>>>>>>        Integer iIndex iRemoveIndex iInsertIndex
36034>>>>>>>        Boolean bSendCommand
36034>>>>>>>        Handle hoObj
36034>>>>>>>        tWebDynamicObject tDynamicObject
36034>>>>>>>        tWebDynamicObject tDynamicObject
36034>>>>>>>        tWebDynamicObject[] aDynamicObjects
36034>>>>>>>        tWebDynamicObject[] aDynamicObjects
36035>>>>>>>        
36035>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36036>>>>>>>        
36036>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36037>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36038>>>>>>>        If (iIndex <> -1) Begin
36040>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36041>>>>>>>            Move sParentId to tDynamicObject.sId
36042>>>>>>>            
36042>>>>>>>            // Remove child from old location
36042>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36043>>>>>>>            If (iIndex <> -1) Begin
36045>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36046>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36047>>>>>>>            End  
36047>>>>>>>>
36047>>>>>>>            
36047>>>>>>>            // Insert child at new location
36047>>>>>>>            Move sInsertAfter to tDynamicObject.sId
36048>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36049>>>>>>>            If (iIndex <> -1) Begin
36051>>>>>>>                Move aDynamicObjects[iIndex].sParentId to sParentId
36052>>>>>>>                
36052>>>>>>>                // Find new parent
36052>>>>>>>                Move sParentId to tDynamicObject.sId
36053>>>>>>>                Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36054>>>>>>>                If (iIndex <> -1) Begin
36056>>>>>>>                    Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
36057>>>>>>>                    If (iInsertIndex <> -1) Begin
36059>>>>>>>                        Move aDynamicObjects[iIndex].aChildren to aChildren
36060>>>>>>>                        
36060>>>>>>>                        // Insert object afer sInsertAfter
36060>>>>>>>                        Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
36061>>>>>>>                        Move aChildren to aDynamicObjects[iIndex].aChildren
36062>>>>>>>                        WebSet paDynamicObjects to aDynamicObjects
36063>>>>>>>                        
36063>>>>>>>                        Move True to bSendCommand
36064>>>>>>>                    End
36064>>>>>>>>
36064>>>>>>>                End
36064>>>>>>>>
36064>>>>>>>            End
36064>>>>>>>>
36064>>>>>>>        End
36064>>>>>>>>
36064>>>>>>>        
36064>>>>>>>        If (bSendCommand) Begin
36066>>>>>>>            Send ConnectRadioButtons
36067>>>>>>>            
36067>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36068>>>>>>>            Get WebObjectName of hoObj to sName
36069>>>>>>>            
36069>>>>>>>            Move sName to aParams[0]
36070>>>>>>>            
36070>>>>>>>            Get DynamicObject sInsertAfter to hoObj
36071>>>>>>>            Get WebObjectName of hoObj to sName
36072>>>>>>>            
36072>>>>>>>            Move sName to aParams[1]
36073>>>>>>>            
36073>>>>>>>            Send ClientAction "moveDynamicObject" aParams
36074>>>>>>>        End
36074>>>>>>>>
36074>>>>>>>    End_Procedure
36075>>>>>>>    
36075>>>>>>>    
36075>>>>>>>    // Moves a dynamic object to a specific index in a new parent's list of children.
36075>>>>>>>    Procedure MoveDynamicObjectToIndex String sDynamicObjectId String sParentId Integer iInsertIndex
36077>>>>>>>        String sName
36077>>>>>>>        String[] aParams aChildren
36079>>>>>>>        Integer iIndex iRemoveIndex
36079>>>>>>>        Boolean bSendCommand
36079>>>>>>>        Handle hoObj
36079>>>>>>>        tWebDynamicObject tDynamicObject
36079>>>>>>>        tWebDynamicObject tDynamicObject
36079>>>>>>>        tWebDynamicObject[] aDynamicObjects
36079>>>>>>>        tWebDynamicObject[] aDynamicObjects
36080>>>>>>>        
36080>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36081>>>>>>>        
36081>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36082>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36083>>>>>>>        If (iIndex <> -1) Begin
36085>>>>>>>            Move aDynamicObjects[iIndex].sParentId to tDynamicObject.sId
36086>>>>>>>            
36086>>>>>>>            // Remove child from old location
36086>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36087>>>>>>>            If (iIndex <> -1) Begin
36089>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36090>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36091>>>>>>>            End  
36091>>>>>>>>
36091>>>>>>>                
36091>>>>>>>            // Find new parent
36091>>>>>>>            Move sParentId to tDynamicObject.sId
36092>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36093>>>>>>>            If (iIndex <> -1) Begin
36095>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
36096>>>>>>>                
36096>>>>>>>                // Insert object afer sInsertAfter
36096>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
36097>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36098>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
36099>>>>>>>                
36099>>>>>>>                Move True to bSendCommand
36100>>>>>>>            End
36100>>>>>>>>
36100>>>>>>>        End
36100>>>>>>>>
36100>>>>>>>        
36100>>>>>>>        If (bSendCommand) Begin
36102>>>>>>>            Send ConnectRadioButtons
36103>>>>>>>            
36103>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36104>>>>>>>            Get WebObjectName of hoObj to sName
36105>>>>>>>            Move sName to aParams[0] 
36106>>>>>>>            
36106>>>>>>>            Get DynamicObject sParentId to hoObj
36107>>>>>>>            Get WebObjectName of hoObj to sName
36108>>>>>>>            Move sName to aParams[1] 
36109>>>>>>>
36109>>>>>>>            Move iInsertIndex to aParams[2]
36110>>>>>>>            
36110>>>>>>>            Send ClientAction "moveDynamicObjectToIndex" aParams
36111>>>>>>>        End 
36111>>>>>>>>
36111>>>>>>>    End_Procedure
36112>>>>>>>    
36112>>>>>>>    
36112>>>>>>>    // Inserts a dynamic object after the given object. The inserted 
36112>>>>>>>    // object inherits the parent of the object it is inserted after.
36112>>>>>>>    Procedure InsertDynamicObject String sDynamicObjectId String sInsertAfter
36114>>>>>>>        String sParentId
36114>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
36118>>>>>>>        Integer iIndex iInsertIndex iRemoveIndex
36118>>>>>>>        Boolean bSendCommand
36118>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36118>>>>>>>        tWebDynamicObject tDynamicObject
36118>>>>>>>        tWebDynamicObject tDynamicObject
36118>>>>>>>        tWebDynamicObject[] aDynamicObjects
36118>>>>>>>        tWebDynamicObject[] aDynamicObjects
36119>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36119>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36120>>>>>>>        
36120>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36121>>>>>>>        
36121>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36122>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36123>>>>>>>        If (iIndex <> -1) Begin
36125>>>>>>>            // Retrieve parent
36125>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36126>>>>>>>            
36126>>>>>>>            // Find parent object
36126>>>>>>>            Move sParentId to tDynamicObject.sId
36127>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36128>>>>>>>            If (iIndex <> -1) Begin
36130>>>>>>>                
36130>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36130>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36131>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36132>>>>>>>                
36132>>>>>>>                Move (SearchArray(sInsertAfter, aDynamicObjects[iIndex].aChildren)) to iInsertIndex
36133>>>>>>>                If (iInsertIndex <> -1) Begin
36135>>>>>>>                    Move aDynamicObjects[iIndex].aChildren to aChildren
36136>>>>>>>                    
36136>>>>>>>                    // Insert object afer sInsertAfter
36136>>>>>>>                    Move (InsertInArray(aChildren, iInsertIndex + 1, sDynamicObjectId)) to aChildren
36137>>>>>>>                    Move aChildren to aDynamicObjects[iIndex].aChildren
36138>>>>>>>                    WebSet paDynamicObjects to aDynamicObjects
36139>>>>>>>                    
36139>>>>>>>                    Move True to bSendCommand
36140>>>>>>>                End
36140>>>>>>>>
36140>>>>>>>            End
36140>>>>>>>>
36140>>>>>>>            Else Begin
36141>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36142>>>>>>>>
36142>>>>>>>            End
36142>>>>>>>>
36142>>>>>>>        End
36142>>>>>>>>
36142>>>>>>>        Else Begin
36143>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$CannotInsertDynamic, sInsertAfter))
36144>>>>>>>>
36144>>>>>>>        End
36144>>>>>>>>
36144>>>>>>>        
36144>>>>>>>        // Finally, send an insert command to the client
36144>>>>>>>        If (bSendCommand) Begin
36146>>>>>>>            Send ConnectRadioButtons
36147>>>>>>>            
36147>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36148>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36149>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36150>>>>>>>            
36150>>>>>>>            Get DynamicObject sParentId to hoObj
36151>>>>>>>            Get WebObjectName of hoObj to sParentId
36152>>>>>>>            
36152>>>>>>>            // Convert queued sync props to JSON
36152>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36153>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36154>>>>>>>
36154>>>>>>>            Move sParentId to aParams[0]
36155>>>>>>>            Move sInsertAfter to aParams[1]
36156>>>>>>>            
36156>>>>>>>            // Send actions to the client
36156>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36157>>>>>>>            Send ClientActionEx "insertDynamicObject" aParams hoObjectJson
36158>>>>>>>            
36158>>>>>>>            Send Destroy of hoObjectJson
36159>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36160>>>>>>>
36160>>>>>>>            Move sDynamicObjectId to aObjects[0]
36161>>>>>>>            Send FinishRendering aObjects
36162>>>>>>>        End
36162>>>>>>>>
36162>>>>>>>    End_Procedure
36163>>>>>>>    
36163>>>>>>>    
36163>>>>>>>    // Inserts a dynamic object at a certain index in its parent's list of childen.
36163>>>>>>>    Procedure InsertDynamicObjectAtIndex String sDynamicObjectId String sParentId Integer iInsertIndex
36165>>>>>>>        String[] aParams aChildren aEmptyArray aObjects
36169>>>>>>>        Integer iIndex iRemoveIndex
36169>>>>>>>        Boolean bSendCommand
36169>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36169>>>>>>>        tWebDynamicObject tDynamicObject
36169>>>>>>>        tWebDynamicObject tDynamicObject
36169>>>>>>>        tWebDynamicObject[] aDynamicObjects
36169>>>>>>>        tWebDynamicObject[] aDynamicObjects
36170>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36170>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36171>>>>>>>        
36171>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36172>>>>>>>        
36172>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36173>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36174>>>>>>>        If (iIndex <> -1) Begin
36176>>>>>>>            // Retrieve parent
36176>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36177>>>>>>>            
36177>>>>>>>            // Find parent object
36177>>>>>>>            Move sParentId to tDynamicObject.sId
36178>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36179>>>>>>>            If (iIndex <> -1) Begin
36181>>>>>>>                
36181>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36181>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36182>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aDynamicObjects[iIndex].aChildren
36183>>>>>>>            End
36183>>>>>>>>
36183>>>>>>>                
36183>>>>>>>            // Find new parent
36183>>>>>>>            Move sParentId to tDynamicObject.sId
36184>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36185>>>>>>>            If (iIndex <> -1) Begin
36187>>>>>>>                Move aDynamicObjects[iIndex].aChildren to aChildren
36188>>>>>>>                
36188>>>>>>>                // Insert object at specified index
36188>>>>>>>                Move (InsertInArray(aChildren, iInsertIndex, sDynamicObjectId)) to aChildren
36189>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36190>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
36191>>>>>>>                
36191>>>>>>>                Move True to bSendCommand
36192>>>>>>>            End
36192>>>>>>>>
36192>>>>>>>        End
36192>>>>>>>>
36192>>>>>>>        
36192>>>>>>>        If (bSendCommand) Begin
36194>>>>>>>            Send ConnectRadioButtons
36195>>>>>>>            
36195>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36196>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36197>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36198>>>>>>>            
36198>>>>>>>            Get DynamicObject sParentId to hoObj
36199>>>>>>>            Get WebObjectName of hoObj to sParentId
36200>>>>>>>            
36200>>>>>>>            // Convert queued sync props to JSON
36200>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36201>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36202>>>>>>>            
36202>>>>>>>            // Convert object definition to JSON
36202>>>>>>>
36202>>>>>>>            
36202>>>>>>>            Move sParentId to aParams[0]
36203>>>>>>>            Move iInsertIndex to aParams[1]
36204>>>>>>>            
36204>>>>>>>            // Send actions to the client
36204>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyArray hoQueuedSyncPropsJson
36205>>>>>>>            Send ClientActionEx "insertDynamicObjectAtIndex" aParams hoObjectJson
36206>>>>>>>            
36206>>>>>>>            Send Destroy of hoObjectJson
36207>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36208>>>>>>>
36208>>>>>>>            Move sDynamicObjectId to aObjects[0]
36209>>>>>>>            Send FinishRendering aObjects
36210>>>>>>>        End 
36210>>>>>>>>
36210>>>>>>>    End_Procedure
36211>>>>>>>    
36211>>>>>>>    
36211>>>>>>>    // Appends a dynamic object at the end of its parent's list of children.
36211>>>>>>>    Procedure AppendDynamicObject String sDynamicObjectId
36213>>>>>>>        String[] aParams aEmptyParams aObjects
36216>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36216>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36216>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36217>>>>>>>        tWebDynamicObject[] aDynamicObjects
36217>>>>>>>        tWebDynamicObject[] aDynamicObjects
36218>>>>>>>        
36218>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36219>>>>>>>        
36219>>>>>>>        Send ConnectRadioButtons
36220>>>>>>>            
36220>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36221>>>>>>>        Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36222>>>>>>>        WebGet paSyncPropsQueue to aSyncPropsQueue
36223>>>>>>>        
36223>>>>>>>        // Convert queued sync props to JSON
36223>>>>>>>        Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36224>>>>>>>        Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36225>>>>>>>        
36225>>>>>>>        // Convert object definition to JSON
36225>>>>>>>        Get DynamicParent sDynamicObjectId to hoObj
36226>>>>>>>        Get WebObjectName of hoObj to aParams[0]
36227>>>>>>>        
36227>>>>>>>        // Send actions to the client
36227>>>>>>>        Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36228>>>>>>>        Send ClientActionEx "appendDynamicObject" aParams hoObjectJson
