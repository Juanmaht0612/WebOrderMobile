20121>>>>>>>>>>>>>>>        If (hoServer and iFile) Begin
20123>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoDD
20124>>>>>>>>>>>>>>>            Set Field_RememberedValue of hoDD iField to sValue
20125>>>>>>>>>>>>>>>        End
20125>>>>>>>>>>>>>>>>
20125>>>>>>>>>>>>>>>    End_Procedure
