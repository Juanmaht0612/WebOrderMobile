56395>>>>>    Procedure ExportReportToDownloadURL tNameValuePair[] NamedValues
56397>>>>>        String sReportId sUrl sExportFormat sFileNameWithoutPath
56397>>>>>        String[] sFileNames
56398>>>>>        Boolean bAllPages
56398>>>>>        Integer eType iPageElements iPageElement iPage eDestination iIndex
