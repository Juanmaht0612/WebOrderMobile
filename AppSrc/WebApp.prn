39455>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
39457>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
39458>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
39459>>>>>            Set piUserRights to WebAppUser.Rights
39460>>>>>            
39460>>>>>            Send OnSessionPropertiesSet 
39461>>>>>        End
39461>>>>>>
39461>>>>>        Else Begin
39462>>>>>            Set psUsername to ""
39463>>>>>            Set psLoginName to ""
39464>>>>>            Set piUserRights to 0
39465>>>>>            
39465>>>>>            Send OnSessionPropertiesClear
39466>>>>>        End
39466>>>>>>
39466>>>>>    End_Procedure
