32008>>>>>>>    Procedure Attach_Deo_To_Server
32010>>>>>>>        // Augmented to apply psCheckedValue & psUncheckedValue from the DDO's data binding...
32010>>>>>>>        Integer iFile iField
32010>>>>>>>        Handle hoDDO
32010>>>>>>>        String sValue
32010>>>>>>>
32010>>>>>>>        Forward Send Attach_Deo_To_Server
32012>>>>>>>
32012>>>>>>>        Get Server to hoDDO
32013>>>>>>>        Get Data_File  to iFile
32014>>>>>>>        Get Data_Field to iField
32015>>>>>>>        
32015>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
32015>>>>>>>        If ((hoDDO <> 0) and (iFile <> 0)) Begin
32017>>>>>>>            // Apply data binding's File_Field_Checkbox_Value setings....
32017>>>>>>>            Get psChecked to sValue
32018>>>>>>>            
32018>>>>>>>            If (Trim(sValue) = "") Begin    // Only apply data binding is there is no explicit setting
32020>>>>>>>                Get File_Field_CheckBox_Value of hoDDO iFile iField True to sValue
32021>>>>>>>                Set psChecked to sValue
32022>>>>>>>            End
32022>>>>>>>>
32022>>>>>>>            
32022>>>>>>>            Get psUnchecked to sValue
32023>>>>>>>            
32023>>>>>>>            If (Trim(sValue) = "") Begin    // Only apply data binding is there is no explicit setting
32025>>>>>>>                Get File_Field_CheckBox_Value of hoDDO iFile iField False to sValue
32026>>>>>>>                Set psUnchecked to sValue
32027>>>>>>>            End
32027>>>>>>>>
32027>>>>>>>        End
32027>>>>>>>>
32027>>>>>>>    End_Procedure
32028>>>>>>>End_Class
