25381>>>>>>>>>>>>>    End_Procedure
25382>>>>>>>>>>>>>        
25382>>>>>>>>>>>>>    Procedure InsertTagRelative String sRelativeTag Boolean bToLeft String sInsertTag
25384>>>>>>>>>>>>>        Integer iIndex iOffset
25384>>>>>>>>>>>>>        Boolean bAdded bCaseSensitive
25384>>>>>>>>>>>>>        String sNormalizedInsertTag sNormalizedCacheTag
25384>>>>>>>>>>>>>        String[] asTags
25385>>>>>>>>>>>>>        Handle hoSelectionSource
25385>>>>>>>>>>>>>        
25385>>>>>>>>>>>>>        // We need to trim both parameters to be sure we comply to the client parsing.
25385>>>>>>>>>>>>>        Move (Trim(sRelativeTag)) to sRelativeTag
25386>>>>>>>>>>>>>        Move (Trim(sInsertTag)) to sInsertTag
25387>>>>>>>>>>>>>        
25387>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25388>>>>>>>>>>>>>        
25388>>>>>>>>>>>>>        // Lower if specified.
25388>>>>>>>>>>>>>        Get pbCaseSensitive of hoSelectionSource to bCaseSensitive
25389>>>>>>>>>>>>>        If (not(bCaseSensitive)) Begin
25391>>>>>>>>>>>>>            Move (Uppercase(sRelativeTag)) to sRelativeTag
25392>>>>>>>>>>>>>            Move (Uppercase(sInsertTag)) to sNormalizedInsertTag
25393>>>>>>>>>>>>>        End
25393>>>>>>>>>>>>>>
25393>>>>>>>>>>>>>        Else ;            Move sInsertTag to sNormalizedInsertTag
25395>>>>>>>>>>>>>        
25395>>>>>>>>>>>>>        // Skip if both are the same or if any is empty.
25395>>>>>>>>>>>>>        If (sRelativeTag = sNormalizedInsertTag or ;            Length(sRelativeTag) = 0 or ;            Length(sNormalizedInsertTag) = 0) ;            Procedure_Return
25398>>>>>>>>>>>>>            
25398>>>>>>>>>>>>>        // Set the offset
25398>>>>>>>>>>>>>        Move (If(bToLeft, 0, 1)) to iOffset
25399>>>>>>>>>>>>>        
25399>>>>>>>>>>>>>        // Initialize the tags
25399>>>>>>>>>>>>>        Move False to bAdded
25400>>>>>>>>>>>>>        Get GetTags to asTags
25401>>>>>>>>>>>>>        
25401>>>>>>>>>>>>>        // Loop the tags till we find our target; if not found we insert it at the end [not(bBreak)].
25401>>>>>>>>>>>>>        While (iIndex < SizeOfArray(asTags))
25405>>>>>>>>>>>>>            // Normalize current tag; the relative is already normalized.
25405>>>>>>>>>>>>>            Move asTags[iIndex] to sNormalizedCacheTag
25406>>>>>>>>>>>>>            If (not(bCaseSensitive)) ;                Move (Uppercase(sNormalizedCacheTag)) to sNormalizedCacheTag
25409>>>>>>>>>>>>>            
25409>>>>>>>>>>>>>            // If it is the tag we insert it and skip the inserted tag and the next othrwise it would cause recursion.
25409>>>>>>>>>>>>>            If (sNormalizedCacheTag = sRelativeTag) Begin
25411>>>>>>>>>>>>>                Move (InsertInArray(asTags, iIndex + iOffset, sInsertTag)) to asTags
25412>>>>>>>>>>>>>                Move True to bAdded
25413>>>>>>>>>>>>>                Move (iIndex + 2) to iIndex
25414>>>>>>>>>>>>>            End
25414>>>>>>>>>>>>>>
25414>>>>>>>>>>>>>            // If we find the same instances we remove it since the client would do it either way.
25414>>>>>>>>>>>>>            Else If (sNormalizedCacheTag = sNormalizedInsertTag) Begin
25417>>>>>>>>>>>>>                Move (RemoveFromArray(asTags, iIndex)) to asTags
25418>>>>>>>>>>>>>            End
25418>>>>>>>>>>>>>>
25418>>>>>>>>>>>>>            Else ;                Increment iIndex
25420>>>>>>>>>>>>>        Loop
25421>>>>>>>>>>>>>>
25421>>>>>>>>>>>>>        
25421>>>>>>>>>>>>>        If (not(bAdded)) ;            Move sInsertTag to asTags[SizeOfArray(asTags)]
25424>>>>>>>>>>>>>            
25424>>>>>>>>>>>>>        // Update the tags.
25424>>>>>>>>>>>>>        Send UpdateTags asTags
25425>>>>>>>>>>>>>    End_Procedure
