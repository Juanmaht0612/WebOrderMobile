31849>>>>>    // Gets the value of a URL parameter based on its name. It parses the URL to determine the 
31849>>>>>    // parameters that are sent and returns the value of the requested parameter ("" if not found).
31849>>>>>    Function UrlParameter String sName Returns String
31851>>>>>        Integer iPos iPos2 iVoid
31851>>>>>        String sUrl
31851>>>>>        WString wsUnescape
31851>>>>>        
31851>>>>>        //  Get the URL from the HTTP header
31851>>>>>        Get ServerVariable of (ServiceDispatcher(Self)) "HTTP_REFERER" to sUrl
31852>>>>>        
31852>>>>>        If (Trim(sUrl) <> "") Begin
31854>>>>>            //  Find ? indicating GET parameters
31854>>>>>            Move (Pos("?", sUrl)) to iPos
31855>>>>>            If (iPos > 0) Begin
31857>>>>>                
31857>>>>>                Move (Uppercase(sName)) to sName
31858>>>>>
31858>>>>>                //  Loop over GET parameters
31858>>>>>                Repeat
31858>>>>>>
31858>>>>>                    //  Determine position of the name
31858>>>>>                    Increment iPos  //  Step over the ? or &
31859>>>>>                    Move (Pos("=", sUrl, iPos)) to iPos2
31860>>>>>                    
31860>>>>>                    //  Check the name
31860>>>>>                    Move (Mid(sURl, iPos2 - iPos, iPos)) to wsUnescape
31861>>>>>                    If (SizeOfWString(wsUnescape) > 0) Begin
31863>>>>>                        Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31864>>>>>                    End
31864>>>>>>
31864>>>>>                    If (Uppercase(CString(wsUnescape)) = sName) Begin
31866>>>>>                        
31866>>>>>                        //  Determine position of the value
31866>>>>>                        Increment iPos2 //  Step over the =
31867>>>>>                        Move (Pos("&", sUrl, iPos2)) to iPos
31868>>>>>                        
31868>>>>>                        If (iPos > 0) Begin
31870>>>>>                            Move (Mid(sUrl, iPos - iPos2, iPos2)) to wsUnescape
31871>>>>>                        End
31871>>>>>>
31871>>>>>                        Else Begin
31872>>>>>                            Move ((Mid(sUrl, (Length(sUrl) - iPos2 + 1), iPos2))) to wsUnescape
31873>>>>>                        End
31873>>>>>>
31873>>>>>                        If (SizeOfWString(wsUnescape) > 0) Begin
31875>>>>>                            Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
31876>>>>>                        End
31876>>>>>>
31876>>>>>                        Function_Return (CString(wsUnescape))
31877>>>>>                    End
31877>>>>>>
31877>>>>>                    
31877>>>>>                    Move (Pos("&", sUrl, iPos2)) to iPos
31878>>>>>                Until (not(iPos > 0)) 
31880>>>>>                
31880>>>>>            End
31880>>>>>>
31880>>>>>        End
31880>>>>>>
31880>>>>>        
31880>>>>>        Function_Return ""
31881>>>>>    End_Function
