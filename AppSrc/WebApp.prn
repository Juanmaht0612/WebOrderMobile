21799>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
21801>>>>>>>>>>>>>            WebSet psCurrentAppState to stateData.v
21802>>>>>>>>>>>>>            Send RestoreState stateData.v False 
21803>>>>>>>>>>>>>        End
21803>>>>>>>>>>>>>>
21803>>>>>>>>>>>>>        
21803>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
21805>>>>>>>>>>>>>            Get StateHash to sStateHash
21806>>>>>>>>>>>>>            Send RestoreState sStateHash False
21807>>>>>>>>>>>>>        End
21807>>>>>>>>>>>>>>
21807>>>>>>>>>>>>>        
21807>>>>>>>>>>>>>        //  Trigger public event
21807>>>>>>>>>>>>>        Send OnHistoryPopState sTitle sUrl stateData
21808>>>>>>>>>>>>>    End_Procedure
21809>>>>>>>>>>>>>    
21809>>>>>>>>>>>>>    // Performs a NavigateBegin to the specified view using the last registered NavigateBegin path 
21809>>>>>>>>>>>>>    // for this view. Use this procedure when doing a NavigateBegin from inside a view (invoking
21809>>>>>>>>>>>>>    // objects inside a view are not allowed any more on NavigateBegin requests). The invoking
21809>>>>>>>>>>>>>    // object will be determined dynamically, if a path is registered from the WebApp then that
21809>>>>>>>>>>>>>    // will be used, else it will use the first registered path it finds.
21809>>>>>>>>>>>>>    //
21809>>>>>>>>>>>>>    // Params:
21809>>>>>>>>>>>>>    //      hoNavigateToView    Handle to the view to navigate into.
21809>>>>>>>>>>>>>    //      bUnconditional      If true no unsaved changes warnings will be given.
21809>>>>>>>>>>>>>    Procedure NavigatePathBegin Handle hoNavigateToView Boolean bUnconditional
21811>>>>>>>>>>>>>        Handle hoInvokingObject
21811>>>>>>>>>>>>>        
21811>>>>>>>>>>>>>        Get FindNavPathInvokingObj Self hoNavigateToView ntNavigateBegin to hoInvokingObject
21812>>>>>>>>>>>>>        
21812>>>>>>>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
21814>>>>>>>>>>>>>            Send NavigateBegin of hoNavigateToView hoInvokingObject bUnconditional
21815>>>>>>>>>>>>>        End
21815>>>>>>>>>>>>>>
21815>>>>>>>>>>>>>        Else Begin
21816>>>>>>>>>>>>>            Error DFERR_PROGRAM "No navigate begin path defined for the view"
21817>>>>>>>>>>>>>>
21817>>>>>>>>>>>>>        End
21817>>>>>>>>>>>>>>
21817>>>>>>>>>>>>>    End_Procedure
21818>>>>>>>>>>>>>    
21818>>>>>>>>>>>>>    // Callback method passed to the ShowView function that is asynchronous. Will continue 
21818>>>>>>>>>>>>>    // restoring the state after the view is loaded.
21818>>>>>>>>>>>>>    //
21818>>>>>>>>>>>>>    // Params:
21818>>>>>>>>>>>>>    //      hoView  Handle to the loaded view (not actually used).
21818>>>>>>>>>>>>>    Procedure RestoreState_Desktop_Callback Handle hoView
21820>>>>>>>>>>>>>        String sStateHash sView sRecordId
21820>>>>>>>>>>>>>        Integer iPos
21820>>>>>>>>>>>>>        
21820>>>>>>>>>>>>>        Get StateHash to sStateHash
21821>>>>>>>>>>>>>        
21821>>>>>>>>>>>>>        Send ParseViewStateHash sStateHash (&sView) (&sRecordId)
21822>>>>>>>>>>>>>        Send RestoreViewState_Desktop of hoView sRecordId False
21823>>>>>>>>>>>>>    End_Procedure
21824>>>>>>>>>>>>>    
21824>>>>>>>>>>>>>    // Callback method passed to the ShowView function that is asynchronous. Will continue 
21824>>>>>>>>>>>>>    // restoring the state after the view is loaded. This is the 'ManualEnter' callback.
21824>>>>>>>>>>>>>    //
21824>>>>>>>>>>>>>    // Params:
21824>>>>>>>>>>>>>    //      hoView  Handle to the loaded view (not actually used).
21824>>>>>>>>>>>>>    Procedure RestoreState_Desktop_Callback_ManualEnter Handle hoView
21826>>>>>>>>>>>>>        String sStateHash sView sRecordId
21826>>>>>>>>>>>>>        Integer iPos
21826>>>>>>>>>>>>>        
21826>>>>>>>>>>>>>        Get StateHash to sStateHash
21827>>>>>>>>>>>>>        
21827>>>>>>>>>>>>>        Send ParseViewStateHash sStateHash (&sView) (&sRecordId)
21828>>>>>>>>>>>>>        Send RestoreViewState_Desktop of hoView sRecordId True
21829>>>>>>>>>>>>>    End_Procedure
21830>>>>>>>>>>>>>    
21830>>>>>>>>>>>>>    // Desktop-style implementation of the restorestate logic. It finds out which view should be
21830>>>>>>>>>>>>>    // shown and calls ShowView, the callback messages will do further processing. If the state 
21830>>>>>>>>>>>>>    // hash is empty we show the default view.
21830>>>>>>>>>>>>>    //
21830>>>>>>>>>>>>>    // Params:
21830>>>>>>>>>>>>>    //      sStateHash      The full state hash.
21830>>>>>>>>>>>>>    //      bManualEnter    If true the state hash is entered by the user and a record should be 
21830>>>>>>>>>>>>>    //                      found.
21830>>>>>>>>>>>>>    Procedure RestoreState_Desktop String sStateHash Boolean bManualEnter
21832>>>>>>>>>>>>>        Boolean bDefault
21832>>>>>>>>>>>>>        Integer iPos
21832>>>>>>>>>>>>>        String sView
21832>>>>>>>>>>>>>        Handle hoView
21832>>>>>>>>>>>>>        
21832>>>>>>>>>>>>>        Move True to bDefault
21833>>>>>>>>>>>>>        
21833>>>>>>>>>>>>>        If (Trim(sStateHash) <> "") Begin
21835>>>>>>>>>>>>>            Send ParseViewStateHash sStateHash (&sView)
21836>>>>>>>>>>>>>            
21836>>>>>>>>>>>>>            Get ViewByStateHashName sView to hoView
21837>>>>>>>>>>>>>            
21837>>>>>>>>>>>>>            If (hoView > 0) Begin
21839>>>>>>>>>>>>>                If (bManualEnter) Begin
21841>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback_ManualEnter)) Self
21842>>>>>>>>>>>>>                End
21842>>>>>>>>>>>>>>
21842>>>>>>>>>>>>>                Else Begin
21843>>>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback)) Self
21844>>>>>>>>>>>>>                End
21844>>>>>>>>>>>>>>
21844>>>>>>>>>>>>>                Move False to bDefault
21845>>>>>>>>>>>>>            End
21845>>>>>>>>>>>>>>
21845>>>>>>>>>>>>>            Else Begin
21846>>>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
21848>>>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
21849>>>>>>>>>>>>>>
21849>>>>>>>>>>>>>                End
21849>>>>>>>>>>>>>>
21849>>>>>>>>>>>>>                Else  Begin
21850>>>>>>>>>>>>>                    Get GetDefaultView to hoView
21851>>>>>>>>>>>>>                    If (hoView > 0) Begin
21853>>>>>>>>>>>>>                        Send Show of hoView
21854>>>>>>>>>>>>>                        Send UpdateStateHash of hoView True
21855>>>>>>>>>>>>>                    End
21855>>>>>>>>>>>>>>
21855>>>>>>>>>>>>>                End
21855>>>>>>>>>>>>>>
21855>>>>>>>>>>>>>                Procedure_Return
21856>>>>>>>>>>>>>            End
21856>>>>>>>>>>>>>>
21856>>>>>>>>>>>>>        End
21856>>>>>>>>>>>>>>
21856>>>>>>>>>>>>>        
21856>>>>>>>>>>>>>        //  Else we just show the default view
21856>>>>>>>>>>>>>        If (bDefault) Begin
21858>>>>>>>>>>>>>            Get GetDefaultView to hoView
21859>>>>>>>>>>>>>            If (hoView > 0) Begin
21861>>>>>>>>>>>>>                Send Show of hoView
21862>>>>>>>>>>>>>            End
21862>>>>>>>>>>>>>>
21862>>>>>>>>>>>>>        End
21862>>>>>>>>>>>>>>
21862>>>>>>>>>>>>>    End_Procedure
21863>>>>>>>>>>>>>    
21863>>>>>>>>>>>>>    // Drill-down version of the restorestate implementation. It parses the state hash into the 
21863>>>>>>>>>>>>>    // separate pieces and restores the entire view stack. It loops over the views in the state
21863>>>>>>>>>>>>>    // hash and checks if they are already properly initialized, if not it will reinitialize the
21863>>>>>>>>>>>>>    // view and rest of the stack from that point on,  if it is properly initialized it won't do
21863>>>>>>>>>>>>>    // anything for this step.
21863>>>>>>>>>>>>>    //
21863>>>>>>>>>>>>>    // Params:
21863>>>>>>>>>>>>>    //      sStateHash      Full state hash string.
21863>>>>>>>>>>>>>    //      bManualEnter    True if the string is manually entered (not used in drill-down).
21863>>>>>>>>>>>>>    Procedure RestoreState_DrillDown String sStateHash Boolean bManualEnter
21865>>>>>>>>>>>>>        String sViewName sState sMainID sCustomState
21865>>>>>>>>>>>>>        String[] asStates asViews asMainIDs asCustomStates asParams
21870>>>>>>>>>>>>>        Integer iState iNavType iPos iStack iStateTo eViewStyle eTopViewStyle iCount iLastViewIndex iFirstDialogIndex
21870>>>>>>>>>>>>>        Handle hoView hoStackView hoTopView hoPrevView hoDefaultView hoInvoking hjObjectDef
21870>>>>>>>>>>>>>        Handle[] ahViews ahInvokingObjects
21872>>>>>>>>>>>>>        Integer[] aeNavType
21873>>>>>>>>>>>>>        Boolean bAllowAccess bOverrideState bReinitialize bOK bIsLoaded bViewShown bErr bSuccess bIsTopView bHandled
21873>>>>>>>>>>>>>        tWebViewInfo[] aViewStack
21873>>>>>>>>>>>>>        tWebViewInfo[] aViewStack
21874>>>>>>>>>>>>>        
21874>>>>>>>>>>>>>        Move False to bViewShown
21875>>>>>>>>>>>>>        Move False to bReinitialize
21876>>>>>>>>>>>>>        Move False to bErr
21877>>>>>>>>>>>>>        Move 0 to iStack
21878>>>>>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack    
21880>>>>>>>>>>>>>        
21880>>>>>>>>>>>>>        Get GetDefaultView to hoDefaultView
21881>>>>>>>>>>>>>        
21881>>>>>>>>>>>>>        //  Split into separate view state hashes
21881>>>>>>>>>>>>>        Get ParseStateHash sStateHash to asStates
21882>>>>>>>>>>>>>        
21882>>>>>>>>>>>>>        //  Resize arrays (for performance and byref calls)
21882>>>>>>>>>>>>>        Move (ResizeArray(asViews, SizeOfArray(asStates))) to asViews
21883>>>>>>>>>>>>>        Move (ResizeArray(asMainIDs, SizeOfArray(asStates))) to asMainIDs
21884>>>>>>>>>>>>>        Move (ResizeArray(asCustomStates, SizeOfArray(asStates))) to asCustomStates
21885>>>>>>>>>>>>>        Move (ResizeArray(ahViews, SizeOfArray(asStates))) to ahViews
21886>>>>>>>>>>>>>        Move (ResizeArray(ahInvokingObjects, SizeOfArray(asStates))) to ahInvokingObjects
21887>>>>>>>>>>>>>        Move (ResizeArray(aeNavType, SizeOfArray(asStates))) to aeNavType
21888>>>>>>>>>>>>>        
21888>>>>>>>>>>>>>        //  Start at global level
21888>>>>>>>>>>>>>        Move Self to hoInvoking
21889>>>>>>>>>>>>>        If (hoDefaultView <> C_WebUnresolvedObject and peStateMode(hoDefaultView) = vsmOff) Begin
21891>>>>>>>>>>>>>            Move hoDefaultView to hoInvoking
21892>>>>>>>>>>>>>            
21892>>>>>>>>>>>>>            Get AllowViewAccess hoDefaultView to bAllowAccess
21893>>>>>>>>>>>>>            
21893>>>>>>>>>>>>>            If (not(bAllowAccess)) Begin
21895>>>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
21896>>>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
21899>>>>>>>>>>>>>                    
21899>>>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
21900>>>>>>>>>>>>>            End
21900>>>>>>>>>>>>>>
21900>>>>>>>>>>>>>        End
21900>>>>>>>>>>>>>>
21900>>>>>>>>>>>>>                
21900>>>>>>>>>>>>>        //  Parse URL and validate view names
21900>>>>>>>>>>>>>        Move (SizeOfArray(asStates) - 1) to iStateTo
21901>>>>>>>>>>>>>        For iState from 0 to iStateTo
21907>>>>>>>>>>>>>>
21907>>>>>>>>>>>>>            Send ParseViewStateHash asStates[iState] (&asViews[iState]) (&asMainIDs[iState]) (&asCustomStates[iState])
21908>>>>>>>>>>>>>            
21908>>>>>>>>>>>>>            //  Search on previous view
21908>>>>>>>>>>>>>            Get FindNavPathByKey of hoInvoking asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
21909>>>>>>>>>>>>>            
21909>>>>>>>>>>>>>            //  The exception for the default view
21909>>>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject and iState <= 1 and hoInvoking = hoDefaultView) Begin
21911>>>>>>>>>>>>>                Get FindNavPathByKey of Self asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
21912>>>>>>>>>>>>>                Move Self to hoInvoking
21913>>>>>>>>>>>>>            End
21913>>>>>>>>>>>>>>
21913>>>>>>>>>>>>>            
21913>>>>>>>>>>>>>            //  If not found we have an invalid URL
21913>>>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject) Begin
21915>>>>>>>>>>>>>                //  Gracefull error and fallback to default view
21915>>>>>>>>>>>>>                Get Reset of (ViewStack(Self)) False True to bOK
21916>>>>>>>>>>>>>                If (hoDefaultView > 0) Begin
21918>>>>>>>>>>>>>                    Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
21919>>>>>>>>>>>>>                End
21919>>>>>>>>>>>>>>
21919>>>>>>>>>>>>>                
21919>>>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
21921>>>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
21922>>>>>>>>>>>>>>
21922>>>>>>>>>>>>>                End
21922>>>>>>>>>>>>>>
21922>>>>>>>>>>>>>                Else If (hoDefaultView > 0) Begin
21925>>>>>>>>>>>>>                    Send UpdateStateHash of hoDefaultView True
21926>>>>>>>>>>>>>                End
21926>>>>>>>>>>>>>>
21926>>>>>>>>>>>>>                Procedure_Return
21927>>>>>>>>>>>>>            End
21927>>>>>>>>>>>>>>
21927>>>>>>>>>>>>>            
21927>>>>>>>>>>>>>            Get AllowViewAccess ahViews[iState] to bAllowAccess
21928>>>>>>>>>>>>>            
21928>>>>>>>>>>>>>            If (not(bAllowAccess)) Begin
21930>>>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
21931>>>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
21934>>>>>>>>>>>>>                    
21934>>>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
21935>>>>>>>>>>>>>                Move -1 to iStateTo
21936>>>>>>>>>>>>>            End
21936>>>>>>>>>>>>>>
21936>>>>>>>>>>>>>            
21936>>>>>>>>>>>>>            Move ahViews[iState] to hoInvoking
21937>>>>>>>>>>>>>        Loop    
21938>>>>>>>>>>>>>>
21938>>>>>>>>>>>>>        
21938>>>>>>>>>>>>>        
21938>>>>>>>>>>>>>        //  Loop over parsed states and compare to view stack
21938>>>>>>>>>>>>>        For iState from 0 to iStateTo
21944>>>>>>>>>>>>>>
21944>>>>>>>>>>>>>            Move hoView to hoPrevView
21945>>>>>>>>>>>>>            
21945>>>>>>>>>>>>>            Move ahViews[iState] to hoView    
21946>>>>>>>>>>>>>            Move asMainIDs[iState] to sMainID
21947>>>>>>>>>>>>>            Move asCustomStates[iState] to sCustomState
21948>>>>>>>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
21949>>>>>>>>>>>>>            
21949>>>>>>>>>>>>>            If (eViewStyle <> wvsDialog) Begin
21951>>>>>>>>>>>>>                Move iState to iLastViewIndex
21952>>>>>>>>>>>>>            End
21952>>>>>>>>>>>>>>
21952>>>>>>>>>>>>>            Else If (eViewStyle = wvsDialog and iFirstDialogIndex = 0) Begin
21955>>>>>>>>>>>>>                Move iState to iFirstDialogIndex
21956>>>>>>>>>>>>>            End
21956>>>>>>>>>>>>>>
21956>>>>>>>>>>>>>            
21956>>>>>>>>>>>>>            //  If we where not reinitializing yet we check if we can get away with doing nothing
21956>>>>>>>>>>>>>            If (not(bReinitialize)) Begin
21958>>>>>>>>>>>>>                Move True to bReinitialize
21959>>>>>>>>>>>>>                
21959>>>>>>>>>>>>>                //  If the default view has vsmOff set then it will be on the stack but not in the hash, so we jump one step
21959>>>>>>>>>>>>>                If (hoDefaultView > 0 and peStateMode(hoDefaultView) = vsmOff and iStack = 0 and SizeOfArray(aViewStack) > 0) Begin
21961>>>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
21962>>>>>>>>>>>>>                    If (hoStackView = hoDefaultView) Begin
21964>>>>>>>>>>>>>                        Increment iStack
21965>>>>>>>>>>>>>                        Move hoDefaultView to hoPrevView
21966>>>>>>>>>>>>>                    End
21966>>>>>>>>>>>>>>
21966>>>>>>>>>>>>>                End
21966>>>>>>>>>>>>>>
21966>>>>>>>>>>>>>                
21966>>>>>>>>>>>>>                //  Check if stack matches hash
21966>>>>>>>>>>>>>                If (iStack < SizeOfArray(aViewStack)) Begin
21968>>>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
21969>>>>>>>>>>>>>                    
21969>>>>>>>>>>>>>                    If (hoView = hoStackView) Begin
21971>>>>>>>>>>>>>                        Get NeedReinitialize of hoView sMainID to bReinitialize
21972>>>>>>>>>>>>>                    End
21972>>>>>>>>>>>>>>
21972>>>>>>>>>>>>>                    
21972>>>>>>>>>>>>>                    //  If it didn't we need to close stuff to the level where it matched
21972>>>>>>>>>>>>>                    If (bReinitialize) Begin
21974>>>>>>>>>>>>>                        Get TopViewHandle of (ViewStack(Self)) to hoTopView
21975>>>>>>>>>>>>>                        
21975>>>>>>>>>>>>>                        //  We just rudely close views here, no checks, this is what entering the new URL would basically do as well!
21975>>>>>>>>>>>>>                        Send Hide of hoTopView
21976>>>>>>>>>>>>>                        Send PopDownToView of (ViewStack(Self)) hoPrevView
21977>>>>>>>>>>>>>                    End
21977>>>>>>>>>>>>>>
21977>>>>>>>>>>>>>                End
21977>>>>>>>>>>>>>>
21977>>>>>>>>>>>>>            End
21977>>>>>>>>>>>>>>
21977>>>>>>>>>>>>>            
21977>>>>>>>>>>>>>            //  If the stack didn't match the state hash we need to reinitialize.
21977>>>>>>>>>>>>>            If (bReinitialize) Begin
21979>>>>>>>>>>>>>                If (iStack = 0) Begin
21981>>>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
21982>>>>>>>>>>>>>                    
21982>>>>>>>>>>>>>                    If (hoDefaultView <> hoView and hoDefaultView > 0) Begin
21984>>>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
21985>>>>>>>>>>>>>                    End
21985>>>>>>>>>>>>>>
21985>>>>>>>>>>>>>                    
21985>>>>>>>>>>>>>                End
21985>>>>>>>>>>>>>>
21985>>>>>>>>>>>>>                
21985>>>>>>>>>>>>>                // Check if this is the top view
21985>>>>>>>>>>>>>                If (iState = (SizeOfArray(asStates) -1)) Begin
21987>>>>>>>>>>>>>                    Move True to bIsTopView
21988>>>>>>>>>>>>>                    
21988>>>>>>>>>>>>>                    //If the top view is a dialog we should render the first actual view too
21988>>>>>>>>>>>>>                    If (eViewStyle = wvsDialog) Begin
21990>>>>>>>>>>>>>                        Move iLastViewIndex to iCount
21991>>>>>>>>>>>>>                        //We need to know what view should be rendered behind the dialog
21991>>>>>>>>>>>>>                        While (iCount < iState)
21995>>>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
21996>>>>>>>>>>>>>                            Increment iCount
21997>>>>>>>>>>>>>                        Loop    
21998>>>>>>>>>>>>>>
21998>>>>>>>>>>>>>                    End
21998>>>>>>>>>>>>>>
21998>>>>>>>>>>>>>                    
21998>>>>>>>>>>>>>                End
21998>>>>>>>>>>>>>>
21998>>>>>>>>>>>>>                Else Begin
21999>>>>>>>>>>>>>                    Move False to bIsTopView
22000>>>>>>>>>>>>>                End
22000>>>>>>>>>>>>>>
22000>>>>>>>>>>>>>                
22000>>>>>>>>>>>>>                //  Actually initialize the view
22000>>>>>>>>>>>>>                Get NavigateInitialize of hoView ahInvokingObjects[iState] bIsTopView asStates[iState] aeNavType[iState] to bSuccess
22001>>>>>>>>>>>>>                If (not(bSuccess)) Begin
22003>>>>>>>>>>>>>                    //  Fallback to default view (error is already shown)
22003>>>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
22004>>>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
22006>>>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
22007>>>>>>>>>>>>>                    End
22007>>>>>>>>>>>>>>
22007>>>>>>>>>>>>>                    
22007>>>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
22009>>>>>>>>>>>>>                        Send UpdateStateHash of hoDefaultView True
22010>>>>>>>>>>>>>                    End
22010>>>>>>>>>>>>>>
22010>>>>>>>>>>>>>                    Procedure_Return
22011>>>>>>>>>>>>>                End
22011>>>>>>>>>>>>>>
22011>>>>>>>>>>>>>            End
22011>>>>>>>>>>>>>>
22011>>>>>>>>>>>>>            
22011>>>>>>>>>>>>>            Move True to bViewShown
22012>>>>>>>>>>>>>            Increment iStack
22013>>>>>>>>>>>>>      
22013>>>>>>>>>>>>>        Loop    
22014>>>>>>>>>>>>>>
22014>>>>>>>>>>>>>        
22014>>>>>>>>>>>>>        //  If no view is shown we show the default view..
22014>>>>>>>>>>>>>        If (not(bViewShown)) Begin
22016>>>>>>>>>>>>>            Get Reset of (ViewStack(Self)) False True to bOK
22017>>>>>>>>>>>>>            Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
22018>>>>>>>>>>>>>        End
22018>>>>>>>>>>>>>>
22018>>>>>>>>>>>>>        
22018>>>>>>>>>>>>>        //  We only serialize the last view in the stack right away
22018>>>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
22020>>>>>>>>>>>>>            
22020>>>>>>>>>>>>>            If (not(bReinitialize)) Begin
22022>>>>>>>>>>>>>                Get TopViewHandle of (ViewStack(Self)) to hoTopView
22023>>>>>>>>>>>>>                If (hoView <> hoTopView) Begin
22025>>>>>>>>>>>>>                    If (hoTopView > 0) Begin
22027>>>>>>>>>>>>>                        Send Hide of hoTopView
22028>>>>>>>>>>>>>                        Get peWebViewStyle of hoTopView to eTopViewStyle
22029>>>>>>>>>>>>>                    End
22029>>>>>>>>>>>>>>
22029>>>>>>>>>>>>>                    Send PopDownToView of (ViewStack(Self)) hoView
22030>>>>>>>>>>>>>                    Send UpdateInvokingViewDrillDownStyle of hoView
22031>>>>>>>>>>>>>                    
22031>>>>>>>>>>>>>                    Get pbOverrideStateOnShow of hoView to bOverrideState
22032>>>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to False
22033>>>>>>>>>>>>>                    
22033>>>>>>>>>>>>>                    Get peWebViewStyle of hoView to eViewStyle
22034>>>>>>>>>>>>>                    // When navigating from a regular view to a dialog we should restore more views
22034>>>>>>>>>>>>>                    // Restore everything up untill the first actual view
22034>>>>>>>>>>>>>                    If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
22036>>>>>>>>>>>>>                        Move iLastViewIndex to iCount
22037>>>>>>>>>>>>>                        //Start from the last actual view and move up from there on.
22037>>>>>>>>>>>>>                        While (iCount <= iStateTo)
22041>>>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
22042>>>>>>>>>>>>>                            Increment iCount
22043>>>>>>>>>>>>>                        Loop
22044>>>>>>>>>>>>>>
22044>>>>>>>>>>>>>                    End
22044>>>>>>>>>>>>>>
22044>>>>>>>>>>>>>                    Else Begin
22045>>>>>>>>>>>>>                        Send ShowView to (Host(Self)) hoView        // Send ShowView so we do not clear the entire viewstack    
22046>>>>>>>>>>>>>                    End
22046>>>>>>>>>>>>>>
22046>>>>>>>>>>>>>                                    
22046>>>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to bOverrideState
22047>>>>>>>>>>>>>                End
22047>>>>>>>>>>>>>>
22047>>>>>>>>>>>>>            
22047>>>>>>>>>>>>>            End
22047>>>>>>>>>>>>>>
22047>>>>>>>>>>>>>            Else Begin
22048>>>>>>>>>>>>>                Get IsViewLoaded hoView to bIsLoaded
22049>>>>>>>>>>>>>                If (not(bIsLoaded)) Begin
22051>>>>>>>>>>>>>                    Set phoLoadView to hoView   //  Set phoLoadView as ClientActions sent by OnLoad must be marked as load view client actions
22052>>>>>>>>>>>>>                    
22052>>>>>>>>>>>>>                    Get SerializeObject of hoView to hjObjectDef
22053>>>>>>>>>>>>>                    Send ClientActionEarly "createView" asParams hjObjectDef               
22054>>>>>>>>>>>>>                    Send Destroy of hjObjectDef
22055>>>>>>>>>>>>>                    Set phoLoadView to C_WebUnresolvedObject
22056>>>>>>>>>>>>>                End
22056>>>>>>>>>>>>>>
22056>>>>>>>>>>>>>            End
22056>>>>>>>>>>>>>>
22056>>>>>>>>>>>>>        End    
22056>>>>>>>>>>>>>>
22056>>>>>>>>>>>>>    End_Procedure
22057>>>>>>>>>>>>>    
22057>>>>>>>>>>>>>    // Splits a view state hash string into the different pieces that it can contain.
22057>>>>>>>>>>>>>    //
22057>>>>>>>>>>>>>    // Params:
22057>>>>>>>>>>>>>    //      sStateHash              Complete view state hash.
22057>>>>>>>>>>>>>    //      ByRef sView             Will receive the view name.
22057>>>>>>>>>>>>>    //      Byref sOptRecordId      (optional) Will receive the record id.
22057>>>>>>>>>>>>>    //      ByRef sOptCustomHash    (optional) Will receive the custom hash.
22057>>>>>>>>>>>>>    Procedure ParseViewStateHash String sStateHash String ByRef sView String ByRef sOptRecordId String ByRef sOptCustomHash
22059>>>>>>>>>>>>>        String[] asParts
22060>>>>>>>>>>>>>        
22060>>>>>>>>>>>>>        //  Cut off possible "/" prefix
22060>>>>>>>>>>>>>        If (Left(sStateHash, 1) = "/") Begin
22062>>>>>>>>>>>>>            Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
22063>>>>>>>>>>>>>        End
22063>>>>>>>>>>>>>>
22063>>>>>>>>>>>>>        
22063>>>>>>>>>>>>>        Move "" to sView
22064>>>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "-")) to asParts
22065>>>>>>>>>>>>>        
22065>>>>>>>>>>>>>        If (num_arguments > 3) Begin        
22067>>>>>>>>>>>>>            Move "" to sOptCustomHash
22068>>>>>>>>>>>>>
22068>>>>>>>>>>>>>            If (SizeOfArray(asParts) > 2) Begin 
22070>>>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[2] to sOptCustomHash
22071>>>>>>>>>>>>>            End
22071>>>>>>>>>>>>>>
22071>>>>>>>>>>>>>        End
22071>>>>>>>>>>>>>>
22071>>>>>>>>>>>>>        
22071>>>>>>>>>>>>>        If (num_arguments > 2) Begin
22073>>>>>>>>>>>>>            Move "" to sOptRecordId
22074>>>>>>>>>>>>>            
22074>>>>>>>>>>>>>            If (SizeOfArray(asParts) > 1) Begin
22076>>>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[1] to sOptRecordId
22077>>>>>>>>>>>>>            End
22077>>>>>>>>>>>>>>
22077>>>>>>>>>>>>>        End
22077>>>>>>>>>>>>>>
22077>>>>>>>>>>>>>        If (SizeOfArray(asParts) > 0) Begin
22079>>>>>>>>>>>>>            Get UnescapeViewStatePartial asParts[0] to sView
22080>>>>>>>>>>>>>        End
22080>>>>>>>>>>>>>>
22080>>>>>>>>>>>>>        
22080>>>>>>>>>>>>>    End_Procedure
22081>>>>>>>>>>>>>    
22081>>>>>>>>>>>>>    // Concatenates the different parts of a view state hash into a single string. Some characters 
22081>>>>>>>>>>>>>    // will be escaped.
22081>>>>>>>>>>>>>    //
22081>>>>>>>>>>>>>    // Params:
22081>>>>>>>>>>>>>    //      sView       The view name.
22081>>>>>>>>>>>>>    //      sRecordId   The record id.
22081>>>>>>>>>>>>>    //      sCustomHash Custom hash part.
22081>>>>>>>>>>>>>    Function ConcatViewStateHash String sView String sRecordId String sCustomHash Returns String
22083>>>>>>>>>>>>>        String sResult
22083>>>>>>>>>>>>>        
22083>>>>>>>>>>>>>        Get EscapeViewStatePartial sView to sView
22084>>>>>>>>>>>>>        Move sView to sResult
22085>>>>>>>>>>>>>        
22085>>>>>>>>>>>>>        If (sRecordId <> "" or sCustomHash <> "") Begin
22087>>>>>>>>>>>>>            Get EscapeViewStatePartial sRecordId to sRecordId
22088>>>>>>>>>>>>>            Move (sResult + "-" + sRecordId) to sResult
22089>>>>>>>>>>>>>            
22089>>>>>>>>>>>>>            If (sCustomHash <> "") Begin
22091>>>>>>>>>>>>>                Get EscapeViewStatePartial sCustomHash to sCustomHash
22092>>>>>>>>>>>>>                Move (sResult + "-" + sCustomHash) to sResult
22093>>>>>>>>>>>>>            End
22093>>>>>>>>>>>>>>
22093>>>>>>>>>>>>>        End
22093>>>>>>>>>>>>>>
22093>>>>>>>>>>>>>        
22093>>>>>>>>>>>>>        Function_Return sResult
22094>>>>>>>>>>>>>    End_Function
22095>>>>>>>>>>>>>    
22095>>>>>>>>>>>>>    // Splits a drill-down style state hash into an array of separate view state hashes.
22095>>>>>>>>>>>>>    //
22095>>>>>>>>>>>>>    // Params:
22095>>>>>>>>>>>>>    //      sStateHash  Full state hash.
22095>>>>>>>>>>>>>    // Returns:
22095>>>>>>>>>>>>>    //      Array of view state hashes.
22095>>>>>>>>>>>>>    Function ParseStateHash String sStateHash Returns String[]
22097>>>>>>>>>>>>>        String[] aViewStateHashes
22098>>>>>>>>>>>>>        Integer i
22098>>>>>>>>>>>>>        
22098>>>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "/")) to aViewStateHashes
22099>>>>>>>>>>>>>        
22099>>>>>>>>>>>>>        //  Remove empty parts
22099>>>>>>>>>>>>>        For i from 0 to (SizeOfArray(aViewStateHashes) - 1)
22105>>>>>>>>>>>>>>
22105>>>>>>>>>>>>>            If (Trim(aViewStateHashes[i]) = "") Begin
22107>>>>>>>>>>>>>                Move (RemoveFromArray(aViewStateHashes, i)) to aViewStateHashes
22108>>>>>>>>>>>>>            End
22108>>>>>>>>>>>>>>
22108>>>>>>>>>>>>>        Loop
22109>>>>>>>>>>>>>>
22109>>>>>>>>>>>>>        
22109>>>>>>>>>>>>>        Function_Return aViewStateHashes
22110>>>>>>>>>>>>>    End_Function
22111>>>>>>>>>>>>>    
22111>>>>>>>>>>>>>    // Appends a view state hash to a drill-down style state hash.
22111>>>>>>>>>>>>>    //
22111>>>>>>>>>>>>>    // Params:
22111>>>>>>>>>>>>>    //      sStateHash      Existing state hash.
22111>>>>>>>>>>>>>    //      sViewStateHash  View state hash to append.
22111>>>>>>>>>>>>>    // Returns:
22111>>>>>>>>>>>>>    //      The extended state has string.
22111>>>>>>>>>>>>>    Function AppendStateHash String sStateHash String sViewStateHash Returns String
22113>>>>>>>>>>>>>        If (sStateHash <> "") Begin
22115>>>>>>>>>>>>>            Move (sStateHash + "/" + sViewStateHash) to sStateHash
22116>>>>>>>>>>>>>        End
22116>>>>>>>>>>>>>>
22116>>>>>>>>>>>>>        Else Begin
22117>>>>>>>>>>>>>            Move sViewStateHash to sStateHash
22118>>>>>>>>>>>>>        End
22118>>>>>>>>>>>>>>
22118>>>>>>>>>>>>>        
22118>>>>>>>>>>>>>        Function_Return sStateHash
22119>>>>>>>>>>>>>    End_Function
22120>>>>>>>>>>>>>    
22120>>>>>>>>>>>>>    //  Escapes disallowed characters in a view state partial with their hexadecimal values between
22120>>>>>>>>>>>>>    //  ~ characters. The / and - are escaped because they are used to concatenate the different 
22120>>>>>>>>>>>>>    // pieces.
22120>>>>>>>>>>>>>    //
22120>>>>>>>>>>>>>    // Params:
22120>>>>>>>>>>>>>    //      sHash   The partial hash to escape.
22120>>>>>>>>>>>>>    // Returns:
22120>>>>>>>>>>>>>    //      The escaped partial view state hash.
22120>>>>>>>>>>>>>    Function EscapeViewStatePartial String sHash Returns String
22122>>>>>>>>>>>>>        //  Encode characters used elsewhere in URLs
22122>>>>>>>>>>>>>        Move (Replaces("-", Replaces("/", sHash, "~2f~"), "~5f~")) to sHash
22123>>>>>>>>>>>>>        
22123>>>>>>>>>>>>>        Move (UrlEncode(sHash, True)) to sHash
22124>>>>>>>>>>>>>        
22124>>>>>>>>>>>>>        Function_Return sHash
22125>>>>>>>>>>>>>    End_Function    
22126>>>>>>>>>>>>>    
22126>>>>>>>>>>>>>    // Unescapes a view state partial that has been escaped by EscapeViewStatePartial.
22126>>>>>>>>>>>>>    //
22126>>>>>>>>>>>>>    // Params:
22126>>>>>>>>>>>>>    //      sHash   The partial hash to unescape.
22126>>>>>>>>>>>>>    // Returns:
22126>>>>>>>>>>>>>    //      The unescaped partial view state hash.
22126>>>>>>>>>>>>>    Function UnescapeViewStatePartial String sHash Returns String
22128>>>>>>>>>>>>>        Move (UrlDecode(sHash)) to sHash
22129>>>>>>>>>>>>>        
22129>>>>>>>>>>>>>        //  Decode characters used elsehwere in urls
22129>>>>>>>>>>>>>        Move (Replaces("~5f~", Replaces("~2f~", sHash, "/"), "-")) to sHash
22130>>>>>>>>>>>>>        
22130>>>>>>>>>>>>>        Function_Return sHash
22131>>>>>>>>>>>>>    End_Function 
