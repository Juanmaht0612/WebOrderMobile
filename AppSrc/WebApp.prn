39144>>>>>>>Class cPasswordHasher is a cObject
39145>>>>>>>    
39145>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
39146>>>>>>>    
39146>>>>>>>    Procedure Construct_Object
39148>>>>>>>        Forward Send Construct_Object
39150>>>>>>>        
39150>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
39151>>>>>>>        Property UInteger   puiSaltSize         16
39152>>>>>>>        
39152>>>>>>>        Property UInteger   puiOptTimeCost      420000
39153>>>>>>>    End_Procedure
39154>>>>>>>    
39154>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
39156>>>>>>>        Boolean bOk
39156>>>>>>>        UInteger uiAlgo
39156>>>>>>>        Get peAlgorithm to uiAlgo
39157>>>>>>>        
39157>>>>>>>        Case Begin
39157>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
39159>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
39162>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
39163>>>>>>>                Case Break
39164>>>>>>>            Case Else
39164>>>>>>>                Error 8710 "Invalid algorithm selected."
39165>>>>>>>>
39165>>>>>>>                Function_Return False
39166>>>>>>>        Case End
39166>>>>>>>        
39166>>>>>>>        Function_Return bOk
39167>>>>>>>    End_Function
39168>>>>>>>    
39168>>>>>>>    Function RequiredBufferSize Returns UBigInt
39170>>>>>>>        UBigInt ullSize
39170>>>>>>>        UInteger uiAlgo
39170>>>>>>>        Get peAlgorithm to uiAlgo
39171>>>>>>>        
39171>>>>>>>        Case Begin
39171>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
39173>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
39176>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
39177>>>>>>>                Case Break
39178>>>>>>>            Case Else
39178>>>>>>>                Error 8710 "Invalid algorithm selected."
39179>>>>>>>>
39179>>>>>>>                Function_Return 0
39180>>>>>>>        Case End
39180>>>>>>>        
39180>>>>>>>        Function_Return ullSize
39181>>>>>>>    End_Function
39182>>>>>>>
39182>>>>>>>End_Class
