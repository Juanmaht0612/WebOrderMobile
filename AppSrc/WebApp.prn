55313>>>>>>>    Procedure ReadDevNames
55315>>>>>>>        Integer iResult iVoid
55315>>>>>>>        Handle hDevNames
55315>>>>>>>        Pointer pDevNames pData
55315>>>>>>>        DEVNAMES dn
55315>>>>>>>        DEVNAMES dn
55315>>>>>>>        WString wName
55315>>>>>>>
55315>>>>>>>        Get phDevNames to hDevNames
55316>>>>>>>        If (hDevNames = 0) Begin
55318>>>>>>>            Procedure_Return
55319>>>>>>>        End
55319>>>>>>>>
55319>>>>>>>
55319>>>>>>>        // Lock memory
55319>>>>>>>        Move (GlobalLock (hDevNames)) to pDevNames
55320>>>>>>>        If (pDevNames = 0) Begin
55322>>>>>>>            Procedure_Return
55323>>>>>>>        End
55323>>>>>>>>
55323>>>>>>>
55323>>>>>>>        // Copy the the devnames structure, devnames structure only contains the pointers to the names
55323>>>>>>>        Move (CopyMemory (AddressOf (dn), pDevNames, SizeOfType (DEVNAMES))) to iVoid
55324>>>>>>>
55324>>>>>>>        // Copy the drivername from the memory pointer to the DataFlex property
55324>>>>>>>        If (dn.wDriverOffset > 0) Begin
55326>>>>>>>            Move (pDevNames + (dn.wDriverOffset * 2)) to pData // wDriverOffset is in code units
55327>>>>>>>            Move (PointerToWString (pData)) to wName
55328>>>>>>>            Set psDriverName to wName
55329>>>>>>>        End
55329>>>>>>>>
55329>>>>>>>
55329>>>>>>>        // Copy the devicename from the memory pointer to the DataFlex property
55329>>>>>>>        If (dn.wDeviceOffset > 0) Begin
55331>>>>>>>            Move (pDevNames + (dn.wDeviceOffset * 2)) to pData
55332>>>>>>>            Move (PointerToWString (pData)) to wName
55333>>>>>>>            Set psDeviceName to wName
55334>>>>>>>        End
55334>>>>>>>>
55334>>>>>>>
55334>>>>>>>        // Copy the outputname from the memory pointer to the DataFlex property
55334>>>>>>>        If (dn.wOutputOffset > 0) Begin
55336>>>>>>>            Move (pDevNames + (dn.wOutputOffset * 2)) to pData
55337>>>>>>>            Move (PointerToWString (pData)) to wName
55338>>>>>>>            Set psOutputName to wName
55339>>>>>>>        End
55339>>>>>>>>
55339>>>>>>>
55339>>>>>>>        Set pbDefaultPrinterSelected to (IsFlagIn (DN_DEFAULTPRN, dn.wDefault))
55340>>>>>>>
55340>>>>>>>        // Unlock memory
55340>>>>>>>        Move (GlobalUnlock (hDevNames)) to iResult
55341>>>>>>>    End_Procedure
