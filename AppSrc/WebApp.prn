29705>>>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 13) ;                            Decrement iOffset
29708>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, iOffset))) to ucValue
29709>>>>>>>>>>>                    End
29709>>>>>>>>>>>>
29709>>>>>>>>>>>                    Else Begin
29710>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
29711>>>>>>>>>>>                        Send ReadChunk (&parsedata)
29712>>>>>>>>>>>                    End
29712>>>>>>>>>>>>
29712>>>>>>>>>>>                    
29712>>>>>>>>>>>                    Send OnField sFieldname ucValue
29713>>>>>>>>>>>                End
29713>>>>>>>>>>>>
29713>>>>>>>>>>>            End
