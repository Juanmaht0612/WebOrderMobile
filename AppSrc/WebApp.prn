39056>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
39058>>>>>>>        Boolean bRequiresTimeCost
39058>>>>>>>        UInteger uiAlgo uiTimeCost
39058>>>>>>>        Integer iBegin iEnd
39058>>>>>>>        String sSalt
39058>>>>>>>        
39058>>>>>>>        Move 1 to iBegin
39059>>>>>>>        
39059>>>>>>>        // Parse Algo
39059>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
39060>>>>>>>        If (not(iEnd)) Function_Return False
39063>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
39064>>>>>>>        
39064>>>>>>>        // Parse Salt
39064>>>>>>>        Move (iEnd + 1) to iBegin
39065>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
39066>>>>>>>        If (not(iEnd)) Function_Return False
39069>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
39070>>>>>>>        
39070>>>>>>>        Case Begin
39070>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
39072>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
39075>>>>>>>                Move True to bRequiresTimeCost
39076>>>>>>>                Case Break
39077>>>>>>>            Case Else
39077>>>>>>>                Error 8710 "Invalid algorithm selected."
39078>>>>>>>>
39078>>>>>>>                Function_Return False
39079>>>>>>>        Case End
39079>>>>>>>        
39079>>>>>>>        // Parse optional timecost
39079>>>>>>>        If (bRequiresTimeCost) Begin
39081>>>>>>>            Move (iEnd + 1) to iBegin
39082>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
39083>>>>>>>            If (not(iEnd)) Function_Return False
39086>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
39087>>>>>>>        End
39087>>>>>>>>
39087>>>>>>>        
39087>>>>>>>        // Parse rest hash
39087>>>>>>>        Move (iEnd + 1) to iBegin
39088>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
39089>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
39092>>>>>>>        
39092>>>>>>>        // Base64Decode
39092>>>>>>>        UChar[] ucaSalt
39093>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
39094>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
39097>>>>>>>        
39097>>>>>>>        // Create new hash
39097>>>>>>>        String sNewHash
39097>>>>>>>        If (bRequiresTimeCost) Begin
39099>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
39101>>>>>>>                Function_Return False 
39102>>>>>>>            End
39102>>>>>>>>
39102>>>>>>>        End
39102>>>>>>>>
39102>>>>>>>        Else Begin
39103>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
39105>>>>>>>                Function_Return False 
39106>>>>>>>            End
39106>>>>>>>>
39106>>>>>>>        End
39106>>>>>>>>
39106>>>>>>>        // Use binary comparison, not affected by DF_LOCALE_CODE collation.
39106>>>>>>>        If (SizeOfString(sNewHash) <> SizeOfString(sHash)) ;            Function_Return False
39109>>>>>>>        Function_Return (MemCompare(AddressOf(sNewHash), AddressOf(sHash), SizeOfString(sNewHash)) = 0)
39110>>>>>>>    End_Function
