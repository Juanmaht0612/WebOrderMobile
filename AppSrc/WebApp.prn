38249>>>Use cLoginEncryption.pkg
Including file: cLoginEncryption.pkg    (E:\Jenkins\workspace\DataFlex 26.0 - DF Source\pkg\cLoginEncryption.pkg)
38249>>>>>Use cCryptographerEx.pkg
38249>>>>>
38249>>>>>Class cLoginEncryption is a cObject
38250>>>>>    
38250>>>>>    Procedure Construct_Object
38252>>>>>        Forward Send Construct_Object
38254>>>>>        // this must be set to a multi (40ish) character random key
38254>>>>>        Property String psEncryptPassword ""
38255>>>>>        
38255>>>>>        Object oDataCrypter is a cCryptographerEx
38257>>>>>            Set piHash to CALG_SHA_256
38258>>>>>            Set piCipher to CALG_AES_256
38259>>>>>            Set psProvider to "" //  Not providing a specific provider gives the default provider for the provider type
38260>>>>>            Set piProvider to PROV_RSA_AES
38261>>>>>        End_Object
38262>>>>>    End_Procedure
38263>>>>>    
38263>>>>>    // This can be augmented to return a password encryption key using any
38263>>>>>    // hidden mechanism desired.
38263>>>>>    Function GetEncryptionPassword Returns String
38265>>>>>        String sPassword
38265>>>>>        Get psEncryptPassword to sPassword
38266>>>>>        Function_Return sPassword
38267>>>>>    End_Function
38268>>>>>    
38268>>>>>    // Encrypts a string into an unreadable hash that can later be decrypted using DecryptKey.
38268>>>>>    //
38268>>>>>    // Params:
38268>>>>>    //   sPlainText     String to encrypt.
38268>>>>>    // Returns:
38268>>>>>    //   Base64 encoded hash.
38268>>>>>    Function EncryptPassword String sPlainText Returns String
38270>>>>>        String sEncryptPassword sBase64
38270>>>>>        UChar[] ucBinary
38271>>>>>        Pointer pBase64
38271>>>>>        Integer iVoid
38271>>>>>        
38271>>>>>        //  Encrypt Key
38271>>>>>        Get GetEncryptionPassword to sEncryptPassword
38272>>>>>        If (sEncryptPassword = "") Begin
38274>>>>>            Error DFERR_PROGRAM "No encryption password set"
38275>>>>>>
38275>>>>>        End
38275>>>>>>
38275>>>>>        
38275>>>>>        Get Encrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) (StringToUCharArray(sPlainText)) to ucBinary
38276>>>>>        
38276>>>>>        If (SizeOfArray(ucBinary) = 0) Begin
38278>>>>>            Error DFERR_PROGRAM "Unable to encrypt database login password"
38279>>>>>>
38279>>>>>            Function_Return ""
38280>>>>>        End
38280>>>>>>
38280>>>>>        
38280>>>>>        //  Encode binary hash to Base64
38280>>>>>        Move (Base64Encode(AddressOf(ucBinary), SizeOfArray(ucBinary))) to pBase64
38281>>>>>        Move (PointerToString(pBase64)) to sBase64
38282>>>>>        Move (Free(pBase64)) to iVoid
38283>>>>>        
38283>>>>>        Function_Return sBase64
38284>>>>>    End_Function
38285>>>>>    
38285>>>>>    
38285>>>>>    // Decrypts the unreadable hash generated by EncryptKey into a readable string.
38285>>>>>    //
38285>>>>>    // Params:
38285>>>>>    //   sBase64EncryptedPassword       Base64 Encrypted password
38285>>>>>    // Returns:
38285>>>>>    //   Readable plain text password
38285>>>>>    Function DecryptPassword String sBase64EncryptedPassword Returns String
38287>>>>>        String sEncryptPassword
38287>>>>>        UChar[] ucBinary ucPlain
38289>>>>>        Boolean bIsHex
38289>>>>>        Integer iLen iVoid
38289>>>>>        Pointer pBinary
38289>>>>>        
38289>>>>>        If (sBase64EncryptedPassword <> "") Begin
38291>>>>>            //  Decode from Base64
38291>>>>>            Move (Base64Decode(AddressOf(sBase64EncryptedPassword), &iLen)) to pBinary
38292>>>>>            
38292>>>>>            Move (ResizeArray(ucBinary, iLen, 0)) to ucBinary
38293>>>>>            Move (MemCopy(AddressOf(ucBinary), pBinary, iLen)) to iVoid
38294>>>>>                        
38294>>>>>            Move (Free(pBinary)) to iVoid
38295>>>>>            
38295>>>>>            //  Encrypted binary hash to string
38295>>>>>            Get GetEncryptionPassword to sEncryptPassword
38296>>>>>            Get Decrypt of oDataCrypter (StringToUCharArray(sEncryptPassword)) ucBinary to ucPlain
38297>>>>>        End
38297>>>>>>
38297>>>>>        
38297>>>>>        Function_Return (UCharArrayToString(ucPlain))
38298>>>>>    End_Function
38299>>>>>End_Class
38300>>>
