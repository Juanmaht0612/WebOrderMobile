44463>>>>>>>    // Drag Drop
44463>>>>>>>    Function DropData Returns Variant
44465>>>>>>>        tWebWidgetContainerDropData DropData
44465>>>>>>>        tWebWidgetContainerDropData DropData
44465>>>>>>>        Handle hoJsonData
44465>>>>>>>        
44465>>>>>>>        Get phoJsonDropData to hoJsonData
44466>>>>>>>        
44466>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject and IsOfJsonType(hoJsonData, jsonTypeObject)) Begin
44468>>>>>>>            Set pbRequireAllMembers of hoJsonData to False
44469>>>>>>>            Get JsonToDataType of hoJsonData to DropData
44470>>>>>>>        End
44470>>>>>>>>
44470>>>>>>>        
44470>>>>>>>        Function_Return DropData
44471>>>>>>>    End_Function
44472>>>>>>>    
44472>>>>>>>    
44472>>>>>>>    // --- Data binding for widgets
44472>>>>>>>    
44472>>>>>>>    // Attempt to Sync DDO's for widget
44472>>>>>>>    // Checks if caller is allowed access to this widget
44472>>>>>>>    // 0 : Default response (usually means object is not a cWebWidget) - Code will continue as normal, but no sync is performed
44472>>>>>>>    // -1: Access denied - Will destroy the associated widget
44472>>>>>>>    // 1 : Access granted - triggers sync
44472>>>>>>>    Function SyncDynamicDDOs Handle hoDynamicObj Returns Integer
44474>>>>>>>        Boolean bIsWidget bAllowed
44474>>>>>>>        
44474>>>>>>>        Get IsObjectOfClass of hoDynamicObj (RefClass(cWebWidget)) to bIsWidget
44475>>>>>>>        
44475>>>>>>>        If (bIsWidget) Begin
44477>>>>>>>            Get AllowViewAccess of (Host(Self)) hoDynamicObj to bAllowed
44478>>>>>>>            If (bAllowed) Begin
44480>>>>>>>                Send Call_PreSync of hoDynamicObj
