45813>>>>>>>>>    Function CountDaysToTotalWeeks DateTime dtStart DateTime dtEnd Returns Integer
45815>>>>>>>>>        Integer iDaysBetween iWeeks
45815>>>>>>>>>        
45815>>>>>>>>>        If (dtStart > dtEnd) Begin
45817>>>>>>>>>            Function_Return -1
45818>>>>>>>>>        End
45818>>>>>>>>>>
45818>>>>>>>>>        
45818>>>>>>>>>        Move 0 to iWeeks
45819>>>>>>>>>        
45819>>>>>>>>>        Get TotalDaysBetweenDates dtStart dtEnd to iDaysBetween  
45820>>>>>>>>>        Move (iDaysBetween / 7) to iWeeks             
45821>>>>>>>>>    
45821>>>>>>>>>        Function_Return iWeeks
45822>>>>>>>>>    End_Function
45823>>>>>>>>>
45823>>>>>>>>>    Function TotalDaysBetweenDates DateTime dtStart DateTime dtEnd Returns Integer
45825>>>>>>>>>        Integer iDays
45825>>>>>>>>>        DateTime dtTemp
45825>>>>>>>>>    
45825>>>>>>>>>        If (dtStart > dtEnd) Begin
45827>>>>>>>>>            Function_Return -1
45828>>>>>>>>>        End
45828>>>>>>>>>>
45828>>>>>>>>>    
45828>>>>>>>>>        Move 0 to iDays
45829>>>>>>>>>        Move dtStart to dtTemp
45830>>>>>>>>>        While (dtTemp < dtEnd) 
45834>>>>>>>>>            Increment iDays
45835>>>>>>>>>            Move (DateAddDay (dtTemp, 1)) to dtTemp
45836>>>>>>>>>        Loop
45837>>>>>>>>>>
45837>>>>>>>>>    
45837>>>>>>>>>        Function_Return iDays
45838>>>>>>>>>    End_Function   
45839>>>>>>>>>
45839>>>>>>>>>    Function TotalMonthsBetween DateTime dtStart DateTime dtEnd Returns Integer
45841>>>>>>>>>        Integer iYearStart iYearEnd iMonthStart iMonthEnd iNumYears iNumMonths iDayStart iDayEnd iMonths
45841>>>>>>>>>        Boolean bStartEOM bEndEOM
45841>>>>>>>>>    
45841>>>>>>>>>        If (dtStart > dtEnd) Begin
45843>>>>>>>>>            Function_Return -1
45844>>>>>>>>>        End
45844>>>>>>>>>>
45844>>>>>>>>>        
45844>>>>>>>>>        Move (DateGetYear (dtEnd)) to iYearEnd
45845>>>>>>>>>        Move (DateGetYear (dtStart)) to iYearStart
45846>>>>>>>>>        Move (iYearEnd - iYearStart) to iNumYears
45847>>>>>>>>>        
45847>>>>>>>>>        Move (iNumYears * 12) to iNumMonths
45848>>>>>>>>>        
45848>>>>>>>>>        Move (DateGetMonth (dtEnd)) to iMonthEnd
45849>>>>>>>>>        Move (DateGetMonth (dtStart)) to iMonthStart
45850>>>>>>>>>        If (iMonthStart <> iMonthEnd) Begin
45852>>>>>>>>>            Move (iMonthEnd - iMonthStart) to iMonths    
45853>>>>>>>>>            Move (iNumMonths + iMonths) to iNumMonths
45854>>>>>>>>>        End
45854>>>>>>>>>>
45854>>>>>>>>>        
45854>>>>>>>>>        Move (DateGetDay (dtStart)) to iDayStart
45855>>>>>>>>>        Move (DateGetDay (dtEnd)) to iDayEnd
45856>>>>>>>>>        If (iDayStart > iDayEnd) Begin 
45858>>>>>>>>>            Get IsEndOfMonth dtStart to bStartEOM
45859>>>>>>>>>            Get IsEndOfMonth dtEnd to bEndEOM
45860>>>>>>>>>            If (not(bStartEOM and bEndEOM)) Begin
45862>>>>>>>>>               Decrement iNumMonths 
45863>>>>>>>>>            End
45863>>>>>>>>>>
45863>>>>>>>>>        End                
45863>>>>>>>>>>
45863>>>>>>>>>        
45863>>>>>>>>>        Function_Return iNumMonths
45864>>>>>>>>>    End_Function
45865>>>>>>>>>    
45865>>>>>>>>>    Function TotalWeeksBetween DateTime dtStart DateTime dtEnd Returns Integer
45867>>>>>>>>>        TimeSpan tsDaysBetween
45867>>>>>>>>>        Real rNumDays
45867>>>>>>>>>        Integer iWeeks
45867>>>>>>>>>        
45867>>>>>>>>>        If (dtStart > dtEnd) Begin
45869>>>>>>>>>            Function_Return -1
45870>>>>>>>>>        End
45870>>>>>>>>>>
45870>>>>>>>>>        
45870>>>>>>>>>        Move 0 to iWeeks
45871>>>>>>>>>        
45871>>>>>>>>>        // limited to 65,535 days ~ 180 years
45871>>>>>>>>>        Move (dtEnd - dtStart) to tsDaysBetween 
45872>>>>>>>>>        Move (SpanTotalDays (tsDaysBetween)) to rNumDays
45873>>>>>>>>>        Move (Round (rNumDays) / 7) to iWeeks          
45874>>>>>>>>>    
45874>>>>>>>>>        Function_Return iWeeks
45875>>>>>>>>>    End_Function
45876>>>>>>>>>
45876>>>>>>>>>    Function TotalYearsBetween DateTime dtStart DateTime dtEnd Returns Integer
45878>>>>>>>>>        Integer iYearStart iYearEnd iMonthStart iMonthEnd iDayStart iDayEnd iNumYears
45878>>>>>>>>>    
45878>>>>>>>>>        If (dtStart > dtEnd) Begin
45880>>>>>>>>>            Function_Return -1
45881>>>>>>>>>        End
45881>>>>>>>>>>
45881>>>>>>>>>        
45881>>>>>>>>>        Move (DateGetYear (dtEnd)) to iYearEnd
45882>>>>>>>>>        Move (DateGetYear (dtStart)) to iYearStart
45883>>>>>>>>>        
45883>>>>>>>>>        Move (iYearEnd - iYearStart) to iNumYears
45884>>>>>>>>>        
45884>>>>>>>>>        If (iNumYears > 0) Begin
45886>>>>>>>>>            Move (DateGetMonth (dtStart)) to iMonthStart
45887>>>>>>>>>            Move (DateGetMonth (dtEnd)) to iMonthEnd
45888>>>>>>>>>            If (iMonthStart = iMonthEnd) Begin
45890>>>>>>>>>                Move (DateGetDay (dtStart)) to iDayStart
45891>>>>>>>>>                Move (DateGetDay (dtEnd)) to iDayEnd
45892>>>>>>>>>                If (iDayStart > iDayEnd) Begin 
45894>>>>>>>>>                    Decrement iNumYears
45895>>>>>>>>>                End
45895>>>>>>>>>>
45895>>>>>>>>>            End
45895>>>>>>>>>>
45895>>>>>>>>>            Else Begin
45896>>>>>>>>>                If (iMonthStart > iMonthEnd) Begin
45898>>>>>>>>>                    Decrement iNumYears
45899>>>>>>>>>                End
45899>>>>>>>>>>
45899>>>>>>>>>            End
45899>>>>>>>>>>
45899>>>>>>>>>        End
45899>>>>>>>>>>
45899>>>>>>>>>        
45899>>>>>>>>>        Function_Return iNumYears
45900>>>>>>>>>    End_Function
45901>>>>>>>>>
45901>>>>>>>>>    Function StartDateFirstWeekOfYear Integer iYear Returns DateTime
45903>>>>>>>>>        DateTime dtJan1 dtResult dtResult2
45903>>>>>>>>>        Integer iWeekDayStart iWeekDay eFirstWeekOfYearType
45903>>>>>>>>>
45903>>>>>>>>>        Get MondayOfWeekYear 1 iYear to dtResult2
45904>>>>>>>>>
45904>>>>>>>>>        // Construct January 1st for the passed year
45904>>>>>>>>>        Move (DateSetYear (dtJan1, iYear)) to dtJan1
45905>>>>>>>>>        Move (DateSetMonth (dtJan1, 1)) to dtJan1
45906>>>>>>>>>        Move (DateSetDay (dtJan1, 1)) to dtJan1
45907>>>>>>>>>
45907>>>>>>>>>        Get FirstDayOfWeek to iWeekDayStart // 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday
45908>>>>>>>>>        // Correct for the fact that the DateGetDayOfWeek_WDS uses 1=Sunday, 2=Monday, 3=Tuesday, 4=Wednesday, 5=Thursday, 6=Friday, 7=Saturday
45908>>>>>>>>>        If (iWeekDayStart = 6) Begin
45910>>>>>>>>>            Move 1 to iWeekDayStart
45911>>>>>>>>>        End
45911>>>>>>>>>>
45911>>>>>>>>>        Else Begin
45912>>>>>>>>>            Move (iWeekDayStart + 2) to iWeekDayStart
45913>>>>>>>>>        End
45913>>>>>>>>>>
45913>>>>>>>>>        Move (DateGetDayofWeek_WDS (dtJan1, iWeekDayStart)) to iWeekDay
45914>>>>>>>>>
45914>>>>>>>>>        // Find out how to determine what is the first week of the year.
45914>>>>>>>>>        // ISO 8601 defines this as that the dirst week containing at least four days is the first week of the year.
45914>>>>>>>>>        Get FirstWeekOfYear to eFirstWeekOfYearType
45915>>>>>>>>>        Case Begin
45915>>>>>>>>>            Case (eFirstWeekOfYearType = 0)
45917>>>>>>>>>                Move dtJan1 to dtResult
45918>>>>>>>>>                Case Break
45919>>>>>>>>>            Case (eFirstWeekOfYearType = 1)
45922>>>>>>>>>                If (iWeekDay > 1) Begin
45924>>>>>>>>>                    Move (DateAddDay (dtJan1, 7 - iWeekDay)) to dtResult
45925>>>>>>>>>                End
45925>>>>>>>>>>
45925>>>>>>>>>                Else Begin
45926>>>>>>>>>                    Move dtJan1 to dtResult
45927>>>>>>>>>                End
45927>>>>>>>>>>
45927>>>>>>>>>                Case Break
45928>>>>>>>>>            Case (eFirstWeekOfYearType = 2)
45931>>>>>>>>>                If (iWeekDay <> 1) Begin
45933>>>>>>>>>                    Move (DateAddDay (dtJan1, 7)) to dtResult
45934>>>>>>>>>                End
45934>>>>>>>>>>
45934>>>>>>>>>                Else Begin
45935>>>>>>>>>                    Move dtJan1 to dtResult
45936>>>>>>>>>                End
45936>>>>>>>>>>
45936>>>>>>>>>                Move (DateGetDayofWeek_WDS (dtResult, iWeekDayStart)) to iWeekDay
45937>>>>>>>>>                Move (DateAddDay (dtResult, 1 - iWeekDay)) to dtResult
45938>>>>>>>>>                Case Break
45939>>>>>>>>>        Case End
45939>>>>>>>>>
45939>>>>>>>>>        Function_Return dtResult
45940>>>>>>>>>    End_Function
