39111>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
39113>>>>>>>        Boolean bRequireTimeCost
39113>>>>>>>        UBigInt ullSize
39113>>>>>>>        UChar[] ucaSalt
39114>>>>>>>        String sSalt
39114>>>>>>>        
39114>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
39115>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
39116>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
39119>>>>>>>        
39119>>>>>>>        Case Begin
39119>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
39121>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
39122>>>>>>>                Move True to bRequireTimeCost
39123>>>>>>>                Case Break
39124>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
39127>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
39128>>>>>>>                Move True to bRequireTimeCost
39129>>>>>>>                Case Break
39130>>>>>>>            Case Else
39130>>>>>>>                Error 8710 "Invalid algorithm selected."
39131>>>>>>>>
39131>>>>>>>                Function_Return 0
39132>>>>>>>        Case End
39132>>>>>>>        
39132>>>>>>>        // calculate base64 in a non-floating-manner
39132>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
39133>>>>>>>        
39133>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
39134>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
39135>>>>>>>        If (bRequireTimeCost) Begin
39137>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
39138>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
39139>>>>>>>        End
39139>>>>>>>>
39139>>>>>>>        Else Begin
39140>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
39141>>>>>>>        End
39141>>>>>>>>
39141>>>>>>>        
39141>>>>>>>        Function_Return ullSize
39142>>>>>>>    End_Function
39143>>>>>>>End_Class
