25729>>>>>>>>>>>    Function GetAccessible Returns Integer
25731>>>>>>>>>>>        Integer iAccessible iAccessibleParent
25731>>>>>>>>>>>        Boolean bVal
25731>>>>>>>>>>>        
25731>>>>>>>>>>>        If (piAccessibilityCacheCall(Self) <> giWebAccCacheCtx) Begin
25733>>>>>>>>>>>            Move C_UIA_InSync to iAccessible
25734>>>>>>>>>>>            
25734>>>>>>>>>>>            If (pbNoAccessibilityCheck(Self)) Begin
25736>>>>>>>>>>>               Move C_UIA_All to iAccessible
25737>>>>>>>>>>>            End
25737>>>>>>>>>>>>
25737>>>>>>>>>>>            Else Begin
25738>>>>>>>>>>>                WebGet pbRender to bVal
25739>>>>>>>>>>>                If (bVal) ;                    Move (iAccessible + C_UIA_Rendered) to iAccessible
25742>>>>>>>>>>>                
25742>>>>>>>>>>>                Move (iAccessible + C_UIA_Visible) to iAccessible
25743>>>>>>>>>>>                
25743>>>>>>>>>>>                WebGet pbEnabled to bVal
25744>>>>>>>>>>>                If (bVal) ;                    Move (iAccessible + C_UIA_Enabled) to iAccessible
25747>>>>>>>>>>>            End
25747>>>>>>>>>>>>
25747>>>>>>>>>>>            
25747>>>>>>>>>>>            Delegate Get GetAccessible to iAccessibleParent
25749>>>>>>>>>>>            Move (iAccessibleParent iand iAccessible) to iAccessible
25750>>>>>>>>>>>            
25750>>>>>>>>>>>            Set piAccessibilityCache to iAccessible
25751>>>>>>>>>>>            Set piAccessibilityCacheCall to giWebAccCacheCtx
25752>>>>>>>>>>>        End
25752>>>>>>>>>>>>
25752>>>>>>>>>>>        Else Begin
25753>>>>>>>>>>>            Get piAccessibilityCache to iAccessible
25754>>>>>>>>>>>        End
25754>>>>>>>>>>>>
25754>>>>>>>>>>>        
25754>>>>>>>>>>>        Function_Return iAccessible
25755>>>>>>>>>>>    End_Function
