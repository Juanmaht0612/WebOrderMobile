56398>>>>>
56398>>>>>        Get OpenReport to sReportId
56399>>>>>        If (sReportId <> "") Begin
56401>>>>>            Get NamedValueGet NamedValues "ExportFormat" to sExportFormat
56402>>>>>            Get NamedValueGet NamedValues "AllPages" to bAllPages
56403>>>>>
56403>>>>>            Case Begin
56403>>>>>                Case (sExportFormat = "HTML")
56405>>>>>                    Set pbHTMLMultiPage to False
56406>>>>>                    If (not (bAllPages)) Begin
56408>>>>>                        Get NamedValueIndex NamedValues "PageNumber" to iIndex
56409>>>>>                        If (iIndex > -1) Begin
56411>>>>>                            Set piHTMLPage to NamedValues[iIndex].sValue
56412>>>>>                        End
56412>>>>>>
56412>>>>>                        Get ReportCacheFileName ".html" to sFileNames[0]
56413>>>>>                    End
56413>>>>>>
56413>>>>>                    Else Begin
56414>>>>>                        Get ExportFileNamesSet "html" -1 to sFileNames
56415>>>>>                    End
56415>>>>>>
56415>>>>>                    Move C_drHTML to eType
56416>>>>>                    Case Break
56417>>>>>                Case (sExportFormat = "TIFF")
56420>>>>>                    Set peImageExportType to C_drTIFF
56421>>>>>                    If (not (bAllPages)) Begin
56423>>>>>                        Get NamedValueIndex NamedValues "PageNumber" to iIndex
56424>>>>>                        If (iIndex > -1) Begin
56426>>>>>                            Move NamedValues[iIndex].sValue to iPage
56427>>>>>                            Set piImageExportPage to iPage
56428>>>>>                        End
56428>>>>>>
56428>>>>>                        Else Begin
56429>>>>>                            Get piImageExportPage to iPage
56430>>>>>                        End
56430>>>>>>
56430>>>>>                        Get ExportFileNamesSet "tiff" iPage to sFileNames
56431>>>>>                        Set pbImageExportMultiPage to False
56432>>>>>                    End
56432>>>>>>
56432>>>>>                    Else Begin
56433>>>>>                        Get ReportCacheFileName ".tiff" to sFileNames[0]
56434>>>>>                    End
56434>>>>>>
56434>>>>>                    Move C_drImage to eType
56435>>>>>                    Case Break
56436>>>>>                Case (sExportFormat = "GIF")
56439>>>>>                    Set pbImageExportMultiPage to False
56440>>>>>                    Set peImageExportType to C_drGIF
56441>>>>>                    If (not (bAllPages)) Begin
56443>>>>>                        Get NamedValueIndex NamedValues "PageNumber" to iIndex
56444>>>>>                        If (iIndex > -1) Begin
56446>>>>>                            Move NamedValues[iIndex].sValue to iPage
56447>>>>>                            Set piImageExportPage to iPage
56448>>>>>                        End
56448>>>>>>
