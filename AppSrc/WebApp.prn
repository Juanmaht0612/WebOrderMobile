45355>>>>>>>>>>>Class cMathHandler is a cObject
45356>>>>>>>>>>>    Function Ceiling Float fIn Returns Integer
45358>>>>>>>>>>>        Integer iResult
45358>>>>>>>>>>>
45358>>>>>>>>>>>        If (fIn < 0.0) Begin
45360>>>>>>>>>>>            Move (Integer (fIn)) to iResult
45361>>>>>>>>>>>        End
45361>>>>>>>>>>>>
45361>>>>>>>>>>>        Else Begin
45362>>>>>>>>>>>            Move (Integer (fIn) + 1) to iResult
45363>>>>>>>>>>>        End
45363>>>>>>>>>>>>
45363>>>>>>>>>>>
45363>>>>>>>>>>>        Function_Return iResult
45364>>>>>>>>>>>    End_Function
45365>>>>>>>>>>>
45365>>>>>>>>>>>    Function Floor Float fIn Returns Integer
45367>>>>>>>>>>>        Integer iResult
45367>>>>>>>>>>>
45367>>>>>>>>>>>        If (fIn < 0.0) Begin
45369>>>>>>>>>>>            Move (Integer (fIn) - 1) to iResult
45370>>>>>>>>>>>        End
45370>>>>>>>>>>>>
45370>>>>>>>>>>>        Else Begin
45371>>>>>>>>>>>            Move (Integer (fIn)) to iResult
45372>>>>>>>>>>>        End
45372>>>>>>>>>>>>
45372>>>>>>>>>>>
45372>>>>>>>>>>>        Function_Return iResult
45373>>>>>>>>>>>    End_Function
45374>>>>>>>>>>>End_Class
