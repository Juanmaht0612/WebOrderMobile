31470>>>>>>>>>            // These messages were just added to the DD.
31470>>>>>>>>>            Get Extended_Error_file   of ghoErrorSource to iErrFile
31471>>>>>>>>>            Get Extended_Error_Field  of ghoErrorSource to iErrField
31472>>>>>>>>>            // we are making the assumption that ghoErrorSource is a DD object
31472>>>>>>>>>            // If it is not, we will have problems.....but it will be!
31472>>>>>>>>>            If (iErrFile>0) Begin
31474>>>>>>>>>                Get_Attribute DF_FILE_DISPLAY_NAME of iErrFile to sFile
31477>>>>>>>>>                If (iErrField>0) Begin
31479>>>>>>>>>                    Get File_Field_Label of ghoErrorSource iErrFile iErrField DD_LABEL_LONG to sLabel
31480>>>>>>>>>                    Move (SFormat(C_$FieldInDataFile,sLabel, sFile)) to sMess
31481>>>>>>>>>                End
31481>>>>>>>>>>
31481>>>>>>>>>                Else Begin
31482>>>>>>>>>                    Move (SFormat(C_$InDataFile,sFile)) to sMess
31483>>>>>>>>>                End
31483>>>>>>>>>>
31483>>>>>>>>>                Append sSystemErr "\n" sMess
31485>>>>>>>>>            End
31485>>>>>>>>>>
31485>>>>>>>>>        End
31485>>>>>>>>>>
31485>>>>>>>>>        
31485>>>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iError, iLine)) to sDtl
31486>>>>>>>>>        If (iErrFile  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iErrFile))  to sDtl
31489>>>>>>>>>        If (iErrField > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iErrField)) to sDtl
31492>>>>>>>>>        // full error is systemError + Error and line numbers
31492>>>>>>>>>        Move (sSystemErr + "\n" + sDtl) to sFullError
31493>>>>>>>>>        
31493>>>>>>>>>        // If 0, the COM object is not yet ready to be used. If an error occurs in this
