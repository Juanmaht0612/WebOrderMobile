24272>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForDD Handle hoCurrentDD Handle hoTargetDD Integer iTargetField String sSearchValue Returns String
24274>>>>>>>>>>>>>>>>>>>        Integer iCurrentFile iTargetFile
24274>>>>>>>>>>>>>>>>>>>        String sFilter
24274>>>>>>>>>>>>>>>>>>>        Boolean bSupportsLike
24274>>>>>>>>>>>>>>>>>>>
24274>>>>>>>>>>>>>>>>>>>        If (hoCurrentDD = 0 or hoTargetDD = 0 or iTargetField = 0) Function_Return ""
24277>>>>>>>>>>>>>>>>>>>
24277>>>>>>>>>>>>>>>>>>>        Get Main_File of hoCurrentDD to iCurrentFile
24278>>>>>>>>>>>>>>>>>>>        Get Main_File of hoTargetDD to iTargetFile
24279>>>>>>>>>>>>>>>>>>>
24279>>>>>>>>>>>>>>>>>>>        If (iCurrentFile <> iTargetFile) Function_Return ""
24282>>>>>>>>>>>>>>>>>>>
24282>>>>>>>>>>>>>>>>>>>        Get FieldSupportsFilterLike iTargetFile iTargetField to bSupportsLike
24283>>>>>>>>>>>>>>>>>>>        If (not(bSupportsLike)) Function_Return ""
24286>>>>>>>>>>>>>>>>>>>
24286>>>>>>>>>>>>>>>>>>>        Get SQLStrLike of hoCurrentDD iTargetField sSearchValue to sFilter
24287>>>>>>>>>>>>>>>>>>>
24287>>>>>>>>>>>>>>>>>>>        Function_Return sFilter
24288>>>>>>>>>>>>>>>>>>>    End_Function
24289>>>>>>>>>>>>>>>>>>>
24289>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForField Handle hoReadingDD Integer iFile Integer iField String sSearchValue Returns String
24291>>>>>>>>>>>>>>>>>>>        String sColumnFilter
24291>>>>>>>>>>>>>>>>>>>        Handle hoColumnDD
24291>>>>>>>>>>>>>>>>>>>
24291>>>>>>>>>>>>>>>>>>>        If (hoReadingDD = 0 or sSearchValue = "" or iFile = 0 or iField = 0) Function_Return ""
24294>>>>>>>>>>>>>>>>>>>
24294>>>>>>>>>>>>>>>>>>>        Get Which_Data_Set of hoReadingDD iFile to hoColumnDD
24295>>>>>>>>>>>>>>>>>>>        If (hoColumnDD = 0) Function_Return ""
24298>>>>>>>>>>>>>>>>>>>
24298>>>>>>>>>>>>>>>>>>>        Get BuildFilterExpressionForDD hoReadingDD hoColumnDD iField sSearchValue to sColumnFilter
24299>>>>>>>>>>>>>>>>>>>        If (sColumnFilter <> "") Begin
24301>>>>>>>>>>>>>>>>>>>            Move ("(" + sColumnFilter + ")") to sColumnFilter
24302>>>>>>>>>>>>>>>>>>>        End
24302>>>>>>>>>>>>>>>>>>>>
24302>>>>>>>>>>>>>>>>>>>
24302>>>>>>>>>>>>>>>>>>>        Function_Return sColumnFilter
24303>>>>>>>>>>>>>>>>>>>    End_Function
24304>>>>>>>>>>>>>>>>>>>
24304>>>>>>>>>>>>>>>>>>>    Function BuildFilterExpressionForFields Handle hoReadingDD Integer[] iaFiles Integer[] iaFields String sSearchValue Returns String
24306>>>>>>>>>>>>>>>>>>>        Integer iCount iFile iField
24306>>>>>>>>>>>>>>>>>>>        String sFilter sColumnFilter
24306>>>>>>>>>>>>>>>>>>>
24306>>>>>>>>>>>>>>>>>>>        If (hoReadingDD = 0 or sSearchValue = "") Function_Return ""
24309>>>>>>>>>>>>>>>>>>>
24309>>>>>>>>>>>>>>>>>>>        For iCount from 0 to (SizeOfArray(iaFiles) - 1)
24315>>>>>>>>>>>>>>>>>>>>
24315>>>>>>>>>>>>>>>>>>>            Move iaFiles[iCount] to iFile
24316>>>>>>>>>>>>>>>>>>>            Move iaFields[iCount] to iField
24317>>>>>>>>>>>>>>>>>>>
24317>>>>>>>>>>>>>>>>>>>            Get BuildFilterExpressionForField hoReadingDD iFile iField sSearchValue to sColumnFilter
24318>>>>>>>>>>>>>>>>>>>            If (sColumnFilter <> "") Begin
24320>>>>>>>>>>>>>>>>>>>                If (sFilter <> "") Begin
24322>>>>>>>>>>>>>>>>>>>                    Move (sFilter + " OR ") to sFilter
24323>>>>>>>>>>>>>>>>>>>                End
24323>>>>>>>>>>>>>>>>>>>>
24323>>>>>>>>>>>>>>>>>>>                Move (sFilter + sColumnFilter) to sFilter
24324>>>>>>>>>>>>>>>>>>>            End
24324>>>>>>>>>>>>>>>>>>>>
24324>>>>>>>>>>>>>>>>>>>        Loop
24325>>>>>>>>>>>>>>>>>>>>
24325>>>>>>>>>>>>>>>>>>>
24325>>>>>>>>>>>>>>>>>>>        If (sFilter <> "") Begin
24327>>>>>>>>>>>>>>>>>>>            Move ("(" + sFilter + ")") to sFilter
24328>>>>>>>>>>>>>>>>>>>        End
24328>>>>>>>>>>>>>>>>>>>>
24328>>>>>>>>>>>>>>>>>>>
24328>>>>>>>>>>>>>>>>>>>        Function_Return sFilter
24329>>>>>>>>>>>>>>>>>>>    End_Function
24330>>>>>>>>>>>>>>>>>>>
24330>>>>>>>>>>>>>>>>>>>    Function BuildAndAppendFilterExpression Handle hoDD Integer[] iaFiles Integer[] iaFields String sSearchValue String sOrigFilter Returns String
24332>>>>>>>>>>>>>>>>>>>        String sSearchFilter sFilter
24332>>>>>>>>>>>>>>>>>>>
24332>>>>>>>>>>>>>>>>>>>        If (hoDD = 0) Function_Return sOrigFilter
24335>>>>>>>>>>>>>>>>>>>
