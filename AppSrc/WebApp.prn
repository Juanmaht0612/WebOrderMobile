24386>>>>>>>>>>>>>>>>>        Property Integer piFindIndex 0
24387>>>>>>>>>>>>>>>>>        
24387>>>>>>>>>>>>>>>>>        Property Boolean pbAutoCreate False
24388>>>>>>>>>>>>>>>>>        
24388>>>>>>>>>>>>>>>>>        Property Boolean pbAllData False
24389>>>>>>>>>>>>>>>>>        Property Boolean pbSuggestions False
24390>>>>>>>>>>>>>>>>>        Property Boolean pbPaged False
24391>>>>>>>>>>>>>>>>>        
24391>>>>>>>>>>>>>>>>>        Property Integer[] piaDataFiles
24392>>>>>>>>>>>>>>>>>        Property Integer[] piaDataFields
