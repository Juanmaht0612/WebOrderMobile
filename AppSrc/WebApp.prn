45591>>>>>>>>>    Function IsEndOfMonth DateTime dtDate Returns Boolean
45593>>>>>>>>>        Integer iYear iMonth iDay iDaysInMonth
45593>>>>>>>>>    
45593>>>>>>>>>        // Get the year, month, and day from the date
45593>>>>>>>>>        Move (DateGetYear (dtDate)) to iYear
45594>>>>>>>>>        Move (DateGetMonth (dtDate)) to iMonth
45595>>>>>>>>>        Move (DateGetDay (dtDate)) to iDay
45596>>>>>>>>>    
45596>>>>>>>>>        // Get the number of days in the month
45596>>>>>>>>>        Get NumberDaysInMonth iYear iMonth to iDaysInMonth
45597>>>>>>>>>    
45597>>>>>>>>>        Function_Return (iDay = iDaysInMonth)
45598>>>>>>>>>    End_Function
45599>>>>>>>>>
45599>>>>>>>>>    Function IsLeapYear Integer iYear Returns Boolean
45601>>>>>>>>>        Boolean bLeapYear
45601>>>>>>>>>        
45601>>>>>>>>>        Move False to bLeapYear
45602>>>>>>>>>        
45602>>>>>>>>>        If (Mod (iYear, 4) = 0) Begin
45604>>>>>>>>>            If (Mod (iYear, 100) = 0) Begin
45606>>>>>>>>>                If (Mod (iYear, 400) = 0) Begin
45608>>>>>>>>>                    Move True to bLeapYear
45609>>>>>>>>>                End
45609>>>>>>>>>>
45609>>>>>>>>>            End
45609>>>>>>>>>>
45609>>>>>>>>>            Else Begin
45610>>>>>>>>>                Move True to bLeapYear
45611>>>>>>>>>            End
45611>>>>>>>>>>
45611>>>>>>>>>        End
45611>>>>>>>>>>
45611>>>>>>>>>    
45611>>>>>>>>>        Function_Return bLeapYear
45612>>>>>>>>>    End_Function
45613>>>>>>>>>    
45613>>>>>>>>>    Function ISO8601WeekNumber Date dDateIn Returns Integer
45615>>>>>>>>>        DateTime dtFirstDayInYear dtLastDayInYear
45615>>>>>>>>>        Integer iDayOfYear iStartWeekDayOfYear iEndWeekDayOfYear iYear
45615>>>>>>>>>        Integer iDaysInFirstWeek iDaysInLastWeek iWeekNumber iFirstDayOfWeek iRetval
45615>>>>>>>>>        Boolean bWeek53Flag
45615>>>>>>>>>
45615>>>>>>>>>        // Get the day number since the beginning of the year
45615>>>>>>>>>        Move (DateGetDayOfYear (dDateIn)) to iDayOfYear
45616>>>>>>>>>
45616>>>>>>>>>        // Get the numeric weekday of the first day of the
45616>>>>>>>>>        // year (using sunday as FirstDay)
45616>>>>>>>>>        Move (DateSetDay (dDateIn, C_FIRSTDAYOFJAN)) to dtFirstDayInYear
45617>>>>>>>>>        Move (DateSetMonth (dtFirstDayInYear, C_FIRSTMONTHOFYEAR)) to dtFirstDayInYear
45618>>>>>>>>>        Move (DateGetDayOfWeek (dtFirstDayInYear)) to iStartWeekDayOfYear
45619>>>>>>>>>
45619>>>>>>>>>        // Get the numeric weekday of the last day of the
45619>>>>>>>>>        // year (using sunday as FirstDay). 1=Sunday, 2=Monday, 3=Tuesday, 4=Wednesday, 5=Thursday, 6=Friday, 7=Saturday
45619>>>>>>>>>        Move (DateSetDay (dDateIn, 28)) to dtLastDayInYear
45620>>>>>>>>>        Move (DateSetMonth (dtLastDayInYear, C_LASTMONTHOFYEAR)) to dtLastDayInYear
45621>>>>>>>>>        Move (DateSetDay (dtLastDayInYear, C_LASTDAYOFDEC)) to dtLastDayInYear
45622>>>>>>>>>        Move (DateGetDayOfWeek (dtLastDayInYear)) to iEndWeekDayOfYear
45623>>>>>>>>>
45623>>>>>>>>>        // Compensate for the fact that Windows might return a different day
45623>>>>>>>>>        // as the first day of the week (0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday)
45623>>>>>>>>>        // According to
45623>>>>>>>>>        Get FirstDayOfWeek to iFirstDayOfWeek
45624>>>>>>>>>        If (iFirstDayOfWeek <= 5) Begin
45626>>>>>>>>>            Move (iStartWeekDayOfYear - 1) to iStartWeekDayOfYear
45627>>>>>>>>>            Move (iEndWeekDayOfYear - 1) to iEndWeekDayOfYear
45628>>>>>>>>>        End
45628>>>>>>>>>>
45628>>>>>>>>>        Else Begin
45629>>>>>>>>>            Move (iStartWeekDayOfYear - 5) to iStartWeekDayOfYear
45630>>>>>>>>>            Move (iEndWeekDayOfYear - 5) to iEndWeekDayOfYear
45631>>>>>>>>>        End
45631>>>>>>>>>>
45631>>>>>>>>>
45631>>>>>>>>>        // Calculate the number of days in the first and last week
45631>>>>>>>>>        Move (8 - iStartWeekDayOfYear) to iDaysInFirstWeek
45632>>>>>>>>>        Move (8 - iEndWeekDayOfYear) to iDaysInLastWeek
45633>>>>>>>>>
45633>>>>>>>>>        // If the year either starts or ends on a
45633>>>>>>>>>        // thursday it will have a 53rd week
45633>>>>>>>>>        If (iStartWeekDayOfYear = C_THURSDAY or iEndWeekDayOfYear = C_THURSDAY) Begin
45635>>>>>>>>>            Move True to bWeek53Flag
45636>>>>>>>>>        End
45636>>>>>>>>>>
45636>>>>>>>>>
45636>>>>>>>>>        // We begin by calculating the number of FULL
45636>>>>>>>>>        // weeks between the start of the year and
45636>>>>>>>>>        // our date. The number is rounded up, so the
45636>>>>>>>>>        // smallest possible value is 0.
45636>>>>>>>>>        Move ((iDayOfYear - iDaysInFirstWeek) / 7.0) to iWeekNumber
45637>>>>>>>>>        If (Mod (iDayOfYear - iDaysInFirstWeek, 7) > 0) Begin
45639>>>>>>>>>            Increment iWeekNumber
45640>>>>>>>>>        End
45640>>>>>>>>>>
45640>>>>>>>>>
45640>>>>>>>>>        // If the first week of the year has at least four days,
45640>>>>>>>>>        // then the actual week number for our date
45640>>>>>>>>>        // can be incremented by one.
45640>>>>>>>>>        If (iDaysInFirstWeek >= C_THURSDAY) Begin
45642>>>>>>>>>            Increment iWeekNumber
45643>>>>>>>>>        End
45643>>>>>>>>>>
45643>>>>>>>>>
45643>>>>>>>>>        // If week number is larger than week 52 (and the year
45643>>>>>>>>>        // doesn't either start or end on a thursday)
45643>>>>>>>>>        // then the correct week number is 1.
45643>>>>>>>>>        If (iWeekNumber > 52 and (not (bWeek53Flag))) Begin
45645>>>>>>>>>            Move 1 to iWeekNumber
45646>>>>>>>>>        End
45646>>>>>>>>>>
45646>>>>>>>>>
45646>>>>>>>>>        // If week number is still 0, it means that we are trying
45646>>>>>>>>>        // to evaluate the week number for a week that belongs in the
45646>>>>>>>>>        // previous year (since that week has 3 days or less in our date's year).
45646>>>>>>>>>        // We therefore make a recursive call using the last day of
45646>>>>>>>>>        // the previous year.
45646>>>>>>>>>        If (iWeekNumber = 0) Begin
45648>>>>>>>>>            Move (DateGetYear (dtLastDayInYear)) to iYear
45649>>>>>>>>>            Move (DateSetYear (dtLastDayInYear, iYear - 1)) to dtLastDayInYear
45650>>>>>>>>>            Get ISO8601WeekNumber dtLastDayInYear to iWeekNumber
45651>>>>>>>>>        End
45651>>>>>>>>>>
45651>>>>>>>>>
45651>>>>>>>>>        Function_Return iWeekNumber
45652>>>>>>>>>    End_Function
45653>>>>>>>>>
45653>>>>>>>>>    Function JavaScriptTimeToLocalDateTime BigInt biMilliSeconds Returns DateTime
45655>>>>>>>>>        DateTime dtResult
45655>>>>>>>>>        tWinSystemTime stResult
45655>>>>>>>>>        tWinSystemTime stResult
45655>>>>>>>>>        tTimeZoneInformation tzInfo
45655>>>>>>>>>        tTimeZoneInformation tzInfo
45655>>>>>>>>>
45655>>>>>>>>>        Move 1/1/1970 to dtResult
45656>>>>>>>>>        Move (DateAddMillisecond (dtResult, biMilliSeconds)) to dtResult
45657>>>>>>>>>
45657>>>>>>>>>        Get DateTimeToSystemTime dtResult to stResult
45658>>>>>>>>>        Get TimeZoneInformation to tzInfo
45659>>>>>>>>>        Get SystemTimeToTzSpecificLocalTime tzInfo stResult to stResult
45660>>>>>>>>>        Get SystemTimeToDateTime stResult to dtResult
45661>>>>>>>>>
45661>>>>>>>>>        Function_Return dtResult
45662>>>>>>>>>    End_Function
