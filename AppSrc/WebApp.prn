37129>>>>>>>    // Marks the given dynamic object as rendered client-side.
37129>>>>>>>    Procedure SetRendered String sDynamicObjectId Boolean bRendered tWebDynamicObject[] ByRef aDynamicObjects Boolean bChildren 
37131>>>>>>>        Integer iObjectIndex iChild icChildren
37131>>>>>>>        tWebDynamicObject tDynamicObject
37131>>>>>>>        tWebDynamicObject tDynamicObject
37131>>>>>>>        
