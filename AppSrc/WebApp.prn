30524>>>>>>>>>    // Performs a logout and a reset of the session. May trigger a login if one is required.
30524>>>>>>>>>    Procedure RequestLogout
30526>>>>>>>>>        Boolean bValid
30526>>>>>>>>>        Integer eLoginMode eAppStateMode 
30526>>>>>>>>>        String sStateHash
30526>>>>>>>>>        Handle hoWebApp
30526>>>>>>>>>        
30526>>>>>>>>>        Get Host to hoWebApp
30527>>>>>>>>>        
30527>>>>>>>>>        //  We end the session and create a new one (so the user is logged out)
30527>>>>>>>>>        Send EndSession // close the current session key
30528>>>>>>>>>        Get RecreateSession of hoWebApp to bValid
30529>>>>>>>>>        
30529>>>>>>>>>        //  Now we try to 
30529>>>>>>>>>        Get LoginMode to eLoginMode
30530>>>>>>>>>        
30530>>>>>>>>>        If (eLoginMode = lmLoginRequired) Begin
30532>>>>>>>>>            Get peApplicationStateMode to eAppStateMode
30533>>>>>>>>>            
30533>>>>>>>>>            //  If history management is used we add an entry for the default view, and then refresh, so after login the user gets back to the dashboard
30533>>>>>>>>>            If (eAppStateMode <> asmOff) Begin
30535>>>>>>>>>                Send SetStateHash of hoWebApp "" "" False
30536>>>>>>>>>            End
30536>>>>>>>>>>
30536>>>>>>>>>
30536>>>>>>>>>            Send NavigateRefresh of hoWebApp          // refresh the WebApp at the client (triggers a login)
30537>>>>>>>>>        End
30537>>>>>>>>>>
30537>>>>>>>>>    End_Procedure
