31139>>>>>>>    //
31139>>>>>>>    // Loads the web properties from the property store and deserializes them.
31139>>>>>>>    //
31139>>>>>>>    Procedure LoadProps
31141>>>>>>>        String sKey
31141>>>>>>>        Boolean bResult
31141>>>>>>>        UChar[] ucPropData
31142>>>>>>>        tWebStoredProps props
31142>>>>>>>        tWebStoredProps props
31142>>>>>>>        Handle hoJsonParser hoServerPropStore
31142>>>>>>>        
31142>>>>>>>        Get ServerPropStore to hoServerPropStore
31143>>>>>>>        
31143>>>>>>>        If (hoServerPropStore = C_WebUnresolvedObject) Begin
31145>>>>>>>            Error DFERR_PROGRAM "Unable to WebGet / WebSet the server property. The phoWebServerPropStore is not initialized. The most likely cause is the WebAppServerProp table not being available."
31146>>>>>>>>
31146>>>>>>>            Procedure_Return
31147>>>>>>>        End
31147>>>>>>>>
31147>>>>>>>        
31147>>>>>>>        Get phoJsonParser to hoJsonParser
31148>>>>>>>        Get StoreKey to sKey
31149>>>>>>>        Get LoadPropValues of hoServerPropStore sKey (&ucPropData) to bResult
31150>>>>>>>        
31150>>>>>>>        If (bResult) Begin
31152>>>>>>>            Get ParseUtf8 of hoJsonParser ucPropData to bResult
31153>>>>>>>            If (bResult) Begin
31155>>>>>>>                Get JsonToDataType of hoJsonParser to props
31156>>>>>>>                
31156>>>>>>>                //  We do this to release the JSON structure in memory without destroying the object
31156>>>>>>>                Send InitializeJsonType of hoJsonParser jsonTypeNull
31157>>>>>>>            End
31157>>>>>>>>
31157>>>>>>>        End
31157>>>>>>>>
31157>>>>>>>        
31157>>>>>>>        Send InitializeSyncProps props.aProps props.aAdvProps
31158>>>>>>>        
31158>>>>>>>        Set pbChanged to False
31159>>>>>>>        Set pbLoaded to True
31160>>>>>>>    End_Procedure
