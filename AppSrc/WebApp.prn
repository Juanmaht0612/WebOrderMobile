30606>>>>>>>    // Adds a new client object to the set of listeners to NotifyChangeRights.
30606>>>>>>>    // This is only supported for object in the global scope, i.e. not supported
30606>>>>>>>    // for menus/toolbars declared inside a view.
30606>>>>>>>    // See also OnChangeRights.
30606>>>>>>>    Procedure AddChangeRightsClient Handle hoClient
30608>>>>>>>        Integer iPos
30608>>>>>>>        Handle[] aClients
30609>>>>>>>        
30609>>>>>>>        Get paChangeRightsClients to aClients
30610>>>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
30611>>>>>>>        
30611>>>>>>>        If (iPos = -1) Begin
30613>>>>>>>            Move (InsertInArray(aClients, BinarySearchInsertPos(), hoClient)) to aClients
30614>>>>>>>            Set paChangeRightsClients to aClients
30615>>>>>>>        End
30615>>>>>>>>
30615>>>>>>>    End_Procedure
30616>>>>>>>    
30616>>>>>>>    // Removes a new client object from the set of listeners to NotifyChangeRights.
30616>>>>>>>    Procedure RemoveChangeRightsClient Handle hoClient
30618>>>>>>>        Integer iPos
