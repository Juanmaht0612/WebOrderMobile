31161>>>>>>>    //
31161>>>>>>>    // Called when the webapp finished handlign a request. If the web properties where loaded and 
31161>>>>>>>    // changed it stores them. If they were loaded but not changed it gives the store a chance to
31161>>>>>>>    // unlock them.
31161>>>>>>>    //
31161>>>>>>>    Procedure FinishedCall tWebSyncProps[] ByRef aChangedSyncProps tWebAdvSyncProp[] ByRef aChangedAdvSyncProps
31163>>>>>>>        Boolean bLoaded bChanged
31163>>>>>>>        Integer iStoreIndex iSize iProp icProp
31163>>>>>>>        UChar[] ucPropData
31164>>>>>>>        String sKey
31164>>>>>>>        tWebStoredProps props
31164>>>>>>>        tWebStoredProps props
31164>>>>>>>        Handle hoJsonParser
31164>>>>>>>        
31164>>>>>>>        Get pbLoaded to bLoaded
31165>>>>>>>        
31165>>>>>>>        If (bLoaded) Begin
31167>>>>>>>            Get pbChanged to bChanged
31168>>>>>>>            Get piStoreIndex to iStoreIndex
31169>>>>>>>            Get phoJsonParser to hoJsonParser
31170>>>>>>>            Get StoreKey to sKey
31171>>>>>>>            If (bChanged) Begin
31173>>>>>>>                //  Get regular props (reduce size of array to actual size)
31173>>>>>>>                Get piSize to iSize
31174>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iSize)) to props.aProps
31175>>>>>>>                
31175>>>>>>>                //  Gather advanced sync props
31175>>>>>>>                Move (SizeOfArray(gaAdvSyncProps[iStoreIndex])) to icProp
31176>>>>>>>                Move (ResizeArray(props.aAdvProps, icProp)) to props.aAdvProps
31177>>>>>>>                For iProp from 0 to (icProp - 1)
31183>>>>>>>>
31183>>>>>>>                    Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp to props.aAdvProps[iProp]
31184>>>>>>>                Loop
31185>>>>>>>>
31185>>>>>>>                
31185>>>>>>>                Send DataTypeToJson of hoJsonParser props
31186>>>>>>>                Get StringifyUtf8 of hoJsonParser to ucPropData
31187>>>>>>>                
31187>>>>>>>                Send StorePropValues of (ServerPropStore(Self)) sKey (&ucPropData)
31188>>>>>>>            End
31188>>>>>>>>
31188>>>>>>>            Else Begin
31189>>>>>>>                Send ReleasePropValues of (ServerPropStore(Self)) sKey
31190>>>>>>>            End
31190>>>>>>>>
31190>>>>>>>            
31190>>>>>>>            Set pbLoaded to False
31191>>>>>>>        End
31191>>>>>>>>
31191>>>>>>>        
31191>>>>>>>        Forward Send FinishedCall (&aChangedSyncProps) (&aChangedAdvSyncProps)
31193>>>>>>>    End_Procedure
