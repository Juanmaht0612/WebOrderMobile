55688>>>>>    Procedure AutoLocateDFFiles String sReportId
55690>>>>>        Integer eDatabaseMainType iTables iTable iSubReports iSubReport
55690>>>>>        String sOpenPath sDatabaseName sTableSchema sReportName sSubReportId
55690>>>>>        Boolean bIsFileList bFileExists
55690>>>>>
55690>>>>>        Get DatabaseMainType sReportId to eDatabaseMainType
55691>>>>>        If (eDatabaseMainType = C_DRDF) Begin
55693>>>>>            Get_Attribute DF_OPEN_PATH to sOpenPath
55696>>>>>            Set psDatabaseConnection sReportId to sOpenPath
55697>>>>>
55697>>>>>            // This might the filelist or the first table name. If filelist we replace with the
55697>>>>>            // current filelist name. We find out if it is the filelist by calling a method
55697>>>>>            // IsFileList which Returns True when the file extension is .cfg.
55697>>>>>            Get psDatabaseName sReportId to sDatabaseName
55698>>>>>            Get IsFileList sDatabaseName to bIsFileList
55699>>>>>            If (bIsFileList) Begin
55701>>>>>                Get_Attribute DF_FILELIST_NAME to sDatabaseName
55704>>>>>                If (sDatabaseName <> "") Begin
55706>>>>>                    Set psDatabaseName sReportId to sDatabaseName
55707>>>>>                End
55707>>>>>>
55707>>>>>                Else Begin
55708>>>>>                    Error DFERR_CANT_OPEN_FILE_LIST
55709>>>>>>
55709>>>>>                End
55709>>>>>>
55709>>>>>            End
55709>>>>>>
55709>>>>>            Else Begin
55710>>>>>                File_Exist sDatabaseName bFileExists
55711>>>>>                If (not (bFileExists)) Begin
55713>>>>>                    Move (ExtractFileName (sDatabaseName)) to sDatabaseName
55714>>>>>                    Get FindTablePath sDatabaseName to sDatabaseName
55715>>>>>                    If (sDatabaseName <> "") Begin
55717>>>>>                        Set psDatabaseName sReportId to sDatabaseName
55718>>>>>                    End
55718>>>>>>
55718>>>>>                End
55718>>>>>>
55718>>>>>            End
55718>>>>>>
55718>>>>>            Get TableCount sReportId to iTables
55719>>>>>            If (iTables >= 1) Begin
55721>>>>>                // Enumerate the tables and change the table schema
55721>>>>>                Decrement iTables
55722>>>>>                For iTable from 0 to iTables
55728>>>>>>
55728>>>>>                    Get psTableSchema sReportId iTable to sTableSchema
55729>>>>>                    // sTableSchema is blank when the table was opened via the filelist
55729>>>>>                    If (sTableSchema <> "") Begin
55731>>>>>                        File_Exist sTableSchema bFileExists
55732>>>>>                        If (not (bFileExists)) Begin
55734>>>>>                            Move (ExtractFileName (sTableSchema)) to sTableSchema
55735>>>>>                            Get FindTablePath sTableSchema to sTableSchema
55736>>>>>                            If (sTableSchema <> "") Begin
55738>>>>>                                Set psTableSchema sReportId iTable to sTableSchema
55739>>>>>                            End
55739>>>>>>
55739>>>>>                            Else Begin
55740>>>>>                                Get psReportName to sReportName
55741>>>>>                                Get psTableSchema sReportId iTable to sTableSchema
55742>>>>>                                Error DFERR_DATAFLEX_REPORTS (Sformat (C_$DRCannotLocateTable, sTableSchema, sReportName, iTable))
55743>>>>>>
55743>>>>>                            End
55743>>>>>>
55743>>>>>                        End
55743>>>>>>
55743>>>>>                    End
55743>>>>>>
55743>>>>>                Loop
55744>>>>>>
55744>>>>>            End
55744>>>>>>
55744>>>>>        End
55744>>>>>>
55744>>>>>
55744>>>>>        Get SubReportCount sReportId to iSubReports
55745>>>>>        Decrement iSubReports
55746>>>>>        For iSubReport from 0 to iSubReports
55752>>>>>>
55752>>>>>            Get SubReportId sReportId iSubReport to sSubReportId
55753>>>>>            Send AutoLocateDFFiles sSubReportId
55754>>>>>        Loop
55755>>>>>>
55755>>>>>    End_Procedure
