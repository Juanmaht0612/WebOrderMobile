37188>>>>>>>    // =============
37188>>>>>>>    // RADIO BUTTONS
37188>>>>>>>    // =============
37188>>>>>>>    
37188>>>>>>>    // Radio buttons require some additional logic to work properly.
37188>>>>>>>    
37188>>>>>>>    Procedure AddRadio Handle hoRadio
37190>>>>>>>        // We just want to interrupt the delegation of this procedure here. The actual
37190>>>>>>>        // registration of the radio object happens in cWebDynamicObjectContainer:CreateLocal(1).
37190>>>>>>>        Procedure_Return
37191>>>>>>>    End_Procedure  
37192>>>>>>>    
37192>>>>>>>    
37192>>>>>>>    // Registers the passed cWebRadio object. The object's group is determined and the radio
37192>>>>>>>    // is registered with the rest of the objects in that group. If this is the first radio
37192>>>>>>>    // object in the group then it will become the "master" radio object for that group.
37192>>>>>>>    Procedure RegisterRadio Handle hoRadio
37194>>>>>>>        String sGroupName sName
37194>>>>>>>        Integer iGroup icGroup icRadio iSize iIndex
37194>>>>>>>        String[] aRadioGroupNames
37195>>>>>>>        String[] aRegisteredRadios
37196>>>>>>>        String[] aConnectQueue
37197>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37197>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37198>>>>>>>        
37198>>>>>>>        Get psDynamicObjectId of hoRadio to sName
37199>>>>>>>        
37199>>>>>>>        Get psGroupName of hoRadio to sGroupName
37200>>>>>>>        WebGet paRadioGroups to aRadioGroups
37201>>>>>>>        WebGet paRadioGroupNames to aRadioGroupNames
37202>>>>>>>        
37202>>>>>>>        // Is this a new group?....
37202>>>>>>>        Move (SearchArray(sGroupName, aRadioGroupNames, Desktop, RefFunc(DFSTRICMP))) to iGroup   // case insensitive search
37203>>>>>>>        
37203>>>>>>>        If (iGroup = -1) Begin
37205>>>>>>>            // Create a new group and make this radio button the master....
37205>>>>>>>            Move (SizeOfArray(aRadioGroups)) to icGroup
37206>>>>>>>
37206>>>>>>>            Move sName      to aRadioGroups[icGroup].sMaster
37207>>>>>>>            Move sName      to aRadioGroups[icGroup].aRadioButtons[0]
37208>>>>>>>            Move sGroupName to aRadioGroups[icGroup].sGroupName
37209>>>>>>>            Move sGroupName to aRadioGroupNames[icGroup]
37210>>>>>>>            
37210>>>>>>>            // Save the changes....
37210>>>>>>>            WebSet paRadioGroups to aRadioGroups
37211>>>>>>>            WebSet paRadioGroupNames to aRadioGroupNames
37212>>>>>>>        End
37212>>>>>>>>
37212>>>>>>>        Else Begin
37213>>>>>>>            Move (SearchArray(sName, aRadioGroups[iGroup].aRadioButtons, Desktop, RefFunc(DFSTRICMP))) to iIndex
37214>>>>>>>            
37214>>>>>>>            If (iIndex <> -1) ;                Procedure_Return
37217>>>>>>>            
37217>>>>>>>            // Add this radio to the existing group....
37217>>>>>>>            Move sName to aRadioGroups[iGroup].aRadioButtons[-1]
37218>>>>>>>            
37218>>>>>>>            // Save the changes....
37218>>>>>>>            WebSet paRadioGroups to aRadioGroups
37219>>>>>>>            
37219>>>>>>>            // Save current group name
37219>>>>>>>            Move aRadioGroupNames[iGroup] to sGroupName
37220>>>>>>>        End 
37220>>>>>>>>
37220>>>>>>>        
37220>>>>>>>        // Add the group name to the list of groups that are to be connected
37220>>>>>>>        WebGet paRadioConnectQueue to aConnectQueue
37221>>>>>>>        Move (SearchArray(sGroupName, aConnectQueue)) to iIndex
37222>>>>>>>        If (iIndex = -1) Begin
37224>>>>>>>            Move sGroupName to aConnectQueue[-1]
37225>>>>>>>            WebSet paRadioConnectQueue to aConnectQueue
37226>>>>>>>        End
37226>>>>>>>>
37226>>>>>>>    End_Procedure
37227>>>>>>>    
37227>>>>>>>    
37227>>>>>>>    Procedure ConnectRadioButtons
37229>>>>>>>        // Radio button Helper:
37229>>>>>>>        //
37229>>>>>>>        // Iterate all of the registered radio groups and connect the cWebRadio objects to their master
37229>>>>>>>        // radio buttons.
37229>>>>>>>        String sValue sTemp sMaster sRadio sMasterFullName
37229>>>>>>>        String[] aConnectQueue aRadioGroupNames
37231>>>>>>>        Handle hoRadio hoMaster
37231>>>>>>>        Integer iGroup icGroup iQueuedGroup
37231>>>>>>>        Integer iRadio icRadio
37231>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37231>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37232>>>>>>>        
37232>>>>>>>        WebGet paRadioGroups to aRadioGroups
37233>>>>>>>        WebGet paRadioConnectQueue to aConnectQueue
37234>>>>>>>        WebGet paRadioGroupNames to aRadioGroupNames
37235>>>>>>>        Move (SizeOfArray(aConnectQueue)) to icGroup
37236>>>>>>>        
37236>>>>>>>        For iQueuedGroup from 0 to (icGroup - 1)
37242>>>>>>>>
37242>>>>>>>            Move (SearchArray(aConnectQueue[iQueuedGroup], aRadioGroupNames)) to iGroup
37243>>>>>>>            If (iGroup <> -1) Begin
37245>>>>>>>                Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
37246>>>>>>>                Move "" to sValue
37247>>>>>>>                Move aRadioGroups[iGroup].sMaster to sMaster 
37248>>>>>>>                Get DynamicObject aRadioGroups[iGroup].sMaster to hoMaster
37249>>>>>>>                
37249>>>>>>>                For iRadio from 0 to (icRadio - 1)
37255>>>>>>>>
37255>>>>>>>                    // Set the master radio....
37255>>>>>>>                    Move aRadioGroups[iGroup].aRadioButtons[iRadio] to sRadio
37256>>>>>>>                    Get DynamicObject sRadio to hoRadio
37257>>>>>>>                    
37257>>>>>>>                    WebSet psMasterRadio of hoRadio to aRadioGroups[iGroup].sMaster
37258>>>>>>>                    If (sRadio <> aRadioGroups[iGroup].sMaster) Begin
37260>>>>>>>                        Get WebObjectName of hoMaster to sMasterFullName
37261>>>>>>>                        WebSet psMasterName of hoRadio to sMasterFullName
37262>>>>>>>                    End
37262>>>>>>>>
37262>>>>>>>                    
37262>>>>>>>                    // Get the last non-null psValue setting....
37262>>>>>>>                    WebGet psValue of hoRadio to sTemp
37263>>>>>>>                    If (sTemp <> "") Begin
37265>>>>>>>                        Move sTemp to sValue
37266>>>>>>>                    End
37266>>>>>>>>
37266>>>>>>>                Loop
37267>>>>>>>>
37267>>>>>>>                
37267>>>>>>>                // If there is no psValue setting then set it to the psRadioValue value of the master radio....
37267>>>>>>>                If (sValue = "") Begin
37269>>>>>>>                    Get DynamicObject aRadioGroups[iGroup].sMaster to hoMaster
37270>>>>>>>                    WebGet psRadioValue of hoMaster to sValue
37271>>>>>>>                End
37271>>>>>>>>
37271>>>>>>>                
37271>>>>>>>                // Synchronize all radios in this group to the same psValue...
37271>>>>>>>                If (sValue <> "") Begin
37273>>>>>>>                    For iRadio from 0 to (icRadio-1)
37279>>>>>>>>
37279>>>>>>>                        Move aRadioGroups[iGroup].aRadioButtons[iRadio] to sRadio
37280>>>>>>>                        Get DynamicObject sRadio to hoRadio
37281>>>>>>>                        
37281>>>>>>>                        WebSet psValue of hoRadio to sValue
37282>>>>>>>                    Loop
37283>>>>>>>>
37283>>>>>>>                End
37283>>>>>>>>
37283>>>>>>>            End
37283>>>>>>>>
37283>>>>>>>        Loop
37284>>>>>>>>
37284>>>>>>>        
37284>>>>>>>        WebSet paRadioConnectQueue to (ResizeArray(aConnectQueue, 0))
37285>>>>>>>    End_Procedure
37286>>>>>>>    
37286>>>>>>>    
37286>>>>>>>    // Finds and returns the radiogroup to which the given radio belongs.
37286>>>>>>>    Function FindRadioGroup String sDynamicObjectId Boolean ByRef bFound Returns tWebDynamicRadioGroup
37288>>>>>>>        Integer icGroups iGroup iRadioIndex
37288>>>>>>>        tWebDynamicRadioGroup tRadioGroup
37288>>>>>>>        tWebDynamicRadioGroup tRadioGroup
37288>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37288>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
37289>>>>>>>        
37289>>>>>>>        WebGet paRadioGroups to aRadioGroups
37290>>>>>>>        
37290>>>>>>>        Move (SizeOfArray(aRadioGroups)) to icGroups
37291>>>>>>>        For iGroup from 0 to (icGroups - 1)
37297>>>>>>>>
37297>>>>>>>            Move (SearchArray(sDynamicObjectId, aRadioGroups[iGroup].aRadioButtons)) to iRadioIndex
37298>>>>>>>            If (iRadioIndex <> -1) Begin
37300>>>>>>>                Move True to bFound
37301>>>>>>>                Move aRadioGroups[iGroup] to tRadioGroup
37302>>>>>>>            End
37302>>>>>>>>
37302>>>>>>>            
37302>>>>>>>            If (bFound) ;                Break
37305>>>>>>>        Loop
37306>>>>>>>>
37306>>>>>>>        
37306>>>>>>>        Function_Return tRadioGroup
37307>>>>>>>    End_Function
