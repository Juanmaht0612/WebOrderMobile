39235>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
39236>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
39237>>>>>        Get Request_Validate of hoSessionDD to iErr
39238>>>>>        If (iErr) Begin
39240>>>>>            // this should not happen. If it does its a programming error
39240>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
39241>>>>>>
39241>>>>>            Function_Return ""
39242>>>>>        End
39242>>>>>>
39242>>>>>        Send Request_Save of hoSessionDD
39243>>>>>        If (Err) Begin
39245>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
39245>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
39246>>>>>>
39246>>>>>            Function_Return ""
39247>>>>>        End
39247>>>>>>
39247>>>>>       
39247>>>>>        Function_Return sSessionKey        
39248>>>>>    End_Function
