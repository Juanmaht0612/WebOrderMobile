22340>>>>>>>>>>>>>>>    //
22340>>>>>>>>>>>>>>>    // Stores the passed web properties array and sets up the object to work with
22340>>>>>>>>>>>>>>>    // this data.
22340>>>>>>>>>>>>>>>    //
22340>>>>>>>>>>>>>>>    // Params:
22340>>>>>>>>>>>>>>>    //      aSyncProps   - Is the set of web properties from the client
22340>>>>>>>>>>>>>>>    //
22340>>>>>>>>>>>>>>>    Procedure InitializeSyncProps tWebSyncProps[] aSyncProps
22342>>>>>>>>>>>>>>>        Integer iObj iProp iSize iCapacity iGrowthFactor iStoreIndex
22342>>>>>>>>>>>>>>>        Handle hoObject hoControlLocator
22342>>>>>>>>>>>>>>>        Handle[] aChildObjects
22343>>>>>>>>>>>>>>>        
22343>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22344>>>>>>>>>>>>>>>        Get phoWebControlLocator to hoControlLocator
22345>>>>>>>>>>>>>>>        
22345>>>>>>>>>>>>>>>        // Set up the array size management properties....
22345>>>>>>>>>>>>>>>        Move (SizeOfArray(aSyncProps)) to iSize
22346>>>>>>>>>>>>>>>        Move 100                       to iGrowthFactor    // This is the initial growth factor of the arrays. It doubles each time the array is resized.
22347>>>>>>>>>>>>>>>        Move (iSize max iGrowthFactor) to iCapacity
22348>>>>>>>>>>>>>>>        
22348>>>>>>>>>>>>>>>        Set piSize to iSize
22349>>>>>>>>>>>>>>>        Set piGrowthFactor to iGrowthFactor
22350>>>>>>>>>>>>>>>        Set piCapacity to iCapacity
22351>>>>>>>>>>>>>>>        
22351>>>>>>>>>>>>>>>        // Preallocate space for sync properties (plus some growth)....
22351>>>>>>>>>>>>>>>        Move (ResizeArray(aSyncProps, iCapacity)) to aSyncProps
22352>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]     // We do not clear the array first. That is because we will just overwrite the old values.
22353>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], 0)) to gaSyncChangedProps[iStoreIndex]               // This global array must be cleared first! We cannot guarantee that the old values will be fully overwritten.
22354>>>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]       // now size it to the correct value
22355>>>>>>>>>>>>>>>        
22355>>>>>>>>>>>>>>>        // Iterate each member and find the object reference.....
22355>>>>>>>>>>>>>>>        For iObj from 0 to (iSize - 1)
22361>>>>>>>>>>>>>>>>
22361>>>>>>>>>>>>>>>            Get FindWebObject of hoControlLocator aSyncProps[iObj].sO to hoObject
22362>>>>>>>>>>>>>>>            
22362>>>>>>>>>>>>>>>            If (hoObject = C_WebUnresolvedObject) Begin
22364>>>>>>>>>>>>>>>                If (pbErrorObjNotFound(Self)) Begin
22366>>>>>>>>>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, aSyncProps[iObj].sO))
22367>>>>>>>>>>>>>>>>
22367>>>>>>>>>>>>>>>                End
22367>>>>>>>>>>>>>>>>
22367>>>>>>>>>>>>>>>            End
22367>>>>>>>>>>>>>>>>
22367>>>>>>>>>>>>>>>            Else Begin
22368>>>>>>>>>>>>>>>//                Set piSyncObjectIndex of hoObject to iObj    // Cache the object's index in the object itself
22368>>>>>>>>>>>>>>>            End
22368>>>>>>>>>>>>>>>>
22368>>>>>>>>>>>>>>>            
22368>>>>>>>>>>>>>>>            // Populate the shadow structs....
22368>>>>>>>>>>>>>>>            Move hoObject to gaSyncObjectHandles[iStoreIndex][iObj]
22369>>>>>>>>>>>>>>>            Move False to gaSyncChangedProps[iStoreIndex][iObj].bContainsChanges
22370>>>>>>>>>>>>>>>        Loop
22371>>>>>>>>>>>>>>>>
22371>>>>>>>>>>>>>>>
22371>>>>>>>>>>>>>>>        // Store the web property data....
22371>>>>>>>>>>>>>>>        Move aSyncProps to gaSyncProps[iStoreIndex]
22372>>>>>>>>>>>>>>>    End_Procedure
