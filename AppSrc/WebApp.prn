37816>>>>>>>        Move (ConvertToClient(typeNumber, fFontSize)) to asParams[4]
37817>>>>>>>
37817>>>>>>>        If (num_arguments > 5) Begin
37819>>>>>>>            Move eJustification to asParams[5]
37820>>>>>>>        End
37820>>>>>>>>
37820>>>>>>>
37820>>>>>>>        If (num_arguments > 6) Begin
37822>>>>>>>            Move sFontWeight to asParams[6]
37823>>>>>>>        End
37823>>>>>>>>
37823>>>>>>>        
37823>>>>>>>        If (num_arguments > 7) Begin
37825>>>>>>>            Move sTextDecoration to asParams[7]
37826>>>>>>>        End
