37619>>>>>>>    // This is called to trigger the OnFileDrop event.
37619>>>>>>>    //
37619>>>>>>>    // Published!
37619>>>>>>>    Function FileDrop String sDropTargetName Integer eDropPosition Returns String
37621>>>>>>>        String[][] aFiles 
37622>>>>>>>        String[][] aResult
37623>>>>>>>        String sPath sData
37623>>>>>>>        Integer iFile iTo
37623>>>>>>>        Handle hoJsonObj hoJsonDragData hoJsonDropData hoDropTarget hoJson
37623>>>>>>>
37623>>>>>>>        //  Parse JSON
37623>>>>>>>        Get phoActionJsonData to hoJson
37624>>>>>>>        
37624>>>>>>>        Get Member of hoJson "DragData" to hoJsonDragData // <-- Contains files array
37625>>>>>>>        Get Member of hoJson "DropData" to hoJsonDropData // Drop data based on target
37626>>>>>>>        
37626>>>>>>>        Get WebObjectByName sDropTargetName to hoDropTarget
37627>>>>>>>        
37627>>>>>>>        If (hoDropTarget <> C_WebUnresolvedObject) Begin
37629>>>>>>>            Set phoJsonDropData of hoDropTarget to hoJsonDropData
37630>>>>>>>        End
37630>>>>>>>>
37630>>>>>>>        
37630>>>>>>>        // Extract files
37630>>>>>>>        Get JsonToDataType of hoJsonDragData to aFiles
37631>>>>>>>        
37631>>>>>>>        Move (SizeOfArray(aFiles) - 1) to iTo
37632>>>>>>>        
37632>>>>>>>        For iFile from 0 to iTo
37638>>>>>>>>
37638>>>>>>>            Move aFiles[iFile][0] to aResult[iFile][0]
37639>>>>>>>            
37639>>>>>>>            Get OnFileDrop aFiles[iFile][1] aFiles[iFile][2] aFiles[iFile][3] hoDropTarget eDropPosition to sPath
37640>>>>>>>            
37640>>>>>>>            If (sPath <> "") Begin
37642>>>>>>>                Get FileUploadKey of (ResourceManager(Self)) sPath to aResult[iFile][1]
37643>>>>>>>            End
37643>>>>>>>>
37643>>>>>>>            Else Begin
37644>>>>>>>                Move "" to aResult[iFile][1]
37645>>>>>>>            End
37645>>>>>>>>
37645>>>>>>>        Loop
37646>>>>>>>>
37646>>>>>>>        
37646>>>>>>>        //  Return upload paths to client
37646>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonObj
37647>>>>>>>        Send DataTypeToJson of hoJsonObj aResult
37648>>>>>>>        Get Stringify of hoJsonObj to sData
37649>>>>>>>        Send Destroy of hoJsonObj
37650>>>>>>>        
37650>>>>>>>        Function_Return sData
37651>>>>>>>        
37651>>>>>>>        //  Cleanup
37651>>>>>>>        If (hoDropTarget <> C_WebUnresolvedObject) Begin
37653>>>>>>>            Set phoJsonDropData of hoDropTarget to C_WebUnresolvedObject
37654>>>>>>>        End
37654>>>>>>>>
37654>>>>>>>    End_Function
37655>>>>>>>    
37655>>>>>>>    // User augmented, can be used to respond to a file drop and should return the path to store the file
37655>>>>>>>    Function OnFileDrop String sFileName BigInt iBytes String sMime Handle hoDropTarget WebDropPosition eDropPosition Returns String
37657>>>>>>>        Function_Return ""
37658>>>>>>>    End_Function
