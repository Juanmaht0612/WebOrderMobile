57062>>>>>    Function GenerateDownloadLinks Returns String[]
57064>>>>>        String sReportId
57064>>>>>        String[] sFileNames
57065>>>>>        Integer iElements iElement iPage
57065>>>>>        Integer eImageType
57065>>>>>
57065>>>>>        Get OpenReport to sReportId
57066>>>>>        If (sReportId <> "") Begin
57068>>>>>            Send OnPreGenerateDownloadLinks
57069>>>>>
57069>>>>>            Get peImageType to eImageType
57070>>>>>
57070>>>>>            Case Begin
57070>>>>>                Case (eImageType = C_drJPEG)
57072>>>>>                    Set peImageExportType to C_DRJPEG
57073>>>>>                    Get ExportFileNamesSet 'jpeg' -1 to sFileNames
57074>>>>>                    Case Break
57075>>>>>                Case (eImageType = C_drGIF)
57078>>>>>                    Set peImageExportType to C_DRGIF
57079>>>>>                    Get ExportFileNamesSet 'gif' -1 to sFileNames
57080>>>>>                    Case Break
57081>>>>>                Case (eImageType = C_drPNG)
57084>>>>>                    Set peImageExportType to C_DRPNG
57085>>>>>                    Get ExportFileNamesSet 'png' -1 to sFileNames
57086>>>>>                    Case Break
57087>>>>>            Case End
57087>>>>>
57087>>>>>            Set pbImageExportMultiPage to False
57088>>>>>
57088>>>>>            Move (SizeOfArray (sFileNames)) to iElements
57089>>>>>            Decrement iElements
57090>>>>>
57090>>>>>            For iElement from 0 to iElements
57096>>>>>>
57096>>>>>                Increment iPage
57097>>>>>                Set piImageExportPage to iPage
57098>>>>>                Send ExportReport C_DRImage sFileNames[iElement]
57099>>>>>                Get DownloadURL of ghoWebResourceManager sFileNames[iElement] to sFileNames[iElement]
57100>>>>>            Loop
57101>>>>>>
57101>>>>>
57101>>>>>            Send OnPostGenerateDownloadLinks sFileNames
57102>>>>>            Send CloseReport sReportId
57103>>>>>        End
57103>>>>>>
57103>>>>>
57103>>>>>        Function_Return sFileNames
57104>>>>>    End_Function
