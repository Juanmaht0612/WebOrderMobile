22142>>>>>>>>>>>>>    // Updates the state hash by pushing a new history item or replacing the existing one. Looks at
22142>>>>>>>>>>>>>    // peApplicationStateMode to see what it should do.
22142>>>>>>>>>>>>>    //
22142>>>>>>>>>>>>>    // Params:
22142>>>>>>>>>>>>>    //      sStateHash      New state hash.
22142>>>>>>>>>>>>>    //      sTitle          New page title.
22142>>>>>>>>>>>>>    //      bReplace        If true the current state is replaced, if false a new history item is 
22142>>>>>>>>>>>>>    //                      pushed.
22142>>>>>>>>>>>>>    Procedure SetStateHash String sStateHash String sTitle Boolean bReplace
22144>>>>>>>>>>>>>        tWebValueTree vt
22144>>>>>>>>>>>>>        tWebValueTree vt
22144>>>>>>>>>>>>>       
22144>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
22146>>>>>>>>>>>>>            Move sStateHash to vt.v
22147>>>>>>>>>>>>>            
22147>>>>>>>>>>>>>            If (bReplace) Begin
22149>>>>>>>>>>>>>                Send HistoryReplaceState "" sTitle vt
22150>>>>>>>>>>>>>            End
22150>>>>>>>>>>>>>>
22150>>>>>>>>>>>>>            Else Begin
22151>>>>>>>>>>>>>                Send HistoryPushState "" sTitle vt
22152>>>>>>>>>>>>>            End
22152>>>>>>>>>>>>>>
22152>>>>>>>>>>>>>            WebSet psCurrentAppState to sStateHash
22153>>>>>>>>>>>>>        End
22153>>>>>>>>>>>>>>
22153>>>>>>>>>>>>>        
22153>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
22155>>>>>>>>>>>>>            Send StateHashToUrl (&sStateHash)
22156>>>>>>>>>>>>>            If (bReplace) Begin
22158>>>>>>>>>>>>>                Send HistoryReplaceState sStateHash sTitle
22159>>>>>>>>>>>>>            End
22159>>>>>>>>>>>>>>
22159>>>>>>>>>>>>>            Else Begin
22160>>>>>>>>>>>>>                Send HistoryPushState sStateHash sTitle
22161>>>>>>>>>>>>>            End
22161>>>>>>>>>>>>>>
22161>>>>>>>>>>>>>        End
22161>>>>>>>>>>>>>>
22161>>>>>>>>>>>>>    End_Procedure
22162>>>>>>>>>>>>>
22162>>>>>>>>>>>>>    // Determines the current state hash. Depending on peApplicationState it looks at the location 
22162>>>>>>>>>>>>>    // hash or a property.
22162>>>>>>>>>>>>>    //
22162>>>>>>>>>>>>>    // Returns:
22162>>>>>>>>>>>>>    //      The current application state hash (since it was last updated).
22162>>>>>>>>>>>>>    Function StateHash Returns String
22164>>>>>>>>>>>>>        String sStateHash
22164>>>>>>>>>>>>>        
22164>>>>>>>>>>>>>        // When the hash is not part of the URL but we do support history then the state hash is
22164>>>>>>>>>>>>>        // stored in a web property unad updated by SetStateHash and HistoryPopState.
22164>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
22166>>>>>>>>>>>>>            WebGet psCurrentAppState to sStateHash
22167>>>>>>>>>>>>>        End
22167>>>>>>>>>>>>>>
22167>>>>>>>>>>>>>        
22167>>>>>>>>>>>>>        // When the hash is part of the URL we can always read it from the URL. Note that this 
22167>>>>>>>>>>>>>        // doesn't reflect changes made during this request.
22167>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
22169>>>>>>>>>>>>>            WebGet psLocationHash to sStateHash
22170>>>>>>>>>>>>>            
22170>>>>>>>>>>>>>            If (Left(sStateHash, 1) = "#") Begin
22172>>>>>>>>>>>>>                Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
22173>>>>>>>>>>>>>            End
22173>>>>>>>>>>>>>>
22173>>>>>>>>>>>>>        End 
22173>>>>>>>>>>>>>>
22173>>>>>>>>>>>>>        Function_Return sStateHash
22174>>>>>>>>>>>>>    End_Function
22175>>>>>>>>>>>>>    
22175>>>>>>>>>>>>>    // Restores the passed state hash and updates the history.
22175>>>>>>>>>>>>>    //
22175>>>>>>>>>>>>>    // Params:
22175>>>>>>>>>>>>>    //  sStateHash  State hash to restore.
22175>>>>>>>>>>>>>    //  bReplace    If true the current history item is replaced (instead of adding a new history item).
22175>>>>>>>>>>>>>    Procedure NavigateToStateHash String sStateHash Boolean bReplace
22177>>>>>>>>>>>>>        Send SetStateHash sStateHash "" bReplace
22178>>>>>>>>>>>>>        Send RestoreState sStateHash
22179>>>>>>>>>>>>>    End_Procedure
22180>>>>>>>>>>>>>    
22180>>>>>>>>>>>>>    // Server-Action
22180>>>>>>>>>>>>>    //
22180>>>>>>>>>>>>>    //  This overrides LocationHasChange in cWebHostAPI_mixin!
22180>>>>>>>>>>>>>    //
22180>>>>>>>>>>>>>    // Called by the client when the location hash changes (hashchange browser event) and triggers
22180>>>>>>>>>>>>>    // a restorestate if needed and calls OnLocationHashChange.
22180>>>>>>>>>>>>>    // 
22180>>>>>>>>>>>>>    // Params:
22180>>>>>>>>>>>>>    //      sHash       New location hash.
22180>>>>>>>>>>>>>    Procedure LocationHashChange String sHash
22182>>>>>>>>>>>>>        String sStateHash
22182>>>>>>>>>>>>>        
22182>>>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls and pbStateAsUrlHash(Self)) Begin
22184>>>>>>>>>>>>>            Get StateHash to sStateHash
22185>>>>>>>>>>>>>            Send RestoreState sStateHash True
22186>>>>>>>>>>>>>        End
22186>>>>>>>>>>>>>>
22186>>>>>>>>>>>>>        
22186>>>>>>>>>>>>>        Send OnLocationHashChange sHash
22187>>>>>>>>>>>>>    End_Procedure
