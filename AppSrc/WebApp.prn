41998>>>            tWebNavigateData NavigateData
41998>>>            tWebNavigateData NavigateData
41998>>>            String sTask
41998>>>            Boolean bFound
41998>>>            Get GetNavigateData to NavigateData
41999>>>            Case Begin
41999>>>                Case (NavigateData.eNavigateType=nfFromChild)
42001>>>                Case (NavigateData.eNavigateType=nfFromMain)
42004>>>                    // a child or main lookup
42004>>>                    Send NavigateClose Self
42005>>>                    Case Break
42006>>>                Case (NavigateData.eNavigateType=nfFromParent)
42009>>>                    // not used yet
42009>>>                    Case Break
42010>>>                Case Else
42010>>>                    Get NamedValueGet NavigateData.NamedValues "task" to sTask
42011>>>                    If (sTask="maint") Begin
42013>>>                        Send NavigatePath of oSwipeDetails // Note that we use the swipe details button so we only have a single path
42014>>>                    End
42014>>>>
42014>>>                    Else Begin
42015>>>                        Send NavigatePath of oSwipeOrders // Note that we use the swipe orders button so we have a single path
42016>>>                    End
42016>>>>
42016>>>            Case End
