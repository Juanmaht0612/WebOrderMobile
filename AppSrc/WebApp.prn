27672>>>>>>>
27672>>>>>>>// Models a data entry view panel. This is a container for...
27672>>>>>>>// - A DDO structure
27672>>>>>>>// - Panel layout
27672>>>>>>>// - Child DEO and non-DEO controls.
27672>>>>>>>//
27672>>>>>>>// Adds support for...
27672>>>>>>>// - DDO Container,
27672>>>>>>>// - DDO request interface
27672>>>>>>>Class cWebView is a cWebWindow
27673>>>>>>>    
27673>>>>>>>    Procedure Construct_Object
27675>>>>>>>        Integer eStyle 
27675>>>>>>>        String sName
27675>>>>>>>        
27675>>>>>>>        Forward Send Construct_Object
27677>>>>>>>        
27677>>>>>>>        
27677>>>>>>>        
27677>>>>>>>        // this determines if request_save should validate all items or stop at the first error. The default
27677>>>>>>>        // for web applicaitions is to validate all.
27677>>>>>>>        // For now this is private, as this may never be needed.  
27677>>>>>>>        Property Boolean pbRequesteValidateAll True
27678>>>>>>>
27678>>>>>>>        // This is set to true during SyncDDOs, specifically while trying to re-establish the DDO's Field_Defaults.
27678>>>>>>>        // Typically the flag is used to protect DEO's during this process so that the Field_Default is re-established
27678>>>>>>>        // only in the actual DDO (where it is needed) and not in the DEO (where the value may have changed already).        
27678>>>>>>>        Property Boolean pbSynchingFieldDefaults False
27679>>>>>>>        
27679>>>>>>>        Property Boolean pbFindKeys True
27680>>>>>>>        Property Boolean pbClearKeys True
27681>>>>>>>        Property Boolean pbDeleteKeys True
27682>>>>>>>        Property Boolean pbSaveKeys True
27683>>>>>>>        
27683>>>>>>>        // set true if constrain_file change in data dictionaries for each client instance
27683>>>>>>>        // This is only applied with drilldown style views
27683>>>>>>>        Property Boolean pbDrillDownDynamicConstraints True 
27684>>>>>>>        
27684>>>>>>>        
27684>>>>>>>        
27684>>>>>>>        // Published Properties
27684>>>>>>>        Property Boolean pbServerOnSubmit False    // Set to true to trigger server OnSubmit event
27687>>>>>>>        Property String psClientOnSubmit ""        // Name of client side OnSubmit event handler
27690>>>>>>>        
27690>>>>>>>        Property Boolean pbServerOnResizeWindow False
27693>>>>>>>        Property String psClientOnResizeWindow ""
27696>>>>>>>         
27696>>>>>>>        Property Boolean pbFillHeight False
27699>>>>>>>        
27699>>>>>>>        // this gets set during object construction by looking at the cWebApp's application type.  
27699>>>>>>>        Property Integer peWebViewStyle wvsDesktop
27700>>>>>>>
27700>>>>>>>        Property Integer peViewType vtUndefined   // General purpose of this view: i.e. vtZoom or vtSelect
27701>>>>>>>        
27701>>>>>>>        // if drillDown should Request_Save attempt to save a new unchanged record?
27701>>>>>>>        // with drill down this makes the most sense. With Desktop style this is ignored.
27701>>>>>>>        // Currently marked private. Might be exposed if it turns out to be needed
27701>>>>>>>        Property Boolean pbAlwaysSaveWhenNewDrillDown True
27702>>>>>>>
27702>>>>>>>        // what to do when closing a changed view. This is called by
27702>>>>>>>        // GetChangedViewExitAction, which can be augmented to handle more dynamic actions
27702>>>>>>>        Property Integer peChangedViewExitAction cveConfirmSaveClearCancel
27703>>>>>>>        
27703>>>>>>>        Property Handle Verify_SaveClearCancel_msg (RefProc(SaveClearCancelConfirmation))
27704>>>>>>>
27704>>>>>>>        Property String psNavigateDataCallbackObj ""   // Private: Used by NavigateClose_Callback. Stores the callback object to populate the navigate data when navigating back. This is usually the object that invoked NavigateBack
27707>>>>>>>        
27707>>>>>>>        Property tWebNavigateData pNavigateData
27710>>>>>>>
27710>>>>>>>        Property String psNavigateBackView
27713>>>>>>>
27713>>>>>>>        Property String psInvokingObject ""        
27716>>>>>>>        
27716>>>>>>>        Property String psInvokingStateHash ""          //  Used to store the state hash of the invoking view for drill-down
27719>>>>>>>        Property Boolean pbNavReinitError False         //  Used to communicate issues back to NavigateInitialize
27720>>>>>>>        Property Boolean pbNavigating False           //  True while inside navigation messages
27721>>>>>>>        Property Boolean pbInitForShow False         //  True while inside initforshow
27722>>>>>>>        
27722>>>>>>>        Property Boolean pbStateRestoreRecord True      //  If true record ids will be part of the state hash for desktop-style
27723>>>>>>>        Property Boolean pbStateReplace False           //  If true the current view will not add a new history item but replace the current item in history
27724>>>>>>>        Property Integer peStateMode vsmDefault         //  Configures how the state hash for this view built
27725>>>>>>>        Property String psStateNewRecordId ""           //  Configures how new records will be represented in the state hash
27726>>>>>>>
27726>>>>>>>        
27726>>>>>>>        /*        A view is preloaded using delayloadview, this basically puts the view 'in sync' but it         loads the view details later. This is an optimization added for history management where it         has to rebuild the entire view stack for drill down applications. It now only fully loads         the visible view and the others are loaded in the background using delayloadview, but it         does need to refind records so InitForShow is already executed and should not be executed         again. pbPreLoaded indicates that it should skip InitForShow.                */
27726>>>>>>>        Property Boolean pbPreLoaded False
27729>>>>>>>                
27729>>>>>>>        Get Object_Label to sName
27730>>>>>>>        Property String psStateViewName sName
27731>>>>>>>               
27731>>>>>>>        // the constructor will set the style based on the application setting of this.
27731>>>>>>>        // this can be changed during object construction but most not be changed
27731>>>>>>>        // after the object is created (i.e., after end_construct_object)
27731>>>>>>>        Get peApplicationStyle of (Host(Self)) to eStyle
27732>>>>>>>        Set peWebViewStyle to eStyle
27733>>>>>>>        Set pbScroll to True
27734>>>>>>>
27734>>>>>>>        Set psJSClass to "df.WebView"
27735>>>>>>>        
27735>>>>>>>        Send Define_cWebNavPathHelper_mixin
27736>>>>>>>        Send Define_cWebOnCallEndHandler_mixin
27737>>>>>>>        Send Define_cWebDDOSync_mixin
27738>>>>>>>    End_Procedure
27739>>>>>>>
