58556>>>>>                    Get ReportPageCount to iPages
58557>>>>>                    Set piMaxPage of hoPrintDialog to iPages
58558>>>>>                    Send InitPageRanges Of hoPrintDialog iPages
58559>>>>>                    Get psPrinterName to sPrinterName
58560>>>>>                    If (sPrinterName <> "") Begin
58562>>>>>                        Get ReadPrinterDevMode of hoPrintDialog sPrinterName to iResult
58563>>>>>                        If (iResult = PD_RESULT_CANCEL) Begin
58565>>>>>                            Send CopyReportPageSizeAndOrientation sReportId hoPrintDialog
58566>>>>>                            Get piFlags of hoPrintDialog to iFlags
58567>>>>>                            Set piFlags of hoPrintDialog to (PD_RETURNDEFAULT ior PD_NOPAGENUMS)
58568>>>>>                            Send OnPreShowPrintDialog sReportId hoPrintDialog
58569>>>>>                            Get PrintDialog of hoPrintDialog to iResult
58570>>>>>                            Send OnPostShowPrintDialog sReportId hoPrintDialog
58571>>>>>                            Set piFlags of hoPrintDialog to iFlags
58572>>>>>                        End
58572>>>>>>
58572>>>>>                    End
58572>>>>>>
58572>>>>>                    Else Begin
58573>>>>>                        Get piFlags of hoPrintDialog to iFlags
58574>>>>>                        Set piFlags of hoPrintDialog to (PD_RETURNDEFAULT ior PD_NOPAGENUMS)
58575>>>>>                        Send CopyReportPageSizeAndOrientation sReportId hoPrintDialog
58576>>>>>                        Send OnPreShowPrintDialog sReportId hoPrintDialog
58577>>>>>                        Get PrintDialog of hoPrintDialog to iResult
58578>>>>>                        Send OnPostShowPrintDialog sReportId hoPrintDialog
58579>>>>>                        Set piFlags of hoPrintDialog to iFlags
58580>>>>>                    End
