29626>>>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
29627>>>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
29628>>>>>>>>>>>        
29628>>>>>>>>>>>        Send ReadChunk (&parsedata)
