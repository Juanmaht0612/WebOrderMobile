25054>>>>>>>>>>>>>>>    Procedure OnCreate tSelectionItem ByRef NewItem Boolean ByRef bCancel
25056>>>>>>>>>>>>>>>        // Stub
25056>>>>>>>>>>>>>>>    End_Procedure
25057>>>>>>>>>>>>>>>
25057>>>>>>>>>>>>>>>    Procedure OnSelectControlSuggestion String sRowId String sValue Integer iAdditionalItems Integer iPage
25059>>>>>>>>>>>>>>>        Case Begin
25059>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_More_Control) 
25061>>>>>>>>>>>>>>>                Send FindSuggestions sValue iPage iAdditionalItems
25062>>>>>>>>>>>>>>>                Case Break
25063>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_CreateNew_Control) 
25066>>>>>>>>>>>>>>>                Send CreateNewByValue sValue
25067>>>>>>>>>>>>>>>                Case Break
25068>>>>>>>>>>>>>>>            Case (sRowId = C_WebBaseSelectionForm_AdvancedSearch_Control)
25071>>>>>>>>>>>>>>>                Send OnPrompt
25072>>>>>>>>>>>>>>>                Case Break
25073>>>>>>>>>>>>>>>        Case End
25073>>>>>>>>>>>>>>>    End_Procedure
25074>>>>>>>>>>>>>>>    
25074>>>>>>>>>>>>>>>    Procedure CreateNewByValue String sValue
25076>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25076>>>>>>>>>>>>>>>        tSelectionItem oNewItem
25076>>>>>>>>>>>>>>>        Boolean bCancel bFound bErr bAllowCreate bSuccess
25076>>>>>>>>>>>>>>>        Integer iFile iField
25076>>>>>>>>>>>>>>>        Handle hoSelectionSource hoServer hoTable
25076>>>>>>>>>>>>>>>        
25076>>>>>>>>>>>>>>>        Get pbAllowCreate to bAllowCreate
25077>>>>>>>>>>>>>>>        If (not(bAllowCreate)) ;            Procedure_Return
25080>>>>>>>>>>>>>>>        
25080>>>>>>>>>>>>>>>        Move sValue to oNewItem.aValues[0]
25081>>>>>>>>>>>>>>>        Send OnCreate (&oNewItem) (&bCancel)
25082>>>>>>>>>>>>>>>        
25082>>>>>>>>>>>>>>>        If (bCancel) ;            Procedure_Return
25085>>>>>>>>>>>>>>>        
25085>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25086>>>>>>>>>>>>>>>        
25086>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25088>>>>>>>>>>>>>>>            If (pbAutoCreate(hoSelectionSource)) Begin
25090>>>>>>>>>>>>>>>                Get CreateItem of hoSelectionSource (&oNewItem) oNewItem.aValues[0] to bSuccess
25091>>>>>>>>>>>>>>>                If (not(bSuccess)) ;                    Procedure_Return
25094>>>>>>>>>>>>>>>            End
25094>>>>>>>>>>>>>>>>
25094>>>>>>>>>>>>>>>        End
25094>>>>>>>>>>>>>>>>
25094>>>>>>>>>>>>>>>        
25094>>>>>>>>>>>>>>>        Send OnPostCreate oNewItem
25095>>>>>>>>>>>>>>>    End_Procedure
25096>>>>>>>>>>>>>>>    
25096>>>>>>>>>>>>>>>    Procedure Refill
25098>>>>>>>>>>>>>>>        String[] aParams
25099>>>>>>>>>>>>>>>        Move True to aParams[0]
25100>>>>>>>>>>>>>>>        Send ClientAction "suggestLoad" aParams
25101>>>>>>>>>>>>>>>    End_Procedure
25102>>>>>>>>>>>>>>>    
25102>>>>>>>>>>>>>>>    Procedure FindSuggestions String sFilter Integer iPage Integer iAdditionalItems
25104>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25104>>>>>>>>>>>>>>>        tSelectionItem[] aItems
25105>>>>>>>>>>>>>>>        Handle hoJson hoSelectionSource
25105>>>>>>>>>>>>>>>        Boolean bLast bIsObj bAllData bSuggestions bPaged
25105>>>>>>>>>>>>>>>        tSelectionItem prevItem
25105>>>>>>>>>>>>>>>        tSelectionItem prevItem
25105>>>>>>>>>>>>>>>        String[] aParams
25106>>>>>>>>>>>>>>>        Integer iPageSize
25106>>>>>>>>>>>>>>>            
25106>>>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
25107>>>>>>>>>>>>>>>        Get pbAllData of hoSelectionSource to bAllData
25108>>>>>>>>>>>>>>>        Get pbSuggestions of hoSelectionSource to bSuggestions
25109>>>>>>>>>>>>>>>        Get pbPaged of hoSelectionSource to bPaged
25110>>>>>>>>>>>>>>>        WebGet piPageSize to iPageSize
25111>>>>>>>>>>>>>>>        Send ValidateSuggestionMode bAllData bSuggestions bPaged
25112>>>>>>>>>>>>>>>        
25112>>>>>>>>>>>>>>>        If (not(bPaged)) Begin
25114>>>>>>>>>>>>>>>            Move 0 to iPage
25115>>>>>>>>>>>>>>>        End
25115>>>>>>>>>>>>>>>>
25115>>>>>>>>>>>>>>>        If (not(bPaged) and not(bSuggestions)) Begin
25117>>>>>>>>>>>>>>>            Move 0 to iAdditionalItems
25118>>>>>>>>>>>>>>>        End
25118>>>>>>>>>>>>>>>>
25118>>>>>>>>>>>>>>>
25118>>>>>>>>>>>>>>>        // Additional items are required when selected tags are filtered out client-side.
25118>>>>>>>>>>>>>>>        If (bPaged or bSuggestions) ;            Move (iPageSize + iAdditionalItems) to iPageSize
25121>>>>>>>>>>>>>>>        
25121>>>>>>>>>>>>>>>        Get phoActionJsonData to hoJson
25122>>>>>>>>>>>>>>>        If (hoJson > 0) Begin
25124>>>>>>>>>>>>>>>            Get JsonToDataType of hoJson to prevItem
25125>>>>>>>>>>>>>>>        End
25125>>>>>>>>>>>>>>>>
25125>>>>>>>>>>>>>>>        If (not(bPaged)) Begin
25127>>>>>>>>>>>>>>>            Move (ResizeArray(prevItem.aValues, 0)) to prevItem.aValues
25128>>>>>>>>>>>>>>>            Move "" to prevItem.sRowId
25129>>>>>>>>>>>>>>>            Move "" to prevItem.sCssClassName
25130>>>>>>>>>>>>>>>            Move False to prevItem.bServer
25131>>>>>>>>>>>>>>>        End
25131>>>>>>>>>>>>>>>>
25131>>>>>>>>>>>>>>>        
25131>>>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
25133>>>>>>>>>>>>>>>            Send FetchItems of hoSelectionSource (&aItems) (&bLast) sFilter prevItem iPageSize iPage
25134>>>>>>>>>>>>>>>            If (pbAllData(hoSelectionSource)) Begin
25136>>>>>>>>>>>>>>>                Move True to bLast
25137>>>>>>>>>>>>>>>            End
25137>>>>>>>>>>>>>>>>
25137>>>>>>>>>>>>>>>        End
25137>>>>>>>>>>>>>>>>
25137>>>>>>>>>>>>>>>        
25137>>>>>>>>>>>>>>>        Send OnFindSuggestions (&aItems) (&bLast) sFilter prevItem iPage
25138>>>>>>>>>>>>>>>        If (bSuggestions) Begin
25140>>>>>>>>>>>>>>>            Move True to bLast
25141>>>>>>>>>>>>>>>        End
25141>>>>>>>>>>>>>>>>
25141>>>>>>>>>>>>>>>        
25141>>>>>>>>>>>>>>>        Send InitializeCustomButtons (&aItems) bLast sFilter
25142>>>>>>>>>>>>>>>        
25142>>>>>>>>>>>>>>>        Move sFilter to aParams[0]
25143>>>>>>>>>>>>>>>        Move (String(bLast)) to aParams[1]
25144>>>>>>>>>>>>>>>        Send ClientAction "suggestHandle" aParams aItems iPage
25145>>>>>>>>>>>>>>>    End_Procedure
25146>>>>>>>>>>>>>>>    
25146>>>>>>>>>>>>>>>    Procedure AddCustomActionButton tSelectionItem[] ByRef aItems String sRowId String sText
25148>>>>>>>>>>>>>>>        tSelectionItem tCustomItem
25148>>>>>>>>>>>>>>>        tSelectionItem tCustomItem
25148>>>>>>>>>>>>>>>        
25148>>>>>>>>>>>>>>>        Move True to tCustomItem.bServer
25149>>>>>>>>>>>>>>>        Move sRowId to tCustomItem.sRowId
25150>>>>>>>>>>>>>>>        Move sText to tCustomItem.aValues[0]
25151>>>>>>>>>>>>>>>        Move "Sugg_ControlSuggestion" to tCustomItem.sCssClassName 
25152>>>>>>>>>>>>>>>        Move tCustomItem to aItems[-1]
25153>>>>>>>>>>>>>>>    End_Procedure
25154>>>>>>>>>>>>>>>    
25154>>>>>>>>>>>>>>>    Function HasAdvancedSearchPrompt Returns Boolean
25156>>>>>>>>>>>>>>>        tWebForwardPath[] aNavInfo
25156>>>>>>>>>>>>>>>        tWebForwardPath[] aNavInfo
25157>>>>>>>>>>>>>>>        Handle hoPrompt
25157>>>>>>>>>>>>>>>        
25157>>>>>>>>>>>>>>>        Get PromptObject to hoPrompt
25158>>>>>>>>>>>>>>>        If (hoPrompt) Begin
25160>>>>>>>>>>>>>>>            Function_Return True
25161>>>>>>>>>>>>>>>        End
25161>>>>>>>>>>>>>>>>
