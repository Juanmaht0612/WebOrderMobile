54086>>>                    Boolean bFound
54086>>>                    RowID riTable
54086>>>
54086>>>                    Move (DeserializeRowId (NavigateData.sRowId)) to riTable
54087>>>                    If (not (IsNullRowId (riTable))) Begin
54089>>>                        Move (FindByRowID (NavigateData.iTable, riTable)) to bFound
54090>>>                        WebSet psValue to Customer.Customer_Number
54091>>>                    End
54091>>>>
54091>>>                End_Procedure
54092>>>            End_Object
54093>>>
