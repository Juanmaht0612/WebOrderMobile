51768>>>                Procedure OnLocationChange Number nLatitude Number nLongitude Number nAccuracy Number nSpeed Number nHeading
51771>>>                    Integer iCount
51771>>>                    
51771>>>                    WebSet psValue of oLatFrm to nLatitude    
51772>>>                    WebSet psValue of oLongFrm to nLongitude
51773>>>                    WebSet piValue of oAccuracyBar to (Round(150.0 - nAccuracy) max 0)
51774>>>                    WebSet psCaption of oAccuracyBar to (String(nAccuracy) + " m")
51775>>>                    WebSet psValue of oSpeedFrm to nSpeed
51776>>>                    WebSet psValue of oHeadingFrm to nHeading
51777>>>                    
51777>>>                    WebGet piCount to iCount
51778>>>                    Increment iCount
51779>>>                    WebSet piCount to iCount
51780>>>                    WebSet psValue of oCountFrm to iCount
51781>>>                    
51781>>>                    WebSet pnSpeed to 232.1
51782>>>                    WebSet pbRender of oErrorLbl to False
51783>>>                End_Procedure
