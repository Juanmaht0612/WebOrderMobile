37809>>>>>>>    // sFontWeight: Optional, The amount of weight of a font in as a CSS property
37809>>>>>>>    // sTextDecoration: Optional, the type of decoration used for text. For example, underline and overline.
37809>>>>>>>    Procedure CreateText String sId tWebPoint position String sContent String sFontFamily Float fFontSize Integer eJustification String sFontWeight String sTextDecoration
37811>>>>>>>        String[] asParams
