33426>>>>>>>        Move (Lowercase(Trim(Right(sFile, Length(sFile) - RightPos(".", sFile))))) to sExt
33427>>>>>>>        
33427>>>>>>>        Case Begin
33427>>>>>>>            Case (sExt = "jpg")
33429>>>>>>>            Case (sExt = "jpeg")
33432>>>>>>>                Function_Return "image/jpeg"
33433>>>>>>>            Case (sExt = "gif")
33436>>>>>>>                Function_Return "image/gif"
33437>>>>>>>            Case (sExt = "png")
33440>>>>>>>                Function_Return "image/png"
33441>>>>>>>            Case (sExt = "svg")
33444>>>>>>>                Function_Return "image/svg"
33445>>>>>>>            Case (sExt = "tiff")
33448>>>>>>>                Function_Return "image/tiff"
33449>>>>>>>            Case (sExt = "bmp")
33452>>>>>>>                Function_Return "image/bmp"
33453>>>>>>>            Case (sExt = "ico")
33456>>>>>>>                Function_Return "image/x-icon"
33457>>>>>>>            Case Else 
33457>>>>>>>                Function_Return ("image/" + sExt)
33458>>>>>>>        Case End
33458>>>>>>>        
33458>>>>>>>    End_Function
