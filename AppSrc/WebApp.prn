29531>>>>>>>>>>>    //  Searches for a token in the current chunk starting at the current position (iChunkRead). It
29531>>>>>>>>>>>    //  will peek in the next chunk if the token starts in the current chunk and continues into the
29531>>>>>>>>>>>    //  next chunk. It will not search the next chunk. 
29531>>>>>>>>>>>    //
29531>>>>>>>>>>>    //  Params:
29531>>>>>>>>>>>    //      parseData   Parsing data.
29531>>>>>>>>>>>    //      ucToken     Token to find in the current chunk data.
29531>>>>>>>>>>>    //      bSkip       If true it will move the current position (iChunkRead) past the found token.
29531>>>>>>>>>>>    //      bBoundary   If true it will not search past the next boundary (iBoundPos).
29531>>>>>>>>>>>    //  Returns:
29531>>>>>>>>>>>    //      The start position of the token, -1 if the token is not found in the current chunk.
29531>>>>>>>>>>>    Function FindToken tMultipartParsingData ByRef parsedata UChar[] ucToken Boolean bSkip Boolean bBoundary Returns Integer
29533>>>>>>>>>>>        Integer iTokenPos iSplit iRead
29533>>>>>>>>>>>        Boolean bEqual
29533>>>>>>>>>>>        
29533>>>>>>>>>>>        //  If we are already at the split then we move to the next chunk (we don't want to miss out out on tokens starting on the split)
29533>>>>>>>>>>>        If (bSkip and parsedata.iChunkRead >= SizeOfArray(parsedata.ucCurrentChunk)) Begin
29535>>>>>>>>>>>            Send ReadChunk (&parsedata)
29536>>>>>>>>>>>        End
29536>>>>>>>>>>>>
29536>>>>>>>>>>>        
29536>>>>>>>>>>>        Move parsedata.iChunkRead to iRead
29537>>>>>>>>>>>        
29537>>>>>>>>>>>        //  Search data for initial character
29537>>>>>>>>>>>        Repeat
29537>>>>>>>>>>>>
29537>>>>>>>>>>>            Move (SearchArray(ucToken[0], (&parsedata.ucCurrentChunk), iRead)) to iTokenPos
29538>>>>>>>>>>>            If (iTokenPos >= 0) Begin
29540>>>>>>>>>>>                If (bBoundary and parsedata.iBoundPos >= 0 and iTokenPos >= parsedata.iBoundPos) Begin
29542>>>>>>>>>>>                    Function_Return -1
29543>>>>>>>>>>>                End
29543>>>>>>>>>>>>
29543>>>>>>>>>>>                
29543>>>>>>>>>>>                //  See if this is really the boundary
29543>>>>>>>>>>>                Move (MemCompare(AddressOf(ucToken), AddressOf(parsedata.ucCurrentChunk[iTokenPos]), (SizeOfArray(ucToken) min (SizeOfArray(parsedata.ucCurrentChunk) - iTokenPos))) = 0) to bEqual
29544>>>>>>>>>>>                If (bEqual) Begin
29546>>>>>>>>>>>                
29546>>>>>>>>>>>                    //  Boundary is possibly split between chunks, compare next chunk
29546>>>>>>>>>>>                    Move (SizeOfArray(ucToken) - (SizeOfArray(parsedata.ucCurrentChunk) - iTokenPos)) to iSplit
29547>>>>>>>>>>>                    If (iSplit > 0) Begin
29549>>>>>>>>>>>                        If (iSplit < SizeOfArray(parsedata.ucNextChunk)) Begin
29551>>>>>>>>>>>                            Move (MemCompare(AddressOf(ucToken[SizeOfArray(ucToken) - iSplit]), AddressOf(parsedata.ucNextChunk), iSplit) = 0) to bEqual
29552>>>>>>>>>>>                            
29552>>>>>>>>>>>                            If (bEqual and bSkip) Begin
29554>>>>>>>>>>>                                Send ReadChunk (&parsedata)
29555>>>>>>>>>>>                                Move iSplit to parsedata.iChunkRead
29556>>>>>>>>>>>                                Function_Return 0
29557>>>>>>>>>>>                            End    
29557>>>>>>>>>>>>
29557>>>>>>>>>>>                        End
29557>>>>>>>>>>>>
29557>>>>>>>>>>>                        Else Begin
29558>>>>>>>>>>>                            Function_Return -1
29559>>>>>>>>>>>                        End
29559>>>>>>>>>>>>
29559>>>>>>>>>>>                    End
29559>>>>>>>>>>>>
29559>>>>>>>>>>>                    
29559>>>>>>>>>>>                    //  Check for a regular match
29559>>>>>>>>>>>                    If (bEqual) Begin
29561>>>>>>>>>>>                        If (bSkip) Begin
29563>>>>>>>>>>>                            Move (iTokenPos + SizeOfArray(ucToken)) to parsedata.iChunkRead
29564>>>>>>>>>>>                        End
29564>>>>>>>>>>>>
29564>>>>>>>>>>>                        
29564>>>>>>>>>>>                        Function_Return iTokenPos
29565>>>>>>>>>>>                    End
29565>>>>>>>>>>>>
29565>>>>>>>>>>>                    
29565>>>>>>>>>>>                End
29565>>>>>>>>>>>>
29565>>>>>>>>>>>                
29565>>>>>>>>>>>                Move (iTokenPos + 1) to iRead
29566>>>>>>>>>>>            End
29566>>>>>>>>>>>>
29566>>>>>>>>>>>        Until (iTokenPos < 0 )
29568>>>>>>>>>>>        
29568>>>>>>>>>>>        Function_Return iTokenPos
29569>>>>>>>>>>>    End_Function
