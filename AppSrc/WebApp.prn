41803>>>    Procedure SetActionButtons
41806>>>        tWebNavigateData NavigateData
41806>>>        tWebNavigateData NavigateData
41806>>>        Boolean bHasRecord
41806>>>        Handle hoDD
41806>>>        String sTitle
41806>>>        
41806>>>        Get Server to hoDD
41807>>>        Get GetNavigateData to NavigateData
41808>>>        Get HasRecord of hoDD to bHasRecord
41809>>>        
41809>>>        WebSet pbRender of oNewBtn to True
41810>>>        WebSet pbRender of oSaveBtn to False
41811>>>        WebSet pbRender of oEditBtn to False
41812>>>        WebSet pbRender of oDeleteBtn to False
41813>>>        
41813>>>        If (NavigateData.bReadOnly) Begin
41815>>>            WebSet pbRender of oEditBtn to True
41816>>>        End
41816>>>>
41816>>>        Else Begin
41817>>>            WebSet pbRender of oSaveBtn to True
41818>>>            WebSet pbRender of oDeleteBtn to bHasRecord
41819>>>        End
41819>>>>
41819>>>        
41819>>>        If bHasRecord Begin
41821>>>            Move ("Order" * String(OrderHeader.Order_Number)) to sTitle
41822>>>        End
41822>>>>
41822>>>        Else Begin
41823>>>            Move "New Order" to sTitle
41824>>>        End
41824>>>>
41824>>>        Send SetBreadcrumbCaption sTitle
41825>>>        Send SetHeaderCaption sTitle
41826>>>    End_Procedure
