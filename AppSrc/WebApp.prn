29599>>>>>>>>>>>        tMultipartParsingData parsedata
29599>>>>>>>>>>>        UChar[] ucValue ucNewLine ucChunk
29602>>>>>>>>>>>        tNameValuePair[] aContentValues
29602>>>>>>>>>>>        tNameValuePair[] aContentValues
29603>>>>>>>>>>>        tNameValuePair tSearch
29603>>>>>>>>>>>        tNameValuePair tSearch
29603>>>>>>>>>>>        
29603>>>>>>>>>>>        Set piParseErrorCode to 0
