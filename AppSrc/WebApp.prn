23842>>>>>>>>>>>>>>>>>>>    Procedure Define_cBaseDEO_Mixin
23844>>>>>>>>>>>>>>>>>>>        
23844>>>>>>>>>>>>>>>>>>>        Property Boolean Auto_Fill_State False       // Used to tell DDO's whether first record should be found automatically after a clear.
23845>>>>>>>>>>>>>>>>>>>        Property Boolean pbAutoFillOnInit False       // Used to tell DDO's that we want autofill on initialization when DEO is attaching
23846>>>>>>>>>>>>>>>>>>>        
23846>>>>>>>>>>>>>>>>>>>        Property Integer private_Server 0
23847>>>>>>>>>>>>>>>>>>>        Property Integer Watched_Servers 0          // Handle to Broadcaster object broacasting tos server DDO's
23848>>>>>>>>>>>>>>>>>>>        // used to send Set Changed_State to "foreign" servers, while Watched_Servers
23848>>>>>>>>>>>>>>>>>>>        // is used for sending messages from the DDO to DEOs (there are more of them)
23848>>>>>>>>>>>>>>>>>>>        Property Integer ChangedStateWatched_Servers     0
23849>>>>>>>>>>>>>>>>>>>        Property Integer private_pbServersScanned 0
23850>>>>>>>>>>>>>>>>>>>        
23850>>>>>>>>>>>>>>>>>>>        // added to support DEO request-delegation. This is set true if the
23850>>>>>>>>>>>>>>>>>>>        // server is explicitly set in this DEO (normally via a USING parameter).
23850>>>>>>>>>>>>>>>>>>>        Property Integer Explicit_Server_State False
23851>>>>>>>>>>>>>>>>>>>        
23851>>>>>>>>>>>>>>>>>>>        // Since this package's SET changed_state is using change_disabled_state
23851>>>>>>>>>>>>>>>>>>>        // we might as well Define it here. This gets changed by Clear_mx to support
23851>>>>>>>>>>>>>>>>>>>        // setting of defaults without changing the objects changed_state.
23851>>>>>>>>>>>>>>>>>>>        //
23851>>>>>>>>>>>>>>>>>>>        // This stops changed_state from getting changed. It allows item_changed_state
23851>>>>>>>>>>>>>>>>>>>        // to change without the object's changed_state getting changed. This Should
23851>>>>>>>>>>>>>>>>>>>        // be considered protected (i.e., likely to change). The new messages Entry_Defaults
23851>>>>>>>>>>>>>>>>>>>        // and Set Default_Value are both public and Use this. Try to use these messages
23851>>>>>>>>>>>>>>>>>>>        // instead of this Property.
23851>>>>>>>>>>>>>>>>>>>        Property Integer Change_Disabled_State False
23852>>>>>>>>>>>>>>>>>>>        
23852>>>>>>>>>>>>>>>>>>>        Property Boolean Extended_DEO_State False    // Defines DEO behavior according to Extended_DEO_State of the server DDO
23853>>>>>>>>>>>>>>>>>>>        
23853>>>>>>>>>>>>>>>>>>>        Property Boolean Active_State False          // True when the DEO has been attached to the DDO
23854>>>>>>>>>>>>>>>>>>>                
23854>>>>>>>>>>>>>>>>>>>        // these can be set via entry_item command....
23854>>>>>>>>>>>>>>>>>>>        Property Integer private_Data_File 0    // The binding table
23855>>>>>>>>>>>>>>>>>>>        Property Integer private_Data_Field 0   // The binding table column
23856>>>>>>>>>>>>>>>>>>>        
23856>>>>>>>>>>>>>>>>>>>        Set pbDataBindable to True
23857>>>>>>>>>>>>>>>>>>>        
23857>>>>>>>>>>>>>>>>>>>    End_Procedure
