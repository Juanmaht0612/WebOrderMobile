20883>>>>>>>>>    
20883>>>>>>>>>    // Send by the cWebCallHandler_mixin when request processing is cancelled. In this case we 
20883>>>>>>>>>    // only want to send error client actions back to the client.
20883>>>>>>>>>    Procedure Call_PostErrorOnlyClientActions tWebCallContext ByRef cctx
20885>>>>>>>>>        tWebClientAction[] aEmpty aActions
20885>>>>>>>>>        tWebClientAction[] aEmpty aActions
20887>>>>>>>>>        Integer iAction iActionTo
20887>>>>>>>>>        
20887>>>>>>>>>        Get paClientActions to aActions
20888>>>>>>>>>        Move (SizeOfArray(aActions) - 1) to iActionTo
20889>>>>>>>>>        For iAction from 0 to iActionTo
20895>>>>>>>>>>
20895>>>>>>>>>            If (aActions[iAction].sName = "showError") ;                Move aActions[iAction] to cctx.response.Header.aActions[iAction]
20898>>>>>>>>>        Loop
20899>>>>>>>>>>
20899>>>>>>>>>        
20899>>>>>>>>>        Set paClientActions to aEmpty
20900>>>>>>>>>    End_Procedure
20901>>>>>>>>>    
20901>>>>>>>>>    // Retrieves an attachment from the request based on its index.
20901>>>>>>>>>    //
20901>>>>>>>>>    // Params:
20901>>>>>>>>>    //  iIndex  Attachment index (1 based).
20901>>>>>>>>>    // Returns:
20901>>>>>>>>>    //  JSON Object handle.
20901>>>>>>>>>    Function RequestAttachment Integer iIndex Returns Handle
20903>>>>>>>>>        Handle hoAttachments
20903>>>>>>>>>        
20903>>>>>>>>>        Get phoRequestAttachments to hoAttachments
20904>>>>>>>>>        If (hoAttachments <> C_WebUnresolvedObject) Begin
20906>>>>>>>>>            If (IsOfJsonType(hoAttachments, jsonTypeArray)) Begin
20908>>>>>>>>>                If (MemberCount(hoAttachments) > (iIndex - 1)) Begin
20910>>>>>>>>>                    Function_Return (MemberByIndex(hoAttachments, (iIndex - 1)))
20911>>>>>>>>>                End
20911>>>>>>>>>>
20911>>>>>>>>>                Else Begin
20912>>>>>>>>>                    Error DFERR_PROGRAM "Request attachment index out of bounds."
20913>>>>>>>>>>
20913>>>>>>>>>                End
20913>>>>>>>>>>
20913>>>>>>>>>            End
20913>>>>>>>>>>
20913>>>>>>>>>            Else Begin
20914>>>>>>>>>                Error DFERR_PROGRAM "No request attachments available."
20915>>>>>>>>>>
20915>>>>>>>>>            End 
20915>>>>>>>>>>
20915>>>>>>>>>        End
20915>>>>>>>>>>
20915>>>>>>>>>        Else Begin
20916>>>>>>>>>            Error DFERR_PROGRAM "No request attachments available."
20917>>>>>>>>>>
20917>>>>>>>>>        End
20917>>>>>>>>>>
20917>>>>>>>>>        
20917>>>>>>>>>        Function_Return C_WebUnresolvedObject
20918>>>>>>>>>    End_Function
20919>>>>>>>>>    
20919>>>>>>>>>    
20919>>>>>>>>>    // Adds an attachment to the response and returns the integer id.
20919>>>>>>>>>    //
20919>>>>>>>>>    // Params:
20919>>>>>>>>>    //  hoJsonObject    cJsonObject handle representing the attachment.
20919>>>>>>>>>    // Returns:
20919>>>>>>>>>    //  The attachment index (1 based).
20919>>>>>>>>>    Function AddResponseAttachment Handle hoJsonObject Returns Integer
20921>>>>>>>>>        Handle hoAttachments
20921>>>>>>>>>        Integer iIndex
20921>>>>>>>>>        Move -1 to iIndex
20922>>>>>>>>>        
20922>>>>>>>>>        Get phoResponseAttachments to hoAttachments
20923>>>>>>>>>        If (hoAttachments = C_WebUnresolvedObject) Begin
20925>>>>>>>>>            Get Create (RefClass(cJsonObject)) to hoAttachments
20926>>>>>>>>>            Send InitializeJsonType of hoAttachments jsonTypeArray
20927>>>>>>>>>            Set phoResponseAttachments to hoAttachments
20928>>>>>>>>>        End
20928>>>>>>>>>>
20928>>>>>>>>>        Get MemberCount of hoAttachments to iIndex
20929>>>>>>>>>        Increment iIndex
20930>>>>>>>>>        Send AddMember of hoAttachments hoJsonObject
20931>>>>>>>>>        
20931>>>>>>>>>        Function_Return iIndex
20932>>>>>>>>>    End_Function
20933>>>>>>>>>    
20933>>>>>>>>>    // Determines the current action state for client actions.
20933>>>>>>>>>    Function OwnerActionState Handle hoWO Returns Integer
20935>>>>>>>>>        Function_Return ctExecDefault
20936>>>>>>>>>    End_Function
20937>>>>>>>>>    
20937>>>>>>>>>    // Adds a ClientAction to be executed during the next response.
20937>>>>>>>>>    // tClientAction    - Is the action to be executed
20937>>>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
20939>>>>>>>>>        tWebClientAction[] aClientActions
20939>>>>>>>>>        tWebClientAction[] aClientActions
20940>>>>>>>>>        
20940>>>>>>>>>        Get paClientActions to aClientActions
20941>>>>>>>>>        Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
20942>>>>>>>>>        Set paClientActions to aClientActions
20943>>>>>>>>>    End_Procedure    
20944>>>>>>>>>    
20944>>>>>>>>>    
20944>>>>>>>>>    // Cancels a client action that was scheduled.
20944>>>>>>>>>    // tClientAction    - Is the action to be executed
20944>>>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
20946>>>>>>>>>        tWebClientAction[] aClientActions
20946>>>>>>>>>        tWebClientAction[] aClientActions
20947>>>>>>>>>        Integer iCur
20947>>>>>>>>>        String sTarget
20947>>>>>>>>>        Handle hoAttachments
20947>>>>>>>>>        
20947>>>>>>>>>        Get WebObjectName of hoWO to sTarget
20948>>>>>>>>>        Get paClientActions to aClientActions
20949>>>>>>>>>        
20949>>>>>>>>>        For iCur from 0 to (SizeOfArray(aClientActions) - 1)
20955>>>>>>>>>>
20955>>>>>>>>>            If (aClientActions[iCur].sTarget = sTarget and aClientActions[iCur].sName = sName) Begin
20957>>>>>>>>>                //  Clear attachment
20957>>>>>>>>>                If (aClientActions[iCur].iAttached <> 0) Begin
20959>>>>>>>>>                    Get phoResponseAttachments to hoAttachments
20960>>>>>>>>>                    Send SetMemberValue of hoAttachments (aClientActions[iCur].iAttached - 1) jsonTypeNull 0        
20961>>>>>>>>>                End
20961>>>>>>>>>>
20961>>>>>>>>>                
20961>>>>>>>>>                Move (RemoveFromArray(aClientActions, iCur)) to aClientActions
20962>>>>>>>>>                
20962>>>>>>>>>                Decrement iCur
20963>>>>>>>>>            End
20963>>>>>>>>>>
20963>>>>>>>>>        Loop
20964>>>>>>>>>>
20964>>>>>>>>>        
20964>>>>>>>>>        Set paClientActions to aClientActions
20965>>>>>>>>>    End_Procedure
20966>>>>>>>>>    
20966>>>>>>>>>
20966>>>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
20966>>>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
20966>>>>>>>>>    //  find the Object it will cause an Error and return C_WebUnresolvedObject (0).
20966>>>>>>>>>    //      sObjectName - Name of the web object.
20966>>>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
20968>>>>>>>>>        Handle hoObj
20968>>>>>>>>>        Boolean bErr
20968>>>>>>>>>        
20968>>>>>>>>>        Move True to bErr
20969>>>>>>>>>        If (num_arguments > 1) ;            Move bOptErr to bErr
20972>>>>>>>>>        
20972>>>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName bErr to hoObj
20973>>>>>>>>>        
20973>>>>>>>>>        If (hoObj = C_WebUnresolvedObject and bErr) Begin
20975>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sObjectName))
20976>>>>>>>>>>
20976>>>>>>>>>        End
20976>>>>>>>>>>
20976>>>>>>>>>        
20976>>>>>>>>>        Function_Return hoObj
20977>>>>>>>>>    End_Function
20978>>>>>>>>>    
20978>>>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
20978>>>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
20978>>>>>>>>>    //  find the Object it will return C_WebUnresolvedObject (0).
20978>>>>>>>>>    //      sObjectName - Name of the web object.
20978>>>>>>>>>    Function FindWebObjectSilent String sObjectName Returns Handle
20980>>>>>>>>>        Handle hoObj
20980>>>>>>>>>        
20980>>>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName False to hoObj
20981>>>>>>>>>        
20981>>>>>>>>>        Function_Return hoObj
20982>>>>>>>>>    End_Function
