39375>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
39377>>>>>        String sSessionKey sUserPassword
39377>>>>>        Handle hoSessionDD hoUserDD
39377>>>>>        Boolean bMatch bUpgrade
39377>>>>>        
39377>>>>>        Get phoSessionDD to hoSessionDD
39378>>>>>        Get phoUserDD to hoUserDD
39379>>>>>        Integer iErr eLoginMode
39379>>>>>        
39379>>>>>        // Refind session record
39379>>>>>        Get psSessionKey to sSessionKey
39380>>>>>        Send Clear of hoSessionDD
39381>>>>>        Move sSessionKey to WebAppSession.SessionKey
39382>>>>>        Send Find of hoSessionDD EQ Index.1
39383>>>>>        
39383>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
39385>>>>>            Get peLoginMode to eLoginMode
39386>>>>>            
39386>>>>>            //  Find the user
39386>>>>>            Move sLoginName to WebAppUser.LoginName
39387>>>>>            Send Find of hoUserDD EQ Index.1
39388>>>>>            
39388>>>>>            // Check username and password
39388>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
39390>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
39391>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
39392>>>>>                
39392>>>>>                If (bMatch) Begin
39394>>>>>                    // Store the login
39394>>>>>                    If (bUpgrade) Begin
39396>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
39397>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
39400>>>>>                    End
39400>>>>>>
39400>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
39401>>>>>                    Get Request_Validate of hoSessionDD to iErr
39402>>>>>                    If (iErr) Begin
39404>>>>>                        // this should not happen. If it does its a programming error
39404>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
39405>>>>>>
39405>>>>>                        Function_Return False
39406>>>>>                    End
39406>>>>>>
39406>>>>>                    
39406>>>>>                    Send Request_Save of hoSessionDD
39407>>>>>                    
39407>>>>>                    // Update session properties
39407>>>>>                    Send UpdateSessionProperties False
39408>>>>>                    Send NotifyChangeRights
39409>>>>>                    Function_Return True
39410>>>>>                End
39410>>>>>>
39410>>>>>                Else Begin
39411>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
39411>>>>>                    Send Clear of hoUserDD
39412>>>>>                End
39412>>>>>>
39412>>>>>            End
39412>>>>>>
39412>>>>>            Else Begin
39413>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
39413>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
39414>>>>>            End
39414>>>>>>
39414>>>>>        End
39414>>>>>>
39414>>>>>        Else Begin
39415>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
39415>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
39416>>>>>        End
39416>>>>>>
39416>>>>>          
39416>>>>>        Function_Return False
39417>>>>>    End_Function
