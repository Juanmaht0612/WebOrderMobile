44198>>>>>>>    
44198>>>>>>>    Function GenerateUniqueID Returns String
44200>>>>>>>        String[] sWidgets
44201>>>>>>>        String sId sRand
44201>>>>>>>        Integer i iWidgets
44201>>>>>>>        
44201>>>>>>>        Get DynamicChildren "" to sWidgets
44202>>>>>>>        Get GenRandomString 10 to sRand
44203>>>>>>>        
44203>>>>>>>        Move ('Widget-' + sRand) to sId
44204>>>>>>>
44204>>>>>>>        Get DynamicChildren "" to sWidgets
44205>>>>>>>        
44205>>>>>>>        // Check if ID already exists (astronomically small chance, but still), if so; try again
44205>>>>>>>        Move (SizeOfArray(sWidgets) - 1) to iWidgets
44206>>>>>>>        For i from 0 to iWidgets
44212>>>>>>>>
44212>>>>>>>            If (sWidgets[i] = sId) Begin
44214>>>>>>>                Get GenerateUniqueID to sId
44215>>>>>>>                Function_Return sId
44216>>>>>>>            End
44216>>>>>>>>
44216>>>>>>>        Loop
44217>>>>>>>>
44217>>>>>>>        
44217>>>>>>>        Function_Return sId
44218>>>>>>>    End_Function
44219>>>>>>>    
44219>>>>>>>    Function GenRandomString Integer iLen Returns String
44221>>>>>>>        String sRet
44221>>>>>>>        Integer i iBase
44221>>>>>>>        
44221>>>>>>>        Move (Ascii("a")) to iBase
44222>>>>>>>        
44222>>>>>>>        For i from 1 to iLen
44228>>>>>>>>
44228>>>>>>>            Add (Character(Random(26) + iBase)) to sRet
44229>>>>>>>        Loop
44230>>>>>>>>
44230>>>>>>>        
44230>>>>>>>        Function_Return sRet
44231>>>>>>>    End_Function
44232>>>>>>>    
44232>>>>>>>    
44232>>>>>>>    Procedure AddWidget tWidgetDef WidgetDef
44234>>>>>>>        Handle hWidgetClass hoWidget
44234>>>>>>>        Boolean bIsWidget bSuccess bAllowed
44234>>>>>>>        String sObj
44234>>>>>>>        String[] aParams asObjIds
44236>>>>>>>        tWebDynamicObject[] aObjs
44236>>>>>>>        tWebDynamicObject[] aObjs
44237>>>>>>>        tWidgetRegistration widgetDefault
44237>>>>>>>        tWidgetRegistration widgetDefault
44237>>>>>>>        
44237>>>>>>>        Get WidgetRegistrationByName WidgetDef.sName to widgetDefault
44238>>>>>>>        Move widgetDefault.hClass to hWidgetClass
44239>>>>>>>        Get IsClassOfClass hWidgetClass (RefClass(cWebWidget)) to bIsWidget
44240>>>>>>>        
44240>>>>>>>        If (hWidgetClass <> 0 and bIsWidget) Begin
44242>>>>>>>            Get OnBeforeAddWidget (&WidgetDef) (&hWidgetClass) to bSuccess
44243>>>>>>>            
44243>>>>>>>            If (bSuccess) Begin
44245>>>>>>>                If (WidgetDef.sDynId = "") ;                    Get GenerateUniqueId to WidgetDef.sDynId
44248>>>>>>>                
44248>>>>>>>                Get DynamicChildren "" to asObjIds
44249>>>>>>>               
44249>>>>>>>                Get CreateDynamicObject hWidgetClass WidgetDef.sDynId '' to hoWidget
44250>>>>>>>                
44250>>>>>>>                If (hoWidget = 0) Begin
44252>>>>>>>                    Procedure_Return
44253>>>>>>>                End
44253>>>>>>>>
44253>>>>>>>                
44253>>>>>>>                Get AllowViewAccess of (Host(Self)) hoWidget to bAllowed
44254>>>>>>>                
44254>>>>>>>                If (not(bAllowed)) Begin
44256>>>>>>>                    Procedure_Return
44257>>>>>>>                End
44257>>>>>>>>
44257>>>>>>>                
44257>>>>>>>                Send InitDynamicProp of hoWidget 'psDynamicWidgetId'    WidgetDef.sDynId
44258>>>>>>>                Send InitDynamicProp of hoWidget 'piRowIndex'           WidgetDef.iRowIndex
44259>>>>>>>                Send InitDynamicProp of hoWidget 'piColumnIndex'        WidgetDef.iColIndex
44260>>>>>>>                Send InitDynamicProp of hoWidget 'piRowSpan'            WidgetDef.iRowSpan
44261>>>>>>>                Send InitDynamicProp of hoWidget 'piColumnSpan'         WidgetDef.iColSpan
44262>>>>>>>                Send InitDynamicProp of hoWidget 'pbFillHeight'         True
44263>>>>>>>                
44263>>>>>>>                Send InitWidget of hoWidget
44264>>>>>>>                
44264>>>>>>>                If ((SizeOfArray(asObjIds)) > 0) Begin
44266>>>>>>>                   Send AppendDynamicObject WidgetDef.sDynId 
44267>>>>>>>                End
44267>>>>>>>>
44267>>>>>>>                Else Begin
44268>>>>>>>                    Send Activate
44269>>>>>>>                End
44269>>>>>>>>
44269>>>>>>>                
44269>>>>>>>                Send AddWidgetLocal WidgetDef hoWidget
44270>>>>>>>                
44270>>>>>>>                Send OnWidgetAdded WidgetDef hWidgetClass
44271>>>>>>>                
44271>>>>>>>                Send RefreshOverlay
44272>>>>>>>            End
44272>>>>>>>>
44272>>>>>>>        End
44272>>>>>>>>
44272>>>>>>>    End_Procedure
44273>>>>>>>    
44273>>>>>>>    // Called through the wrapper API
44273>>>>>>>    // Sends the WidgetDef to the client (only needs sWidgetName, iRowSpan & iColSpan)
44273>>>>>>>    // The client then finds a suitable spot for the widget and places the first possible location in the WidgetDef struct
44273>>>>>>>    // The client then calls AppendWidgetEx with the updated WidgetDef struct, which adds the at the determined location
44273>>>>>>>    Procedure AppendWidget tWidgetDef WidgetDef
44275>>>>>>>        Handle hoJsonData
44275>>>>>>>        String[] aParams
44276>>>>>>>        
44276>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
44277>>>>>>>        Send DataTypeToJson of hoJsonData WidgetDef
44278>>>>>>>        
44278>>>>>>>        Send ClientActionEx 'findSpotForWidget' aParams hoJsonData
44279>>>>>>>        
44279>>>>>>>        Send Destroy of hoJsonData
44280>>>>>>>    End_Procedure
44281>>>>>>>    
44281>>>>>>>    // Called by from the client after the AppendWidget instruction
44281>>>>>>>    // The client finds a suitable spot for the widget and sends the first possible location in the updated WidgetDef struct
44281>>>>>>>    Procedure AppendWidgetEx
44283>>>>>>>        tWidgetDef WidgetDef
44283>>>>>>>        tWidgetDef WidgetDef
44283>>>>>>>        Handle hoJson
44283>>>>>>>        
44283>>>>>>>        Get phoActionJsonData to hoJson
44284>>>>>>>        Set pbRequireAllMembers of hoJson to False
44285>>>>>>>        Get JsonToDataType of hoJson to WidgetDef
44286>>>>>>>        
44286>>>>>>>        Send AddWidget WidgetDef
44287>>>>>>>    End_Procedure
44288>>>>>>>    
44288>>>>>>>    Procedure AddWidgetLocal tWidgetDef WidgetDef Handle hoWidget
44290>>>>>>>        Handle hoJsonData
44290>>>>>>>        String[] aParams
44291>>>>>>>        
44291>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
44292>>>>>>>        Send DataTypeToJson of hoJsonData WidgetDef
44293>>>>>>>        
44293>>>>>>>        Get WebObjectName of hoWidget to aParams[0]
44294>>>>>>>        
44294>>>>>>>        Send ClientActionEx 'registerWidget' aParams hoJsonData
44295>>>>>>>        
44295>>>>>>>        Send Destroy of hoJsonData
44296>>>>>>>    End_Procedure
44297>>>>>>>    
44297>>>>>>>    Procedure RefreshOverlay
44299>>>>>>>        Send ClientAction "refreshOverlay" 
44300>>>>>>>    End_Procedure
44301>>>>>>>    
44301>>>>>>>    Procedure RequestConfigWizard String sObjName Boolean bOptNoError
44303>>>>>>>        Handle hoWizard
44303>>>>>>>        Handle hoWidget
44303>>>>>>>        String sWidgetId
44303>>>>>>>        
44303>>>>>>>        Get TruncateName sObjName to sWidgetId
44304>>>>>>>        Get DynamicObject sWidgetId to hoWidget
44305>>>>>>>        
44305>>>>>>>        If (hoWidget <> 0) Begin
44307>>>>>>>            Get phoConfigWizard of hoWidget to hoWizard
44308>>>>>>>            If (hoWizard = C_WebUnresolvedObject) Begin
44310>>>>>>>                If (num_arguments < 2 or not(bOptNoError)) ;                    Error DFERR_PROGRAM "No config wizard has been set for this Widget"
44313>>>>>>>                Procedure_Return
44314>>>>>>>            End
44314>>>>>>>>
44314>>>>>>>            
44314>>>>>>>            Send InitWizard of hoWizard (Self) sWidgetId
44315>>>>>>>        End
44315>>>>>>>>
44315>>>>>>>    End_Procedure
44316>>>>>>>    
44316>>>>>>>    // This is called when the Config Wizard is closed
44316>>>>>>>    Procedure OnCloseModalDialog Handle hoModalDialog
44318>>>>>>>        tWidgetConfigPropValue[] aPropValues
44318>>>>>>>        tWidgetConfigPropValue[] aPropValues
44319>>>>>>>        String sWidgetId
44319>>>>>>>        Handle hoWidget hoWrapper
44319>>>>>>>        Boolean bIsConfigWizard bEditMode
44319>>>>>>>        
44319>>>>>>>        Forward Send OnCloseModalDialog hoModalDialog
44321>>>>>>>        
44321>>>>>>>        Get IsObjectOfClass of hoModalDialog (RefClass(cWebWidgetConfigurationWizard)) to bIsConfigWizard
44322>>>>>>>        
44322>>>>>>>        If (bIsConfigWizard) Begin
44324>>>>>>>            Get GetConfigValues of hoModalDialog to aPropValues
44325>>>>>>>            
44325>>>>>>>            WebGet psCurrentWidgetDynID of hoModalDialog to sWidgetId
44326>>>>>>>            Get DynamicObject sWidgetId to hoWidget
44327>>>>>>>            
44327>>>>>>>            If (hoWidget <> 0) Begin
44329>>>>>>>                // Apply values to corresponding widget controls
44329>>>>>>>                Send ApplyWidgetProps hoWidget sWidgetId aPropValues
44330>>>>>>>                
44330>>>>>>>                Get phoWrapperGroup to hoWrapper
44331>>>>>>>                WebGet pbEditMode of hoWrapper to bEditMode 
44333>>>>>>>
44333>>>>>>>                // When configuring outside edit mode we should trigger a save.
44333>>>>>>>                If (not(bEditMode)) Begin
44335>>>>>>>                    Send SaveConfiguration
44336>>>>>>>                End
44336>>>>>>>>
44336>>>>>>>            End
44336>>>>>>>>
44336>>>>>>>        End
44336>>>>>>>>
44336>>>>>>>    End_Procedure
44337>>>>>>>    
44337>>>>>>>    Procedure ApplyWidgetProps Handle hoWidget String sWidgetId tWidgetConfigPropValue[] aPropValues
44339>>>>>>>        Handle hoObj
44339>>>>>>>        Boolean bValid
44339>>>>>>>        Variant vValue
44339>>>>>>>        Integer i j iProps iVals
44339>>>>>>>        String[] asPropId
44340>>>>>>>        String sObjName sPropName sPropVal
44340>>>>>>>        tWebPropMetaData PropMeta
44340>>>>>>>        tWebPropMetaData PropMeta
44340>>>>>>>        tWidgetConfigProp[] aProps
44340>>>>>>>        tWidgetConfigProp[] aProps
44341>>>>>>>        
44341>>>>>>>        // First Verify
44341>>>>>>>        Get GetConfigurableProps of hoWidget to aProps
44342>>>>>>>        Move ((SizeOfArray(aProps) - 1)) to iProps
44343>>>>>>>        Move ((SizeOfArray(aPropValues) - 1)) to iVals
44344>>>>>>>        Move True to bValid
44345>>>>>>>        
44345>>>>>>>        For i from 0 to iProps
44351>>>>>>>>
44351>>>>>>>            For j from 0 to iVals
44357>>>>>>>>
44357>>>>>>>                If ((aPropValues[j].sObjName = aProps[i].sObjName) and (aPropValues[j].sPropName = aProps[i].sPropName)) Begin
44359>>>>>>>                    Get VerifyConfigurablePropValue of hoWidget aProps[i] aPropValues[j].sValue to bValid
44360>>>>>>>                    If (not(bValid)) Begin
44362>>>>>>>                        Send ClientLog "Invalid prop value detected"
44363>>>>>>>                        Procedure_Return
44364>>>>>>>                    End
44364>>>>>>>>
44364>>>>>>>                End
44364>>>>>>>>
44364>>>>>>>            Loop
44365>>>>>>>>
44365>>>>>>>        Loop
44366>>>>>>>>
44366>>>>>>>        
44366>>>>>>>        // A single invalid value will prevent application of all props. This prevents tampering through various avenues
44366>>>>>>>        // All good? Then apply        
44366>>>>>>>        for i from 0 to iVals
44372>>>>>>>>
44372>>>>>>>            Move aPropValues[i].sObjName to sObjName
44373>>>>>>>            Move aPropValues[i].sPropName to sPropName
44374>>>>>>>            Move aPropValues[i].sValue to sPropVal
44375>>>>>>>            
44375>>>>>>>            // Assume Object is either this widget or a child
44375>>>>>>>            If (sObjName <> '') Begin
44377>>>>>>>                Get DynamicObject (sWidgetId + '.' + sObjName) to hoObj
44378>>>>>>>            End
44378>>>>>>>>
44378>>>>>>>            Else Begin
44379>>>>>>>                Move hoWidget to hoObj
44380>>>>>>>            End
44380>>>>>>>>
44380>>>>>>>            
44380>>>>>>>            If (hoObj <> 0) Begin
44382>>>>>>>                // perform WebSet based on asPropId[1]
44382>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to PropMeta
44383>>>>>>>                If (PropMeta.hmGetter <> 0) Begin
44385>>>>>>>                    Send SetSyncProp of hoObj hoObj PropMeta.hmSetter sPropName sPropVal
44386>>>>>>>                End
44386>>>>>>>>
44386>>>>>>>            End
44386>>>>>>>>
44386>>>>>>>        Loop
44387>>>>>>>>
44387>>>>>>>        
44387>>>>>>>        Send OnWidgetPropsChanged of hoWidget   
44388>>>>>>>    End_Procedure
44389>>>>>>>    
