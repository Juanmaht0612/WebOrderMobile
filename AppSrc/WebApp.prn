29691>>>>>>>>>>>                    Move (ResizeArray(ucValue, 0)) to ucValue
29692>>>>>>>>>>>                    
29692>>>>>>>>>>>                    While (parsedata.iBoundPos < 0 and ShouldParseContinue(Self, &parsedata))
29696>>>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
29697>>>>>>>>>>>                        
29697>>>>>>>>>>>                        Send ReadChunk (&parsedata)            
29698>>>>>>>>>>>                    End
29699>>>>>>>>>>>>
29699>>>>>>>>>>>                    
29699>>>>>>>>>>>                    If (parsedata.iBoundPos > 0) Begin
29701>>>>>>>>>>>                        //  Cut off newline
