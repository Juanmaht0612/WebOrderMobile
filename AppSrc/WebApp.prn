36234>>>>>>>    
36234>>>>>>>    // Prepends a dynamic object at the beginning of its parent's list of children.
36234>>>>>>>    Procedure PrependDynamicObject String sDynamicObjectId
36236>>>>>>>        String sParentId
36236>>>>>>>        String[] aParams aChildren aEmptyParams aObjects
36240>>>>>>>        Integer iIndex iRemoveIndex
36240>>>>>>>        Boolean bSendCommand
36240>>>>>>>        Handle hoObj hoQueuedSyncPropsJson hoObjectJson
36240>>>>>>>        tWebDynamicObject tDynamicObject
36240>>>>>>>        tWebDynamicObject tDynamicObject
36240>>>>>>>        tWebDynamicObject[] aDynamicObjects
36240>>>>>>>        tWebDynamicObject[] aDynamicObjects
36241>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36241>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36242>>>>>>>        
36242>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36243>>>>>>>        
36243>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36244>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36245>>>>>>>        If (iIndex <> -1) Begin
36247>>>>>>>            // Retrieve parent
36247>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36248>>>>>>>            
36248>>>>>>>            // Find parent object
36248>>>>>>>            Move sParentId to tDynamicObject.sId
36249>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects)) to iIndex
36250>>>>>>>            If (iIndex <> -1) Begin
36252>>>>>>>                
36252>>>>>>>                // Remove previously appended object (in CreateDynamicObject)
36252>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iRemoveIndex
36253>>>>>>>                Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iRemoveIndex)) to aChildren
36254>>>>>>>                
36254>>>>>>>                // Insert object at beginning of the array
36254>>>>>>>                Move (InsertInArray(aChildren, 0, sDynamicObjectId)) to aChildren
36255>>>>>>>                Move aChildren to aDynamicObjects[iIndex].aChildren
36256>>>>>>>                
36256>>>>>>>                WebSet paDynamicObjects to aDynamicObjects 
36257>>>>>>>                Move True to bSendCommand
36258>>>>>>>            End
36258>>>>>>>>
36258>>>>>>>            Else Begin
36259>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$DynamicParentNotFound, sParentId))
36260>>>>>>>>
36260>>>>>>>            End
36260>>>>>>>>
36260>>>>>>>        End
36260>>>>>>>>
36260>>>>>>>        
36260>>>>>>>        // Finally, send an insert command to the client
36260>>>>>>>        If (bSendCommand) Begin
36262>>>>>>>            Send ConnectRadioButtons
36263>>>>>>>            
36263>>>>>>>            Get DynamicObject sDynamicObjectId to hoObj
36264>>>>>>>            Get SerializeDynamicObject hoObj aDynamicObjects to hoObjectJson
36265>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36266>>>>>>>            
36266>>>>>>>            // Convert queued sync props to JSON
36266>>>>>>>            Get Create (RefClass(cJsonObject)) to hoQueuedSyncPropsJson
36267>>>>>>>            Send DataTypeToJson of hoQueuedSyncPropsJson aSyncPropsQueue 
36268>>>>>>>            
36268>>>>>>>            // Convert object definition to JSON
36268>>>>>>>            Get DynamicParent sDynamicObjectId to hoObj
36269>>>>>>>            Get WebObjectName of hoObj to aParams[0]
36270>>>>>>>            
36270>>>>>>>            // Send actions to the client
36270>>>>>>>            Send ClientActionEx "loadQueuedSyncProps" aEmptyParams hoQueuedSyncPropsJson
36271>>>>>>>            Send ClientActionEx "prependDynamicObject" aParams hoObjectJson
36272>>>>>>>        
36272>>>>>>>            Send Destroy of hoObjectJson
36273>>>>>>>            Send Destroy of hoQueuedSyncPropsJson
36274>>>>>>>    
36274>>>>>>>            Move sDynamicObjectId to aObjects[0]
36275>>>>>>>            Send FinishRendering aObjects
36276>>>>>>>        End
36276>>>>>>>>
36276>>>>>>>    End_Procedure
36277>>>>>>>
36277>>>>>>>  
36277>>>>>>>    // Destroys the given dynamic object and removes it from the container.
36277>>>>>>>    Procedure DestroyDynamicObject String sDynamicObjectId
36279>>>>>>>        String sParentId sName sRadioGroup
36279>>>>>>>        String[] aParams aChildren
36281>>>>>>>        Handle hoObj
36281>>>>>>>        Integer iIndex iChildIndex iTotal iNum icObjects iObject
36281>>>>>>>        Variant vResult
36281>>>>>>>        tWebDynamicObject tDynamicObject
36281>>>>>>>        tWebDynamicObject tDynamicObject
36281>>>>>>>        tWebDynamicObject[] aDynamicObjects
36281>>>>>>>        tWebDynamicObject[] aDynamicObjects
36282>>>>>>>        tWebSyncProps tSyncProp
36282>>>>>>>        tWebSyncProps tSyncProp
36282>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36282>>>>>>>        tWebSyncPropsWrapper tSyncPropsWrapper
36282>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36282>>>>>>>        tWebAdvSyncProp tAdvSyncProp
36282>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36282>>>>>>>        tWebAdvSyncPropsWrapper tAdvSyncPropsWrapper
36282>>>>>>>        tQueuedSyncProp tTest
36282>>>>>>>        tQueuedSyncProp tTest
36282>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36282>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36283>>>>>>>        tWebClientAction[] aClientActionsQueue
36283>>>>>>>        tWebClientAction[] aClientActionsQueue
36284>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36284>>>>>>>        tWebDynamicRadioGroup[] aRadioGroups
36285>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36285>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36286>>>>>>>        tObjectInMemory tObjectInMemory
36286>>>>>>>        tObjectInMemory tObjectInMemory
36286>>>>>>>        
36286>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36287>>>>>>>        Get WebObjectName of hoObj to sName
36288>>>>>>>        
36288>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36289>>>>>>>           
36289>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36290>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36291>>>>>>>        If (iIndex <> -1) Begin
36293>>>>>>>            Move aDynamicObjects[iIndex] to tDynamicObject
36294>>>>>>>            
36294>>>>>>>            // Destroy the object's children
36294>>>>>>>            Move tDynamicObject.aChildren to aChildren
36295>>>>>>>            Move (SizeOfArray(aChildren)) to icObjects
36296>>>>>>>            For iObject from 0 to (icObjects - 1)
36302>>>>>>>>
36302>>>>>>>                Send DestroyDynamicObject aChildren[iObject]
36303>>>>>>>            Loop
36304>>>>>>>>
36304>>>>>>>            
36304>>>>>>>            // We need to do a WebGet again, because the array might have changed while children were being destroyed
36304>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
36305>>>>>>>            
36305>>>>>>>            // The index also needs to be updated
36305>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36306>>>>>>>            
36306>>>>>>>            // Destroy the dynamic object itself
36306>>>>>>>            Move tDynamicObject.sParentId to sParentId
36307>>>>>>>            Move (RemoveFromArray(aDynamicObjects, iIndex)) to aDynamicObjects
36308>>>>>>>            
36308>>>>>>>            // Remove it from its parent's list of children
36308>>>>>>>            Move sParentId to tDynamicObject.sId
36309>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36310>>>>>>>            If (iIndex <> -1) Begin
36312>>>>>>>                Move (SearchArray(sDynamicObjectId, aDynamicObjects[iIndex].aChildren)) to iChildIndex
36313>>>>>>>                If (iChildIndex <> -1) Begin
36315>>>>>>>                    Move (RemoveFromArray(aDynamicObjects[iIndex].aChildren, iChildIndex)) to aDynamicObjects[iIndex].aChildren
36316>>>>>>>                End
36316>>>>>>>>
36316>>>>>>>            End
36316>>>>>>>>
36316>>>>>>>            
36316>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36317>>>>>>>            
36317>>>>>>>            // Optional: remove radio button from its group
36317>>>>>>>            If (IsObjectOfClass(hoObj, (RefClass(cWebRadio)))) Begin
36319>>>>>>>                WebGet paRadioGroups to aRadioGroups
36320>>>>>>>                
36320>>>>>>>                Move (SizeOfArray(aRadioGroups)) to iTotal
36321>>>>>>>                For iNum from 0 to (iTotal - 1)
36327>>>>>>>>
36327>>>>>>>                    Move (SearchArray(sDynamicObjectId, aRadioGroups[iNum].aRadioButtons)) to iIndex
36328>>>>>>>                    If (iIndex <> -1) Begin
36330>>>>>>>                        Move (RemoveFromArray(aRadioGroups[iNum].aRadioButtons, iIndex)) to aRadioGroups[iNum].aRadioButtons
36331>>>>>>>                    End
36331>>>>>>>>
36331>>>>>>>                Loop
36332>>>>>>>>
36332>>>>>>>                
36332>>>>>>>                WebSet paRadioGroups to aRadioGroups
36333>>>>>>>            End  
36333>>>>>>>>
36333>>>>>>>            
36333>>>>>>>            // Destroy the local object in memory (we can't leave this untill OnCallEnd as destructors and SyncDDO could change props)
36333>>>>>>>            Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36334>>>>>>>            Move sDynamicObjectId to tObjectInMemory.sDynamicObjectId
36335>>>>>>>            
36335>>>>>>>            Move (BinarySearchArray(tObjectInMemory, aDynamicObjectsInMemory, False)) to iIndex
36336>>>>>>>            If (iIndex <> -1) Begin
36338>>>>>>>                Send Destroy of aDynamicObjectsInMemory[iIndex].hoObj
36339>>>>>>>                Move (RemoveFromArray(aDynamicObjectsInMemory, iIndex)) to aDynamicObjectsInMemory
36340>>>>>>>                Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36341>>>>>>>            End
36341>>>>>>>>
36341>>>>>>>            Move 0 to hoObj
36342>>>>>>>            // Remove client properties
36342>>>>>>>            WebGet ptSyncPropsWrapper to tSyncPropsWrapper
36343>>>>>>>            Move (SortArray(tSyncPropsWrapper.aSyncProps, False)) to tSyncPropsWrapper.aSyncProps
36344>>>>>>>            
36344>>>>>>>            Move sName to tSyncProp.sO
36345>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36346>>>>>>>            If (iIndex <> -1) Begin
36348>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36349>>>>>>>                WebSet ptSyncPropsWrapper to tSyncPropsWrapper
36350>>>>>>>            End
36350>>>>>>>>
36350>>>>>>>            // Remove server properties
36350>>>>>>>            WebGet ptSyncServerPropsWrapper to tSyncPropsWrapper
36351>>>>>>>            Move (BinarySearchArray(tSyncProp, tSyncPropsWrapper.aSyncProps, False)) to iIndex
36352>>>>>>>            If (iIndex <> -1) Begin
36354>>>>>>>                Move (RemoveFromArray(tSyncPropsWrapper.aSyncProps, iIndex)) to tSyncPropsWrapper.aSyncProps
36355>>>>>>>                WebSet ptSyncServerPropsWrapper to tSyncPropsWrapper
36356>>>>>>>            End
36356>>>>>>>>
36356>>>>>>>            
36356>>>>>>>            
36356>>>>>>>            
36356>>>>>>>            // Remove advanced properties
36356>>>>>>>            WebGet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36357>>>>>>>            Move sName to tAdvSyncProp.sO
36358>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36359>>>>>>>            If (iIndex <> -1) Begin
36361>>>>>>>                While (iIndex <> -1)
36365>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36366>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36367>>>>>>>                Loop
36368>>>>>>>>
36368>>>>>>>                WebSet ptAdvSyncPropsWrapper to tAdvSyncPropsWrapper
36369>>>>>>>            End
36369>>>>>>>>
36369>>>>>>>            
36369>>>>>>>            // Remove advanced server properties
36369>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper
36370>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36371>>>>>>>            If (iIndex <> -1) Begin
36373>>>>>>>                While (iIndex <> -1)
36377>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36378>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36379>>>>>>>                Loop
36380>>>>>>>>
36380>>>>>>>                WebSet ptAdvServerSyncPropsWrapper to tAdvSyncPropsWrapper      
36381>>>>>>>            End
36381>>>>>>>>
36381>>>>>>>            
36381>>>>>>>            // Remove advanced server session properties
36381>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36382>>>>>>>            Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36383>>>>>>>            If (iIndex <> -1) Begin
36385>>>>>>>                While (iIndex <> -1)
36389>>>>>>>                    Move (RemoveFromArray(tAdvSyncPropsWrapper.aAdvSyncProps, iIndex)) to tAdvSyncPropsWrapper.aAdvSyncProps
36390>>>>>>>                    Move (SearchArray(tAdvSyncProp, tAdvSyncPropsWrapper.aAdvSyncProps)) to iIndex
36391>>>>>>>                Loop
36392>>>>>>>>
36392>>>>>>>                WebSet ptAdvServerSessionSyncPropsWrapper to tAdvSyncPropsWrapper
36393>>>>>>>            End
36393>>>>>>>>
36393>>>>>>>            
36393>>>>>>>            // Remove queued sync props for this object
36393>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue            
36394>>>>>>>            Move (SizeOfArray(aSyncPropsQueue)) to iTotal
36395>>>>>>>            For iNum from 0 to (iTotal - 1)
36401>>>>>>>>
36401>>>>>>>                If (aSyncPropsQueue[iNum].sO = sName) Begin
36403>>>>>>>                    Move (RemoveFromArray(aSyncPropsQueue, iNum)) to aSyncPropsQueue
36404>>>>>>>                    
36404>>>>>>>                    // This is necessary to keep the loop running correctly
36404>>>>>>>                    Decrement iNum
36405>>>>>>>                    Decrement iTotal
36406>>>>>>>                End
36406>>>>>>>>
36406>>>>>>>            Loop
36407>>>>>>>>
36407>>>>>>>            WebSet paSyncPropsQueue to aSyncPropsQueue
36408>>>>>>>            
36408>>>>>>>            // Remove queued client actions for this object
36408>>>>>>>            Get paClientActionsQueue to aClientActionsQueue
36409>>>>>>>            Move (SizeOfArray(aClientActionsQueue)) to iTotal
36410>>>>>>>            For iNum from 0 to (iTotal - 1)
36416>>>>>>>>
36416>>>>>>>                If (aClientActionsQueue[iNum].sName = sName) Begin
36418>>>>>>>                    Move (RemoveFromArray(aClientActionsQueue, iNum)) to aClientActionsQueue
36419>>>>>>>                    
36419>>>>>>>                    // This is necessary to keep the loop running correctly
36419>>>>>>>                    Decrement iNum
36420>>>>>>>                    Decrement iTotal
36421>>>>>>>                End
36421>>>>>>>>
36421>>>>>>>            Loop
36422>>>>>>>>
36422>>>>>>>            
36422>>>>>>>            // Update client
36422>>>>>>>            Move sName to aParams[0]
36423>>>>>>>            Send ClientAction "destroyDynamicObject" aParams
36424>>>>>>>        End
36424>>>>>>>>
36424>>>>>>>    End_Procedure
36425>>>>>>>                
36425>>>>>>>    // Appends a child object to the end of the parent's list of children.
36425>>>>>>>    Procedure AppendToSiblings String sDynamicObjectId
36427>>>>>>>        String sParentId
36427>>>>>>>        Integer iIndex iSize
36427>>>>>>>        Handle hoObj
36427>>>>>>>        tWebDynamicObject tDynamicObject
36427>>>>>>>        tWebDynamicObject tDynamicObject
36427>>>>>>>        tWebDynamicObject[] aDynamicObjects
36427>>>>>>>        tWebDynamicObject[] aDynamicObjects
36428>>>>>>>        
36428>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36429>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36430>>>>>>>        
36430>>>>>>>        // First get parent of the object
36430>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36431>>>>>>>        If (iIndex <> -1) Begin
36433>>>>>>>            Move aDynamicObjects[iIndex].sParentId to sParentId
36434>>>>>>>            Move sParentId to tDynamicObject.sId
36435>>>>>>>            
36435>>>>>>>            // Search for parent object
36435>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36436>>>>>>>            If (iIndex = -1) Begin
36438>>>>>>>                // Root object is not yet in the list of objects, so add it now
36438>>>>>>>                Move (BinarySearchInsertPos()) to iIndex 
36439>>>>>>>                Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36440>>>>>>>            End
36440>>>>>>>>
36440>>>>>>>           
36440>>>>>>>            Move (SizeOfArray(aDynamicObjects[iIndex].aChildren)) to iSize
36441>>>>>>>            Move sDynamicObjectId to aDynamicObjects[iIndex].aChildren[iSize]
36442>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36443>>>>>>>        End
36443>>>>>>>>
36443>>>>>>>    End_Procedure
36444>>>>>>>    
36444>>>>>>>       
36444>>>>>>>    // =======================
36444>>>>>>>    // DYNAMIC OBJECT QUERYING
36444>>>>>>>    // =======================
36444>>>>>>>
36444>>>>>>>    // Checks whether the given object should always create its children when it is being created.
36444>>>>>>>    // Currently, this is true if the object is a subclass of:
36444>>>>>>>    //      - cWebList
36444>>>>>>>    //      - cWebCardContainer
36444>>>>>>>     Function RequiresChildren Handle hoObj Returns Boolean
36446>>>>>>>        Integer iClass icClasses
36446>>>>>>>        Integer[] aClassIds
36447>>>>>>>        Boolean bResult
36447>>>>>>>        
36447>>>>>>>        Move False to bResult
36448>>>>>>>        
36448>>>>>>>        Move (RefClass(cWebList)) to aClassIds[SizeOfArray(aClassIds)]
36449>>>>>>>        Move (RefClass(cWebCardContainer)) to aClassIds[SizeOfArray(aClassIds)]
36450>>>>>>>        
36450>>>>>>>        Move (SizeOfArray(aClassIds)) to icClasses
36451>>>>>>>        For iClass from 0 to (icClasses - 1)
36457>>>>>>>>
36457>>>>>>>            If (IsObjectOfClass(hoObj, aClassIds[iClass])) Begin
36459>>>>>>>                Move True to bResult
36460>>>>>>>            End
36460>>>>>>>>
36460>>>>>>>            
36460>>>>>>>            If bResult ;                Break
36463>>>>>>>        Loop
36464>>>>>>>>
36464>>>>>>>        
36464>>>>>>>        Function_Return bResult
36465>>>>>>>    End_Function
36466>>>>>>>    
36466>>>>>>>    
36466>>>>>>>    // Creates all child objects for the given dynamic object in memory
36466>>>>>>>    Procedure CreateChildren String sDynamicObjectId
36468>>>>>>>        Integer iIndex
36468>>>>>>>        Handle hoObj
36468>>>>>>>        tWebDynamicObject tDynamicObject
36468>>>>>>>        tWebDynamicObject tDynamicObject
36468>>>>>>>        tWebDynamicObject[] aDynamicObjects
36468>>>>>>>        tWebDynamicObject[] aDynamicObjects
36469>>>>>>>        String[] aChildren
36470>>>>>>>        
36470>>>>>>>        //  Find the dynamic object        
36470>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36471>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36472>>>>>>>
36472>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36473>>>>>>>        If (iIndex >= 0) Begin
36475>>>>>>>            //  Loop over its children
36475>>>>>>>            Move aDynamicObjects[iIndex].aChildren to aChildren
36476>>>>>>>            For iIndex from 0 to (SizeOfArray(aChildren) - 1)
36482>>>>>>>>
36482>>>>>>>                Get CreateLocal aChildren[iIndex] to hoObj
36483>>>>>>>            Loop
36484>>>>>>>>
36484>>>>>>>        End
36484>>>>>>>>
36484>>>>>>>    End_Procedure
36485>>>>>>>    
36485>>>>>>>    
36485>>>>>>>    //  This function searches the object handle of a dynamic object using its public name.
36485>>>>>>>    //      sObjectName - Name of the web object.
36485>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
36487>>>>>>>        Integer iIndex
36487>>>>>>>        String sDynamicObjectId
36487>>>>>>>        Handle hoObj
36487>>>>>>>        
36487>>>>>>>        // Only the actual name of the object (without parentage) is saved.
36487>>>>>>>        // Therefore, we first need to remove the parentage from the name
36487>>>>>>>        // of the object.
36487>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36488>>>>>>>        
36488>>>>>>>        Get DynamicObject sDynamicObjectId to hoObj
36489>>>>>>>        Function_Return hoObj
36490>>>>>>>    End_Function
36491>>>>>>>    
36491>>>>>>>    
36491>>>>>>>    /*    Converts a name received from the client into the identifier used in the dynamic object id     its registration. Dynamic objects their names are prefixed with a # when they are created, so     when a name comes from the client it will include the #.        So a full object name for a dynamic object will be:    oDynamicContainer@#dynamicobjectid  => dynamicobjectid        But a static child will be:    oDynamicContainer@#dynamicobjectid.oStaticChild  => dynamicobjectid.oStaticChild        But it can also be nested dynamic obects:    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject  => #nesteddynamicobject    oDynamicContainer@#dynamicobjectid.#nesteddynamicobject.oStaticChild  => #nesteddynamicobject.oStaticChild        Note that usually oDynamicContainer@ is already stripped off when this function is called, but     for compatibility we still check for that if we do not find a #.        */
36491>>>>>>>    Function TruncateName String sObjectName Returns String
36493>>>>>>>        Integer iPos
36493>>>>>>>        
36493>>>>>>>        Move (RightPos("#", sObjectName)) to iPos
36494>>>>>>>        
36494>>>>>>>        If (iPos = 0) ;            Move (RightPos("$", sObjectName)) to iPos
36497>>>>>>>        
36497>>>>>>>        If (iPos > 0) ;            Function_Return (Right(sObjectName, (Length(sObjectName) - iPos)))
36500>>>>>>>        
36500>>>>>>>        Function_Return sObjectName
36501>>>>>>>    End_Function
36502>>>>>>>    
36502>>>>>>>    
36502>>>>>>>    // Returns the dynamic object with the given ID. Creates the object
36502>>>>>>>    // in memory if it doesn't exist yet.
36502>>>>>>>    Function DynamicObject String sDynamicObjectId Returns Handle
36504>>>>>>>        Handle hoObj
36504>>>>>>>        
36504>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36505>>>>>>>        
36505>>>>>>>        If (hoObj = C_WebUnresolvedObject) ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36508>>>>>>>            
36508>>>>>>>        Function_Return hoObj
36509>>>>>>>    End_Function
36510>>>>>>>    
36510>>>>>>>    // Static children of dynamic objects are registered as "<dynamicparentid>.oChild.oChild". 
36510>>>>>>>    // Dynamic children are registered under their ID which is also set as their name, so then this 
36510>>>>>>>    // function is called with "<dynamicparentid>.<dynamicchildid>" while we should search for
36510>>>>>>>    // "<dynamicchildid>". So this function just tries to find them both ways.
36510>>>>>>>    //
36510>>>>>>>    // Worst case scenario is that we get collisions when people use the "." in dynamic object id's.
36510>>>>>>>    //
36510>>>>>>>    // This function is called by the cWebControlLocator.
36510>>>>>>>    Function OwnerFindWebObject String sObjectName Returns Handle
36512>>>>>>>        Handle hoObj
36512>>>>>>>        String sDynamicObjectId
36512>>>>>>>        
36512>>>>>>>        // If this is a root object or static child
36512>>>>>>>        Get TruncateName sObjectName to sDynamicObjectId
36513>>>>>>>        
36513>>>>>>>        Get DynamicObjectEx sDynamicObjectId to hoObj
36514>>>>>>>        
36514>>>>>>>        If (hoObj <> C_WebUnresolvedObject) ;            Function_Return hoObj
36517>>>>>>>        
36517>>>>>>>        Function_Return hoObj
36518>>>>>>>    End_Function
36519>>>>>>>    
36519>>>>>>>    // DynamicObject function that does not give an error.
36519>>>>>>>    Function DynamicObjectEx String sDynamicObjectId Returns Handle
36521>>>>>>>        Integer iObjectIndex
36521>>>>>>>        Handle hoObj
36521>>>>>>>        tWebDynamicObject tDynamicObject
36521>>>>>>>        tWebDynamicObject tDynamicObject
36521>>>>>>>        tWebDynamicObject[] aDynamicObjects
36521>>>>>>>        tWebDynamicObject[] aDynamicObjects
36522>>>>>>>        
36522>>>>>>>        // Check if the object we are looking for is the top-parent object:
36522>>>>>>>        // the container itself.
36522>>>>>>>        If (sDynamicObjectId = "") Begin
36524>>>>>>>            Function_Return Self
36525>>>>>>>        End
36525>>>>>>>>
36525>>>>>>>        
36525>>>>>>>        WebGet paDynamicObjects to aDynamicObjects  
36526>>>>>>>           
36526>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36527>>>>>>>     
36527>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36528>>>>>>>        If (iObjectIndex <> -1) Begin
36530>>>>>>>            Get StoredHandle sDynamicObjectId to hoObj
36531>>>>>>>            
36531>>>>>>>            If (hoObj = 0) Begin
36533>>>>>>>                // This means the object is not yet loaded, so load it now.
36533>>>>>>>                Get CreateLocal sDynamicObjectId to hoObj
36534>>>>>>>            End
36534>>>>>>>>
36534>>>>>>>        End
36534>>>>>>>>
36534>>>>>>>        Else Begin
36535>>>>>>>            Move C_WebUnresolvedObject to hoObj 
36536>>>>>>>        End
36536>>>>>>>>
36536>>>>>>>        
36536>>>>>>>        Function_Return hoObj
36537>>>>>>>    End_Function
36538>>>>>>>    
36538>>>>>>>    
36538>>>>>>>    // Returns the dynamic parent of a dynamic object. 
36538>>>>>>>    Function DynamicParent String sDynamicObjectId Returns Handle
36540>>>>>>>        String sParentId
36540>>>>>>>        Integer iObjectIndex iParentIndex
36540>>>>>>>        Handle hoParent
36540>>>>>>>        tWebDynamicObject tDynamicObject
36540>>>>>>>        tWebDynamicObject tDynamicObject
36540>>>>>>>        tWebDynamicObject[] aDynamicObjects
36540>>>>>>>        tWebDynamicObject[] aDynamicObjects
36541>>>>>>>        
36541>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36542>>>>>>>        
36542>>>>>>>        Get TruncateName sDynamicObjectId to sDynamicObjectId
36543>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36544>>>>>>>        
36544>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36545>>>>>>>        If (iObjectIndex <> -1) Begin
36547>>>>>>>            Move aDynamicObjects[iObjectIndex].sParentId to sParentId
36548>>>>>>>            
36548>>>>>>>            If (sParentId = "") ;                Function_Return (Self)
36551>>>>>>>                
36551>>>>>>>            Move sParentId to tDynamicObject.sId
36552>>>>>>>                
36552>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iParentIndex
36553>>>>>>>            If (iParentIndex <> -1) Begin
36555>>>>>>>                Get DynamicObject sParentId to hoParent
36556>>>>>>>            End
36556>>>>>>>>
36556>>>>>>>            Else ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sParentId))
36558>>>>>>>        End
36558>>>>>>>>
36558>>>>>>>        Else ;            Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36560>>>>>>>            
36560>>>>>>>        Function_Return hoParent
36561>>>>>>>    End_Function
36562>>>>>>>    
36562>>>>>>>    
36562>>>>>>>        
36562>>>>>>>    // Returns the list of children for an object.
36562>>>>>>>    Function DynamicChildren String sDynamicObjectId Returns String[]
36564>>>>>>>        String[] aResult
36565>>>>>>>        Integer iIndex
36565>>>>>>>        tWebDynamicObject tDynamicObject
36565>>>>>>>        tWebDynamicObject tDynamicObject
36565>>>>>>>        tWebDynamicObject[] aDynamicObjects
36565>>>>>>>        tWebDynamicObject[] aDynamicObjects
36566>>>>>>>        
36566>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36567>>>>>>>        
36567>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
36568>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36569>>>>>>>        If (iIndex <> -1) Begin
36571>>>>>>>            Function_Return aDynamicObjects[iIndex].aChildren
36572>>>>>>>        End
36572>>>>>>>>
36572>>>>>>>        Else Begin
36573>>>>>>>            If (sDynamicObjectId <> "") ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId)) 
36576>>>>>>>        End
36576>>>>>>>>
36576>>>>>>>        Function_Return aResult
36577>>>>>>>    End_Function
36578>>>>>>>
36578>>>>>>>    
36578>>>>>>>    // =========================
36578>>>>>>>    // PROCESS MEMORY MANAGEMENT
36578>>>>>>>    // =========================
36578>>>>>>>    
36578>>>>>>>    // Loads all dynamic objects in memory. This method is often called
36578>>>>>>>    // before rendering, so that all inter-object connections are set
36578>>>>>>>    // up properly.
36578>>>>>>>    Procedure CreateAllLocal 
36580>>>>>>>        Integer icObjects iObject
36580>>>>>>>        tWebDynamicObject[] aDynamicObjects
36580>>>>>>>        tWebDynamicObject[] aDynamicObjects
36581>>>>>>>        Handle hoObj
36581>>>>>>>        
36581>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36582>>>>>>>        
36582>>>>>>>        Move (SizeOfArray(aDynamicObjects)) to icObjects
36583>>>>>>>        For iObject from 0 to (icObjects - 1)
36589>>>>>>>>
36589>>>>>>>            Get DynamicObject aDynamicObjects[iObject].sId to hoObj
36590>>>>>>>        Loop
36591>>>>>>>>
36591>>>>>>>    End_Procedure
36592>>>>>>>    
36592>>>>>>>    
36592>>>>>>>    Function CreateLongNameUsingParents Handle hoDynamicObject Handle hoMaxParent Returns String
36594>>>>>>>        String sName
36594>>>>>>>        Handle hoParent hoCurrent
36594>>>>>>>        
36594>>>>>>>        Move hoDynamicObject to hoCurrent
36595>>>>>>>        Get Parent of hoMaxParent to hoMaxParent
36596>>>>>>>        
36596>>>>>>>        While (hoCurrent <> hoMaxParent and hoCurrent <> Self)
36600>>>>>>>            If (hoCurrent = hoDynamicObject) ;                Move (Object_Label(hoCurrent)) to sName
36603>>>>>>>            Else ;                Move (Object_Label(hoCurrent) + "." + sName) to sName
36605>>>>>>>            
36605>>>>>>>            Get Parent of hoCurrent to hoCurrent
36606>>>>>>>        Loop
36607>>>>>>>>
36607>>>>>>>        
36607>>>>>>>        
36607>>>>>>>        
36607>>>>>>>        If (Left(sName, 1) = "#") ;            Move (Remove(sName, 1, 1)) to sName
36610>>>>>>>            
36610>>>>>>>        Function_Return sName
36611>>>>>>>    End_Function
36612>>>>>>>    
36612>>>>>>>    Function SyncDynamicDDOs Handle hoDynamicObj Returns Integer
36614>>>>>>>        // Override in cWebWidgetContainer
36614>>>>>>>        Function_Return 0
36615>>>>>>>    End_Procedure
36616>>>>>>>    
36616>>>>>>>    Procedure StoreDynamicDDOs Handle hoDynamicObj
36618>>>>>>>        // Override in cWebWidgetContainer
36618>>>>>>>    End_Procedure
36619>>>>>>>    
36619>>>>>>>    
36619>>>>>>>    // Creates an object in memory. Due to process pooling, it can not
36619>>>>>>>    // be guaranteed that all objects are always loaded in memory. 
36619>>>>>>>    // This method creates an object in the memory of the current process.
36619>>>>>>>    Function CreateLocal String sDynamicObjectId Returns Handle
36621>>>>>>>        String sName
36621>>>>>>>        Boolean bRequiresChildren
36621>>>>>>>        Integer iObjectIndex iHandleIndex iClassId iParentIndex icObjects iObject iWebRadioClass iSyncRequestResponse
36621>>>>>>>        Handle hoObj hoParent hoChild   
36621>>>>>>>        tObjectInMemory tObject
36621>>>>>>>        tObjectInMemory tObject
36621>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36621>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36622>>>>>>>        tWebDynamicObject tDynamicObject
36622>>>>>>>        tWebDynamicObject tDynamicObject
36622>>>>>>>        tWebDynamicObject[] aDynamicObjects
36622>>>>>>>        tWebDynamicObject[] aDynamicObjects
36623>>>>>>>
36623>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36624>>>>>>>        
36624>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36625>>>>>>>
36625>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36626>>>>>>>        If (iHandleIndex = -1) Begin
36628>>>>>>>            WebGet paDynamicObjects to aDynamicObjects
36629>>>>>>>            
36629>>>>>>>            Move sDynamicObjectId to tDynamicObject.sId
36630>>>>>>>            
36630>>>>>>>            Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
36631>>>>>>>            If (iObjectIndex <> -1) Begin
36633>>>>>>>                Move aDynamicObjects[iObjectIndex].iClassId to iClassId
36634>>>>>>>                Get DynamicParent sDynamicObjectId to hoParent
36635>>>>>>>                // DynamicParent might already have created the object. We either retrieve the created object.
36635>>>>>>>                // Or we do an in-place CreateNamed.
36635>>>>>>>                Send RetrieveOrCreateHandle sDynamicObjectId (&hoObj) hoParent iClassId
36636>>>>>>>
36636>>>>>>>                // Check WebObject
36636>>>>>>>                If (not(IsAjaxWebObject(hoObj))) Begin
36638>>>>>>>                    Error DFERR_PROGRAM (SFormat("Class %1 is not a valid cWebObject and can't be used with CreateDynamicObject.", iClassId))
36639>>>>>>>>
36639>>>>>>>                    Send Destroy of hoObj
36640>>>>>>>                    Function_Return C_WebUnresolvedObject
36641>>>>>>>                End
36641>>>>>>>>
36641>>>>>>>                
36641>>>>>>>                If (Pos(".", sDynamicObjectId) > 0) Begin
36643>>>>>>>                    // This is a static child so it has been created by DynamicParent which means that all processing below is already done
36643>>>>>>>                    Function_Return hoObj
36644>>>>>>>                End
36644>>>>>>>>
36644>>>>>>>                
36644>>>>>>>                Set psDynamicObjectId of hoObj to sDynamicObjectId
36645>>>>>>>                Set phoOwner of hoObj to (Self)
36646>>>>>>>                
36646>>>>>>>                Send ApplyDynamicProps sDynamicObjectId hoObj
36647>>>>>>>                
36647>>>>>>>                // Call to attempt to sync DDO's
36647>>>>>>>                Get SyncDynamicDDOs hoObj to iSyncRequestResponse
36648>>>>>>>                If (iSyncRequestResponse = -1) Begin
36650>>>>>>>                    // Request response -1 means no access, so we should destroy this object to prevent any possible calls
36650>>>>>>>                    Send DestroyDynamicObject sDynamicObjectId
36651>>>>>>>                    Procedure_Return
36652>>>>>>>                End
36652>>>>>>>>
36652>>>>>>>                
36652>>>>>>>                // Process belated childs.
36652>>>>>>>                Send CreateLocalOfChildren hoObj hoObj
36653>>>>>>>                
36653>>>>>>>                //  All data bindable objects need AfterAttachDDO message (even through Data awareness is not supported on dynamic objects for now)
36653>>>>>>>                If (pbDataBindable(hoObj)) Begin
36655>>>>>>>                    Send AfterAttachDDO of hoObj
36656>>>>>>>                End         
36656>>>>>>>>
36656>>>>>>>                
36656>>>>>>>                // WebRadio's require slightly different logic. Here we check if the 
36656>>>>>>>                // object we want to create is a cWebRadio. 
36656>>>>>>>                Move (RefClass(cWebRadio)) to iWebRadioClass
36657>>>>>>>                If (IsObjectOfClass(hoObj, iWebRadioClass)) Begin
36659>>>>>>>                    Send RegisterRadio hoObj   
36660>>>>>>>                End   
36660>>>>>>>>
36660>>>>>>>            End
36660>>>>>>>>
36660>>>>>>>            Else ;                Error DFERR_PROGRAM (SFormat(C_$DynamicObjectNotRegistered, sDynamicObjectId))
36662>>>>>>>        End
36662>>>>>>>>
36662>>>>>>>        Else Begin
36663>>>>>>>            Get StoredHandle sDynamicObjectId to hoObj
36664>>>>>>>        End
36664>>>>>>>>
36664>>>>>>>        
36664>>>>>>>        // In addition to creating the object itself, we also want to create all child objects (for some objects).
36664>>>>>>>        // This solves issues with objects that have embedded children (such as cWebList).
36664>>>>>>>        Get RequiresChildren hoObj to bRequiresChildren
36665>>>>>>>        If (bRequiresChildren) Begin      
36667>>>>>>>            Send CreateChildren sDynamicObjectId
36668>>>>>>>        End
36668>>>>>>>>
36668>>>>>>>  
36668>>>>>>>        Function_Return hoObj
36669>>>>>>>    End_Function
36670>>>>>>>                
36670>>>>>>>    // This function is only called from a createlocal with static children (should be guarded by DynamicObjectsInMemory).
36670>>>>>>>    // It registers the dynamic object if it has to and sets a mangled name on the child to make it unique.
36670>>>>>>>    // It then recurses down.
36670>>>>>>>    Procedure CreateLocalFor Handle hoObj Handle hoParent Handle hoMaxParent
36672>>>>>>>        Integer iIndex iSyncRequestResponse
36672>>>>>>>        Boolean bRequiresChildren
36672>>>>>>>        tWebDynamicObject tDynamicObject
36672>>>>>>>        tWebDynamicObject tDynamicObject
36672>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36672>>>>>>>        tWebDynamicObject[] aDynamicObjects  
36673>>>>>>>        
36673>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
36674>>>>>>>        
36674>>>>>>>        // Get parent info.
36674>>>>>>>        Get psDynamicObjectId of hoParent to tDynamicObject.sParentId
36675>>>>>>>        Get CreateLongNameUsingParents hoObj hoMaxParent to tDynamicObject.sId
36676>>>>>>>        
36676>>>>>>>        // Find a registration.
36676>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iIndex
36677>>>>>>>        If (iIndex = -1) Begin
36679>>>>>>>            // Dynamic object has not been registered before, so append it  
36679>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36680>>>>>>>            Get ObjectClass of hoObj to tDynamicObject.iClassId
36681>>>>>>>            Move False to tDynamicObject.bRendered
36682>>>>>>>            
36682>>>>>>>            Move (InsertInArray(aDynamicObjects, iIndex, tDynamicObject)) to aDynamicObjects
36683>>>>>>>            
36683>>>>>>>            WebSet paDynamicObjects to aDynamicObjects
36684>>>>>>>        End
36684>>>>>>>>
36684>>>>>>>        
36684>>>>>>>        // Now apply state.
36684>>>>>>>        Set psDynamicObjectId of hoObj to tDynamicObject.sId
36685>>>>>>>        Set phoOwner of hoObj to Self
36686>>>>>>>        
36686>>>>>>>        Send ApplyDynamicProps tDynamicObject.sId hoObj
36687>>>>>>>        Send StoreDirectHandle tDynamicObject.sId hoObj
36688>>>>>>>        
36688>>>>>>>        // Call to attempt to sync DDO's
36688>>>>>>>        Get SyncDynamicDDOs hoObj to iSyncRequestResponse
36689>>>>>>>        If (iSyncRequestResponse = -1) Begin
36691>>>>>>>            // Request response -1 means no access, so we should destroy this object to prevent any possible calls
36691>>>>>>>            Send DestroyDynamicObject tDynamicObject.sId
36692>>>>>>>            Procedure_Return
36693>>>>>>>        End
36693>>>>>>>>
36693>>>>>>>
36693>>>>>>>        // Process belated childs.
36693>>>>>>>        Send CreateLocalOfChildren hoObj hoMaxParent
36694>>>>>>>        
36694>>>>>>>        //  All data bindable objects need AfterAttachDDO message (even through Data awareness is not supported on dynamic objects for now)
36694>>>>>>>        If (pbDataBindable(hoObj)) Begin
36696>>>>>>>            Send AfterAttachDDO of hoObj
36697>>>>>>>        End
36697>>>>>>>>
36697>>>>>>>        
36697>>>>>>>        // WebRadio's require slightly different logic. Here we check if the 
36697>>>>>>>        // object we want to create is a cWebRadio. 
36697>>>>>>>        If (IsObjectOfClass(hoObj, (RefClass(cWebRadio)))) Begin
36699>>>>>>>            Send RegisterRadio hoObj
36700>>>>>>>        End
36700>>>>>>>>
36700>>>>>>>        
36700>>>>>>>        Get RequiresChildren hoObj to bRequiresChildren
36701>>>>>>>        If (bRequiresChildren) Begin      
36703>>>>>>>            Send CreateChildren tDynamicObject.sId
36704>>>>>>>        End
36704>>>>>>>>
36704>>>>>>>        
36704>>>>>>>        // Insert object at end of parent's child structure
36704>>>>>>>        If (pbIsCreating(Self)) Begin
36706>>>>>>>            Send AppendToSiblings tDynamicObject.sId
36707>>>>>>>        End
36707>>>>>>>>
36707>>>>>>>    End_Procedure
36708>>>>>>>    
36708>>>>>>>    
36708>>>>>>>    Procedure CreateLocalOfChildren Handle hoParent Handle hoMaxParent
36710>>>>>>>        Integer iIndex
36710>>>>>>>        Handle hoChild
36710>>>>>>>        
36710>>>>>>>        For iIndex from 0 to (Child_Count(hoParent) - 1)
36716>>>>>>>>
36716>>>>>>>            Get ChildByIndex of hoParent iIndex to hoChild
36717>>>>>>>            If (IsObjectOfClass(hoChild, RefClass(cWebObject))) Begin
36719>>>>>>>                Send CreateLocalFor hoChild hoParent hoMaxParent
36720>>>>>>>            End
36720>>>>>>>>
36720>>>>>>>        Loop
36721>>>>>>>>
36721>>>>>>>    End_Procedure
36722>>>>>>>    
36722>>>>>>>     
36722>>>>>>>    // Destroys all dynamic objects on the server. This procedure is
36722>>>>>>>    // executed after every call from the client to prevent spawning too 
36722>>>>>>>    // many objects in complex applications.
36722>>>>>>>    Procedure DestroyLocalObjects
36724>>>>>>>        Handle hoChild
36724>>>>>>>        Integer iObject
36724>>>>>>>        String sDynamicObjectName
36724>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36724>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36725>>>>>>>        tWebClientAction[] aClientActions
36725>>>>>>>        tWebClientAction[] aClientActions
36726>>>>>>>            
36726>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36727>>>>>>>        
36727>>>>>>>        For iObject from 0 to (Child_Count(Self) - 1)
36733>>>>>>>>
36733>>>>>>>            Get ChildByIndex iObject to hoChild
36734>>>>>>>            If (IsObjectOfClass(hoChild, RefClass(cWebObject))) Begin
36736>>>>>>>                Get psDynamicObjectId of hoChild to sDynamicObjectName
36737>>>>>>>                If (IsDynamicObject(hoChild) and SizeOfString(sDynamicObjectName)) Begin
36739>>>>>>>                    Send StoreDynamicDDOs hoChild
36740>>>>>>>                    Send Destroy of hoChild
36741>>>>>>>                    Decrement iObject
36742>>>>>>>                End
36742>>>>>>>>
36742>>>>>>>            End
36742>>>>>>>>
36742>>>>>>>        Loop
36743>>>>>>>>
36743>>>>>>>        
36743>>>>>>>        Move (ResizeArray(aDynamicObjectsInMemory, 0)) to aDynamicObjectsInMemory
36744>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36745>>>>>>>        Set paClientActionsQueue to aClientActions  // Should be empty, clear to preven cross session leakage
36746>>>>>>>    End_Procedure
36747>>>>>>>    
36747>>>>>>>    
36747>>>>>>>    // Returns the handle of a dynamic object from memory. Does not guarantee
36747>>>>>>>    // the object exists or is loaded. Do not use this method to get the handle
36747>>>>>>>    // of a dynamic object in applications. Use 'Get DynamicObject' instead.
36747>>>>>>>    Function StoredHandle String sDynamicObjectId Returns Handle
36749>>>>>>>        Integer iObjectIndex iHandleIndex
36749>>>>>>>        Handle hoObj
36749>>>>>>>        tObjectInMemory tObject
36749>>>>>>>        tObjectInMemory tObject
36749>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36749>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36750>>>>>>>
36750>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36751>>>>>>>        
36751>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36752>>>>>>>        
36752>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36753>>>>>>>        If (iHandleIndex <> -1) Begin
36755>>>>>>>            Move aDynamicObjectsInMemory[iHandleIndex].hoObj to hoObj
36756>>>>>>>        End
36756>>>>>>>>
36756>>>>>>>        
36756>>>>>>>        Function_Return hoObj
36757>>>>>>>    End_Function
36758>>>>>>>    
36758>>>>>>>    // Saves the handle for a dynamic object in memory.
36758>>>>>>>    Procedure StoreDirectHandle String sDynamicObjectId Handle hoObj
36760>>>>>>>        Integer iHandleIndex iIndex
36760>>>>>>>        tObjectInMemory tObject
36760>>>>>>>        tObjectInMemory tObject
36760>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36760>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36761>>>>>>>        
36761>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36762>>>>>>>        
36762>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36763>>>>>>>        
36763>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36764>>>>>>>        If (iHandleIndex <> -1) Begin
36766>>>>>>>            // Update handle
36766>>>>>>>            Move hoObj to aDynamicObjectsInMemory[iHandleIndex].hoObj
36767>>>>>>>        End
36767>>>>>>>>
36767>>>>>>>        Else Begin
36768>>>>>>>            // Set new handle
36768>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36769>>>>>>>            Move sDynamicObjectId to tObject.sDynamicObjectId
36770>>>>>>>            Move hoObj to tObject.hoObj
36771>>>>>>>            
36771>>>>>>>            Move (InsertInArray(aDynamicObjectsInMemory, iIndex, tObject)) to aDynamicObjectsInMemory
36772>>>>>>>        End  
36772>>>>>>>>
36772>>>>>>>        
36772>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36773>>>>>>>    End_Procedure
36774>>>>>>>    
36774>>>>>>>    // Saves the handle for a dynamic object in memory.
36774>>>>>>>    Procedure RetrieveOrCreateHandle String sDynamicObjectId Handle ByRef hoObj Handle hoParent Integer iClassId 
36776>>>>>>>        Integer iHandleIndex iIndex
36776>>>>>>>        tObjectInMemory tObject
36776>>>>>>>        tObjectInMemory tObject
36776>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36776>>>>>>>        tObjectInMemory[] aDynamicObjectsInMemory
36777>>>>>>>        
36777>>>>>>>        Get paDynamicObjectsInMemory to aDynamicObjectsInMemory
36778>>>>>>>        
36778>>>>>>>        Move sDynamicObjectId to tObject.sDynamicObjectId
36779>>>>>>>        
36779>>>>>>>        Move (BinarySearchArray(tObject, aDynamicObjectsInMemory, False)) to iHandleIndex
36780>>>>>>>        If (iHandleIndex <> -1) Begin
36782>>>>>>>            // Retrieve handle
36782>>>>>>>            Move aDynamicObjectsInMemory[iHandleIndex].hoObj to hoObj            
36783>>>>>>>        End
36783>>>>>>>>
36783>>>>>>>        Else Begin
36784>>>>>>>            // Create new handle
36784>>>>>>>            Move (BinarySearchInsertPos()) to iIndex
36785>>>>>>>            Move sDynamicObjectId to tObject.sDynamicObjectId
36786>>>>>>>            
36786>>>>>>>            Get CreateNamed of hoParent iClassId ("#" + sDynamicObjectId) to hoObj
36787>>>>>>>            Move hoObj to tObject.hoObj
36788>>>>>>>            
36788>>>>>>>            Move (InsertInArray(aDynamicObjectsInMemory, iIndex, tObject)) to aDynamicObjectsInMemory
36789>>>>>>>        End  
36789>>>>>>>>
36789>>>>>>>        
36789>>>>>>>        Set paDynamicObjectsInMemory to aDynamicObjectsInMemory
36790>>>>>>>    End_Procedure
36791>>>>>>>    
36791>>>>>>>    
36791>>>>>>>    // ==========================================
36791>>>>>>>    // SYNCHRONIZED PROPERTY HANDLING (3RD LEVEL)
36791>>>>>>>    // ==========================================
36791>>>>>>>    
36791>>>>>>>    // Dynamic objects have three levels of properties. The first level contains properties that
36791>>>>>>>    // are set in the subclass definition of the object. The second level properties (called 
36791>>>>>>>    // dynamic properties) can be different for individual instances of objects. Two dynamic
36791>>>>>>>    // buttons of the same class can have different initial properties. The third and final 
36791>>>>>>>    // level contains properties that are changed at runtime. This is done using regular
36791>>>>>>>    // WebGet/WebSet operations.
36791>>>>>>>    
36791>>>>>>>    
36791>>>>>>>    // Sets a synchronized property.
36791>>>>>>>    Procedure OwnerSetSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Variant vPropValue
36793>>>>>>>        Integer iPubPropIndex
36793>>>>>>>        String sObjName sDynamicObjectId
36793>>>>>>>        Boolean bIsRendered bAdvanced bIsAjaxWebObject
36793>>>>>>>        tWebNameValue tProp
36793>>>>>>>        tWebNameValue tProp
36793>>>>>>>        tWebAdvSyncProp tAdvProp
36793>>>>>>>        tWebAdvSyncProp tAdvProp
36793>>>>>>>        tQueuedSyncProp tQueuedProp
36793>>>>>>>        tQueuedSyncProp tQueuedProp
36793>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36793>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue
36794>>>>>>>
36794>>>>>>>                
36794>>>>>>>        // Test that the target object is a cWebObject....
36794>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36795>>>>>>>        
36795>>>>>>>        If (not(bIsAjaxWebObject)) Begin
36797>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
36798>>>>>>>>
36798>>>>>>>            Procedure_Return
36799>>>>>>>        End
36799>>>>>>>>
36799>>>>>>>               
36799>>>>>>>        
36799>>>>>>>        Get WebObjectName of hoObj to sObjName
36800>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
36801>>>>>>>        Move False to bAdvanced
36802>>>>>>>        
36802>>>>>>>        // Check if property is advanced
36802>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
36804>>>>>>>            Move True to bAdvanced
36805>>>>>>>        End
36805>>>>>>>>
36805>>>>>>>        
36805>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
36805>>>>>>>        // Therefore, all properties set before an object is rendered will be added
36805>>>>>>>        // to a special queue, so they are initialized when the object is created.
36805>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
36806>>>>>>>        If (not(bIsRendered) and (pubProp.eMode = wptClient or pubProp.eMode = wptClientProtected)) Begin
36808>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36809>>>>>>>            
36809>>>>>>>            Move sObjName to tQueuedProp.sO
36810>>>>>>>            Move pubProp.sName to tQueuedProp.sP
36811>>>>>>>            
36811>>>>>>>            If (bAdvanced) Begin
36813>>>>>>>                Move True to tQueuedProp.bA
36814>>>>>>>                ValueTreeSerializeParameter vPropValue to tQueuedProp.tVT  
36815>>>>>>>            End
36815>>>>>>>>
36815>>>>>>>            Else Begin
36816>>>>>>>                Move False to tQueuedProp.bA
36817>>>>>>>                Get ConvertToTransport of hoObj pubProp.hmGetter vPropValue pubProp.eType to tQueuedProp.sV
36818>>>>>>>            End
36818>>>>>>>>
36818>>>>>>>            
36818>>>>>>>            Move tQueuedProp to aSyncPropsQueue[SizeOfArray(aSyncPropsQueue)]
36819>>>>>>>            WebSet paSyncPropsQueue to aSyncPropsQueue
36820>>>>>>>            
36820>>>>>>>            If (pubProp.eMode = wptClient) ;                Procedure_Return
36823>>>>>>>        End
36823>>>>>>>>
36823>>>>>>>        
36823>>>>>>>        // This function accepts both advanced and regular properties.        
36823>>>>>>>        If (bAdvanced) Begin
36825>>>>>>>            ValueTreeSerializeParameter vPropValue to tAdvProp.tV
36826>>>>>>>            Move sObjName to tAdvProp.sO
36827>>>>>>>            Move pubProp.sName to tAdvProp.sP
36828>>>>>>>            
36828>>>>>>>            If (pubProp.eMode = wptClientProtected) Begin
36830>>>>>>>                Send SetAdvPropInWrapper wptClient (&tAdvProp)
36831>>>>>>>                Send SetAdvPropInWrapper wptServerPage (&tAdvProp)
36832>>>>>>>            End
36832>>>>>>>>
36832>>>>>>>            Else Begin
36833>>>>>>>                Send SetAdvPropInWrapper pubProp.eMode (&tAdvProp)
36834>>>>>>>            End
36834>>>>>>>>
36834>>>>>>>        End
36834>>>>>>>>
36834>>>>>>>        Else Begin
36835>>>>>>>            Move pubProp.sName to tProp.sN
36836>>>>>>>            Get ConvertToTransport of hoObj pubProp.hmGetter vPropValue pubProp.eType to  tProp.sV
36837>>>>>>>           
36837>>>>>>>            If (pubProp.eMode = wptClientProtected) Begin
36839>>>>>>>                If (bIsRendered) ;                    Send SetPropInWrapper wptClient sObjName (&tProp)
36842>>>>>>>                Send SetPropInWrapper wptServerPage sObjName (&tProp)
36843>>>>>>>            End
36843>>>>>>>>
36843>>>>>>>            Else Begin
36844>>>>>>>                Send SetPropInWrapper pubProp.eMode sObjName (&tProp)
36845>>>>>>>            End
36845>>>>>>>>
36845>>>>>>>           
36845>>>>>>>        End 
36845>>>>>>>>
36845>>>>>>>    End_Procedure
36846>>>>>>>    
36846>>>>>>>    Procedure SetPropInWrapper Integer eMode String sObjectName tWebNameValue ByRef newProp
36848>>>>>>>        tWebSyncPropsWrapper wrapper
36848>>>>>>>        tWebSyncPropsWrapper wrapper
36848>>>>>>>        tWebSyncProps objProps
36848>>>>>>>        tWebSyncProps objProps
36848>>>>>>>        Integer iObjectIndex iPropIndex
36848>>>>>>>        
36848>>>>>>>        If (eMode = wptClient) Begin
36850>>>>>>>            WebGet ptSyncPropsWrapper to wrapper
36851>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36852>>>>>>>        End
36852>>>>>>>>
36852>>>>>>>        Else If (eMode = wptServerPage) Begin
36855>>>>>>>            WebGet ptSyncServerPropsWrapper to wrapper
36856>>>>>>>        End
36856>>>>>>>>
36856>>>>>>>        Else If (eMode = wptServerSession) Begin
36859>>>>>>>            WebGet ptSyncServerSessionPropsWrapper to wrapper 
36860>>>>>>>        End
36860>>>>>>>>
36860>>>>>>>        
36860>>>>>>>        
36860>>>>>>>        Move sObjectName to objProps.sO
36861>>>>>>>        
36861>>>>>>>        // First find the object containing all properties for a dynamic object            
36861>>>>>>>        Move (BinarySearchArray(objProps, wrapper.aSyncProps, False)) to iObjectIndex
36862>>>>>>>        If (iObjectIndex <> -1) Begin
36864>>>>>>>            Move (BinarySearchArray(newProp, wrapper.aSyncProps[iObjectIndex].aP, False)) to iPropIndex
36865>>>>>>>            If (iPropIndex <> -1) Begin
36867>>>>>>>                // Update property value
36867>>>>>>>                Move newProp.sV to wrapper.aSyncProps[iObjectIndex].aP[iPropIndex].sV
36868>>>>>>>            End
36868>>>>>>>>
36868>>>>>>>            Else Begin
36869>>>>>>>                // Add new property
36869>>>>>>>                Move (BinarySearchInsertPos()) to iPropIndex
36870>>>>>>>                
36870>>>>>>>                Move (InsertInArray(wrapper.aSyncProps[iObjectIndex].aP, iPropIndex, newProp)) to wrapper.aSyncProps[iObjectIndex].aP
36871>>>>>>>            End
36871>>>>>>>>
36871>>>>>>>        End
36871>>>>>>>>
36871>>>>>>>        Else Begin
36872>>>>>>>            // Object has no synchronized properties yet, so add an entry for this object
36872>>>>>>>            Move (BinarySearchInsertPos()) to iObjectIndex
36873>>>>>>>            
36873>>>>>>>            Move newProp to objProps.aP[0]
36874>>>>>>>            
36874>>>>>>>            Move (InsertInArray(wrapper.aSyncProps, iObjectIndex, objProps)) to wrapper.aSyncProps
36875>>>>>>>        End
36875>>>>>>>>
36875>>>>>>>        
36875>>>>>>>        If (eMode = wptClient) Begin
36877>>>>>>>            WebSet ptSyncPropsWrapper to wrapper
36878>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36879>>>>>>>        End
36879>>>>>>>>
36879>>>>>>>        Else If (eMode = wptServerPage) Begin
36882>>>>>>>            WebSet ptSyncServerPropsWrapper to wrapper
36883>>>>>>>        End
36883>>>>>>>>
36883>>>>>>>        Else If (eMode = wptServerSession) Begin
36886>>>>>>>            WebSet ptSyncServerSessionPropsWrapper to wrapper 
36887>>>>>>>        End        
36887>>>>>>>>
36887>>>>>>>    End_Procedure
36888>>>>>>>    
36888>>>>>>>    Procedure SetAdvPropInWrapper  Integer eMode tWebAdvSyncProp ByRef newProp
36890>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36890>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36890>>>>>>>        Integer iPropIndex
36890>>>>>>>        
36890>>>>>>>        If (eMode = wptClient) Begin
36892>>>>>>>            WebGet ptAdvSyncPropsWrapper to wrapper
36893>>>>>>>        End
36893>>>>>>>>
36893>>>>>>>        Else If (eMode = wptServerPage) Begin
36896>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to wrapper
36897>>>>>>>        End
36897>>>>>>>>
36897>>>>>>>        Else If (eMode = wptServerSession) Begin
36900>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to wrapper 
36901>>>>>>>        End
36901>>>>>>>>
36901>>>>>>>
36901>>>>>>>        
36901>>>>>>>        
36901>>>>>>>        // First find the object containing all advanced properties for a dynamic object            
36901>>>>>>>        Move (SearchArray(newProp, wrapper.aAdvSyncProps, Self, RefFunc(CompareAdvProp))) to iPropIndex
36902>>>>>>>        Move newProp to wrapper.aAdvSyncProps[iPropIndex]
36903>>>>>>>        
36903>>>>>>>        If (eMode = wptClient) Begin
36905>>>>>>>            WebSet ptAdvSyncPropsWrapper to wrapper
36906>>>>>>>        End
36906>>>>>>>>
36906>>>>>>>        Else If (eMode = wptServerPage) Begin
36909>>>>>>>            WebSet ptAdvServerSyncPropsWrapper to wrapper
36910>>>>>>>        End
36910>>>>>>>>
36910>>>>>>>        Else If (eMode = wptServerSession) Begin
36913>>>>>>>            WebSet ptAdvServerSessionSyncPropsWrapper to wrapper 
36914>>>>>>>        End
36914>>>>>>>>
36914>>>>>>>    End_Procedure
36915>>>>>>>    
36915>>>>>>>    
36915>>>>>>>    
36915>>>>>>>    // Gets a synchronized property.
36915>>>>>>>    Function OwnerGetSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Returns String
36917>>>>>>>        String sResult
36917>>>>>>>        Integer iObjectIndex iPropIndex 
36917>>>>>>>        String sObjName sDynamicObjectId
36917>>>>>>>        Boolean bExists bIsRendered bIsAjaxWebObject
36917>>>>>>>        tWebNameValue tProp tCompareProp
36917>>>>>>>        tWebNameValue tProp tCompareProp
36917>>>>>>>        tWebValueTree tVT
36917>>>>>>>        tWebValueTree tVT
36917>>>>>>>        tWebSyncProps tCompareSyncProps
36917>>>>>>>        tWebSyncProps tCompareSyncProps
36917>>>>>>>        tWebSyncProps[] aSyncProps
36917>>>>>>>        tWebSyncProps[] aSyncProps
36918>>>>>>>        tWebSyncPropsWrapper wrapper
36918>>>>>>>        tWebSyncPropsWrapper wrapper
36918>>>>>>>        tQueuedSyncProp tQueuedProp
36918>>>>>>>        tQueuedSyncProp tQueuedProp
36918>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36918>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36919>>>>>>>        
36919>>>>>>>        // Test that the target object is a cWebObject....
36919>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36920>>>>>>>        
36920>>>>>>>        If (not(bIsAjaxWebObject)) Begin
36922>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
36923>>>>>>>>
36923>>>>>>>            Procedure_Return
36924>>>>>>>        End
36924>>>>>>>>
36924>>>>>>>        
36924>>>>>>>        
36924>>>>>>>        Get WebObjectName of hoObj to sObjName
36925>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
36926>>>>>>>        
36926>>>>>>>        
36926>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
36926>>>>>>>        // Therefore, all properties set before an object is rendered are added
36926>>>>>>>        // to a special queue, so they are initialized when the object is created.
36926>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
36927>>>>>>>        If (not(bIsRendered) and pubProp.eMode = wptClient) Begin
36929>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36930>>>>>>>            
36930>>>>>>>            Move sObjName to tQueuedProp.sO
36931>>>>>>>            Move pubProp.sName to tQueuedProp.sP
36932>>>>>>>            Move (SearchArray(tQueuedProp, aSyncPropsQueue, (Self), (RefFunc(CompareQueuedSyncProps)))) to iPropIndex
36933>>>>>>>            If (iPropIndex <> -1) Begin
36935>>>>>>>                Move aSyncPropsQueue[iPropIndex].sV to sResult
36936>>>>>>>                
36936>>>>>>>                Function_Return sResult
36937>>>>>>>            End
36937>>>>>>>>
36937>>>>>>>            
36937>>>>>>>            // This code is only reached if the property is not synchronized. Therefore, 
36937>>>>>>>            // return the default value of the property.
36937>>>>>>>            Get pubProp.hmGetter of hoObj to sResult
36938>>>>>>>            Function_Return sResult  
36939>>>>>>>        End
36939>>>>>>>>
36939>>>>>>>        
36939>>>>>>>        // This function accepts only scalar properties
36939>>>>>>>        If (pubProp.eMode = wptClient) Begin
36941>>>>>>>            WebGet ptSyncPropsWrapper to wrapper
36942>>>>>>>            Move (SortArray(wrapper.aSyncProps, False)) to wrapper.aSyncProps
36943>>>>>>>        End
36943>>>>>>>>
36943>>>>>>>        Else If (pubProp.eMode = wptServerPage or pubProp.eMode = wptClientProtected) Begin
36946>>>>>>>            WebGet ptSyncServerPropsWrapper to wrapper
36947>>>>>>>        End
36947>>>>>>>>
36947>>>>>>>        Else If (pubProp.eMode = wptServerSession) Begin
36950>>>>>>>            WebGet ptSyncServerSessionPropsWrapper to wrapper 
36951>>>>>>>        End
36951>>>>>>>>
36951>>>>>>>        
36951>>>>>>>        Move sObjName to tCompareSyncProps.sO
36952>>>>>>>        
36952>>>>>>>        // Check if object has any synchronized properties
36952>>>>>>>        Move (BinarySearchArray(tCompareSyncProps, wrapper.aSyncProps, False)) to iObjectIndex
36953>>>>>>>        If (iObjectIndex <> -1) Begin    
36955>>>>>>>            Move pubProp.sName to tCompareProp.sN
36956>>>>>>>                  
36956>>>>>>>            // Check if object has given synchronized property
36956>>>>>>>            Move (BinarySearchArray(tCompareProp, wrapper.aSyncProps[iObjectIndex].aP, False)) to iPropIndex
36957>>>>>>>            If (iPropIndex <> -1) Begin
36959>>>>>>>                Get ConvertFromTransport of hoObj pubProp.hmGetter wrapper.aSyncProps[iObjectIndex].aP[iPropIndex].sV pubProp.eType to sResult
36960>>>>>>>                Function_Return sResult
36961>>>>>>>            End
36961>>>>>>>>
36961>>>>>>>        End
36961>>>>>>>>
36961>>>>>>>        
36961>>>>>>>        // This code is only reached if the property is not synchronized. Therefore, 
36961>>>>>>>        // return the default value of the property.
36961>>>>>>>        Get pubProp.hmGetter of hoObj to sResult
36962>>>>>>>        Function_Return sResult             
36963>>>>>>>    End_Function
36964>>>>>>>   
36964>>>>>>>   
36964>>>>>>>    // Gets a synchronized property.
36964>>>>>>>    Function OwnerGetAdvSyncProp Handle hoObj tWebPropMetaData ByRef pubProp Returns Variant
36966>>>>>>>        Variant vResult
36966>>>>>>>        Integer iPropIndex iPubPropIndex iGetterIndex
36966>>>>>>>        String sObjName sDynamicObjectId
36966>>>>>>>        Boolean bExists bIsRendered bIsAjaxWebObject
36966>>>>>>>        tWebAdvSyncProp tCompareAdvProp 
36966>>>>>>>        tWebAdvSyncProp tCompareAdvProp 
36966>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36966>>>>>>>        tWebAdvSyncPropsWrapper wrapper
36966>>>>>>>        tQueuedSyncProp tQueuedProp
36966>>>>>>>        tQueuedSyncProp tQueuedProp
36966>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36966>>>>>>>        tQueuedSyncProp[] aSyncPropsQueue 
36967>>>>>>>                
36967>>>>>>>        // Test that the target object is a cWebObject....
36967>>>>>>>        Get IsAjaxWebObject of hoObj to bIsAjaxWebObject
36968>>>>>>>        
36968>>>>>>>        If (not(bIsAjaxWebObject)) Begin
36970>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, Name(hoObj), "WebSet " + pubProp.sName, C_NewLine+C_NewLine))
36971>>>>>>>>
36971>>>>>>>            Procedure_Return
36972>>>>>>>        End
36972>>>>>>>>
36972>>>>>>>        
36972>>>>>>>        
36972>>>>>>>        Get WebObjectName of hoObj to sObjName
36973>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
36974>>>>>>>            
36974>>>>>>>        // If the object has not been rendered yet, it is not known to the client.
36974>>>>>>>        // Therefore, all properties set before an object is rendered are added
36974>>>>>>>        // to a special queue, so they are initialized when the object is created.
36974>>>>>>>        Get IsRendered sDynamicObjectId to bIsRendered
36975>>>>>>>        If (not(bIsRendered) and pubProp.eMode = wptClient) Begin
36977>>>>>>>            WebGet paSyncPropsQueue to aSyncPropsQueue
36978>>>>>>>            
36978>>>>>>>            Move sObjName to tQueuedProp.sO
36979>>>>>>>            Move pubProp.sName to tQueuedProp.sP
36980>>>>>>>            Move (SearchArray(tQueuedProp, aSyncPropsQueue, (Self), (RefFunc(CompareQueuedSyncProps)))) to iPropIndex
36981>>>>>>>            If (iPropIndex <> -1) Begin
36983>>>>>>>                Get pubProp.hmGetter of hoObj to vResult
36984>>>>>>>                ValueTreeDeserializeParameter aSyncPropsQueue[iPropIndex].tVT to vResult
36985>>>>>>>            
36985>>>>>>>                Function_Return vResult
36986>>>>>>>            End
36986>>>>>>>>
36986>>>>>>>            
36986>>>>>>>            // This code is only reached if the property is not synchronized. Therefore, 
36986>>>>>>>            // return the default value of the property.
36986>>>>>>>            Get pubprop.hmGetter of hoObj to vResult
36987>>>>>>>            Function_Return vResult  
36988>>>>>>>        End
36988>>>>>>>>
36988>>>>>>>        
36988>>>>>>>        // This function accepts only non-scalar(advanced)
36988>>>>>>>        If (pubProp.eMode = wptClient) Begin
36990>>>>>>>            WebGet ptAdvSyncPropsWrapper to wrapper
36991>>>>>>>            Move (SortArray(wrapper.aAdvSyncProps, False)) to wrapper.aAdvSyncProps
36992>>>>>>>        End
36992>>>>>>>>
36992>>>>>>>        Else If (pubProp.eMode = wptServerPage or pubProp.eMode = wptClientProtected) Begin
36995>>>>>>>            WebGet ptAdvServerSyncPropsWrapper to wrapper
36996>>>>>>>        End
36996>>>>>>>>
36996>>>>>>>        Else If (pubProp.eMode = wptServerSession) Begin
36999>>>>>>>            WebGet ptAdvServerSessionSyncPropsWrapper to wrapper 
37000>>>>>>>        End
37000>>>>>>>>
37000>>>>>>>        
37000>>>>>>>        Move sObjName to tCompareAdvProp.sO
37001>>>>>>>        Move pubProp.sName to tCompareAdvProp.sP
37002>>>>>>>        
37002>>>>>>>        // Check if object has any advanced synchronized properties
37002>>>>>>>        Move (SearchArray(tCompareAdvProp, wrapper.aAdvSyncProps, Self, (RefFunc(CompareAdvProp)))) to iPropIndex
37003>>>>>>>        If (iPropIndex <> -1) Begin 
37005>>>>>>>            
37005>>>>>>>            Get pubProp.hmGetter of hoObj to vResult
37006>>>>>>>            ValueTreeDeserializeParameter wrapper.aAdvSyncProps[iPropIndex].tV to vResult
37007>>>>>>>        
37007>>>>>>>            Function_Return vResult
37008>>>>>>>        End
37008>>>>>>>>
37008>>>>>>>        
37008>>>>>>>        
37008>>>>>>>        // This code is only reached if the property is not synchronized. Therefore, 
37008>>>>>>>        // return the default value of the property.
37008>>>>>>>        Get pubProp.hmGetter of hoObj to vResult
37009>>>>>>>        Function_Return vResult             
37010>>>>>>>    End_Function
37011>>>>>>>    
37011>>>>>>>    // =====================================
37011>>>>>>>    // DYNAMIC PROPERTY HANDLING (2ND LEVEL)
37011>>>>>>>    // =====================================
37011>>>>>>>    
37011>>>>>>>    // Sets a dynamic property.
37011>>>>>>>    Procedure SetDynamicProp Handle hoObj tWebPropMetaData pubProp Variant vPropValue
37013>>>>>>>        Integer iObjectIndex iPropIndex iSize iIndex
37013>>>>>>>        String sDynamicObjectId sName
37013>>>>>>>        Boolean bAdvanced
37013>>>>>>>        Handle hmGetter
37013>>>>>>>        tWebNameValue   tCompareProp
37013>>>>>>>        tWebNameValue   tCompareProp
37013>>>>>>>        tWebAdvSyncProp tCompareAdvProp
37013>>>>>>>        tWebAdvSyncProp tCompareAdvProp
37013>>>>>>>        tWebValueTree tVT
37013>>>>>>>        tWebValueTree tVT
37013>>>>>>>        tWebDynamicObject tDynamicObject
37013>>>>>>>        tWebDynamicObject tDynamicObject
37013>>>>>>>        tWebDynamicObject[] aDynamicObjects
37013>>>>>>>        tWebDynamicObject[] aDynamicObjects
37014>>>>>>>        Get WebObjectName to sName
37015>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37016>>>>>>>        Get psDynamicObjectId of hoObj to sDynamicObjectId
37017>>>>>>>
37017>>>>>>>        
37017>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
37019>>>>>>>            Move True to bAdvanced
37020>>>>>>>        End
37020>>>>>>>>
37020>>>>>>>        
37020>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37021>>>>>>>        
37021>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37022>>>>>>>        If (iObjectIndex <> -1) Begin    
37024>>>>>>>            If (bAdvanced) Begin         
37026>>>>>>>                Move pubProp.sName to tCompareAdvProp.sP
37027>>>>>>>                ValueTreeSerializeParameter vPropValue to tVT
37028>>>>>>>                
37028>>>>>>>                // Then find the advanced property we are looking for
37028>>>>>>>                Move (BinarySearchArray(tCompareAdvProp, aDynamicObjects[iObjectIndex].aAdvProps, Self, RefFunc(CompareAdvPropNames))) to iPropIndex
37029>>>>>>>                If (iPropIndex <> -1) Begin
37031>>>>>>>                    // Update property value
37031>>>>>>>                    Move tVT to aDynamicObjects[iObjectIndex].aAdvProps[iPropIndex].tV
37032>>>>>>>                End
37032>>>>>>>>
37032>>>>>>>                Else Begin
37033>>>>>>>                    // Add new property     
37033>>>>>>>                    Move (BinarySearchInsertPos()) to iIndex
37034>>>>>>>                    
37034>>>>>>>                    Move pubProp.sName to tCompareAdvProp.sP
37035>>>>>>>                    Move tVT       to tCompareAdvProp.tV
37036>>>>>>>                    Move (InsertInArray(aDynamicObjects[iObjectIndex].aAdvProps, iIndex, tCompareAdvProp)) to aDynamicObjects[iObjectIndex].aAdvProps
37037>>>>>>>                End
37037>>>>>>>>
37037>>>>>>>                
37037>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
37038>>>>>>>            End
37038>>>>>>>>
37038>>>>>>>            Else Begin              
37039>>>>>>>                Move pubProp.sName to tCompareProp.sN
37040>>>>>>>                
37040>>>>>>>                // Find the property we are looking for
37040>>>>>>>                Move (BinarySearchArray(tCompareProp, aDynamicObjects[iObjectIndex].aProps, False)) to iPropIndex
37041>>>>>>>                If (iPropIndex <> -1) Begin
37043>>>>>>>                    // Update prop value
37043>>>>>>>                    Move pubProp.sName to aDynamicObjects[iObjectIndex].aProps[iPropIndex].sN
37044>>>>>>>                    Move (String(vPropValue)) to aDynamicObjects[iObjectIndex].aProps[iPropIndex].sV
37045>>>>>>>                End
37045>>>>>>>>
37045>>>>>>>                Else Begin
37046>>>>>>>                    // Add new property                   
37046>>>>>>>                    Move (BinarySearchInsertPos()) to iIndex
37047>>>>>>>                    
37047>>>>>>>                    Move pubProp.sName to tCompareProp.sN
37048>>>>>>>                    Move (String(vPropValue)) to tCompareProp.sV
37049>>>>>>>                    Move (InsertInArray(aDynamicObjects[iObjectIndex].aProps, iIndex, tCompareProp)) to aDynamicObjects[iObjectIndex].aProps
37050>>>>>>>                End
37050>>>>>>>>
37050>>>>>>>                
37050>>>>>>>                WebSet paDynamicObjects to aDynamicObjects
37051>>>>>>>            End
37051>>>>>>>>
37051>>>>>>>        End
37051>>>>>>>>
37051>>>>>>>    End_Procedure
37052>>>>>>>    
37052>>>>>>>    
37052>>>>>>>    // Updates the given object with all set dynamic properties
37052>>>>>>>    Procedure ApplyDynamicProps String sDynamicObjectId Handle hoObj
37054>>>>>>>        String sPropName sPropValue sObject
37054>>>>>>>        Integer iObjectIndex icProps iProp iPubPropIndex
37054>>>>>>>        Variant vPropValue
37054>>>>>>>        Handle hmSetter hmGetter
37054>>>>>>>        tWebDynamicObject tDynamicObject
37054>>>>>>>        tWebDynamicObject tDynamicObject
37054>>>>>>>        tWebDynamicObject[] aDynamicObjects
37054>>>>>>>        tWebDynamicObject[] aDynamicObjects
37055>>>>>>>        String[] aParams
37056>>>>>>>        tWebPropMetaData pubProp
37056>>>>>>>        tWebPropMetaData pubProp
37056>>>>>>>        
37056>>>>>>>        WebGet paDynamicObjects to aDynamicObjects
37057>>>>>>>        
37057>>>>>>>        Move sDynamicObjectId to tDynamicObject.sId
37058>>>>>>>        
37058>>>>>>>        Move (BinarySearchArray(tDynamicObject, aDynamicObjects, False)) to iObjectIndex
37059>>>>>>>        If (iObjectIndex <> -1) Begin           
37061>>>>>>>            // Apply regular props
37061>>>>>>>            Move (SizeOfArray(aDynamicObjects[iObjectIndex].aProps)) to icProps
37062>>>>>>>            For iProp from 0 to (icProps - 1) 
37068>>>>>>>>
37068>>>>>>>                Move aDynamicObjects[iObjectIndex].aProps[iProp].sN to sPropName
37069>>>>>>>                Move aDynamicObjects[iObjectIndex].aProps[iProp].sV to sPropValue
37070>>>>>>>                
37070>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to pubProp
37071>>>>>>>                Set pubProp.hmSetter of hoObj to sPropValue
37072>>>>>>>            Loop
37073>>>>>>>>
37073>>>>>>>            
37073>>>>>>>            // Apply advanced props
37073>>>>>>>            Move (SizeOfArray(aDynamicObjects[iObjectIndex].aAdvProps)) to icProps
37074>>>>>>>            For iProp from 0 to (icProps - 1)
37080>>>>>>>>
37080>>>>>>>                Move aDynamicObjects[iObjectIndex].aAdvProps[iProp].sP to sPropName
37081>>>>>>>                Get FindWebPropertyMetaByName of hoObj sPropName to pubProp
37082>>>>>>>                
37082>>>>>>>                If (pubProp.hmGetter <= 0) Begin
37084>>>>>>>                    Get Object_Label of hoObj to sObject
37085>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSet", sPropName, sObject, C_NewLine+C_NewLine))        
37086>>>>>>>>
37086>>>>>>>                    Function_Return
37087>>>>>>>                End
37087>>>>>>>>
37087>>>>>>>                
37087>>>>>>>                // This step is important, as otherwise the system won't know
37087>>>>>>>                // the actual type of the variant.
37087>>>>>>>                Get pubProp.hmGetter of hoObj to vPropValue
37088>>>>>>>                ValueTreeDeserializeParameter aDynamicObjects[iObjectIndex].aAdvProps[iProp].tV to vPropValue
37089>>>>>>>                Set pubprop.hmSetter of hoObj to vPropValue
37090>>>>>>>            Loop
37091>>>>>>>>
37091>>>>>>>        End
37091>>>>>>>>
37091>>>>>>>    End_Procedure   
