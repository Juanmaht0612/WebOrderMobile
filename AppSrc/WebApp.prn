29605>>>>>>>>>>>        //  Parse and validate content type
29605>>>>>>>>>>>        Get GetContentType to sContentType
29606>>>>>>>>>>>        Get ParseContentType (&sContentType) to aContentValues
29607>>>>>>>>>>>        If (sContentType <> "multipart/form-data") Begin
29609>>>>>>>>>>>            Set piParseErrorCode to 1
29610>>>>>>>>>>>            Set psParseError to "Invalid request format: expected multipart/form-data post"
29611>>>>>>>>>>>            Function_Return False
29612>>>>>>>>>>>        End
29612>>>>>>>>>>>>
29612>>>>>>>>>>>        
29612>>>>>>>>>>>        //  Find BOUNDARY value
29612>>>>>>>>>>>        Move "BOUNDARY" to tSearch.sName
29613>>>>>>>>>>>        Move (SearchArray(tSearch, aContentValues)) to iIndex
29614>>>>>>>>>>>        If (iIndex < 0) Begin
29616>>>>>>>>>>>            Set piParseErrorCode to 2
29617>>>>>>>>>>>            Set psParseError to "Invalid request format: expected boundary in content-type"
29618>>>>>>>>>>>            Function_Return False
