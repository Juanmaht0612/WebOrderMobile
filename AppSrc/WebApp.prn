30619>>>>>>>        
30619>>>>>>>        Get paChangeRightsClients to aClients
30620>>>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
30621>>>>>>>        
30621>>>>>>>        If (iPos <> -1) Begin
30623>>>>>>>            Move (RemoveFromArray(aClients, iPos)) to aClients
30624>>>>>>>            Set paChangeRightsClients to aClients
30625>>>>>>>        End
30625>>>>>>>>
30625>>>>>>>    End_Procedure
