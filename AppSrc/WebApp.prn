27742>>>>>>> 
27742>>>>>>>    Procedure NotifySyncWebApp
27744>>>>>>>        Send OnSyncView
27745>>>>>>>    End_Procedure
27746>>>>>>>   
27746>>>>>>>    Procedure OnSubmit
27748>>>>>>>        // Event stub that is called when enter is used within the view.
27748>>>>>>>    End_Procedure
27749>>>>>>>    
27749>>>>>>>    
27749>>>>>>>    // Event that is fired when the size of the browser window changes. This event can be used to 
27749>>>>>>>    // make the web application layout responsive to the browser size. It gets the new dimensions
27749>>>>>>>    // of the browser window passed as parameters.
27749>>>>>>>    //
27749>>>>>>>    // Params:
27749>>>>>>>    //  iWindowWidth    Width of the browser window in pixels.
27749>>>>>>>    //  iWindowHeight   Height of the browser window in pixels.
27749>>>>>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
27751>>>>>>>    End_Procedure    
27752>>>>>>>
27752>>>>>>>    // Generic request find method for handling Request_Find
27752>>>>>>>    // Currently this will get delegated here by objects that do not understand Requset_Find. In the
27752>>>>>>>    // future we could use DEO_Find_Object to not send these messages at all.
27752>>>>>>>    // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
27752>>>>>>>    Procedure Request_Find Integer eFindMode
27754>>>>>>>        // Do nothing. Ignore this message in this class.
27754>>>>>>>    End_Procedure
27755>>>>>>>
27755>>>>>>>
27755>>>>>>>    //  Performs the initialization of the view when it is loaded to the client. It is called by 
27755>>>>>>>    //  cWebApp at the right moment (pbOverrideStateOnShow influences this). Clears the DDO 
27755>>>>>>>    //  structures, adds key handlers and sends OnResizeWindow.
27755>>>>>>>    //    
27755>>>>>>>    Procedure InitForShow
27757>>>>>>>        Integer i iCount iWidth iHeight
27757>>>>>>>        Handle hoMainDD
27757>>>>>>>        Handle[] aAdditionalDDOStructures 
27758>>>>>>>        tNameHandlePair[] aDDOs
27758>>>>>>>        tNameHandlePair[] aDDOs
27759>>>>>>>        Boolean bOnResize bPreLoaded bDynamicConstraints
27759>>>>>>>        tDDRemembered[] aEmptyRemembered
27759>>>>>>>        tDDRemembered[] aEmptyRemembered
27760>>>>>>>        
27760>>>>>>>        //  If this is a preloaded view we skip initforshow
27760>>>>>>>        WebGet pbPreLoaded to bPreLoaded
27761>>>>>>>        If (bPreLoaded) Begin
27763>>>>>>>            WebSet pbPreLoaded to False
27764>>>>>>>            Procedure_Return
27765>>>>>>>        End
27765>>>>>>>>
27765>>>>>>>        
27765>>>>>>>        Get Main_DD to hoMainDD
27766>>>>>>>        If (hoMainDD <> 0) Begin
27768>>>>>>>            // Clear dynamic constraints that might have been left from previous show
27768>>>>>>>            Get IsDynamicConstraints to bDynamicConstraints
27769>>>>>>>            If (bDynamicConstraints) Begin
27771>>>>>>>                Send ClearConstrainFiles hoMainDD
27772>>>>>>>                Send Rebuild_Constraints of hoMainDD
27773>>>>>>>            End
27773>>>>>>>>
27773>>>>>>>        End
27773>>>>>>>>
27773>>>>>>>        
27773>>>>>>>        Set pbInitForShow to True
27774>>>>>>>        
27774>>>>>>>        // Clear remember values
27774>>>>>>>        Get paDDOIndex to aDDOs
27775>>>>>>>        Move (SizeOfArray(aDDOs) - 1) to iCount
27776>>>>>>>        For i from 0 to iCount
27782>>>>>>>>
27782>>>>>>>            Set pDDDefaults of aDDOs[i].hValue to aEmptyRemembered
27783>>>>>>>        Loop
27784>>>>>>>>
27784>>>>>>>        
27784>>>>>>>        // Clear the main DDO structure
27784>>>>>>>        If (hoMainDD <> 0) Begin
27786>>>>>>>            Send Clear_All of hoMainDD
27787>>>>>>>        End
27787>>>>>>>>
27787>>>>>>>        
27787>>>>>>>        // Now clear the main dd of any 'additional' DDO structures
27787>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
27788>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
27789>>>>>>>        
27789>>>>>>>        For i from 0 to (iCount - 1)
27795>>>>>>>>
27795>>>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
27797>>>>>>>                Send Clear_All of aAdditionalDDOStructures[i]
27798>>>>>>>            End
27798>>>>>>>>
27798>>>>>>>        Loop
27799>>>>>>>>
27799>>>>>>>        
27799>>>>>>>        //  Rebuild constraints
27799>>>>>>>        Send RebuildDDConstraints
27800>>>>>>>        
27800>>>>>>>        //  Trigger resize event
27800>>>>>>>        Get pbServerOnResizeWindow to bOnResize
27801>>>>>>>        If (bOnResize) Begin
27803>>>>>>>            WebGet piWindowWidth of (Host(Self)) to iWidth
27804>>>>>>>            WebGet piWindowHeight of (Host(Self)) to iHeight
27805>>>>>>>            
27805>>>>>>>            Send OnResizeWindow iWidth iHeight
27806>>>>>>>        End
27806>>>>>>>>
27806>>>>>>>        
27806>>>>>>>        Set pbInitForShow to False
27807>>>>>>>    End_Procedure
27808>>>>>>>    
27808>>>>>>>    
27808>>>>>>>    //  Called always when the view is shown.
27808>>>>>>>    //  
27808>>>>>>>    Procedure DoShow
27810>>>>>>>        Boolean bOnShow
27810>>>>>>>        Integer eViewStyle
27810>>>>>>>        String sPrevHash sView sHashView
27810>>>>>>>        
27810>>>>>>>        //  Fire OnShow (optimization, used to be fired from JavaScript)
27810>>>>>>>        Send OnBeforeShow
27811>>>>>>>        
27811>>>>>>>        Get peWebViewStyle to eViewStyle
27812>>>>>>>        If (eViewStyle = wvsDesktop) Begin
27814>>>>>>>            
27814>>>>>>>            If (peStateMode(Self) <> vsmOff) Begin 
27816>>>>>>>                //  Replace state if the hash no location url
27816>>>>>>>                Get psStateViewName to sView
27817>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
27818>>>>>>>                Send ParseViewStateHash sPrevHash (&sHashView)
27819>>>>>>>                
27819>>>>>>>                If (Lowercase(sHashView) <> Lowercase(sView)) Begin
27821>>>>>>>                    Send UpdateStateHash ((Trim(sPrevHash) = "") or pbStateReplace(Self))            
27822>>>>>>>                End
27822>>>>>>>>
27822>>>>>>>            End
27822>>>>>>>>
27822>>>>>>>            Send UpdatePageTitle
27823>>>>>>>        End
27823>>>>>>>>
27823>>>>>>>        
27823>>>>>>>    End_Procedure
27824>>>>>>>    
27824>>>>>>>    
27824>>>>>>>    Procedure HandleFindKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27826>>>>>>>        Handle hoFocus
27826>>>>>>>        
27826>>>>>>>        If (pbFindKeys(Self)) Begin
27828>>>>>>>            Get DEOControlFocusObject to hoFocus
27829>>>>>>>            If (hoFocus) Begin
27831>>>>>>>                Case Begin
27831>>>>>>>                    Case (iKey = 119)
27833>>>>>>>                        Send Request_Find of hoFocus  GT
27834>>>>>>>                        Case Break
27835>>>>>>>                    Case (iKey = 118)
27838>>>>>>>                        Send Request_Find of hoFocus  LT
27839>>>>>>>                        Case Break
27840>>>>>>>                    Case (iKey = 120)
27843>>>>>>>                        Send Request_Find of hoFocus  GE
27844>>>>>>>                        Case Break
27845>>>>>>>                    Case (iKey = 36 and bCtrl)
27848>>>>>>>                        Send Request_Find of hoFocus  FIRST_RECORD
27849>>>>>>>                        Case Break
27850>>>>>>>                    Case (iKey = 35 and bCtrl)
27853>>>>>>>                        Send Request_Find of hoFocus  LAST_RECORD
27854>>>>>>>                        Case Break
27855>>>>>>>                Case End
27855>>>>>>>                
27855>>>>>>>            End
27855>>>>>>>>
27855>>>>>>>        End
27855>>>>>>>>
27855>>>>>>>    End_Procedure
27856>>>>>>>    
27856>>>>>>>    Procedure HandleClearKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27858>>>>>>>        Handle hoFocus
27858>>>>>>>        
27858>>>>>>>        If (pbClearKeys(Self) and iKey = 116) Begin 
27860>>>>>>>            Get DEOControlFocusObject to hoFocus
27861>>>>>>>            
27861>>>>>>>            If (hoFocus) Begin
27863>>>>>>>                If (bCtrl) Begin
27865>>>>>>>                    Send Request_Clear_All of hoFocus
27866>>>>>>>                End
27866>>>>>>>>
27866>>>>>>>                Else Begin
27867>>>>>>>                    Send Request_Clear of hoFocus
27868>>>>>>>                End
27868>>>>>>>>
27868>>>>>>>            End
27868>>>>>>>>
27868>>>>>>>        End
27868>>>>>>>>
27868>>>>>>>    End_Procedure
27869>>>>>>>    
27869>>>>>>>    Procedure HandleDeleteKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27871>>>>>>>        Handle hoFocus
27871>>>>>>>        
27871>>>>>>>        If (pbDeleteKeys(Self) and iKey = 113 and bShift) Begin
27873>>>>>>>            Get DEOFocusObject to hoFocus
27874>>>>>>>            If hoFocus Begin
27876>>>>>>>                Send Request_Delete of hoFocus
27877>>>>>>>            End
27877>>>>>>>>
27877>>>>>>>        End
27877>>>>>>>>
27877>>>>>>>    End_Procedure
27878>>>>>>>    
27878>>>>>>>    Procedure HandleSaveKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
27880>>>>>>>        Handle hoFocus
27880>>>>>>>        
27880>>>>>>>        If (pbSaveKeys(Self) and iKey = 113 and not(bShift)) Begin
27882>>>>>>>            Get DEOFocusObject to hoFocus
27883>>>>>>>            If hoFocus Begin
27885>>>>>>>                Send Request_Save of hoFocus
27886>>>>>>>            End
27886>>>>>>>>
27886>>>>>>>        End
27886>>>>>>>>
27886>>>>>>>    End_Procedure
27887>>>>>>>    
27887>>>>>>>    
27887>>>>>>>    
27887>>>>>>>    Procedure DefaultKeyHandlers
27889>>>>>>>        If (pbFindKeys(Self)) Begin
27891>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 119 False False False   //  F8
27892>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 118 False False False   //  F7
27893>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 120 False False False   //  F9
27894>>>>>>>            
27894>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 36 False False True     //  Ctrl - home
27895>>>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 35 False False True     //  Ctrl - end
27896>>>>>>>        End
27896>>>>>>>>
27896>>>>>>>        
27896>>>>>>>        If (pbClearKeys(Self)) Begin
27898>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False False  //  F5
27899>>>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False True   //  Ctrl - F5
27900>>>>>>>        End
27900>>>>>>>>
27900>>>>>>>        
27900>>>>>>>        If (pbDeleteKeys(Self)) Begin
27902>>>>>>>            Send AddKeyHandler (RefProc(HandleDeleteKey)) 113 True False False  //  Shift - F2
27903>>>>>>>        End
27903>>>>>>>>
27903>>>>>>>        
27903>>>>>>>        If (pbSaveKeys(Self)) Begin
27905>>>>>>>            Send AddKeyHandler (RefProc(HandleSaveKey)) 113 False False False   //  F2
27906>>>>>>>        End
27906>>>>>>>>
27906>>>>>>>        
27906>>>>>>>    End_Procedure
27907>>>>>>>    
27907>>>>>>>    // Show an unhandled refind error for this DDO.
27907>>>>>>>    Procedure CannotRefindRecordUnhandledError Handle hoDDO
27909>>>>>>>        Integer iFile
27909>>>>>>>        String sExtMess sFile sView
27909>>>>>>>        Get WebObjectName to sView
27910>>>>>>>        Get Main_File of hoDDO to iFile
27911>>>>>>>        Get ErrorMessageTableName of hoDDO iFile to sFile
27912>>>>>>>        Move ("View:" * sView - "." * DD_FILE_TEXT * String(iFile) * "-" * sFile) to sExtMess
27913>>>>>>>        Error DFERR_REC_NOT_FOUND sExtMess
27914>>>>>>>>
27914>>>>>>>    End_Procedure
27915>>>>>>>
27915>>>>>>>    
27915>>>>>>>    // Sent when a NavigateForward fails. 
27915>>>>>>>    // By default call standard OnRefindRecordError and a NavigateCancel. This allows for customization
27915>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27915>>>>>>>    Procedure OnNavigateForwardRefindError Handle hoDD Integer eReason
27917>>>>>>>        Send OnRefindRecordError hoDD reoNavigateForward eReason
27918>>>>>>>        // we will cancel this navigation forward
27918>>>>>>>        Send NavigateCancel
27919>>>>>>>    End_Procedure
27920>>>>>>>
27920>>>>>>>    // Sent when a Navigate Back fails. 
27920>>>>>>>    // By default call standard OnRefindRecordError. This allows for customization
27920>>>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
27920>>>>>>>    Procedure OnNavigateBackRefindError Handle hoDD Integer eReason
27922>>>>>>>        Send OnRefindRecordError hoDD reoNavigateBack eReason
27923>>>>>>>    End_Procedure
27924>>>>>>>
27924>>>>>>>    
27924>>>>>>>    
27924>>>>>>>
27924>>>>>>>    // these are used for setting dynamic enabled controls
27924>>>>>>>     
27924>>>>>>>    // returns true if this view should not allow finds on main-dd DEOs
27924>>>>>>>    // You want no finds with drilldowns that don't come from a main (select to zoom for same DDO)
27924>>>>>>>    Function IsViewNoFindOnMain Returns Boolean
27926>>>>>>>        tWebNavigateData NData
27926>>>>>>>        tWebNavigateData NData
27926>>>>>>>        Integer eWebViewStyle
27926>>>>>>>        Get peWebViewStyle to eWebViewStyle
27927>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27929>>>>>>>            // typically if you navigated from main (from select) you
27929>>>>>>>            // will not want to allow finds or prompts on main field indexes
27929>>>>>>>            Get GetNavigateData to NData
27930>>>>>>>            Function_Return (NData.eNavigateType = nfFromMain)
27931>>>>>>>        End
27931>>>>>>>>
27931>>>>>>>        Else Begin
27932>>>>>>>            Function_Return False
27933>>>>>>>        End
27933>>>>>>>>
27933>>>>>>>    End_Function
27934>>>>>>>    
27934>>>>>>>    // this this view have a No finding on a constrained parent? 
27934>>>>>>>    // Normally drilldowns do not want finding on the constrained parent
27934>>>>>>>    Function IsViewNoFindOnConstrainedParent Returns Boolean
27936>>>>>>>        Integer eWebViewStyle
27936>>>>>>>        Get peWebViewStyle to eWebViewStyle
27937>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27939>>>>>>>            // typically with drill down views you don't allow finds on the
27939>>>>>>>            // constraining child, because that's what you drilled in from
27939>>>>>>>            Function_Return True
27940>>>>>>>        End
27940>>>>>>>>
27940>>>>>>>        Else Begin
27941>>>>>>>            Function_Return False
27942>>>>>>>        End
27942>>>>>>>>
27942>>>>>>>    End_Function
27943>>>>>>>    
27943>>>>>>>    // Is this a read-only. With drilldown this is set true
27943>>>>>>>    // when the NavigateData.bReadOnly is True.
27943>>>>>>>    Function IsViewReadOnly Returns Boolean
27945>>>>>>>        Integer eWebViewStyle
27945>>>>>>>        Get peWebViewStyle to eWebViewStyle
27946>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27948>>>>>>>            // if this was called as read only, it's read only
27948>>>>>>>            tWebNavigateData NData
27948>>>>>>>            tWebNavigateData NData
27948>>>>>>>            Get GetNavigateData to NData
27949>>>>>>>            Function_Return (NData.bReadOnly)
27950>>>>>>>        End
27950>>>>>>>>
27950>>>>>>>        Else Begin
27951>>>>>>>            Function_Return False
27952>>>>>>>        End
27952>>>>>>>>
27952>>>>>>>    End_Function
27953>>>>>>>    
27953>>>>>>>    // this just sets the view readonly property
27953>>>>>>>    // With drilldown style, this is set in tWebNavigateData
27953>>>>>>>    // With non-drilldown, it is not set and you'd have to do this yourself
27953>>>>>>>    Procedure SetViewReadOnly Boolean bReadOnly
27955>>>>>>>        tWebNavigateData NData
27955>>>>>>>        tWebNavigateData NData
27955>>>>>>>        Integer eWebViewStyle
27955>>>>>>>        Get peWebViewStyle to eWebViewStyle
27956>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
27958>>>>>>>            // set edit mode in NavigateData
27958>>>>>>>            Get GetNavigateData to NData
27959>>>>>>>            Move bReadOnly to NData.bReadOnly
27960>>>>>>>            Send SetNavigateData NData
27961>>>>>>>        End
27961>>>>>>>>
27961>>>>>>>    End_Procedure
27962>>>>>>>
27962>>>>>>>    // performs a refind and refresh based on the main view's DD record
27962>>>>>>>    // If the record cannot be found a handled error is raised
27962>>>>>>>    Procedure RefreshRecord
27964>>>>>>>        Handle hoDD
27964>>>>>>>        Integer iFile
27964>>>>>>>        RowID RID
27964>>>>>>>        Boolean bSuccess
27964>>>>>>>        Get Server to hoDD
27965>>>>>>>        If hoDD Begin
27967>>>>>>>            Get Main_File of hoDD to iFile
27968>>>>>>>            Get CurrentRowId of hoDD to RID
27969>>>>>>>            Get FindByRowIdEx of hoDD iFile RID to bSuccess
27970>>>>>>>            If not bSuccess Begin
27972>>>>>>>                Send OnRefreshRecordError hoDD
27973>>>>>>>            End
27973>>>>>>>>
27973>>>>>>>        End
27973>>>>>>>>
27973>>>>>>>    End_Procedure
27974>>>>>>>    
27974>>>>>>>    // Sets the edit mode
27974>>>>>>>    // refinds records and resets the DEOs as needed 
27974>>>>>>>    Procedure ChangeEditMode Boolean bEdit
27976>>>>>>>        Send SetViewReadOnly (not(bEdit))
27977>>>>>>>        // for a refind which will change enabled/disabled
27977>>>>>>>        Send RefreshRecord
27978>>>>>>>    End_Procedure
27979>>>>>>>
27979>>>>>>>
27979>>>>>>>    // called when after any save in this view. 
27979>>>>>>>    // bChanged is true if should_save was set and a save
27979>>>>>>>    // was actually attempted.
27979>>>>>>>    Procedure OnViewSaved Handle hoDDO Boolean bChanged
27981>>>>>>>    End_Procedure
27982>>>>>>>    
27982>>>>>>>    // called when after any delete in this view. 
27982>>>>>>>    Procedure OnViewDeleted Handle hoDDO 
27984>>>>>>>    End_Procedure
27985>>>>>>>
27985>>>>>>>    // called when after a clear in this view. 
27985>>>>>>>    Procedure OnViewCleared Handle hoDDO 
27987>>>>>>>    End_Procedure
27988>>>>>>>
27988>>>>>>>    // Is the view changed? 
27988>>>>>>>    // Currently we just look at should_save of the main ddo. We
27988>>>>>>>    // might want to expand this to look for changed children 
27988>>>>>>>    Function IsViewChanged Returns Boolean
27990>>>>>>>        Handle hoMain
27990>>>>>>>        Boolean bShouldSave
27990>>>>>>>        Get Main_DD to hoMain
27991>>>>>>>        
27991>>>>>>>        If (hoMain) Begin
27993>>>>>>>            Get Should_Save of hoMain to bShouldSave
27994>>>>>>>        End
27994>>>>>>>>
27994>>>>>>>        Function_Return bShouldSave
27995>>>>>>>    End_Function
27996>>>>>>>
27996>>>>>>>    // returns true if this should use dynamic constraints. By default
27996>>>>>>>    // desktop views never use this and probably never should.
27996>>>>>>>    // Drilldown views do use this but there may be times you'd want to stop this
27996>>>>>>>    // in which case you's set pbDrillDownDynamicConstraints to true. 
27996>>>>>>>    Function IsDynamicConstraints Returns Boolean
27998>>>>>>>        Integer eWebViewStyle
27998>>>>>>>        Boolean bDynamicConstraints
27998>>>>>>>        Get peWebViewStyle to eWebViewStyle
27999>>>>>>>        Get pbDrillDownDynamicConstraints to bDynamicConstraints
28000>>>>>>>        Function_Return (eWebViewStyle = wvsDrillDown and bDynamicConstraints)
28001>>>>>>>    End_Function
28002>>>>>>>    
28002>>>>>>>
28002>>>>>>>
28002>>>>>>>    
28002>>>>>>>
28002>>>>>>>
28002>>>>>>>    // We provide this because NavigateData is an important web property and these
28002>>>>>>>    // two messages can be accessed via delegation (which WebGet|WebSet pNavigateData cannot).
28002>>>>>>>    Function GetNavigateData Returns tWebNavigateData
28004>>>>>>>        tWebNavigateData NavigateData
28004>>>>>>>        tWebNavigateData NavigateData
28004>>>>>>>        WebGet pNavigateData to NavigateData
28005>>>>>>>        Function_Return NavigateData
28006>>>>>>>    End_Function
28007>>>>>>>
28007>>>>>>>    Procedure SetNavigateData tWebNavigateData NavigateData
28009>>>>>>>        WebSet pNavigateData to NavigateData
28010>>>>>>>    End_Procedure    
28011>>>>>>>
28011>>>>>>>    // helper for ClearConstrainFiles
28011>>>>>>>    Procedure ClearConstrainFile2 Handle hoDD
28013>>>>>>>        Handle hoDDNext
28013>>>>>>>        Integer iCount iMax
28013>>>>>>>        Set Visited_State of hoDD to True
28014>>>>>>>        // First process all server DDs
28014>>>>>>>        Get Data_Set_Server_Count of hoDD to iMax
28015>>>>>>>        For iCount from 0 to (iMax-1)
28021>>>>>>>>
28021>>>>>>>            Get Data_Set_Server of hoDD iCount to hoDDNext
28022>>>>>>>            If not (Visited_state(hoDDNext)) Begin
28024>>>>>>>                Send ClearConstrainFile2 hoDDNext
28025>>>>>>>            End
28025>>>>>>>>
28025>>>>>>>        Loop
28026>>>>>>>>
28026>>>>>>>        Set Constrain_File of hoDD to 0
28027>>>>>>>    End_Procedure
28028>>>>>>>
28028>>>>>>>    // clear all constrain files from the passed main DD on up.
28028>>>>>>>    Procedure ClearConstrainFiles Handle hoMainDD
28030>>>>>>>        If hoMainDD Begin
28032>>>>>>>            Send Initialize_Visited to hoMainDD False False // False=don't clear Column marks
28033>>>>>>>            Send ClearConstrainFile2 hoMainDD
28034>>>>>>>        End
28034>>>>>>>>
28034>>>>>>>    End_Procedure
28035>>>>>>>
28035>>>>>>>    // Returns the invokingobject when used in a drilldown
28035>>>>>>>    // NavigateFoward context. This should be an object within an invoking
28035>>>>>>>    // view or the invoking view. Often this would be the focus object when
28035>>>>>>>    // a prompt action is called.
28035>>>>>>>    Function GetInvokingObject Returns Handle 
28037>>>>>>>        Handle hoInvoker
28037>>>>>>>        String sInvoker
28037>>>>>>>        
28037>>>>>>>        Move C_WebUnresolvedObject to hoInvoker
28038>>>>>>>        
28038>>>>>>>        WebGet psInvokingObject to sInvoker
28039>>>>>>>        If (sInvoker <> "[NULL]") Begin
28041>>>>>>>            Get WebObjectByName sInvoker to hoInvoker
28042>>>>>>>        End
28042>>>>>>>>
28042>>>>>>>        
28042>>>>>>>        Function_Return hoInvoker        
28043>>>>>>>    End_Function
28044>>>>>>>
28044>>>>>>>    // Sets the invoking object for this view to hoInvokingObject.
28044>>>>>>>    Procedure SetInvokingObject Handle hoInvokingObject
28046>>>>>>>        Handle hoView
28046>>>>>>>        String sInvoker
28046>>>>>>>        
28046>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
28048>>>>>>>            Get WebObjectName of hoInvokingObject to sInvoker
28049>>>>>>>        End
28049>>>>>>>>
28049>>>>>>>        Else Begin
28050>>>>>>>            Move "[NULL]" to sInvoker
28051>>>>>>>        End
28051>>>>>>>>
28051>>>>>>>        
28051>>>>>>>        WebSet psInvokingObject to sInvoker
28052>>>>>>>    End_Procedure
28053>>>>>>>    
28053>>>>>>>    // Unconditionally navigate back to this view.
28053>>>>>>>    // We assume any data-loss checking has been done (if not, it's too late)
28053>>>>>>>    // If bCancel is true this is a Cancel operation (NavigateCancel), else a Close operation (NavigateClose)
28053>>>>>>>    // If a Close a callback, can and should be passed to update the NavigateData data before processing the close.
28053>>>>>>>    // This can be called when this view is not synched, in which case you should not trust the
28053>>>>>>>    // data or the web properties.
28053>>>>>>>    Procedure NavigateBackToHere Boolean bCancel Handle hoCallback
28055>>>>>>>        Handle hoTopView hoInvokingView
28055>>>>>>>        tWebValueTree tVT
28055>>>>>>>        tWebValueTree tVT
28055>>>>>>>        tWebNavigateData NavigateData
28055>>>>>>>        tWebNavigateData NavigateData
28055>>>>>>>        String[] aParams
28056>>>>>>>        
28056>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
28057>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
28058>>>>>>>        
28058>>>>>>>        
28058>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
28060>>>>>>>            // Get NavigateData from the view that is being closed
28060>>>>>>>            // start with the NavigateData from the view being closed
28060>>>>>>>            Get GetNavigateData of hoTopView to NavigateData
28061>>>>>>>            // if we are not going back to the invoking view this means you are jumping back several 
28061>>>>>>>            // breadcrumb items. The navigate type is always undefined and it is up to the developer to
28061>>>>>>>            // decide what to do with the returned data in OnNavigateBack
28061>>>>>>>            If (Self <> hoInvokingView) Begin
28063>>>>>>>                Move nfUndefined to NavigateData.eNavigateType
28064>>>>>>>            End
28064>>>>>>>>
28064>>>>>>>            Send GetNavigateBackData to hoCallback Self (&NavigateData)
28065>>>>>>>        End
28065>>>>>>>>
28065>>>>>>>        
28065>>>>>>>        // if we are the invoking object, both the top object and invoking are synched and we can proceed directly
28065>>>>>>>        // or if we are performing a cancel the extra round trip would have no real meaning
28065>>>>>>>        If (bCancel or Self = hoInvokingView) Begin
28067>>>>>>>            Send NavigateBackToHereExec (&NavigateData) bCancel hoCallback
28068>>>>>>>        End
28068>>>>>>>>
28068>>>>>>>        Else Begin
28069>>>>>>>            //  Navigating back multiple levels means that we need another round trip as the view we are navigating towards is nto synchronized
28069>>>>>>>                        
28069>>>>>>>            Move bCancel to aParams[0]
28070>>>>>>>            
28070>>>>>>>            //  Because "" indicates the WebApp object we have an extra boolean indicating if there actually is a callback object
28070>>>>>>>            If (hoCallback > 0) Begin
28072>>>>>>>                Move True to aParams[1]
28073>>>>>>>                Get WebObjectName of hoCallback to aParams[2]
28074>>>>>>>            End
28074>>>>>>>>
28074>>>>>>>            Else Begin
28075>>>>>>>                Move False to aParams[1]
28076>>>>>>>                Move "" to aParams[2]
28077>>>>>>>            End
28077>>>>>>>>
28077>>>>>>>            
28077>>>>>>>            ValueTreeSerializeParameter NavigateData to tVT
28078>>>>>>>            
28078>>>>>>>            //  Perform client action that will call NavigateBackToHere_Callback
28078>>>>>>>            Send ClientAction "navigateBackToHere" aParams tVT
28079>>>>>>>        End
28079>>>>>>>>
28079>>>>>>>        
28079>>>>>>>    End_Procedure
28080>>>>>>>
28080>>>>>>>    //  Actually performs the navigateBackToHere operation, either called directly or asynchronously
28080>>>>>>>    //  by NavigateBackToHere_Callback.
28080>>>>>>>    Procedure NavigateBackToHereExec tWebNavigateData ByRef NavigateData Boolean bCancel Handle hoCallback
28082>>>>>>>        Handle hoTopView 
28082>>>>>>>        Handle hoDD hoMainDD hoTarget hoInvokingObject hoInvokingObjectDD hoInvokingView hoNextView
28082>>>>>>>        String psInvoker sTitle sStateHash
28082>>>>>>>        Integer eViewType eTopViewStyle eViewStyle
28082>>>>>>>        RowID ri
28082>>>>>>>        Boolean bParentLookup bOverrideViewState
28082>>>>>>>        Integer iConstrainingFile eRefindError
28082>>>>>>>        Handle hoConstrainingParent hoRefindError
28082>>>>>>>        RowID riConstrainingParent
28082>>>>>>>        Boolean bSuccess
28082>>>>>>>        
28082>>>>>>>        //  Indicate that we are navigating
28082>>>>>>>        Set pbNavigating to True
28083>>>>>>>        
28083>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
28084>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
28085>>>>>>>        
28085>>>>>>>        If (hoTopView = Self) Begin
28087>>>>>>>            Error DFERR_PROGRAM "NavigateBackToHere is already the top of the stack"
28088>>>>>>>>
28088>>>>>>>        End
28088>>>>>>>>
28088>>>>>>>        
28088>>>>>>>        Get NextViewHandleByView of (ViewStack(Self)) Self to hoNextView
28089>>>>>>>        Get GetInvokingObject of hoNextView to hoInvokingObject 
28090>>>>>>>        
28090>>>>>>>        Get peWebViewStyle to eViewStyle
28091>>>>>>>        Get peWebViewStyle of hoTopView to eTopViewStyle       
28092>>>>>>>        
28092>>>>>>>        // send ShowView directly (this shows the view without clearing the 
28092>>>>>>>        // entire viewstack)
28092>>>>>>>        Get pbOverrideStateOnShow to bOverrideViewState
28093>>>>>>>        Set pbOverrideStateOnShow to False
28094>>>>>>>        // if we navigate from a regular drill down view to a dialog we need to perform some more logic
28094>>>>>>>        If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
28096>>>>>>>            Send RestoreDialog
28097>>>>>>>        End
28097>>>>>>>>
28097>>>>>>>        Else Begin
28098>>>>>>>            Send ShowView to (Host(Self)) Self 
28099>>>>>>>        End
28099>>>>>>>>
28099>>>>>>>        
28099>>>>>>>        Set pbOverrideStateOnShow to bOverrideViewState
28100>>>>>>>        // pop all unwanted views off the stack...
28100>>>>>>>        Send PopDownToView of (ViewStack(Self)) Self
28101>>>>>>>        Send UpdateInvokingViewDrillDownStyle
28102>>>>>>>
28102>>>>>>>        
28102>>>>>>>        // In this case we need to consider what to do with the data that
28102>>>>>>>        // is passed back from the previous top view.
28102>>>>>>>        Get peViewType to eViewType
28103>>>>>>>        Get Main_DD to hoMainDD  
28104>>>>>>>        
28104>>>>>>>        If hoMainDD Begin
28106>>>>>>>            Send Refind_Records of hoMainDD
28107>>>>>>>        End
28107>>>>>>>>
28107>>>>>>>
28107>>>>>>>        // if a close / update 
28107>>>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
28109>>>>>>>
28109>>>>>>>            // if navigate from was relational (child, parent or main) we can do refinding
28109>>>>>>>            If (NavigateData.eNavigateType = nfFromChild or NavigateData.eNavigateType = nfFromMain or NavigateData.eNavigateType = nfFromParent) Begin
28111>>>>>>>                Get FindDDOForTable NavigateData.iTable to hoDD
28112>>>>>>>                If hoDD Begin
28114>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28115>>>>>>>                    
28115>>>>>>>                    If (eViewType = vtZoom) Begin
28117>>>>>>>                        // This will force constrained parents to update if appropriate
28117>>>>>>>                        
28117>>>>>>>                        // Use the DD of the invoking object as our starting point 
28117>>>>>>>                        If hoInvokingObject Begin
28119>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28120>>>>>>>                        End
28120>>>>>>>>
28120>>>>>>>                        // if no server (unlikely) use the view's main dd 
28120>>>>>>>                        If not (hoInvokingObjectDD) Begin
28122>>>>>>>                            Get Main_DD to hoInvokingObjectDD        
28123>>>>>>>                        End
28123>>>>>>>>
28123>>>>>>>                        If (hoInvokingObjectDD) Begin
28125>>>>>>>                            // assume a parent DD is a parent lookup. If so, we don't update
28125>>>>>>>                            // the rest of the view. If not a lookup, do a clear_all so the
28125>>>>>>>                            // findbyrowid updates all deos 
28125>>>>>>>                            // which_data_Set only searches up.
28125>>>>>>>                            Get Which_Data_Set of hoInvokingObjectDD NavigateData.iTable to hoTarget
28126>>>>>>>                            Move (hoTarget and hoTarget<>hoInvokingObjectDD) to bParentLookup
28127>>>>>>>                            If not bParentLookup Begin
28129>>>>>>>                                // if constrained we will need to constraining parent
28129>>>>>>>                                // DD and row in case this is a null child RowId
28129>>>>>>>                                Get Constrain_File of hoDD to iConstrainingFile
28130>>>>>>>                                If (iConstrainingFile) Begin
28132>>>>>>>                                    Get Which_Data_Set of hoDD iConstrainingFile to hoConstrainingParent
28133>>>>>>>                                    If hoConstrainingParent Begin
28135>>>>>>>                                        Get CurrentRowId of hoConstrainingParent to riConstrainingParent
28136>>>>>>>                                    End
28136>>>>>>>>
28136>>>>>>>                                End
28136>>>>>>>>
28136>>>>>>>                                Send Clear_All of hoDD
28137>>>>>>>                                If (IsNullRowID(ri) and hoConstrainingParent) Begin
28139>>>>>>>                                    Get FindByRowIdEx of hoConstrainingParent iConstrainingFile riConstrainingParent to bSuccess
28140>>>>>>>                                    If not bSuccess Begin
28142>>>>>>>                                        // this is quite unlikely
28142>>>>>>>                                        // This is kind of complex because it means that the constraining parent cannot be
28142>>>>>>>                                        // reloaded. In such a case you probably should not be in the view at all and
28142>>>>>>>                                        // should navigate back
28142>>>>>>>                                        Move hoDD to hoRefindError
28143>>>>>>>                                        Move retCannotRereadConstrainingParent to eRefindError
28144>>>>>>>                                    End
28144>>>>>>>>
28144>>>>>>>                                End
28144>>>>>>>>
28144>>>>>>>                            End
28144>>>>>>>>
28144>>>>>>>                        End
28144>>>>>>>>
28144>>>>>>>                        If (hoRefindError=0) Begin
28146>>>>>>>                            If (IsNullRowID(ri)) Begin
28148>>>>>>>                                // Assume Create New Record
28148>>>>>>>                                Send Clear to hoDD
28149>>>>>>>                            End
28149>>>>>>>>
28149>>>>>>>                            Else Begin
28150>>>>>>>                                // Load up the selected rowID
28150>>>>>>>                                Get FindByRowIdEx of hoDD NavigateData.iTable ri to bSuccess
28151>>>>>>>                                If not bSuccess Begin
28153>>>>>>>                                    // this is quite unlikely
28153>>>>>>>                                    Send Clear of hoDD // this will leave the zoom cleared
28154>>>>>>>                                    Move hoDD to hoRefindError
28155>>>>>>>                                    Move retCannotRereadMain to eRefindError
28156>>>>>>>                                End
28156>>>>>>>>
28156>>>>>>>                            End
28156>>>>>>>>
28156>>>>>>>                        End
28156>>>>>>>>
28156>>>>>>>                    End
28156>>>>>>>>
28156>>>>>>>                    // else... if vtSelect the test below will catch this for any non cancel
28156>>>>>>>                    //         vtSelect. That way we catch hoDD=0 cases and nfundefined.
28156>>>>>>>                End
28156>>>>>>>>
28156>>>>>>>            End
28156>>>>>>>>
28156>>>>>>>
28156>>>>>>>            // This handles all select and weblist closes.        
28156>>>>>>>            // We do this for all view types because a zoom might contain a list
28156>>>>>>>            // If there is a missing hoDD or ri is null it will do a refresh of whatever
28156>>>>>>>            // is in the DD. If there is a rowid, it will refind around that.
28156>>>>>>>            Broadcast Recursive Send RefreshListForBackNavigation bCancel hoDD ri
28158>>>>>>>            
28158>>>>>>>        End
28158>>>>>>>>
28158>>>>>>>        // cancel
28158>>>>>>>        Else Begin
28159>>>>>>>            
28159>>>>>>>            // case of a cancel going back one level
28159>>>>>>>            If (Self = hoInvokingView) Begin
28161>>>>>>>                // This handles all select and weblist cancels.        
28161>>>>>>>                // We do this for all view types because a zoom might contain a list
28161>>>>>>>                Broadcast Recursive Send RefreshListForBackNavigation bCancel 0 (NullRowID())
28163>>>>>>>            End
28163>>>>>>>>
28163>>>>>>>            // if going back multiple levels, we don't do an update on the list because the list is not in scope. 
28163>>>>>>>            // Currently we are choosing not to  incur the overhead of extra roundtrip for a multi-level cancel.
28163>>>>>>>        End
28163>>>>>>>>
28163>>>>>>>            
28163>>>>>>>        
28163>>>>>>>        If hoInvokingObject Begin
28165>>>>>>>            Send ConditionalFocus of hoInvokingObject
28166>>>>>>>        End            
28166>>>>>>>>
28166>>>>>>>
28166>>>>>>>        //  Update the URL      
28166>>>>>>>        Send UpdateStateHash False
28167>>>>>>>        Send UpdatePageTitle
28168>>>>>>>        
28168>>>>>>>        //  We are done navigating now
28168>>>>>>>        Set pbNavigating to False
28169>>>>>>>
28169>>>>>>>        If (hoRefindError) Begin
28171>>>>>>>            // last thing that happens, you can do whatever
28171>>>>>>>            Send OnNavigateBackRefindError hoConstrainingParent eRefindError
28172>>>>>>>        End
28172>>>>>>>>
28172>>>>>>>        Else If (not(bCancel)) Begin
28175>>>>>>>        
28175>>>>>>>            // this is the object within the invoking view that called this
28175>>>>>>>            If (hoInvokingObject and hoCallback) Begin
28177>>>>>>>                // We are now the focus. You can use this to customize the update
28177>>>>>>>                // of to do another navigation 
28177>>>>>>>                Send OnNavigateBack of hoInvokingObject hoCallback NavigateData
28178>>>>>>>            End
28178>>>>>>>>
28178>>>>>>>        End
28178>>>>>>>>
28178>>>>>>>    End_Procedure
28179>>>>>>>    
28179>>>>>>>    //  Published procedure called by the client when it gets the navigateToClient client-action. 
28179>>>>>>>    //  This is done when navigating back multiple levels and the view we are navigating too was 
28179>>>>>>>    //  not synchronized. When this procedure is called the current view and the top view are both
28179>>>>>>>    //  being synchronized.
28179>>>>>>>    Procedure NavigateBackToHere_Callback Boolean bCancel Boolean bCallback String sCallback
28181>>>>>>>        tWebValueTree VT
28181>>>>>>>        tWebValueTree VT
28181>>>>>>>        tWebNavigateData NavigateData
28181>>>>>>>        tWebNavigateData NavigateData
28181>>>>>>>        Handle hoCallback
28181>>>>>>>        
28181>>>>>>>        Get ptActionData to VT
28182>>>>>>>        ValueTreeDeserializeParameter VT to NavigateData
28183>>>>>>>        
28183>>>>>>>        If (bCallback) Begin
28185>>>>>>>            Get WebObjectByName sCallback to hoCallback
28186>>>>>>>        End
28186>>>>>>>>
28186>>>>>>>        
28186>>>>>>>        Send NavigateBackToHereExec NavigateData bCancel hoCallback
28187>>>>>>>        
28187>>>>>>>    End_Procedure
28188>>>>>>>    
28188>>>>>>>    // determine the navigateFrom type based on the view being activated (self) and the
28188>>>>>>>    // invoking view and object (passed)
28188>>>>>>>    Function DetermineNavigateFromType Handle hoInvokingView Handle hoInvokingObject Handle ByRef iNavigateFile Returns Integer
28190>>>>>>>        Handle hoInvokingDD hoMainDD hoDDO
28190>>>>>>>        Integer iInvokingFile iMainFile
28190>>>>>>>        Integer iServers iServer iServerFile
28190>>>>>>>        Boolean bDataBindable
28190>>>>>>>        Move 0 to iNavigateFile
28191>>>>>>>        
28191>>>>>>>        If (hoInvokingView) Begin
28193>>>>>>>            
28193>>>>>>>            If (hoInvokingObject) Begin
28195>>>>>>>                Get Server of hoInvokingObject to hoInvokingDD
28196>>>>>>>            End
28196>>>>>>>>
28196>>>>>>>            Else Begin
28197>>>>>>>                Get Server of hoInvokingView to hoInvokingDD
28198>>>>>>>            End
28198>>>>>>>>
28198>>>>>>>            
28198>>>>>>>            Get Server to hoMainDD
28199>>>>>>>            
28199>>>>>>>            If (hoInvokingDD and hoMainDD) Begin
28201>>>>>>>                Get Main_File of hoInvokingDD to iInvokingFile
28202>>>>>>>                Get Main_File of hoMainDD to iMainFile
28203>>>>>>>                
28203>>>>>>>                If (iInvokingFile = iMainFile) Begin
28205>>>>>>>                    Move iMainFile to iNavigateFile
28206>>>>>>>                    Function_Return nfFromMain
28207>>>>>>>                End
28207>>>>>>>>
28207>>>>>>>                Else If ( Which_Data_Set(hoInvokingDD, iMainFile)) Begin
28210>>>>>>>                    Move iMainFile to iNavigateFile
28211>>>>>>>                    Function_Return nfFromChild
28212>>>>>>>                End
28212>>>>>>>>
28212>>>>>>>                Else Begin
28213>>>>>>>                    Get Data_Set_Server_Count of hoMainDD to iServers
28214>>>>>>>                    For iServer from 0 to (iServers-1)
28220>>>>>>>>
28220>>>>>>>                        Get Data_Set_Server of hoMainDD iServer to hoDDO
28221>>>>>>>                        Get Main_File of hoDDO to iServerFile
28222>>>>>>>                        If (iInvokingFile = iServerFile) Begin
28224>>>>>>>                            Move iInvokingFile to iNavigateFile
28225>>>>>>>                            Function_Return nfFromParent
28226>>>>>>>                        End
28226>>>>>>>>
28226>>>>>>>                    Loop
28227>>>>>>>>
28227>>>>>>>                End
28227>>>>>>>>
28227>>>>>>>            End
28227>>>>>>>>
28227>>>>>>>        End
28227>>>>>>>>
28227>>>>>>>        Function_Return nfUndefined
28228>>>>>>>    End_Function
28229>>>>>>>    
28229>>>>>>>    // Send this to navigate to the target view and add it to the view stack.
28229>>>>>>>    //
28229>>>>>>>    // eNavigateType - The Navigate From Type (i.e. nfFromMain, nfFromParent, etc)
28229>>>>>>>    // hoInvokingObject - This is the control in the "from view" that will populate the Navigate Data.
28229>>>>>>>    //                    The navigate data describes the role this view will play. Typically you will
28229>>>>>>>    //                    pass the object handle of the control that called NavigateForward.
28229>>>>>>>    //                    This control must understand the GetNavigateForwardData callback message.
28229>>>>>>>    Procedure NavigateForward Handle hoInvokingObject
28231>>>>>>>        Handle hoInvokingView hoTestInvokingObject
28231>>>>>>>        tWebNavigateData NavigateData
28231>>>>>>>        tWebNavigateData NavigateData
28231>>>>>>>        Integer iExpectedTable eNavigateType// eAppStateMode eTestNavType iTestTable
28231>>>>>>>        
28231>>>>>>>        // temporary for conversion. This will raise an error for older style NavigateFoward
28231>>>>>>>        // which passed two arguments. 
28231>>>>>>>        If (num_arguments<>1) Begin
28233>>>>>>>            Error DFERR_PROGRAM "NavigateForward has wrong number of parameters. Probably old style call"
28234>>>>>>>>
28234>>>>>>>            Procedure_Return
28235>>>>>>>        End
28235>>>>>>>>
28235>>>>>>>        
28235>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28236>>>>>>>        
28236>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForward
28237>>>>>>>    End_Procedure
28238>>>>>>>
28238>>>>>>>    // Just like NavigateForward but it always makes this an nfUndefined navigation. This provides a way
28238>>>>>>>    // for developers to perform a custom forward navigation (nfUndefined) when the natural navigation would be
28238>>>>>>>    // some other navigation. When doing a custom navigation, the only option is nfUndefined because allowing a 
28238>>>>>>>    // developer to assign any other navigate-from type when it is not what is expected will probably not work.
28238>>>>>>>    // Note that the NavigateData data can be further customized in OnGetNavigateForwardData
28238>>>>>>>    // this is for advanced use - normally NavigateForward is used.
28238>>>>>>>    Procedure NavigateForwardCustom Handle hoInvokingObject
28240>>>>>>>        tWebNavigateData NavigateData
28240>>>>>>>        tWebNavigateData NavigateData
28240>>>>>>>        
28240>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
28241>>>>>>>        
28241>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForwardCustom
28242>>>>>>>    End_Procedure
28243>>>>>>>    
28243>>>>>>>    
28243>>>>>>>    // Navigates into this view when restoring a state. This means that most likely the view will 
28243>>>>>>>    // not be shown but is just initialzed to correct the view stack. The view will be loaded to 
28243>>>>>>>    // the client asynchronously to optimize performance.
28243>>>>>>>    //
28243>>>>>>>    // Params:
28243>>>>>>>    //      bTopView    If true this is the topmost view that will be displayed.
28243>>>>>>>    //      sMainId     Record ID of the main DD (from the state hash).
28243>>>>>>>    //      sStateHash  The full state hash for this view.
28243>>>>>>>    // Returns:
28243>>>>>>>    //      False if the main ID is not a valid record.
28243>>>>>>>    Function NavigateInitialize Handle hoInvokingObject Boolean bTopView String sStateHash Integer eNavMode Returns Boolean
28245>>>>>>>        tWebNavigateData NavigateData
28245>>>>>>>        tWebNavigateData NavigateData
28245>>>>>>>        Handle hoInvokingView hoMainDD
28245>>>>>>>        RowID rRowId
28245>>>>>>>        Boolean bFound bSuccess bIsDynamic
28245>>>>>>>        
28245>>>>>>>        
28245>>>>>>>        // Add extra properties used during initialization
28245>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" (If(bTopView, initStateReinitializeTopView, initStateReinitialize)) to NavigateData.NamedValues
28246>>>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_StateHash" sStateHash to NavigateData.NamedValues
28247>>>>>>>        
28247>>>>>>>        // Get into the standard initialization
28247>>>>>>>        Set pbNavReinitError to False
28248>>>>>>>        Send NavigateForward2 hoInvokingObject NavigateData eNavMode
28249>>>>>>>        Get pbNavReinitError to bSuccess
28250>>>>>>>        Move (not(bSuccess)) to bSuccess
28251>>>>>>>        
28251>>>>>>>        Function_Return bSuccess
28252>>>>>>>    End_Function
28253>>>>>>>    
28253>>>>>>>    // Reads the record id from the statehash and puts it in the NavigateData struct, this is called during 
28253>>>>>>>    // the forward navigation (only for NavigateInitialize).
28253>>>>>>>    //
28253>>>>>>>    // Params:
28253>>>>>>>    //      NavigateData    Byreference navigationdata struct (so it can be altered).
28253>>>>>>>    Procedure NavigateInitializeUpdateRowId tWebNavigateData ByRef NavigateData
28255>>>>>>>        String sHash sMainId sView sCustom
28255>>>>>>>        Integer eStateMode iTable
28255>>>>>>>        Handle hoMainDD
28255>>>>>>>        RowID rRowID
28255>>>>>>>        Boolean bSuccess
28255>>>>>>>        
28255>>>>>>>        Get peStateMode to eStateMode
28256>>>>>>>        Get Main_DD to hoMainDD
28257>>>>>>>        
28257>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_StateHash" to sHash
28258>>>>>>>        Send ParseViewStateHash of (Host(Self)) sHash (&sView) (&sMainId) (&sCustom)
28259>>>>>>>        
28259>>>>>>>        // Set rowid from the state hash
28259>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28261>>>>>>>            If (hoMainDD <> 0) Begin
28263>>>>>>>                Move (Main_File(hoMainDD)) to iTable
28264>>>>>>>                Get HashRecordIdToRowId iTable sMainId (&rRowId) to bSuccess
28265>>>>>>>                If (bSuccess) Begin
28267>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28268>>>>>>>                    Move iTable to  NavigateData.iTable
28269>>>>>>>                    Move False to NavigateData.bNewRecord
28270>>>>>>>                End
28270>>>>>>>>
28270>>>>>>>                Else Begin
28271>>>>>>>                    Set pbNavReinitError to True
28272>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28274>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28275>>>>>>>>
28275>>>>>>>                    End
28275>>>>>>>>
28275>>>>>>>                End
28275>>>>>>>>
28275>>>>>>>            End
28275>>>>>>>>
28275>>>>>>>        End
28275>>>>>>>>
28275>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28278>>>>>>>            If (NavigateData.iTable > 0) Begin
28280>>>>>>>                Get HashRecordIdToRowId NavigateData.iTable sMainId (&rRowId) to bSuccess
28281>>>>>>>                If (bSuccess) Begin
28283>>>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
28284>>>>>>>                End
28284>>>>>>>>
28284>>>>>>>                Else Begin
28285>>>>>>>                    Set pbNavReinitError to True
28286>>>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
28288>>>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
28289>>>>>>>>
28289>>>>>>>                    End
28289>>>>>>>>
28289>>>>>>>                End
28289>>>>>>>>
28289>>>>>>>            End
28289>>>>>>>>
28289>>>>>>>        End
28289>>>>>>>>
28289>>>>>>>    End_Procedure
28290>>>>>>>    
28290>>>>>>>    // Determines if this view needs to be reininitialized when restoring the state looking at the
28290>>>>>>>    // record id.
28290>>>>>>>    //
28290>>>>>>>    // Params:
28290>>>>>>>    //      sExpectedMainId     Record ID of the main table navigation table to compare to record buffer.
28290>>>>>>>    Function NeedReinitialize String sExpectedMainId Returns Boolean
28292>>>>>>>        tWebNavigateData navData
28292>>>>>>>        tWebNavigateData navData
28292>>>>>>>        Integer eStateMode
28292>>>>>>>        Handle hoMainDD
28292>>>>>>>        RowID rRowId
28292>>>>>>>        Boolean bValid
28292>>>>>>>        
28292>>>>>>>        Get peStateMode to eStateMode
28293>>>>>>>        Get Main_DD to hoMainDD
28294>>>>>>>        
28294>>>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
28296>>>>>>>            Get GetNavigateData to navData
28297>>>>>>>            
28297>>>>>>>            If (hoMainDD <> 0) Begin
28299>>>>>>>                If (sExpectedMainId <> "" ) Begin    
28301>>>>>>>                    Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28302>>>>>>>                    If (bValid and IsSameRowID(rRowId, CurrentRowId(hoMainDD))) Begin
28304>>>>>>>                        Function_Return False
28305>>>>>>>                    End
28305>>>>>>>>
28305>>>>>>>                End
28305>>>>>>>>
28305>>>>>>>                Else If (navData.bNewRecord and not(HasRecord(hoMainDD))) Begin
28308>>>>>>>                    Function_Return False
28309>>>>>>>                End
28309>>>>>>>>
28309>>>>>>>            End
28309>>>>>>>>
28309>>>>>>>            Else Begin
28310>>>>>>>                Function_Return False
28311>>>>>>>            End
28311>>>>>>>>
28311>>>>>>>        End
28311>>>>>>>>
28311>>>>>>>        Else If (eStateMode = vsmDefault) Begin
28314>>>>>>>            Get GetNavigateData to navData
28315>>>>>>>            
28315>>>>>>>            If (navData.iTable > 0) Begin
28317>>>>>>>                Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
28318>>>>>>>                If (bValid and navData.sRowID = SerializeRowID(rRowId)) Begin
28320>>>>>>>                    Function_Return False
28321>>>>>>>                End
28321>>>>>>>>
28321>>>>>>>            End
28321>>>>>>>>
28321>>>>>>>            
28321>>>>>>>            If (navData.eNavigateType = nfUndefined) Begin
28323>>>>>>>                Function_Return False
28324>>>>>>>            End
28324>>>>>>>>
28324>>>>>>>        End
28324>>>>>>>>
28324>>>>>>>        
28324>>>>>>>        Function_Return True
28325>>>>>>>    End_Function
28326>>>>>>>
28326>>>>>>>    // Called back by the LoadViewCallBack procedure that makes sure that the view is actually in 
28326>>>>>>>    // sync (by going back to the client and optionally loading it).
28326>>>>>>>    Procedure NavigateForward_CallBack
28328>>>>>>>        Send NavigateForwardFinish
28329>>>>>>>    End_Procedure
28330>>>>>>>
28330>>>>>>>    // called by NavigateForward and NavigateForwardCustom only 
28330>>>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
28332>>>>>>>        Integer eWebViewStyle eInvokingViewStyle eInitMode iMainFile iStackSize
28332>>>>>>>        Handle hoInvokingObjectTemp hoInvokingView hoMainDD hoInvokingViewDD 
28332>>>>>>>        Boolean bOK bChanged bErr bHasRecord bCancel bHandled
28332>>>>>>>        String sInvokingView sReason sViewName
28332>>>>>>>        tWebViewInfo[] aViewStack
28332>>>>>>>        tWebViewInfo[] aViewStack
28333>>>>>>>        RowID riMainRowId
28333>>>>>>>        
28333>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28334>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28335>>>>>>>        Get Main_DD to hoMainDD
28336>>>>>>>                
28336>>>>>>>        // Test Access rights...
28336>>>>>>>        Get AllowAccess to bOK
28337>>>>>>>        If (not(bOK)) Begin
28339>>>>>>>            Get ViewAccessDenied Self False to bHandled
28340>>>>>>>            Procedure_Return
28341>>>>>>>        End
28341>>>>>>>>
28341>>>>>>>        
28341>>>>>>>        // Test for valid view style
28341>>>>>>>        Get peWebViewStyle to eWebViewStyle
28342>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28344>>>>>>>            Error DFERR_PROGRAM "Can't navigate forward to a non-drill down view"
28345>>>>>>>>
28345>>>>>>>            Procedure_Return
28346>>>>>>>        End
28346>>>>>>>>
28346>>>>>>>
28346>>>>>>>        // Test that we can actually navigate to this view
28346>>>>>>>        Get CanPushView of (ViewStack(Self)) Self (&sReason) to bOK
28347>>>>>>>        
28347>>>>>>>        If (not(bOK)) Begin
28349>>>>>>>            Get WebObjectName to sViewName
28350>>>>>>>            Error DFERR_PROGRAM ("View stack navigate error: Cannot Navigate to (" + sViewName + "). " + sReason)
28351>>>>>>>>
28351>>>>>>>            Procedure_Return             
28352>>>>>>>        End
28352>>>>>>>>
28352>>>>>>>
28352>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28353>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28354>>>>>>>        
28354>>>>>>>        // Populate the Navigate Data struct.
28354>>>>>>>        If (eNavMode = ntNavigateForwardCustom) Begin
28356>>>>>>>            Move nfUndefined to NavigateData.eNavigateType
28357>>>>>>>        End
28357>>>>>>>>
28357>>>>>>>        Else Begin      
28358>>>>>>>            //  Determine navigation type and table
28358>>>>>>>            Get DetermineNavigateFromType hoInvokingView hoInvokingObject (&NavigateData.iTable) to NavigateData.eNavigateType
28359>>>>>>>        End 
28359>>>>>>>>
28359>>>>>>>        
28359>>>>>>>        //  Determine rowid and fire OnGetNavigateForwardData
28359>>>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
28361>>>>>>>            Send GetNavigateForwardData of hoInvokingObject Self (&NavigateData)
28362>>>>>>>        End
28362>>>>>>>>
28362>>>>>>>        
28362>>>>>>>        //  Override rowid when initializing from a state hash
28362>>>>>>>        If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28364>>>>>>>            Send NavigateInitializeUpdateRowId (&NavigateData)
28365>>>>>>>            If (pbNavReinitError(Self)) ;                Procedure_Return
28368>>>>>>>        End
28368>>>>>>>>
28368>>>>>>>        
28368>>>>>>>        //  Give a last change to intervene before actual changes will be made
28368>>>>>>>        Send SetNavigateData NavigateData   // Set the navigationdata so that Refresh reads the right init_mode
28369>>>>>>>        Move False to bCancel
28370>>>>>>>        Send OnNavigating (&NavigateData) hoInvokingView hoInvokingObject (&bCancel)
28371>>>>>>>        If (bCancel) Begin
28373>>>>>>>            Set pbNavReinitError to True
28374>>>>>>>            Procedure_Return
28375>>>>>>>        End
28375>>>>>>>>
28375>>>>>>>        
28375>>>>>>>        // update the top of the stack with what is now the current record which
28375>>>>>>>        // should have been returned in NavigateData
28375>>>>>>>        If (iStackSize and aViewStack[iStackSize-1].iMainTable = NavigateData.iTable) Begin 
28377>>>>>>>            Move (DeserializeRowID(NavigateData.sRowID)) to aViewStack[iStackSize-1].riMainTable
28378>>>>>>>            WebSet paViewStack of (ViewStack(Self)) to aViewStack
28379>>>>>>>        End
28379>>>>>>>>
28379>>>>>>>                
28379>>>>>>>        // Store the NavigateData
28379>>>>>>>        Send SetNavigateData NavigateData
28380>>>>>>>        Send SetInvokingObject hoInvokingObject
28381>>>>>>>        
28381>>>>>>>        // if we must first save, we require a successful save
28381>>>>>>>        // or an existing record with no changes
28381>>>>>>>        If (NavigateData.bSaveBeforeNavigate and eInitMode = initStateDefault) Begin
28383>>>>>>>            Get Server of hoInvokingView to hoInvokingViewDD
28384>>>>>>>            If (hoInvokingViewDD) Begin
28386>>>>>>>                Get HasRecord of hoInvokingViewDD to bHasRecord
28387>>>>>>>            End
28387>>>>>>>>
28387>>>>>>>            Get SaveViewBeforeNavigate of hoInvokingView to bErr
28388>>>>>>>            If bErr Begin
28390>>>>>>>                Set pbNavReinitError to True    //  This should never happen!
28391>>>>>>>                Procedure_Return
28392>>>>>>>            End
28392>>>>>>>>
28392>>>>>>>            // if a new successful save we must udpate navigateData and the
28392>>>>>>>            // top of the view stack with the new record
28392>>>>>>>            If (hoInvokingViewDD and not(bHasRecord)) Begin
28394>>>>>>>                Get Main_File of hoInvokingViewDD to iMainFile
28395>>>>>>>                If (NavigateData.iTable = iMainFile) Begin
28397>>>>>>>                    Get CurrentRowId of hoInvokingViewDD to riMainRowId
28398>>>>>>>                    Move (SerializeRowID(riMainRowId)) to NavigateData.sRowID
28399>>>>>>>                    Send SetNavigateData NavigateData
28400>>>>>>>                    
28400>>>>>>>                    If (iStackSize) Begin 
28402>>>>>>>                        Move riMainRowId to aViewStack[iStackSize-1].riMainTable
28403>>>>>>>                        WebSet paViewStack of (ViewStack(Self)) to aViewStack
28404>>>>>>>                    End
28404>>>>>>>>
28404>>>>>>>                End
28404>>>>>>>>
28404>>>>>>>            End
28404>>>>>>>>
28404>>>>>>>        End
28404>>>>>>>>
28404>>>>>>>        
28404>>>>>>>        //Check if we need to hide a dialog
28404>>>>>>>        If (hoInvokingView <> 0) Begin
28406>>>>>>>           Get peWebViewStyle of hoInvokingView to eInvokingViewStyle
28407>>>>>>>            If (eInvokingViewStyle = wvsDialog and eWebViewStyle <> wvsDialog) Begin
28409>>>>>>>                //If this happens we navigated from a dialog to a view which means we should hide all dialogs.
28409>>>>>>>                Send HideAllDialogs
28410>>>>>>>            End
28410>>>>>>>>
28410>>>>>>>        End
28410>>>>>>>>
28410>>>>>>>        
28410>>>>>>>        //  Finish navigation
28410>>>>>>>        If (eInitMode = initStateReinitialize) Begin
28412>>>>>>>            Send DelayLoadview of (Host(Self)) Self 
28413>>>>>>>            Send NavigateForwardFinish 
28414>>>>>>>        End
28414>>>>>>>>
28414>>>>>>>        Else Begin
28415>>>>>>>            Send ShowView of (Host(Self)) Self (RefProc(NavigateForward_CallBack)) Self
28416>>>>>>>        End
28416>>>>>>>>
28416>>>>>>>    End_Procedure
28417>>>>>>>    
28417>>>>>>>    // This message is sent when navigating into a view (forward navigation) and is the last chance
28417>>>>>>>    // to influence the navigation data before the navigation is performed. It also is the place to 
28417>>>>>>>    // cancel the navigation.
28417>>>>>>>    Procedure OnNavigating tWebNavigateData ByRef NavigateData Handle hoInvokingView Handle hoInvokingObject Boolean ByRef bCancel
28419>>>>>>>    End_Procedure
28420>>>>>>>    
28420>>>>>>>    // The last step of the forward navigation where the view navigating to is in sync and finds 
28420>>>>>>>    // and constraints are performed based on the NavigateDataFinish. This procedure does look at
28420>>>>>>>    // the DDO structure of the invoking view but that shouldn't be a problem.
28420>>>>>>>    Procedure NavigateForwardFinish
28422>>>>>>>        Integer iStackSize iParentTable eInitMode
28422>>>>>>>        Handle hoMainDD hoParentDD hoInvokingView hoInvokingObject hoTopView
28422>>>>>>>        Boolean bOK bHasRecord bPrevNav
28422>>>>>>>        RowID ri
28422>>>>>>>        tWebNavigateData NavigateData
28422>>>>>>>        tWebNavigateData NavigateData
28422>>>>>>>        tWebViewInfo[] aViewStack
28422>>>>>>>        tWebViewInfo[] aViewStack
28423>>>>>>>        Handle[] hoStackDDOs
28424>>>>>>>        RowID[] riStackRowIds
28425>>>>>>>        Boolean bDynamicConstraints bOverrideViewState bFindParent bErr bSuccess
28425>>>>>>>        Integer eWebViewStyle eViewType
28425>>>>>>>        Integer iMainFile iConstrainFile eRefindError
28425>>>>>>>        String sMainRowId sTitle sCustomStateHash
28425>>>>>>>        RowID riMainRowId
28425>>>>>>>        Handle hoInvokingViewDD hoInvokingObjectDD hoRefindError
28425>>>>>>>        
28425>>>>>>>        //  Indicate that we are navigating
28425>>>>>>>        Set pbNavigating to True
28426>>>>>>>        
28426>>>>>>>        Get Main_DD to hoMainDD
28427>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
28428>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
28430>>>>>>>            Get GetInvokingObject to hoInvokingObject
28431>>>>>>>        End
28431>>>>>>>>
28431>>>>>>>        
28431>>>>>>>        Get GetNavigateData to NavigateData
28432>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
28433>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
28434>>>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
28435>>>>>>>
28435>>>>>>>        
28435>>>>>>>        Get peViewType to eViewType
28436>>>>>>>        Get IsDynamicConstraints to bDynamicConstraints
28437>>>>>>>        
28437>>>>>>>        // Interpret the navigate data 
28437>>>>>>>        
28437>>>>>>>        If hoMainDD Begin
28439>>>>>>>            
28439>>>>>>>            Send Refind_Records of hoMainDD
28440>>>>>>>            
28440>>>>>>>            
28440>>>>>>>            //  We are performing finds on the invoking views here to 'correct' their current records based on our navigate-data
28440>>>>>>>            If (hoInvokingObject <> C_WebUnresolvedObject and eInitMode <> initStateDefault and NavigateData.iTable > 0) Begin
28442>>>>>>>                Handle hoInvokingServer hoInvokingDD
28442>>>>>>>                RowID riNavRowId
28442>>>>>>>                
28442>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer 
28443>>>>>>>                If (hoInvokingServer > 0 and IsInCallActionScope(hoInvokingObject)) Begin
28445>>>>>>>                    Get Data_Set of hoInvokingServer NavigateData.iTable to hoInvokingDD
28446>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to riNavRowId
28447>>>>>>>                    
28447>>>>>>>                    If (hoinvokingdd > 0 and not(IsSameRowId(CurrentRowId(hoInvokingDD), riNavRowId))) Begin
28449>>>>>>>                        Get pbNavigating of hoInvokingView to bPrevNav
28450>>>>>>>                        Set pbNavigating of hoInvokingView to True
28451>>>>>>>                        If (IsNullRowID(riNavRowId)) Begin
28453>>>>>>>                            Send Clear of hoInvokingDD
28454>>>>>>>                        End
28454>>>>>>>>
28454>>>>>>>                        Else Begin
28455>>>>>>>                            Send FindByRowId of hoInvokingDD NavigateData.iTable riNavRowId
28456>>>>>>>                        End
28456>>>>>>>>
28456>>>>>>>                        Set pbNavigating of hoInvokingView to bPrevNav
28457>>>>>>>                    End
28457>>>>>>>>
28457>>>>>>>                End
28457>>>>>>>>
28457>>>>>>>            End
28457>>>>>>>>
28457>>>>>>>            
28457>>>>>>>            If (bDynamicConstraints) Begin
28459>>>>>>>                // this re-establishes all existing constraints
28459>>>>>>>                Send EstablishConstrainFiles hoMainDD aViewStack (&hoStackDDOs) (&riStackRowIds)    
28460>>>>>>>                
28460>>>>>>>                // Now Set hew highest level constrain_file if needed.
28460>>>>>>>                Move False to bFindParent
28461>>>>>>>                // if fromParent we need a constraint
28461>>>>>>>                If (NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28463>>>>>>>                    Move aViewStack[iStackSize-1].iMainTable to iParentTable
28464>>>>>>>                    // must be an immediate parent of the main DDO or this is an error          
28464>>>>>>>                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28465>>>>>>>                    If (hoParentDD = 0) Begin
28467>>>>>>>                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28468>>>>>>>>
28468>>>>>>>                    End
28468>>>>>>>>
28468>>>>>>>                    
28468>>>>>>>                    Set Constrain_File of hoMainDD to iParentTable
28469>>>>>>>                    
28469>>>>>>>                    // find the constraining parent record and its parents
28469>>>>>>>                    Move True to bFindParent
28470>>>>>>>                    Move aViewStack[iStackSize-1].riMainTable to ri
28471>>>>>>>                End
28471>>>>>>>>
28471>>>>>>>                // if fromMain and the parent view is fromParent or a manual constraint
28471>>>>>>>                // we need a constraint added here
28471>>>>>>>                Else If (NavigateData.eNavigateType = nfFromMain) Begin
28474>>>>>>>
28474>>>>>>>                    If (hoInvokingObject) Begin
28476>>>>>>>                        Boolean bIsDynamic bIsDynamicBase
28476>>>>>>>                        Handle hoWidgetObj hoWidgetObjDD
28476>>>>>>>                        
28476>>>>>>>                        If (hoWidgetObj <> 0) Begin
28478>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28479>>>>>>>                            Get Server of hoWidgetObj to hoWidgetObjDD
28480>>>>>>>                            
28480>>>>>>>                            If (hoInvokingObjectDD and hoWidgetObjDD<>hoInvokingObjectDD) Begin
28482>>>>>>>                            
28482>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28483>>>>>>>                                If (hoWidgetObjDD > 0) Begin
28485>>>>>>>                                    Get Main_File of hoWidgetObjDD to iParentTable
28486>>>>>>>                                End
28486>>>>>>>>
28486>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28486>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28486>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28488>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28488>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28489>>>>>>>                                    If (hoParentDD = 0) Begin
28491>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28492>>>>>>>>
28492>>>>>>>                                    End
28492>>>>>>>>
28492>>>>>>>                                    
28492>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28493>>>>>>>                                    
28493>>>>>>>                                    // find the constraining parent record and its parents
28493>>>>>>>                                    Move True to bFindParent
28494>>>>>>>                                    // this is the parent record to refind
28494>>>>>>>                                    Get CurrentRowId of hoWidgetObjDD to ri
28495>>>>>>>                                End
28495>>>>>>>>
28495>>>>>>>                                Else If (hoWidgetObjDD > 0) Begin
28498>>>>>>>                                    // this is a navigate from we don't allow.
28498>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28499>>>>>>>>
28499>>>>>>>                                End
28499>>>>>>>>
28499>>>>>>>                            End
28499>>>>>>>>
28499>>>>>>>                            Else Begin
28500>>>>>>>                                Send Refind_Records of hoInvokingObjectDD
28501>>>>>>>                                Get CurrentRowId of hoInvokingObjectDD to ri
28502>>>>>>>                                Move (SerializeRowID(ri)) to NavigateData.sRowID
28503>>>>>>>                            End
28503>>>>>>>>
28503>>>>>>>                        End
28503>>>>>>>>
28503>>>>>>>                        Else Begin
28504>>>>>>>                            
28504>>>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
28505>>>>>>>                            Get Server of hoInvokingView to hoInvokingViewDD
28506>>>>>>>                            // special fromMain case where the DDO is not the view's main_dd but is
28506>>>>>>>                            // a child DD that has a constraint. If so we only support this one level
28506>>>>>>>                            // deep and the DD must be constrained to the invoking view's main DD.
28506>>>>>>>                            // for example, mavigating from ZoomOrder's detail grid tp a detail zoom
28506>>>>>>>                            If (hoInvokingObjectDD and hoInvokingViewDD<>hoInvokingObjectDD) Begin
28508>>>>>>>                            
28508>>>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
28509>>>>>>>                                If (hoInvokingViewDD > 0) Begin
28511>>>>>>>                                    Get Main_File of hoInvokingViewDD to iParentTable
28512>>>>>>>                                End
28512>>>>>>>>
28512>>>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
28512>>>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
28512>>>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
28514>>>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
28514>>>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28515>>>>>>>                                    If (hoParentDD = 0) Begin
28517>>>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28518>>>>>>>>
28518>>>>>>>                                    End
28518>>>>>>>>
28518>>>>>>>                                    
28518>>>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
28519>>>>>>>                                    
28519>>>>>>>                                    // find the constraining parent record and its parents
28519>>>>>>>                                    Move True to bFindParent
28520>>>>>>>                                    // this is the parent record to refind
28520>>>>>>>                                    Get CurrentRowId of hoInvokingViewDD to ri
28521>>>>>>>                                End
28521>>>>>>>>
28521>>>>>>>                                Else If (hoInvokingViewDD > 0) Begin
28524>>>>>>>                                    // this is a navigate from we don't allow.
28524>>>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
28525>>>>>>>>
28525>>>>>>>                                End
28525>>>>>>>>
28525>>>>>>>                            End
28525>>>>>>>>
28525>>>>>>>                            
28525>>>>>>>                        End
28525>>>>>>>>
28525>>>>>>>                    End
28525>>>>>>>>
28525>>>>>>>                    // this is a more typical fromMain where invoking view is constrained amd
28525>>>>>>>                    // we want to use that constraint. 
28525>>>>>>>                    If  (not(bFindParent) and aViewStack[iStackSize-1].eNavigateType=nfFromParent and iStackSize>1) Begin
28527>>>>>>>                        Move aViewStack[iStackSize-2].iMainTable to iParentTable
28528>>>>>>>                        // must be an immediate parent of the main DDO or this is an error          
28528>>>>>>>                        Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
28529>>>>>>>                        If (hoParentDD = 0) Begin
28531>>>>>>>                            Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
28532>>>>>>>>
28532>>>>>>>                        End
28532>>>>>>>>
28532>>>>>>>                        // note constrain_file should already be set
28532>>>>>>>                        Move True to bFindParent
28533>>>>>>>                        Move aViewStack[iStackSize-2].riMainTable to ri
28534>>>>>>>                    End
28534>>>>>>>>
28534>>>>>>>                End
28534>>>>>>>>
28534>>>>>>>                
28534>>>>>>>            End
28534>>>>>>>>
28534>>>>>>>    
28534>>>>>>>            // Used to set ordering for a List. Do it here so any grid fills will use the right index.
28534>>>>>>>            // Let's do this before any finds occur on the new view. This can be used to set up custom
28534>>>>>>>            // constraints
28534>>>>>>>            Send NavigateForwardPreFindInit NavigateData hoInvokingObject
28535>>>>>>>
28535>>>>>>>            // Now rebuild the constraints
28535>>>>>>>            Send RebuildAllConstraints of hoMainDD
28536>>>>>>>        
28536>>>>>>>            // Now refind the parent if needed.
28536>>>>>>>            // This will only happen with dynamic constraints but this makes our intention clear.
28536>>>>>>>            If (bDynamicConstraints and bFindParent) Begin
28538>>>>>>>                // no autofill stops a child findfirst. We don't need that here  
28538>>>>>>>                Get FindByRowIdExNoAutoFill of hoParentDD iParentTable ri to bSuccess
28539>>>>>>>                // we also consider navigating forward from a null consrained parent an error
28539>>>>>>>                If (not(bSuccess) or IsNullRowID(ri)) Begin
28541>>>>>>>                    // This is kind of complex because it means that the constraining parent cannot be
28541>>>>>>>                    // reloaded. In such a case you probably should not be in the view at all and
28541>>>>>>>                    // should navigate back
28541>>>>>>>                    Move hoParentDD to hoRefindError
28542>>>>>>>                    Move retCannotRereadConstrainingParent to eRefindError    
28543>>>>>>>                End
28543>>>>>>>>
28543>>>>>>>            End
28543>>>>>>>>
28543>>>>>>>
28543>>>>>>>            If (hoRefindError=0) Begin
28545>>>>>>>                
28545>>>>>>>                // now find main file as needed
28545>>>>>>>                If ( (NavigateData.eNavigateType = nfFromMain or ;                      NavigateData.eNavigateType = nfFromChild or ;                      NavigateData.eNavigateType = nfUndefined)  ;                     and NavigateData.iTable=Main_File(hoMainDD) and iStackSize>0) Begin
28547>>>>>>>                    
28547>>>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
28548>>>>>>>                    If (IsNullRowID(ri) or NavigateData.bNewRecord) Begin
28550>>>>>>>                        // Assume Create New Record
28550>>>>>>>                        Send Clear to hoMainDD
28551>>>>>>>                    End
28551>>>>>>>>
28551>>>>>>>                    Else Begin
28552>>>>>>>                        // Populate the list around the passed row ID
28552>>>>>>>                        Get FindByRowIdEx of hoMainDD (Main_File(hoMainDD)) ri to bSuccess
28553>>>>>>>                        If not bSuccess Begin
28555>>>>>>>                            Send Clear of hoMainDD
28556>>>>>>>                            Move hoMainDD to hoRefindError
28557>>>>>>>                            Move retCannotRereadMain to eRefindError    
28558>>>>>>>                        End
28558>>>>>>>>
28558>>>>>>>                    End
28558>>>>>>>>
28558>>>>>>>                End
28558>>>>>>>>
28558>>>>>>>                Else If (eViewType=vtZoom and  NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
28561>>>>>>>                    // Assume Create New Record
28561>>>>>>>                    Send Clear to hoMainDD
28562>>>>>>>                End
28562>>>>>>>>
28562>>>>>>>    
28562>>>>>>>                // finally, if a select view and we don't have a record tell the grid to
28562>>>>>>>                // do an init
28562>>>>>>>                If (eInitMode <> initStateReinitialize and hoRefindError=0 and eViewType=vtSelect) Begin
28564>>>>>>>                    Get HasRecord of hoMainDD to bOK
28565>>>>>>>                    If not bOK Begin
28567>>>>>>>                        Broadcast Recursive Send InitGrid NavigateData hoInvokingObject
28569>>>>>>>                    End
28569>>>>>>>>
28569>>>>>>>                End
28569>>>>>>>>
28569>>>>>>>    
28569>>>>>>>            End
28569>>>>>>>>
28569>>>>>>>        End
28569>>>>>>>>
28569>>>>>>>        
28569>>>>>>>        // Update the View Stack
28569>>>>>>>        Send PushView to (ViewStack(Self)) Self NavigateData.eNavigateType
28570>>>>>>>        Send UpdateInvokingViewDrillDownStyle 
28571>>>>>>>        
28571>>>>>>>
28571>>>>>>>        
28571>>>>>>>        
28571>>>>>>>        //  Cleanup navigation data
28571>>>>>>>        Get NamedValueRemove NavigateData.NamedValues "Init_Mode" to NavigateData.NamedValues
28572>>>>>>>        Send SetNavigateData NavigateData
28573>>>>>>>        
28573>>>>>>>        // if a find error, reverse the navigation. We assume that navigating to a view with
28573>>>>>>>        // records that cannot be found should be reversed. 
28573>>>>>>>        If hoRefindError Begin
28575>>>>>>>            If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
28577>>>>>>>                Set pbNavReinitError to True
28578>>>>>>>                If (pbStateHashInvalidError(Host(Self))) Begin
28580>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL_REC
28581>>>>>>>>
28581>>>>>>>                End
28581>>>>>>>>
28581>>>>>>>            End
28581>>>>>>>>
28581>>>>>>>            Else Begin
28582>>>>>>>                Send OnNavigateForwardRefindError hoRefindError eRefindError
28583>>>>>>>            End
28583>>>>>>>>
28583>>>>>>>        End
28583>>>>>>>>
28583>>>>>>>        Else Begin
28584>>>>>>>            Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject    // Hook to modify the view before opening it 
28585>>>>>>>        End
28585>>>>>>>>
28585>>>>>>>        
28585>>>>>>>        //  We are done navigating now
28585>>>>>>>        Set pbNavigating to False
28586>>>>>>>        
28586>>>>>>>        // Update URL (check if still the topview, OnNavigateForward might have done a navigation)
28586>>>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView
28587>>>>>>>        If (eInitMode <> initStateReinitialize and hoTopView = Self) Begin 
28589>>>>>>>            Send UpdateStateHash (eInitMode = initStateReinitializeTopView or pbStateReplace(Self))
28590>>>>>>>                        
28590>>>>>>>            Send UpdatePageTitle
28591>>>>>>>        End
28591>>>>>>>>
28591>>>>>>>    End_Procedure
28592>>>>>>>    
28592>>>>>>>    
28592>>>>>>>    
28592>>>>>>>    // set ordering for a List. Do it here so any grid fills will use the right index.
28592>>>>>>>    // Let's do this before any finds occur on the new view
28592>>>>>>>    Procedure NavigateForwardPreFindInit tWebNavigateData NavigateData Handle hoInvokingObject
28594>>>>>>>        Integer eViewType
28594>>>>>>>        Get peViewType to eViewType
28595>>>>>>>        If (eViewType=vtSelect) Begin
28597>>>>>>>            Broadcast Recursive Send InitOrdering NavigateData hoInvokingObject
28599>>>>>>>        End
28599>>>>>>>>
28599>>>>>>>        Send OnNavigateForwardPreFindInit NavigateData hoInvokingObject
28600>>>>>>>    End_Procedure
28601>>>>>>>    
28601>>>>>>>    // This is called during NavigateForward after the automatic constraints have been applied but
28601>>>>>>>    // before the constraints have been rebuilt and any records have been found for the view.
28601>>>>>>>    // This primarily exists to give you a chance to apply any additional constraints for the view. You can
28601>>>>>>>    // also use this to set any finding properties such as piSortCol, etc.
28601>>>>>>>    // You should not use this to find DD records or fill the DDOs yourself - it won't work!
28601>>>>>>>    Procedure OnNavigateForwardPreFindInit  tWebNavigateData NavigateData Handle hoInvokingObject
28603>>>>>>>    End_Procedure
28604>>>>>>>    
28604>>>>>>>    // use to navigate to the start of the stack. If there is a default view it
28604>>>>>>>    // will navigate to there.
28604>>>>>>>    // if bUnconditional, do this without checking for changed states
28604>>>>>>>    Procedure NavigateBegin Handle hoInvokingObject Boolean bUnconditional
28606>>>>>>>        Boolean bOk
28606>>>>>>>        Handle hoTop hoDefault
28606>>>>>>>        
28606>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28607>>>>>>>        
28607>>>>>>>        // reset the breadcrumb stack respecting the default view
28607>>>>>>>        Get Reset of (ViewStack(Self)) (hoDefault <> Self) bUnconditional to bOK
28608>>>>>>>        If (bOK) Begin
28610>>>>>>>            Send NavigateForward hoInvokingObject // note that we do not pass on the invoking object to preven the navigation logic from making wrong assumptions
28611>>>>>>>        End
28611>>>>>>>>
28611>>>>>>>    End_Procedure
28612>>>>>>>
28612>>>>>>>    // Send this to change the default caption that is shown for this view
28612>>>>>>>    // in a breadcrumb.
28612>>>>>>>    Procedure SetBreadcrumbCaption String sCaption
28614>>>>>>>        Send SetCaption of (ViewStack(Self)) Self sCaption
28615>>>>>>>    End_Procedure
28616>>>>>>>
28616>>>>>>>    // this gets the breadcrumb caption 
28616>>>>>>>    Function GetBreadcrumbCaption Returns String
28618>>>>>>>        String sCaption
28618>>>>>>>        Get GetCaption of (ViewStack(Self)) Self to sCaption
28619>>>>>>>        Function_Return sCaption
28620>>>>>>>    End_Function
28621>>>>>>>
28621>>>>>>>    // Send this to change the default caption that is shown for this view
28621>>>>>>>    // in a "heading". Typically used by a breadcrumb object when it is simply
28621>>>>>>>    // displaying a view heading rather than the entire breadcrumb.
28621>>>>>>>    Procedure SetHeaderCaption String sCaption
28623>>>>>>>        Send SetHeaderCaption of (ViewStack(Self)) Self sCaption
28624>>>>>>>        
28624>>>>>>>        Send UpdatePageTitle
28625>>>>>>>    End_Procedure
28626>>>>>>>
28626>>>>>>>    // this gets the breadcrumb heading scaption 
28626>>>>>>>    Function GetHeaderCaption Returns String
28628>>>>>>>        String sCaption
28628>>>>>>>        Get GetHeaderCaption of (ViewStack(Self)) Self to sCaption
28629>>>>>>>        Function_Return sCaption
28630>>>>>>>    End_Function
28631>>>>>>>
28631>>>>>>>    // if a view is changed, how do we close this?
28631>>>>>>>    // This uses peChangedViewAction and a corresponding
28631>>>>>>>    // Verify_Data_Loss_Msg / Verify_SaveClearCancel_msg to
28631>>>>>>>    // determine the action. Therefore setting the Verify_xxx_msg overrides
28631>>>>>>>    // the peChangedViewExitAction and force a non-verified abandoning of changes  
28631>>>>>>>    Function GetChangedViewExitAction Returns Integer
28633>>>>>>>        Integer iMsg eCloseAction
28633>>>>>>>        
28633>>>>>>>        Get peChangedViewExitAction to eCloseAction
28634>>>>>>>        If (eCloseAction=cveConfirmAbandonChanges) Begin
28636>>>>>>>            Get Verify_Data_Loss_Msg to iMsg
28637>>>>>>>            If (iMsg=0) Begin
28639>>>>>>>                Move cveAbandonChanges to eCloseAction
28640>>>>>>>            End
28640>>>>>>>>
28640>>>>>>>        End
28640>>>>>>>>
28640>>>>>>>        Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28643>>>>>>>            Get Verify_SaveClearCancel_msg to iMsg
28644>>>>>>>            If (iMsg=0) Begin
28646>>>>>>>                Move cveAbandonChanges to eCloseAction
28647>>>>>>>            End
28647>>>>>>>>
28647>>>>>>>        End
28647>>>>>>>>
28647>>>>>>>        Function_Return eCloseAction
28648>>>>>>>    End_Function
28649>>>>>>>    
28649>>>>>>>
28649>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28649>>>>>>>    // do not call this directly.
28649>>>>>>>    // This is used for Yes/No verifies
28649>>>>>>>    Procedure NavigateClose_Callback Integer eConfirmMode
28651>>>>>>>        If (eConfirmMode = cmYes) Begin
28653>>>>>>>            Send NavigateCloseExec False // means close no save
28654>>>>>>>        End
28654>>>>>>>>
28654>>>>>>>    End_Procedure
28655>>>>>>>
28655>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28655>>>>>>>    Procedure NavigateCloseYNC_Callback Integer eConfirmMode
28657>>>>>>>        If (eConfirmMode = cmYes) Begin
28659>>>>>>>            Send NavigateCloseExec True
28660>>>>>>>        End
28660>>>>>>>>
28660>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28663>>>>>>>            Send NavigateCloseExec False // means close no save
28664>>>>>>>        End
28664>>>>>>>>
28664>>>>>>>    End_Procedure
28665>>>>>>>    
28665>>>>>>>
28665>>>>>>>    // If a view is the current top view, you can send this message to it
28665>>>>>>>    // to close the view. If there is a view underneath in the view stack
28665>>>>>>>    // then it will be passed back navigation data from the callback object.
28665>>>>>>>    // This control must understand the GetNavigateBackData callback message.
28665>>>>>>>    // 
28665>>>>>>>    // If there is no special data to pass back to the view underneath in 
28665>>>>>>>    // the view stack then you should call NavigateCancel.
28665>>>>>>>    Procedure NavigateClose Handle hoCallback
28667>>>>>>>        Handle hoView
28667>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28668>>>>>>>        Send NavigateCloseTo hoView hoCallback
28669>>>>>>>    End_Procedure
28670>>>>>>>
28670>>>>>>>    // NavigateCloseTo is passed the view to return to. Normally NavigateClose is used and this is for more
28670>>>>>>>    // advanced usage when closing several views but wanting to return a value to the view
28670>>>>>>>    // 1. When multi-level closes are used the navigateFrom type is always changed to nfUndefined meaning you must
28670>>>>>>>    //    handle the update yourself.
28670>>>>>>>    // 2. We only check for data-loss changes in the top view. If there are changes in views in between this and the destination
28670>>>>>>>    //    view, they are lost.
28670>>>>>>>    // Use this with care.
28670>>>>>>>    Procedure NavigateCloseTo Handle hoView Handle hoCallback
28672>>>>>>>        Handle hoMainDD
28672>>>>>>>        Boolean bCanPopView bChanged 
28672>>>>>>>        Integer eCloseAction iIndex
28672>>>>>>>        String sReason sNavigateDataCallbackObj sInvokingView
28672>>>>>>>        Integer eWebViewStyle
28672>>>>>>>
28672>>>>>>>        Get peWebViewStyle to eWebViewStyle
28673>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28675>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28676>>>>>>>>
28676>>>>>>>            Procedure_Return
28677>>>>>>>        End            
28677>>>>>>>>
28677>>>>>>>
28677>>>>>>>
28677>>>>>>>        If hoView Begin
28679>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28680>>>>>>>            If (iIndex=-1) Begin
28682>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28683>>>>>>>>
28683>>>>>>>                Procedure_Return
28684>>>>>>>            End
28684>>>>>>>>
28684>>>>>>>            Get WebObjectName of hoView to sInvokingView
28685>>>>>>>        End
28685>>>>>>>>
28685>>>>>>>        WebSet psNavigateBackView to sInvokingView
28686>>>>>>>        
28686>>>>>>>        Get WebObjectName of hoCallback to sNavigateDataCallbackObj
28687>>>>>>>        WebSet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28688>>>>>>>
28688>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28689>>>>>>>        
28689>>>>>>>        If (bCanPopView) Begin
28691>>>>>>>            Get IsViewChanged to bChanged
28692>>>>>>>            
28692>>>>>>>            If bChanged Begin
28694>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28695>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28697>>>>>>>                    Send VerifyRequest (RefProc(NavigateClose_Callback)) (RefFunc(Verify_Data_Loss_msg))
28698>>>>>>>                End
28698>>>>>>>>
28698>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28701>>>>>>>                    Send VerifyRequest (RefProc(NavigateCloseYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28702>>>>>>>                End
28702>>>>>>>>
28702>>>>>>>                Else If (eCloseAction=cveSave) Begin
28705>>>>>>>                    Send NavigateCloseExec True
28706>>>>>>>                End
28706>>>>>>>>
28706>>>>>>>                Else Begin
28707>>>>>>>                    Send NavigateCloseExec False
28708>>>>>>>                End
28708>>>>>>>>
28708>>>>>>>            End
28708>>>>>>>>
28708>>>>>>>            Else Begin            
28709>>>>>>>                Send NavigateCloseExec False
28710>>>>>>>            End
28710>>>>>>>>
28710>>>>>>>        End
28710>>>>>>>>
28710>>>>>>>        Else Begin
28711>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28712>>>>>>>>
28712>>>>>>>        End
28712>>>>>>>>
28712>>>>>>>    End_Procedure
28713>>>>>>>    
28713>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28713>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28713>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28713>>>>>>>    // been performed before we get here.
28713>>>>>>>    //
28713>>>>>>>    // Called via NavigateCloseTo, do not call this directly.
28713>>>>>>>    Procedure NavigateCloseExec Boolean bSave
28715>>>>>>>        Handle hoView hoCallback
28715>>>>>>>        String sNavigateDataCallbackObj sView
28715>>>>>>>        Boolean bErr
28715>>>>>>>        
28715>>>>>>>        If bSave Begin
28717>>>>>>>           Get SaveViewExec to bErr            
28718>>>>>>>           If bErr ;            Procedure_Return 
28721>>>>>>>        End
28721>>>>>>>>
28721>>>>>>>        
28721>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28722>>>>>>>        If (Trim(sView) <> "") Begin
28724>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28725>>>>>>>            WebGet psNavigateDataCallbackObj to sNavigateDataCallbackObj
28726>>>>>>>            If (sNavigateDataCallbackObj<>"") Begin
28728>>>>>>>                Get WebObjectByName sNavigateDataCallbackObj to hoCallback
28729>>>>>>>            End
28729>>>>>>>>
28729>>>>>>>            Send NavigateBackToHere of hoView False (If(hoCallback, hoCallback, Self))
28730>>>>>>>        End
28730>>>>>>>>
28730>>>>>>>        Else Begin
28731>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28732>>>>>>>        End
28732>>>>>>>>
28732>>>>>>>    End_Procedure
28733>>>>>>>
28733>>>>>>>    // this attempts a save and returns True if it failed.
28733>>>>>>>    // There should be no confirmation messages at this point.
28733>>>>>>>    // Unlike RequestSaveExec, this has to attempt a save at the view level.
28733>>>>>>>    // Currently it just saves the view's Server, which may not always be enough if
28733>>>>>>>    // have sub-DD like detail lines.
28733>>>>>>>    Function SaveViewExec Returns Boolean
28735>>>>>>>        Handle hoServer
28735>>>>>>>        Integer iRetVal
28735>>>>>>>        Boolean bRequestValidateAll bErr
28735>>>>>>>        Get Server to hoServer
28736>>>>>>>        If hoServer Begin
28738>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
28739>>>>>>>            If bRequestValidateAll Begin
28741>>>>>>>                Get Request_Validate_All of hoServer to iRetVal
28742>>>>>>>            End
28742>>>>>>>>
28742>>>>>>>            Else Begin
28743>>>>>>>                Get Request_Validate of hoServer to iRetVal
28744>>>>>>>            End
28744>>>>>>>>
28744>>>>>>>            If (iRetVal=0) Begin
28746>>>>>>>                Move False to Err
28747>>>>>>>                Send Request_Save to hoServer
28748>>>>>>>                Move Err to iRetVal
28749>>>>>>>            End
28749>>>>>>>>
28749>>>>>>>        End
28749>>>>>>>>
28749>>>>>>>        Function_Return iRetVal
28750>>>>>>>    End_Function
28751>>>>>>>
28751>>>>>>>    // Save before navigate forward to some other view. Return 0 if ok.
28751>>>>>>>    // Upon completion a saved record must exist, else return non zero
28751>>>>>>>    Function SaveViewBeforeNavigate Returns Boolean
28753>>>>>>>        Handle hoServer
28753>>>>>>>        Boolean bChanged bErr bHasRec
28753>>>>>>>        Get Server to hoServer
28754>>>>>>>        Get IsViewChanged to bChanged
28755>>>>>>>        
28755>>>>>>>        If (bChanged) Begin
28757>>>>>>>           Get SaveViewExec to bErr
28758>>>>>>>        End
28758>>>>>>>>
28758>>>>>>>        Else Begin
28759>>>>>>>            // if nothing to save but a new record, we will attempt validation and save anyway. Most
28759>>>>>>>            // likely this will raise a validation error providing the user feedback that they cannot
28759>>>>>>>            // navigate forward without a valid save
28759>>>>>>>            If (hoServer) Begin
28761>>>>>>>                Get HasRecord of hoServer to bHasRec
28762>>>>>>>                If not bHasRec Begin
28764>>>>>>>                    Get SaveViewExec to bErr
28765>>>>>>>                End
28765>>>>>>>>
28765>>>>>>>            End
28765>>>>>>>>
28765>>>>>>>        End
28765>>>>>>>>
28765>>>>>>>        Function_Return bErr
28766>>>>>>>    End_Function
28767>>>>>>>
28767>>>>>>>
28767>>>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
28767>>>>>>>    // do not call this directly.
28767>>>>>>>    // This is used for Yes/No verifies
28767>>>>>>>    Procedure NavigateCancel_Callback Integer eConfirmMode
28769>>>>>>>        If (eConfirmMode = cmYes) Begin
28771>>>>>>>            Send NavigateCancelExec False
28772>>>>>>>        End
28772>>>>>>>>
28772>>>>>>>    End_Procedure
28773>>>>>>>
28773>>>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
28773>>>>>>>    Procedure NavigateCancelYNC_Callback Integer eConfirmMode
28775>>>>>>>        If (eConfirmMode = cmYes) Begin
28777>>>>>>>            Send NavigateCancelExec True
28778>>>>>>>        End
28778>>>>>>>>
28778>>>>>>>        Else If (eConfirmMode = cmNo) Begin
28781>>>>>>>            Send NavigateCancelExec False // means close no save
28782>>>>>>>        End
28782>>>>>>>>
28782>>>>>>>    End_Procedure
28783>>>>>>>    
28783>>>>>>>
28783>>>>>>>    // If a view is the current top view, you can send this message to it
28783>>>>>>>    // to close the view. Typically this message is sent to a view by a 
28783>>>>>>>    // Cancel on the view.
28783>>>>>>>    Procedure NavigateCancel 
28785>>>>>>>        Handle hoView
28785>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
28786>>>>>>>        Send NavigateCancelTo hoView
28787>>>>>>>    End_Procedure
28788>>>>>>>    
28788>>>>>>>    // If a view is the current top view, you can send this message to it
28788>>>>>>>    // to close the view and navigate down to the passed view. Typically this message is sent to
28788>>>>>>>    // a view by a breacrumb navigate back action
28788>>>>>>>    Procedure NavigateCancelTo Handle hoView
28790>>>>>>>        Boolean bCanPopView bChanged  bOk
28790>>>>>>>        Integer eCloseAction
28790>>>>>>>        String sReason sInvokingView
28790>>>>>>>        Integer eWebViewStyle iIndex
28790>>>>>>>
28790>>>>>>>        Get peWebViewStyle to eWebViewStyle
28791>>>>>>>        If (eWebViewStyle = wvsDesktop) Begin
28793>>>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
28794>>>>>>>>
28794>>>>>>>            Procedure_Return
28795>>>>>>>        End            
28795>>>>>>>>
28795>>>>>>>        
28795>>>>>>>        If hoView Begin
28797>>>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
28798>>>>>>>            If (iIndex=-1) Begin
28800>>>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
28801>>>>>>>>
28801>>>>>>>                Procedure_Return
28802>>>>>>>            End
28802>>>>>>>>
28802>>>>>>>            Get WebObjectName of hoView to sInvokingView
28803>>>>>>>        End
28803>>>>>>>>
28803>>>>>>>        WebSet psNavigateBackView to sInvokingView
28804>>>>>>>        
28804>>>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
28805>>>>>>>        
28805>>>>>>>        If (bCanPopView) Begin
28807>>>>>>>            
28807>>>>>>>            // Set the callback object that will be used by NavigateCloseExec
28807>>>>>>>            Get IsViewChanged to bChanged
28808>>>>>>>            If bChanged Begin
28810>>>>>>>                Get GetChangedViewExitAction to eCloseAction
28811>>>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
28813>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancel_Callback)) (RefFunc(Verify_Data_Loss_msg))
28814>>>>>>>                End
28814>>>>>>>>
28814>>>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
28817>>>>>>>                    Send VerifyRequest (RefProc(NavigateCancelYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
28818>>>>>>>                End
28818>>>>>>>>
28818>>>>>>>                Else If (eCloseAction=cveSave) Begin
28821>>>>>>>                    Send NavigateCancelExec True
28822>>>>>>>                End
28822>>>>>>>>
28822>>>>>>>                Else Begin
28823>>>>>>>                    Send NavigateCancelExec False
28824>>>>>>>                End
28824>>>>>>>>
28824>>>>>>>            End
28824>>>>>>>>
28824>>>>>>>            Else Begin            
28825>>>>>>>                Send NavigateCancelExec False
28826>>>>>>>            End
28826>>>>>>>>
28826>>>>>>>        End
28826>>>>>>>>
28826>>>>>>>        Else Begin
28827>>>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
28828>>>>>>>>
28828>>>>>>>        End
28828>>>>>>>>
28828>>>>>>>    End_Procedure
28829>>>>>>>
28829>>>>>>>    
28829>>>>>>>    // This actually performs the Navigate Close operation. This will close the current
28829>>>>>>>    // view and pop the view stack without returning any data to the invoking view.
28829>>>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
28829>>>>>>>    // been performed before we get here.
28829>>>>>>>    //
28829>>>>>>>    // Called via NavigateCancel, do not call this directly.
28829>>>>>>>    Procedure NavigateCancelExec Boolean bSave
28831>>>>>>>        Handle hoView hoCallback
28831>>>>>>>        Boolean bErr
28831>>>>>>>        String sView
28831>>>>>>>
28831>>>>>>>        If bSave Begin
28833>>>>>>>           Get SaveViewExec to bErr            
28834>>>>>>>           If bErr ;            Procedure_Return
28837>>>>>>>           // If save was successful treat this as a close and not a cancel
28837>>>>>>>           Send NavigateCloseExec False 
28838>>>>>>>           Procedure_Return
28839>>>>>>>        End
28839>>>>>>>>
28839>>>>>>>
28839>>>>>>>//        // Navigate to the next view down in the view stack
28839>>>>>>>//        Send PopView to (ViewStack(Self))                  // removes this view
28839>>>>>>>//        Get TopViewHandle of (ViewStack(Self)) to hoView   // handle to the new top of view
28839>>>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
28840>>>>>>>
28840>>>>>>>        If (Trim(sView) <> "") Begin
28842>>>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
28843>>>>>>>            Send NavigateBackToHere of hoView True 0
28844>>>>>>>        End
28844>>>>>>>>
28844>>>>>>>        Else Begin
28845>>>>>>>            Send Hide   // If the view stack is empty, just hide this view
28846>>>>>>>        End
28846>>>>>>>>
28846>>>>>>>    End_Procedure
28847>>>>>>>
28847>>>>>>>    // Loads default data for NavigateData for NavigateForward.
28847>>>>>>>    // This must be executed from the point of view
28847>>>>>>>    // of the invoking object, which is the object that calls this.
28847>>>>>>>    Procedure LoadDefaultNavigateForwardData Handle hoInvokIngObject tWebNavigateData ByRef NavigateData
28849>>>>>>>        Integer iFile iField
28849>>>>>>>        String sValue
28849>>>>>>>        Handle hoServer hoDDO
28849>>>>>>>        Boolean bChanged bDataBindable
28849>>>>>>>        RowID ri
28849>>>>>>>        
28849>>>>>>>        // step Populate the Navigate Data struct with the best guess values from
28849>>>>>>>        // this control's server DDO.
28849>>>>>>>        // If this is called from outside a view, like a main menu, this should
28849>>>>>>>        // delegate to cWebApp and return 0.
28849>>>>>>>        Get Server of hoInvokIngObject to hoServer
28850>>>>>>>        
28850>>>>>>>        If (hoServer) Begin
28852>>>>>>>            Get pbDataBindable of hoInvokIngObject to bDataBindable
28853>>>>>>>            Get Main_File of hoServer to iFile
28854>>>>>>>            
28854>>>>>>>            If (NavigateData.eNavigateType=nfFromParent) Begin
28856>>>>>>>
28856>>>>>>>                // Assertion: Check that the constraining table is set properly
28856>>>>>>>                If (iFile<>NavigateData.iTable) Begin
28858>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromParent"
28859>>>>>>>>
28859>>>>>>>                    Procedure_Return
28860>>>>>>>                End
28860>>>>>>>>
28860>>>>>>>
28860>>>>>>>                Get CurrentRowId of hoServer to ri
28861>>>>>>>                Move (SerializeRowID(ri)) to NavigateData.sRowID 
28862>>>>>>>            End
28862>>>>>>>>
28862>>>>>>>            Else If (NavigateData.eNavigateType=nfFromChild or NavigateData.eNavigateType=nfFromMain) Begin
28865>>>>>>>
28865>>>>>>>                // Assertion: Check that the table is set properly for a from main
28865>>>>>>>                If (NavigateData.eNavigateType=nfFromMain and NavigateData.iTable<>iFile) Begin
28867>>>>>>>                    // With the NavigateInitialize logic we don't always have the right invoking object where this is not an error but something we want to correct
28867>>>>>>>                    Move NavigateData.iTable to iFile
28868>>>>>>>//                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromMain"
28868>>>>>>>//                    Procedure_Return
28868>>>>>>>                End
28868>>>>>>>>
28868>>>>>>>                // Assertion: Check that the table is set properly for a from child
28868>>>>>>>                If (NavigateData.eNavigateType=nfFromChild and (NavigateData.iTable=0 or NavigateData.iTable=iFile)) Begin
28870>>>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromChild"
28871>>>>>>>>
28871>>>>>>>                    Procedure_Return
28872>>>>>>>                End
28872>>>>>>>>
28872>>>>>>>
28872>>>>>>>                // use the DDO that owns the file 
28872>>>>>>>                Get Data_Set of hoServer NavigateData.iTable to hoDDO
28873>>>>>>>                If hoDDO Begin
28875>>>>>>>                    Get CurrentRowId of hoDDO to ri
28876>>>>>>>                    If (bDataBindable) Begin
28878>>>>>>>                        Get Data_File of hoInvokIngObject  to iFile
28879>>>>>>>                        If (iFile=NavigateData.iTable) Begin
28881>>>>>>>                            Get Data_Field of hoInvokIngObject to iField
28882>>>>>>>                            Move iField to NavigateData.iColumn
28883>>>>>>>                            WebGet pbChanged of hoInvokIngObject to bChanged
28884>>>>>>>                            // if changed we will do item_find (read) to seed this
28884>>>>>>>                            If bChanged Begin
28886>>>>>>>                                // note this deferred (a DDO read)
28886>>>>>>>                                Send Item_Find of hoServer GE iFile iField True False True
28887>>>>>>>                                Move (GetRowID(iFile)) to ri
28888>>>>>>>                            End
28888>>>>>>>>
28888>>>>>>>                        End
28888>>>>>>>>
28888>>>>>>>                    End
28888>>>>>>>>
28888>>>>>>>                    Move (SerializeRowID(ri)) to NavigateData.sRowID    // Store the resulting RowID
28889>>>>>>>                End
28889>>>>>>>>
28889>>>>>>>            End
28889>>>>>>>>
28889>>>>>>>            // If undefined we provide no extra information. Trying to guess what the developer wants
28889>>>>>>>            // to do will just make things too confusing. Use OnGetNavigateForwardData to set whatever you want 
28889>>>>>>>        End
28889>>>>>>>>
28889>>>>>>>    End_Procedure
28890>>>>>>>    
28890>>>>>>>    // loads default data for NavigateData for a NavigateClose
28890>>>>>>>    // This must be executed from the point of view
28890>>>>>>>    // of the invoking object, which is the object that calls this.
28890>>>>>>>    
28890>>>>>>>    Procedure LoadDefaultNavigateBackData Handle hoInvokingObject tWebNavigateData ByRef NavigateData
28892>>>>>>>        Integer iFile iField
28892>>>>>>>        Handle hoServer
28892>>>>>>>        Boolean bChanged bDataBindable
28892>>>>>>>        RowID ri
28892>>>>>>>        
28892>>>>>>>        // Populate the Navigate Data struct with the best guess values from
28892>>>>>>>        // this control's server DDO
28892>>>>>>>        // If this is called from outside a view, like a main menu, this should
28892>>>>>>>        // delegate to cWebApp and return 0.
28892>>>>>>>        Get Server of hoInvokingObject to hoServer
28893>>>>>>>        If (hoServer) Begin
28895>>>>>>>            Get pbDataBindable of hoInvokingObject to bDataBindable
28896>>>>>>>            Get CurrentRowId of hoServer to ri
28897>>>>>>>            Move (SerializeRowID(ri)) to NavigateData.sRowID 
28898>>>>>>>            Get Main_File of hoServer to NavigateData.iTable
28899>>>>>>>            
28899>>>>>>>            If (bDataBindable) Begin
28901>>>>>>>                Get Data_File of hoInvokingObject  to iFile
28902>>>>>>>                Get Data_Field of hoInvokingObject to iField
28903>>>>>>>                
28903>>>>>>>                Move iFile  to NavigateData.iTable
28904>>>>>>>                Move iField to NavigateData.iColumn
28905>>>>>>>            End
28905>>>>>>>>
28905>>>>>>>        End
28905>>>>>>>>
28905>>>>>>>    
28905>>>>>>>    End_Procedure
28906>>>>>>>    
28906>>>>>>>    
28906>>>>>>>    // Triggers an update of the state hash and pushes it to the history stack.
28906>>>>>>>    //
28906>>>>>>>    // Params:
28906>>>>>>>    //      bReplace    If true the new state will replace the existing state instead of pushing a 
28906>>>>>>>    //                  new history item.
28906>>>>>>>    Procedure UpdateStateHash Boolean bReplace
28908>>>>>>>        String sPrevHash sStateHash
28908>>>>>>>        
28908>>>>>>>        If (peApplicationStateMode(Host(Self)) <> asmOff) Begin
28910>>>>>>>            Get GenerateStateHash to sStateHash
28911>>>>>>>
28911>>>>>>>            If (bReplace) Begin
28913>>>>>>>                Get StateHash of (Host(Self)) to sPrevHash
28914>>>>>>>                If (sStateHash <> sPrevHash) Begin
28916>>>>>>>                    Send SetStateHash of (Host(Self)) sStateHash "" True
28917>>>>>>>                End
28917>>>>>>>>
28917>>>>>>>            End
28917>>>>>>>>
28917>>>>>>>            Else Begin
28918>>>>>>>                Send SetStateHash of (Host(Self)) sStateHash "" False
28919>>>>>>>            End
28919>>>>>>>>
28919>>>>>>>        End
28919>>>>>>>>
28919>>>>>>>    End_Procedure
28920>>>>>>>    
28920>>>>>>>    
28920>>>>>>>    // Triggered when a state hash is defined allowing the application to add a custom piece to the
28920>>>>>>>    // hash. This piece can be used inside OnShow / OnLoad / OnNavigateForward to restore the state.
28920>>>>>>>    //
28920>>>>>>>    // Params:
28920>>>>>>>    //      ByRef sStateHash    String that should be filled with the custom hash.
28920>>>>>>>    Procedure OnDefineCustomStateHash String ByRef sStateHash
28922>>>>>>>    End_Procedure
28923>>>>>>>    
28923>>>>>>>    
28923>>>>>>>    // Determines the custom state hash by parsing it out of the view state hash. The view state
28923>>>>>>>    // has is retrieved form the navigation data or read directly from the url.
28923>>>>>>>    //
28923>>>>>>>    // Returns:
28923>>>>>>>    //      Custom state hash.
28923>>>>>>>    Function CustomStateHash Returns String
28925>>>>>>>        Integer eViewStyle
28925>>>>>>>        String sStateHash sView sRecordId sCustomHash
28925>>>>>>>        tWebNavigateData navData
28925>>>>>>>        tWebNavigateData navData
28925>>>>>>>        
28925>>>>>>>        Get peWebViewStyle to eViewStyle
28926>>>>>>>        
28926>>>>>>>        If (eViewStyle = wvsDesktop) Begin
28928>>>>>>>            Get StateHash of (Host(Self)) to sStateHash
28929>>>>>>>        End
28929>>>>>>>>
28929>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
28932>>>>>>>            Get GetNavigateData to navData
28933>>>>>>>            Get NamedValueGet navData.NamedValues "Init_StateHash" to sStateHash
28934>>>>>>>        End
28934>>>>>>>>
28934>>>>>>>        
28934>>>>>>>        Send ParseViewStateHash of (Host(Self)) sStateHash (&sView) (&sRecordId) (&sCustomHash)
28935>>>>>>>        
28935>>>>>>>        Function_Return sCustomHash
28936>>>>>>>    End_Function
28937>>>>>>>    
28937>>>>>>>    
28937>>>>>>>    // Converts a record id from a hash for a specific table into a rowid. By default it offloads
28937>>>>>>>    // this to RecordIdToRowId of the Data Dictionary.
28937>>>>>>>    //
28937>>>>>>>    // Params:
28937>>>>>>>    //      iFile       File number.
28937>>>>>>>    //      sRecordId   String representing the record id.
28937>>>>>>>    //      rRowId      (ByRef) Filled with the rowid by this function.
28937>>>>>>>    // Returns:
28937>>>>>>>    //      True if the record id is valid.
28937>>>>>>>    Function HashRecordIdToRowId Integer iFile String sRecordId RowID ByRef rRowId Returns Boolean
28939>>>>>>>        Handle hoMainDD hoDD
28939>>>>>>>        Boolean bFound
28939>>>>>>>        
28939>>>>>>>        Move True to bFound
28940>>>>>>>        
28940>>>>>>>        Get Main_DD to hoMainDD
28941>>>>>>>        If (hoMainDD > 0) Begin
28943>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28944>>>>>>>            
28944>>>>>>>            If (hoDD > 0) Begin
28946>>>>>>>                If (Lowercase(sRecordId) <> (Lowercase(psStateNewRecordId(Self)))) Begin
28948>>>>>>>                    Get RecordIdToRowId of hoDD sRecordId (&rRowId) to bFound
28949>>>>>>>                End
28949>>>>>>>>
28949>>>>>>>            End
28949>>>>>>>>
28949>>>>>>>        End
28949>>>>>>>>
28949>>>>>>>        
28949>>>>>>>        Function_Return bFound
28950>>>>>>>    End_Function
28951>>>>>>>    
28951>>>>>>>    
28951>>>>>>>    // Converts a rowid into a state hash record id (a readable format). By default this is
28951>>>>>>>    // offloaded to the Data Dictionary RowIdToRecordId logic that works on the primary key.
28951>>>>>>>    //
28951>>>>>>>    // Params:
28951>>>>>>>    //      iFile       File number.
28951>>>>>>>    //      sRowId      Serialized rowid.
28951>>>>>>>    // Returns:
28951>>>>>>>    //      Record id.
28951>>>>>>>    Function GenerateStateHashRecordId Integer iFile RowID rRowId Returns String
28953>>>>>>>        Handle hoMainDD hoDD
28953>>>>>>>        String sRecordId
28953>>>>>>>        
28953>>>>>>>        
28953>>>>>>>        Get Main_DD to hoMainDD
28954>>>>>>>        If (hoMainDD > 0) Begin
28956>>>>>>>            Get Data_Set of hoMainDD iFile to hoDD
28957>>>>>>>            
28957>>>>>>>            If (hoDD > 0) Begin
28959>>>>>>>                If (IsNullRowID(rRowId)) Begin
28961>>>>>>>                    Move (psStateNewRecordId(Self)) to sRecordId
28962>>>>>>>                End
28962>>>>>>>>
28962>>>>>>>                Else Begin
28963>>>>>>>                    Get RowIdToRecordId of hoDD rRowId to sRecordId
28964>>>>>>>                End
28964>>>>>>>>
28964>>>>>>>            End
28964>>>>>>>>
28964>>>>>>>        End
28964>>>>>>>>
28964>>>>>>>        
28964>>>>>>>        Function_Return sRecordId
28965>>>>>>>    End_Function
28966>>>>>>>    
28966>>>>>>>    
28966>>>>>>>    // Generates the view state hash for the drill-down model. Recursively calls its invoking view
28966>>>>>>>    // (if it is in sync) to get the entire view stack in the hash.
28966>>>>>>>    //
28966>>>>>>>    // Returns:
28966>>>>>>>    //      View state hash including hashes of invoking views.
28966>>>>>>>    Function GenerateStateHash_DrillDown Returns String
28968>>>>>>>        String sInvokingHash sViewHash sHash sName sId sCustom sRowId
28968>>>>>>>        Boolean bInScope
28968>>>>>>>        Handle hoInvokingView hoDefault hoMain hoInvokingObject
28968>>>>>>>        tWebNavigateData navData
28968>>>>>>>        tWebNavigateData navData
28968>>>>>>>        Integer eViewType eStateMode
28968>>>>>>>        RowID rRowId
28968>>>>>>>        
28968>>>>>>>        Get InvokingViewHandleByView of (ViewStack(Self)) Self to hoInvokingView
28969>>>>>>>        Get peStateMode to eStateMode
28970>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
28971>>>>>>>        
28971>>>>>>>        
28971>>>>>>>        If (eStateMode <> vsmOff) Begin
28973>>>>>>>            Get peViewType to eViewType
28974>>>>>>>            
28974>>>>>>>            
28974>>>>>>>            //  For zoom views or record views we look at the main DD
28974>>>>>>>            If (eStateMode = vsmRecord or (eViewType = vtZoom and eStateMode = vsmDefault)) Begin
28976>>>>>>>                Get Main_DD to hoMain
28977>>>>>>>                
28977>>>>>>>                If (hoMain > 0) Begin
28979>>>>>>>                    Get CurrentRowId of hoMain to rRowId
28980>>>>>>>                    
28980>>>>>>>                    Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sId
28981>>>>>>>                End
28981>>>>>>>>
28981>>>>>>>            End
28981>>>>>>>>
28981>>>>>>>            Else If (eStateMode = vsmDefault) Begin
28984>>>>>>>                //  For other views we we look at the navigation data (if eStatEMode is default)
28984>>>>>>>                Get GetNavigateData to navData
28985>>>>>>>                
28985>>>>>>>                Case Begin
28985>>>>>>>                    Case (navData.eNavigateType = nfFromParent)
28987>>>>>>>                    Case (navData.eNavigateType = nfFromChild)
28990>>>>>>>                    Case (navData.eNavigateType = nfFromMain) 
28993>>>>>>>                        If (hoInvokingView = C_WebUnresolvedObject) Begin
28995>>>>>>>                            Function_Return ""
28996>>>>>>>                        End
28996>>>>>>>>
28996>>>>>>>                        
28996>>>>>>>                        If (navData.bNewRecord) Begin
28998>>>>>>>                            Move "" to sId    
28999>>>>>>>                        End
28999>>>>>>>>
28999>>>>>>>                        Else Begin
29000>>>>>>>                            Move navData.sRowID to sRowId
29001>>>>>>>                        End
29001>>>>>>>>
29001>>>>>>>                        
29001>>>>>>>                        Get GenerateStateHashRecordId of hoInvokingView navData.iTable (DeserializeRowID(sRowId)) to sId
29002>>>>>>>                        
29002>>>>>>>                        Case Break
29003>>>>>>>                Case End
29003>>>>>>>            End
29003>>>>>>>>
29003>>>>>>>        
29003>>>>>>>            Get GetInvokingObject to hoInvokingObject
29004>>>>>>>            Get StateHashKey hoInvokingObject to sName
29005>>>>>>>            
29005>>>>>>>            If (sName <> "") Begin
29007>>>>>>>                Send OnDefineCustomStateHash (&sCustom)
29008>>>>>>>            
29008>>>>>>>                Get ConcatViewStateHash of (Host(Self)) sName sId sCustom to sViewHash
29009>>>>>>>            End
29009>>>>>>>>
29009>>>>>>>        End
29009>>>>>>>>
29009>>>>>>>        
29009>>>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
29011>>>>>>>            Get IsInCallActionScope of hoInvokingView to bInScope
29012>>>>>>>            If (bInScope) Begin
29014>>>>>>>                Get GenerateStateHash_DrillDown of hoInvokingView to sInvokingHash
29015>>>>>>>                WebSet psInvokingStateHash to sInvokingHash
29016>>>>>>>            End
29016>>>>>>>>
29016>>>>>>>            Else Begin
29017>>>>>>>                WebGet psInvokingStateHash to sInvokingHash 
29018>>>>>>>            End
29018>>>>>>>>
29018>>>>>>>            
29018>>>>>>>        End
29018>>>>>>>>
29018>>>>>>>        
29018>>>>>>>        If (eStateMode <> vsmOff) Begin
29020>>>>>>>            Get AppendStateHash of (Host(Self)) sInvokingHash sViewHash to sHash
29021>>>>>>>        End
29021>>>>>>>>
29021>>>>>>>        Else Begin
29022>>>>>>>            Move sInvokingHash to sHash
29023>>>>>>>        End
29023>>>>>>>>
29023>>>>>>>        
29023>>>>>>>        Function_Return sHash
29024>>>>>>>    End_Function
29025>>>>>>>    
29025>>>>>>>
29025>>>>>>>    // Restores the view state for desktop style by performing a find if needed.
29025>>>>>>>    //
29025>>>>>>>    // Params:
29025>>>>>>>    //      sRecordId       Record id.
29025>>>>>>>    //      bManualEnter    True if the state was changed manually so a find should be done (the
29025>>>>>>>    //                      back button won't cause a find on desktop-style).
29025>>>>>>>    Procedure RestoreViewState_Desktop String sRecordId Boolean bManualEnter
29027>>>>>>>        String sRowId
29027>>>>>>>        Integer iPos
29027>>>>>>>        Handle hoMain
29027>>>>>>>        RowID rRowId
29027>>>>>>>        Boolean bValid
29027>>>>>>>        
29027>>>>>>>        If (pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
29029>>>>>>>            If (bManualEnter) Begin
29031>>>>>>>                Get Main_DD to hoMain
29032>>>>>>>                
29032>>>>>>>                If (hoMain > 0) Begin
29034>>>>>>>                    Get HashRecordIdToRowId (Main_File(hoMain)) sRecordId (&rRowId) to bValid  
29035>>>>>>>                    If (bValid and not(IsSameRowID(CurrentRowId(hoMain), rRowId))) Begin
29037>>>>>>>                        Send FindByRowId of hoMain (Main_File(hoMain)) rRowId
29038>>>>>>>                    End
29038>>>>>>>>
29038>>>>>>>                    Else If (not(bValid)) Begin
29041>>>>>>>                        
29041>>>>>>>                        If (pbStateHashInvalidError(Host(Self))) Begin
29043>>>>>>>                            Error DFERR_WEBAPP_INVALID_URL_REC
29044>>>>>>>>
29044>>>>>>>                        End
29044>>>>>>>>
29044>>>>>>>                        Send Clear of hoMain
29045>>>>>>>                    End
29045>>>>>>>>
29045>>>>>>>                End
29045>>>>>>>>
29045>>>>>>>            End
29045>>>>>>>>
29045>>>>>>>            Else Begin
29046>>>>>>>                Send UpdateStateHash True
29047>>>>>>>            End
29047>>>>>>>>
29047>>>>>>>        End
29047>>>>>>>>
29047>>>>>>>    End_Procedure
29048>>>>>>>    
29048>>>>>>>    
29048>>>>>>>    // Generates the view state hash for desktop-style.
29048>>>>>>>    //
29048>>>>>>>    // Returns:
29048>>>>>>>    //      View state string.
29048>>>>>>>    Function GenerateStateHash_Desktop Returns String
29050>>>>>>>        String sState sName sCustom sRowId sRecordId
29050>>>>>>>        Handle hoMain
29050>>>>>>>        RowID rRowId
29050>>>>>>>        Integer eStateMode
29050>>>>>>>        
29050>>>>>>>        Get peStateMode to eStateMode
29051>>>>>>>        
29051>>>>>>>        If (eStateMode = vsmOff) Begin
29053>>>>>>>            Function_Return ""
29054>>>>>>>        End
29054>>>>>>>>
29054>>>>>>>        
29054>>>>>>>        If ((eStateMode = vsmDefault or eStateMode = vsmRecord) and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
29056>>>>>>>            Get Main_DD to hoMain
29057>>>>>>>            If (hoMain > 0) Begin
29059>>>>>>>                Get CurrentRowId of hoMain to rRowId
29060>>>>>>>                
29060>>>>>>>                Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sRecordId
29061>>>>>>>            End
29061>>>>>>>>
29061>>>>>>>        End
29061>>>>>>>>
29061>>>>>>>        
29061>>>>>>>        Get psStateViewName to sName
29062>>>>>>>        
29062>>>>>>>        Send OnDefineCustomStateHash (&sCustom)
29063>>>>>>>        
29063>>>>>>>        Get ConcatViewStateHash of (Host(Self)) sName sRecordId sCustom to sState
29064>>>>>>>        
29064>>>>>>>        Function_Return sState
29065>>>>>>>    End_Function
29066>>>>>>>    
29066>>>>>>>    
29066>>>>>>>    // Generates the current state hash for this view.
29066>>>>>>>    //
29066>>>>>>>    // Returns:
29066>>>>>>>    //      State hash for this view (for drill-down this includes invoking view hashes).
29066>>>>>>>    Function GenerateStateHash Returns String
29068>>>>>>>        Integer eViewStyle
29068>>>>>>>        String sResult
29068>>>>>>>        
29068>>>>>>>        Get peWebViewStyle to eViewStyle
29069>>>>>>>        If (eViewStyle = wvsDesktop) Begin
29071>>>>>>>            Get GenerateStateHash_Desktop to sResult    
29072>>>>>>>        End
29072>>>>>>>>
29072>>>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
29075>>>>>>>            Get GenerateStateHash_DrillDown to sResult
29076>>>>>>>        End
29076>>>>>>>>
29076>>>>>>>        
29076>>>>>>>        Function_Return sResult
29077>>>>>>>    End_Function
29078>>>>>>>    
29078>>>>>>>    // Updates the page title with the current view title (if pbUpdateApplicationTitle of cWebApp 
29078>>>>>>>    // is true).
29078>>>>>>>    Procedure UpdatePageTitle
29080>>>>>>>        String sViewTitle
29080>>>>>>>        Boolean bUpdate
29080>>>>>>>        
29080>>>>>>>        WebGet pbUpdateApplicationTitle of (Host(Self)) to bUpdate
29081>>>>>>>        
29081>>>>>>>        If (bUpdate) Begin
29083>>>>>>>            If (peWebViewStyle(Self) = wvsDrillDown) Begin
29085>>>>>>>                Get GetHeaderCaption to sViewTitle
29086>>>>>>>            End
29086>>>>>>>>
29086>>>>>>>            Else Begin
29087>>>>>>>                WebGet psCaption to sViewTitle
29088>>>>>>>            End
29088>>>>>>>>
29088>>>>>>>            
29088>>>>>>>            Send UpdatePageTitle of (Host(Self)) Self sViewTitle
29089>>>>>>>        End    
29089>>>>>>>>
29089>>>>>>>    End_Procedure
29090>>>>>>>    
29090>>>>>>>    
29090>>>>>>>    // Default refresh logic that updates the state hash when the record changes.
29090>>>>>>>    // 
29090>>>>>>>    // Params:
29090>>>>>>>    //      eMode   The refresh mode.
29090>>>>>>>    Procedure Refresh Integer eMode
29092>>>>>>>        String sName sHash sView 
29092>>>>>>>        Integer eViewType eViewStyle eStateMode iIndex
29092>>>>>>>        tWebNavigateData navData
29092>>>>>>>        tWebNavigateData navData
29092>>>>>>>        
29092>>>>>>>        Forward Send Refresh eMode
29094>>>>>>>                
29094>>>>>>>        // if application style is wvsNone it is a basic non-framework application that does handle web-views at
29094>>>>>>>        // all - refresh should do nothing. This allows web lookups to get added to a basic webapp. While
29094>>>>>>>        // compiled, we don't want to use them.        
29094>>>>>>>        If (peApplicationStyle(Host(Self)) = wvsNone or peApplicationStateMode(Host(Self)) = asmOff) ;            Procedure_Return
29097>>>>>>>        
29097>>>>>>>        If (not(AppSynching(Owner(Self)))) Begin
29099>>>>>>>            If (phoLoadView(Host(Self)) <> Self and phoCurrentShowView(Host(Self)) <> Self and not(pbNavigating(Self)) and not(pbInitForShow(Self))) Begin
29101>>>>>>>                Get peViewType to eViewType
29102>>>>>>>                Get peWebViewStyle to eViewStyle
29103>>>>>>>                Get peStateMode to eStateMode
29104>>>>>>>                
29104>>>>>>>                If (eViewStyle = wvsDrillDown) Begin
29106>>>>>>>                    If (eStateMode = vsmRecord or (eViewStyle = wvsDrillDown and eViewType = vtZoom and eStateMode = vsmDefault)) Begin
29108>>>>>>>                        //  Check if still initializing (we can't check if the name is in the URL because the statehash might not be up-to-date)
29108>>>>>>>                        Get GetNavigateData to navData
29109>>>>>>>                        Get NamedValueIndex navData.NamedValues "Init_Mode" to iIndex
29110>>>>>>>                        If (iIndex < 0) Begin
29112>>>>>>>                            Send UpdateStateHash True
29113>>>>>>>                        End
29113>>>>>>>>
29113>>>>>>>                    End
29113>>>>>>>>
29113>>>>>>>                End
29113>>>>>>>>
29113>>>>>>>                Else Begin
29114>>>>>>>                    If (eStateMode = vsmRecord or (eStateMode = vsmDefault and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self))) Begin
29116>>>>>>>                        Get psStateViewName to sName
29117>>>>>>>                        Get StateHash of (Host(Self)) to sHash
29118>>>>>>>                        Send ParseViewStateHash sHash (&sView)        
29119>>>>>>>                        
29119>>>>>>>                        If (lowercase(sName) = Lowercase(sView)) Begin
29121>>>>>>>                            Send UpdateStateHash True
29122>>>>>>>                        End
29122>>>>>>>>
29122>>>>>>>                    End
29122>>>>>>>>
29122>>>>>>>                End
29122>>>>>>>>
29122>>>>>>>            End
29122>>>>>>>>
29122>>>>>>>        End
29122>>>>>>>>
29122>>>>>>>    End_Procedure
29123>>>>>>>    
29123>>>>>>>    
29123>>>>>>>    // This is an event hook sent to a view during NavigateForward. 
29123>>>>>>>    // You can augment this event to modify the view based on the 
29123>>>>>>>    // navigation context that is passed in the NavigateData parameter.
29123>>>>>>>    //
29123>>>>>>>    // You would typically use this event when a view is re-used in 
29123>>>>>>>    // different contexts within your application and you would like 
29123>>>>>>>    // to modify the appearance and features of the view accordingly.
29123>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
29125>>>>>>>    End_Procedure
29126>>>>>>>    
29126>>>>>>>    // Callback handler for the Show function used when navigating into a desktop view with the 
29126>>>>>>>    // drilldown model. It adds the view to the stack, now that we know for sure that it is in sync.
29126>>>>>>>    Procedure Show_CallBack Handle hoView
29128>>>>>>>        Send PushView to (ViewStack(Self)) hoView nfUndefined
29129>>>>>>>    End_Procedure
29130>>>>>>>
29130>>>>>>>    // This is overridden to handle desktop and drill down views.
29130>>>>>>>    // 1. if this is a dialog or if there is no stack, it just does a normal show
29130>>>>>>>    // dfirst Clear the view stack down as far as the default
29130>>>>>>>    // view, then load this view.
29130>>>>>>>    //
29130>>>>>>>    // Note: Augmenting this here means two things:
29130>>>>>>>    // 1. The application already supports the View Stack (drill-down)
29130>>>>>>>    // 2. That the Show command in the superclass does -not- try to manipulate the view stack.  
29130>>>>>>>    Procedure Show
29132>>>>>>>        Handle hoDefaultView hoTopView
29132>>>>>>>        Integer eWebViewStyle
29132>>>>>>>        Boolean bOK bUnconditional
29132>>>>>>>        Get peWebViewStyle to eWebViewStyle
29133>>>>>>>        If ((ViewStack(Self))=0 or eWebViewStyle=wvsDialog) Begin
29135>>>>>>>            Forward Send Show
29137>>>>>>>        End
29137>>>>>>>>
29137>>>>>>>        Else If (eWebViewStyle = wvsDesktop) Begin
29140>>>>>>>            Get GetDefaultView to hoDefaultView
29141>>>>>>>            Get TopViewHandle of (ViewStack(Self)) to hoTopView
29142>>>>>>>            Move (hoTopView=0 or peWebViewStyle(hoTopView)=wvsDesktop) to bUnconditional
29143>>>>>>>            Get Reset of (ViewStack(Self)) True bUnconditional to bOK
29144>>>>>>>            If bOK Begin
29146>>>>>>>                // if a non-drilldown just show and add to view stack
29146>>>>>>>                Send SetInvokingObject 0
29147>>>>>>>                Send ShowView to (Host(Self)) Self (RefProc(Show_CallBack)) Self
29148>>>>>>>            End
29148>>>>>>>>
29148>>>>>>>        End
29148>>>>>>>>
29148>>>>>>>        // moving to a drill down view - same as NavigateBegin
29148>>>>>>>        Else Begin
29149>>>>>>>            Send NavigatePathBegin Self False
29150>>>>>>>        End
29150>>>>>>>>
29150>>>>>>>    End_Procedure
29151>>>>>>>
29151>>>>>>>
29151>>>>>>>    // Send this to update psInvokingView of this view to the name of the next view down
29151>>>>>>>    // in the view stack. Also, psInvokingView of this next view down is set to "".
29151>>>>>>>    // This ensures that Only to top view in the view stack and its invoking view are synchronized.
29151>>>>>>>    // The view that receives this message should be the top view in the view stack. 
29151>>>>>>>    Procedure UpdateInvokingViewDrillDownStyle
29153>>>>>>>        Handle hoInvokingView
29153>>>>>>>        String sInvokingView
29153>>>>>>>        
29153>>>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView
29154>>>>>>>        
29154>>>>>>>        If (hoInvokingView = 0) Begin
29156>>>>>>>            Move "" to sInvokingView
29157>>>>>>>        End
29157>>>>>>>>
29157>>>>>>>        Else Begin
29158>>>>>>>            Get WebObjectName of hoInvokingView to sInvokingView
29159>>>>>>>            WebSet psInvokingView of hoInvokingView to ""
29160>>>>>>>        End
29160>>>>>>>>
29160>>>>>>>        
29160>>>>>>>        WebSet psInvokingView to sInvokingView
29161>>>>>>>    End_Procedure
29162>>>>>>>    
29162>>>>>>>    //  Empty stub of cWebModalDialog API to prevent issues when delegating this message from controls (cWebPromptList).
29162>>>>>>>    Procedure NotifyCloseModalDialog
29164>>>>>>>    End_Procedure
29165>>>>>>>    
29165>>>>>>>    //  Empty stub of cWebModalDialog API to prevent issues when delegating this message from controls (cWebPromptList).
29165>>>>>>>    Function ReturnObject Returns Handle
29167>>>>>>>        Function_Return C_WebUnresolvedObject
29168>>>>>>>    End_Function
29169>>>>>>>    
29169>>>>>>>    
29169>>>>>>>    // hook called during End_Construct_Object that provides developer a way
29169>>>>>>>    // to customize any properties based on peWebViewStyle. To be used in a 
29169>>>>>>>    // sub-class or object. 
29169>>>>>>>    Procedure OnCustomizeWebViewStyle
29171>>>>>>>    End_Procedure
29172>>>>>>>    
29172>>>>>>>    Procedure PostSerializeObject
29174>>>>>>>        //  Assing key handlers
29174>>>>>>>        Send DefaultKeyHandlers
29175>>>>>>>    End_Procedure
29176>>>>>>>    
29176>>>>>>>    // Hides all active dialogs
29176>>>>>>>    Procedure HideAllDialogs
29178>>>>>>>        Handle hoView
29178>>>>>>>        String sInvokingView
29178>>>>>>>        Integer eViewStyle iCount
29178>>>>>>>        tWebViewInfo[] aViewStack
29178>>>>>>>        tWebViewInfo[] aViewStack
29179>>>>>>>        
29179>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29180>>>>>>>        // We start from the 2nd last element going down
29180>>>>>>>        Move (SizeOfArray(aViewStack)-1) to iCount
29181>>>>>>>        
29181>>>>>>>        While (iCount <> 0)
29185>>>>>>>            Get WebObjectByName aViewStack[iCount].sViewName False to hoView
29186>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29187>>>>>>>            //If the previous view isnt a dialog we can stop looking back
29187>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29189>>>>>>>                Procedure_Return
29190>>>>>>>            End
29190>>>>>>>>
29190>>>>>>>            
29190>>>>>>>            Send Hide of hoView
29191>>>>>>>            
29191>>>>>>>            Decrement iCount
29192>>>>>>>        Loop
29193>>>>>>>>
29193>>>>>>>    End_Procedure
29194>>>>>>>    
29194>>>>>>>    // Shows a dialog again. It does this by showing All the previous dialogs in the viewstack up untill the first actual view.
29194>>>>>>>    Procedure RestoreDialog
29196>>>>>>>        Handle hoView hoNextView
29196>>>>>>>        String sViewName
29196>>>>>>>        Integer eViewStyle iIndex iCount iViewsInStack iAmountOfViewsToShow
29196>>>>>>>        Handle[] aViewsToShow
29197>>>>>>>        Boolean bFirstNonDialogView
29197>>>>>>>        tWebViewInfo[] aViewStack
29197>>>>>>>        tWebViewInfo[] aViewStack
29198>>>>>>>        tWebViewInfo searchStack
29198>>>>>>>        tWebViewInfo searchStack
29198>>>>>>>        
29198>>>>>>>        Get psStateViewName to sViewName
29199>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
29200>>>>>>>        Move sViewName to searchStack.sViewName        
29201>>>>>>>        Move (SearchArray(searchStack, aViewStack)) to iIndex
29202>>>>>>>        Move Self to aViewsToShow[-1]
29203>>>>>>>        
29203>>>>>>>        // This should never be possible
29203>>>>>>>        If (iIndex = -1) Begin
29205>>>>>>>            Procedure_Return
29206>>>>>>>        End
29206>>>>>>>>
29206>>>>>>>        
29206>>>>>>>        //Start going down the viewstack, and start showing each view that isnt a drill down view.
29206>>>>>>>        While (not(bFirstNonDialogView))
29210>>>>>>>            Decrement iIndex
29211>>>>>>>            Get FindWebObject of (Owner(Self)) aViewStack[iIndex].sViewName to hoView
29212>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
29213>>>>>>>            Move (InsertInArray(aViewsToShow, 0, hoView)) to aViewsToShow
29214>>>>>>>            
29214>>>>>>>            If (eViewStyle <> wvsDialog) Begin
29216>>>>>>>                Move True to bFirstNonDialogView
29217>>>>>>>            End
29217>>>>>>>>
29217>>>>>>>        Loop
29218>>>>>>>>
29218>>>>>>>        
29218>>>>>>>        //Now loop through the array of views we should be showing
29218>>>>>>>        Move (SizeOfArray(aViewsToShow)-1) to iAmountOfViewsToShow
29219>>>>>>>        For iCount from 0 to iAmountOfViewsToShow
29225>>>>>>>>
29225>>>>>>>            Send ShowView to (Host(Self)) aViewsToShow[iCount]
29226>>>>>>>        Loop
29227>>>>>>>>
29227>>>>>>>    End_Procedure
