55793>>>>>    // Enumerates the psDataPath to find the table and returns the path if present.
55793>>>>>    Function FindTablePath String sTableName Returns String
55795>>>>>        Handle hoWorkspace
55795>>>>>        Integer iDataPaths iDataPath
55795>>>>>        String sDataPaths sDataPath sTestTableName
55795>>>>>        Boolean bFileExists
55795>>>>>
55795>>>>>        If (ghoApplication > 0) Begin
55797>>>>>            Get phoWorkspace of ghoApplication to hoWorkspace
55798>>>>>            If (hoWorkspace > 0) Begin
55800>>>>>                Get psDataPath of hoWorkspace to sDataPaths
55801>>>>>                Get CountOfPaths of hoWorkspace sDataPaths to iDataPaths
55802>>>>>                For iDataPath from 1 to iDataPaths
55808>>>>>>
55808>>>>>                    Get PathAtIndex of hoWorkspace sDataPaths iDataPath to sDataPath
55809>>>>>                    Move (Trim (sDataPath)) to sDataPath
55810>>>>>                    If (Right (sDataPath, 1) <> SysConf (SYSCONF_DIR_SEPARATOR)) Begin
55812>>>>>                        Move (sDataPath - SysConf (SYSCONF_DIR_SEPARATOR)) to sDataPath
55813>>>>>                    End
55813>>>>>>
55813>>>>>                    Move (sDataPath - sTableName) to sTestTableName
55814>>>>>                    File_Exist sTestTableName bFileExists
55815>>>>>                    If (bFileExists) Begin
55817>>>>>                        Function_Return sTestTableName
55818>>>>>                    End
55818>>>>>>
55818>>>>>                Loop
55819>>>>>>
55819>>>>>            End
55819>>>>>>
55819>>>>>        End
55819>>>>>>
55819>>>>>
55819>>>>>        Function_Return ""
55820>>>>>    End_Function
