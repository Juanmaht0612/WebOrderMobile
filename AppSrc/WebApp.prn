57563>>>>>            Case (iLanguage = LANG_URDU)
57566>>>>>                Move "Urdu" to sLanguage
57567>>>>>                Case Break
57568>>>>>            Case (iLanguage = LANG_UZBEK)
57571>>>>>                Move "Uzbek" to sLanguage
57572>>>>>                Case Break
57573>>>>>            Case (iLanguage = LANG_VIETNAMESE)
57576>>>>>                Move "Vietnamese" to sLanguage
57577>>>>>                Case Break
57578>>>>>            Case Else
57578>>>>>                Move "Unknown" to sLanguage
57579>>>>>                Case Break
57580>>>>>        Case End
57580>>>>>
57580>>>>>        Function_Return sLanguage
57581>>>>>    End_Function
