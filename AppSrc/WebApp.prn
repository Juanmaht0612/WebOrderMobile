23861>>>>>>>>>>>>>>>>>>>    // This procedure adds the specified object id (hoServer) to this object's
23861>>>>>>>>>>>>>>>>>>>    // set of database agents who are merely 'watched', and establishes a
23861>>>>>>>>>>>>>>>>>>>    // connection between the database agent and this object.
23861>>>>>>>>>>>>>>>>>>>    //
23861>>>>>>>>>>>>>>>>>>>    Procedure Add_Watched_Server Integer hoServer
23863>>>>>>>>>>>>>>>>>>>        Integer iIndex
23863>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23863>>>>>>>>>>>>>>>>>>>        
23863>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23864>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23866>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23867>>>>>>>>>>>>>>>>>>>            Set Watched_Servers to hoWatchedServers
23868>>>>>>>>>>>>>>>>>>>        End
23868>>>>>>>>>>>>>>>>>>>>
23868>>>>>>>>>>>>>>>>>>>        
23868>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23869>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23870>>>>>>>>>>>>>>>>>>>        
23870>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23872>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23873>>>>>>>>>>>>>>>>>>>        End
23873>>>>>>>>>>>>>>>>>>>>
23873>>>>>>>>>>>>>>>>>>>        
23873>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23874>>>>>>>>>>>>>>>>>>>        
23874>>>>>>>>>>>>>>>>>>>        If (iIndex < 0 and Active_State(Self)) Begin
23876>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self True // TRUE for watchers
23877>>>>>>>>>>>>>>>>>>>        End
23877>>>>>>>>>>>>>>>>>>>>
23877>>>>>>>>>>>>>>>>>>>    End_Procedure
23878>>>>>>>>>>>>>>>>>>>    
23878>>>>>>>>>>>>>>>>>>>    Procedure Add_ChangedStateWatched_Server Integer hoServer
23880>>>>>>>>>>>>>>>>>>>        Integer iIndex
23880>>>>>>>>>>>>>>>>>>>        Handle hoWatchedServers
23880>>>>>>>>>>>>>>>>>>>        
23880>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23881>>>>>>>>>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
23883>>>>>>>>>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
23884>>>>>>>>>>>>>>>>>>>            Set ChangedStateWatched_Servers to hoWatchedServers
23885>>>>>>>>>>>>>>>>>>>        End
23885>>>>>>>>>>>>>>>>>>>>
23885>>>>>>>>>>>>>>>>>>>        
23885>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
23886>>>>>>>>>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
23887>>>>>>>>>>>>>>>>>>>        
23887>>>>>>>>>>>>>>>>>>>        If (iIndex < 0) Begin
23889>>>>>>>>>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
23890>>>>>>>>>>>>>>>>>>>        End
23890>>>>>>>>>>>>>>>>>>>>
23890>>>>>>>>>>>>>>>>>>>        
23890>>>>>>>>>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
23891>>>>>>>>>>>>>>>>>>>    End_Procedure
23892>>>>>>>>>>>>>>>>>>>    
23892>>>>>>>>>>>>>>>>>>>    
23892>>>>>>>>>>>>>>>>>>>    // Expects the class to understand the Active_State property. Relies on the pbDataBindable interface.
23892>>>>>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
23894>>>>>>>>>>>>>>>>>>>        Integer iFile iField
23894>>>>>>>>>>>>>>>>>>>        Boolean bDataBindable bServerScan
23894>>>>>>>>>>>>>>>>>>>        Handle hoServer hoFileDDO hoWatchedServers
23894>>>>>>>>>>>>>>>>>>>        
23894>>>>>>>>>>>>>>>>>>>        Get Server to hoServer
23895>>>>>>>>>>>>>>>>>>>        Get Data_File  to iFile
23896>>>>>>>>>>>>>>>>>>>        Get Data_Field to iField
23897>>>>>>>>>>>>>>>>>>>        Get pbDataBindable to bDataBindable        
23898>>>>>>>>>>>>>>>>>>>        
23898>>>>>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
23900>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoServer Self
23901>>>>>>>>>>>>>>>>>>>            // Extended_DEO_State is used to determine whether the object receives the data binding related
23901>>>>>>>>>>>>>>>>>>>            // message interface from the server DDO...
23901>>>>>>>>>>>>>>>>>>>            Set Extended_DEO_State to (Extended_DSO_State(hoServer) and bDataBindable)
23902>>>>>>>>>>>>>>>>>>>        End
23902>>>>>>>>>>>>>>>>>>>>
23902>>>>>>>>>>>>>>>>>>>        
23902>>>>>>>>>>>>>>>>>>>        Get private_pbServersScanned to bServerScan
23903>>>>>>>>>>>>>>>>>>>        If (not(bServerScan)) Begin
23905>>>>>>>>>>>>>>>>>>>            Send Scan_Servers
23906>>>>>>>>>>>>>>>>>>>        End
23906>>>>>>>>>>>>>>>>>>>>
23906>>>>>>>>>>>>>>>>>>>        
23906>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23907>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23909>>>>>>>>>>>>>>>>>>>            Send Add_User_Interface to hoWatchedServers Self True // True for watchers
23910>>>>>>>>>>>>>>>>>>>        End
23910>>>>>>>>>>>>>>>>>>>>
23910>>>>>>>>>>>>>>>>>>>        
23910>>>>>>>>>>>>>>>>>>>        Set Active_State to True
23911>>>>>>>>>>>>>>>>>>>    End_Procedure
23912>>>>>>>>>>>>>>>>>>>    
23912>>>>>>>>>>>>>>>>>>>    // Changed so that this respects Change_disabled_state. I don't
23912>>>>>>>>>>>>>>>>>>>    // like this here but its the best I can think of. Therefore, all
23912>>>>>>>>>>>>>>>>>>>    // objects using server.pkg must understand Change_disabled_state.
23912>>>>>>>>>>>>>>>>>>>    //
23912>>>>>>>>>>>>>>>>>>>    // Changed to not remove from server if static.
23912>>>>>>>>>>>>>>>>>>>    Procedure Set Changed_State Integer newVal
23914>>>>>>>>>>>>>>>>>>>        Integer hoServer hoWatchedServers
23914>>>>>>>>>>>>>>>>>>>        
23914>>>>>>>>>>>>>>>>>>>        If not (Change_Disabled_State(Self)) Begin
23916>>>>>>>>>>>>>>>>>>>            Forward Set Changed_State to newVal
23918>>>>>>>>>>>>>>>>>>>            Get server to hoServer
23919>>>>>>>>>>>>>>>>>>>            
23919>>>>>>>>>>>>>>>>>>>            If (newVal and hoServer) Begin
23921>>>>>>>>>>>>>>>>>>>                Set Changed_State of hoServer to True
23922>>>>>>>>>>>>>>>>>>>                // We also set changed_state of all "foreign" servers. These
23922>>>>>>>>>>>>>>>>>>>                // are the ones whose Data_File is a parent File
23922>>>>>>>>>>>>>>>>>>>                Get ChangedStateWatched_Servers to hoWatchedServers
23923>>>>>>>>>>>>>>>>>>>                If hoWatchedServers ;                    Set Changed_State of hoWatchedServers to True
23926>>>>>>>>>>>>>>>>>>>            End
23926>>>>>>>>>>>>>>>>>>>>
23926>>>>>>>>>>>>>>>>>>>        End
23926>>>>>>>>>>>>>>>>>>>>
23926>>>>>>>>>>>>>>>>>>>    End_Procedure
23927>>>>>>>>>>>>>>>>>>>    
23927>>>>>>>>>>>>>>>>>>>    // returns the table's status for the refresh event. A table can either be
23927>>>>>>>>>>>>>>>>>>>    // cleared, found or not touched by the operation. This can only be called while
23927>>>>>>>>>>>>>>>>>>>    // within Refresh. This was created to hide the private is_file_included command
23927>>>>>>>>>>>>>>>>>>>    Function DDRefreshTableStatus Integer iTable Returns Integer
23929>>>>>>>>>>>>>>>>>>>        Boolean bIncluded
23929>>>>>>>>>>>>>>>>>>>        is_file_included iTable 1 to bIncluded // see if main file is in find done array
23931>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23933>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsFound
23934>>>>>>>>>>>>>>>>>>>        End
23934>>>>>>>>>>>>>>>>>>>>
23934>>>>>>>>>>>>>>>>>>>        is_file_included iTable 0 to bIncluded // see if main file is in clear done array
23936>>>>>>>>>>>>>>>>>>>        If bIncluded Begin
23938>>>>>>>>>>>>>>>>>>>            Function_Return ddrtsCleared
23939>>>>>>>>>>>>>>>>>>>            
23939>>>>>>>>>>>>>>>>>>>        End
23939>>>>>>>>>>>>>>>>>>>>
23939>>>>>>>>>>>>>>>>>>>        Function_Return ddrtsNone
23940>>>>>>>>>>>>>>>>>>>    End_Function
23941>>>>>>>>>>>>>>>>>>>    
23941>>>>>>>>>>>>>>>>>>>    //   This procedure empties the Watched_Servers broadcaster, after
23941>>>>>>>>>>>>>>>>>>>    //   detaching this object from all of the broadcaster's elements.
23941>>>>>>>>>>>>>>>>>>>    //   This procedure is invoked by Find_Servers_to_Watch, in preparation
23941>>>>>>>>>>>>>>>>>>>    //   for a scan.
23941>>>>>>>>>>>>>>>>>>>    Procedure Delete_Watched_Servers
23943>>>>>>>>>>>>>>>>>>>        Integer hoWatchedServers
23943>>>>>>>>>>>>>>>>>>>        
23943>>>>>>>>>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
23944>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23946>>>>>>>>>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // detach from all, TRUE for watchers
23947>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23948>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23949>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23950>>>>>>>>>>>>>>>>>>>        End
23950>>>>>>>>>>>>>>>>>>>>
23950>>>>>>>>>>>>>>>>>>>        
23950>>>>>>>>>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
23951>>>>>>>>>>>>>>>>>>>        If hoWatchedServers Begin
23953>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
23954>>>>>>>>>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
23955>>>>>>>>>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
23956>>>>>>>>>>>>>>>>>>>        End
23956>>>>>>>>>>>>>>>>>>>>
23956>>>>>>>>>>>>>>>>>>>    End_Procedure
