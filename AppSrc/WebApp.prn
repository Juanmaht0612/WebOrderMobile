40218>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
40221>>>        String sTask
40221>>>        Boolean bFound
40221>>>        // turns all buttons on
40221>>>        WebSet pbRender of oNewButton to True
40222>>>        WebSet pbRender of oDetailButton to True
40223>>>        Send SetBreadcrumbCaption "Select Customer"
40224>>>        Send SetHeaderCaption     "Customers"
40225>>>        
40225>>>        Case Begin
40225>>>            Case (NavigateData.eNavigateType = nfFromMain)
40227>>>                // a main-file lookup
40227>>>                // not used yet
40227>>>                WebSet pbRender of oNewButton to False
40228>>>                WebSet pbRender of oDetailButton to False
40229>>>                Case Break
40230>>>            Case (NavigateData.eNavigateType = nfFromChild)
40233>>>                // a parent lookup
40233>>>                Case Break
40234>>>            Case (NavigateData.eNavigateType = nfFromParent)
40237>>>                // A parent query
40237>>>                // not used yet
40237>>>                Case Break
40238>>>            Case Else
40238>>>                // either a start of a drill down query or a main file query
40238>>>                Get NamedValueGet NavigateData.NamedValues "task" to sTask
40239>>>                If (sTask="maint") Begin
40241>>>                    // main file query
40241>>>                    WebSet pbRender of oDetailButton to False
40242>>>                End
40242>>>>
40242>>>        Case End
40242>>>    End_Procedure
