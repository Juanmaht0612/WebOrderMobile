34028>>>>>>>        // Tests psLoadViewOnClick. If Set the view is looked up and AllowAccess is queried.
34028>>>>>>>        // The result of the AllowAccess is used to enable/disable items in SetMenuViewAccess.
34028>>>>>>>        String sViewName sObjectLabel sCRLF
34028>>>>>>>        Handle hoView
