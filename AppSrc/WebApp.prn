37432>>>>>>>    Procedure QueryLocation_Callback String sCallbackMsg String sCallbackObj Integer iErr String sLatitude String sLongitude String sAccuracy String sSpeed String sHeading
37434>>>>>>>        Number nLatitude nLongitude nAccuracy nSpeed nHeading
37434>>>>>>>        Handle hoCallback hmCallback
37434>>>>>>>        
37434>>>>>>>        //  Values are passed in fixed format so convert without localization
37434>>>>>>>        CvtLocalization Off
37435>>>>>>>        Move sLatitude to nLatitude
37436>>>>>>>        Move sLongitude to nLongitude
37437>>>>>>>        Move sAccuracy to nAccuracy
37438>>>>>>>        Move sSpeed to nSpeed
37439>>>>>>>        Move sHeading to nHeading
37440>>>>>>>        CvtLocalization On
37441>>>>>>>        
37441>>>>>>>        Get WebObjectByName sCallbackObj to hoCallback
37442>>>>>>>        If (hoCallback <> C_WebUnresolvedObject) Begin
37444>>>>>>>            Get WebMethodByName of hoCallback sCallbackMsg to hmCallback
37445>>>>>>>            
37445>>>>>>>            If (hmCallback <> C_WebUnresolvedObject) Begin
37447>>>>>>>                Send hmCallback of hoCallback iErr nLatitude nLongitude nAccuracy nSpeed nHeading
37448>>>>>>>            End
37448>>>>>>>>
37448>>>>>>>        End
37448>>>>>>>>
37448>>>>>>>    End_Procedure
