21093>>>>>>>>>    // Client Actions: Sends an error to the client so it can be displayed.
21093>>>>>>>>>    Procedure ShowError Integer iErrNum Integer iErrLine String sErrText String sCaption Boolean bUserError
21095>>>>>>>>>        String[] aParams
21096>>>>>>>>>        
21096>>>>>>>>>        Move iErrNum    to aParams[0]
21097>>>>>>>>>        Move iErrLine   to aParams[1]
21098>>>>>>>>>        Move sErrText   to aParams[2]
21099>>>>>>>>>        Move sCaption   to aParams[3]
21100>>>>>>>>>        Move bUserError to aParams[4]
21101>>>>>>>>>        
21101>>>>>>>>>        Send ClientAction "showError" aParams
