20317>>>>>>>>>>>/*Defines the API used by radio's to register themselves to their container. Used by cWebWindow and cLocalWebControlHost.  */
20317>>>>>>>>>>>Class cWebRadioContainer_mixin is a Mixin
20318>>>>>>>>>>>      
20318>>>>>>>>>>>    Procedure Define_cWebRadioContainer_mixin
20320>>>>>>>>>>>        Property tWebRadioGroup[] paRadioGroups   // collection of radio button groups in this View\Dialog 
20321>>>>>>>>>>>        Property String[] paRadioGroupNames       // searchable array of group names that are stored in paRagioGroups. One member of paRadioGroups exists for each paRadioGroupNames
20322>>>>>>>>>>>    End_Procedure
20323>>>>>>>>>>>    
20323>>>>>>>>>>>    
20323>>>>>>>>>>>    Procedure AddRadio Handle hoRadio
20325>>>>>>>>>>>        // Radio Button Helper:
20325>>>>>>>>>>>        //
20325>>>>>>>>>>>        // Registers the passed cWebRadio object. The object's group is determined and the radio
20325>>>>>>>>>>>        // is registered with the rest of the objects in that group. If this is the first radio
20325>>>>>>>>>>>        // object in the group then it will become the "master" radio object for that group.
20325>>>>>>>>>>>        String sGroupName
20325>>>>>>>>>>>        Integer iGroup icGroup icRadio
20325>>>>>>>>>>>        String[] aRadioGroupNames
20326>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20326>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20327>>>>>>>>>>>        
20327>>>>>>>>>>>        Get psGroupName of hoRadio to sGroupName
20328>>>>>>>>>>>        Get paRadioGroups to aRadioGroups
20329>>>>>>>>>>>        Get paRadioGroupNames to aRadioGroupNames
20330>>>>>>>>>>>        
20330>>>>>>>>>>>        // Is this a new group?....
20330>>>>>>>>>>>        Move (SearchArray(sGroupName, aRadioGroupNames, Desktop, RefFunc(DFSTRICMP))) to iGroup   // case insensitive search
20331>>>>>>>>>>>        
20331>>>>>>>>>>>        If (iGroup = -1) Begin
20333>>>>>>>>>>>            // Create a new group amd make this radio button the master....
20333>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups)) to icGroup
20334>>>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].hoMaster
20335>>>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].aRadioButtons[0]
20336>>>>>>>>>>>            Move sGroupName to aRadioGroups[icGroup].sGroupName
20337>>>>>>>>>>>            Move sGroupName to aRadioGroupNames[icGroup]
20338>>>>>>>>>>>            
20338>>>>>>>>>>>            // Save the changes....
20338>>>>>>>>>>>            Set paRadioGroups to aRadioGroups
20339>>>>>>>>>>>            Set paRadioGroupNames to aRadioGroupNames
20340>>>>>>>>>>>        End
20340>>>>>>>>>>>>
20340>>>>>>>>>>>        Else Begin
20341>>>>>>>>>>>            // Add this radio to the existing group....
20341>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
20342>>>>>>>>>>>            Move hoRadio to aRadioGroups[iGroup].aRadioButtons[icRadio]
20343>>>>>>>>>>>            
20343>>>>>>>>>>>            // Save the changes....
20343>>>>>>>>>>>            Set paRadioGroups to aRadioGroups
20344>>>>>>>>>>>        End
20344>>>>>>>>>>>>
20344>>>>>>>>>>>    End_Procedure
20345>>>>>>>>>>>    
20345>>>>>>>>>>>    
20345>>>>>>>>>>>    Procedure ConnectRadioButtons
20347>>>>>>>>>>>        // Radio button Helper:
20347>>>>>>>>>>>        //
20347>>>>>>>>>>>        // Iterate all of the registered radio groups and connect the cWebRadio objects to their master
20347>>>>>>>>>>>        // radio buttons.
20347>>>>>>>>>>>        String sValue sTemp sMaster
20347>>>>>>>>>>>        Handle hoRadio
20347>>>>>>>>>>>        Integer iGroup icGroup 
20347>>>>>>>>>>>        Integer iRadio icRadio
20347>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20347>>>>>>>>>>>        tWebRadioGroup[] aRadioGroups
20348>>>>>>>>>>>        
20348>>>>>>>>>>>        Get paRadioGroups to aRadioGroups
20349>>>>>>>>>>>        Move (SizeOfArray(aRadioGroups)) to icGroup
20350>>>>>>>>>>>        
20350>>>>>>>>>>>        For iGroup from 0 to (icGroup-1)
20356>>>>>>>>>>>>
20356>>>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
20357>>>>>>>>>>>            Move "" to sValue
20358>>>>>>>>>>>            Get WebObjectName of aRadioGroups[iGroup].hoMaster to sMaster 
20359>>>>>>>>>>>            
20359>>>>>>>>>>>            For iRadio from 0 to (icRadio-1)
20365>>>>>>>>>>>>
20365>>>>>>>>>>>                // Set the master radio....
20365>>>>>>>>>>>                Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
20366>>>>>>>>>>>                Set phoMasterRadio of hoRadio to aRadioGroups[iGroup].hoMaster
20367>>>>>>>>>>>                If (hoRadio <> aRadioGroups[iGroup].hoMaster) Begin
20369>>>>>>>>>>>                    Set psMasterName of hoRadio to sMaster
20370>>>>>>>>>>>                End
20370>>>>>>>>>>>>
20370>>>>>>>>>>>                
20370>>>>>>>>>>>                // Get the last non-null psValue setting....
20370>>>>>>>>>>>                Get psValue of hoRadio to sTemp
20371>>>>>>>>>>>                If (sTemp <> "") Begin
20373>>>>>>>>>>>                    Move sTemp to sValue
20374>>>>>>>>>>>                End
20374>>>>>>>>>>>>
20374>>>>>>>>>>>            Loop
20375>>>>>>>>>>>>
20375>>>>>>>>>>>            
20375>>>>>>>>>>>            // If there is no psValue setting then set it to the psRadioValue value of the master radio....
20375>>>>>>>>>>>            If (sValue = "") Begin
20377>>>>>>>>>>>                Get psRadioValue of aRadioGroups[iGroup].hoMaster to sValue
20378>>>>>>>>>>>            End
20378>>>>>>>>>>>>
20378>>>>>>>>>>>            
20378>>>>>>>>>>>            // Synchronize all radios in this group to the same psValue...
20378>>>>>>>>>>>            If (sValue <> "") Begin
20380>>>>>>>>>>>                For iRadio from 0 to (icRadio-1)
20386>>>>>>>>>>>>
20386>>>>>>>>>>>                    Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
20387>>>>>>>>>>>                    Set psValue of hoRadio to sValue
20388>>>>>>>>>>>                Loop
20389>>>>>>>>>>>>
20389>>>>>>>>>>>            End
20389>>>>>>>>>>>>
20389>>>>>>>>>>>        Loop
20390>>>>>>>>>>>>
20390>>>>>>>>>>>    End_Procedure
20391>>>>>>>>>>>End_Class
20392>>>>>>>>>
20392>>>>>>>>>
20392>>>>>>>>>// Basic window container object. Window containers, and their subclasses, encapsulate a basic
20392>>>>>>>>>// unit of a web application, such as a Customer Entry view, etc.
20392>>>>>>>>>//
20392>>>>>>>>>// Adds support for...
20392>>>>>>>>>// - Show & Hide interface,
20392>>>>>>>>>// - Title,
20392>>>>>>>>>// - WBO registration in the global internet session object.
20392>>>>>>>>>Class cWebWindow is a cWebBaseContainer
20393>>>>>>>>>    
20393>>>>>>>>>    Procedure Construct_Object
20395>>>>>>>>>        Forward Send Construct_Object
20397>>>>>>>>>        
20397>>>>>>>>>        // Normally AllowAccess does a login check. You can override this
20397>>>>>>>>>        // by setting this false (e.g. needed for a login dialog)
20397>>>>>>>>>        Property Boolean pbLoginModeEnforced True
20398>>>>>>>>>        
20398>>>>>>>>>        Property Handle phoCommandBar 0           // Handle to child cWebCommandbar object
20399>>>>>>>>>        
20399>>>>>>>>>        // Published properties
20399>>>>>>>>>        Property Boolean pbServerOnHide False     // Set to true to trigger server OnHide event
20402>>>>>>>>>        Property Boolean pbServerOnShow False     // Set to true to trigger server OnShow event
20405>>>>>>>>>        
20405>>>>>>>>>        
20405>>>>>>>>>        Property String psClientOnHide ""         // Name of client side OnHide event handler
20408>>>>>>>>>        Property String psClientOnShow ""         // Name of client side OnShow event handler
20411>>>>>>>>>        Property String psInvokingView ""         // Name of the view object that invoked (activated) this window. Usually this is only set for popup modal windows. (see cWebModalDialog)
20414>>>>>>>>>        Property String psCaption ""              // Is the control's label (see pbShowLabel)
20417>>>>>>>>>        Property Integer pbShowCaption True  //  Allows to hide the captions
20420>>>>>>>>>        
20420>>>>>>>>>        Property Boolean pbFocusFirstOnShow True  // Determines if the view / dialog will take the focus when it is shown
20423>>>>>>>>>        
20423>>>>>>>>>        Property Integer piMaxWidth 0             // Determines the maximum width of a view / panel. Only works if piWidth is 0.
20426>>>>>>>>>        
20426>>>>>>>>>        Property Integer pbOverrideStateOnShow C_WebDefault    //  If set to true a window will become immediately in sync as soon as it is shown and the new state (DDO & Sync Props) will override the eventually existing state on the client
20427>>>>>>>>>        
20427>>>>>>>>>        Set psJSClass to "df.WebWindow"
20428>>>>>>>>>        Set peNeighborhood to nhPublic
20429>>>>>>>>>        
20429>>>>>>>>>        Send Define_cWebRadioContainer_mixin
20430>>>>>>>>>        
20430>>>>>>>>>        // register the view...
20430>>>>>>>>>        Delegate Send OwnerRegisterView Self
