41388>>>>>        Set Field_Label_Short Field OrderDetail.Extended_Price to "Total"
41389>>>>>        Set Field_Mask_Type Field OrderDetail.Extended_Price to MASK_CURRENCY_WINDOW
41390>>>>>        Set Field_Option Field OrderDetail.Extended_Price DD_DISPLAYONLY to True
