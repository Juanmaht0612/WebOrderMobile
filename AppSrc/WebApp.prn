49658>>>    Procedure UpdateFilterableWidgets
49661>>>        Handle hoChild hoWidget hoWidgetContainerInternal
49661>>>        Integer iDynamicObjects iCount iSizeOfArray iPos
49661>>>        String sWidgetName
49661>>>        Boolean bFilterable
49661>>>        tWebDynamicObject[] dynamicObjects
49661>>>        tWebDynamicObject[] dynamicObjects
49662>>>        
49662>>>        Get CurrentActiveInternalWidgetContainer to hoWidgetContainerInternal
49663>>>        WebGet paDynamicObjects of hoWidgetContainerInternal to dynamicObjects
49664>>>        
49664>>>        Move (SizeOfArray(dynamicObjects)-1) to iSizeOfArray
49665>>>        
49665>>>        For iCount from 0 to iSizeOfArray
49671>>>>
49671>>>            Move dynamicObjects[iCount].sId to sWidgetName
49672>>>            Move (Pos(".", sWidgetName)) to iPos
49673>>>            
49673>>>            If (iPos = 0) Begin
49675>>>                Get WidgetInstance of hoWidgetContainerInternal sWidgetName to hoWidget
49676>>>                
49676>>>                If (IsObjectOfClass (hoWidget, (RefClass(cSampleWidget)))) Begin
49678>>>                    Get pbFilterable of hoWidget to bFilterable
49679>>>                    
49679>>>                    If (bFilterable) Begin
49681>>>                        Send Update of hoWidget
49682>>>                    End
49682>>>>
49682>>>                End
49682>>>>
49682>>>            End
49682>>>>
49682>>>        Loop
49683>>>>
49683>>>    End_Procedure
49684>>>    
