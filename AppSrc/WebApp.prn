25892>>>>>>>>>>>
25892>>>>>>>>>>>    // Return the best index for this column. If -1, there is no good index
25892>>>>>>>>>>>
25892>>>>>>>>>>>    Function DefaultIndex Returns Integer
25894>>>>>>>>>>>        Integer iFile iField iMainFile iIndex iFieldIndex
25894>>>>>>>>>>>        Integer iRelField eRequestFindMode
25894>>>>>>>>>>>        Handle hoDDO
25894>>>>>>>>>>>  
25894>>>>>>>>>>>        Get Server to hoDDO
25895>>>>>>>>>>>        Get Data_File  to iFile
25896>>>>>>>>>>>        Get Data_Field to iField
25897>>>>>>>>>>>        
25897>>>>>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
25897>>>>>>>>>>>        If ((hoDDO = 0) or (iFile = 0)) Begin
25899>>>>>>>>>>>            Function_Return -1
25900>>>>>>>>>>>        End
25900>>>>>>>>>>>>
25900>>>>>>>>>>>
25900>>>>>>>>>>>        Get Main_File of hoDDO to iMainFile
25901>>>>>>>>>>>        
25901>>>>>>>>>>>        // we don't use the DD FieldIndex message because it respects a DD Ordering override
25901>>>>>>>>>>>        If (iField>0) Begin
25903>>>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of iFile iField to iFieldIndex
25906>>>>>>>>>>>            Move (If(iFieldIndex=0,-1,iFieldIndex)) to iIndex
25907>>>>>>>>>>>        End
25907>>>>>>>>>>>>
25907>>>>>>>>>>>        Else Begin
25908>>>>>>>>>>>            Move 0 to iIndex // recnum index
25909>>>>>>>>>>>        End
25909>>>>>>>>>>>>
25909>>>>>>>>>>>        
25909>>>>>>>>>>>        If (iFile <> iMainFile and iIndex<>-1) Begin
25911>>>>>>>>>>>            // if field is not main-file, we normally don't sort but we allow
25911>>>>>>>>>>>            // one special mode for prompt lists that sorts on the main-file's
25911>>>>>>>>>>>            // index that relates to this parent
25911>>>>>>>>>>>            Delegate Get peRequestFindMode to eRequestFindMode
25913>>>>>>>>>>>            If (eRequestFindMode<>rfmFindMainSuper) Begin
25915>>>>>>>>>>>                Move -1 to iIndex
25916>>>>>>>>>>>            End
25916>>>>>>>>>>>>
25916>>>>>>>>>>>            Else Begin
25917>>>>>>>>>>>                // if non-main file and super find allowed we check for a super-find path
25917>>>>>>>>>>>                If (iIndex>=0) Begin
25919>>>>>>>>>>>                    // it has an index, now make that there is a relational link
25919>>>>>>>>>>>                    // between the main server file and this parent file. If not, no index
25919>>>>>>>>>>>                    Get RelatingField iFile to iRelField
25920>>>>>>>>>>>                    If (iRelField=-1) Begin
25922>>>>>>>>>>>                        Move -1 to iIndex
25923>>>>>>>>>>>                    End
25923>>>>>>>>>>>>
25923>>>>>>>>>>>                    Else Begin
25924>>>>>>>>>>>                        Get_Attribute DF_FIELD_INDEX of iMainFile iRelField to iIndex
25927>>>>>>>>>>>                    End
25927>>>>>>>>>>>>
25927>>>>>>>>>>>                End
25927>>>>>>>>>>>>
25927>>>>>>>>>>>
25927>>>>>>>>>>>            End
25927>>>>>>>>>>>>
25927>>>>>>>>>>>        End
25927>>>>>>>>>>>>
25927>>>>>>>>>>>        Function_Return iIndex    
25928>>>>>>>>>>>    End_Function
25929>>>>>>>>>>>    
25929>>>>>>>>>>>    
25929>>>>>>>>>>>    // Augmented to apply a pbSortable value for columns that are not already set
25929>>>>>>>>>>>    Procedure Attach_Deo_To_Server
25931>>>>>>>>>>>        Integer iIndex iSortable eDataType eFooterDataType iPrecision iFooterPrecision
25931>>>>>>>>>>>        Boolean bClientSortable
25931>>>>>>>>>>>        String sMask sFooterMask
25931>>>>>>>>>>>
25931>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
25933>>>>>>>>>>>        
25933>>>>>>>>>>>        Get peDataType to eDataType
25934>>>>>>>>>>>        Get peFooterDataType to eFooterDataType
25935>>>>>>>>>>>        If (eFooterDataType = C_WebDefault) Begin
25937>>>>>>>>>>>            Set peFooterDataType to eDataType
25938>>>>>>>>>>>        End
25938>>>>>>>>>>>>
25938>>>>>>>>>>>        
25938>>>>>>>>>>>        Get psMask to sMask
25939>>>>>>>>>>>        Get psFooterMask to sFooterMask
25940>>>>>>>>>>>        If (sFooterMask = "") Begin
25942>>>>>>>>>>>            Set psFooterMask to sMask
25943>>>>>>>>>>>        End
25943>>>>>>>>>>>>
25943>>>>>>>>>>>         
25943>>>>>>>>>>>        Get piPrecision to iPrecision
25944>>>>>>>>>>>        Get piFooterPrecision to iFooterPrecision
25945>>>>>>>>>>>        If (iFooterPrecision = C_WebDefault) Begin
25947>>>>>>>>>>>            Set piFooterPrecision to iPrecision
25948>>>>>>>>>>>        End
25948>>>>>>>>>>>>
25948>>>>>>>>>>>
25948>>>>>>>>>>>        // need to set piDefaultIndex and pbSortable (if not explicitly set)
25948>>>>>>>>>>>        // find out who does the sorting, the client or the server
25948>>>>>>>>>>>        Delegate Get ClientSortable to bClientSortable
25950>>>>>>>>>>>        Get pbSortable to iSortable
25951>>>>>>>>>>>        
25951>>>>>>>>>>>        If (bClientSortable) Begin
25953>>>>>>>>>>>            // if client sorting, we dont care about piDefaultIndex
25953>>>>>>>>>>>            // and if  pbSortable is undefined, true is a good default
25953>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25955>>>>>>>>>>>                Set pbSortable to True
25956>>>>>>>>>>>            End
25956>>>>>>>>>>>>
25956>>>>>>>>>>>        End
25956>>>>>>>>>>>>
25956>>>>>>>>>>>        Else Begin
25957>>>>>>>>>>>            
25957>>>>>>>>>>>            // if server sorting, we will set piDefaultIndex
25957>>>>>>>>>>>            // and if pbSortable is undefined, set it based on having an index
25957>>>>>>>>>>>            Get piDefaultIndex to iIndex
25958>>>>>>>>>>>            
25958>>>>>>>>>>>            If (iIndex = -1) Begin
25960>>>>>>>>>>>                Get DefaultIndex to iIndex
25961>>>>>>>>>>>                Set piDefaultIndex to iIndex 
25962>>>>>>>>>>>            End
25962>>>>>>>>>>>>
25962>>>>>>>>>>>            
25962>>>>>>>>>>>            // If the pbSortable is undefined, set a proper default for it
25962>>>>>>>>>>>            If (iSortable = C_WebDefault) Begin
25964>>>>>>>>>>>                Set pbSortable to (iIndex <> -1)
25965>>>>>>>>>>>            End
25965>>>>>>>>>>>>
25965>>>>>>>>>>>        End
25965>>>>>>>>>>>>
25965>>>>>>>>>>>
25965>>>>>>>>>>>    End_Procedure
25966>>>>>>>>>>>    
25966>>>>>>>>>>>    
