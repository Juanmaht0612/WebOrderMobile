35437>>>>>>>    End_Procedure
35438>>>>>>>    
35438>>>>>>>    //  Override the FillFromDDO and add an entry item for each parent record.
35438>>>>>>>    Procedure FillFromDDO
35440>>>>>>>        Handle hoServer hoDD
35440>>>>>>>        Integer iFile iField iIndex
35440>>>>>>>        String sRowId sDescription sEmptyItemDescription
35440>>>>>>>        Boolean bOldRelate bNeedsRelate
35440>>>>>>>        tWebComboItem[] atEmpty
35440>>>>>>>        tWebComboItem[] atEmpty
35441>>>>>>>        Boolean bAddEmptyItem
35441>>>>>>>        
35441>>>>>>>        Get Server to hoServer
35442>>>>>>>        Get Data_Field to iField
35443>>>>>>>        Get Data_File to iFile
35444>>>>>>>        Get piIndex to iIndex
35445>>>>>>>        
35445>>>>>>>        Set paComboItems to atEmpty
35446>>>>>>>        
35446>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35448>>>>>>>            //  Do security check
35448>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35450>>>>>>>                Procedure_Return
35451>>>>>>>            End
35451>>>>>>>>
35451>>>>>>>            
35451>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35452>>>>>>>            
35452>>>>>>>            If (hoDD > 0) Begin
35454>>>>>>>                Get pbAddEmptyItem to bAddEmptyItem
35455>>>>>>>                If (bAddEmptyItem) Begin
35457>>>>>>>                    Get psEmptyItemDescription to sEmptyItemDescription
35458>>>>>>>                    Send AddComboItem (SerializeRowID(NullRowID())) sEmptyItemDescription
35459>>>>>>>                End
35459>>>>>>>>
35459>>>>>>>                
35459>>>>>>>                //  Use the field its prefered index
35459>>>>>>>                If (iIndex <= 0) Begin
35461>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
35464>>>>>>>                End
35464>>>>>>>>
35464>>>>>>>                
35464>>>>>>>                //  If the field is not indexed we use the table its primary index
35464>>>>>>>                If (iIndex <= 0) Begin
35466>>>>>>>                    Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
35469>>>>>>>                End
35469>>>>>>>>
35469>>>>>>>                                 
35469>>>>>>>                // optimize relates. Only do it if needed
35469>>>>>>>                Get No_Relate_State of hoDD to bOldRelate
35470>>>>>>>                Get DDOConstraintNeedsRelate of hoDD iIndex to bNeedsRelate
35471>>>>>>>                Set No_Relate_State of hoDD to (not(bNeedsRelate))
35472>>>>>>>                Send Request_Read of hoDD FIRST_RECORD iFile iIndex
35473>>>>>>>                
35473>>>>>>>                While (Found)
35477>>>>>>>                    Get_Field_Value iFile iField to sDescription
35480>>>>>>>                    Send OnDefineDescription (&sDescription)
35481>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to sRowId
35482>>>>>>>                    Send AddComboItem sRowId (Trim(sDescription))
35483>>>>>>>                    
35483>>>>>>>                    Send Locate_Next of hoDD
35484>>>>>>>                Loop
35485>>>>>>>>
35485>>>>>>>                Set No_Relate_State of hoDD to bOldRelate
35486>>>>>>>           End
35486>>>>>>>>
35486>>>>>>>        End
35486>>>>>>>>
35486>>>>>>>    End_Procedure
35487>>>>>>>    
35487>>>>>>>    // Hook to customize a combo item's description.
35487>>>>>>>    Procedure OnDefineDescription String ByRef sDescription
35489>>>>>>>    End_Procedure
35490>>>>>>>    
35490>>>>>>>    //  Override the Refresh procedure and instead of setting the value we use the rowid.
35490>>>>>>>    Procedure Refresh Integer eMode
35492>>>>>>>        Handle hoServer hoDD
35492>>>>>>>        Integer iFile iField
35492>>>>>>>        String sRowId
35492>>>>>>>        RowID riRowId
35492>>>>>>>        Boolean bAllowFind
35492>>>>>>>        
35492>>>>>>>        If (not(AppSynching(Host(Self)))) Begin
35494>>>>>>>            Get Server to hoServer
35495>>>>>>>            Get Data_File to iFile
35496>>>>>>>            Get Data_Field to iField
35497>>>>>>>            
35497>>>>>>>            If (hoServer > 0 and iFile > 0) Begin
35499>>>>>>>                //  Do security check
35499>>>>>>>                If (not(FillDEOAllowed(Self))) Begin
35501>>>>>>>                    Procedure_Return
35502>>>>>>>                End
35502>>>>>>>>
35502>>>>>>>                
35502>>>>>>>                Get Data_Set of hoServer iFile to hoDD
35503>>>>>>>                
35503>>>>>>>                //  Update value with the current rowid
35503>>>>>>>                If (hoDD > 0) Begin
35505>>>>>>>                    Get CurrentRowId of hoDD to riRowId
35506>>>>>>>                    Move (SerializeRowID(riRowId)) to sRowId
35507>>>>>>>                    
35507>>>>>>>                    WebSet psValue to sRowId
35508>>>>>>>                End
35508>>>>>>>>
35508>>>>>>>                
35508>>>>>>>                //  Handle dynamic switching of the enabled state
35508>>>>>>>                If (pbEnabled(Self)) Begin
35510>>>>>>>                    Send SetDynamicEnabled
35511>>>>>>>                End                
35511>>>>>>>>
35511>>>>>>>            End
35511>>>>>>>>
35511>>>>>>>        End
35511>>>>>>>>
35511>>>>>>>    End_Procedure
35512>>>>>>>    
35512>>>>>>>    
35512>>>>>>>    //  The default implementation of the OnChange will perform the find operation so if 
35512>>>>>>>    //  pbServerOnChange is enabled changing the combo will immediately update other fields from 
35512>>>>>>>    //  the parent that might be displayed.
35512>>>>>>>    Procedure OnChange String sNewValue String sOldValue
35514>>>>>>>        Integer iFile
35514>>>>>>>        RowID riNewRow
35514>>>>>>>        Handle hoDD hoServer
35514>>>>>>>        Boolean bAllowFind
35514>>>>>>>        
35514>>>>>>>        Forward Send OnChange sNewValue sOldValue
35516>>>>>>>        
35516>>>>>>>        Get Server to hoServer
35517>>>>>>>        Get Data_File to iFile
35518>>>>>>>        
35518>>>>>>>        If (hoServer > 0 and iFile > 0) Begin
35520>>>>>>>            //  Do security check
35520>>>>>>>            If (not(FillDEOAllowed(Self))) Begin
35522>>>>>>>                Procedure_Return
35523>>>>>>>            End
35523>>>>>>>>
35523>>>>>>>            
35523>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35524>>>>>>>            
35524>>>>>>>            If (hoDD > 0) Begin
35526>>>>>>>                Get AllowParentFind of hoDD to bAllowFind
35527>>>>>>>                
35527>>>>>>>                If (bAllowFind) Begin
35529>>>>>>>                    Move (DeserializeRowID(sNewValue)) to riNewRow
35530>>>>>>>                    
35530>>>>>>>                    If (not(IsNullRowID(riNewRow))) Begin
35532>>>>>>>                        Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35533>>>>>>>                    End
35533>>>>>>>>
35533>>>>>>>                    Else Begin
35534>>>>>>>                        Send Clear of hoDD  
35535>>>>>>>                    End
35535>>>>>>>>
35535>>>>>>>                End
35535>>>>>>>>
35535>>>>>>>            End
35535>>>>>>>>
35535>>>>>>>        End
35535>>>>>>>>
35535>>>>>>>    End_Procedure
35536>>>>>>>    
35536>>>>>>>    //  Override the UpdateDataBinding and instead of setting the field its changed-value it 
35536>>>>>>>    //  performs a find to select the right parent.
35536>>>>>>>    Procedure UpdateDataBinding
35538>>>>>>>        Integer iFile
35538>>>>>>>        String sRowId
35538>>>>>>>        RowID riNewRow
35538>>>>>>>        Handle hoDD hoServer
35538>>>>>>>        Boolean bAllowFind
35538>>>>>>>        
35538>>>>>>>        WebGet psValue to sRowId
35539>>>>>>>        Get Server to hoServer
35540>>>>>>>        Get Data_File to iFile
35541>>>>>>>        
35541>>>>>>>        If (hoServer > 0 and iFile > 0) Begin        
35543>>>>>>>            //  Do security check
35543>>>>>>>            If (not(UpdateDDAllowed(Self))) Begin
35545>>>>>>>                Procedure_Return
35546>>>>>>>            End
35546>>>>>>>>
35546>>>>>>>            
35546>>>>>>>            Get Data_Set of hoServer iFile to hoDD
35547>>>>>>>            
35547>>>>>>>            If (hoDD > 0) Begin
35549>>>>>>>                Get AllowParentFind of hoDD to bAllowFind
35550>>>>>>>                
35550>>>>>>>                If (bAllowFind) Begin
35552>>>>>>>                    Move (DeserializeRowID(sRowId)) to riNewRow
35553>>>>>>>                    
35553>>>>>>>                    If (not(IsSameRowID(CurrentRowId(hoDD), riNewRow))) Begin
35555>>>>>>>                        If (not(IsNullRowID(riNewRow))) Begin
35557>>>>>>>                            Send FindByRowId of hoDD (Main_File(hoDD)) riNewRow
35558>>>>>>>                        End
35558>>>>>>>>
35558>>>>>>>                        Else Begin
35559>>>>>>>                            Send Clear of hoDD  
35560>>>>>>>                        End
35560>>>>>>>>
35560>>>>>>>                    End
35560>>>>>>>>
35560>>>>>>>                End
35560>>>>>>>>
35560>>>>>>>            End 
35560>>>>>>>>
35560>>>>>>>        End
35560>>>>>>>>
35560>>>>>>>    End_Procedure
