55143>>>>>>>
55143>>>>>>>    Function PrintDialog Returns Integer
55145>>>>>>>        Handle hDevMode hDevNames hPrintDlg hResult hPageRanges
55145>>>>>>>        Integer iResult iVoid
55145>>>>>>>        UInteger iFlags
55145>>>>>>>        PRINTDLGEXW pd
55145>>>>>>>        PRINTDLGEXW pd
55145>>>>>>>        PRINTPAGERANGE[] PageRanges
55145>>>>>>>        PRINTPAGERANGE[] PageRanges
55146>>>>>>>        tPrintDialogDevModeData PrintDialogDevMode
55146>>>>>>>        tPrintDialogDevModeData PrintDialogDevMode
55146>>>>>>>
55146>>>>>>>        Move (SetLastError(0)) to iResult
55147>>>>>>>
55147>>>>>>>        Get phPrintDlg to hPrintDlg
55148>>>>>>>        If (hPrintDlg <> 0) Begin
55150>>>>>>>            Move (GlobalFree (hPrintDlg)) to iResult
55151>>>>>>>            Set phPrintDlg to 0
55152>>>>>>>        End
55152>>>>>>>>
55152>>>>>>>
55152>>>>>>>        // Allocate memory for PRINTDLGEXW structure
55152>>>>>>>        Move (GlobalAlloc (GPTR, SizeOfType (PRINTDLGEXW))) to hPrintDlg
55153>>>>>>>        If (hPrintDlg = 0) Begin
55155>>>>>>>            Move (ShowLastError ()) to iResult
55156>>>>>>>            Function_Return PD_RESULT_CANCEL
55157>>>>>>>        End
55157>>>>>>>>
55157>>>>>>>
55157>>>>>>>        Get piFlags to iFlags
55158>>>>>>>
55158>>>>>>>        // Return the printer device context
55158>>>>>>>        Move (iFlags ior PD_RETURNDC) to iFlags
55159>>>>>>>
55159>>>>>>>        // Copy the page ranges array information
55159>>>>>>>        If (not (IsFlagIn (PD_NOPAGENUMS, iFlags))) Begin
55161>>>>>>>            Send CopyPageRangeInfo (&pd)
55162>>>>>>>        End
55162>>>>>>>>
55162>>>>>>>
55162>>>>>>>        // Filter unsupported flags
55162>>>>>>>        If (IsFlagIn (PD_ENABLEPRINTTEMPLATE, iFlags)) Begin
55164>>>>>>>            Move (iFlags - PD_ENABLEPRINTTEMPLATE) to iFlags
55165>>>>>>>        End
55165>>>>>>>>
55165>>>>>>>        If (IsFlagIn (PD_ENABLEPRINTTEMPLATEHANDLE, iFlags)) Begin
55167>>>>>>>            Move (iFlags - PD_ENABLEPRINTTEMPLATEHANDLE) to iFlags
55168>>>>>>>        End
55168>>>>>>>>
55168>>>>>>>        If (IsFlagIn (PD_USELARGETEMPLATE, iFlags)) Begin
55170>>>>>>>            Move (iFlags - PD_USELARGETEMPLATE) to iFlags
55171>>>>>>>        End
55171>>>>>>>>
55171>>>>>>>
55171>>>>>>>        // If the PD_RETURNDEFAULT flag is set the hDevMode and hDevNames must be zero
55171>>>>>>>        If (IsFlagIn (PD_RETURNDEFAULT, iFlags)) Begin
55173>>>>>>>            Move 0 to hDevMode
55174>>>>>>>            Move 0 to hDevNames
55175>>>>>>>        End
55175>>>>>>>>
55175>>>>>>>        Else Begin
55176>>>>>>>            Get private_pPrintDialogDevMode to PrintDialogDevMode
55177>>>>>>>            If (IsFlagIn (PD_USEDEVMODECOPIES, iFlags) or (not (PrintDialogDevMode.bChanged))) Begin
55179>>>>>>>                Move 0 to hDevNames
55180>>>>>>>                Move 0 to hDevMode
55181>>>>>>>            End
55181>>>>>>>>
55181>>>>>>>            Else Begin
55182>>>>>>>                Get InitDevMode to hDevMode
55183>>>>>>>                If (hDevMode = -1) Begin
55185>>>>>>>                    Function_Return PD_RESULT_CANCEL
55186>>>>>>>                End
55186>>>>>>>>
55186>>>>>>>                Get InitDevNames to hDevNames
55187>>>>>>>                If (hDevNames = -1) Begin
55189>>>>>>>                    Function_Return PD_RESULT_CANCEL
55190>>>>>>>                End
55190>>>>>>>>
55190>>>>>>>            End
55190>>>>>>>>
55190>>>>>>>        End
55190>>>>>>>>
55190>>>>>>>
55190>>>>>>>        Move (SizeOfType (PRINTDLGEXW)) to pd.lStructSize
55191>>>>>>>        Get OwnerHandle to pd.hwndOwner
55192>>>>>>>        Move hDevMode to pd.hDevMode
55193>>>>>>>        Move hDevNames to pd.hDevNames
55194>>>>>>>        Move iFlags to pd.Flags
55195>>>>>>>        Get piMinPage to pd.nMinPage
55196>>>>>>>        Get piMaxPage to pd.nMaxPage
55197>>>>>>>        Get piCopies to pd.nCopies
55198>>>>>>>        Move START_PAGE_GENERAL to pd.nStartPage
55199>>>>>>>
55199>>>>>>>        // Copy the PRINTDLGEX structure
55199>>>>>>>        Move (CopyMemory (hPrintDlg, AddressOf (pd), SizeOfType (PRINTDLGEXW))) to iVoid
55200>>>>>>>
55200>>>>>>>        // Call the printdlgex function, this may open a dialog
55200>>>>>>>        Move (PrintDlgEx (hPrintDlg)) to hResult
