54371>>>>>>>    Procedure CopyPageRangeInfo PRINTDLGEXW ByRef pd
54373>>>>>>>        Integer iPageRangeElements iPageRangeElement iMaxPage iMinPage iResult
54373>>>>>>>        Handle hPageRanges
54373>>>>>>>        PRINTPAGERANGE[] PageRanges
54373>>>>>>>        PRINTPAGERANGE[] PageRanges
54374>>>>>>>
54374>>>>>>>        Get piMaxPageRanges to pd.nMaxPageRanges
54375>>>>>>>        If (pd.nMaxPageRanges <= 0) Begin
54377>>>>>>>            Move 10 to pd.nMaxPageRanges
54378>>>>>>>            Set piMaxPageRanges to 10
54379>>>>>>>        End
54379>>>>>>>>
54379>>>>>>>        Get phPageRanges to hPageRanges
54380>>>>>>>        If (hPageRanges <> 0) Begin
54382>>>>>>>            Move (GlobalFree (hPageRanges)) to iResult
54383>>>>>>>            Set phPageRanges to 0
54384>>>>>>>        End
54384>>>>>>>>
54384>>>>>>>        Get pPageRanges to PageRanges
54385>>>>>>>        Move (SizeOfArray (PageRanges)) to pd.nPageRanges
54386>>>>>>>        If (pd.nPageRanges > 0) Begin
54388>>>>>>>            Move (GlobalAlloc (GPTR, pd.nPageRanges * SizeOfType (PRINTPAGERANGE))) to hPageRanges
54389>>>>>>>            If (hPageRanges = 0) Begin
54391>>>>>>>                Move (ShowLastError ()) to iResult
54392>>>>>>>                Move 0 to pd.nPageRanges
54393>>>>>>>                Move 0 to pd.lpPageRanges
54394>>>>>>>            End
54394>>>>>>>>
54394>>>>>>>            Else Begin
54395>>>>>>>                Move 99999 to iMinPage
54396>>>>>>>                // Loop through passed page range elements to find the min and max page values.
54396>>>>>>>                Move (pd.nPageRanges - 1) to iPageRangeElements
54397>>>>>>>                For iPageRangeElement from 0 to iPageRangeElements
54403>>>>>>>>
54403>>>>>>>                    Move (iMinPage min PageRanges[iPageRangeElement].nFromPage) to iMinPage
54404>>>>>>>                    Move (iMaxPage max PageRanges[iPageRangeElement].nToPage) to iMaxPage
54405>>>>>>>                Loop
54406>>>>>>>>
54406>>>>>>>
54406>>>>>>>                Set piMaxPage to iMaxPage
54407>>>>>>>                Set piMinPage to iMinPage
54408>>>>>>>
54408>>>>>>>                Move (CopyMemory (hPageRanges, AddressOf (PageRanges), pd.nPageRanges * SizeOfType (PRINTPAGERANGE))) to iResult
54409>>>>>>>                Move hPageRanges to pd.lpPageRanges
54410>>>>>>>                Set phPageRanges to hPageRanges
54411>>>>>>>            End
54411>>>>>>>>
54411>>>>>>>        End
54411>>>>>>>>
54411>>>>>>>    End_Procedure
