22249>>>>>>>>>>>>>>>    //
22249>>>>>>>>>>>>>>>    // Returns the value for non-scalar (advanced) web properties. These are stored separate from
22249>>>>>>>>>>>>>>>    // the scalar web properties. It looks for the 'synchronized' value in the gaAdvSyncProps store.
22249>>>>>>>>>>>>>>>    //
22249>>>>>>>>>>>>>>>    // Params:
22249>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22249>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22249>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22249>>>>>>>>>>>>>>>    // Returns:
22249>>>>>>>>>>>>>>>    //      The property value as a variant.
22249>>>>>>>>>>>>>>>    //
22249>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22249>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22249>>>>>>>>>>>>>>>    // to be "out of scope".
22249>>>>>>>>>>>>>>>    Function GetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
22251>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22251>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22251>>>>>>>>>>>>>>>        Variant vReturnValue
22251>>>>>>>>>>>>>>>        Boolean bFoundProp bIsAjaxWebObject bIsObjectInScope
22251>>>>>>>>>>>>>>>            
22251>>>>>>>>>>>>>>>        // Test if we are active....
22251>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22253>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22253>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22253>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22253>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to vReturnValue
22254>>>>>>>>>>>>>>>            Function_Return vReturnValue
22255>>>>>>>>>>>>>>>        End
22255>>>>>>>>>>>>>>>>
22255>>>>>>>>>>>>>>>        
22255>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22256>>>>>>>>>>>>>>>    
22256>>>>>>>>>>>>>>>        Get FindAdvPropCache hoObject pubProp.sName to iProp
22257>>>>>>>>>>>>>>>        If (iProp = -1) Begin
22259>>>>>>>>>>>>>>>            //  Use the raw property
22259>>>>>>>>>>>>>>>            Get pubprop.hmGetter of hoObject to vReturnValue
22260>>>>>>>>>>>>>>>        End
22260>>>>>>>>>>>>>>>>
22260>>>>>>>>>>>>>>>        Else Begin
22261>>>>>>>>>>>>>>>            If (not(gaAdvSyncProps[iStoreIndex][iProp].bDeserialized)) Begin
22263>>>>>>>>>>>>>>>                //  Initialize our variant with an advanced value of the right type to make valuetreedeserialize work (!IMPORTANT)
22263>>>>>>>>>>>>>>>                Get pubProp.hmGetter of hoObject to vReturnValue
22264>>>>>>>>>>>>>>>                ValueTreeDeserializeParameter gaAdvSyncProps[iStoreIndex][iProp].tSyncProp.tV to vReturnValue
22265>>>>>>>>>>>>>>>                
22265>>>>>>>>>>>>>>>                Move vReturnValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22266>>>>>>>>>>>>>>>                Move True to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22267>>>>>>>>>>>>>>>            End
22267>>>>>>>>>>>>>>>>
22267>>>>>>>>>>>>>>>            Else Begin
22268>>>>>>>>>>>>>>>                Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV to vReturnValue
22269>>>>>>>>>>>>>>>            End
22269>>>>>>>>>>>>>>>>
22269>>>>>>>>>>>>>>>        End
22269>>>>>>>>>>>>>>>>
22269>>>>>>>>>>>>>>>        Function_Return vReturnValue
22270>>>>>>>>>>>>>>>    End_Function
