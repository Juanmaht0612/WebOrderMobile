34561>>>>>>>    // called before the list is activated. 
34561>>>>>>>    Procedure InitializePromptList
34563>>>>>>>        Handle hoServer hoReadingDD hoInvokingObject hoInvokingServer hoInitialColumn hoUpdateColumn
34563>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
34563>>>>>>>        Integer iFile iField iOldMode iMainFile eUpdateMode iOrdering
34563>>>>>>>        Integer iUpdateColumn iInitialColumn 
34563>>>>>>>        String sValue sName
34563>>>>>>>        RowID riRowid
34563>>>>>>>        
34563>>>>>>>        Send RestoreDefaults // set back to default state
34564>>>>>>>        
34564>>>>>>>        WebGet peUpdateMode to eUpdateMode
34565>>>>>>>        
34565>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin
34567>>>>>>>            // get and webset the full name of the invoking object
34567>>>>>>>            Get ReturnObject to hoInvokingObject
34568>>>>>>>            Get WebObjectName of hoInvokingObject to sName
34569>>>>>>>            WebSet psInvokingObject to sName  
34570>>>>>>>                      
34570>>>>>>>            If (hoInvokingObject<=Desktop) Begin
34572>>>>>>>                Error DFERR_PROGRAM C_$PromptListHasNoInvokingObject
34573>>>>>>>>
34573>>>>>>>                Procedure_Return
34574>>>>>>>            End
34574>>>>>>>>
34574>>>>>>>
34574>>>>>>>            Send Prompt_Callback to hoInvokingObject Self
34575>>>>>>>            WebGet peUpdateMode to eUpdateMode // this may have changed
34576>>>>>>>        End
34576>>>>>>>>
34576>>>>>>>        Get pbDataAware to bDataAware
34577>>>>>>>        If not bDataAware Begin
34579>>>>>>>            Send InitializePromptListNDA
34580>>>>>>>            Procedure_Return
34581>>>>>>>        End
34581>>>>>>>>
34581>>>>>>>
34581>>>>>>>        Get Server to hoServer
34582>>>>>>>        If (hoServer=0) Begin
34584>>>>>>>            Error DFERR_PROGRAM C_$PromptListHasNoServer
34585>>>>>>>>
34585>>>>>>>            Procedure_Return
34586>>>>>>>        End
34586>>>>>>>>
34586>>>>>>>        
34586>>>>>>>        WebGet piInitialColumn to iInitialColumn
34587>>>>>>>
34587>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34589>>>>>>>            Get Delegation_Mode of hoInvokingObject to iOldMode
34590>>>>>>>            Set Delegation_Mode of hoInvokingObject to NO_DELEGATE_OR_ERROR
34591>>>>>>>            Get Data_File  of hoInvokingObject Current to iFile
34592>>>>>>>            Get Data_Field of hoInvokingObject Current to iField
34593>>>>>>>            Set Delegation_Mode of hoInvokingObject to iOldMode
34594>>>>>>>            If (iFile) Begin
34596>>>>>>>                Get Server of hoInvokingObject to hoInvokingServer
34597>>>>>>>            End
34597>>>>>>>>
34597>>>>>>>            
34597>>>>>>>            Get Main_File of hoServer to iMainFile
34598>>>>>>>            
34598>>>>>>>            If (not (iFile<>0 and iMainFile=iFile and hoInvokingObject<>0)) Begin
34600>>>>>>>                Send OnRelationalPromptListError
34601>>>>>>>                // get the update mode in case the RelationalPromptListError changes the mode to try another mode
34601>>>>>>>                WebGet peUpdateMode to eUpdateMode
34602>>>>>>>            End
34602>>>>>>>>
34602>>>>>>>        End
34602>>>>>>>>
34602>>>>>>>        
34602>>>>>>>        If (eUpdateMode=umPromptValue) Begin // else not used here intentionally
34604>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34605>>>>>>>            WebSet psSeedValue to sValue
34606>>>>>>>        End
34606>>>>>>>>
34606>>>>>>>        
34606>>>>>>>        // if relational, update column is the "best" else you must specify it
34606>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34608>>>>>>>            Get SelectBestColumn iFile iField to iUpdateColumn
34609>>>>>>>        End
34609>>>>>>>>
34609>>>>>>>        Else Begin
34610>>>>>>>            WebGet piUpdateColumn to iUpdateColumn
34611>>>>>>>        End
34611>>>>>>>>
34611>>>>>>>        If (iUpdateColumn>=0) Begin
34613>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34614>>>>>>>        End
34614>>>>>>>>
34614>>>>>>>        
34614>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34614>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34614>>>>>>>        If (iInitialColumn=-1) Begin
34616>>>>>>>            Move iUpdateColumn to iInitialColumn
34617>>>>>>>        End
34617>>>>>>>>
34617>>>>>>>        If (iInitialColumn>=0) Begin
34619>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34620>>>>>>>        End
34620>>>>>>>>
34620>>>>>>>        
34620>>>>>>>        // this assigns an ordering and a sort order
34620>>>>>>>        If (hoInitialColumn) Begin
34622>>>>>>>            WebSet piSortColumn to iUpdateColumn
34623>>>>>>>        End
34623>>>>>>>>
34623>>>>>>>        
34623>>>>>>>        // this function seeds the data and a boolean indicating if the buffer was seeded and read
34623>>>>>>>        If (eUpdateMode<>umPromptNonInvoking) Begin 
34625>>>>>>>            Get SeedData hoUpdateColumn hoInitialColumn to bSeeded
34626>>>>>>>        End 
34626>>>>>>>>
34626>>>>>>>
34626>>>>>>>        // if initial and update columns are different we must now reset the ordering
34626>>>>>>>        // to the initial order.
34626>>>>>>>        If (hoInitialColumn and (hoInitialColumn<>hoUpdateColumn)) Begin
34628>>>>>>>            WebSet piSortColumn to iInitialColumn
34629>>>>>>>        End
34629>>>>>>>>
34629>>>>>>>            
34629>>>>>>>        If (not(bSeeded)) Begin
34631>>>>>>>            WebGet pbReverseOrdering to bReverseOrdering
34632>>>>>>>            Get IndexOrder to iOrdering
34633>>>>>>>            Get ReadingServer to hoReadingDD
34634>>>>>>>            Get ReadDDFirstRecord hoReadingDD iOrdering bReverseOrdering to riRowid
34635>>>>>>>            Move (not(IsNullRowID(riRowid))) to bSeeded
34636>>>>>>>        End
34636>>>>>>>>
34636>>>>>>>        
34636>>>>>>>        If (peDbGridType(Self)<>gtManual) Begin
34638>>>>>>>            If bSeeded Begin
34640>>>>>>>                Send Request_Assign of hoServer
34641>>>>>>>            End
34641>>>>>>>>
34641>>>>>>>            Else Begin
34642>>>>>>>                Send ClearGrid
34643>>>>>>>            End
34643>>>>>>>>
34643>>>>>>>        End
34643>>>>>>>>
34643>>>>>>>        Else Begin
34644>>>>>>>            // with a manual loaded list, we will refresh the grid by sending GridRefresh
34644>>>>>>>            Move (GetRowID(Main_File(hoServer))) to riRowid
34645>>>>>>>            Send GridRefresh // this will do a manual load
34646>>>>>>>            String sRowId
34646>>>>>>>            Get psCurrentRowID to sRowId
34647>>>>>>>            If (bSeeded and IsNullRowID(DeserializeRowID(sRowId))) Begin
34649>>>>>>>                WebSet psCurrentRowID to (SerializeRowID(riRowid))
34650>>>>>>>            End
34650>>>>>>>>
34650>>>>>>>        End            
34650>>>>>>>>
34650>>>>>>>    End_Procedure
34651>>>>>>>
34651>>>>>>>    // initialize prompt list for a non-data aware grid (pbDataAware=F)
34651>>>>>>>    Procedure InitializePromptListNDA
34653>>>>>>>        Handle hoInvokingObject hoInitialColumn hoUpdateColumn
34653>>>>>>>        Boolean  bDataAware
34653>>>>>>>        Integer  eUpdateMode
34653>>>>>>>        Integer iUpdateColumn iInitialColumn 
34653>>>>>>>        String sValue sName
34653>>>>>>>        
34653>>>>>>>        Get FocusObject to hoInvokingObject
34654>>>>>>>
34654>>>>>>>        WebGet peUpdateMode to eUpdateMode
34655>>>>>>>        If (eUpdateMode=umPromptRelational) Begin
34657>>>>>>>            Move umPromptValue to eUpdateMode
34658>>>>>>>            WebSet peUpdateMode to eUpdateMode
34659>>>>>>>        End
34659>>>>>>>>
34659>>>>>>>        
34659>>>>>>>        WebGet piInitialColumn to iInitialColumn
34660>>>>>>>        
34660>>>>>>>        If (eUpdateMode=umPromptValue) Begin
34662>>>>>>>            WebGet psValue of hoInvokingObject to sValue
34663>>>>>>>            WebSet psSeedValue to sValue
34664>>>>>>>        End
34664>>>>>>>>
34664>>>>>>>        
34664>>>>>>>        WebGet piUpdateColumn to iUpdateColumn
34665>>>>>>>        If (iUpdateColumn>=0) Begin
34667>>>>>>>            Get GetColumnObject iUpdateColumn to hoUpdateColumn
34668>>>>>>>        End
34668>>>>>>>>
34668>>>>>>>        
34668>>>>>>>        // We need an initial column. if you specified an initial column that will get used for the start column
34668>>>>>>>        // and the initial sort order. If you did not, which is typical, it will use the update column
34668>>>>>>>        If (iInitialColumn=-1) Begin
34670>>>>>>>            Move iUpdateColumn to iInitialColumn
34671>>>>>>>        End
34671>>>>>>>>
34671>>>>>>>        If (iInitialColumn>=0) Begin
34673>>>>>>>            Get GetColumnObject iInitialColumn to hoInitialColumn
34674>>>>>>>        End
34674>>>>>>>>
34674>>>>>>>        
34674>>>>>>>        // this assigns an ordering and a sort order
34674>>>>>>>        If (hoInitialColumn) Begin
34676>>>>>>>            WebSet piSortColumn to iInitialColumn
34677>>>>>>>        End
34677>>>>>>>>
34677>>>>>>>        
34677>>>>>>>        Send GridRefresh // this will call OnLoadManualData which will fill and seed the list
34678>>>>>>>    End_Procedure
