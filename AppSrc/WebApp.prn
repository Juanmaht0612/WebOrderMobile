30304>>>>>>>>>>>    // Retrieves a hash value
30304>>>>>>>>>>>    Function HashValue Handle lhHash Returns UChar[]
30306>>>>>>>>>>>        UChar[] ucHash
30307>>>>>>>>>>>        Integer liResult
30307>>>>>>>>>>>        DWord   dwDataLen
30307>>>>>>>>>>>        
30307>>>>>>>>>>>        Move 0 to dwDataLen
30308>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,0,AddressOf(dwDataLen),0)) to liResult
30309>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
30312>>>>>>>>>>>        
30312>>>>>>>>>>>        Move (ResizeArray(ucHash, dwDataLen, 0)) to ucHash
30313>>>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,AddressOf(ucHash),AddressOf(dwDataLen),0)) to liResult
30314>>>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
