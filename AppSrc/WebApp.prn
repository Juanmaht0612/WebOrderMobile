Including file: cWebModalDialog.pkg    (E:\Jenkins\workspace\DataFlex 26.0 - DF Source\Examples\WebOrderMobile\DfPkg\DataFlex_dev_Web_UI-1.0.52\AppSrc\cWebModalDialog.pkg)
34276>>>>>>>Use cWebView.pkg
34276>>>>>>>
34276>>>>>>>// Use this class to implement a floating modal window that can contain a data entry view.
34276>>>>>>>// For example a prompt list dialog.
34276>>>>>>>//
34276>>>>>>>// Add support for:
34276>>>>>>>// - Invoking view object handle.
34276>>>>>>>// - Window size.
34276>>>>>>>
34276>>>>>>>// Make the following interface for this class private...
34276>>>>>>>
34276>>>>>>>Class cWebModalDialog is a cWebView
34277>>>>>>>    
34277>>>>>>>    Procedure Construct_Object
34279>>>>>>>        Forward Send Construct_Object
34281>>>>>>>        
34281>>>>>>>        // Published Properties
34281>>>>>>>        Property Boolean pbResizable True             // True if the window can be resized (with mouse)
34284>>>>>>>        Property Boolean pbShowClose True             // True if the title has a close button to hide the window
34287>>>>>>>        Property Boolean pbShowMax False              // True if the title has a max button to maximize the window 
34290>>>>>>>        Property Boolean pbShowMin False              // True if the title has a min button to minimize the window
34293>>>>>>>        Property Integer piLeft 0                   // Left co-ordinate, in pixels of the window
34296>>>>>>>        Property Integer piMinHeight 80               // Minimum height, in pixels, of the window
34299>>>>>>>        Property Integer piTop 0                    // Top co-ordinate, in pixels of the window
34302>>>>>>>        Property Integer piWidth -1                   // Width, in pixels of the window
34305>>>>>>>        
34305>>>>>>>        Property Boolean pbServerOnEscape False   // Set to true to trigger server OnEscape event
34308>>>>>>>        Property String psClientOnEscape ""       // Name of client side OnEscape event handler
34311>>>>>>>        
34311>>>>>>>        Property String psReturnMessage "OnCloseModalDialog"   // callback method name
34314>>>>>>>        Property String psReturnObject             // callback object name
34317>>>>>>>        Property Boolean pbCanceled True          // maintained by class when used in a default manner
34320>>>>>>>        
34320>>>>>>>        //  Configure super classes
34320>>>>>>>        Set pbOverrideStateOnShow to True
34321>>>>>>>        Set pbScroll to False
34322>>>>>>>        
34322>>>>>>>        Set piMinWidth to 200
34323>>>>>>>        Set peWebViewStyle to wvsDialog
34324>>>>>>>        
34324>>>>>>>        Set psJSClass to "df.WebModalDialog"
34325>>>>>>>    End_Procedure
34326>>>>>>>    
34326>>>>>>>
34326>>>>>>>    // Returns a handle to the invoking view object. i.e. the view that activated this modal dialog.
34326>>>>>>>    // Returns C_WebUnresolvedObject if there is no invoking view. See also psInvokingView
34326>>>>>>>    Function InvokingView Returns Handle
34328>>>>>>>        Handle hoInvokingView
34328>>>>>>>        String sInvokingView
34328>>>>>>>        
34328>>>>>>>        WebGet psInvokingView to sInvokingView
34329>>>>>>>        If (Trim(sInvokingView) <> "") Begin
34331>>>>>>>            Get FindWebObject of (Owner(Self)) sInvokingView to hoInvokingView
34332>>>>>>>            Function_Return hoInvokingView
34333>>>>>>>        End
34333>>>>>>>>
34333>>>>>>>         
34333>>>>>>>        Function_Return C_WebUnresolvedObject    
34334>>>>>>>    End_Function   
34335>>>>>>>    
34335>>>>>>>     
34335>>>>>>>    // Does a standard modal dialog invocation. It web-sets pbCanceled to True (which can be
34335>>>>>>>    // set to true on a successful close), it sets the callback object and sets the default
34335>>>>>>>    // callback message "OnCloseModalDialog". Finally it calls OnPopup
34335>>>>>>>    Procedure Popup Handle hoReturnObject
34337>>>>>>>        String sReturnMethod sReturnObject
34337>>>>>>>        WebSet pbCanceled to True // this gets reset if it closes ok
34338>>>>>>>        Get WebObjectName of hoReturnObject to sReturnObject
34339>>>>>>>        WebSet psReturnObject to sReturnObject
34340>>>>>>>        Send Show
34341>>>>>>>    End_Procedure
34342>>>>>>>    
34342>>>>>>>    // Can be called to do a successful closing of a panel. It sets pbCanceled to False, sends hide
34342>>>>>>>    // and class NotifyCloseModalDialog, which performs the callback using data web-set in Popup
34342>>>>>>>    Procedure Ok
34344>>>>>>>        WebSet pbCanceled to False
34345>>>>>>>        Send NotifyCloseModalDialog
34346>>>>>>>        Send CloseDialog
34347>>>>>>>    End_Procedure
34348>>>>>>>
34348>>>>>>>    // Can be called to do a non-successful closing of a panel. pbCanceled will be True (from Popup),
34348>>>>>>>    // it sends hide and it optionally sends NotifyCloseModalDialog, which performs the callback using data web-set in Popup.
34348>>>>>>>    // It sends NotifyCloseModalPanel if pbServerOnEscape is True. This makes the assumption that pbServerOnEscape means that
34348>>>>>>>    // you want to send a close notification and callback even when canceled in any manner.
34348>>>>>>>    Procedure Cancel
34350>>>>>>>        Boolean bServerOnEscape
34350>>>>>>>        WebGet pbServerOnEscape to bServerOnEscape
34351>>>>>>>        If (bServerOnEscape) Begin
34353>>>>>>>            Send NotifyCloseModalDialog
34354>>>>>>>        End
34354>>>>>>>>
34354>>>>>>>        Send CloseDialog
34355>>>>>>>    End_Procedure
34356>>>>>>>    
34356>>>>>>>    // this is called when the Esc key or "x" is pressed
34356>>>>>>>    Procedure OnEscape
34358>>>>>>>        Send Cancel
34359>>>>>>>    End_Procedure
34360>>>>>>>    
34360>>>>>>>    
34360>>>>>>>    // Sends the callback method to the callback object using values web-set in Popup. This is 
34360>>>>>>>    // usually called by Ok and maybe Cancel.
34360>>>>>>>    Procedure NotifyCloseModalDialog
34362>>>>>>>        Handle hoReturnObject hReturnMessage
34362>>>>>>>        String sReturnObject sReturnMessage
34362>>>>>>>        Boolean bOpenedWithNavigate
34362>>>>>>>        
34362>>>>>>>        //Check if we got here through navigation or through Send popup
34362>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34363>>>>>>>        //If sReturnObject is an empty string we got here through Send popup
34363>>>>>>>        If (bOpenedWithNavigate) Begin
34365>>>>>>>            WebGet psInvokingObject to sReturnObject
34366>>>>>>>        End
34366>>>>>>>>
34366>>>>>>>        Else Begin
34367>>>>>>>            WebGet psReturnObject to sReturnObject
34368>>>>>>>        End
34368>>>>>>>>
34368>>>>>>>        
34368>>>>>>>        WebGet psReturnMessage to sReturnMessage
34369>>>>>>>
34369>>>>>>>        Get WebObjectByName sReturnObject to hoReturnObject
34370>>>>>>>        If hoReturnObject Begin
34372>>>>>>>            If (sReturnMessage <> "") Begin
34374>>>>>>>                Get WebMethodByName of hoReturnObject sReturnMessage to hReturnMessage
34375>>>>>>>                If hReturnMessage Begin
34377>>>>>>>                    Send hReturnMessage of hoReturnObject Self
34378>>>>>>>                End
34378>>>>>>>>
34378>>>>>>>            End
34378>>>>>>>>
34378>>>>>>>        End
34378>>>>>>>>
34378>>>>>>>    End_Procedure
34379>>>>>>>    
34379>>>>>>>    // Returns a handle to the return object. This is used by controls (cWebPromptList) to get
34379>>>>>>>    // the return object using delegation.
34379>>>>>>>    Function ReturnObject Returns Handle
34381>>>>>>>        String sWO
34381>>>>>>>        Handle hoWO
34381>>>>>>>        Boolean bOpenedWithNavigate
34381>>>>>>>        
34381>>>>>>>        Move C_WebUnresolvedObject to hoWO
34382>>>>>>>        Get OpenedWithNavigate to bOpenedWithNavigate
34383>>>>>>>        
34383>>>>>>>        //When opened with navigate we rely on psInvokingObject, otherwise psReturnObject.
34383>>>>>>>        If (bOpenedWithNavigate) Begin
34385>>>>>>>            WebGet psInvokingObject to sWO
34386>>>>>>>        End
34386>>>>>>>>
34386>>>>>>>        Else Begin
34387>>>>>>>            WebGet psReturnObject to sWO
34388>>>>>>>        End
34388>>>>>>>>
34388>>>>>>>
34388>>>>>>>        If (sWO <> "") Begin
34390>>>>>>>            Get WebObjectByName sWO to hoWO
34391>>>>>>>        End
34391>>>>>>>>
34391>>>>>>>        
34391>>>>>>>        Function_Return hoWO
34392>>>>>>>    End_Function
34393>>>>>>>    
34393>>>>>>>    Function IsDialog Returns Boolean
34395>>>>>>>        Function_Return True
34396>>>>>>>    End_Function
34397>>>>>>>    
34397>>>>>>>    //Calls navigate close for a modal dialog
34397>>>>>>>    Procedure NavigateCloseDialog
34399>>>>>>>        Boolean bCanceled
