49691>>>        
49691>>>        For iCount from 0 to iSizeOfArray
49697>>>>
49697>>>            Move dynamicObjects[iCount].sId to sWidgetName
49698>>>            Move (Pos(".", sWidgetName)) to iPos
49699>>>            
49699>>>            If (iPos = 0) Begin
49701>>>                Get WidgetInstance of hoWidgetContainerInternal sWidgetName to hoWidget
49702>>>               
49702>>>               If (IsObjectOfClass (hoWidget, (RefClass(cWidgetTimezone)))) Begin
49704>>>                    Send OnInitializeWidget of hoWidget
49705>>>               End
49705>>>>
49705>>>            End
49705>>>>
49705>>>        Loop
49706>>>>
