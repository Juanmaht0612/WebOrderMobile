45700>>>>>>>>>    Function MondayOfWeekYear Integer iWeek Integer iYear Returns DateTime
45702>>>>>>>>>        Integer iWeekStart iDay iDiff
45702>>>>>>>>>        DateTime dtResult
45702>>>>>>>>>
45702>>>>>>>>>        // Make January 1st of the passed year
45702>>>>>>>>>        Move (DateSet (iYear, 1, 1)) to dtResult
45703>>>>>>>>>        // Get The weeknumber of this date
45703>>>>>>>>>        Move (DateGetWeekOfYearISO (dtResult)) to iWeekStart
45704>>>>>>>>>        // Add 7 days when the weeknumber is not equal to 1
45704>>>>>>>>>        If (iWeekStart <> 1) Begin
45706>>>>>>>>>            Move (DateAddDay (dtResult, 7)) to dtResult
45707>>>>>>>>>        End
45707>>>>>>>>>>
45707>>>>>>>>>
45707>>>>>>>>>        // Get the day number of the date in the first week
45707>>>>>>>>>        Move (DateGetDayofWeekISO (dtResult)) to iDay
45708>>>>>>>>>        // Calculate the difference between day number of the first week and the monday
45708>>>>>>>>>        Move (1 - iDay) to iDiff
45709>>>>>>>>>        // Calculate the monday via the difference of the correct monday and the first monday of the year
45709>>>>>>>>>        Move (DateAddDay (dtResult, iDiff)) to dtResult
45710>>>>>>>>>
45710>>>>>>>>>        // Add number of days to the calculated date to get the monday
45710>>>>>>>>>        Move (DateAddDay (dtResult, (iWeek - 1) * 7)) to dtResult
45711>>>>>>>>>
45711>>>>>>>>>        Function_Return dtResult
45712>>>>>>>>>    End_Function
45713>>>>>>>>>
45713>>>>>>>>>    Function NumberDaysInMonth Integer iYear Integer iMonth Returns Integer
45715>>>>>>>>>        Integer iDays
45715>>>>>>>>>        Boolean bIsLeapYear
45715>>>>>>>>>        
45715>>>>>>>>>        Case Begin
45715>>>>>>>>>            Case (iMonth = 1)
45717>>>>>>>>>            Case (iMonth = 3)
45720>>>>>>>>>            Case (iMonth = 5)
45723>>>>>>>>>            Case (iMonth = 7)
45726>>>>>>>>>            Case (iMonth = 8) 
45729>>>>>>>>>            Case (iMonth = 10) 
45732>>>>>>>>>            Case (iMonth = 12)
45735>>>>>>>>>                Move 31 to iDays
45736>>>>>>>>>                Case Break            
45737>>>>>>>>>            Case (iMonth = 4)
45740>>>>>>>>>            Case (iMonth = 6)
45743>>>>>>>>>            Case (iMonth = 9)
45746>>>>>>>>>            Case (iMonth = 11)
45749>>>>>>>>>                Move 30 to iDays
45750>>>>>>>>>                Case Break                
45751>>>>>>>>>            Case (iMonth = 2)
45754>>>>>>>>>                Get IsLeapYear iYear to bIsLeapYear
45755>>>>>>>>>                If (bIsLeapYear) Begin
45757>>>>>>>>>                    Move 29 to iDays
45758>>>>>>>>>                End
45758>>>>>>>>>>
45758>>>>>>>>>                Else Begin
45759>>>>>>>>>                    Move 28 to iDays
45760>>>>>>>>>                End
45760>>>>>>>>>>
45760>>>>>>>>>                Case Break
45761>>>>>>>>>        Case End
45761>>>>>>>>>        
45761>>>>>>>>>        Function_Return iDays
45762>>>>>>>>>    End_Function
