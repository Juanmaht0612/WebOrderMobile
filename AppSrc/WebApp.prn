26317>>>>>>>>>    
26317>>>>>>>>>    Procedure Construct_Object
26319>>>>>>>>>        Forward Send Construct_Object
26321>>>>>>>>>        Send Define_cFilterExpression_mixin
26322>>>>>>>>>        Send Define_cWebListFilter_mixin
26323>>>>>>>>>        
26323>>>>>>>>>        Property Integer piOrdering -1                // initial ordering index see also Function Ordering
26324>>>>>>>>>        Property Integer piPageSize 80                // Max number of rows to send to the client at a time. 0 = load all available rows
26325>>>>>>>>>        
26325>>>>>>>>>        // should columns adjust their pbEnabled based on the DDO binding or should it be static.
26325>>>>>>>>>        // Normally only grids should be dynamic. This property is queried by cWebColumn objects.
26325>>>>>>>>>        Property Boolean pbColumnsEnabledStatic True
26326>>>>>>>>>
26326>>>>>>>>>        Property Integer peRequestFindMode rfmFindAll
26327>>>>>>>>>        
26327>>>>>>>>>        Property Boolean pbDataAware True             // Set True if Grid Columns use data binding to DDO. False if there should be no DDO connection.
26330>>>>>>>>>
26330>>>>>>>>>        Property Integer peDbGridType gtAutomatic           // If set to true, data is static and load just once. Only used with pbDataAware=T.
26333>>>>>>>>>        
26333>>>>>>>>>        Property Integer peGrouping grpDisabled
26336>>>>>>>>>        
26336>>>>>>>>>        Property Boolean pbGroupsCollapsible True
26339>>>>>>>>>        
26339>>>>>>>>>        Property Boolean pbGroupsCollapseByDefault False
26342>>>>>>>>>        
26342>>>>>>>>>        Property Handle[] phoColumnObjects            // ordered list of cWebColumn objects (in left to right column order)
26343>>>>>>>>>        Property Boolean pbNotifyingExternalDD False  // Private: Used to indicate to the Refresh event that we are handling an event generated by some action on the list/grid control (i.e. delete row, change row, etc)
26344>>>>>>>>>        Property Boolean pbGridBehavior False         // Private: Used by cWebColumn objects to test if they live in a cWebList (read only) or a cWebGrid (save and other stuff is supported)
26345>>>>>>>>>        Property Boolean pbInClearGrid False          // Private: should be set when a DD Clear is supposed refresh an empty grid instead of adding a new row            
26346>>>>>>>>>        
26346>>>>>>>>>        Property Boolean pbSuppressCacheError True // if a record cannot be found in cache, do we report the error?        
26347>>>>>>>>>        // Published Properties
26347>>>>>>>>>        Property Boolean pbColumnSortable True      // If true, column sorting is allowed (which may be server side or client side)
26350>>>>>>>>>        Property Boolean pbAutoSearch True          // If true the search dialog will popup automatically when the user starts typing
26353>>>>>>>>>        Property Boolean pbShowSelected True        // If true the list will visually show which row is selected.
26356>>>>>>>>>        Property Boolean pbShowHeader True          // If true the list will show a header that allows the user to see the column captions and sorting.
26359>>>>>>>>>        Property Boolean pbShowFooter False          // If true the list will show a footer that allows the user to see the footer information.
26362>>>>>>>>>        Property Boolean pbScroll True              // If true the list will scroll vertically
26365>>>>>>>>>        
26365>>>>>>>>>        Property Boolean pbReverseOrdering False    // If true then the current grid ordering is reversed
26368>>>>>>>>>        Property Boolean pbUnOrdered False          // If True then the grid data has potentially become unordered due to changes in the data
26371>>>>>>>>>        Property Integer piSortColumn -1            // Indicates which column the grid is currently sorted on (-1 means the data is sorted via piOrdering)
26374>>>>>>>>>        Property String psCurrentRowId ""           // Row ID of the currently selected row.
26377>>>>>>>>>        Property Integer piCurrentRowIndex -1       // The row index of the currently selected row on the client. Does not reflect row changes on the server within the current request. Note that if peGridType is set to gtAutomatic this number is relative to the rows in cache on the client.
26380>>>>>>>>>        Property Integer piRowCount 0               // The number of rows currently on the client. Note that if peGridType is set to gtAutomatic this number does not represent the entire set.
26383>>>>>>>>>        
26383>>>>>>>>>        Property Boolean pbColumnsResizable True
26386>>>>>>>>>        
26386>>>>>>>>>        Property Boolean pbAutoColumnSizing True
26389>>>>>>>>>        
26389>>>>>>>>>        Property Boolean pbOfflineEditing False      // Optimization: Disable server call on row change
26392>>>>>>>>>        Property String psPlaceHolder ""            //  Placeholder text shown if the list has no records
26395>>>>>>>>>        
26395>>>>>>>>>        Property Integer piLimitRows 0              // Only show the first x rows (0 = show all), requires peDbGridType to be set to gtAllData or pbScroll to false!
26398>>>>>>>>>        
26398>>>>>>>>>        Property String psKeyBuddy ""
26401>>>>>>>>>        
26401>>>>>>>>>        Property Handle phoKeyBuddy C_WebUnresolvedObject   //  Can be set to another cWebBaseUIObject and the cWebList will respond to key actions on that control 
26402>>>>>>>>>        
26402>>>>>>>>>         
26402>>>>>>>>>        Property Boolean pbServerOnRowClick False   // Switches the OnRowClick event on and off
26405>>>>>>>>>        Property String psClientOnRowClick ""       // Can be set to a client-side JavaScript event handler for the OnRowClick event
26408>>>>>>>>>        
26408>>>>>>>>>        Property Boolean pbAllowDeleteRow False   // Allows deleting rows.
26409>>>>>>>>>        
26409>>>>>>>>>        Property Boolean pbAllowColumnReordering True // Allows the moving of columns by dragging.
26412>>>>>>>>>        Property Boolean pbAllowColumnHiding True // Allows the showing and hiding of columns by context menu.
26415>>>>>>>>>        
26415>>>>>>>>>        Property Boolean pbStoreColumnLayout True
26418>>>>>>>>>        Property String psClientOnColumnLayoutChanged ""
26421>>>>>>>>>        Property Boolean pbServerOnColumnLayoutChanged False
26424>>>>>>>>>        
26424>>>>>>>>>        Property Boolean pbStoreGroupConfig True
26427>>>>>>>>>        Property String psClientOnGroupConfigChanged ""
26430>>>>>>>>>        Property Boolean pbServerOnGroupConfigChanged False
26433>>>>>>>>>        
26433>>>>>>>>>        Property Boolean pbServerOnGroupHeaderToggle False
26436>>>>>>>>>        
26436>>>>>>>>>        Property Boolean pbUseCustomHeaderMenu False
26437>>>>>>>>>        Property Boolean pbUseHeaderMenuOnWholeList False // Implicit (True) if pbShowHeader is (False)
26438>>>>>>>>>        Property Handle phPrivateDefaultHeaderMenu 0
26439>>>>>>>>>                
26439>>>>>>>>>        Set psJSClass to "df.WebList"
26440>>>>>>>>>        Set Auto_Fill_State to True                 // Indicates that server DDO should find first record in it's dataset (important to set True for constrained child grids such as Order Details, for unconstrained lists it does not matter what the value is).
26441>>>>>>>>>        Set pbShowLabel to False                    // Lists won't have a label by default
26442>>>>>>>>>        Set piColumnSpan to 0                       // Lists will span the whole width by default (0 does this)
26443>>>>>>>>>        Set piHeight to 200
26444>>>>>>>>>    End_Procedure
