47770>>>>>        // sMode = "total" or "difference"
47770>>>>>        // bTop = True for top N, False for bottom N
47770>>>>>        // iCount = how many results you want (e.g. 5)
47770>>>>>        Function SortData tListData[] aData String sMode Boolean bTop Integer iCount Returns tListData[]
47773>>>>>            Integer i j
47773>>>>>            tListData tmp
47773>>>>>            tListData tmp
47773>>>>>            tListData[] aSorted
47773>>>>>            tListData[] aSorted
47774>>>>>            
47774>>>>>            Move aData to aSorted
47775>>>>>            
47775>>>>>            // Bubble sort
47775>>>>>            For i from 0 to (SizeOfArray(aSorted) - 2)
47781>>>>>>
47781>>>>>                For j from i to (SizeOfArray(aSorted) - 1)
47787>>>>>>
47787>>>>>            
47787>>>>>                    Number valueCurrent
47787>>>>>                    Number valueCompared
47787>>>>>            
47787>>>>>                    If (sMode = "difference") Begin
47789>>>>>                        Move (aSorted[i].nValue - aSorted[i].nCompValue) to valueCurrent
47790>>>>>                        Move (aSorted[j].nValue - aSorted[j].nCompValue) to valueCompared
47791>>>>>                    End
47791>>>>>>
47791>>>>>                    Else Begin
47792>>>>>                        Move aSorted[i].nValue to valueCurrent
47793>>>>>                        Move aSorted[j].nValue to valueCompared
47794>>>>>                    End
47794>>>>>>
47794>>>>>            
47794>>>>>                    Boolean bSwap
47794>>>>>                    If (bTop) Begin
47796>>>>>                        Move (valueCurrent < valueCompared) to bSwap
47797>>>>>                    End
47797>>>>>>
47797>>>>>                    Else Begin
47798>>>>>                        Move (valueCurrent > valueCompared) to bSwap
47799>>>>>                    End
47799>>>>>>
47799>>>>>            
47799>>>>>                    If (bSwap) Begin
47801>>>>>                        Move aSorted[i] to tmp
47802>>>>>                        Move aSorted[j] to aSorted[i]
47803>>>>>                        Move tmp to aSorted[j]
47804>>>>>                    End
47804>>>>>>
47804>>>>>            
47804>>>>>                Loop
47805>>>>>>
47805>>>>>            Loop
47806>>>>>>
47806>>>>>            
47806>>>>>            // Trim to top/bottom N if needed
47806>>>>>            If (iCount > 0 and SizeOfArray(aSorted) > iCount) ;                Move (ResizeArray(aSorted, iCount)) to aSorted
47809>>>>>            
47809>>>>>            Function_Return aSorted
47810>>>>>        End_Function
