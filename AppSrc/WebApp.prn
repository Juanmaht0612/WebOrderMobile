38866>>>>>>>    //
38866>>>>>>>    //  Converts the given time to an string that can be saved in the database.
38866>>>>>>>    //
38866>>>>>>>    //  Params:
38866>>>>>>>    //      dtTime  Time to convert
38866>>>>>>>    //  Returns:
38866>>>>>>>    //      String with "HH:MM:SS" format
38866>>>>>>>    //
38866>>>>>>>    Function TimeToString DateTime dtTime Returns String
38868>>>>>>>        String sHours sMinutes sSeconds
38868>>>>>>>        
38868>>>>>>>        //  Extract parts
38868>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
38869>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
38870>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
38871>>>>>>>        
38871>>>>>>>        //  Fill out with 0
38871>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
38874>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
38877>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
38880>>>>>>>        
38880>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
38881>>>>>>>    End_Function
38882>>>>>>>    
38882>>>>>>>    //
38882>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
38882>>>>>>>    //
38882>>>>>>>    //  Params:
38882>>>>>>>    //      dtTime  Datetime variable to add time to
38882>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
38882>>>>>>>    //  Returns:
38882>>>>>>>    //      dtDateTime with the loaded time
38882>>>>>>>    //
38882>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
38884>>>>>>>        String sHours sMinutes sSeconds
38884>>>>>>>        
38884>>>>>>>        //  Extract parts
38884>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
38885>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
38886>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
38887>>>>>>>        
38887>>>>>>>        //  Set to DateTime
38887>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
38888>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
38889>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
38890>>>>>>>        
38890>>>>>>>        Function_Return dtTime
38891>>>>>>>    End_Function
38892>>>>>>>End_Class
