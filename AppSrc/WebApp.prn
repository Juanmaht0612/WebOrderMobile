37752>>>>>>>    // Convert a clColor to a hex value
37752>>>>>>>    // Taken and adapted from Convetions lib
37752>>>>>>>    //
37752>>>>>>>    // iColor: The cl Color value
37752>>>>>>>    //
37752>>>>>>>    // Returns: HTML HEX color value as a string
37752>>>>>>>    Function GDIColorToHex Integer iColor Returns String
37754>>>>>>>        String sResult
37754>>>>>>>        Repeat
37754>>>>>>>>
37754>>>>>>>            Move (sResult + Mid ("0123456789ABCDEF", 1, ((iColor iand |CI$0F) + 1))) to sResult
37755>>>>>>>            Move (iColor / |CI$10) to iColor
37756>>>>>>>        Until (iColor = 0)
37758>>>>>>>
37758>>>>>>>        // Fill remaining
37758>>>>>>>        While (Length(sResult) < 6)
37762>>>>>>>            Move (sResult + "0") to sResult
37763>>>>>>>        Loop
37764>>>>>>>>
37764>>>>>>>
37764>>>>>>>        // Prepend hash symbol
37764>>>>>>>        Move ("#" + sResult) to sResult
37765>>>>>>>
37765>>>>>>>        Function_Return sResult
37766>>>>>>>    End_Function
