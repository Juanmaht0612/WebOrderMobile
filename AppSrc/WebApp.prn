57967>>>>>    Function OCXVersion Returns String
57969>>>>>        Handle hoVersionInfo
57969>>>>>        String sVersionInfo
57969>>>>>        String[] sModuleNames
57970>>>>>        Integer iVoid iModule iModules iLength
57970>>>>>        Integer iVersionMajor iVersionMinor iVersionRelease iVersionBuild
57970>>>>>        Boolean bOk
57970>>>>>
57970>>>>>        Get ProcessModules to sModuleNames
57971>>>>>        Move (SizeOfArray (sModuleNames)) to iModules
57972>>>>>        Decrement iModules
57973>>>>>        For iModule from 0 to iModules
57979>>>>>>
57979>>>>>            If (sModuleNames[iModule] contains C_DR_OCX_NAME) Begin
57981>>>>>                Get Create (RefClass (cVersionInfo)) to hoVersionInfo
57982>>>>>                Send DoCreate of hoVersionInfo sModuleNames[iModule]
57983>>>>>                Get pbIncluded of hoVersionInfo to bOk
57984>>>>>                If (bOk) Begin
57986>>>>>                    Get piVersionMajor of hoVersionInfo to iVersionMajor
57987>>>>>                    Get piVersionMinor of hoVersionInfo to iVersionMinor
57988>>>>>                    Get piVersionRelease of hoVersionInfo to iVersionRelease
57989>>>>>                    Get piVersionBuild of hoVersionInfo to iVersionBuild
57990>>>>>                    Move (SFormat ("%1.%2.%3.%4", iVersionMajor, iVersionMinor, iVersionRelease, iVersionBuild)) to sVersionInfo
57991>>>>>                End
57991>>>>>>
57991>>>>>                Send Destroy of hoVersionInfo
57992>>>>>                Function_Return sVersionInfo
57993>>>>>            End
57993>>>>>>
57993>>>>>        Loop
57994>>>>>>
57994>>>>>
57994>>>>>        Function_Return ""
57995>>>>>    End_Function
57996>>>>>
57996>>>>>    Function OpenReport Returns String
57998>>>>>        Boolean bOk bCreated bExists bCanceled bAutoLocateDFFiles bHasErrors
57998>>>>>        String sReportId sReport sReportPaths sReportPath sDataPath sDirectorySeparator
57998>>>>>        Handle hoWorkspace
57998>>>>>        Integer iPaths iPath
57998>>>>>
57998>>>>>        Send RedirectErrorsToLocalHandler True
57999>>>>>
57999>>>>>        Set pbCanceled to False // default
58000>>>>>
58000>>>>>        // Create com object if not done yet
58000>>>>>        Get IsComObjectCreated to bCreated
58001>>>>>        If (not (bCreated)) Begin
58003>>>>>            Send CreateComObject
58004>>>>>            Get IsComObjectCreated to bCreated
58005>>>>>            If (not (bCreated)) Begin
58007>>>>>                Procedure_Return ''
58008>>>>>            End
58008>>>>>>
58008>>>>>        End
58008>>>>>>
58008>>>>>
58008>>>>>        Move True to bOk
58009>>>>>
58009>>>>>        Get psReportId to sReportId
58010>>>>>        If (sReportId <> "") Begin
58012>>>>>            Send CloseReport sReportId
58013>>>>>            Move '' to sReportId
58014>>>>>        End
58014>>>>>>
58014>>>>>
58014>>>>>        Send OnPreOpenReport
58015>>>>>
58015>>>>>        // Open report
58015>>>>>        Get psReportName to sReport
58016>>>>>
58016>>>>>        Move (SysConf (SYSCONF_DIR_SEPARATOR)) to sDirectorySeparator
58017>>>>>        If (Pos (sDirectorySeparator, sReport) > 0) Begin
58019>>>>>            File_Exist sReport bExists
58020>>>>>        End
58020>>>>>>
58020>>>>>        Else Begin
58021>>>>>            Move False to bExists
58022>>>>>        End
58022>>>>>>
58022>>>>>
58022>>>>>        If (bExists) Begin
58024>>>>>            Move sReport to sReportPath
58025>>>>>        End
58025>>>>>>
58025>>>>>        Else Begin
58026>>>>>            Get psReportPath to sReportPath
58027>>>>>            If (sReportPath <> "") Begin
58029>>>>>                If (ghoApplication) Begin
58031>>>>>                    Get phoWorkspace of ghoApplication to hoWorkspace
58032>>>>>                    Get CountOfPaths of hoWorkspace sReportPath to iPaths
58033>>>>>                    If (iPaths > 1) Begin
58035>>>>>                        Move sReportPath to sReportPaths
58036>>>>>                        For iPath from 1 to iPaths
58042>>>>>>
58042>>>>>                            Get PathAtIndex of hoWorkspace sReportPaths iPath to sReportPath
58043>>>>>                            Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58044>>>>>                            If (bExists) ;                                Break
58047>>>>>                        Loop
58048>>>>>>
58048>>>>>                    End
58048>>>>>>
58048>>>>>                    Else Begin
58049>>>>>                        Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58050>>>>>                    End
58050>>>>>>
58050>>>>>                End
58050>>>>>>
58050>>>>>                Else Begin
58051>>>>>                    Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58052>>>>>                End
58052>>>>>>
58052>>>>>            End
58052>>>>>>
58052>>>>>
58052>>>>>            If (not (bExists)) Begin
58054>>>>>                If (ghoApplication) Begin
58056>>>>>                    // If no path was given, see if the report sits in a folder named Reports sub-folder of the workspace root
58056>>>>>                    Get ReportsFolder to sReportPath
58057>>>>>                    If (sReportPath <> '') Begin
58059>>>>>                        Get phoWorkspace of ghoApplication to hoWorkspace
58060>>>>>                        Get CountOfPaths of hoWorkspace sReportPath to iPaths
58061>>>>>                        If (iPaths > 1) Begin
58063>>>>>                            Move sReportPath to sReportPaths
58064>>>>>                            For iPath from 1 to iPaths
58070>>>>>>
58070>>>>>                                Get PathAtIndex of hoWorkspace sReportPaths iPath to sReportPath
58071>>>>>                                Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58072>>>>>                                If (bExists) ;                                    Break
58075>>>>>                            Loop
58076>>>>>>
58076>>>>>                        End
58076>>>>>>
58076>>>>>                        Else Begin
58077>>>>>                            Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58078>>>>>                        End
58078>>>>>>
58078>>>>>                    End
58078>>>>>>
58078>>>>>
58078>>>>>                    If (not (bExists)) Begin
58080>>>>>                        // If the report is still not found, see if it resides in one of the datapaths of the workspace
58080>>>>>                        Get phoWorkspace of ghoApplication to hoWorkspace
58081>>>>>                        Get psDataPath of hoWorkspace to sDataPath
58082>>>>>                        Get CountOfPaths of hoWorkspace sDataPath to iPaths
58083>>>>>                        // Iterate through each datapath until report is located
58083>>>>>                        For iPath from 1 to iPaths
58089>>>>>>
58089>>>>>                            Get PathAtIndex of hoWorkspace sDataPath iPath to sReportPath
58090>>>>>                            Get ReportFileExist (&sReportPath) sDirectorySeparator sReport to bExists
58091>>>>>                            If (bExists) ;                                Break
58094>>>>>                        Loop
58095>>>>>>
58095>>>>>                    End
58095>>>>>>
58095>>>>>                End
58095>>>>>>
58095>>>>>            End
58095>>>>>>
58095>>>>>        End
58095>>>>>>
58095>>>>>
58095>>>>>        If (not (bExists)) Begin
58097>>>>>            Move False to bOk
58098>>>>>            Error DFERR_DATAFLEX_REPORTS (SFormat (C_$UnabletoLocateReport, sReport))
58099>>>>>>
58099>>>>>        End
58099>>>>>>
58099>>>>>
58099>>>>>        // If Report was found, open it.
58099>>>>>        If (bOk) Begin
58101>>>>>            // open report
58101>>>>>            Get ComReportOpenFromFile sReportPath to sReportId
58102>>>>>            Move (sReportId <> "") to bOk
58103>>>>>            If (bOk) Begin
58105>>>>>                Set psReportId to sReportId
58106>>>>>                Get pbAutoLocateDFFiles to bAutoLocateDFFiles
58107>>>>>                If (bAutoLocateDFFiles) Begin
58109>>>>>                    Send AutoLocateDFFiles sReportId
58110>>>>>                End
58110>>>>>>
58110>>>>>            End
58110>>>>>>
58110>>>>>            If (not (bOk)) Begin
58112>>>>>                Get pbHasErrors to bHasErrors
58113>>>>>                Move (not (bHasErrors)) to bOk
58114>>>>>                If (not (bOk)) Begin
58116>>>>>                    Error DFERR_DATAFLEX_REPORTS (SFormat (C_$ErrorOpeningReport, sReportPath))
58117>>>>>>
58117>>>>>                End
58117>>>>>>
58117>>>>>            End
58117>>>>>>
58117>>>>>        End
58117>>>>>>
58117>>>>>
58117>>>>>        If (bOk) Begin
58119>>>>>            // Set report location
58119>>>>>            Move (ExtractFilePath (sReportPath)) to sReportPath
58120>>>>>            Set psReportLocation to sReportPath
58121>>>>>        End
58121>>>>>>
58121>>>>>
58121>>>>>        If (bOk) Begin
58123>>>>>            Send OnInitializeReport
58124>>>>>            Get pbCanceled to bCanceled
58125>>>>>            If (bCanceled) Begin
58127>>>>>                Move False to bOk
58128>>>>>            End
58128>>>>>>
58128>>>>>        End
58128>>>>>>
58128>>>>>
58128>>>>>        // we check pbCanceled once more at the at end of the process. It is possible that OnError is setting this
58128>>>>>        // to True and that could happen any time. So we check at the very last moment here.
58128>>>>>        If (bOk) Begin
58130>>>>>            Get pbCanceled to bCanceled
58131>>>>>            If (bCanceled) Begin
58133>>>>>                Move False to bOk
58134>>>>>            End
58134>>>>>>
58134>>>>>        End
58134>>>>>>
58134>>>>>
58134>>>>>        If (not (bOk)) Begin
58136>>>>>            If (sReportId <> "") Begin
58138>>>>>                Send CloseReport sReportId
58139>>>>>                Move "" to sReportId
58140>>>>>            End
58140>>>>>>
58140>>>>>        End
58140>>>>>>
58140>>>>>
58140>>>>>        Send RedirectErrorsToLocalHandler False
58141>>>>>
58141>>>>>
58141>>>>>        Function_Return sReportId
58142>>>>>    End_Function
58143>>>>>
58143>>>>>    Procedure OutputReport
58145>>>>>        Integer eDestination eExportType
58145>>>>>        String sFileName
58145>>>>>        Handle hPrintDlg hoExportOptionsDialog
58145>>>>>
58145>>>>>        Send RedirectErrorsToLocalHandler True
58146>>>>>
58146>>>>>        Send RefreshReport
58147>>>>>
58147>>>>>        Get peOutputDestination to eDestination
58148>>>>>        Case Begin
58148>>>>>            Case (eDestination = PRINT_TO_PRINTER)
58150>>>>>                Get phPrintDlg to hPrintDlg
58151>>>>>                Send PrintReport hPrintDlg
58152>>>>>                Case Break
58153>>>>>            Case (eDestination = PRINT_TO_PRINTER_NO_DIALOG)
58156>>>>>                Send PrintToDefaultPrinter
58157>>>>>                Case Break
58158>>>>>            Case (eDestination = PRINT_TO_FILE)
58161>>>>>                Get peExportType to eExportType
58162>>>>>                If (eExportType >= C_DRPDF and eExportType <= C_DRRTF) Begin
58164>>>>>                    Get psExportFileName to sFileName
58165>>>>>                    If (sFileName <> "") Begin
58167>>>>>                        Send ExportReport eExportType sFileName
58168>>>>>                    End
58168>>>>>>
58168>>>>>                End
58168>>>>>>
58168>>>>>                Else Begin
58169>>>>>                    Error DFERR_DATAFLEX_REPORTS (SFormat (C_$DRNoValidExportTypeSpecified, eExportType))
58170>>>>>>
58170>>>>>                End
58170>>>>>>
58170>>>>>                Case Break
58171>>>>>            Case Else
58171>>>>>                Error DFERR_DATAFLEX_REPORTS (SFormat (C_$DRNoValidPrintDestinationDefined, eDestination))
58172>>>>>>
58172>>>>>                Case Break
58173>>>>>        Case End
58173>>>>>
58173>>>>>        Send RedirectErrorsToLocalHandler False
58174>>>>>    End_Procedure
58175>>>>>
58175>>>>>    Function PageLayerCount String sReportId Returns Integer
58177>>>>>        Integer iPageLayers
58177>>>>>        Boolean bComObjectCreated
58177>>>>>
58177>>>>>        Send RedirectErrorsToLocalHandler True
58178>>>>>
