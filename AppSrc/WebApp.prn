58194>>>>>    Function PageLayerId String sReportId Integer iPageLayer Returns String
58196>>>>>        String sPageLayerID
58196>>>>>        Integer iPageLayerCount
58196>>>>>        Boolean bComObjectCreated
58196>>>>>
