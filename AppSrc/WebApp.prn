29574>>>>>>>>>>>        // Parses a content-type header string and splits it into just the content-type (put into 
29574>>>>>>>>>>>    // sContenttype passed by reference) and returns an array of name value pairs that were in the 
29574>>>>>>>>>>>    // content-type string.
29574>>>>>>>>>>>    Function ParseContentType String ByRef sContentType Returns tNameValuePair[]
29576>>>>>>>>>>>        tNameValuePair[] aValues
29576>>>>>>>>>>>        tNameValuePair[] aValues
29577>>>>>>>>>>>        String[] aParts aPair
29579>>>>>>>>>>>        Integer iPart iVal
29579>>>>>>>>>>>        
29579>>>>>>>>>>>        Move (StrSplitToArray(sContentType, ";")) to aParts
29580>>>>>>>>>>>        If (SizeOfArray(aParts) > 0) Begin
29582>>>>>>>>>>>            Move aParts[0] to sContentType
29583>>>>>>>>>>>            
29583>>>>>>>>>>>            For iPart from 1 to (SizeOfArray(aParts) - 1)
29589>>>>>>>>>>>>
29589>>>>>>>>>>>                Move (StrSplitToArray(aParts[iPart], "=")) to aPair
29590>>>>>>>>>>>                If (SizeOfArray(aPair) > 1) Begin
29592>>>>>>>>>>>                    Move (Trim(Uppercase(aPair[0]))) to aValues[iVal].sName
29593>>>>>>>>>>>                    Move (Trim(aPair[1])) to aValues[iVal].sValue
29594>>>>>>>>>>>                End
29594>>>>>>>>>>>>
29594>>>>>>>>>>>            Loop
29595>>>>>>>>>>>>
29595>>>>>>>>>>>        End
29595>>>>>>>>>>>>
29595>>>>>>>>>>>        
29595>>>>>>>>>>>        Function_Return aValues
29596>>>>>>>>>>>    End_Function
