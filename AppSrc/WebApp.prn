55834>>>>>    Function ProcessModules Returns String[]
55836>>>>>        DWord dwProcessId
55836>>>>>        Handle hProcess
55836>>>>>        Handle[] hModules
55837>>>>>        Integer iSize iVoid iModules iModule iLength
55837>>>>>        Boolean bOk
55837>>>>>        WString wModuleName
55837>>>>>        String[] sModuleNames
55838>>>>>
55838>>>>>        Move (DR_WinAPI_GetCurrentProcessId ()) to dwProcessId
55839>>>>>        If (dwProcessId <> 0) Begin
55841>>>>>            Move (DR_WinAPI_OpenProcess (PROCESS_VM_READ + PROCESS_QUERY_INFORMATION, False, dwProcessId)) to hProcess
55842>>>>>            If (hProcess <> 0) Begin
55844>>>>>                Move 0 to iSize
55845>>>>>                Move (DR_WinAPI_EnumProcessModules (hProcess, AddressOf (hModules), 0, AddressOf (iSize))) to bOk
55846>>>>>                If (not (bOk)) Begin
55848>>>>>                    Get ShowLastError to iVoid
55849>>>>>                End
55849>>>>>>
55849>>>>>                Else Begin
55850>>>>>                    Move (iSize / SizeOfType (Handle)) to iModules
55851>>>>>                    Move (ResizeArray (hModules, iModules)) to hModules
55852>>>>>                    Move (DR_WinAPI_EnumProcessModules (hProcess, AddressOf (hModules), iSize, AddressOf (iSize))) to bOk
55853>>>>>                    If (not (bOk)) Begin
55855>>>>>                        Get ShowLastError to iVoid
55856>>>>>                    End
55856>>>>>>
55856>>>>>                    Else Begin
55857>>>>>                        Move (ResizeArray (sModuleNames, iModules, Repeat (Character (0), MAX_PATH))) to sModuleNames
55858>>>>>                        Decrement iModules
55859>>>>>                        For iModule from 0 to iModules
55865>>>>>>
55865>>>>>                            Move (Repeat (Character (0), MAX_PATH)) to wModuleName
55866>>>>>                            Move (GetModuleFileNameW (hModules[iModule], AddressOf (wModuleName), MAX_PATH)) to iLength
55867>>>>>                            Move wModuleName to sModuleNames[iModule]
55868>>>>>                        Loop
55869>>>>>>
55869>>>>>                    End
55869>>>>>>
55869>>>>>                End
55869>>>>>>
55869>>>>>                Move (DR_WinAPI_CloseHandle (hProcess)) to bOk
55870>>>>>            End
55870>>>>>>
55870>>>>>        End
55870>>>>>>
55870>>>>>
55870>>>>>        Function_Return sModuleNames
55871>>>>>    End_Function
