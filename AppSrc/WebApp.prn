47183>>>>>    Procedure Update
47185>>>>>        String sTileType sFilter sTotal sDifference
47185>>>>>        Boolean bPos
47185>>>>>        Number nTotal nDifference
47185>>>>>        DateTime dtStart dtEnd dtCompStart dtCompEnd
47185>>>>>        
47185>>>>>        WebSet pbRender of oGraphic to True
47186>>>>>        WebSet piColumnSpan of oContent to 3
47187>>>>>        WebSet piColumnIndex of oContent to 2
47188>>>>>        
47188>>>>>        WebGet psTileType to sTileType
47189>>>>>        Delegate Get WidgetDateFilter to sFilter
47191>>>>>        
47191>>>>>        Get StartDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtStart
47192>>>>>        Get EndDateByFilterType   of oWidgetFilterAndDateFormatHandler sFilter to dtEnd
47193>>>>>        Get CompareStartDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtCompStart
47194>>>>>        Get CompareEndDateByFilterType of oWidgetFilterAndDateFormatHandler sFilter to dtCompEnd
47195>>>>>        
47195>>>>>        Case Begin
47195>>>>>            Case (sTileType = "TotalRevenue")
47197>>>>>                Get EarningsData dtStart dtEnd dtCompStart dtCompEnd (&nTotal) (&nDifference) to bPos 
47198>>>>>                WebSet psCaption of oHeader to "Total revenue"
47199>>>>>                Move (FormatCurrency(nTotal, 2)) to sTotal
47200>>>>>                Move (FormatCurrency(nDifference, 2)) to sDifference
47201>>>>>                
47201>>>>>                If (nDifference >= 0) Begin
47203>>>>>                    WebSet psURL of oGraphic to "images/Arrow_Up.svg"
47204>>>>>                    WebSet psBackgroundColor to "#55A346"
47205>>>>>                    
47205>>>>>                    Move ("+ " + sDifference) to sDifference
47206>>>>>                End
47206>>>>>>
47206>>>>>                Else Begin
47207>>>>>                    WebSet psURL of oGraphic to "images/Arrow_Down.svg"
47208>>>>>                    WebSet psBackgroundColor to "var(--df-ErrorRegular)"
47209>>>>>                    
47209>>>>>                    Move (Replace("(", sDifference, "")) to sDifference
47210>>>>>                    Move (Replace(")", sDifference, "")) to sDifference
47211>>>>>                    Move ("- " + sDifference) to sDifference
47212>>>>>                End
47212>>>>>>
47212>>>>>                
47212>>>>>                WebSet psHtml of oContent to (SFormat("<div><h1>%1</h1><h3>%2</h3></div>", sTotal, sDifference))
47213>>>>>            Case Break
47214>>>>>                
47214>>>>>            Case (sTileType = "OrderTotals")
47217>>>>>                Get OrderCountData dtStart dtEnd dtCompStart dtCompEnd (&nTotal) (&nDifference) to bPos
47218>>>>>                WebSet psCaption of oHeader to "Total Orders"
47219>>>>>                Move (String(nTotal)) to sTotal  
47220>>>>>                
47220>>>>>                If (nDifference >= 0) Begin
47222>>>>>                    WebSet psURL of oGraphic to "images/Arrow_Up.svg"
47223>>>>>                    WebSet psBackgroundColor to "#55A346"
47224>>>>>                    
47224>>>>>                    WebSet psHtml of oContent to (SFormat("<div><h1>%1</h1><h3>+ %2</h3></div>", sTotal, nDifference))
47225>>>>>                End
47225>>>>>>
47225>>>>>                Else Begin
47226>>>>>                    WebSet psURL of oGraphic to "images/Arrow_Down.svg"
47227>>>>>                    WebSet psBackgroundColor to "var(--df-ErrorRegular)"
47228>>>>>                    
47228>>>>>                    WebSet psHtml of oContent to (SFormat("<div><h1>%1</h1><h3>%2</h3></div>", sTotal, nDifference))
47229>>>>>                End                
47229>>>>>>
47229>>>>>            Case Break
47230>>>>>            
47230>>>>>            Case (sTileType = "LowInventory")
47233>>>>>                Get LowInventoryData to nTotal
47234>>>>>                WebSet psCaption of oHeader to "Low Inventory Count"
47235>>>>>                Move (String(nTotal)) to sTotal
47236>>>>>                
47236>>>>>                If (nTotal > 0) Begin
47238>>>>>                    WebSet psURL of oGraphic to "images/Warning.svg"
47239>>>>>                    WebSet psBackgroundColor to "var(--df-WarningRegular)"
47240>>>>>                End 
47240>>>>>>
47240>>>>>                Else Begin
47241>>>>>                    WebSet psURL of oGraphic to "images/Check.svg"
47242>>>>>                    WebSet psBackgroundColor to "#55A346"
47243>>>>>                End
47243>>>>>>
47243>>>>>                
47243>>>>>                WebSet psHtml of oContent to (SFormat("<div><h1>%1</h1></div>", sTotal))
47244>>>>>            Case Break
47245>>>>>        Case End        
47245>>>>>    End_Procedure
