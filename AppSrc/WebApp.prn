22373>>>>>>>>>>>>>>>    //
22373>>>>>>>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetScalarSyncProp)
22373>>>>>>>>>>>>>>>    //
22373>>>>>>>>>>>>>>>    // Params:
22373>>>>>>>>>>>>>>>    //      hoObject   - Is handle to the object which owns the property.
22373>>>>>>>>>>>>>>>    //      hmGetter   - Is a handle to the property's getter message.
22373>>>>>>>>>>>>>>>    //      sPropName  - Is the (case sensitive) property name.
22373>>>>>>>>>>>>>>>    //      sPropValue - Is the property value.
22373>>>>>>>>>>>>>>>    //
22373>>>>>>>>>>>>>>>    // Use the WebSet command instead of sending this message.
22373>>>>>>>>>>>>>>>    //
22373>>>>>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Variant vPropValue
22375>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSyncPropIndex iStoreIndex
22375>>>>>>>>>>>>>>>        Integer icObject iIndex iCount iSize
22375>>>>>>>>>>>>>>>        Boolean bFoundSyncProp bSaveProp bIsAjaxWebObject
22375>>>>>>>>>>>>>>>        String sUC_PropName sObject sPropValue
22375>>>>>>>>>>>>>>>        tWebValueTree tVT
22375>>>>>>>>>>>>>>>        tWebValueTree tVT
22375>>>>>>>>>>>>>>>        Variant vTest
22375>>>>>>>>>>>>>>>        
22375>>>>>>>>>>>>>>>        // Test if we are active....
22375>>>>>>>>>>>>>>>        Get Object_Label of hoObject to sObject
22376>>>>>>>>>>>>>>>
22376>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22378>>>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppSynPropsNotReady, sObject, "WebSet " + pubProp.sName))
22379>>>>>>>>>>>>>>>>
22379>>>>>>>>>>>>>>>            Procedure_Return
22380>>>>>>>>>>>>>>>        End
22380>>>>>>>>>>>>>>>>
22380>>>>>>>>>>>>>>>
22380>>>>>>>>>>>>>>>
22380>>>>>>>>>>>>>>>        // Try to find the the sync prop in the published props array...
22380>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22381>>>>>>>>>>>>>>>        
22381>>>>>>>>>>>>>>>        //  Determine if advanced (struct / array) property
22381>>>>>>>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
22383>>>>>>>>>>>>>>>            //  Find advanced sync prop in the cache
22383>>>>>>>>>>>>>>>            Get FindAdvPropCache hoObject pubProp.sName to iProp
22384>>>>>>>>>>>>>>>            //  If not found then add it to the cache
22384>>>>>>>>>>>>>>>            If (iProp = -1) Begin
22386>>>>>>>>>>>>>>>                // Add the property....
22386>>>>>>>>>>>>>>>                Get AddToAdvPropCache hoObject pubProp.sName to iProp
22387>>>>>>>>>>>>>>>            End
22387>>>>>>>>>>>>>>>>
22387>>>>>>>>>>>>>>>            
22387>>>>>>>>>>>>>>>            //  Store the value and mark as changed
22387>>>>>>>>>>>>>>>            Move vPropValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
22388>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
22389>>>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bChanged
22390>>>>>>>>>>>>>>>        End
22390>>>>>>>>>>>>>>>>
22390>>>>>>>>>>>>>>>        Else Begin
22391>>>>>>>>>>>>>>>            // get the sync props index for the passed object handle...
22391>>>>>>>>>>>>>>>            Move (Uppercase(pubProp.sName)) to sUC_PropName
22392>>>>>>>>>>>>>>>            Move False to bSaveProp
22393>>>>>>>>>>>>>>>            Get piSize to iSize
22394>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22394>>>>>>>>>>>>>>>            Get FindObjectIndex hoObject to iObjectIndex
22395>>>>>>>>>>>>>>>            
22395>>>>>>>>>>>>>>>            If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22397>>>>>>>>>>>>>>>                Get AddObjectToSyncProps hoObject to iObjectIndex
22398>>>>>>>>>>>>>>>            End
22398>>>>>>>>>>>>>>>>
22398>>>>>>>>>>>>>>>            
22398>>>>>>>>>>>>>>>            // Test iObjectIndex again as it might have changed (above)....
22398>>>>>>>>>>>>>>>            If (iObjectIndex <> -1) Begin
22400>>>>>>>>>>>>>>>                // Send Hook for converting the value to format for transport.
22400>>>>>>>>>>>>>>>                Get ConvertToTransport of hoObject pubProp.hmGetter vPropValue pubProp.eType  to sPropValue
22401>>>>>>>>>>>>>>>                
22401>>>>>>>>>>>>>>>                // Search for the property name....
22401>>>>>>>>>>>>>>>                Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22402>>>>>>>>>>>>>>>                Move False to bFoundSyncProp
22403>>>>>>>>>>>>>>>                
22403>>>>>>>>>>>>>>>                For iProp from 0 to (icProp - 1)
22409>>>>>>>>>>>>>>>>
22409>>>>>>>>>>>>>>>                    If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22411>>>>>>>>>>>>>>>                        Move iProp to iSyncPropIndex
22412>>>>>>>>>>>>>>>                        Move True to bFoundSyncProp
22413>>>>>>>>>>>>>>>                    End
22413>>>>>>>>>>>>>>>>
22413>>>>>>>>>>>>>>>                    If (bFoundSyncProp) ;                        Break
22416>>>>>>>>>>>>>>>                Loop
22417>>>>>>>>>>>>>>>>
22417>>>>>>>>>>>>>>>                
22417>>>>>>>>>>>>>>>                If (bFoundSyncProp) Begin
22419>>>>>>>>>>>>>>>                    // Case 1: Object and Property found in gaSyncProps
22419>>>>>>>>>>>>>>>                    // Update the found property....
22419>>>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[iSyncPropIndex].sV
22420>>>>>>>>>>>>>>>                    Move True to bSaveProp
22421>>>>>>>>>>>>>>>                End
22421>>>>>>>>>>>>>>>>
22421>>>>>>>>>>>>>>>                Else Begin
22422>>>>>>>>>>>>>>>                    // Case 2: The Property needs to be added to sync props array
22422>>>>>>>>>>>>>>>                    // Add the property....
22422>>>>>>>>>>>>>>>                    Move pubProp.sName to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sN    // Use the original case of the property name
22423>>>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sV
22424>>>>>>>>>>>>>>>                    Move icProp to iSyncPropIndex
22425>>>>>>>>>>>>>>>                    Move True to bSaveProp
22426>>>>>>>>>>>>>>>                End
22426>>>>>>>>>>>>>>>>
22426>>>>>>>>>>>>>>>                
22426>>>>>>>>>>>>>>>                If (bSaveProp) Begin
22428>>>>>>>>>>>>>>>                    // Update the changed props array....
22428>>>>>>>>>>>>>>>                    Move True to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges     // Mark the object as changed
22429>>>>>>>>>>>>>>>                    Move (SearchArray(iSyncPropIndex, gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iIndex
22430>>>>>>>>>>>>>>>                    
22430>>>>>>>>>>>>>>>                    If (iIndex = -1) Begin
22432>>>>>>>>>>>>>>>                        // Add the property name to the changed props array....
22432>>>>>>>>>>>>>>>                        Move (SizeOfArray(gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iCount
22433>>>>>>>>>>>>>>>                        Move iSyncPropIndex to gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex[iCount]
22434>>>>>>>>>>>>>>>                    End
22434>>>>>>>>>>>>>>>>
22434>>>>>>>>>>>>>>>                End
22434>>>>>>>>>>>>>>>>
22434>>>>>>>>>>>>>>>            End
22434>>>>>>>>>>>>>>>>
22434>>>>>>>>>>>>>>>            Else Begin
22435>>>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, (sObject + " (WebSet " + pubProp.sName+")") ))
22436>>>>>>>>>>>>>>>>
22436>>>>>>>>>>>>>>>            End
22436>>>>>>>>>>>>>>>>
22436>>>>>>>>>>>>>>>        End
22436>>>>>>>>>>>>>>>>
22436>>>>>>>>>>>>>>>        
22436>>>>>>>>>>>>>>>    End_Procedure
