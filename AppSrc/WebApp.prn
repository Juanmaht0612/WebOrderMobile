25012>>>>>>>>>>>>>>>        
25012>>>>>>>>>>>>>>>        Property String psAdvancedSearchText        C_$AdvancedSearch        
25015>>>>>>>>>>>>>>>
25015>>>>>>>>>>>>>>>        Property Boolean pbShowSuggestionsOnFocus
