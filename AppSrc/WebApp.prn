32972>>>>>>>    Procedure RequestClearExec
32974>>>>>>>        String sCurrentRowID
32974>>>>>>>        RowID riCurrentRowID
32974>>>>>>>        Handle hoDD
32974>>>>>>>        Integer iMainFile
32974>>>>>>>        Boolean bOldGridAction bContinue bDataAware bSuccess
32974>>>>>>>
32974>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
32975>>>>>>>        Get OnClearRow sCurrentRowID to bContinue
32976>>>>>>>        
32976>>>>>>>        Get pbDataAware to bDataAware
32977>>>>>>>        If (bDataAware) Begin
32979>>>>>>>            // db-aware....
32979>>>>>>>            If (bContinue) Begin
32981>>>>>>>                //  Set to prevent the entire grid from refreshing
32981>>>>>>>                Get Server to hoDD        
32982>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
32983>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
32984>>>>>>>                Set pbNotifyingExternalDD to True
32985>>>>>>>                
32985>>>>>>>                //  Refind the current record
32985>>>>>>>                If (IsNullRowID(riCurrentRowID)) Begin
32987>>>>>>>                    Send Clear of hoDD
32988>>>>>>>                End
32988>>>>>>>>
32988>>>>>>>                Else Begin
32989>>>>>>>                    Get Main_File of hoDD to iMainFile
32990>>>>>>>                    Get FindByRowIdEx of hoDD iMainFile riCurrentRowID to bSuccess
32991>>>>>>>                    If not bSuccess Begin
32993>>>>>>>                        Set pbNotifyingExternalDD to False
32994>>>>>>>                        Send ReportCacheError
32995>>>>>>>                    End
32995>>>>>>>>
32995>>>>>>>                End
32995>>>>>>>>
32995>>>>>>>            
32995>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
32996>>>>>>>            End
32996>>>>>>>>
32996>>>>>>>        End
32996>>>>>>>>
32996>>>>>>>        Else Begin
32997>>>>>>>            // non-db aware...
32997>>>>>>>            If (bContinue) Begin
32999>>>>>>>                Send ClearRow sCurrentRowID
33000>>>>>>>            End
33000>>>>>>>>
33000>>>>>>>        End
33000>>>>>>>>
33000>>>>>>>    End_Procedure
33001>>>>>>>
33001>>>>>>>    
33001>>>>>>>    // Clear Logic which basically means refinding the current record.
33001>>>>>>>    // returns True if the clear was successful, False if we are not sure because there is a callback or clear actually failed
33001>>>>>>>    Function ClearSelectedRow Returns Integer
33003>>>>>>>        Handle hoDD hmVerify
33003>>>>>>>        String sCurrentRowID
33003>>>>>>>        Boolean bDataAware bChanged
33003>>>>>>>        Integer iReturn
33003>>>>>>>
33003>>>>>>>        // Manual data handling?
33003>>>>>>>        Get Verify_Data_Loss_Msg to hmVerify
33004>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
33005>>>>>>>        Get pbDataAware to bDataAware
33006>>>>>>>        
33006>>>>>>>        Get ShouldSaveRow to bChanged
33007>>>>>>>        
33007>>>>>>>        If (bChanged) Begin
33009>>>>>>>            If (bDataAware) Begin
33011>>>>>>>                // db-aware..
33011>>>>>>>                Get Server to hoDD
33012>>>>>>>                If (hoDD <> 0) Begin
33014>>>>>>>                    If hmVerify Begin
33016>>>>>>>                        Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
33017>>>>>>>                        Function_Return sroPending // this means there is a verification so we don't know yet
33018>>>>>>>                    End
33018>>>>>>>>
33018>>>>>>>                    Else Begin
33019>>>>>>>                        Send RequestClearExec
33020>>>>>>>                        If (Should_Save_Row(hoDD)) Begin
33022>>>>>>>                            Function_Return sroFail // this means it actually failed
33023>>>>>>>                        End
33023>>>>>>>>
33023>>>>>>>                    End
33023>>>>>>>>
33023>>>>>>>                End
33023>>>>>>>>
33023>>>>>>>                Function_Return sroSucceed
33024>>>>>>>            End
33024>>>>>>>>
33024>>>>>>>            Else Begin
33025>>>>>>>                // non db-aware..
33025>>>>>>>                If hmVerify Begin
33027>>>>>>>                    Send VerifyRequest (RefProc(RequestClearCallBack)) (RefFunc(Verify_Data_Loss_Msg))
33028>>>>>>>                    Function_Return sroPending // this means there is a verification so we don't know yet
33029>>>>>>>                End
33029>>>>>>>>
33029>>>>>>>                Else Begin
33030>>>>>>>                    Send RequestClearExec
33031>>>>>>>                    // Currently we always consider that a clear succeeds. This is probably as safe
33031>>>>>>>                    // assumption but might be revisited in the future.
33031>>>>>>>                    Function_Return sroSucceed
33032>>>>>>>                End
33032>>>>>>>>
33032>>>>>>>            End
33032>>>>>>>>
33032>>>>>>>        End
33032>>>>>>>>
33032>>>>>>>      
33032>>>>>>>        Function_Return sroSucceed
33033>>>>>>>    End_Function
33034>>>>>>>    
33034>>>>>>>    // Client action to remove the passed row from the cache. 
33034>>>>>>>    Procedure ClearRow String sRowID
33036>>>>>>>        String[] aParams
33037>>>>>>>        
33037>>>>>>>        Move sRowID to aParams[0]
33038>>>>>>>        Send ClientAction "clearRow" aParams    
33039>>>>>>>    End_Procedure
33040>>>>>>>
33040>>>>>>>
33040>>>>>>>    
33040>>>>>>>    Procedure RequestSaveExec
33042>>>>>>>        Handle hoServer 
33042>>>>>>>        String sCurrentRowID sOrigRowID
33042>>>>>>>        Boolean bDataAware bContinue bError bUnOrdered bAutoRegenerate
33042>>>>>>>
33042>>>>>>>        WebGet psCurrentRowId to sOrigRowID
33043>>>>>>>        Move sOrigRowID to sCurrentRowID
33044>>>>>>>        
33044>>>>>>>        Get OnSaveRow (&sCurrentRowID) to bContinue
33045>>>>>>>        WebSet psCurrentRowId to sCurrentRowID   
33046>>>>>>>        
33046>>>>>>>        // db-aware....
33046>>>>>>>        Move (not(bContinue)) to bError
33047>>>>>>>        Get pbDataAware to bDataAware
33048>>>>>>>        
33048>>>>>>>        If (bDataAware and bContinue) Begin
33050>>>>>>>            // Validate the row... 
33050>>>>>>>            Get Server to hoServer
33051>>>>>>>            Get ValidateRow to bError
33052>>>>>>>            If (bError) Begin
33054>>>>>>>                Procedure_Return
33055>>>>>>>            End    
33055>>>>>>>>
33055>>>>>>>    
33055>>>>>>>            // Perform the save....
33055>>>>>>>            Move False to  Err
33056>>>>>>>            Send Request_Save to hoServer
33057>>>>>>>            Move Err to bError
33058>>>>>>>            If not bError Begin
33060>>>>>>>                // if a successful save see if we need to refresh the list. We do i
33060>>>>>>>                // pbAutoRegenerate is True and a save has rendered it possible unordered.
33060>>>>>>>                WebGet pbUnOrdered to bUnOrdered
33061>>>>>>>                Get pbAutoRegenerate to bAutoRegenerate
33062>>>>>>>                If (bUnOrdered and bAutoRegenerate) Begin
33064>>>>>>>                    Send RefreshListFromDD
33065>>>>>>>                End
33065>>>>>>>>
33065>>>>>>>            End
33065>>>>>>>>
33065>>>>>>>        End
33065>>>>>>>>
33065>>>>>>>        
33065>>>>>>>        // Force the client to refresh the saved row (in case any values were changed).
33065>>>>>>>        If (not(bError)) Begin
33067>>>>>>>            Send UpdateRow sOrigRowID 
33068>>>>>>>        End
33068>>>>>>>>
33068>>>>>>>    End_Procedure
33069>>>>>>>        
33069>>>>>>>    // Returns sroSucceed if the save was successful. Called by Request_Save.
33069>>>>>>>    Function SaveSelectedRow Returns Integer
33071>>>>>>>        Handle hoDD hmVerify
33071>>>>>>>        RowID riCurrentRowID riTestRowID
33071>>>>>>>        String sCurrentRowID
33071>>>>>>>        Boolean bDataAware bChanged bError
33071>>>>>>>        Integer iReturn
33071>>>>>>>
33071>>>>>>>        // Manual data handling?
33071>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
33072>>>>>>>        Get pbDataAware to bDataAware
33073>>>>>>>        
33073>>>>>>>        // db-aware data handling....
33073>>>>>>>        If (bDataAware) Begin
33075>>>>>>>            Get Server to hoDD
33076>>>>>>>            
33076>>>>>>>            If (hoDD <> 0) Begin
33078>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33079>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
33080>>>>>>>                
33080>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
33082>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
33083>>>>>>>>
33083>>>>>>>                    Function_Return sroFail
33084>>>>>>>                End
33084>>>>>>>>
33084>>>>>>>                
33084>>>>>>>                // Verify that we are allowed to save....
33084>>>>>>>                If (Read_Only_State(hoDD)) Begin
33086>>>>>>>                    Function_Return sroFail         // the view should not allow this to happen
33087>>>>>>>                End
33087>>>>>>>>
33087>>>>>>>            End
33087>>>>>>>>
33087>>>>>>>        End
33087>>>>>>>>
33087>>>>>>>        
33087>>>>>>>        // If there is nothing to save, do nothing....
33087>>>>>>>        Get ShouldSaveRow to bChanged
33088>>>>>>>        If (not(bChanged)) Begin
33090>>>>>>>            Function_Return sroSucceed
33091>>>>>>>        End
33091>>>>>>>>
33091>>>>>>>        
33091>>>>>>>        // Validate the row... 
33091>>>>>>>        Get ValidateRow to bError
33092>>>>>>>        If (bError) Begin
33094>>>>>>>            Function_Return sroFail
33095>>>>>>>        End   
33095>>>>>>>>
33095>>>>>>>        
33095>>>>>>>        // perform verify callback or save now...
33095>>>>>>>        Get Verify_Save_msg to hmVerify
33096>>>>>>>        If (hmVerify) Begin
33098>>>>>>>            WebSet pbSaveCallbackActive to True
33099>>>>>>>            Send VerifyRequest (RefProc(RequestSaveCallBack)) (RefFunc(Verify_Save_msg))
33100>>>>>>>            Function_Return sroPending
33101>>>>>>>        End
33101>>>>>>>>
33101>>>>>>>        Else Begin
33102>>>>>>>            Send RequestSaveExec
33103>>>>>>>            If (bDataAware and Should_Save_Row(hoDD)) Begin
33105>>>>>>>                Function_Return sroFail
33106>>>>>>>            End
33106>>>>>>>>
33106>>>>>>>        End
33106>>>>>>>>
33106>>>>>>>        
33106>>>>>>>        Function_Return sroSucceed
33107>>>>>>>    End_Function
33108>>>>>>>    
33108>>>>>>>    // Determines if the current row has changed values in which case it should be saved. For 
33108>>>>>>>    // data-aware grids the DDO is asked to determine this. For non-data-aware grids the individual
33108>>>>>>>    // changed states of columns are queried.
33108>>>>>>>    Function ShouldSaveRow Returns Boolean
33110>>>>>>>        Handle[] aColumns
33111>>>>>>>        Integer iCol
33111>>>>>>>        Boolean bChanged
33111>>>>>>>      
33111>>>>>>>        // Test for Data-Aware grid...
33111>>>>>>>        If (pbDataAware(Self)) Begin
33113>>>>>>>            Function_Return (Should_Save_Row(Server(Self)))            
33114>>>>>>>        End
33114>>>>>>>>
33114>>>>>>>        Else Begin
33115>>>>>>>            //  Determine if a value was changed
33115>>>>>>>            Get phoColumnObjects to aColumns
33116>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
33122>>>>>>>>
33122>>>>>>>                WebGet pbChanged of aColumns[iCol] to bChanged
33123>>>>>>>                
33123>>>>>>>                If (bChanged) Begin
33125>>>>>>>                    Function_Return True
33126>>>>>>>                End
33126>>>>>>>>
33126>>>>>>>            Loop
33127>>>>>>>>
33127>>>>>>>            
33127>>>>>>>            Function_Return False
33128>>>>>>>        End
33128>>>>>>>>
33128>>>>>>>    End_Function
33129>>>>>>>
33129>>>>>>>    // Returns true if you can move off of the selected row.
33129>>>>>>>    // This gets called during a row change and returns true if the row change is allowed. You are allowed
33129>>>>>>>    // to make changes to the row such as saving or clearing before returning if the row change is allowed.
33129>>>>>>>    //
33129>>>>>>>    // The following actions are performed here:
33129>>>>>>>    // [1] - ShouldSaveRow is tested. This will test if the current row needs saving.
33129>>>>>>>    // [2] - If the row needs saving it is saved if validation passes. If not then we stop here.
33129>>>>>>>    // [3] - If we are moving to a new row then the row is cleared, loaded with default values,
33129>>>>>>>    //       and the OnNewRow event gets fired.
33129>>>>>>>    Function AllowChangeSelectedRow String sGotoRow String sToRowID Returns Boolean
33131>>>>>>>        Handle hoDD hoColumn
33131>>>>>>>        Handle hmVerify
33131>>>>>>>       
33131>>>>>>>        RowID riCurrentRowID riTestRowID
33131>>>>>>>        String sCurrentRowID
33131>>>>>>>        Boolean bAutoSave bDataAware bChanged bResult bOldGridAction
33131>>>>>>>        Integer eSelectedRowOperation iCol iTo iRowIndex
33131>>>>>>>
33131>>>>>>>        Get Server to hoDD
33132>>>>>>>        Get pbAutoSave to bAutoSave
33133>>>>>>>        Get pbDataAware to bDataAware
33134>>>>>>>        
33134>>>>>>>        //  Assertions
33134>>>>>>>        If (bDataAware) Begin
33136>>>>>>>            If (hoDD <> 0) Begin
33138>>>>>>>                WebGet psCurrentRowId to sCurrentRowID
33139>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
33140>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
33141>>>>>>>                
33141>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
33143>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
33144>>>>>>>>
33144>>>>>>>                    Function_Return False
33145>>>>>>>                End
33145>>>>>>>>
33145>>>>>>>            End
33145>>>>>>>>
33145>>>>>>>            Else Begin
33146>>>>>>>                Function_Return False
33147>>>>>>>            End
33147>>>>>>>>
33147>>>>>>>        End
33147>>>>>>>>
33147>>>>>>>        
33147>>>>>>>        // Save if needed, test also if the grid is currently cleared (no rows to save)....
33147>>>>>>>        WebGet piCurrentRowIndex to iRowIndex
33148>>>>>>>        
33148>>>>>>>        If (iRowIndex = -1) Begin
33150>>>>>>>            Move False to bChanged
33151>>>>>>>        End
33151>>>>>>>>
33151>>>>>>>        Else Begin
33152>>>>>>>            Get ShouldSaveRow to bChanged
33153>>>>>>>        End
33153>>>>>>>>
33153>>>>>>>
33153>>>>>>>        If (bChanged) Begin
33155>>>>>>>            // Verify that we are allowed to save....
33155>>>>>>>            If (bDataAware and Read_Only_State(hoDD)) Begin
33157>>>>>>>                Function_Return False         // the view should not allow this to happen
33158>>>>>>>            End
33158>>>>>>>>
33158>>>>>>>            
33158>>>>>>>            // Auto-save gets precedence over data-loss/clear
33158>>>>>>>            If bAutoSave Begin
33160>>>>>>>                Get SaveSelectedRow to eSelectedRowOperation
33161>>>>>>>            End
33161>>>>>>>>
33161>>>>>>>            Else Begin
33162>>>>>>>                Get ClearSelectedRow to eSelectedRowOperation
33163>>>>>>>            End
33163>>>>>>>>
33163>>>>>>>            
33163>>>>>>>            // we only allow a row change if we are sure we succeeded in the save or clear. If a confirmation verification
33163>>>>>>>            // is required the above will return sroPending, which we will treat as a no.
33163>>>>>>>            If (not(eSelectedRowOperation=sroSucceed)) Begin
33165>>>>>>>                Function_Return False
33166>>>>>>>            End
33166>>>>>>>>
33166>>>>>>>        End
33166>>>>>>>>
33166>>>>>>>        
33166>>>>>>>        //  Handle changing to a new row
33166>>>>>>>        If (sGotoRow = "new") Begin
33168>>>>>>>            If (bDataAware) Begin
33170>>>>>>>                // data-aware: Clear the DD
33170>>>>>>>                Get Server to hoDD
33171>>>>>>>                // find the row that we are going to...
33171>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
33172>>>>>>>                Set pbNotifyingExternalDD to True
33173>>>>>>>                
33173>>>>>>>                Send Clear of hoDD
33174>>>>>>>                
33174>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
33175>>>>>>>            End
33175>>>>>>>>
33175>>>>>>>            Else Begin
33176>>>>>>>                // non-data-aware: Use the data received from the client
33176>>>>>>>                Send FillFromActionData
33177>>>>>>>            End
33177>>>>>>>>
33177>>>>>>>            
33177>>>>>>>            //  Trigger event
33177>>>>>>>            Send OnNewRow
33178>>>>>>>        End
33178>>>>>>>>
33178>>>>>>>        
33178>>>>>>>        Function_Return True
33179>>>>>>>    End_Function
33180>>>>>>>    
33180>>>>>>>    
33180>>>>>>>    // Validates the selected row. 
33180>>>>>>>    // Returns True if Error, False if Ok
33180>>>>>>>    Function ValidateRow Returns Boolean
33182>>>>>>>        Handle hoDD
33182>>>>>>>        Handle[] hoColumnObjects
33183>>>>>>>        Boolean bError bRequestValidateAll bDataAware bOk
33183>>>>>>>        Integer icColumn iCol
33183>>>>>>>        
33183>>>>>>>        Get pbRequesteValidateAll to bRequestValidateAll
33184>>>>>>>        
33184>>>>>>>        Get pbDataAware to bDataAware
33185>>>>>>>        
33185>>>>>>>        // if not data aware perform validation here
33185>>>>>>>        If (not(bDataAware)) Begin
33187>>>>>>>    
33187>>>>>>>            // Validate each column....
33187>>>>>>>            Get phoColumnObjects to hoColumnObjects
33188>>>>>>>            Move (SizeOfArray(hoColumnObjects)) to icColumn
33189>>>>>>>            
33189>>>>>>>            For iCol from 0 to (icColumn-1)
33195>>>>>>>>
33195>>>>>>>                Get OnValidate of hoColumnObjects[iCol] to bOk
33196>>>>>>>                If not bOk Begin
33198>>>>>>>                    If not bRequestValidateAll Begin
33200>>>>>>>                        Function_Return True
33201>>>>>>>                    End
33201>>>>>>>>
33201>>>>>>>                    Else Begin
33202>>>>>>>                        Move True to bError
33203>>>>>>>                    End
33203>>>>>>>>
33203>>>>>>>                End
33203>>>>>>>>
33203>>>>>>>            Loop
33204>>>>>>>>
33204>>>>>>>            Function_Return bError
33205>>>>>>>        End
33205>>>>>>>>
33205>>>>>>>        
33205>>>>>>>        // if data aware, perform validation through the DDs
33205>>>>>>>        Get Server to hoDD
33206>>>>>>>        If (hoDD <> 0) Begin
33208>>>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
33209>>>>>>>            If bRequestValidateAll Begin
33211>>>>>>>                Get Request_Validate_All of hoDD to bError
33212>>>>>>>            End
33212>>>>>>>>
33212>>>>>>>            Else Begin
33213>>>>>>>                Get Request_Validate of hoDD to bError
33214>>>>>>>            End
33214>>>>>>>>
33214>>>>>>>            
33214>>>>>>>        End
33214>>>>>>>>
33214>>>>>>>        Function_Return bError
33215>>>>>>>    End_Function
