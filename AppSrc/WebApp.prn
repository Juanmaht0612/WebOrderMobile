22271>>>>>>>>>>>>>>>    
22271>>>>>>>>>>>>>>>    //
22271>>>>>>>>>>>>>>>    // Returns the value for scalar web properties. It looks for a synchronized value in the
22271>>>>>>>>>>>>>>>    // global gaSycnProps store.
22271>>>>>>>>>>>>>>>    //
22271>>>>>>>>>>>>>>>    // Params:
22271>>>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
22271>>>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
22271>>>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
22271>>>>>>>>>>>>>>>    // Returns:
22271>>>>>>>>>>>>>>>    //      The property value as a variant.
22271>>>>>>>>>>>>>>>    //
22271>>>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
22271>>>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
22271>>>>>>>>>>>>>>>    // to be "out of scope".
22271>>>>>>>>>>>>>>>    Function GetScalarSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns String
22273>>>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
22273>>>>>>>>>>>>>>>        String sUC_PropName sReturnValue
22273>>>>>>>>>>>>>>>        Boolean bFoundProp bIsObjectInScope
22273>>>>>>>>>>>>>>>            
22273>>>>>>>>>>>>>>>        // Test if we are active....
22273>>>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
22275>>>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
22275>>>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
22275>>>>>>>>>>>>>>>            // clients have loaded the webapp....
22275>>>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to sReturnValue
22276>>>>>>>>>>>>>>>            Function_Return sReturnValue
22277>>>>>>>>>>>>>>>        End
22277>>>>>>>>>>>>>>>>
22277>>>>>>>>>>>>>>>        
22277>>>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
22278>>>>>>>>>>>>>>>        
22278>>>>>>>>>>>>>>>        // get the sync props index for the passed object handle...
22278>>>>>>>>>>>>>>>        Move (Uppercase(pubProp.sName)) to sUC_PropName
22279>>>>>>>>>>>>>>>        Get piSize to iSize
22280>>>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
22280>>>>>>>>>>>>>>>        Get FindObjectIndex hoObject to iObjectIndex
22281>>>>>>>>>>>>>>>        
22281>>>>>>>>>>>>>>>        If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
22283>>>>>>>>>>>>>>>            // If iObjectIndex = -1 it means that this object does not currently have any web properties.
22283>>>>>>>>>>>>>>>            // It might also mean that this object is out of scope during this CallAction. An object is only in-scope
22283>>>>>>>>>>>>>>>            // if it is a global object cWebApp or its child objects, or the object is part of the stack of views\
22283>>>>>>>>>>>>>>>            // dialog that are passed in the cWebObject's paDDOViews property.
22283>>>>>>>>>>>>>>>            Get IsObjectInCallActionScope hoObject to bIsObjectInScope
22284>>>>>>>>>>>>>>>            
22284>>>>>>>>>>>>>>>            If (bIsObjectInScope) Begin
22286>>>>>>>>>>>>>>>                //  Use the raw property
22286>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22287>>>>>>>>>>>>>>>            End
22287>>>>>>>>>>>>>>>>
22287>>>>>>>>>>>>>>>            Else Begin
22288>>>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppObjectOutOfScope, If(hoObject > 0, Name(hoObject), ""), "WebGet " + pubProp.sName, C_NewLine))
22289>>>>>>>>>>>>>>>>
22289>>>>>>>>>>>>>>>            End
22289>>>>>>>>>>>>>>>>
22289>>>>>>>>>>>>>>>        End
22289>>>>>>>>>>>>>>>>
22289>>>>>>>>>>>>>>>        Else Begin
22290>>>>>>>>>>>>>>>            // Search for the property name....
22290>>>>>>>>>>>>>>>            Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
22291>>>>>>>>>>>>>>>            Move False to bFoundProp
22292>>>>>>>>>>>>>>>            
22292>>>>>>>>>>>>>>>            For iProp from 0 to (icProp - 1)
22298>>>>>>>>>>>>>>>>
22298>>>>>>>>>>>>>>>                If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
22300>>>>>>>>>>>>>>>                    Move gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sV to sReturnValue
22301>>>>>>>>>>>>>>>                    
22301>>>>>>>>>>>>>>>                    // Send Hook for converting the value from format for transport.
22301>>>>>>>>>>>>>>>                    Get ConvertFromTransport of hoObject pubProp.hmGetter sReturnValue pubProp.eType to sReturnValue
22302>>>>>>>>>>>>>>>
22302>>>>>>>>>>>>>>>                    Move True to bFoundProp
22303>>>>>>>>>>>>>>>                End
22303>>>>>>>>>>>>>>>>
22303>>>>>>>>>>>>>>>                If (bFoundProp) ;                    Break
22306>>>>>>>>>>>>>>>            Loop
22307>>>>>>>>>>>>>>>>
22307>>>>>>>>>>>>>>>            
22307>>>>>>>>>>>>>>>            If (not(bFoundProp)) Begin
22309>>>>>>>>>>>>>>>                //  Use the raw property
22309>>>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
22310>>>>>>>>>>>>>>>            End
22310>>>>>>>>>>>>>>>>
22310>>>>>>>>>>>>>>>        End
22310>>>>>>>>>>>>>>>>
22310>>>>>>>>>>>>>>>        
22310>>>>>>>>>>>>>>>        Function_Return sReturnValue
22311>>>>>>>>>>>>>>>    End_Function
