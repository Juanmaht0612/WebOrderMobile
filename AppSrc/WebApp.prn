20149>>>>>>>>>>>>>>>    //  Override the ShowControlError function called by the error system to show control errors. 
20149>>>>>>>>>>>>>>>    //  Returns true to let the error system know that this control can show errors.
20149>>>>>>>>>>>>>>>    Function ShowControlError Integer iErrNum String sErrText Returns Boolean
20151>>>>>>>>>>>>>>>        Boolean bInSync bRender
20151>>>>>>>>>>>>>>>        
20151>>>>>>>>>>>>>>>        Get IsInCallActionScope to bInSync
20152>>>>>>>>>>>>>>>        If (bInSync) Begin
20154>>>>>>>>>>>>>>>            Get IsControlRendered to bRender
20155>>>>>>>>>>>>>>>            If (bRender) Begin
20157>>>>>>>>>>>>>>>                Send ShowControlError iErrNum sErrText
20158>>>>>>>>>>>>>>>                Function_Return True        
20159>>>>>>>>>>>>>>>            End
20159>>>>>>>>>>>>>>>>
20159>>>>>>>>>>>>>>>        End
20159>>>>>>>>>>>>>>>>
20159>>>>>>>>>>>>>>>        
20159>>>>>>>>>>>>>>>        Function_Return False
20160>>>>>>>>>>>>>>>    End_Function
20161>>>>>>>>>>>>>>>    
20161>>>>>>>>>>>>>>>    
20161>>>>>>>>>>>>>>>    //  Displays a control error in an error balloon around the control. The error number is used 
20161>>>>>>>>>>>>>>>    //  as identifier to hide the error. The error will be cleared by a WebSet of psValue and the 
20161>>>>>>>>>>>>>>>    //  HideControlError / HideAllControlErrors procedures and by a succesfull server-side 
20161>>>>>>>>>>>>>>>    //  validation.
20161>>>>>>>>>>>>>>>    // 
20161>>>>>>>>>>>>>>>    //  Params:
20161>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20161>>>>>>>>>>>>>>>    //      sErrText    Error description.
20161>>>>>>>>>>>>>>>    Procedure ShowControlError Integer iErrNum String sErrText
20163>>>>>>>>>>>>>>>        String[] aParams
20164>>>>>>>>>>>>>>>        
20164>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20165>>>>>>>>>>>>>>>        Move sErrText   to aParams[1]
20166>>>>>>>>>>>>>>>        
20166>>>>>>>>>>>>>>>        WebSet pbHasControlError to True
20167>>>>>>>>>>>>>>>        Send ClientAction "showControlError" aParams
20168>>>>>>>>>>>>>>>    End_Procedure
20169>>>>>>>>>>>>>>>        
20169>>>>>>>>>>>>>>>    
20169>>>>>>>>>>>>>>>    //  Hides an error shown using ShowControlError based on its error number.
20169>>>>>>>>>>>>>>>    // 
20169>>>>>>>>>>>>>>>    //  Params:
20169>>>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
20169>>>>>>>>>>>>>>>    Procedure HideControlError Integer iErrNum
20171>>>>>>>>>>>>>>>        String[] aParams
20172>>>>>>>>>>>>>>>        
20172>>>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
20173>>>>>>>>>>>>>>>        
20173>>>>>>>>>>>>>>>        Send ClientAction "hideControlError" aParams
20174>>>>>>>>>>>>>>>    End_Procedure
20175>>>>>>>>>>>>>>>    
20175>>>>>>>>>>>>>>>    //  Hides all active control errors on this control.
20175>>>>>>>>>>>>>>>    Procedure HideAllControlErrors
20177>>>>>>>>>>>>>>>        Boolean bHas
20177>>>>>>>>>>>>>>>        
20177>>>>>>>>>>>>>>>        WebGet pbHasControlError to bHas
20178>>>>>>>>>>>>>>>        
20178>>>>>>>>>>>>>>>        If (bHas) Begin
20180>>>>>>>>>>>>>>>            Send ClientAction "hideAllControlErrors"
20181>>>>>>>>>>>>>>>            WebSet pbHasControlError to False
20182>>>>>>>>>>>>>>>        End
20182>>>>>>>>>>>>>>>>
20182>>>>>>>>>>>>>>>    End_Procedure
20183>>>>>>>>>>>>>>>    
20183>>>>>>>>>>>>>>>    
20183>>>>>>>>>>>>>>>    //  Called to determine if filling the DEO with data is allowed.
20183>>>>>>>>>>>>>>>    //
20183>>>>>>>>>>>>>>>    //  Params:
20183>>>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
20183>>>>>>>>>>>>>>>    Procedure AllowFillDEO Boolean ByRef bAllow
20185>>>>>>>>>>>>>>>        If (bAllow) Begin
20187>>>>>>>>>>>>>>>            Get IsControlAccessible False (pbNoFillIfHidden(Self)) to bAllow
20188>>>>>>>>>>>>>>>        End
20188>>>>>>>>>>>>>>>>
20188>>>>>>>>>>>>>>>    End_Procedure
20189>>>>>>>>>>>>>>>    
20189>>>>>>>>>>>>>>>    //  Called to determine if the DEO has permission to update the Data Dictionary with new value(s).
20189>>>>>>>>>>>>>>>    //
20189>>>>>>>>>>>>>>>    //  Params:
20189>>>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
20189>>>>>>>>>>>>>>>    Procedure AllowUpdateDD Boolean ByRef bAllow
20191>>>>>>>>>>>>>>>        If (bAllow) Begin
20193>>>>>>>>>>>>>>>            Get IsControlAccessible True (pbNoUpdateIfHidden(Self)) to bAllow
20194>>>>>>>>>>>>>>>        End
20194>>>>>>>>>>>>>>>>
20194>>>>>>>>>>>>>>>    End_Procedure
