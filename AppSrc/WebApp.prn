29986>>>>>>>Use cWebObject_API.pkg
29986>>>>>>>
29986>>>>>>>
29986>>>>>>>// Class used by cWebApp to handle file streaming requests. Communicates with the resource manager 
29986>>>>>>>// via the ghoWebResourceManager handle.
29986>>>>>>>Class cWebResourceManagerProxy is a cWebHttpMultipartFormdataHandler
29987>>>>>>>    Procedure Construct_Object
29989>>>>>>>        Forward Send Construct_Object
29991>>>>>>>        
29991>>>>>>>        Send Define_cWebResourceManagerProxy_mixin
29992>>>>>>>        
29992>>>>>>>        //  Stores the hash during a file upload
29992>>>>>>>        Property String psHash ""
29993>>>>>>>        //  Stores the output channel during a file upload
29993>>>>>>>        Property Integer piChannel -1
29994>>>>>>>        //  Stores the file path during a file upload
29994>>>>>>>        Property String psUploadPath ""
29995>>>>>>>        //  Used to not send the status twice during file upload
29995>>>>>>>        Property Boolean pbStatusSent False
29996>>>>>>>        
29996>>>>>>>        
29996>>>>>>>        Set psVerbs to "GET,POST"
29997>>>>>>>        Set psPath to "DfResource"
29998>>>>>>>    End_Procedure
29999>>>>>>>    
29999>>>>>>>    Import_Class_Protocol cWebResourceManagerProxy_mixin
30000>>>>>>>    
30000>>>>>>>    //  A get request means we are downloading a file
30000>>>>>>>    Procedure OnHttpGet String sPath String sAcceptType
30002>>>>>>>        String[] aParts
30003>>>>>>>        String sHash sStreamType sFilePath sFileName sContentType sHttpError sAttach
30003>>>>>>>        Integer iPos iChnl iSize iHttpError
30003>>>>>>>        UChar[] aData
30004>>>>>>>        Boolean bOk
30004>>>>>>>        Handle hoResourceManager
30004>>>>>>>        
30004>>>>>>>        Get ResourceManager to hoResourceManager
30005>>>>>>>        
30005>>>>>>>        //  Determine key
30005>>>>>>>        Get UrlParameter "key" to sHash
30006>>>>>>>        If (Trim(sHash) = "") Begin
30008>>>>>>>            Send SetResponseStatus 404 "Invalid resource" 1
30009>>>>>>>            Procedure_Return
30010>>>>>>>        End
30010>>>>>>>>
30010>>>>>>>        
30010>>>>>>>        // Split the file name from the key 
30010>>>>>>>        Move (RightPos("/", sPath)) to iPos
30011>>>>>>>        If (iPos > 0) ;            Move (Right(sPath, Length(sPath) - iPos)) to sFileName
30014>>>>>>>        Else ;            Move sPath to sFileName
30016>>>>>>>        
30016>>>>>>>        //  Determine stream type
30016>>>>>>>        Get UrlParameter "attach" to sAttach
30017>>>>>>>        If (Lowercase(Trim(sAttach)) = "true") ;            Move "attachment" to sStreamType
30020>>>>>>>        Else ;            Move "inline" to sStreamType
30022>>>>>>>            
30022>>>>>>>        //  Let resource manager parse the path
30022>>>>>>>        Get FileDownload of hoResourceManager sHash (&sFilePath) (&iHttpError) (&sHttpError) to bOk
30023>>>>>>>        
30023>>>>>>>        If (not(bOk)) Begin
30025>>>>>>>            Send SetResponseStatus iHttpError sHttpError
30026>>>>>>>            Procedure_Return
30027>>>>>>>        End
30027>>>>>>>>
30027>>>>>>>                
30027>>>>>>>        //  Determine contenttype based on extension
30027>>>>>>>        Move (RightPos(".", sFileName)) to iPos
30028>>>>>>>        If (iPos >= 0) ;            Get ContentType of hoResourceManager (Right(sFileName, Length(sFileName) - iPos)) to sContentType
30031>>>>>>>        Else ;            Get ContentType of hoResourceManager "" to sContentType
30033>>>>>>>                
30033>>>>>>>        //  Open the file
30033>>>>>>>        Move (Seq_New_Channel()) to iChnl
30034>>>>>>>        If (iChnl >= 0) Begin
30036>>>>>>>            Direct_Input channel iChnl ("binary:" + sFilePath)
30038>>>>>>>            Get_Channel_Size iChnl to iSize
30039>>>>>>>            
30039>>>>>>>            //  Send the response headers
30039>>>>>>>            Send AddHttpResponseHeader "Content-Type" sContentType
30040>>>>>>>            Send AddHttpResponseHeader "Content-Disposition" (sStreamType +';filename="' + sFileName + '"')
30041>>>>>>>            Send AddHttpResponseHeader "Content-Length" iSize
30042>>>>>>>            
30042>>>>>>>            //  Send the file
30042>>>>>>>            While (not(SeqEof))
30046>>>>>>>                Read_Block channel iChnl aData HTTP_DEFAULT_CHUNK_SIZE
30048>>>>>>>                
30048>>>>>>>                Send OutputUChar aData
30049>>>>>>>            Loop
30050>>>>>>>>
30050>>>>>>>            
30050>>>>>>>            Close_Input channel iChnl
30052>>>>>>>            Send Seq_Release_Channel iChnl
30053>>>>>>>            
30053>>>>>>>            //  Trigger filedownloadfinished
30053>>>>>>>            Send FileDownloadFinished of hoResourceManager sFilePath
30054>>>>>>>        End
30054>>>>>>>>
30054>>>>>>>        Else If (iChnl = -1) Begin
30057>>>>>>>            Send SetResponseStatus 500 "I/O Channel Error" 1
30058>>>>>>>            Procedure_Return
30059>>>>>>>        End
30059>>>>>>>>
30059>>>>>>>        Else If (iChnl = -2) Begin
30062>>>>>>>            Send SetResponseStatus 500 "No I/O Channel Available" 2
30063>>>>>>>            Procedure_Return
30064>>>>>>>        End
30064>>>>>>>>
30064>>>>>>>    End_Procedure
30065>>>>>>>
30065>>>>>>>    //  In case of a post this is a file upload. The cWebHttpMultipartFormDataHandler base class 
30065>>>>>>>    //  will tear the request apart and trigger OnField and OnFile.. events. 
30065>>>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType DWord iSize
30067>>>>>>>        Send HandleFileUpload
30068>>>>>>>    End_Procedure
30069>>>>>>>    
30069>>>>>>>    // Main entry point for parsing the file upload
30069>>>>>>>    Procedure HandleFileUpload 
30071>>>>>>>        Boolean bSuccess bExists
30071>>>>>>>        String sFilePath
30071>>>>>>>        
30071>>>>>>>        Set psHash to ""
30072>>>>>>>        Set piChannel to -1
30073>>>>>>>        Set psUploadPath to ""
30074>>>>>>>        Set pbStatusSent to False
30075>>>>>>>
30075>>>>>>>        Get ParseMultipartFormData to bSuccess
30076>>>>>>>        //Send SetResponseStatus 500 "Invalid request format: test" 8
30076>>>>>>>        If (not(bSuccess)) Begin
30078>>>>>>>            Get psUploadPath to sFilePath    
30079>>>>>>>            If (sFilePath <> "") Begin
30081>>>>>>>                File_Exist sFilePath bExists
30082>>>>>>>                If (bExists) Begin
30084>>>>>>>                    EraseFile sFilePath 
30085>>>>>>>>
30085>>>>>>>                End
30085>>>>>>>>
30085>>>>>>>            End
30085>>>>>>>>
30085>>>>>>>            
30085>>>>>>>            If (not(pbstatussent(Self))) ;                Send SetResponseStatus 500 (psParseError(Self)) (piParseErrorCode(Self))             
30088>>>>>>>        End
30088>>>>>>>>
30088>>>>>>>        Set psHash to ""
30089>>>>>>>        Set piChannel to -1
30090>>>>>>>        Set psUploadPath to ""
30091>>>>>>>        Set pbStatusSent to False
30092>>>>>>>    End_Procedure
30093>>>>>>>    
30093>>>>>>>    //  The hash is sent as a field before the file is sent.
30093>>>>>>>    Procedure OnField String sName UChar[] ucData
30095>>>>>>>        Forward Send OnField sName ucData
30097>>>>>>>        
30097>>>>>>>        If (sName = "hash") Begin
30099>>>>>>>            Set psHash to (UCharArrayToString(ucData))
30100>>>>>>>        End
30100>>>>>>>>
30100>>>>>>>    End_Procedure
30101>>>>>>>    
30101>>>>>>>    //  When the file comes in we decrypt the hash and open the file. We store the channel so that
30101>>>>>>>    //  OnFileChunk can actually write the data.
30101>>>>>>>    Procedure OnFileStart String sFieldName String sFileName String sContentType Boolean ByRef bAbort
30103>>>>>>>        String sHash sPath sError
30103>>>>>>>        Integer iChnl iHttpErr
30103>>>>>>>        Boolean bExists bOk
30103>>>>>>>        
30103>>>>>>>        If (sFieldName = "file") Begin
30105>>>>>>>            Get psHash to sHash
30106>>>>>>>            
30106>>>>>>>            If (sHash = "") Begin
30108>>>>>>>                Send SetResponseStatus 500 "Invalid request format: expected hash before file." 4
30109>>>>>>>                Move True to bAbort
30110>>>>>>>                Set pbStatusSent to True
30111>>>>>>>                Procedure_Return
30112>>>>>>>            End
30112>>>>>>>>
30112>>>>>>>            
30112>>>>>>>            Get FileUpload of (ResourceManager(Self)) sFileName sHash (&sPath) (&iHttpErr) (&sError) to bOk
30113>>>>>>>            If (not(bOk)) Begin
30115>>>>>>>                Send SetResponseStatus iHttpErr sError
30116>>>>>>>                Set pbStatusSent to True
30117>>>>>>>                Move True to bAbort
30118>>>>>>>                Procedure_Return
30119>>>>>>>            End
30119>>>>>>>>
30119>>>>>>>            
30119>>>>>>>            File_Exist sPath bExists
30120>>>>>>>            
30120>>>>>>>            If (not(bExists)) Begin
30122>>>>>>>                Move (Seq_New_Channel()) to iChnl
30123>>>>>>>                If (iChnl >= 0) Begin
30125>>>>>>>                    Direct_Output channel iChnl ("binary:" + sPath)
30127>>>>>>>                    Set piChannel to iChnl
30128>>>>>>>                    Set psUploadPath to sPath
30129>>>>>>>                End
30129>>>>>>>>
30129>>>>>>>                Else If (iChnl = -1) Begin
30132>>>>>>>                    Send SetResponseStatus 500 "I/O Channel Error" 1
30133>>>>>>>                    Set pbStatusSent to True
30134>>>>>>>                    Move True to bAbort
30135>>>>>>>                End
30135>>>>>>>>
30135>>>>>>>                Else If (iChnl = -2) Begin
30138>>>>>>>                    Send SetResponseStatus 500 "No I/O Channel Available" 2
30139>>>>>>>                    Set pbStatusSent to True
30140>>>>>>>                    Move True to bAbort
30141>>>>>>>                End
30141>>>>>>>>
30141>>>>>>>            End
30141>>>>>>>>
30141>>>>>>>            Else Begin
30142>>>>>>>                Send SetResponseStatus 500 "File already exists" 6
30143>>>>>>>                Set pbStatusSent to True
30144>>>>>>>                Move True to bAbort
30145>>>>>>>            End
30145>>>>>>>>
30145>>>>>>>        End
30145>>>>>>>>
30145>>>>>>>    End_Procedure
30146>>>>>>>    
30146>>>>>>>    //  Called for each chunk of data that comes in for a file, we simply write it out to the 
30146>>>>>>>    //  already opened file channel.
30146>>>>>>>    Procedure OnFileChunk String sFieldName UChar[] ByRef ucData
30148>>>>>>>        Integer iChnl
30148>>>>>>>        
30148>>>>>>>        If (sFieldName = "file") Begin
30150>>>>>>>            Get piChannel to iChnl
30151>>>>>>>            If (iChnl >= 0) Begin
30153>>>>>>>                Write channel iChnl ucData
30155>>>>>>>            End
30155>>>>>>>>
30155>>>>>>>        End
30155>>>>>>>>
30155>>>>>>>    End_Procedure
30156>>>>>>>    
30156>>>>>>>    //  The upload is done, we send back a positive response.
30156>>>>>>>    Procedure OnFileFinished String sFieldName
30158>>>>>>>        Integer iChnl
30158>>>>>>>        String sFilePath
30158>>>>>>>        
30158>>>>>>>        If (sFieldName = "file") Begin
30160>>>>>>>            Get piChannel to iChnl
30161>>>>>>>            If (iChnl >= 0) Begin
30163>>>>>>>                Close_Output channel iChnl
30165>>>>>>>                Send Seq_Release_Channel iChnl
30166>>>>>>>                
30166>>>>>>>                Get psUploadPath to sFilePath
30167>>>>>>>                                
30167>>>>>>>                Set piChannel to -1
30168>>>>>>>                Set psUploadPath to ""
30169>>>>>>>                
30169>>>>>>>                Send SetResponseStatus 201 "Upload succesfull" 0
30170>>>>>>>                Set pbStatusSent to True
30171>>>>>>>                Send FileUploadFinished of (ResourceManager(Self)) sFilePath
30172>>>>>>>            End
30172>>>>>>>>
30172>>>>>>>            Else If (iChnl = -1) Begin
30175>>>>>>>                Send SetResponseStatus 500 "I/O Channel Error" 1
30176>>>>>>>                Set pbStatusSent to True
30177>>>>>>>            End
30177>>>>>>>>
30177>>>>>>>            Else If (iChnl = -2) Begin
30180>>>>>>>                Send SetResponseStatus 500 "No I/O Channel Available" 2
30181>>>>>>>                Set pbStatusSent to True
30182>>>>>>>            End
30182>>>>>>>>
30182>>>>>>>        End
30182>>>>>>>>
30182>>>>>>>    End_Procedure
