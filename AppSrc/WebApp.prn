56453>>>>>                    End
56453>>>>>>
56453>>>>>                    Move C_drImage to eType
56454>>>>>                    Case Break
56455>>>>>                Case (sExportFormat = "PNG")
56458>>>>>                    Set pbImageExportMultiPage to False
56459>>>>>                    Set peImageExportType to C_drPNG
56460>>>>>                    If (not (bAllPages)) Begin
56462>>>>>                        Get NamedValueIndex NamedValues "PageNumber" to iIndex
56463>>>>>                        If (iIndex > -1) Begin
