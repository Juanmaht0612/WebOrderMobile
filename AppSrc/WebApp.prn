51412>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
51415>>>        WebSet pbRender of oNewButton to True
51416>>>        
51416>>>        Case Begin
51416>>>            Case (NavigateData.eNavigateType=nfFromParent)
51418>>>                // If from parent, this is a constrained drill down
51418>>>                // If Row select does main-zoom we don't need this
51418>>>                Case Break
51419>>>            
51419>>>            Case (NavigateData.eNavigateType=nfFromChild)
51422>>>                // If from child, this is a probably a parent lookup from a Zoom
51422>>>                Case Break
51423>>>            
51423>>>            Case (NavigateData.eNavigateType=nfFromMain)
51426>>>                // If from main, this is a probably a main-file lookup from a Zoom
51426>>>                Case Break
51427>>>            
51427>>>            Case Else // must be nfUndefined
51427>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
51427>>>                // If Row select does main-zoom we don't need this
51427>>>                
51427>>>        Case End
