62707>>>            tWebNavigateData NavigateData
62707>>>
62707>>>            Get GetNavigateData to NavigateData
62708>>>
62708>>>            Get NamedValueGet NavigateData.NamedValues "TotalsPerState" to sTotalsPerState
62709>>>            Set psFunction sReportId "TotalsPerState" to ("Return" * sTotalsPerState)
62710>>>
62710>>>            Get NamedValueGet NavigateData.NamedValues "TotalsPerSalesPerson" to sTotalsPerSalesPerson
62711>>>            Set psFunction sReportId "TotalsPerSalesPerson" to ("Return" * sTotalsPerSalesPerson)
62712>>>
62712>>>            Get NamedValueGet NavigateData.NamedValues "GrandTotal" to sGrandTotal
62713>>>            Get ParameterIdByName sReportId "GrandTotal" to iParameter
62714>>>            Set psParameterValue sReportId iParameter to sGrandTotal
62715>>>        End_Procedure
62716>>>    End_Object
