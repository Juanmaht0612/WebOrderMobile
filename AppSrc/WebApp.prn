42207>>>            //  We store the file in the regular upload folder first (due to rights)
42207>>>            Function OnFileUpload String sFileName Integer iBytes String sMime Returns String
42210>>>                String sUploadPath sPath
42210>>>                Boolean bExists
42210>>>
42210>>>                // Determine local path based on workspace setting
42210>>>                Get UploadFolder True to sPath
42211>>>                Move (sPath + "\" + sFileName) to sPath
42212>>>
42212>>>                //  Remove existing file (only reason for a file being in this location would be an earlier failed attempt)
42212>>>                File_Exist sPath bExists
42213>>>                If (bExists) Begin
42215>>>                    EraseFile sPath
42216>>>>
42216>>>                End
42216>>>>
42216>>>
42216>>>                Function_Return sPath
42217>>>            End_Function
42218>>>
42218>>>            Procedure OnFileFinished String sFileName String sLocalPath
42221>>>                String sLocalFileName sExtension sPath
42221>>>                Handle hoSalesPersonDD
42221>>>                RowID riSalesPerson
42221>>>
42221>>>                Forward Send OnFileFinished sFileName sLocalPath
42223>>>
42223>>>                Move (Right(sFileName, Length(sFileName) - RightPos(".", sFileName))) to sExtension
42224>>>
42224>>>                // Determine local path based on workspace setting
42224>>>
42224>>>                If (sExtension <> "" and (HasRecord(oSalesPersonDataDictionary))) Begin
42226>>>                    //  Delete old avatar if available (as the extension could be different)
42226>>>                    If (Trim(SalesPerson.Avatar) <> "") Begin
42228>>>                        Get SalesAvatarsFolder to sPath
42229>>>                        Move (sPath + "\" + Trim(SalesPerson.Avatar)) to sPath
42230>>>                        EraseFile sPath
42231>>>>
42231>>>                    End
42231>>>>
42231>>>
42231>>>                    //  Move the uploaded file to the avatar folder
42231>>>                    Get SalesAvatarsFolder to sPath
42232>>>                    Move (sPath  + "\" - SalesPerson.ID - "." + sExtension) to sPath
42233>>>                    CopyFile sLocalPath to sPath
42234>>>>
42234>>>                    EraseFile sLocalPath
42235>>>>
42235>>>
42235>>>                    // Store the avatar file name:
42235>>>                    // In order not to affect other changes that could have been made (e.g. name) that may not be saved yet,
42235>>>                    // create a temporary DDO and save the new filename using it.
42235>>>                    Get Create (RefClass (cSalesPersonDataDictionary)) to hoSalesPersonDD
42236>>>                    Get CurrentRowId of oSalesPersonDataDictionary to riSalesPerson
42237>>>                    Send FindByRowId of hoSalesPersonDD SalesPerson.File_Number riSalesPerson 
42238>>>                    Set Field_Changed_Value of hoSalesPersonDD Field SalesPerson.Avatar to (SalesPerson.ID - "." + sExtension)
42239>>>                    Send Request_Save of hoSalesPersonDD
42240>>>                    Send Destroy of hoSalesPersonDD
42241>>>
42241>>>                    //  Refesh the image
42241>>>                    Send Refresh of oWebImage1 0
42242>>>                End
42242>>>>
42242>>>                Else Begin
42243>>>                    EraseFile sLocalPath
42244>>>>
42244>>>                End
42244>>>>
42244>>>            End_Procedure
42245>>>   
