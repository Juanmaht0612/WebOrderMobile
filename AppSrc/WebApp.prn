24966>>>>>>>>>>>>>>>        Forward Send Construct_Object
24968>>>>>>>>>>>>>>>        
24968>>>>>>>>>>>>>>>        Property Boolean pbFullText                 False
24971>>>>>>>>>>>>>>>        Property Boolean pbCaseSensitive            False
24974>>>>>>>>>>>>>>>        Property Boolean pbAllData                  False
24977>>>>>>>>>>>>>>>        Property Boolean pbSuggestions              False
24980>>>>>>>>>>>>>>>        Property Boolean pbPaged                    False
24983>>>>>>>>>>>>>>>        Property Boolean pbSourceIsValidationTable  False
24986>>>>>>>>>>>>>>>        
24986>>>>>>>>>>>>>>>        Property Integer piPageSize                 10
24989>>>>>>>>>>>>>>>        Property Integer piStartAtChar              0
24992>>>>>>>>>>>>>>>        Property Integer piPopupWidth               0
24995>>>>>>>>>>>>>>>        Property Integer piTypeTimeout              20
24998>>>>>>>>>>>>>>>        Property String psShowMoreText              C_$ShowMore
25001>>>>>>>>>>>>>>>        Property String psCreateNewItemText         C_$CreateNew
25004>>>>>>>>>>>>>>>        Property Boolean pbAllowCreate              False
25007>>>>>>>>>>>>>>>        Property Integer piMinimumItemLength        2
25010>>>>>>>>>>>>>>>        
25010>>>>>>>>>>>>>>>        Property Boolean pbAutoCreate               False // This property exists to solve the recursive include.
25011>>>>>>>>>>>>>>>        
