38013>>>>>>>
38013>>>>>>>    // Set the rotation of the item
38013>>>>>>>    //
38013>>>>>>>    // sId: ID of the item
38013>>>>>>>    // fAngle: The rotation angle in degrees, clockwise. A negative number will make the rotation go counterclockwise
38013>>>>>>>    // bRotateInPlace: Determines if the item should rotate on its current spot. If this is false it will rotate around the center point of the canvas/group it is in.
38013>>>>>>>    Procedure Rotation String sId Float fAngle Boolean bRotateInPlace
38015>>>>>>>        String[] asParams
38016>>>>>>>        
38016>>>>>>>        // Restrict angle to 360
38016>>>>>>>        // If it goes over, return the remainder
38016>>>>>>>        Move (Mod(fAngle, 360)) to fAngle
38017>>>>>>>
38017>>>>>>>        Move fAngle to asParams[0]
38018>>>>>>>        
38018>>>>>>>        If (num_arguments > 2) Begin
38020>>>>>>>            Move bRotateInPlace to asParams[1]
38021>>>>>>>        End
38021>>>>>>>>
38021>>>>>>>
38021>>>>>>>        Send AddInstr sId "rotation" asParams
38022>>>>>>>    End_Procedure
