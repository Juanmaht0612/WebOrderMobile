26512>>>>>>>>>    // returns true if this would be a client sorted field. This is used by
26512>>>>>>>>>    // grid columns to determine a default setting.
26512>>>>>>>>>    Function ClientSortable Returns Boolean
26514>>>>>>>>>        Integer eDBGridType
26514>>>>>>>>>        Boolean bDataAware bScrollable
26514>>>>>>>>>        Get pbDataAware to bDataAware
26515>>>>>>>>>        Get peDbGridType to eDBGridType
26516>>>>>>>>>        Get pbScroll to bScrollable
26517>>>>>>>>>        // It can be client sortable as long as it is static
26517>>>>>>>>>        Function_Return (not(bDataAware) or eDBGridType<>gtAutomatic or not(bScrollable))
26518>>>>>>>>>    End_Function
26519>>>>>>>>>    
26519>>>>>>>>>    // find in DD using eFindMode adjusting for reverse ordering. Use the current index 
26519>>>>>>>>>    Function FindInDD Handle hoDD Integer eMode Returns Boolean
26521>>>>>>>>>        Integer iOrdering
26521>>>>>>>>>        Boolean bReverseOrdering
26521>>>>>>>>>
26521>>>>>>>>>        If (pbNotifyingExternalDD(Self)) Begin
26523>>>>>>>>>            Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
26524>>>>>>>>>>
26524>>>>>>>>>        End
26524>>>>>>>>>>
26524>>>>>>>>>
26524>>>>>>>>>        Get IndexOrder to iOrdering
26525>>>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
26526>>>>>>>>>        Get FindMode eMode bReverseOrdering to eMode
26527>>>>>>>>>        Send Find of hoDD eMode iOrdering    
26528>>>>>>>>>        Function_Return (Found)
26529>>>>>>>>>    End_Function
26530>>>>>>>>>    
26530>>>>>>>>>    // used by public FindFromTop and FindFromBottom
26530>>>>>>>>>    Procedure FindFromTB Boolean bFirst
26532>>>>>>>>>        Handle hoDD
26532>>>>>>>>>        Boolean bDataAware bFound
26532>>>>>>>>>        Get pbDataAware to bDataAware
26533>>>>>>>>>        If bDataAware Begin
26535>>>>>>>>>            Get Server to hoDD
26536>>>>>>>>>            Get FindInDD hoDD (If(bFirst,FIRST_RECORD, LAST_RECORD)) to bFound
26537>>>>>>>>>            If bFound Begin
26539>>>>>>>>>                Send UpdateCurrentRowID
26540>>>>>>>>>            End
26540>>>>>>>>>>
26540>>>>>>>>>            Else Begin
26541>>>>>>>>>                // If not found then the DD didn't change so we must clear the grid.
26541>>>>>>>>>                Send ClearGrid
26542>>>>>>>>>            End
26542>>>>>>>>>>
26542>>>>>>>>>        End
26542>>>>>>>>>>
26542>>>>>>>>>    End_Procedure
26543>>>>>>>>>    
26543>>>>>>>>>    // Server action
26543>>>>>>>>>    //
26543>>>>>>>>>    // Sent when the client navigates the focus from one row to another.
26543>>>>>>>>>    // sGoToRow - Indicates how to treat the second parameter:
26543>>>>>>>>>    //            "row"   - indicates that we are going to a specific row as specified in sToRowID
26543>>>>>>>>>    //            "first" - indicates that we are going to the first row in the data set. Ignore sToRowID.
26543>>>>>>>>>    //            "last"  - indicates that we are going to the last row in the data set. Ignore sToRowID.
26543>>>>>>>>>    //            "new"   - indicates that we are creating a new row. Ignore sToRowID.
26543>>>>>>>>>    // Returns  - True if the navigation is allowed, otherwise returns False.
26543>>>>>>>>>    Function ChangeCurrentRow String sGotoRow String sToRowID Returns Boolean 
26545>>>>>>>>>        Handle hoDD
26545>>>>>>>>>        Integer iMainFile
26545>>>>>>>>>        RowID riRowID
26545>>>>>>>>>        Boolean bReturn bOldGridAction bDataAware bSuccess
26545>>>>>>>>>        String sPreviousRowId
26545>>>>>>>>>        String[] aParams
26546>>>>>>>>>        
26546>>>>>>>>>        Get pbDataAware to bDataAware
26547>>>>>>>>>        WebGet psCurrentRowId to sPreviousRowId
26548>>>>>>>>>        
26548>>>>>>>>>        // Give grid a chance to do its row change logic via AllowChangeSelectedRow
26548>>>>>>>>>        Get AllowChangeSelectedRow sGotoRow sToRowID to bReturn
26549>>>>>>>>>
26549>>>>>>>>>        // load the new row
26549>>>>>>>>>        If (bReturn) Begin   
26551>>>>>>>>>            If (bDataAware) Begin
26553>>>>>>>>>                // data-aware
26553>>>>>>>>>                Get Server to hoDD
26554>>>>>>>>>                
26554>>>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
26555>>>>>>>>>                If (hoDD) Begin
26557>>>>>>>>>                    Move (Lowercase(sGotoRow)) to sGotoRow
26558>>>>>>>>>                    
26558>>>>>>>>>                    Case Begin
26558>>>>>>>>>                        Case (sGotoRow = "row")
26560>>>>>>>>>                            Set pbNotifyingExternalDD to True // indicate that we are simply in a client row change event.
26561>>>>>>>>>                            // Load the ToRowID's record into the DDO structure. This triggers a refresh to all
26561>>>>>>>>>                            // connected DDO's including cWebColumn objects
26561>>>>>>>>>                            Get Main_File of hoDD to iMainFile
26562>>>>>>>>>                            Move (DeserializeRowID(sToRowID)) to riRowID
26563>>>>>>>>>                            // load the "to" row into the DDO. Should indirectly set psCurrentRowId
26563>>>>>>>>>                            Get FindByRowIdEx of hoDD iMainFile riRowID to bSuccess
26564>>>>>>>>>                            // Handle errors
26564>>>>>>>>>                            If (not(bSuccess)) Begin
26566>>>>>>>>>                                Set pbNotifyingExternalDD to False
26567>>>>>>>>>                                Send HandleCacheError
26568>>>>>>>>>                            End
26568>>>>>>>>>>
26568>>>>>>>>>                            Case Break
26569>>>>>>>>>        
26569>>>>>>>>>                        Case (sGotoRow = "first")
26572>>>>>>>>>                        Case (sGotoRow = "last")
26575>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26575>>>>>>>>>                            Set pbNotifyingExternalDD to False
26576>>>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
26576>>>>>>>>>                            If (sGotoRow = "first") Begin
26578>>>>>>>>>                                Get FindInDD hoDD FIRST_RECORD to bSuccess
26579>>>>>>>>>                            End
26579>>>>>>>>>>
26579>>>>>>>>>                            Else Begin
26580>>>>>>>>>                                Get FindInDD hoDD LAST_RECORD to bSuccess
26581>>>>>>>>>                            End
26581>>>>>>>>>>
26581>>>>>>>>>
26581>>>>>>>>>                            //  If not found then the DD didn't cause a refresh so we do it manually here
26581>>>>>>>>>                            If (not(bSuccess)) Begin
26583>>>>>>>>>                                Send ClearGrid
26584>>>>>>>>>                            End
26584>>>>>>>>>>
26584>>>>>>>>>                            
26584>>>>>>>>>                            
26584>>>>>>>>>                            Case Break
26585>>>>>>>>>        
26585>>>>>>>>>                    Case End               
26585>>>>>>>>>                    Set pbNotifyingExternalDD to bOldGridAction
26586>>>>>>>>>                                    
26586>>>>>>>>>                End
26586>>>>>>>>>>
26586>>>>>>>>>                Else Begin
26587>>>>>>>>>                    Error DFERR_PROGRAM C_$WebGridDoesNotHaveDDOServer
26588>>>>>>>>>>
26588>>>>>>>>>                End
26588>>>>>>>>>>
26588>>>>>>>>>            End
26588>>>>>>>>>>
26588>>>>>>>>>            Else Begin
26589>>>>>>>>>                // non-data-aware: We simply load the row sent by the client into the DEOs (columns)
26589>>>>>>>>>                If (sGotoRow = "row") Begin
26591>>>>>>>>>                    Send FillFromActionData 
26592>>>>>>>>>                End
26592>>>>>>>>>>
26592>>>>>>>>>            End
26592>>>>>>>>>>
26592>>>>>>>>>            
26592>>>>>>>>>            //  Fire user event
26592>>>>>>>>>            Send OnChangeCurrentRow sPreviousRowId sToRowID
26593>>>>>>>>>        End
26593>>>>>>>>>>
26593>>>>>>>>>        
26593>>>>>>>>>        //  Send client action that processes the row change (this is done to preserve the order combined with list refreshes)
26593>>>>>>>>>        Move bReturn to aParams[0]
26594>>>>>>>>>        Send ClientAction "handleRowChange" aParams
26595>>>>>>>>>        
26595>>>>>>>>>        Function_Return bReturn
26596>>>>>>>>>    End_Function
26597>>>>>>>>>    
26597>>>>>>>>>    
26597>>>>>>>>>    //  Called by the client when the sorting is changed. The piSortColumn and pbReverseSorting are
26597>>>>>>>>>    //  already updated when it is called.
26597>>>>>>>>>    Procedure ChangeSorting Integer iCol Boolean bReverse Integer iPrevCol Boolean bPrevReverse
26599>>>>>>>>>        Send GridRefresh
26600>>>>>>>>>    End_Procedure
