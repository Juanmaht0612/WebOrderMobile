7252>>>>>>>    // override for desktop in val_mx which does not work well with tab
7252>>>>>>>    // pages. First make sure tab dialog has the focus (and that it worked)
7252>>>>>>>    // then if page is not active or it is hidden, make this the active page
7252>>>>>>>    // This is only sent during DEO validation and always sent via delegation
7252>>>>>>>    //
7252>>>>>>>    Procedure Activate_Area Integer TakeFocusFg
7254>>>>>>>        Integer iTab
7254>>>>>>>        Delegate Send Activate_Area False // make sure parent dialog is active and not hidden
7256>>>>>>>        // if parent is not active or it is hidden, we've had an error. Stop. This should not happen
7256>>>>>>>        If (Active_State(Parent(Self))=0 or implicit_Hidden_state(Self) ) ;            Procedure_Return
7259>>>>>>>        
7259>>>>>>>        // If here the parent tab dialog is active and ready. Now let's make sure that this page takes the focus
7259>>>>>>>        // At this point the page cannot be implicitly hidden (we checked above), so it can only be explicitly hidden
7259>>>>>>>        If (Active_State(Self)=0 or pbHidePage(Self) ) Begin
7261>>>>>>>            Get tab_button_item to iTab   // this page's tab item #
7262>>>>>>>            Send Request_tab_Display iTab // makes page active without taking focus.
7263>>>>>>>        End
7263>>>>>>>>
7263>>>>>>>    End_Procedure
7264>>>>>>>    
7264>>>>>>>    Procedure Rotate_Up
7266>>>>>>>        // We only want to rotate up a tab page if it is the current page.
7266>>>>>>>        // This is needed when multiple tab pages remain in the focus tree
7266>>>>>>>        Integer i
7266>>>>>>>        Delegate Get current_item to i
7268>>>>>>>        If (tab_page_id(Self,i)=Self) ;            Forward Send rotate_up
7272>>>>>>>    End_Procedure
