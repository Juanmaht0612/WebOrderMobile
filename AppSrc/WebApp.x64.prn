25441>>>>>>>>>>>>>>>        Property Integer pbPromptButton C_WebDefault  // If True a prompt button is drawn (see also pbServerOnPrompt, psClientOnPrompt)
25444>>>>>>>>>>>>>>>        Property Boolean pbServerOnPrompt True        // Set to true to trigger server OnPrompt event when the prompt button is clicked (see also pbPromptButton)
25447>>>>>>>>>>>>>>>        Property String psClientOnPrompt ""           // Name of client side OnPrompt event handler. See also pbPromptButton.
25450>>>>>>>>>>>>>>>
