35586>>>>>        Move (SizeOfArray(gaAdvSyncProps[iStoreIndex]) - 1) to iTo
35587>>>>>        For iCur from 0 to iTo
35593>>>>>>
35593>>>>>            If (gaAdvSyncProps[iStoreIndex][iCur].hoObj = hoObj and Uppercase(gaAdvSyncProps[iStoreIndex][iCur].tSyncProp.sP) = sPropName) Begin
35595>>>>>                Function_Return iCur
35596>>>>>            End
35596>>>>>>
35596>>>>>        Loop
35597>>>>>>
35597>>>>>        
35597>>>>>        Function_Return -1
35598>>>>>    End_Function
