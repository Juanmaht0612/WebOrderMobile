4430>>>>>    
4430>>>>>    Procedure Page Integer iPageObject
4432>>>>>        Integer iOld iNew
4432>>>>>        // This special code to make Codejock skinning work better. When skins are applied the window size
4432>>>>>        // is maintained and the clientsize if changed. If we are using client-sizing we want to keep the size
4432>>>>>        // the same. pbMaintainGuiSizeOnPage allows one to disable this special behavior.
4432>>>>>        If (iPageObject=1 and pbMaintainGuiSizeOnPage(Self) and pbSizeToClientArea(Self)) Begin
4434>>>>>            // when modal dialog windows are created they are created in create_dialog and the size has already
4434>>>>>            // been skin adjusted. We store the value before that happens and use it here
4434>>>>>            // this should only happen with modal dialogs. At this point they should have a window_handle but we
4434>>>>>            // check just to be careful.
4434>>>>>            Send OnPreApplySkin False
4435>>>>>            Forward Send Page iPageObject
4437>>>>>            Send OnPostApplySkin False
4438>>>>>        End
4438>>>>>>
4438>>>>>        Else Begin
4439>>>>>            Forward Send Page iPageObject
4441>>>>>        End
4441>>>>>>
4441>>>>>        If (iPageObject =1) Begin
4443>>>>>            Send OnResize
4444>>>>>        End
4444>>>>>>
4444>>>>>    End_Procedure
4445>>>>>    
4445>>>>>    // When skins are applied to views we want to maintain the client size. I theory we want to do this to all objects
4445>>>>>    // with pbSizeToClientArea=T. Views are the most likely objects to need this which is what I've tested this with.
4445>>>>>    Procedure OnPreApplySkin Boolean bReApply
4447>>>>>        Handle hWnd
4447>>>>>        Integer iVoid
4447>>>>>        Get Window_Handle to hWnd
4448>>>>>        // if we are repapplying a skin and it is not active we end
4448>>>>>        // if we are not reapplying (page) and it has a window then this has already
4448>>>>>        // been called by create_dialog - we end
4448>>>>>        If ((bReApply and hWnd=0) or (not(bReApply) and hWnd)) Begin
4450>>>>>            Procedure_Return
4451>>>>>        End
4451>>>>>>
4451>>>>>        
4451>>>>>        If (pbSizeToClientArea(Self)) Begin
4453>>>>>            Set piPrePageGuiSize to (GuiSize(Self))
4454>>>>>            If (hWnd and bReApply) Begin
4456>>>>>                Move (SendMessage(hWnd, WM_SETREDRAW, 0, 0)) to iVoid    // turn off painting
4457>>>>>            End
4457>>>>>>
4457>>>>>        End
4457>>>>>>
4457>>>>>        Broadcast Send OnPreApplySkin bReApply
4459>>>>>    End_Procedure
4460>>>>>    
4460>>>>>    Procedure OnPostApplySkin Boolean bReApply
4462>>>>>        Integer iNew iVoid
4462>>>>>        Handle hWnd
4462>>>>>        Boolean bOk
4462>>>>>        Get Window_Handle to hWnd
4463>>>>>        
4463>>>>>        If (bReApply and hWnd=0) Begin
4465>>>>>            Procedure_Return
4466>>>>>        End
4466>>>>>>
4466>>>>>        
4466>>>>>        Broadcast Send OnPostApplySkin bReApply
4468>>>>>        If (hWnd and pbSizeToClientArea(Self)) Begin
4470>>>>>            Get GuiSize to iNew
4471>>>>>            If (iNew<>0 and iNew<>piPrePageGuiSize(Self)) Begin
4473>>>>>                Set GuiSize to (hi(piPrePageGuiSize(Self))) (low(piPrePageGuiSize(Self)))
4474>>>>>            End
4474>>>>>>
4474>>>>>            If bReApply Begin
4476>>>>>                Move (SendMessage(hWnd, WM_SETREDRAW, 1, 0)) to iVoid    // turn back on painting
4477>>>>>                Move (RedrawWindow(hWnd, 0, 0, RDW_ERASE ior RDW_FRAME ior RDW_INVALIDATE ior RDW_ALLCHILDREN ior RDW_ERASENOW ior RDW_UPDATENOW)) to bOk
4478>>>>>            End
4478>>>>>>
4478>>>>>            Set piPrePageGuiSize to 0 0
4479>>>>>        End
4479>>>>>>
4479>>>>>    End_Procedure
4480>>>>>    
4480>>>>>    
