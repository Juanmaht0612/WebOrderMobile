33968>>>>>>>    //  Registers a folder as being allowed to stream files from. Even through the download URL's 
33968>>>>>>>    //  should be secure this provides an extra layer of security on top of the encryption.
33968>>>>>>>    //
33968>>>>>>>    //  Params:
33968>>>>>>>    //      sPath   The absolute path to this folder (relative paths will not work!).
33968>>>>>>>    Procedure RegisterDownloadFolder String sPath
33970>>>>>>>        String[] aFolders
33971>>>>>>>        
33971>>>>>>>        Get paDownloadFolders to aFolders
33972>>>>>>>        
33972>>>>>>>        //  Convert relative paths into a full path and lowercase for comparison
33972>>>>>>>        Get FullPathName sPath to sPath
33973>>>>>>>        Move (Lowercase(sPath)) to sPath
33974>>>>>>>        
33974>>>>>>>        //  Add trailing "\" to prevent "Picture" sharing also "Pictures" mistake
33974>>>>>>>        If (Right(sPath, 1) <> "\") Begin
33976>>>>>>>            Move (sPath + "\") to sPath
33977>>>>>>>        End
33977>>>>>>>>
33977>>>>>>>        
33977>>>>>>>        //  Prevent duplicates
33977>>>>>>>        If (SearchArray(sPath, aFolders) >= 0) Begin
33979>>>>>>>            Procedure_Return 
33980>>>>>>>        End
33980>>>>>>>>
33980>>>>>>>        
33980>>>>>>>        //  Add path
33980>>>>>>>        Move sPath to aFolders[SizeOfArray(aFolders)]
33981>>>>>>>        Set paDownloadFolders to aFolders
33982>>>>>>>    End_Procedure
