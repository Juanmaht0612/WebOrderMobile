29909>>>>>>>>>        End
29909>>>>>>>>>>
29909>>>>>>>>>
29909>>>>>>>>>        Get pbSearchSQLFilterSet to bFilterSet
29910>>>>>>>>>        If bFilterSet Begin
29912>>>>>>>>>            Get phoSearchSQLFilterDD to hoFilterDD
29913>>>>>>>>>            If (hoFilterDD = hoDD) Begin
29915>>>>>>>>>                Procedure_Return
29916>>>>>>>>>            End
29916>>>>>>>>>>
29916>>>>>>>>>            Else Begin
29917>>>>>>>>>                Move True to FilterState.bDisregardFilter
29918>>>>>>>>>                Move FilterState to vFilterState
29919>>>>>>>>>                Send DisregardFilter vFilterState
29920>>>>>>>>>                Move False to FilterState.bDisregardFilter
29921>>>>>>>>>                Move FilterState to vFilterState
29922>>>>>>>>>            End
29922>>>>>>>>>>
29922>>>>>>>>>        End
29922>>>>>>>>>>
29922>>>>>>>>>
29922>>>>>>>>>        Get pbUseDDSqlFilters of hoDD to bOrigActive
29923>>>>>>>>>        Get psSQLFilter of hoDD to sOrigFilter
29924>>>>>>>>>
29924>>>>>>>>>        If (not(bOrigActive)) Begin
29926>>>>>>>>>            Procedure_Return
29927>>>>>>>>>        End
29927>>>>>>>>>>
29927>>>>>>>>>
29927>>>>>>>>>        Get phoColumnObjects to ahoColumns
29928>>>>>>>>>        WebGet pbSearchHiddenColumns to bSearchHiddenColumns
29929>>>>>>>>>
29929>>>>>>>>>        While (iColumn < SizeOfArray(ahoColumns))
29933>>>>>>>>>            WebGet pbHidden of ahoColumns[iColumn] to bHidden
29934>>>>>>>>>            If (bSearchHiddenColumns or not(bHidden)) Begin
29936>>>>>>>>>                Get Data_File of ahoColumns[iColumn] to iFile
29937>>>>>>>>>                Get Data_Field of ahoColumns[iColumn] to iField
29938>>>>>>>>>
29938>>>>>>>>>                If (iFile <> 0 and iField <> 0) Begin
29940>>>>>>>>>                    Get BuildFilterExpressionForField hoDD iFile iField sSearchValue to sColumnFilter
29941>>>>>>>>>                    If (sColumnFilter <> "") Begin
