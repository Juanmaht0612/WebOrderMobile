23400>>>>>>>    // sets all Constrain_Files starting at hoMainDD and up as based on the view stack.
23400>>>>>>>    Procedure EstablishConstrainFiles Handle hoMainDD tWebViewInfo[] aViewStack Handle[] ByRef hoStackDDOs RowID[] ByRef riStackRowIds
23402>>>>>>>        Integer iClient iClients iStack iParent iStackSize
23402>>>>>>>        Handle hoDDO hoParentDD
23402>>>>>>>        
23402>>>>>>>        // set constrain_file to 0 from main_DDO on up
23402>>>>>>>        Send ClearConstrainFiles hoMainDD 
23403>>>>>>>        
23403>>>>>>>        // establish all parent constraints. Take any nfFromParent and set
23403>>>>>>>        // a constrain if this view has the same DDO structure.
23403>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
23404>>>>>>>        For iStack from 1 to (iStackSize-1)
23410>>>>>>>>
23410>>>>>>>            If (aViewStack[iStack].eNavigateType=nfFromParent) Begin
23412>>>>>>>                Get FindDDOForTable aViewStack[iStack-1].iMainTable to hoParentDD
23413>>>>>>>                // it's possible for there to be no connection here in this view, that's ok
23413>>>>>>>                If hoParentDD Begin
23415>>>>>>>                    // keep track of all parents and their RowId
23415>>>>>>>                    Move (InsertInArray(hoStackDDOs,-1,hoDDO)) to hoStackDDOs
23416>>>>>>>//                    Move (InsertInArray(riStackRowIds,-1,DeserializeRowID(aViewStack[iStack-1].sMainTableRowID))) to riStackRowIds
23416>>>>>>>                    Move (InsertInArray(riStackRowIds,-1,aViewStack[iStack-1].riMainTable)) to riStackRowIds
23417>>>>>>>                    // Set constraint to this parent for all children.
23417>>>>>>>                    // Odds are there will only be one or no child connections.
23417>>>>>>>                    Get Data_Set_Client_Count of hoParentDD to iClients
23418>>>>>>>                    For iClient from 0 to (iClients-1)
23424>>>>>>>>
23424>>>>>>>                        Get Data_Set_Client of hoParentDD iClient to hoDDO
23425>>>>>>>                        Set Constrain_File of hoDDO to aViewStack[iStack-1].iMainTable
23426>>>>>>>                    Loop
23427>>>>>>>>
23427>>>>>>>                End
23427>>>>>>>>
23427>>>>>>>            End
23427>>>>>>>>
23427>>>>>>>        Loop
23428>>>>>>>>
23428>>>>>>>    End_Procedure
