4546>>>>>
4546>>>>>// This used by form and entry classes to handle the differences that
4546>>>>>// occur because DF thinks as a multi-item object and these are single item
4546>>>>>//
4546>>>>>//
4546>>>>>// 1. define alternate switch behavior for single items form and entry
4546>>>>>//
4546>>>>>Class Single_Item_Navigate_Mixin is a Mixin
4547>>>>>    Procedure Define_Single_Item_Navigate_Mixin
4549>>>>>        // This will tell the object that it should switch/switch_back
4549>>>>>        // by skipping other dfentry_forms. The reason we made this a
4549>>>>>        // property is so it can be overridden. Switch_Next_area and
4549>>>>>        // Switch_Prior_area uses this.
4549>>>>>        //
4549>>>>>        Set Switch_Skip_State to True
4550>>>>>        Send Define_Shadow_Mixin
4551>>>>>    End_Procedure
4552>>>>>    
4552>>>>>    Import_Class_Protocol Shadow_Mixin
4553>>>>>    
4553>>>>>    // The switch_next_area and switch_Prior_area messages are sent by the
4553>>>>>    // F6/Shift+F6 keys. Changes are made here to make a switch do something
4553>>>>>    // useful in entry_forms. The current goal is to make it act like the
4553>>>>>    // character mode product. We do this by making the switch skip all
4553>>>>>    // dfentry_forms until it hits a DEO that is not an entry-form. This
4553>>>>>    // changed behavior only occurs when switching FROM a dfentry_form
4553>>>>>    // TO another dfentry_form.
4553>>>>>    //
4553>>>>>    Procedure Switch_Next_Area
4555>>>>>        Integer Obj Ef Rval hoRing
4555>>>>>        // if there are multiple items in the form, treat it like a normal
4555>>>>>        // entry-form and do the normal switch message.
4555>>>>>        If (Item_Count(Self)>1) ;            Send Switch
4558>>>>>        Else Begin
4559>>>>>            Move Self to Obj
4560>>>>>            Move 0 to ef
4561>>>>>            // we want to keep looking until the next object is a container (we switch into containers)
4561>>>>>            // or the next object is in a different container than the one we are in (which handles
4561>>>>>            // switching out of a container)
4561>>>>>            Repeat
4561>>>>>>
4561>>>>>                Get Next_Object_Id of Obj 0 to Obj // Normal Switch Behavior
4562>>>>>                If (Obj=0 or Obj=Self) Begin
4564>>>>>                    // if no next object or we are back to this object. We are either in a ring
4564>>>>>                    // or we are done. See if we have a ring parent. If we have a ring parent see
4564>>>>>                    // if the ring contains the focus and the object we found is ourselves. If that's the
4564>>>>>                    // case, switch tried its best and there is nowhere to go. Return a zero.
4564>>>>>                    // If the ring does not have the focus or there was not object then if not
4564>>>>>                    // a scope (not a view) Send next_object_id noDescend to it. This is created to provide a
4564>>>>>                    // way to next get stuck inside of rings with no focusable objects.
4564>>>>>                    Get RingParent to hoRing
4565>>>>>                    // if ring contains focus and we've come back to ourselves assume we've tried
4565>>>>>                    // our best and there is nowhere to go.
4565>>>>>                    If (hoRing and ContainsFocus(hoRing) and obj=Self) ;                        Move 0 to Obj
4568>>>>>                    Else Begin
4569>>>>>                        If (hoRing and scope_state(hoRing)=0) ;                            Get next_object_id of hoRing 1 to obj
4572>>>>>                        Else ;                            Move 0 to obj
4574>>>>>                    End
4574>>>>>>
4574>>>>>                    If (Obj=0) ;                        Procedure_Return
4577>>>>>                End
4577>>>>>>
4577>>>>>                If (Client_area_state(obj) or parent(Self)<>parent(obj) ) ;                    Move 1 to Ef
4580>>>>>            Until Ef
4582>>>>>            
4582>>>>>            Get Msg_Activate of Obj to Rval // Try To Activate Object
4583>>>>>            // if we fail activation we want to do what switch normally does
4583>>>>>            // which is to keep trying to switch.
4583>>>>>            If Rval ;                Send Switch to Obj // Send To Object That Didn'T Activate
4586>>>>>        End
4586>>>>>>
4586>>>>>    End_Procedure
4587>>>>>    
4587>>>>>    
4587>>>>>    Procedure Switch_Prior_Area  // See Comments In Switch_Next_Area
4589>>>>>        Integer Obj Ef Rval hoRing
4589>>>>>        If (Item_Count(Self)>1) ;            Send Switch_Back
4592>>>>>        Else Begin
4593>>>>>            Move Self to Obj
4594>>>>>            Repeat
4594>>>>>>
4594>>>>>                Get Prior_Object_Id of obj 0 to Obj
4595>>>>>                If (Obj=0 or Obj=Self) Begin
4597>>>>>                    Get RingParent to hoRing
4598>>>>>                    If (hoRing and ContainsFocus(hoRing) and obj=Self) ;                        Move 0 to Obj
4601>>>>>                    Else Begin
4602>>>>>                        If (hoRing and scope_state(hoRing)=0) ;                            Get prior_object_id of hoRing 0 to obj
4605>>>>>                        Else ;                            Move 0 to obj
4607>>>>>                    End
4607>>>>>>
4607>>>>>                    If (Obj=0) ;                        Procedure_Return
4610>>>>>                End
4610>>>>>>
4610>>>>>                If (parent(Self)<>parent(obj) ) ;                    Move 1 to Ef
4613>>>>>            Until Ef
4615>>>>>            //delegate Get Prior_Object_Id 0 To Obj
4615>>>>>            //If (Obj=0 Or Obj=self or parent(obj)=parent(self)) Procedure_Return
4615>>>>>            Get Msg_Activate of Obj to Rval
4616>>>>>            If Rval ;                Send Switch_Back to Obj
4619>>>>>        End
4619>>>>>>
4619>>>>>    End_Procedure
4620>>>>>    
4620>>>>>    //  Navigational work-around. In single item objects previous does not
4620>>>>>    //  work when the previous item is displayonly (any shadow-state condition).
4620>>>>>    //  The previous key remains where it is. While next works, it does not
4620>>>>>    //  work well in that the NEXT is sent recursively - place enough display
4620>>>>>    //  only object together and the stack would overflow. Switch/Switch_back
4620>>>>>    //  will continue searching if the object's activation fails (activate,
4620>>>>>    //  entering or exiting). We will trigger entering to return a non-zero
4620>>>>>    //  value if 1) it was already going to do that, or 2) we've got a single
4620>>>>>    //  item object and that single item's shadow-state is set. This seems to
4620>>>>>    //  address all possibilities.
4620>>>>>    //
4620>>>>>    Procedure Entering Returns Integer
4622>>>>>        Integer Rval
4622>>>>>        Forward Get Msg_Entering to Rval  // Do Normal Entering
4624>>>>>        // if entering is ok and single item check shadow state of that item.
4624>>>>>        If (Rval=0 and Item_Count(Self)=1) ;            Get Shadow_State 0 to Rval
4627>>>>>        Procedure_Return Rval
4628>>>>>    End_Procedure
4629>>>>>End_Class
