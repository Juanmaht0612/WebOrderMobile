5675>>>>>
5675>>>>>Class Grid is a DfBaseFormList
5676>>>>>    
5676>>>>>    Procedure Construct_Object
5678>>>>>        Forward Send Construct_Object
5680>>>>>        Send Define_Standard_Grid_Mixin
5681>>>>>        // This determines if the scroll occurs when the thumb is dragged
5681>>>>>        // When false, it scrolls when the thumb is released. Only set it to
5681>>>>>        // false if the scroll takes a long time.
5681>>>>>        Property Integer ScrollOnThumbTrackState True
5682>>>>>        // This determines if thumb should be sized proportionally to the scroll
5682>>>>>        // area. When true it acts like a normal windows list. When false, you get
5682>>>>>        // old vdf behavior where thumb is small and scroll moves up down one line at
5682>>>>>        // a time
5682>>>>>        Property Integer ThumbScrollState True
5683>>>>>        // If the developer wishes to augment the vScroll messages they can shut
5683>>>>>        // the existing customizations by setting this true
5683>>>>>        Property Integer CustomScrollState False
5684>>>>>    End_Procedure
5685>>>>>    
5685>>>>>    Import_Class_Protocol Standard_Grid_Mixin
5686>>>>>    
5686>>>>>    Procedure End_Construct_Object
5688>>>>>        Send Define_List_Form_Columns
5689>>>>>        Forward Send End_Construct_Object
5691>>>>>    End_Procedure
5692>>>>>    
5692>>>>>    Procedure SetVScrollInfo Integer iMin Integer iMax Integer iPage
5694>>>>>        If not (CustomScrollState(Self)) Begin
5696>>>>>            If (ThumbScrollState(Self)) ;                Move (displayable_rows(Self)) to iPage
5699>>>>>        End
5699>>>>>>
5699>>>>>        // showln iMin ' ' iMax ' ' iPage
5699>>>>>        Forward Send SetVScrollInfo iMin iMax iPage
5701>>>>>    End_Procedure
5702>>>>>    
5702>>>>>    Procedure SetVScrollPos Integer iPos
5704>>>>>        If not (CustomScrollState(Self)) Begin
5706>>>>>            If (ThumbScrollState(Self)) ;                Move (top_item(Self)/line_size(Self)) to iPos
5709>>>>>            //Showln "SetVScrollPos" iPos
5709>>>>>        End
5709>>>>>>
5709>>>>>        Forward Send SetVScrollPos  iPos
5711>>>>>    End_Procedure
5712>>>>>    
5712>>>>>    Procedure SetVScrollbox Integer iType Integer iData
5714>>>>>        Integer iTop bFast
5714>>>>>        If not (CustomScrollState(Self)) Begin
5716>>>>>            //Showln "SetVScrollBox" iType ", " iData
5716>>>>>            If (iType=SB_THUMBPOSITION or iType=SB_THUMBTRACK) Begin
5718>>>>>                Get ScrollOnThumbTrackState to bFast
5719>>>>>                If (( iType=SB_THUMBPOSITION and bFast) or ;                    (iType=SB_THUMBTRACK and not(bFast))) ;                    Procedure_Return
5722>>>>>                If not (ThumbScrollState(Self)) ;                    Move SB_THUMBPOSITION to iType
5725>>>>>                Else Begin
5726>>>>>                    Move (Top_item(Self)/line_size(Self)) to iTop
5727>>>>>                    If (iTop<>iData) Begin
5729>>>>>                        If (iTop>iData) ;                            Send scroll upward_direction (iTop-iData)
5732>>>>>                        Else ;                            Send Scroll downward_direction (iData-iTop)
5734>>>>>                    End
5734>>>>>>
5734>>>>>                    Procedure_Return
5735>>>>>                End
5735>>>>>>
5735>>>>>            End
5735>>>>>>
5735>>>>>        End
5735>>>>>>
5735>>>>>        // send accelerator keys for top and bottom
5735>>>>>        If (iType=SB_BOTTOM) Begin
5737>>>>>            Send End_of_Data
5738>>>>>        End
5738>>>>>>
5738>>>>>        Else If (iType=SB_TOP) Begin
5741>>>>>            Send Beginning_of_Data
5742>>>>>        End
5742>>>>>>
5742>>>>>        Else Begin
5743>>>>>            Forward Send SetVScrollBox iType iData
5745>>>>>        End
5745>>>>>>
5745>>>>>    End_Procedure
5746>>>>>    
5746>>>>>End_Class
