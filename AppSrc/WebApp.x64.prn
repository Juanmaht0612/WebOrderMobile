20761>>>>>>>>>>>    Procedure RequestSaveCallBack Integer eConfirmMode
20763>>>>>>>>>>>        Boolean bActive
20763>>>>>>>>>>>        
20763>>>>>>>>>>>        //  Security check
20763>>>>>>>>>>>        WebGet pbSaveCallbackActive to bActive
20764>>>>>>>>>>>        If (not(bActive)) Begin
20766>>>>>>>>>>>            Error DFERR_WEBAPP_ACCESS_DENIED
20767>>>>>>>>>>>>
20767>>>>>>>>>>>            Procedure_Return
20768>>>>>>>>>>>        End
20768>>>>>>>>>>>>
20768>>>>>>>>>>>        WebSet pbSaveCallbackActive to False
20769>>>>>>>>>>>        
20769>>>>>>>>>>>        // called as a callback started by Request_Save
20769>>>>>>>>>>>        If (eConfirmMode=cmYes) Begin
20771>>>>>>>>>>>            Send RequestSaveExec
20772>>>>>>>>>>>        End
20772>>>>>>>>>>>>
20772>>>>>>>>>>>    End_Procedure
20773>>>>>>>>>>>    
20773>>>>>>>>>>>    // What to do with a new unchanged record. The normal framework behavior has always been
20773>>>>>>>>>>>    // to do nothing. With drilldown, it might make the most sense to attempt a save. Currently
20773>>>>>>>>>>>    // when drilldown, we will return True, else false
20773>>>>>>>>>>>    Function AlwaysSaveNew Returns Boolean
20775>>>>>>>>>>>        Integer eViewStyle
20775>>>>>>>>>>>        Boolean bSave
20775>>>>>>>>>>>        Get WebViewStyle to eViewStyle
20776>>>>>>>>>>>        If (eViewStyle=wvsDrillDown) Begin
20778>>>>>>>>>>>            Get AlwaysSaveWhenNewDrillDown to bSave
20779>>>>>>>>>>>        End
20779>>>>>>>>>>>>
20779>>>>>>>>>>>        Function_Return bSave
20780>>>>>>>>>>>    End_Function
20781>>>>>>>>>>>    
20781>>>>>>>>>>>    Procedure Request_Save
20783>>>>>>>>>>>        Handle hoServer
20783>>>>>>>>>>>        Integer iRetVal
20783>>>>>>>>>>>        Boolean bDelegate bRequestValidateAll bShouldSave bHasRec
20783>>>>>>>>>>>        
20783>>>>>>>>>>>        Get DelegateDeoRequest to bDelegate
20784>>>>>>>>>>>        If bDelegate Begin
20786>>>>>>>>>>>            Delegate Send Request_Save
20788>>>>>>>>>>>            Procedure_Return
20789>>>>>>>>>>>        End
20789>>>>>>>>>>>>
20789>>>>>>>>>>>        
20789>>>>>>>>>>>        Get Server to hoServer
20790>>>>>>>>>>>        
20790>>>>>>>>>>>        If ((hoServer <> 0) and not(Read_Only_State(hoServer))) Begin
20792>>>>>>>>>>>            Get Should_Save of hoServer to bShouldSave
20793>>>>>>>>>>>            // if no changes but a new record, we may want to attempt a save anyway (for drilldown style)
20793>>>>>>>>>>>            If (not(bShouldSave)) Begin
20795>>>>>>>>>>>                Get HasRecord of hoServer to bHasRec
20796>>>>>>>>>>>                If not bHasRec Begin
20798>>>>>>>>>>>                    Get AlwaysSaveNew to bShouldSave
20799>>>>>>>>>>>                End
20799>>>>>>>>>>>>
20799>>>>>>>>>>>            End
20799>>>>>>>>>>>>
20799>>>>>>>>>>>            If bShouldSave Begin
20801>>>>>>>>>>>                // Handle save validation....
20801>>>>>>>>>>>                Get pbRequesteValidateAll to bRequestValidateAll
20802>>>>>>>>>>>                If bRequestValidateAll Begin
20804>>>>>>>>>>>                    Get Request_Validate_All of hoServer to iRetVal
20805>>>>>>>>>>>                End
20805>>>>>>>>>>>>
20805>>>>>>>>>>>                Else Begin
20806>>>>>>>>>>>                    Get Request_Validate of hoServer to iRetVal
20807>>>>>>>>>>>                End
20807>>>>>>>>>>>>
20807>>>>>>>>>>>                If (iRetVal=0) Begin
20809>>>>>>>>>>>                    WebSet pbSaveCallbackActive to True
20810>>>>>>>>>>>                    Send VerifyRequest (RefProc(RequestSaveCallBack)) (RefFunc(Verify_Save_Msg))
20811>>>>>>>>>>>                End
20811>>>>>>>>>>>>
20811>>>>>>>>>>>            End
20811>>>>>>>>>>>>
20811>>>>>>>>>>>            Else Begin
20812>>>>>>>>>>>                If (pbClearAfterSave(Self)) Begin
20814>>>>>>>>>>>                    Send RequestClearExec
20815>>>>>>>>>>>                End
20815>>>>>>>>>>>>
20815>>>>>>>>>>>                Send OnViewSaved hoServer False
20816>>>>>>>>>>>            End
20816>>>>>>>>>>>>
20816>>>>>>>>>>>        End
20816>>>>>>>>>>>>
20816>>>>>>>>>>>    End_Procedure
20817>>>>>>>>>>>    
20817>>>>>>>>>>>    
20817>>>>>>>>>>>    Procedure RequestSaveExec
20819>>>>>>>>>>>        Handle hoServer
20819>>>>>>>>>>>        Integer iRetVal
20819>>>>>>>>>>>        Boolean bRequestValidateAll bErr
20819>>>>>>>>>>>        Get Server to hoServer
20820>>>>>>>>>>>        // this may be a 2nd request_validate, that's ok.
20820>>>>>>>>>>>        Get pbRequesteValidateAll to bRequestValidateAll
20821>>>>>>>>>>>        If bRequestValidateAll Begin
20823>>>>>>>>>>>            Get Request_Validate_All of hoServer to iRetVal
20824>>>>>>>>>>>        End
20824>>>>>>>>>>>>
20824>>>>>>>>>>>        Else Begin
20825>>>>>>>>>>>            Get Request_Validate of hoServer to iRetVal
20826>>>>>>>>>>>        End
20826>>>>>>>>>>>>
20826>>>>>>>>>>>        If (iRetVal=0) Begin
20828>>>>>>>>>>>            Move False to Err
20829>>>>>>>>>>>            Send Request_Save to hoServer
20830>>>>>>>>>>>            Move Err to bErr
20831>>>>>>>>>>>            If (not(bErr)) Begin
20833>>>>>>>>>>>                // clear saved record
20833>>>>>>>>>>>                If (pbClearAfterSave(Self)) Begin
20835>>>>>>>>>>>                    Send RequestClearExec
20836>>>>>>>>>>>                End
20836>>>>>>>>>>>>
20836>>>>>>>>>>>                Send OnViewSaved hoServer True
20837>>>>>>>>>>>            End
20837>>>>>>>>>>>>
20837>>>>>>>>>>>        End
20837>>>>>>>>>>>>
20837>>>>>>>>>>>    End_Procedure
