1416>>>>>>>>>
1416>>>>>>>>> //  Encodes the passed value using the URI encoding scheme.
1416>>>>>>>>>Function UrlEncode Global String sValue Boolean bSegment Returns String
1418>>>>>>>>>    WString wWideEncoded wPart
1418>>>>>>>>>    String sEncoded  
1418>>>>>>>>>    String sResult
1418>>>>>>>>>    DWord dwSize dwFlags
1418>>>>>>>>>    Integer iRes iPart iStart
1418>>>>>>>>>    
1418>>>>>>>>>    //  The UrlEscape is limited by the maximum URL lenght so we call it chunck by chunck
1418>>>>>>>>>    Move 0 to iStart
1419>>>>>>>>>    Move 1000 to iPart
1420>>>>>>>>>    
1420>>>>>>>>>    If (bSegment) Begin
1422>>>>>>>>>        Move URL_ESCAPE_SEGMENT_ONLY to dwFlags
1423>>>>>>>>>    End
1423>>>>>>>>>>
1423>>>>>>>>>    
1423>>>>>>>>>    While (iStart < Length(sValue))
1427>>>>>>>>>        Move (Mid(sValue, iPart, iStart + 1)) to wPart
1428>>>>>>>>>        
1428>>>>>>>>>        //  Call UrlEscape
1428>>>>>>>>>        Move (Length(wPart) + 1) to dwSize
1429>>>>>>>>>        Move (Repeat(" ", dwSize)) to wWideEncoded
1430>>>>>>>>>        
1430>>>>>>>>>        Move (UrlEscapeW(AddressOf(wPart), AddressOf(wWideEncoded), AddressOf(dwSize), dwFlags)) to iRes
1431>>>>>>>>>                
1431>>>>>>>>>        If (Length(wPart) < dwSize) Begin
1433>>>>>>>>>            Move (Repeat(" ", dwSize)) to wWideEncoded
1434>>>>>>>>>            Move (UrlEscapeW(AddressOf(wPart), AddressOf(wWideEncoded), AddressOf(dwSize), dwFlags)) to iRes
1435>>>>>>>>>        End
1435>>>>>>>>>>
1435>>>>>>>>>        
1435>>>>>>>>>        Move (CString(wWideEncoded)) to sEncoded
1436>>>>>>>>>        
1436>>>>>>>>>        //  Do extra replacements for cookies
1436>>>>>>>>>        Move (Replaces(";", sEncoded, "%3B")) to sEncoded
1437>>>>>>>>>        If (bSegment) Begin
1439>>>>>>>>>            Move (Replaces("=", sEncoded, "%3D")) to sEncoded
1440>>>>>>>>>        End
1440>>>>>>>>>>
1440>>>>>>>>>        
1440>>>>>>>>>        
1440>>>>>>>>>        Move (iStart + iPart) to iStart
1441>>>>>>>>>        Move (sResult + sEncoded) to sResult
1442>>>>>>>>>    Loop
1443>>>>>>>>>>
1443>>>>>>>>>    
1443>>>>>>>>>    Function_Return sResult    
1444>>>>>>>>>End_Function
1445>>>>>>>>>
1445>>>>>>>>>//  Decodes the passed value using the URI encoding scheme.
1445>>>>>>>>>Function UrlDecode Global String sValue Returns String
1447>>>>>>>>>    Integer iVoid
1447>>>>>>>>>    WString wValue
1447>>>>>>>>>    
1447>>>>>>>>>    If (Trim(sValue) <> "") Begin
1449>>>>>>>>>        Move (Replaces("%3D", Replaces("%3B", sValue, ";"), "=")) to wValue
1450>>>>>>>>>        Move (UrlUnescapeW(AddressOf(wValue), 0, 0, URL_UNESCAPE_INPLACE)) to iVoid
1451>>>>>>>>>    End
1451>>>>>>>>>>
1451>>>>>>>>>    
1451>>>>>>>>>    Function_Return (CString(wValue))
1452>>>>>>>>>End_Function
1453>>>>>>>>>
1453>>>>>>>>>// Returns True if the sPath is a directory.
1453>>>>>>>>>Function IsDirectory Global String sPath Returns Boolean
1455>>>>>>>>>    Integer iAttributes
1455>>>>>>>>>    Move (GetFileAttributes(sPath)) to iAttributes
1456>>>>>>>>>    If (iAttributes <> INVALID_FILE_ATTRIBUTES) Begin
1458>>>>>>>>>        Function_Return  (IsFlagIn(FILE_ATTRIBUTE_DIRECTORY, iAttributes))
1459>>>>>>>>>    End
1459>>>>>>>>>>
1459>>>>>>>>>    Function_Return False // File is not a directory (or doesn't exist)
1460>>>>>>>>>End_Function
1461>>>>>>>>>
1461>>>>>>>>>//  Convert a short name or qualified name with relative references to a long name.
1461>>>>>>>>>//  Relative path is converted with respect to the current working directory. 
1461>>>>>>>>>//  (see Get_Current_Directory and SetCurrentDirectory).
1461>>>>>>>>>//
1461>>>>>>>>>//  This works even if the directories don't exist - this does more a syntatical check
1461>>>>>>>>>//  e.g.  c:\MyApp\..\MyApp\appsrc ----> c:\MyApp\appsrc
1461>>>>>>>>>//                   \MyApp\appsrc ----> c:\MyApp\appsrc  
1461>>>>>>>>>//
1461>>>>>>>>>Function FullPathName Global String sRelPathName Returns String
1463>>>>>>>>>    WString sFullPathName
1463>>>>>>>>>    Pointer lpsFilePart
1463>>>>>>>>>    Integer icChar // the number of characters returned
1463>>>>>>>>>    
1463>>>>>>>>>    Move (Repeat(character(0), 4096)) to sFullPathName
1464>>>>>>>>>    Move -1 to lpsFilePart
1465>>>>>>>>>    Move (GetFullPathNameW(sRelPathName, 4096, AddressOf(sFullPathName), AddressOf(lpsFilePart))) to icChar
1466>>>>>>>>>    
1466>>>>>>>>>    Function_Return (trim(sFullPathName))
1467>>>>>>>>>End_Function
1468>>>>>>>>>
1468>>>>>>>>>// This is a recursive function. It will create the directory sDir, but if the parent directory
1468>>>>>>>>>// of sDir does not exist, then it is created first. This is necessary because Make_Directory needs
1468>>>>>>>>>// the parent directory to be already there or it will fail.
1468>>>>>>>>>//
1468>>>>>>>>>// Returns True if the directory already exists or if it was successfully created.
1468>>>>>>>>>Function CreateDirectoryRecursive Global String sDir Returns Boolean
1470>>>>>>>>>    Integer iPos iCount
1470>>>>>>>>>    String sParent sSep
1470>>>>>>>>>    Boolean bResult
1470>>>>>>>>>    Move (SysConf(SYSCONF_DIR_SEPARATOR)) to sSep   // i.e. sSep = "\"
1471>>>>>>>>>
1471>>>>>>>>>    Move True         to bResult
1472>>>>>>>>>    Move (Trim(sDir)) to sDir
1473>>>>>>>>>    Move 1            to iPos  // This is "really" important so that the recursion can break out if the Path name is invalid
1474>>>>>>>>>
1474>>>>>>>>>    // Stop now if sDir is already a directory....
1474>>>>>>>>>    If (IsDirectory(sDir)) ;        Function_Return True
1477>>>>>>>>>
1477>>>>>>>>>    // break out of the recursion if sDir is a drive designator,
1477>>>>>>>>>    // or a "\".
1477>>>>>>>>>    If ((sDir = sSep) or (Right(sDir,1) = ":") or (sDir = "")) ;        Function_Return False
1480>>>>>>>>>
1480>>>>>>>>>    // Find the last "\" position (not counting the last character).
1480>>>>>>>>>    If (Right(sDir ,1) = sSep) Begin
1482>>>>>>>>>        Move (Left(sDir, Length(sDir) - 1)) to sDir
1483>>>>>>>>>    End
1483>>>>>>>>>>
1483>>>>>>>>>
1483>>>>>>>>>    For iCount from 1 to (Length(sDir))
1489>>>>>>>>>>
1489>>>>>>>>>        If (Mid(sDir,1,iCount) = sSep) ;            Move iCount to iPos
1492>>>>>>>>>    Loop
1493>>>>>>>>>>
1493>>>>>>>>>
1493>>>>>>>>>    // get the parent directory.
1493>>>>>>>>>    Move (Left(sDir, iPos - 1)) to sParent
1494>>>>>>>>>
1494>>>>>>>>>    // Test if the Parent directory exists. If not, create it....
1494>>>>>>>>>    If (not(IsDirectory(sParent))) Begin
1496>>>>>>>>>        Move (CreateDirectoryRecursive(sParent)) to bResult
1497>>>>>>>>>    End
1497>>>>>>>>>>
1497>>>>>>>>>
1497>>>>>>>>>    // Now the parent should be built so try to build the passed directory...
1497>>>>>>>>>    If (bResult) Begin
1499>>>>>>>>>        Move False to Err
1500>>>>>>>>>        Make_Directory sDir
1501>>>>>>>>>
1501>>>>>>>>>        If (Err) Begin
1503>>>>>>>>>            Move False to bResult
1504>>>>>>>>>        End
1504>>>>>>>>>>
1504>>>>>>>>>    End
1504>>>>>>>>>>
1504>>>>>>>>>
1504>>>>>>>>>    Function_Return bResult
1505>>>>>>>>>End_Function
1506>>>>>>>
1506>>>>>>>// Returns an extension from a filename: "c:\Test\IDE.src" will return ".src"
1506>>>>>>>// See also ExtractFilePath()
1506>>>>>>>Function ExtractFileExt Global String sFileName Returns String
1508>>>>>>>    Integer iPos
1508>>>>>>>    
1508>>>>>>>    Move (LastDelimeter("\:.", sFileName)) to iPos
1509>>>>>>>    
1509>>>>>>>    If ((iPos > 0) and (Mid(sFileName, 1, iPos) = ".")) ;        Function_Return (Right(sFileName, Length(sFileName) - iPos + 1))
1512>>>>>>>    Else ;        Function_Return ""
1514>>>>>>>End_Function
1515>>>>>>>
1515>>>>>>>
1515>>>>>>>Define IL_AutoTransparency for -1
1515>>>>>>>
1515>>>>>>>Class cImageList32 is a cImageList
1516>>>>>>>    
1516>>>>>>>    Procedure Construct_Object
1518>>>>>>>        Forward Send Construct_Object
1520>>>>>>>        
1520>>>>>>>        // ILC_COLOR
1520>>>>>>>        //     Use the default color depth. Typically, the default is ILC_COLOR4, but for older display drivers,
1520>>>>>>>        //     the default is ILC_COLORDDB.
1520>>>>>>>        // ILC_COLOR4
1520>>>>>>>        //     Use a 4-bit (16-color) device-independent bitmap (DIB) section as the bitmap for the image list.
1520>>>>>>>        // ILC_COLOR8
1520>>>>>>>        //     Use an 8-bit DIB section. The colors used for the color table are the same colors as the halftone palette.
1520>>>>>>>        // ILC_COLOR16
1520>>>>>>>        //     Use a 16-bit (32/64k-color) DIB section.
1520>>>>>>>        // ILC_COLOR24
1520>>>>>>>        //     Use a 24-bit DIB section.
1520>>>>>>>        // ILC_COLOR32
1520>>>>>>>        //     Use a 32-bit DIB section.
1520>>>>>>>        // ILC_COLORDDB
1520>>>>>>>        //     Use a device-dependent bitmap.
1520>>>>>>>        Property Integer peColorDepth ILC_Color32
1521>>>>>>>        Property Boolean pbAutoResizeIcons False
1522>>>>>>>        
1522>>>>>>>        // test to see if scaledown is supported (it is in vista and above)
1522>>>>>>>        Property Boolean pbScaleDownable (Hi(SysConf(SYSCONF_COMCTL_REV))>=6)
1523>>>>>>>    End_Procedure
1524>>>>>>>    
1524>>>>>>>    
1524>>>>>>>    // Overridden superclass method to create image list of the required color depth.
1524>>>>>>>    Procedure DoCreate
1526>>>>>>>        Integer cx cy dwFlags icInitial iGrowBy
1526>>>>>>>        Integer eColorDepth
1526>>>>>>>        Boolean bAutoScale
1526>>>>>>>        
1526>>>>>>>        Get piImageHeight to cy
1527>>>>>>>        Get piImageWidth  to cx
1528>>>>>>>        Get pbAutoResizeIcons to bAutoScale
1529>>>>>>>        If bAutoScale Begin
1531>>>>>>>            Send ScaleSizes (&cx) (&cy)
1532>>>>>>>        End
1532>>>>>>>>
1532>>>>>>>        Get piMaxImages   to iGrowBy
1533>>>>>>>        Get peColorDepth  to eColorDepth
1534>>>>>>>        
1534>>>>>>>        If (eColorDepth = 0) ;            Move ILC_COLOR32 to eColorDepth
1537>>>>>>>        
1537>>>>>>>        Move (eColorDepth + ILC_MASK) to dwFlags
1538>>>>>>>        
1538>>>>>>>        Set phImageList to (ImageList_Create(cx, cy, dwFlags, 0, iGrowBy))
1539>>>>>>>    End_Procedure
1540>>>>>>>    
1540>>>>>>>    
1540>>>>>>>    // Use this function to add a Bitmap, to the imagelist. All images will be scaled to 16x16 pixels.
1540>>>>>>>    // If you do not specify a transparency color then the top left pixel is used to identify the transparent color.
1540>>>>>>>    //
1540>>>>>>>    // See also AddImage, AddCursor, AddIcon.
1540>>>>>>>    //
1540>>>>>>>    // sImage            - is the image filename being loaded.
1540>>>>>>>    // iTransparentColor - Is the RGB color value used as a transparency mask. If you pass IL_AutoTransparency then the
1540>>>>>>>    //                     color of the top left pixel in the bitmap will be used as the transparency mask color.
1540>>>>>>>    // Returns           - The image index of the loaded image or -1 if an error occurs.
1540>>>>>>>    Function AddBitmap String sImage Integer iTransparentColor Returns Integer
1542>>>>>>>        Integer iImage iVoid
1542>>>>>>>        Handle hImage hImageList
1542>>>>>>>        Boolean bOK
1542>>>>>>>        Integer iX iY iH iW
1542>>>>>>>        
1542>>>>>>>        Move -1 to iImage // assume inability to add
1543>>>>>>>        
