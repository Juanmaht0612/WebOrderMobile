31291>>>>>>>        If (hoObj <> C_WebUnresolvedObject) Begin
31293>>>>>>>            Get WebObjectName of hoObj to sObj            
31294>>>>>>>        End
31294>>>>>>>>
31294>>>>>>>        Set psKeyBuddy to sObj
31295>>>>>>>    End_Procedure
