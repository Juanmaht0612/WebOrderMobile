23343>>>>>>>    Procedure WriteDDOCache
23345>>>>>>>        // Stores the DDO object array and creates a corresponding array of DDO object names.
23345>>>>>>>        // Both arrays are sorted according the object names. This cache can then be used for fast
23345>>>>>>>        // lookups of DDO object name to DDO handle.
23345>>>>>>>        //
23345>>>>>>>        // Note: Must be called after Main_DD has been set.
23345>>>>>>>        Handle hoMain_DD
23345>>>>>>>        Integer i icDDO iIndex iCount
23345>>>>>>>        tNameHandlePair[] aDDOIndex
23345>>>>>>>        tNameHandlePair[] aDDOIndex
23346>>>>>>>        
23346>>>>>>>        String[] aNames aSortedNames
23348>>>>>>>        Handle[] aDDOHandles aSortedDDOs aAdditionalDDOStructures
23351>>>>>>>        
23351>>>>>>>        // Get all the DDOs in the main DDO structure
23351>>>>>>>        Get Main_DD to hoMain_DD
23352>>>>>>>        
23352>>>>>>>        If (hoMain_DD <> 0) Begin
23354>>>>>>>            // returns the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
23354>>>>>>>            Send FindDataDictionaries hoMain_DD (&aDDOHandles)
23355>>>>>>>        End
23355>>>>>>>>
23355>>>>>>>        
23355>>>>>>>        // Get all "additional" DDO structures
23355>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
23356>>>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
23357>>>>>>>        
23357>>>>>>>        For i from 0 to (iCount - 1)
23363>>>>>>>>
23363>>>>>>>            // returns the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
23363>>>>>>>            Send FindDataDictionaries aAdditionalDDOStructures[i] (&aDDOHandles)
23364>>>>>>>        Loop
23365>>>>>>>>
23365>>>>>>>    
23365>>>>>>>        
23365>>>>>>>        //  Build the search index
23365>>>>>>>        Move (SizeOfArray(aDDOHandles)) to icDDO
23366>>>>>>>        If (icDDO > 0) Begin
23368>>>>>>>            Move (ResizeArray(aDDOIndex, icDDO)) to aDDOIndex
23369>>>>>>>            For i from 0 to (icDDO - 1)
23375>>>>>>>>
23375>>>>>>>                Get DDIdentity aDDOHandles[i] to aDDOIndex[i].sName
23376>>>>>>>                Move aDDOHandles[i] to aDDOIndex[i].hValue
23377>>>>>>>            Loop
23378>>>>>>>>
23378>>>>>>>            
23378>>>>>>>            Move (SortArray(aDDOIndex, False)) to aDDOIndex
23379>>>>>>>        End
23379>>>>>>>>
23379>>>>>>>        
23379>>>>>>>        // Save the arrays....
23379>>>>>>>        Set paDDOIndex to aDDOIndex
23380>>>>>>>        Set paDDOHandlesTree to aDDOHandles     // Store the DDO tree structure Main DD, followed by child DD tree, then parent DD tree
23381>>>>>>>    End_Procedure
