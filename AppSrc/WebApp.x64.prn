33812>>>>>>>>>        tMultipartParsingData parsedata
33812>>>>>>>>>        UChar[] ucValue ucNewLine ucChunk
33815>>>>>>>>>        tNameValuePair[] aContentValues
33815>>>>>>>>>        tNameValuePair[] aContentValues
33816>>>>>>>>>        tNameValuePair tSearch
33816>>>>>>>>>        tNameValuePair tSearch
33816>>>>>>>>>        
33816>>>>>>>>>        Set piParseErrorCode to 0
33817>>>>>>>>>        Set psParseError to ""
33818>>>>>>>>>        
33818>>>>>>>>>        //  Parse and validate content type
33818>>>>>>>>>        Get GetContentType to sContentType
33819>>>>>>>>>        Get ParseContentType (&sContentType) to aContentValues
33820>>>>>>>>>        If (sContentType <> "multipart/form-data") Begin
33822>>>>>>>>>            Set piParseErrorCode to 1
33823>>>>>>>>>            Set psParseError to "Invalid request format: expected multipart/form-data post"
33824>>>>>>>>>            Function_Return False
33825>>>>>>>>>        End
33825>>>>>>>>>>
33825>>>>>>>>>        
33825>>>>>>>>>        //  Find BOUNDARY value
33825>>>>>>>>>        Move "BOUNDARY" to tSearch.sName
33826>>>>>>>>>        Move (SearchArray(tSearch, aContentValues)) to iIndex
