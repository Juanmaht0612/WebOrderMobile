5057>>>>>        If (eButtonStyle=FORM_BUTTON_SPIN or eButtonStyle=FORM_BUTTON_SPIN_WRAP) Begin
5059>>>>>            Send OnInitSpin
5060>>>>>            Get Spin_Value to iCurrentValue
5061>>>>>            If bUp Begin
5063>>>>>                Increment iCurrentValue
5064>>>>>                If (iCurrentValue>Maximum_Position(Self)) Begin
5066>>>>>                    If (eButtonStyle=FORM_BUTTON_SPIN) ;                        Procedure_Return
5069>>>>>                    Get Minimum_Position to iCurrentValue
5070>>>>>                End
5070>>>>>>
5070>>>>>            End
5070>>>>>>
5070>>>>>            Else Begin
5071>>>>>                Decrement iCurrentValue
5072>>>>>                If (iCurrentValue<Minimum_Position(Self)) Begin
5074>>>>>                    If (eButtonStyle=FORM_BUTTON_SPIN) ;                        Procedure_Return
5077>>>>>                    Get Maximum_Position to iCurrentValue
5078>>>>>                End
5078>>>>>>
5078>>>>>            End
5078>>>>>>
5078>>>>>            Send Value_Spinned iCurrentValue
5079>>>>>        End
5079>>>>>>
5079>>>>>    End_Procedure
