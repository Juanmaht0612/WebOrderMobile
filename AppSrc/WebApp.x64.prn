1978>>>>>>>    
1978>>>>>>>    Procedure DoHtmlHelp
1980>>>>>>>        String  sContext
1980>>>>>>>        Integer eContextFound
1980>>>>>>>        
1980>>>>>>>        If (ghoHtmlHelp =0) Begin
1982>>>>>>>            Error DFERR_HELP_SYSTEM C_$ThereIsNoHelpSystem
1983>>>>>>>>
1983>>>>>>>        End
1983>>>>>>>>
1983>>>>>>>        Else Begin
1984>>>>>>>            Get HtmlHelpContext HELP_CONTEXT_ANY (&sContext) to eContextFound
1985>>>>>>>            Case Begin
1985>>>>>>>                Case (eContextFound=HELP_CONTEXT_HTMLPAGE)
1987>>>>>>>                    Send DoDisplayTopic of ghoHtmlHelp sContext
1988>>>>>>>                    Case Break
1989>>>>>>>                Case (eContextFound=HELP_CONTEXT_ID)
1992>>>>>>>                    Send DoShowMapId of ghoHtmlHelp (Integer(sContext)) // it's a map id system
1993>>>>>>>                    Case Break
1994>>>>>>>                Case (eContextFound=HELP_CONTEXT_KEYWORD)
1997>>>>>>>                    Send DoDisplayKeyword of ghoHtmlHelp sContext // If a non-numeric (string), goto keyword
1998>>>>>>>                    Case Break
1999>>>>>>>                Case Else
1999>>>>>>>                    Send DoDisplayTOC of ghoHtmlHelp   // if no context, go to TOC
2000>>>>>>>            Case End
2000>>>>>>>        End
2000>>>>>>>>
2000>>>>>>>    End_Procedure
