35253>>>>>>>    //
35253>>>>>>>    // Calculates when a set of web properties expires by looking at the piSessionTimeout property
35253>>>>>>>    // of the session manager. This is only stored for cleanup purposes.
35253>>>>>>>    //
35253>>>>>>>    Function CalculateExpires Returns DateTime
35255>>>>>>>        DateTime dtExpires
35255>>>>>>>        Integer iTimeout
35255>>>>>>>        
35255>>>>>>>        Get piSessionTimeout of (SessionManager(Self)) to iTimeout
35256>>>>>>>        Move (DateAddMinute(CurrentDateTime(), iTimeout)) to dtExpires
35257>>>>>>>        
35257>>>>>>>        
35257>>>>>>>        Function_Return dtExpires
