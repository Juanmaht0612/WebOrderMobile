18714>>>>>>>>>    // Registers the passed cWebControl in pChildWebControls array.
18714>>>>>>>>>    // (see also RegisterThisWebObject)
18714>>>>>>>>>    Procedure RegisterChildWebObject Handle hoChild
18716>>>>>>>>>        Handle[] aChildWebControls
18717>>>>>>>>>        Integer iSize
18717>>>>>>>>>        Boolean bChildExists
18717>>>>>>>>>        
18717>>>>>>>>>        Get ChildExists hoChild to bChildExists
18718>>>>>>>>>        
18718>>>>>>>>>        If (not(bChildExists)) Begin
18720>>>>>>>>>            Get paChildWebControls to aChildWebControls
18721>>>>>>>>>            Move (SizeOfArray(aChildWebControls)) to iSize
18722>>>>>>>>>            Move hoChild to aChildWebControls[iSize]
18723>>>>>>>>>            Set paChildWebControls to aChildWebControls
18724>>>>>>>>>        End
18724>>>>>>>>>>
18724>>>>>>>>>    End_Procedure
18725>>>>>>>>>    
18725>>>>>>>>>    
18725>>>>>>>>>    // Registers the passed method as a procedure or function that is permitted to be called from the client.
18725>>>>>>>>>    Procedure RegisterPublishedMethod Handle hMethod String sName Boolean bIsFunction
18727>>>>>>>>>        Integer iPos iSize
18727>>>>>>>>>        Handle[] aPubMethodHandles
18728>>>>>>>>>        String[] aPubMethodNames
18729>>>>>>>>>        Boolean[] aPubMethodIsFunction
18730>>>>>>>>>        
18730>>>>>>>>>        Get paPubMethodHandles to aPubMethodHandles
18731>>>>>>>>>        Get paPubMethodNames   to aPubMethodNames
18732>>>>>>>>>        Get paPubMethodIsFunction to aPubMethodIsFunction
18733>>>>>>>>>        Move (SearchArray(hMethod, aPubMethodHandles)) to iPos
18734>>>>>>>>>        
18734>>>>>>>>>        If (iPos = -1) Begin
18736>>>>>>>>>            Move (SizeOfArray(aPubMethodHandles)) to iSize
18737>>>>>>>>>            Move hMethod            to aPubMethodHandles[iSize]
18738>>>>>>>>>            Move (Uppercase(sName)) to aPubMethodNames[iSize]     // make the name search case insensitive
18739>>>>>>>>>            Move bIsFunction        to aPubMethodIsFunction[iSize]
18740>>>>>>>>>
18740>>>>>>>>>            Set paPubMethodHandles to aPubMethodHandles
18741>>>>>>>>>            Set paPubMethodNames   to aPubMethodNames
18742>>>>>>>>>            Set paPubMethodIsFunction to aPubMethodIsFunction
18743>>>>>>>>>        End
18743>>>>>>>>>>
18743>>>>>>>>>    End_Procedure
18744>>>>>>>>>
18744>>>>>>>>>
18744>>>>>>>>>    // Registers the passed property as a property to publish to the client object.
18744>>>>>>>>>    Procedure RegisterPublishedProperty Handle hmGetter Handle hmSetter String sName Integer iType Integer eMode Boolean bObject
18746>>>>>>>>>        Handle hoMeta
18746>>>>>>>>>        Variant vDefault
18746>>>>>>>>>        String sDefault
18746>>>>>>>>>        
18746>>>>>>>>>        If (bObject) Begin
18748>>>>>>>>>            Send RegisterWebProperty hmGetter hmSetter sName iType eMode
18749>>>>>>>>>        End
18749>>>>>>>>>>
18749>>>>>>>>>        Else Begin
18750>>>>>>>>>            Get phoClassPropMeta to hoMeta
18751>>>>>>>>>            
18751>>>>>>>>>            //  Only add to class if it is not already sealed
18751>>>>>>>>>            If (not(pbSealed(hoMeta))) Begin
18753>>>>>>>>>                If (iType <> cArgStruct and iType <> cArgArray) Begin
18755>>>>>>>>>                    Get hmGetter to vDefault
18756>>>>>>>>>                    Get ConvertToTransport hmGetter vDefault iType to sDefault
18757>>>>>>>>>                End
18757>>>>>>>>>>
18757>>>>>>>>>                    
18757>>>>>>>>>                Send RegisterWebProperty of hoMeta hmGetter hmSetter sName iType eMode sDefault
18758>>>>>>>>>            End
18758>>>>>>>>>>
18758>>>>>>>>>        End
18758>>>>>>>>>>
18758>>>>>>>>>    End_Procedure
18759>>>>>>>>>    
18759>>>>>>>>>    // Looks up the meta data for a web property based on its setter. Returns the meta data in a tWebPropMetaData struct.
18759>>>>>>>>>    Function FindWebPropertyMetaBySetter Handle hmSetter Returns tWebPropMetaData
18761>>>>>>>>>        tWebPropMetaData result
18761>>>>>>>>>        tWebPropMetaData result
18761>>>>>>>>>        
18761>>>>>>>>>        //  Look in object properties if we have them
18761>>>>>>>>>        Get FindWebPropertyBySetter hmSetter to result
18762>>>>>>>>>        
18762>>>>>>>>>        //  Look in class properties if we did not find it yet
18762>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyBySetter of (phoClassPropMeta(Self)) hmSetter to result
18765>>>>>>>>>            
18765>>>>>>>>>        Function_Return result
18766>>>>>>>>>    End_Function
18767>>>>>>>>>    
18767>>>>>>>>>    // Looks up the meta data for a web property based on its getter. Returns the meta data in a tWebPropMetaData struct.
