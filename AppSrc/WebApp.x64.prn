6722>>>>>>>    // Replace current mouse behavior with out own. This give us more control
6722>>>>>>>    // over the switching behavior.
6722>>>>>>>    //
6722>>>>>>>    Procedure Mouse_Down Integer iWindowNumber Integer iPosition
6724>>>>>>>        If (iWindowNumber > 0) ; // sometimes mouse down gets a 0 - should not happen            Send Request_Switch_to_Tab (iWindowNumber-1) 1 // 1=kbd
6727>>>>>>>    End_Procedure
