33690>>>>>>>>>// This class is capable of parsing multipart/form-data requests. These requests are used to post
33690>>>>>>>>>// binary data and usually files. The WAF file upload uses this class. Because it works in chunks
33690>>>>>>>>>// are used this class is capable of handling large files.
33690>>>>>>>>>
33690>>>>>>>>>// Data used while parsing the request. Passed arround by reference for performance reasons (properties would be copied in memory).
33690>>>>>>>>>Struct tMultipartParsingData
33690>>>>>>>>>    UChar[] ucBoundary      //  Multipart boundary string (received from the client)
33690>>>>>>>>>    UChar[] ucCurrentChunk  //  Current chunk being handled
33690>>>>>>>>>    UChar[] ucNextChunk     //  Next chunk (already loaded for peeking ahead)
33690>>>>>>>>>    Integer iChunkOffset    //  Offset in bytes of the current chunk from the beginning of the request
33690>>>>>>>>>    Integer iChunkRead      //  Parsing position within the current chunk
33690>>>>>>>>>    DWord iSize             //  Size of the full request known so far (only if bEndOfReq is true it is complete)
33690>>>>>>>>>    Integer iBoundPos       //  Position of the next boundary in the current chunk (if available)
33690>>>>>>>>>    Boolean bEndOfReq       //  End of request reached
33690>>>>>>>>>    Boolean bAbort          //  If true something is wrong and we should abot
33690>>>>>>>>>End_Struct
