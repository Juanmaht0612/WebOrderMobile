5862>>>>>    //
5862>>>>>    // Save any information you wish about this panel.
5862>>>>>    //
5862>>>>>    //  Rules for saving:
5862>>>>>    //  1. only save if SaveEnvironment=TRUE, ON or YES
5862>>>>>    //  2. Save current size and location to ApplicationSize, ApplicationLocation
5862>>>>>    //
5862>>>>>    Procedure Save_Environment
5864>>>>>        If (ghoApplication) ;            Send DoSaveEnvironment of ghoApplication Self (private_pbEnvironmentProgram(Self))
5867>>>>>    End_Procedure
5868>>>>>    
5868>>>>>    // 
5868>>>>>    // Load saved information about this panel.
5868>>>>>    //
5868>>>>>    Procedure Load_Environment
5870>>>>>        //  Only perform load once (Panel subclass calls this function from Page which performs resize before anything is painted but won't handle anchors on child objects well)
5870>>>>>        If (ghoApplication and not(private_pbEnvironmentLoaded(Self))) Begin
5872>>>>>            Send DoLoadEnvironment of ghoApplication Self (private_pbEnvironmentProgram(Self))
5873>>>>>            Set private_pbEnvironmentLoaded to True
5874>>>>>        End
5874>>>>>>
5874>>>>>    End_Procedure
5875>>>>>    
5875>>>>>    // For high level panel support save of environment
