34839>>>>>    // This function is called by the framework to read a session key. By default the session key 
34839>>>>>    // is read from the cookie. Overriding this procedure allows the developer to customize this 
34839>>>>>    // behavior.
34839>>>>>    //
34839>>>>>    // WARNING: Note that this method can also be called when the WebApp is out of sync (Web 
34839>>>>>    // Properties are not available at that point). This happens in case of a file download.
34839>>>>>    Function ReadSessionKey Returns String
34841>>>>>        String sSessionKey
34841>>>>>        
34841>>>>>        Get GetCookie (psSessionCookieName(SessionManager(Self))) to sSessionKey
34842>>>>>        
34842>>>>>        Function_Return sSessionKey
34843>>>>>    End_Function
34844>>>>>
34844>>>>>    // This procedure is called whenever a session key is stored by the framework. By default the 
34844>>>>>    // session key is stored in a cookie and the settings (cookie name,  timeout, path) are read 
34844>>>>>    // from the SessionManager. Overriding this procedure allows the developer to customize
34844>>>>>    // this behavior.
34844>>>>>    //
34844>>>>>    // Params:
34844>>>>>    //   sSessionKey   The new session key. "" if the session is cleared.
34844>>>>>    Procedure StoreSessionKey String sSessionKey
34846>>>>>        String sPath
34846>>>>>        Integer iPos
34846>>>>>        Handle hoSessionManager
34846>>>>>        
34846>>>>>        Get SessionManager to hoSessionManager
34847>>>>>        Get psSessionCookiePath of hoSessionManager to sPath
34848>>>>>        
34848>>>>>        //  If the path is empty we determine the current path where the cookie should be set, we can't leave it blank as the client interprets /CallAction/JSON in the URL as part of the path
34848>>>>>        If (Trim(sPath) = "") Begin
34850>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "SCRIPT_NAME" to sPath
34851>>>>>            
34851>>>>>            Move (Pos("WebServiceDispatcher.wso", sPath)) to iPos
34852>>>>>            If (iPos > 0) Begin
34854>>>>>                Move (Left(sPath, iPos - 1)) to sPath
34855>>>>>            End
34855>>>>>>
34855>>>>>            
34855>>>>>            Move (RightPos("/", sPath)) to iPos    
34856>>>>>            If (iPos > 0) Begin
34858>>>>>                Move (Left(sPath, iPos)) to sPath
34859>>>>>            End
34859>>>>>>
34859>>>>>        End
34859>>>>>>
34859>>>>>        
34859>>>>>        Send SetCookie (psSessionCookieName(hoSessionManager)) sSessionKey (piSessionCookieTimeout(hoSessionManager)) sPath (psSessionCookieDomain(hoSessionManager)) (pbSessionCookieSecure(hoSessionManager)) (pbSessionCookieHttpOnly(hoSessionManager)) (psSessionCookieSameSite(hoSessionManager))
34860>>>>>    End_Procedure    
34861>>>>>
34861>>>>>    // Determines if a login is required to access this web application. If so it will determine if
34861>>>>>    // the current session is logged in by asking the session manager. This function is called by 
34861>>>>>    // views as a first level security test.
34861>>>>>    //
34861>>>>>    // Returns: 
34861>>>>>    //      True if a login is not required or if login is required and the session is logged in.
34861>>>>>    //      False if the login is required and the session is nog logged in.
34861>>>>>    Function ValidLogin Returns Boolean
34863>>>>>        Boolean bIsLoggedIn 
34863>>>>>        Integer eLoginMode
34863>>>>>        Get peLoginMode to eLoginMode
34864>>>>>        If (eLoginMode=lmLoginRequired) Begin
34866>>>>>            Get IsLoggedIn of (SessionManager(Self)) to bIsLoggedIn
34867>>>>>            Function_Return (bIsLoggedIn)
34868>>>>>        End
34868>>>>>>
34868>>>>>        Function_Return True
34869>>>>>    End_Function
