3925>>>>>    Procedure Page_Object Integer iState
3927>>>>>        Integer obj
3927>>>>>        Get Label_object to obj
3928>>>>>        Forward Send Page_Object iState
3930>>>>>        
3930>>>>>        // Handle tooltip support....
3930>>>>>        If (iState = 0) Begin
3932>>>>>            Send RequestDeleteToolTip
3933>>>>>        End
3933>>>>>>
3933>>>>>        Else Begin
3934>>>>>            Send RequestAddToolTip
3935>>>>>        End
3935>>>>>>
3935>>>>>        
3935>>>>>        If (Obj and iState) Begin
3937>>>>>            // this forces an AutoSize of the label. This handles any changes in font, fontweight, etc. that might have occurred
3937>>>>>            // after the value was set.
3937>>>>>            Set Label of Obj to (Label(obj))
