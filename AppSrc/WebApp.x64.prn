20905>>>>>>>>>>>>>>>        Forward Send Construct_Object
20907>>>>>>>>>>>>>>>        
20907>>>>>>>>>>>>>>>        // Published Properties
20907>>>>>>>>>>>>>>>        Property Boolean pbFillHeight False            // If True, then the control is vertically stretched to fill all available space. In GridLayout, this will cause it to fill the rows this control is occupying (by default, controls have their natural height through CSS styling)
20910>>>>>>>>>>>>>>>        Property Integer piHeight 0                 // Is the explicit fixed height of the control (for most controls you leave this set to 0 so the control's style settings determine the height). Ignored when pbFillHeight is True.
20913>>>>>>>>>>>>>>>        Property Integer piMinHeight 0              // Minimum control height (ignored unless pbFillHeight is True)ent)
20916>>>>>>>>>>>>>>>        
20916>>>>>>>>>>>>>>>        Property Boolean pbShowLabel True              // If False, then no space is assigned for the label in the column layout (see psLabel)
20919>>>>>>>>>>>>>>>        Property Integer peLabelAlign C_WebDefault     // Label alignment (alLeft, alCenter, alRight aligned)
20922>>>>>>>>>>>>>>>        Property Integer peLabelPosition lpLeft         // Label position relative to the control (lpLeft, lpRight, lpTop, lpFloat)
20925>>>>>>>>>>>>>>>        Property Integer piColumnIndex C_WebDefault     // Determines the horizontal column position in the parent panel object
20928>>>>>>>>>>>>>>>        Property Integer piColumnSpan 1                // Determines how many columns the width of the control will span (i.e. determines the width of the control, 0 will spann the full available space)
20931>>>>>>>>>>>>>>>        Property Integer piRowIndex C_WebDefault        // For LayoutType Grid. -1 = auto
20934>>>>>>>>>>>>>>>        Property Integer piRowSpan 1                    // For LayoutType Grid. Amount of rows this control will occupy.
20937>>>>>>>>>>>>>>>        Property Integer piLabelOffset C_WebDefault    // Label position (in pixels) relative to the control
20940>>>>>>>>>>>>>>>        Property String psLabel ""                     // Is the control's label (see pbShowLabel)
20943>>>>>>>>>>>>>>>        Property String psLabelColor ""                // CSS Inline Style - Color of label's text      
20946>>>>>>>>>>>>>>>        
20946>>>>>>>>>>>>>>>        Property String psToolTip ""                 // Tooltip that is displayed when the mouse is hovered over the control. Set by data binding from Status_Help.
20949>>>>>>>>>>>>>>>        
20949>>>>>>>>>>>>>>>        Property Boolean pbServerOnBlur False
20952>>>>>>>>>>>>>>>        Property String psClientOnBlur ""
20955>>>>>>>>>>>>>>>        
20955>>>>>>>>>>>>>>>        Property Boolean pbServerOnFocus False
