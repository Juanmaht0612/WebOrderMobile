24350>>>>>>>>>>>    End_Procedure
24351>>>>>>>>>>>    
24351>>>>>>>>>>>    
24351>>>>>>>>>>>    //
24351>>>>>>>>>>>    // Called by the cWebApp class when the processing of a request is finished. All handlers are
24351>>>>>>>>>>>    // triggered to store their properties and the client ahndler puts the in the passed arrays so 
24351>>>>>>>>>>>    // they are sent back to the client.
24351>>>>>>>>>>>    //
24351>>>>>>>>>>>    Procedure Call_PostWebProps tWebCallContext ByRef cctx
24353>>>>>>>>>>>        Handle hoHandler
24353>>>>>>>>>>>
24353>>>>>>>>>>>        //  Handle server properties (note that this might change client properties like psSPKey of ghoWebApp
24353>>>>>>>>>>>        Get phoServerHandler to hoHandler
24354>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
24355>>>>>>>>>>>        
24355>>>>>>>>>>>        Get phoSessionHandler to hoHandler
24356>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
24357>>>>>>>>>>>        
24357>>>>>>>>>>>        //  Load client web properties
24357>>>>>>>>>>>        Get phoClientHandler to hoHandler
24358>>>>>>>>>>>        Send FinishedCall of hoHandler (&cctx.response.Header.aSyncProps) (&cctx.response.Header.aAdvSyncP)
24359>>>>>>>>>>>    End_Procedure
24360>>>>>>>>>>>End_Class
24361>>>>>>>>>>>
24361>>>>>>>>>>>// Returns the value of the named Web Property belonging to the named object.
24361>>>>>>>>>>>// Displays an appropriate message if the property cannot be reached.
24361>>>>>>>>>>>//
24361>>>>>>>>>>>// Only use this function in the Debugger Watches window to watch Web 
24361>>>>>>>>>>>// Property values. Should never be used to get a Web Property value in 
24361>>>>>>>>>>>// your application. Use WebGet instead.
24361>>>>>>>>>>>
24361>>>>>>>>>>>Function _wp Global Handle hoObject String sPropName Returns Variant
24363>>>>>>>>>>>    Boolean bIsAjaxWebObject bInScope
24363>>>>>>>>>>>    String sObject
24363>>>>>>>>>>>    Handle hoHandler hoOwner
24363>>>>>>>>>>>    Variant vReturn
24363>>>>>>>>>>>    tWebPropMetaData pubProp
24363>>>>>>>>>>>    tWebPropMetaData pubProp
24363>>>>>>>>>>>    
24363>>>>>>>>>>>    //  Test ig target object is WO
24363>>>>>>>>>>>    Get IsAjaxWebObject of hoObject to bIsAjaxWebObject
24364>>>>>>>>>>>    Get Object_Label of hoObject to sObject
24365>>>>>>>>>>>    
24365>>>>>>>>>>>    If (not(bIsAjaxWebObject)) Begin
24367>>>>>>>>>>>        Function_Return ("Object " + sObject + " does not support web properties")
24368>>>>>>>>>>>    End
24368>>>>>>>>>>>>
24368>>>>>>>>>>>    
24368>>>>>>>>>>>    //  Find property index
24368>>>>>>>>>>>    Get FindWebPropertyMetaByName of hoObject sPropName to pubProp
24369>>>>>>>>>>>    If (pubProp.hmGetter = 0) Begin
24371>>>>>>>>>>>        Function_Return (sPropName + " is not a web property of " + sObject) 
24372>>>>>>>>>>>    End
24372>>>>>>>>>>>>
24372>>>>>>>>>>>    
24372>>>>>>>>>>>    //  Get handler
24372>>>>>>>>>>>    Get Owner of hoObject to hoOwner
24373>>>>>>>>>>>    If (hoOwner = -1) Begin
24375>>>>>>>>>>>        Function_Return (SFormat("Object '%1' is not a valid web web object for %2.", sObject, "WebGet"))        
24376>>>>>>>>>>>    End
24376>>>>>>>>>>>>
24376>>>>>>>>>>>    
24376>>>>>>>>>>>    Get PropertyHandler of hoOwner hoObject pubProp.eMode to hoHandler
24377>>>>>>>>>>>    If (hoHandler = -1) Begin
24379>>>>>>>>>>>        Function_Return (SFormat("Property '%2' of object '%1' is not a valid web property for %3, check the web property meta value.", sPropName, sObject, "WebGet"))        
24380>>>>>>>>>>>    End
24380>>>>>>>>>>>>
24380>>>>>>>>>>>    
24380>>>>>>>>>>>    // Test if handler is active....
24380>>>>>>>>>>>    If (not(pbActive(hoHandler))) Begin
24382>>>>>>>>>>>        Function_Return "Web property handler is inactive"
24383>>>>>>>>>>>    End
24383>>>>>>>>>>>>
24383>>>>>>>>>>>    
24383>>>>>>>>>>>    // Test if in scope
24383>>>>>>>>>>>    Get IsObjectInCallActionScope of hoHandler hoObject to bInScope
24384>>>>>>>>>>>    If (not(bInScope)) Begin
24386>>>>>>>>>>>        Function_Return ("Object " + sObject + " is out of scope. Web property " + sPropName + " not available")
24387>>>>>>>>>>>    End
24387>>>>>>>>>>>>
24387>>>>>>>>>>>    
24387>>>>>>>>>>>    // Now call the actual handler (now if something goes wrong it is a proper error)
24387>>>>>>>>>>>    Get GetScalarSyncProp of hoHandler hoObject (&pubProp) to vReturn
24388>>>>>>>>>>>    
24388>>>>>>>>>>>    Function_Return vReturn
24389>>>>>>>>>>>End_Function
24390>>>>>>>>>Use tWebControlMapItem.pkg
24390>>>>>>>>>
24390>>>>>>>>>Register_Function IsDialog Returns Boolean
24390>>>>>>>>>
24390>>>>>>>>>Class cWebViewHost_mixin is a Mixin
24391>>>>>>>>>    Procedure Define_cWebViewHost_mixin
24393>>>>>>>>>        
24393>>>>>>>>>        Property tWebControlMapItem[] paViews          // Collection of all views available within this host
24394>>>>>>>>>        
24394>>>>>>>>>        Property Handle[] paDDOViews                   // Collection of view object handles referenced in each member of the RequestHeader.aDDOs
24395>>>>>>>>>        
24395>>>>>>>>>        
24395>>>>>>>>>        
24395>>>>>>>>>        Property Handle phoLoadView C_WebUnresolvedObject       // handle to view to load during a CallAction to LoadView
24396>>>>>>>>>        
24396>>>>>>>>>        Property Handle phoLoginView C_WebUnresolvedObject      // handle of login view to load when application is loaded.
24397>>>>>>>>>        Property Handle phoDefaultView C_WebUnresolvedObject    // handle of the default view to load when web application is loaded (unless there is a login screen to be shown - see phoLoginView)
24398>>>>>>>>>        
24398>>>>>>>>>        Property Handle phoCommandBar C_WebUnresolvedObject     // handle to child cWebCommandbar object
24399>>>>>>>>>        
24399>>>>>>>>>        
24399>>>>>>>>>        Property Integer peApplicationStyle wvsDesktop 
24400>>>>>>>>>        
24400>>>>>>>>>        Property Boolean pbTestSyncDDO False // for testing only (s/b False on release)
24401>>>>>>>>>        
24401>>>>>>>>>        Property String[] paLoadedViews     // List of all views loaded to the client (used by ShowView to determine if it should go back to the client)
24404>>>>>>>>>        
24404>>>>>>>>>        Property String psCurrentView ""    // Name of the currently active view
24407>>>>>>>>>        Property Handle phoCurrentShowView  C_WebUnresolvedObject // Handle to the view currently being shown (used to check if OnNavigateForward calls another view during show
24408>>>>>>>>>        
24408>>>>>>>>>        
24408>>>>>>>>>        Property String psApplicationTitle "DataFlex WebApp"        // The title shown in the browser title bar
24411>>>>>>>>>        Property Boolean pbUpdateApplicationTitle True              // If true the title in the title bar is automatically updated
24414>>>>>>>>>        
24414>>>>>>>>>        // When set to True all views will show an unhandled error when a refind record
24414>>>>>>>>>        // fails (usually some kind of FindByRowIdEx call). Normally this is False because
24414>>>>>>>>>        // refinds can fail in a multi-user environment and the framework will handle this
24414>>>>>>>>>        // as best it can. However, refind errors can also be caused by a programming error.
24414>>>>>>>>>        // If you set this true during debugging you will be notified of refind errors that
24414>>>>>>>>>        // may be a programming bug. This can work well because the multi-user can't refind
24414>>>>>>>>>        // error usually does not occur while debugging. If you set this True while testing,
24414>>>>>>>>>        // remember to set it back to False when deploying.  
24414>>>>>>>>>        Property Boolean pbShowAllRefindErrors False
24415>>>>>>>>>    End_Procedure
24416>>>>>>>>>    
24416>>>>>>>>>    // An object is only in-scope during a WebApp CallAction in the following cases:
24416>>>>>>>>>    // - It is a Global Object: cWebApp or its child objects (but not a cWebWindow child).
24416>>>>>>>>>    // - It is part of the stack of views\dialog in the cWebApp's paDDOViews property.
24416>>>>>>>>>    // - During a call to LoadView, it is part of the view being loaded.
24416>>>>>>>>>    Function OwnerIsInCallActionScope Handle hoWO Returns Boolean
24418>>>>>>>>>        Integer iViewIndex
24418>>>>>>>>>        Handle hoWebNeighborhood hoLoadView
24418>>>>>>>>>        Handle[] aDDOViews
24419>>>>>>>>>        
24419>>>>>>>>>        Get phoWebNeighborhood of hoWO to hoWebNeighborhood    // This property is set during object creation
24420>>>>>>>>>        
24420>>>>>>>>>        // Test if the neighborhood property is actually correctly set.
24420>>>>>>>>>        If (hoWebNeighborhood = C_WebUnresolvedObject) Begin
24422>>>>>>>>>            Function_Return False
24423>>>>>>>>>        End
24423>>>>>>>>>>
24423>>>>>>>>>        
24423>>>>>>>>>        // is this in the cWebApp Neighborhood?
24423>>>>>>>>>        If (hoWebNeighborhood = Self) Begin
24425>>>>>>>>>            Function_Return True
24426>>>>>>>>>        End
24426>>>>>>>>>>
24426>>>>>>>>>        
24426>>>>>>>>>        // is this a View that is being loaded?
24426>>>>>>>>>        Get phoLoadView to hoLoadView
24427>>>>>>>>>        If (hoWebNeighborhood = hoLoadView) Begin
24429>>>>>>>>>            Function_Return True
24430>>>>>>>>>        End
24430>>>>>>>>>>
24430>>>>>>>>>        
24430>>>>>>>>>        // is this in the neighborhood of one of the focus windows?
24430>>>>>>>>>        Get paDDOViews to aDDOViews     // This property is set during CallAction
24431>>>>>>>>>        Move (SearchArray(hoWebNeighborhood, aDDOViews)) to iViewIndex
24432>>>>>>>>>        Function_Return (iViewIndex <> -1)
24433>>>>>>>>>    End_Function
24434>>>>>>>>>    
24434>>>>>>>>>    Procedure OwnerRegisterView Handle hoView
24436>>>>>>>>>        tWebControlMapItem new
24436>>>>>>>>>        tWebControlMapItem new
24436>>>>>>>>>        tWebControlMapItem[] aViews
24436>>>>>>>>>        tWebControlMapItem[] aViews
24437>>>>>>>>>        
24437>>>>>>>>>        Get paViews to aViews
24438>>>>>>>>>        
24438>>>>>>>>>        Move hoView to new.hoObj
24439>>>>>>>>>        Move (Uppercase(Name(hoView))) to new.sName
24440>>>>>>>>>        
24440>>>>>>>>>        If (BinarySearchArray(new, aViews, False) = -1) Begin
24442>>>>>>>>>            Move (InsertInArray(aViews, BinarySearchInsertPos(), new)) to aViews
24443>>>>>>>>>            Set paViews to aViews
24444>>>>>>>>>        End
24444>>>>>>>>>>
24444>>>>>>>>>        Else Begin
24445>>>>>>>>>            Error DFERR_PROGRAM (SFormat("View with name '%1' already registered.", new.sName))
24446>>>>>>>>>>
24446>>>>>>>>>        End
24446>>>>>>>>>>
24446>>>>>>>>>    End_Function
24447>>>>>>>>>    
24447>>>>>>>>>    Function FindView String sViewName Boolean bSilent Returns Handle
24449>>>>>>>>>        tWebControlMapItem[] aViews
24449>>>>>>>>>        tWebControlMapItem[] aViews
24450>>>>>>>>>        tWebControlMapItem search
24450>>>>>>>>>        tWebControlMapItem search
24450>>>>>>>>>        Integer iPos
24450>>>>>>>>>        
24450>>>>>>>>>        Get paViews to aViews
24451>>>>>>>>>        Move (Uppercase(Trim(sViewName))) to search.sName
24452>>>>>>>>>        Move (BinarySearchArray(search, aViews, False)) to iPos
24453>>>>>>>>>        
24453>>>>>>>>>        If (iPos <> -1) Begin
24455>>>>>>>>>            Function_Return aViews[iPos].hoObj
24456>>>>>>>>>        End
24456>>>>>>>>>>
24456>>>>>>>>>        
24456>>>>>>>>>        If (not(bSilent)) Begin
24458>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sViewName))
24459>>>>>>>>>>
24459>>>>>>>>>        End
24459>>>>>>>>>>
24459>>>>>>>>>        
24459>>>>>>>>>        Function_Return C_WebUnresolvedObject
24460>>>>>>>>>    End_Function
24461>>>>>>>>>    
24461>>>>>>>>>    Function OwnerActionState Handle hoWO Returns Integer
24463>>>>>>>>>        Handle hoLoadView hoNeigborhood
24463>>>>>>>>>        
24463>>>>>>>>>        Get phoLoadView to hoLoadView
24464>>>>>>>>>        Get phoWebNeighborhood to hoNeigborhood
24465>>>>>>>>>        
24465>>>>>>>>>        If (hoLoadView <> C_WebUnresolvedObject and hoLoadView = hoNeigborhood) Begin
24467>>>>>>>>>            Function_Return ctExecViewLoad
24468>>>>>>>>>        End
24468>>>>>>>>>>
24468>>>>>>>>>        
24468>>>>>>>>>        Function_Return ctExecDefault    //  Execute as a default client action (after synchronization of web properties)
24469>>>>>>>>>    End_Function
24470>>>>>>>>>    
24470>>>>>>>>>    // Called by LoadWebApp to load the initial view
24470>>>>>>>>>    Procedure Load_InitialView
24472>>>>>>>>>        Handle hoView
24472>>>>>>>>>        String sStateHash
24472>>>>>>>>>        Integer eAppStyle
24472>>>>>>>>>        String[] aLoadedViews
24473>>>>>>>>>        
24473>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
24474>>>>>>>>>        If (SizeOfArray(aLoadedViews) > 0) ;            Procedure_Return
24477>>>>>>>>>        
24477>>>>>>>>>        //  Get forced initial view (login dialog or so)
24477>>>>>>>>>        Get ForcedInitialView to hoView
24478>>>>>>>>>        
24478>>>>>>>>>        //  Set initial page title (a login dialog might not set one)
24478>>>>>>>>>        Send UpdatePageTitle C_WebUnresolvedObject ""
24479>>>>>>>>>        
24479>>>>>>>>>        //  Send back default view unless a login dialog needs to be sent
24479>>>>>>>>>        If (hoView = C_WebUnresolvedObject) Begin
24481>>>>>>>>>            //  Restore application state
24481>>>>>>>>>            If (peApplicationStateMode(Self) <> asmOff) Begin
24483>>>>>>>>>                Get StateHash to sStateHash 
24484>>>>>>>>>                Send RestoreState sStateHash True
24485>>>>>>>>>            End
24485>>>>>>>>>>
24485>>>>>>>>>            Else Begin //  Or return default view
24486>>>>>>>>>                Get GetDefaultView to hoView
24487>>>>>>>>>                If (hoView > 0) Begin
24489>>>>>>>>>                    Send Show of hoView
24490>>>>>>>>>                End
24490>>>>>>>>>>
24490>>>>>>>>>            End
24490>>>>>>>>>>
24490>>>>>>>>>        End
24490>>>>>>>>>>
24490>>>>>>>>>        Else Begin
24491>>>>>>>>>            Get peApplicationStyle to eAppStyle
24492>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
24494>>>>>>>>>               Send NavigateBegin of hoView Self True 
24495>>>>>>>>>            End
24495>>>>>>>>>>
24495>>>>>>>>>            Else Begin
24496>>>>>>>>>                Send Show of hoView    
24497>>>>>>>>>            End
24497>>>>>>>>>>
24497>>>>>>>>>        End
24497>>>>>>>>>>
24497>>>>>>>>>    End_Procedure
24498>>>>>>>>>    
24498>>>>>>>>>    Function ViewAccessDenied Handle hoView Boolean bRestoreState Returns Boolean
24500>>>>>>>>>        tOnViewAccessDenied deniedDetails
24500>>>>>>>>>        tOnViewAccessDenied deniedDetails
24500>>>>>>>>>        Integer eAppStyle
24500>>>>>>>>>        
24500>>>>>>>>>        Move hoView to deniedDetails.hoView
24501>>>>>>>>>        Move bRestoreState to deniedDetails.bRestoreState
24502>>>>>>>>>        Move False to deniedDetails.bHandled
24503>>>>>>>>>        Move C_WebUnresolvedObject to deniedDetails.hoNavigateToView
24504>>>>>>>>>        
24504>>>>>>>>>        Send OnViewAccessDenied (&deniedDetails)
24505>>>>>>>>>        If (deniedDetails.bHandled) ;            Function_Return True
24508>>>>>>>>>        
24508>>>>>>>>>        If (deniedDetails.hoNavigateToView <> C_WebUnresolvedObject) Begin
24510>>>>>>>>>            Get peApplicationStyle to eAppStyle
24511>>>>>>>>>            If (eAppStyle = wvsDrillDown) Begin
24513>>>>>>>>>                Send NavigatePathBegin deniedDetails.hoNavigateToView True
24514>>>>>>>>>            End
24514>>>>>>>>>>
24514>>>>>>>>>            Else Begin
24515>>>>>>>>>                Send Show of deniedDetails.hoNavigateToView    
24516>>>>>>>>>            End 
24516>>>>>>>>>>
24516>>>>>>>>>            Function_Return True
24517>>>>>>>>>        End
24517>>>>>>>>>>
24517>>>>>>>>>        
24517>>>>>>>>>        Function_Return False
24518>>>>>>>>>    End_Function
24519>>>>>>>>>    
24519>>>>>>>>>    // Event that is fired when the user tries to navigate into a view or dialog and access is denied. Implement this 
24519>>>>>>>>>    // procedure to customize behavior (for example show a login view). By default triggers the Access Denied error.
24519>>>>>>>>>    Procedure OnViewAccessDenied tOnViewAccessDenied ByRef details
24521>>>>>>>>>        Error DFERR_WEBAPP_ACCESS_DENIED
24522>>>>>>>>>>
24522>>>>>>>>>    End_Procedure
24523>>>>>>>>>
24523>>>>>>>>>
24523>>>>>>>>>    // Client Action: Sends hideView to the client to hide the passed view. A hidden view can be re-shown without making
24523>>>>>>>>>    // a server call (see ShowView). Note, a hidden view and it's data is still present on the client. 
24523>>>>>>>>>    // If access to a view is to be securely restricted Use CloseView instead.
24523>>>>>>>>>    // See also "Hide" method of cWebView.
24523>>>>>>>>>    // See also "ShowView" 
24523>>>>>>>>>    Procedure HideView Handle hoView
24525>>>>>>>>>        String sView sCurrent sInvoking
24525>>>>>>>>>        String[] aParams
24526>>>>>>>>>
24526>>>>>>>>>        Get Object_Label of hoView to sView
24527>>>>>>>>>        
24527>>>>>>>>>        WebGet psCurrentView to sCurrent
24528>>>>>>>>>        If (sView = sCurrent) Begin
24530>>>>>>>>>            WebGet psInvokingView of hoView to sInvoking
24531>>>>>>>>>            WebSet psCurrentView to sInvoking
24532>>>>>>>>>        End
24532>>>>>>>>>>
24532>>>>>>>>>        
24532>>>>>>>>>        Move sView to aParams[0]       // Pass the view name as the 1st parameter.
24533>>>>>>>>>        Move False to aParams[1]       // We do want to send OnHide if needed
24534>>>>>>>>>        Send ClientAction "hideView" aParams 
24535>>>>>>>>>    End_Procedure
24536>>>>>>>>>    
24536>>>>>>>>>    
24536>>>>>>>>>    //  Determines if a view loaded on the client by looking at paLoadedViews.
24536>>>>>>>>>    //
24536>>>>>>>>>    //  hoView      - Handle to the view object.
24536>>>>>>>>>    //  Returns true if the view is available on the client.
24536>>>>>>>>>    Function IsViewLoaded Handle hoView Returns Boolean
24538>>>>>>>>>        String [] aLoadedViews
24539>>>>>>>>>        String sView
24539>>>>>>>>>        
24539>>>>>>>>>        Get WebObjectName of hoView to sView
24540>>>>>>>>>        WebGet paLoadedViews to aLoadedViews
24541>>>>>>>>>        
24541>>>>>>>>>        Function_Return (SearchArray(UpperCase(sView), aLoadedViews) >= 0)
24542>>>>>>>>>    End_Function
24543>>>>>>>>>    
24543>>>>>>>>>    
24543>>>>>>>>>    //  Determines if a view is in sync using IsInCallActionScope.
24543>>>>>>>>>    //
24543>>>>>>>>>    //  hoView      - Handle to the view object.
24543>>>>>>>>>    //  Returns true if the view is currently in sync.
24543>>>>>>>>>    Function IsViewInSync Handle hoView Returns Boolean
24545>>>>>>>>>        Boolean bResult
24545>>>>>>>>>        
24545>>>>>>>>>        Get IsInCallActionScope of hoView to bResult
24546>>>>>>>>>        
24546>>>>>>>>>        Function_Return bResult
24547>>>>>>>>>    End_Function
24548>>>>>>>>>    
24548>>>>>>>>>    //  Determines the currently shown view.
24548>>>>>>>>>    //
24548>>>>>>>>>    //  Returns a handle to the currently shown view.
24548>>>>>>>>>    Function CurrentView Returns Handle
24550>>>>>>>>>        String sView
24550>>>>>>>>>        Handle hoView
24550>>>>>>>>>        
24550>>>>>>>>>        Move C_WebUnresolvedObject to hoView
24551>>>>>>>>>        
24551>>>>>>>>>        WebGet psCurrentView to sView
24552>>>>>>>>>        If (sView <> "") Begin
24554>>>>>>>>>            Get WebObjectByName sView to hoView
24555>>>>>>>>>        End
24555>>>>>>>>>>
24555>>>>>>>>>        
24555>>>>>>>>>        Function_Return hoView
24556>>>>>>>>>    End_Function
24557>>>>>>>>>    
24557>>>>>>>>>    // Server-Action
24557>>>>>>>>>    //
24557>>>>>>>>>    // Part of the CallAction interface. Used to return a view's object definition to the client.
24557>>>>>>>>>    // Returns a structure of objects and properties for nested DDO and cWebObjects
24557>>>>>>>>>    // These are returned to the client as serialized JSON.
24557>>>>>>>>>    // sViewName     - Is the name of the view to be loaded
24557>>>>>>>>>    // sInvokingView - Is the name of the view that triggered the LoadView call. This is mostly used
24557>>>>>>>>>    //                 in the cWebDialog class when activating a modal dialog.
24557>>>>>>>>>    Function LoadView String sViewName String sInvokingView Returns Boolean
24559>>>>>>>>>        Handle hoView
24559>>>>>>>>>        Handle[] aDDOViews
24560>>>>>>>>>        String[] aLoadedViews asParams
24562>>>>>>>>>        Boolean bAllowAccess bLoaded bHandled
24562>>>>>>>>>        Handle hjObjectDef
24562>>>>>>>>>        tWebDDODef DDODef
24562>>>>>>>>>        tWebDDODef DDODef
24562>>>>>>>>>        String sPreLoad
24562>>>>>>>>>
24562>>>>>>>>>        // Get a handle to the view we are loading....
24562>>>>>>>>>        Get GetAjaxWebAppView of (phoWebControlLocator(Self)) sViewName to hoView
24563>>>>>>>>>        
24563>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
24565>>>>>>>>>            
24565>>>>>>>>>            // Set up the web properties system to allow WebGet to access this view....
24565>>>>>>>>>            Set phoLoadView to hoView
24566>>>>>>>>>            Send ProcessLoadViewClientSyncProps hoView
24567>>>>>>>>>            
24567>>>>>>>>>            // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
24567>>>>>>>>>            // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
24567>>>>>>>>>            // test AllowViewAccess of the view that is processing the call (this might be different).
24567>>>>>>>>>            Get AllowViewAccess hoView to bAllowAccess
24568>>>>>>>>>    
24568>>>>>>>>>            If (bAllowAccess) Begin
24570>>>>>>>>>                // Add to the list of views to synchronize back to the client....
24570>>>>>>>>>                Get paDDOViews to aDDOViews
24571>>>>>>>>>                If (SearchArray(hoView, aDDOViews) < 0) Begin
24573>>>>>>>>>                    Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
24574>>>>>>>>>                End
24574>>>>>>>>>>
24574>>>>>>>>>                Set paDDOViews to aDDOViews
24575>>>>>>>>>
24575>>>>>>>>>                //  Perform initialization (clear, set constraints)
24575>>>>>>>>>                Send InitForShow of hoView                    
24576>>>>>>>>>                
24576>>>>>>>>>                // we want view sync before OnLoad
24576>>>>>>>>>                Send NotifySyncWebApp of hoView
24577>>>>>>>>>                    
24577>>>>>>>>>                // Serialize the view to JSON....
24577>>>>>>>>>                Get SerializeObject of hoView to hjObjectDef
24578>>>>>>>>>                Send ClientActionEarly "createView" asParams hjObjectDef    
24579>>>>>>>>>                Send Destroy of hjObjectDef           
24580>>>>>>>>>
24580>>>>>>>>>                // Set the psInvokingView web property. We need this to be set already during LoadView
24580>>>>>>>>>                // if we are loading a Modal Dialog...
24580>>>>>>>>>                //WebSet psInvokingView of hoView to sInvokingView
24580>>>>>>>>>                Send InitInvokingView to hoView sInvokingView
24581>>>>>>>>>                
24581>>>>>>>>>                Set phoLoadView to C_WebUnresolvedObject
24582>>>>>>>>>                
24582>>>>>>>>>                //  Mark view as loaded
24582>>>>>>>>>                WebGet paLoadedViews to aLoadedViews
24583>>>>>>>>>                If (SearchArray(Uppercase(sViewName), aLoadedViews) = -1) Begin
24585>>>>>>>>>                    Move (Uppercase(sViewName)) to aLoadedViews[SizeOfArray(aLoadedViews)]
24586>>>>>>>>>                    WebSet paLoadedViews to aLoadedViews
24587>>>>>>>>>                End            
24587>>>>>>>>>>
24587>>>>>>>>>                
24587>>>>>>>>>                Function_Return True
24588>>>>>>>>>            End
24588>>>>>>>>>>
24588>>>>>>>>>            Else Begin
24589>>>>>>>>>                Get ViewAccessDenied hoView False to bHandled
24590>>>>>>>>>            End
24590>>>>>>>>>>
24590>>>>>>>>>        End
24590>>>>>>>>>>
24590>>>>>>>>>        
24590>>>>>>>>>        Function_Return False
24591>>>>>>>>>    End_Function
24592>>>>>>>>>    
24592>>>>>>>>>    //  Loads and initializes a view asynchronously (the loading is done via a separate round-trip).
24592>>>>>>>>>    //  This is used for performance reasons when restoring the application state from a URL path.
24592>>>>>>>>>    //
24592>>>>>>>>>    //  Note: Should only be used when the view is not loaded to the client!!
24592>>>>>>>>>    //  
24592>>>>>>>>>    //  - hoView        Handle to the view.
24592>>>>>>>>>    Procedure DelayLoadview Handle hoView
24594>>>>>>>>>        String[] aParams
24595>>>>>>>>>        Handle[] aDDOViews
24596>>>>>>>>>        
24596>>>>>>>>>        // Add to the list of views to synchronize back to the client....
24596>>>>>>>>>        Get paDDOViews to aDDOViews
24597>>>>>>>>>        If (SearchArray(hoView, aDDOViews) < 0) Begin
24599>>>>>>>>>            Move hoView to aDDOViews[SizeOfArray(aDDOViews)]
24600>>>>>>>>>        End
24600>>>>>>>>>>
24600>>>>>>>>>        Set paDDOViews to aDDOViews
24601>>>>>>>>>
24601>>>>>>>>>        //  Add load view client action
24601>>>>>>>>>        Get WebObjectName of hoView to aParams[0]
24602>>>>>>>>>        Move 1 to aParams[1]
24603>>>>>>>>>        Send ClientAction "loadView" aParams
24604>>>>>>>>>        
24604>>>>>>>>>        //  Initialize view
24604>>>>>>>>>        Send InitForShow of hoView
24605>>>>>>>>>        WebSet pbPreLoaded of hoView to True
24607>>>>>>>>>
24607>>>>>>>>>        //  We want view sync before OnLoad
24607>>>>>>>>>        Send NotifySyncWebApp of hoView
24608>>>>>>>>>        
24608>>>>>>>>>
24608>>>>>>>>>    End_Procedure
24609>>>>>>>>>      
24609>>>>>>>>>    
24609>>>>>>>>>    //  Shows a view and loads it (if nessecary). If a view is loaded and synchronized it will be 
24609>>>>>>>>>    //  shown directly (when returned to the client) and processing can continue. If a view is 
24609>>>>>>>>>    //  loaded to the client but not synchronized it depends on pbOverrideStateOnShow what happens.
24609>>>>>>>>>    //  If pbOverrideStateOnShow is false it will go back to the client before it continues and this 
24609>>>>>>>>>    //  makes the message asynchronous. If pbOverridestateOnShow is true it will continue and 
24609>>>>>>>>>    //  instruct the client to reinitialize the view before rendering it. If the view is not loaded
24609>>>>>>>>>    //  it will load the view (add the definitions to the response) and show it directly. The
24609>>>>>>>>>    //  optional handler message needs to be published and the object needs to be a web object.
24609>>>>>>>>>    //
24609>>>>>>>>>    //  - hoView                Handle of the view to be shown.
24609>>>>>>>>>    //  - hmOptCallBackMsg      (optional) Callback message executed when the view is initialized.
24609>>>>>>>>>    //  - hoOptCallbackObj      (optional) Object to which the callback message should be sent.
24609>>>>>>>>>    Procedure ShowView Handle hoView Handle hmOptCallbackMsg Handle hoOptCallbackObj
24611>>>>>>>>>        Boolean bIsLoaded bInSync bAllowAccess bShowDirect
24611>>>>>>>>>        String sView
24611>>>>>>>>>        String[] aParams
24612>>>>>>>>>        tWebClientAction tClientAction
24612>>>>>>>>>        tWebClientAction tClientAction
24612>>>>>>>>>        tWebClientAction[] aClientActions
24612>>>>>>>>>        tWebClientAction[] aClientActions
24613>>>>>>>>>        Handle hmCallbackMsg hoCallbackObj
24613>>>>>>>>>        Boolean bHandled
24613>>>>>>>>>        
24613>>>>>>>>>        If (num_arguments > 2) Begin
24615>>>>>>>>>            Move hmOptCallbackMsg to hmCallbackMsg
24616>>>>>>>>>            Move hoOptCallbackObj to hoCallbackObj
24617>>>>>>>>>        End
24617>>>>>>>>>>
24617>>>>>>>>>        
24617>>>>>>>>>        Move False to bShowDirect
24618>>>>>>>>>        
24618>>>>>>>>>        Get WebObjectName of hoView to sView
24619>>>>>>>>>                
24619>>>>>>>>>        // Test AllowViewAcess here because this explicitly tests access to the view we are loading.
24619>>>>>>>>>        // That is not the case when testing AllowViewAccess from CallAction. In CallAction we only
24619>>>>>>>>>        // test AllowViewAccess of the view that is processing the call (this might be different).
24619>>>>>>>>>        Get AllowViewAccess hoView to bAllowAccess
24620>>>>>>>>>        If (not(bAllowAccess)) Begin
24622>>>>>>>>>            Get ViewAccessDenied hoView False to bHandled
24623>>>>>>>>>            Procedure_Return
24624>>>>>>>>>        End
24624>>>>>>>>>>
24624>>>>>>>>>        
24624>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
24625>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
24626>>>>>>>>>        If (not(bIsLoaded)) Begin
24628>>>>>>>>>            //  If the view is not loaded we load it now
24628>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
24629>>>>>>>>>            If (bIsLoaded) Begin
24631>>>>>>>>>                Move True to bShowDirect
24632>>>>>>>>>            End
24632>>>>>>>>>>
24632>>>>>>>>>        End
24632>>>>>>>>>>
24632>>>>>>>>>        Else Begin
24633>>>>>>>>>            Get IsViewInSync hoView to bInSync
24634>>>>>>>>>            If (bInSync) Begin
24636>>>>>>>>>                Move True to bShowDirect
24637>>>>>>>>>            End
24637>>>>>>>>>>
24637>>>>>>>>>            Else Begin
24638>>>>>>>>>                If (pbOverrideStateOnShow(hoView)) Begin
24640>>>>>>>>>                    //  If pbOverrideStateOnShow is true we can override it by unloading it on the client and simply loading it fresh (we used to do sneaky things here before 20.0)
24640>>>>>>>>>                    
24640>>>>>>>>>                    //  Add an early executed action to unload the view
24640>>>>>>>>>                    Move "unloadView"   to tClientAction.sName
24641>>>>>>>>>                    Move ""             to tClientAction.sTarget
24642>>>>>>>>>                    Move ctExecEarly    to tClientAction.eType
24643>>>>>>>>>                    Move sView          to tClientAction.aParams[0]
24644>>>>>>>>>                    
24644>>>>>>>>>                    Get paClientActions to aClientActions
24645>>>>>>>>>                    Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
24646>>>>>>>>>                    Set paClientActions to aClientActions
24647>>>>>>>>>                    
24647>>>>>>>>>                    //  Load the view fresh and show when succesfull
24647>>>>>>>>>                    Get LoadView sView 0 to bIsLoaded
24648>>>>>>>>>                    If (bIsLoaded) Begin
24650>>>>>>>>>                        Move True to bShowDirect
24651>>>>>>>>>                    End
24651>>>>>>>>>>
24651>>>>>>>>>                End
24651>>>>>>>>>>
24651>>>>>>>>>                Else Begin
24652>>>>>>>>>                    //  We need to go to the client first
24652>>>>>>>>>                    Move sView to aParams[0]
24653>>>>>>>>>                    
24653>>>>>>>>>                    If (hmCallbackMsg > 0) Begin
24655>>>>>>>>>                        Get WebMethodName of hoCallbackObj hmCallbackMsg to aParams[1]
24656>>>>>>>>>                        Get WebObjectName of hoCallbackObj to aParams[2]
24657>>>>>>>>>                    End
24657>>>>>>>>>>
24657>>>>>>>>>                    
24657>>>>>>>>>                    Send ClientAction "showView" aParams
24658>>>>>>>>>                End
24658>>>>>>>>>>
24658>>>>>>>>>            End
24658>>>>>>>>>>
24658>>>>>>>>>        End
24658>>>>>>>>>>
24658>>>>>>>>>        
24658>>>>>>>>>        If (bShowDirect) Begin
24660>>>>>>>>>            // Do callback
24660>>>>>>>>>            If (hmCallbackMsg > 0) Begin
24662>>>>>>>>>                Send hmCallbackMsg of hoCallbackObj hoView
24663>>>>>>>>>            End
24663>>>>>>>>>>
24663>>>>>>>>>            
24663>>>>>>>>>            // Directly show the view
24663>>>>>>>>>            Send ShowView_Exec hoView False
24664>>>>>>>>>        End    
24664>>>>>>>>>>
24664>>>>>>>>>    End_Procedure
24665>>>>>>>>>    
24665>>>>>>>>>    
24665>>>>>>>>>    //  Actually shows the view by sending doShow and performing the renderView client action.
24665>>>>>>>>>    //
24665>>>>>>>>>    //  - hoView        Handle of the view object to the be shown.
24665>>>>>>>>>    //  - bStandalone   If true this is a standalone view (oWebApp.displayView(..)) and not 
24665>>>>>>>>>    //                  rendered by renderview.
24665>>>>>>>>>    Procedure ShowView_Exec Handle hoView Boolean bStandalone
24667>>>>>>>>>        String[] aParams
24668>>>>>>>>>        String sView
24668>>>>>>>>>        Handle hoInvokingView
24668>>>>>>>>>        
24668>>>>>>>>>        //  Check if the showview is not overriden by a different ShowView call inside OnNavigateForward, phoCurrentShowView should be set before this function is called
24668>>>>>>>>>        If (phoCurrentShowView(Self) = hoView or (phoCurrentShowView(Self) <> C_WebUnresolvedObject and IsDialog(phoCurrentShowView(Self)))) Begin
24670>>>>>>>>>            Send DoShow of hoView
24671>>>>>>>>>            Get WebObjectName of hoView to sView
24672>>>>>>>>>            
24672>>>>>>>>>            WebSet psCurrentView to sView
24673>>>>>>>>>            
24673>>>>>>>>>            If (not(bStandalone)) Begin
24675>>>>>>>>>                Move sView to aParams[0]
24676>>>>>>>>>                Send ClientAction "renderView" aParams
24677>>>>>>>>>            End
24677>>>>>>>>>>
24677>>>>>>>>>            
24677>>>>>>>>>            Set phoCurrentShowView to C_WebUnresolvedObject
24678>>>>>>>>>        End
24678>>>>>>>>>>
24678>>>>>>>>>    End_Procedure
24679>>>>>>>>>    
24679>>>>>>>>>    
24679>>>>>>>>>    //  Server-Action
24679>>>>>>>>>    //
24679>>>>>>>>>    //  Called by the JavaScript Engine to show a view. This can either be initiated by the server 
24679>>>>>>>>>    //  via ShowView (view was loaded to the client but not in sync) or be initiated from the 
24679>>>>>>>>>    //  client like with cWebMenuItemLoadView.
24679>>>>>>>>>    //
24679>>>>>>>>>    //  - sView         Name of the view.
24679>>>>>>>>>    //  - bStandalone   True if the view is shown separately (oWebApp.displayView).
24679>>>>>>>>>    //  - sOptCallbackMsg   (optional) String with the published procedure that needs to be called 
24679>>>>>>>>>    //                      when the view is initialized.
24679>>>>>>>>>    //  - sOptCallback      (optional) Name of the web object handling the callback message.
24679>>>>>>>>>    Procedure ShowView_FromClient String sView Boolean bStandalone String sOptCallbackMsg String sOptCallbackObj
24681>>>>>>>>>        Handle hoView hmCallbackMsg hoCallbackObj
24681>>>>>>>>>        Boolean bIsLoaded bInSync
24681>>>>>>>>>        
24681>>>>>>>>>        If (num_arguments > 3) Begin
24683>>>>>>>>>            Get WebObjectByName sOptCallbackObj to hoCallbackObj
24684>>>>>>>>>            If (hoCallbackObj > 0) Begin
24686>>>>>>>>>                Get WebMethodByName of hoCallbackObj sOptCallbackMsg to hmCallbackMsg
24687>>>>>>>>>            End
24687>>>>>>>>>>
24687>>>>>>>>>        End
24687>>>>>>>>>>
24687>>>>>>>>>        
24687>>>>>>>>>        Get WebObjectByName sView to hoView
24688>>>>>>>>>        Get IsViewLoaded hoView to bIsLoaded
24689>>>>>>>>>        Set phoCurrentShowView to hoView    // Property used to check if no other ShowView is called meanwhile (check is in ShowView_Exec)
24690>>>>>>>>>        
24690>>>>>>>>>        If (not(bIsLoaded)) Begin
24692>>>>>>>>>            Get LoadView sView 0 to bIsLoaded
24693>>>>>>>>>            If (bIsLoaded) Begin
24695>>>>>>>>>                
24695>>>>>>>>>                // Do callback
24695>>>>>>>>>                If (hmCallbackMsg > 0) Begin
24697>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
24698>>>>>>>>>                End
24698>>>>>>>>>>
24698>>>>>>>>>                
24698>>>>>>>>>                Send ShowView_Exec hoView bStandalone
24699>>>>>>>>>            End
24699>>>>>>>>>>
24699>>>>>>>>>        End
24699>>>>>>>>>>
24699>>>>>>>>>        Else Begin
24700>>>>>>>>>            Get IsViewInSync hoView to bInSync
24701>>>>>>>>>            If (bInSync) Begin
24703>>>>>>>>>                // Do callback
24703>>>>>>>>>                If (hmCallbackMsg > 0) Begin
24705>>>>>>>>>                    Send hmCallbackMsg of hoCallbackObj hoView
24706>>>>>>>>>                End
24706>>>>>>>>>>
24706>>>>>>>>>                
24706>>>>>>>>>                Send ShowView_Exec hoView bStandalone
24707>>>>>>>>>            End
24707>>>>>>>>>>
24707>>>>>>>>>            Else Begin
24708>>>>>>>>>                Error DFERR_OPERATOR "ShowView_FromClient requires view to be synchronized if loaded."
24709>>>>>>>>>>
24709>>>>>>>>>            End
24709>>>>>>>>>>
24709>>>>>>>>>        End
24709>>>>>>>>>>
24709>>>>>>>>>    End_Procedure
24710>>>>>>>>>    
24710>>>>>>>>>    
24710>>>>>>>>>    // Client Action: Sends unloadView to the client to remove the passed view and its web properties.
24710>>>>>>>>>    // An Unloaded view must be reloaded from the server before it can be displayed again (using LoadView). 
24710>>>>>>>>>    // Note, unloading a view is more secure than hiding it because its data is removed from the client.
24710>>>>>>>>>    // See also "Unload" method of cWebView.
24710>>>>>>>>>    // See also "LoadView"
24710>>>>>>>>>    Procedure UnloadView Handle hoView
24712>>>>>>>>>        String sViewName
24712>>>>>>>>>        String[] aParams
24713>>>>>>>>>        
24713>>>>>>>>>        Get Object_Label of hoView to sViewName
24714>>>>>>>>>        Move sViewName      to aParams[0]   // Pass the view name as the 1st parameter.
24715>>>>>>>>>        Move True           to aParams[1]
24716>>>>>>>>>        Send ClientAction "unloadView" aParams
24717>>>>>>>>>    End_Procedure
24718>>>>>>>>>    
24718>>>>>>>>>    
24718>>>>>>>>>    // Triggers when the page title is automatically updated and concatenates the the application 
24718>>>>>>>>>    // title with the view title. Can be augmented / overriden to 
24718>>>>>>>>>    //
24718>>>>>>>>>    // Params:
24718>>>>>>>>>    //      ByRef sTitle    Contains the page title when coming in, should receive the full title.
24718>>>>>>>>>    //      hoView          Handle to the current view (can be C_WebUnresolvedObject).
24718>>>>>>>>>    //      sViewTitle      Current caption of the view (can be "").
24718>>>>>>>>>    Procedure OnGeneratePageTitle String ByRef sTitle Handle hoView String sViewTitle
24720>>>>>>>>>        If (Trim(sViewTitle) <> "") Begin
24722>>>>>>>>>            Move (sTitle + " - " + sViewTitle) to sTitle
24723>>>>>>>>>        End
24723>>>>>>>>>>
24723>>>>>>>>>    End_Procedure
24724>>>>>>>>>    
24724>>>>>>>>>    
24724>>>>>>>>>    // Updates the page title by generating the full title based on the passed view title.
24724>>>>>>>>>    //
24724>>>>>>>>>    // Params:
24724>>>>>>>>>    //      hoView      Handle to the current view (can be C_WebUnresolvedObject).
24724>>>>>>>>>    //      sViewTitle  Current view caption.
24724>>>>>>>>>    Procedure UpdatePageTitle Handle hoView String sViewTitle
24726>>>>>>>>>        String sTitle
24726>>>>>>>>>        Boolean bUpdate
24726>>>>>>>>>        
24726>>>>>>>>>        WebGet pbUpdateApplicationTitle to bUpdate
24727>>>>>>>>>        
24727>>>>>>>>>        If (bUpdate) Begin
24729>>>>>>>>>            WebGet psApplicationTitle to sTitle
24730>>>>>>>>>            
24730>>>>>>>>>            Send OnGeneratePageTitle (&sTitle) hoView sViewTitle
24731>>>>>>>>>            
24731>>>>>>>>>            Send SetPageTitle sTitle
24732>>>>>>>>>        End
24732>>>>>>>>>>
24732>>>>>>>>>    End_Procedure
24733>>>>>>>>>
24733>>>>>>>>>
24733>>>>>>>>>    // This can be sent to any child object to retrieve the object handle of the parent view via delegation.
24733>>>>>>>>>    // If delegation reaches here it means there is no view object so we return C_WebUnresolvedObject.
24733>>>>>>>>>    Function ViewObject Returns Handle
24735>>>>>>>>>        Function_Return C_WebUnresolvedObject
24736>>>>>>>>>    End_Function
24737>>>>>>>>>    
24737>>>>>>>>>    
24737>>>>>>>>>    // Locate_Server and Server are used so that child objects can resolve 
24737>>>>>>>>>    // that a server does not exit.
24737>>>>>>>>>    Function Locate_Server Returns Handle
24739>>>>>>>>>        Function_Return 0
24740>>>>>>>>>    End_Function
24741>>>>>>>>>    
24741>>>>>>>>>    
24741>>>>>>>>>    Function Server Returns Handle
24743>>>>>>>>>        Function_Return 0
24744>>>>>>>>>    End_Function
24745>>>>>>>>>
24745>>>>>>>>>    // Determines if an initial view (like a login dialog) needs to be shown. Overriden in
24745>>>>>>>>>    // cWebSessionHost_mixin to handle showing of a login view.
24745>>>>>>>>>    //
24745>>>>>>>>>    // Returns:
24745>>>>>>>>>    //  Handle to the initial view that needs to be shown (C_WebUnresolvedObject if none)
24745>>>>>>>>>    Function ForcedInitialView Returns Handle
24747>>>>>>>>>        Function_Return C_WebUnresolvedObject
24748>>>>>>>>>    End_Function
24749>>>>>>>>>
24749>>>>>>>>>    // returns the default view, which is normally phoDefaultView.
24749>>>>>>>>>    // Is provided for augmentation so developers can specify the default view dynamically
24749>>>>>>>>>    Function GetDefaultView Returns Handle
24751>>>>>>>>>        Handle hoView
24751>>>>>>>>>        Get phoDefaultView to hoView
24752>>>>>>>>>        Function_Return hoView
24753>>>>>>>>>    End_Function
24754>>>>>>>>>
24754>>>>>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
24754>>>>>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
24754>>>>>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
24754>>>>>>>>>    // of each view referenced in the aDDODefs collection
24754>>>>>>>>>    //
24754>>>>>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
24754>>>>>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
24754>>>>>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
24756>>>>>>>>>        Integer i icDDODef
24756>>>>>>>>>        Handle[] aDDOViews
24757>>>>>>>>>        Handle hoInvokingObject
24757>>>>>>>>>        
24757>>>>>>>>>        Send NotifySyncWebApp         
24758>>>>>>>>>        
24758>>>>>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
24758>>>>>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
24759>>>>>>>>>        
24759>>>>>>>>>        //  First get all the object references
24759>>>>>>>>>        For i from 0 to (icDDODef - 1)
24765>>>>>>>>>>
24765>>>>>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
24765>>>>>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
24766>>>>>>>>>        Loop
24767>>>>>>>>>>
24767>>>>>>>>>        
24767>>>>>>>>>        Set paDDOViews to aDDOViews
24768>>>>>>>>>        
24768>>>>>>>>>        //  Now update data bindings (note that this needs to happen after paDDOViews is set for accessibility checks
24768>>>>>>>>>        For i from 0 to (icDDODef - 1)
24774>>>>>>>>>>
24774>>>>>>>>>            // Process the synchronized psValue and pbChanged properties for each control that has a data binding
24774>>>>>>>>>            Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
24776>>>>>>>>>            
24776>>>>>>>>>            // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
24776>>>>>>>>>            Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
24777>>>>>>>>>        Loop
24778>>>>>>>>>>
24778>>>>>>>>>    End_Procedure
24779>>>>>>>>>
24779>>>>>>>>>    Procedure Call_PostOnCallEnd tWebCallContext ByRef cctx
24781>>>>>>>>>        Integer i icDDODef
24781>>>>>>>>>        Handle[] aDDOViews
24782>>>>>>>>>        
24782>>>>>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
24782>>>>>>>>>        Get paDDOViews to aDDOViews
24783>>>>>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
24784>>>>>>>>>        
24784>>>>>>>>>        For i from 0 to (icDDODef - 1)
24790>>>>>>>>>>
24790>>>>>>>>>            Send TriggerOnCallEnd of aDDOViews[i]
24791>>>>>>>>>        Loop
24792>>>>>>>>>>
24792>>>>>>>>>        
24792>>>>>>>>>        Send TriggerOnCallEnd
24793>>>>>>>>>    End_Procedure
24794>>>>>>>>>    
24794>>>>>>>>>    // This event is sent for every AJAX call to this view. This can be used by your
24794>>>>>>>>>    // security rights management system to set various global rights and roles constraints
24794>>>>>>>>>    // properties during each AJAX call.
24794>>>>>>>>>    // Note: You should not use web properties for this purpose since synchronized
24794>>>>>>>>>    // properties are sync'ed to the client and thus considered insecure.
24794>>>>>>>>>    Procedure OnSyncWebApp
24796>>>>>>>>>    End_Procedure
24797>>>>>>>>>    
24797>>>>>>>>>    Procedure NotifySyncWebApp
24799>>>>>>>>>        Send OnSyncWebApp
24800>>>>>>>>>    End_Procedure
24801>>>>>>>>>
24801>>>>>>>>>    Procedure End_Construct_cWebViewHost_mixin
24803>>>>>>>>>        WebPublishFunction LoadView
24804>>>>>>>>>        WebPublishProcedure LoadViewCallBack_CallBack
24805>>>>>>>>>        WebPublishProcedure ShowView_FromClient
24806>>>>>>>>>    End_Procedure
24807>>>>>>>>>
24807>>>>>>>>>End_Class
24808>>>>>>>
24808>>>>>>>Register_Procedure OnUpdateViewStack
24808>>>>>>>
24808>>>>>>>// Singleton stack object. Store and manipulates information about the stack of views
24808>>>>>>>// in a drill-down navigation architecture.
24808>>>>>>>Class cWebViewStack is a cWebObject
24809>>>>>>>    
24809>>>>>>>    Procedure Construct_Object
24811>>>>>>>        Forward Send Construct_Object
24813>>>>>>>        
24813>>>>>>>        // Global handle is deprecated.
24813>>>>>>>        Move Self to ghoWebViewStack
24814>>>>>>>        // Set the viewstack of the cWebApp or cLocalWebControlHost to this object
24814>>>>>>>        Set phoViewStack of (Host(Self)) to Self
24815>>>>>>>        
24815>>>>>>>        Property tWebViewInfo[] paViewStack    // The stack of current views navigated to in the drill-down view stack.
24818>>>>>>>        
24818>>>>>>>        Property Handle[] paClientControls     // Array of client web controls that are notified whenever the view stack is modified
24819>>>>>>>    End_Procedure 
24820>>>>>>>
24820>>>>>>>    
24820>>>>>>>    // Returns the total number of views currently in the view stack.
24820>>>>>>>    Function ViewStackSize Returns Integer
24822>>>>>>>        Integer iCount
24822>>>>>>>        tWebViewInfo[] aViewStack
24822>>>>>>>        tWebViewInfo[] aViewStack
24823>>>>>>>        WebGet paViewStack to aViewStack
24824>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
24825>>>>>>>        Function_Return iCount
24826>>>>>>>    End_Function
24827>>>>>>>
24827>>>>>>>        
24827>>>>>>>    // Adds a new client object to the set of listening client objects.
24827>>>>>>>    // See also NotifyClients
24827>>>>>>>    Procedure AddClient Handle hoClient
24829>>>>>>>        Integer iCount
24829>>>>>>>        Handle[] aClientControls
24830>>>>>>>        
24830>>>>>>>        Get paClientControls to aClientControls
24831>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
24832>>>>>>>        Move hoClient to aClientControls[iCount]
24833>>>>>>>        Set paClientControls to aClientControls
24834>>>>>>>    End_Procedure
24835>>>>>>>
24835>>>>>>>
24835>>>>>>>
24835>>>>>>>    // sReason - [Out] Passes back the reason why Pop View is not allowed.
24835>>>>>>>    // Returns true if you can pop the passed View. 
24835>>>>>>>    // Returns False if the view is not at the top of the stack
24835>>>>>>>    Function CanPopView Handle hoView String ByRef sReason Returns Boolean
24837>>>>>>>        Integer iCount
24837>>>>>>>        String sViewName
24837>>>>>>>        tWebViewInfo[] aViewStack
24837>>>>>>>        tWebViewInfo[] aViewStack
24838>>>>>>>        
24838>>>>>>>        //Send DeserializeViewStack
24838>>>>>>>        WebGet paViewStack to aViewStack
24839>>>>>>>        Move (SizeOfArray(aViewStack)) to iCount
24840>>>>>>>        Get WebObjectName of hoView to sViewName
24841>>>>>>>        
24841>>>>>>>        If (iCount > 0 and sViewName = aViewStack[iCount-1].sViewName) Begin
24843>>>>>>>            Function_Return True
24844>>>>>>>        End
24844>>>>>>>>
24844>>>>>>>        Else Begin
24845>>>>>>>            Move "This is not the top view." to sReason
24846>>>>>>>            Function_Return False
24847>>>>>>>        End
24847>>>>>>>>
24847>>>>>>>    End_Function
24848>>>>>>>    
24848>>>>>>>    // sReason - [Out] Passes back the reason why Push View is not allowed.
24848>>>>>>>    // Returns true if you can push the passed View. 
24848>>>>>>>    // Returns False If the view is already on the view stack.
24848>>>>>>>    Function CanPushView Handle hoView String ByRef sReason Returns Boolean
24850>>>>>>>        Integer iIndex
24850>>>>>>>        Boolean bOK
24850>>>>>>>        
24850>>>>>>>        Get GetViewIndex hoView to iIndex
24851>>>>>>>        Move (iIndex = -1) to bOK
24852>>>>>>>        If (not(bOK)) Begin
24854>>>>>>>            Move "View is already in the view stack." to sReason        
24855>>>>>>>        End
24855>>>>>>>>
24855>>>>>>>        Function_Return bOK
24856>>>>>>>    End_Function
24857>>>>>>>
24857>>>>>>>    
24857>>>>>>>    // Returns the index in the view stack of the passed view handle. 
24857>>>>>>>    // Returns -1 if the view is not in the stack
24857>>>>>>>    Function GetViewIndex Handle hoView Returns Integer
24859>>>>>>>        Integer i iCount
24859>>>>>>>        String sViewName
24859>>>>>>>        tWebViewInfo[] aViewStack
24859>>>>>>>        tWebViewInfo[] aViewStack
24860>>>>>>>
24860>>>>>>>        If (hoView <> 0) Begin        
24862>>>>>>>            WebGet paViewStack to aViewStack
24863>>>>>>>            Move (SizeOfArray(aViewStack)) to iCount
24864>>>>>>>            Get WebObjectName of hoView to sViewName
24865>>>>>>>            
24865>>>>>>>            For i from 0 to (iCount-1)
24871>>>>>>>>
24871>>>>>>>                If (sViewName = aViewStack[i].sViewName) Begin
24873>>>>>>>                    Function_Return i
24874>>>>>>>                End
24874>>>>>>>>
24874>>>>>>>            Loop
24875>>>>>>>>
24875>>>>>>>        End
24875>>>>>>>>
24875>>>>>>>        
24875>>>>>>>        Function_Return -1
24876>>>>>>>    End_Function
24877>>>>>>>
24877>>>>>>>
24877>>>>>>>    // Returns the view handle of the view below the top of stack. 
24877>>>>>>>    // Returns 0 If there are less than two views in the stack.
24877>>>>>>>    // See also TopViewHandle.
24877>>>>>>>    Function InvokingViewHandle Returns Handle
24879>>>>>>>        Integer iTop
24879>>>>>>>        Handle hoView
24879>>>>>>>        tWebViewInfo[] aViewStack
24879>>>>>>>        tWebViewInfo[] aViewStack
24880>>>>>>>
24880>>>>>>>        // Update the stack
24880>>>>>>>        //Send DeserializeViewStack
24880>>>>>>>        WebGet paViewStack to aViewStack
24881>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
24882>>>>>>>            
24882>>>>>>>        If (iTop < 2) Begin
24884>>>>>>>            Function_Return 0
24885>>>>>>>        End
24885>>>>>>>>
24885>>>>>>>        Else Begin
24886>>>>>>>            Get WebObjectByName aViewStack[iTop-2].sViewName to hoView
24887>>>>>>>            Function_Return hoView
24888>>>>>>>        End
24888>>>>>>>>
24888>>>>>>>    End_Function
24889>>>>>>>    
24889>>>>>>>    // Returns the view handle of the invoking view of a specific view that is on the stack. 
24889>>>>>>>    // Returns C_WebUnresolvedObject if the view is not found on the stack.
24889>>>>>>>    Function InvokingViewHandleByView Handle hoView Returns Handle
24891>>>>>>>        Integer iIndex
24891>>>>>>>
24891>>>>>>>        tWebViewInfo[] aViewStack
24891>>>>>>>        tWebViewInfo[] aViewStack
24892>>>>>>>
24892>>>>>>>        // Update the stack
24892>>>>>>>        //Send DeserializeViewStack
24892>>>>>>>        WebGet paViewStack to aViewStack
24893>>>>>>>        
24893>>>>>>>        Get GetViewIndex hoView to iIndex
24894>>>>>>>        If (iIndex > 0) Begin
24896>>>>>>>       
24896>>>>>>>            Get WebObjectByName aViewStack[iIndex-1].sViewName to hoView
24897>>>>>>>            Function_Return hoView
24898>>>>>>>        End
24898>>>>>>>>
24898>>>>>>>        
24898>>>>>>>        Function_Return C_WebUnresolvedObject
24899>>>>>>>    End_Function
24900>>>>>>>    
24900>>>>>>>    
24900>>>>>>>    // Returns the view in the stack after the passed view. So the view of which the passed view is
24900>>>>>>>    // the invoking view. If the passed view is not in the stack or is the top view then
24900>>>>>>>    // C_WebUnresolvedObject will be returned.
24900>>>>>>>    Function NextViewHandleByView Handle hoView Returns Handle
24902>>>>>>>        Integer iIndex
24902>>>>>>>
24902>>>>>>>        tWebViewInfo[] aViewStack
24902>>>>>>>        tWebViewInfo[] aViewStack
24903>>>>>>>
24903>>>>>>>        // Update the stack
24903>>>>>>>        //Send DeserializeViewStack
24903>>>>>>>        WebGet paViewStack to aViewStack
24904>>>>>>>        
24904>>>>>>>        Get GetViewIndex hoView to iIndex
24905>>>>>>>        If (iIndex < SizeOfArray(aViewStack) - 1) Begin
24907>>>>>>>       
24907>>>>>>>            Get WebObjectByName aViewStack[iIndex+1].sViewName to hoView
24908>>>>>>>            Function_Return hoView
24909>>>>>>>        End
24909>>>>>>>>
24909>>>>>>>        
24909>>>>>>>        Function_Return C_WebUnresolvedObject
24910>>>>>>>    End_Function
24911>>>>>>>
24911>>>>>>>    
24911>>>>>>>    // Notifies all listening client objects that the view stack has changed.
24911>>>>>>>    // These objects must understand the OnUpdateViewStack event.
24911>>>>>>>    // See also AddClient
24911>>>>>>>    Procedure NotifyClients
24913>>>>>>>        Integer i iCount
24913>>>>>>>        Handle[] aClientControls
24914>>>>>>>        
24914>>>>>>>        Get paClientControls to aClientControls
24915>>>>>>>        Move (SizeOfArray(aClientControls)) to iCount
24916>>>>>>>        
24916>>>>>>>        For i from 0 to (iCount-1)
24922>>>>>>>>
24922>>>>>>>            Send OnUpdateViewStack to aClientControls[i]
24923>>>>>>>        Loop
24924>>>>>>>>
24924>>>>>>>    End_Procedure
24925>>>>>>>    
24925>>>>>>>    
24925>>>>>>>    // Pops all members of the stack down to the passed view handle. If the view is
24925>>>>>>>    // not on the stack then nothing is removed.
24925>>>>>>>    Procedure PopDownToView Handle hoView
24927>>>>>>>        Integer iIndex iTopOfStack
24927>>>>>>>        tWebViewInfo[] aViewStack
24927>>>>>>>        tWebViewInfo[] aViewStack
24928>>>>>>>
24928>>>>>>>        Get GetViewIndex hoView to iIndex
24929>>>>>>>        
24929>>>>>>>        If (iIndex <> -1) Begin
24931>>>>>>>            // Update the stack
24931>>>>>>>            WebGet paViewStack to aViewStack
24932>>>>>>>            Move (ResizeArray(aViewStack, iIndex+1)) to aViewStack
24933>>>>>>>            WebSet paViewStack to aViewStack        
24934>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
24935>>>>>>>        End
24935>>>>>>>>
24935>>>>>>>    End_Procedure
24936>>>>>>>
24936>>>>>>>
24936>>>>>>>    // Pops a view off the top of the view stack.
24936>>>>>>>    Procedure PopView
24938>>>>>>>        Integer iTop
24938>>>>>>>        tWebViewInfo[] aViewStack
24938>>>>>>>        tWebViewInfo[] aViewStack
24939>>>>>>>
24939>>>>>>>        // Update the stack
24939>>>>>>>        WebGet paViewStack to aViewStack
24940>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
24941>>>>>>>        
24941>>>>>>>        If (iTop = 0) Begin
24943>>>>>>>            Error DFERR_PROGRAM "View Stack Error: Pop past end of stack"
24944>>>>>>>>
24944>>>>>>>        End
24944>>>>>>>>
24944>>>>>>>        Else Begin
24945>>>>>>>            Move (ResizeArray(aViewStack, iTop - 1)) to aViewStack
24946>>>>>>>            WebSet paViewStack to aViewStack        
24947>>>>>>>            Send NotifyClients    // Notify the view stack clients of this change
24948>>>>>>>        End
24948>>>>>>>>
24948>>>>>>>    End_Procedure
24949>>>>>>>
24949>>>>>>>    
24949>>>>>>>    // Pushes a new view to the top of the view stack (Note: we assume hoView's web properties are in scope).
24949>>>>>>>    Procedure PushView Handle hoView Integer eNavigateType
24951>>>>>>>        Handle hoMainDD
24951>>>>>>>        Integer iTop
24951>>>>>>>        tWebViewInfo ViewInfo
24951>>>>>>>        tWebViewInfo ViewInfo
24951>>>>>>>        tWebViewInfo[] aViewStack
24951>>>>>>>        tWebViewInfo[] aViewStack
24952>>>>>>>        RowID riId
24952>>>>>>>        // Before pushing any new view onto the stack we want 
24952>>>>>>>        // to retrieve the latest "Should_Save state of the
24952>>>>>>>        // current top view...
24952>>>>>>>        Send UpdateShouldSave
24953>>>>>>>        
24953>>>>>>>        // Populate the ViewInfo struct
24953>>>>>>>        Get WebObjectName of hoView  to ViewInfo.sViewName
24954>>>>>>>        WebGet psCaption of hoView   to ViewInfo.sCaption
24955>>>>>>>        Move ViewInfo.sCaption       to ViewInfo.sHeaderCaption    // by default these are both set to the same value
24956>>>>>>>        Get peViewType of hoView     to ViewInfo.eViewType
24957>>>>>>>        Move eNavigateType           to ViewInfo.eNavigateType 
24958>>>>>>>        
24958>>>>>>>        Get Main_DD of hoView to hoMainDD
24959>>>>>>>        If (hoMainDD <> 0) Begin
24961>>>>>>>            Get Main_File of hoMainDD to ViewInfo.iMainTable
24962>>>>>>>            Get CurrentRowId of hoMainDD to riId
24963>>>>>>>            Move riId to ViewInfo.riMainTable
24964>>>>>>>//            Move (SerializeRowID(riId)) to ViewInfo.sMainTableRowID
24964>>>>>>>        End
24964>>>>>>>>
24964>>>>>>>        
24964>>>>>>>        // Update the stack
24964>>>>>>>        WebGet paViewStack to aViewStack
24965>>>>>>>        Move (InsertInArray(aViewStack,-1,ViewInfo)) to aViewStack
24966>>>>>>>        WebSet paViewStack to aViewStack        
24967>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
24968>>>>>>>    End_Procedure
24969>>>>>>>    
24969>>>>>>>    // returns handle of object we can close up to
24969>>>>>>>    // hoCloseToView is the view you want to close to. If 0, it's all.
24969>>>>>>>    // bSkipTop deremines if you should skip the top of the stack, which sometimes gets special
24969>>>>>>>    // treatment.
24969>>>>>>>    Function CanCloseViews Handle hoCloseToView Boolean bSkipTop Returns Handle
24971>>>>>>>        tWebViewInfo[] aViewStack
24971>>>>>>>        tWebViewInfo[] aViewStack
24972>>>>>>>        Integer iStackViews eCloseAction
24972>>>>>>>        Handle hoView
24972>>>>>>>        Boolean bStop
24972>>>>>>>        Send UpdateShouldSave to (ViewStack(Self))
24973>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
24974>>>>>>>        Move (SizeOfArray(aViewStack)) to iStackViews
24975>>>>>>>        If bSkipTop Begin
24977>>>>>>>            Decrement iStackViews
24978>>>>>>>        End
24978>>>>>>>>
24978>>>>>>>        While (iStackViews and not(bStop))
24982>>>>>>>            Decrement iStackViews
24983>>>>>>>            Get WebObjectByName aViewStack[iStackViews].sViewName to hoView
24984>>>>>>>            If (hoView=hoCloseToView) Begin
24986>>>>>>>                Move 0 to iStackViews
24987>>>>>>>            End
24987>>>>>>>>
24987>>>>>>>            Else If (aViewStack[iStackViews].bShouldSave) Begin
24990>>>>>>>                Get GetChangedViewExitAction of hoView to eCloseAction 
24991>>>>>>>                // we only allow a close if it is a pure adandon changes.
24991>>>>>>>                If (eCloseAction<>cveAbandonChanges) Begin
24993>>>>>>>                   Function_Return hoView 
24994>>>>>>>                End
24994>>>>>>>>
24994>>>>>>>            End
24994>>>>>>>>
24994>>>>>>>        Loop
24995>>>>>>>>
24995>>>>>>>        Function_Return hoCloseToView
24996>>>>>>>    End_Function
24997>>>>>>>    
24997>>>>>>>    // Clears the view stack.
24997>>>>>>>    // bDefaultView - Pass True if the default view should be pushed onto the
24997>>>>>>>    //                view stack automatically after it is reset.
24997>>>>>>>    // Returns - True if the Reset succeeded.
24997>>>>>>>    //           False if the View stack could not be reset (usually due to unsaved changes in
24997>>>>>>>    //           one of the current views in the stack).
24997>>>>>>>    Function Reset Boolean bDefaultView Boolean bUnconditional Returns Boolean
24999>>>>>>>        Handle hoShouldSaveView 
24999>>>>>>>        Handle hoTopView hoDefaultView
24999>>>>>>>        Integer iDefaultViewIndex
24999>>>>>>>        tWebViewInfo[] aViewStack
24999>>>>>>>        tWebViewInfo[] aViewStack
25000>>>>>>>        String sReason
25000>>>>>>>        
25000>>>>>>>        Get GetDefaultView of (Host(Self)) to hoDefaultView
25001>>>>>>>        Get TopViewHandle to hoTopView
25002>>>>>>>        
25002>>>>>>>        // First see if it is OK to close all of the current views down
25002>>>>>>>        // to the current first view.
25002>>>>>>>        If bUnconditional Begin
25004>>>>>>>            Move hoDefaultView to hoShouldSaveView
25005>>>>>>>        End
25005>>>>>>>>
25005>>>>>>>        Else Begin
25006>>>>>>>            Get CanCloseViews hoDefaultView False to hoShouldSaveView
25007>>>>>>>        End
25007>>>>>>>>
25007>>>>>>>        If (hoShouldSaveView<>hoDefaultView) Begin
25009>>>>>>>            If (hoShouldSaveView <> hoTopView) Begin
25011>>>>>>>                Send ShowView to (Host(Self)) hoShouldSaveView
25012>>>>>>>            End
25012>>>>>>>>
25012>>>>>>>            Send PopDownToView of (ViewStack(Self)) hoShouldSaveView
25013>>>>>>>            Send UpdateInvokingViewDrillDownStyle to hoShouldSaveView
25014>>>>>>>            Send CantCloseChangedViewError
25015>>>>>>>            Function_Return False
25016>>>>>>>        End
25016>>>>>>>>
25016>>>>>>>        
25016>>>>>>>        // If we got here then we can reset the stack...
25016>>>>>>>        If (hoTopView <> 0) Begin
25018>>>>>>>            If (hoDefaultView <> hoTopView or not(bDefaultView)) Begin
25020>>>>>>>                Send Hide to hoTopView    // First hide the current view
25021>>>>>>>            End
25021>>>>>>>>
25021>>>>>>>        End
25021>>>>>>>>
25021>>>>>>>        
25021>>>>>>>        // Make sure we do not clear the default view off the stack
25021>>>>>>>        If (bDefaultView and hoDefaultView <> 0) Begin
25023>>>>>>>            // Test that the default view is the first view in the stack
25023>>>>>>>            Get GetViewIndex hoDefaultView to iDefaultViewIndex
25024>>>>>>>            
25024>>>>>>>            If (iDefaultViewIndex = 0) Begin
25026>>>>>>>                WebGet paViewStack to aViewStack
25027>>>>>>>                Move (ResizeArray(aViewStack, 1)) to aViewStack
25028>>>>>>>            End
25028>>>>>>>>
25028>>>>>>>        End
25028>>>>>>>>
25028>>>>>>>        
25028>>>>>>>        // Clear the stack
25028>>>>>>>        WebSet paViewStack to aViewStack        
25029>>>>>>>        Send NotifyClients    // Notify the view stack clients of this change
25030>>>>>>>        
25030>>>>>>>        Function_Return True
25031>>>>>>>    End_Function
25032>>>>>>>
