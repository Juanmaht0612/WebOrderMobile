10490>>>>>>>>>        // This is defined as DD_DEFAULT_ERROR_NUMBER in DataDict.pkg and is the default Field_error number of DDs.
10490>>>>>>>>>        Move 999                                   to aUserErrors[32]
10491>>>>>>>>>        // This is session timeout (we keep the old number 950 for backwards comatibility reasons)
10491>>>>>>>>>        Move DFERR_WEBAPP_SESSION_TIMEOUT          to aUserErrors[33]
10492>>>>>>>>>        // This is session timeout (we keep the old number 951 for backwards comatibility reasons)
10492>>>>>>>>>        Move DFERR_WEBAPP_BAD_SESSION_KEY          to aUserErrors[34]
10493>>>>>>>>>        Move DFERR_WEBAPP_INVALID_URL              to aUserErrors[35]
10494>>>>>>>>>        Move DFERR_WEBAPP_INVALID_URL_REC          to aUserErrors[36]
10495>>>>>>>>>        Move (SortArray(aUserErrors)) to aUserErrors
10496>>>>>>>>>        Set paUserErrors to aUserErrors
