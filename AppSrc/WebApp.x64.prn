3182>>>>>    Procedure Define_RGB_Support_Temp_Mixin
3184>>>>>        Property Integer private.Object_Color 0
3185>>>>>        // always force a set object_color, by passing 0,0 VDF
3185>>>>>        // convert these to system colors ($10xx) and pass them on to
3185>>>>>        // set Dynamic_colors. We will augment Dynamic_colors to set our
3185>>>>>        // internal object_color. This way we always have object_color set
3185>>>>>        Set object_color to 0 0
3186>>>>>    End_Procedure
3187>>>>>    
3187>>>>>    Procedure Set Dynamic_Colors Integer i1 Integer i2
3189>>>>>        // if sent when within init_instance, ignore. Our property is not yet defined.
3189>>>>>        // Keep track of object_color manually.
3189>>>>>        If (buildingObjectid = 0) ;            Set Private.Object_color to (i1*65536 + i2)
3192>>>>>        
3192>>>>>        Forward Set dynamic_colors to i1 i2
3194>>>>>        
3194>>>>>        // if a system color convert from old DF color to new GetSysColor.
3194>>>>>        // This way changes in the windows color will get set right away.
3194>>>>>        // DF system colors are $10xx, New Rgb is $800000xx).
3194>>>>>        If (i1 iand $1000) ;            Set TextColor to ((I1 iand $FF) ior $80000000)
3197>>>>>        If (i2 iand $1000) ;            Set Color      to ((I2 iand $FF) ior $80000000)
3200>>>>>    End_Procedure
3201>>>>>    
3201>>>>>    Function Object_Color Returns Integer
3203>>>>>        Function_Return (Private.Object_color(Self))
3204>>>>>    End_Function
