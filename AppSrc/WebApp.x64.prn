290>>>>>>>>>>>>>Define FORMAT_MESSAGE_ALLOCATE_BUFFER for |CI$00000100
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_IGNORE_INSERTS  for |CI$00000200
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_FROM_STRING     for |CI$00000400
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_FROM_HMODULE    for |CI$00000800
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_FROM_SYSTEM     for |CI$00001000
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_ARGUMENT_ARRAY  for |CI$00002000
290>>>>>>>>>>>>>Define FORMAT_MESSAGE_MAX_WIDTH_MASK  for |CI$000000FF
290>>>>>>>>>>>>>// File Attributes.....
290>>>>>>>>>>>>>
290>>>>>>>>>>>>>// For use with the global GetFileAttribute function....
290>>>>>>>>>>>>>Define INVALID_FILE_ATTRIBUTES            for -1
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_READONLY            for |CI$0001
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_HIDDEN              for |CI$0002
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_SYSTEM              for |CI$0004
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_DIRECTORY           for |CI$0010
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_ARCHIVE             for |CI$0020
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_NORMAL              for |CI$0080
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_TEMPORARY           for |CI$0100
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_SPARSE_FILE         for |CI$0200
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_REPARSE_POINT       for |CI$0400
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_COMPRESSED          for |CI$0800
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_OFFLINE             for |CI$1000
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_NOT_CONTENT_INDEXED for |CI$2000
290>>>>>>>>>>>>>Define FILE_ATTRIBUTE_ENCRYPTED           for |CI$4000
290>>>>>>>>>>>>>
290>>>>>>>>>>>>>// Resource Type IDs
290>>>>>>>>>>>>>// =================
290>>>>>>>>>>>>>// Note: We are using the String version of these IDs. These special strings
290>>>>>>>>>>>>>//       are interpreted as resource type integer id's in all Win32 functions
290>>>>>>>>>>>>>//       that accept a resource type ID as a parameter. Below is from Win32 API Help...
290>>>>>>>>>>>>>//
290>>>>>>>>>>>>>// lpType specifies the integer identifier of the type of the given resource.
290>>>>>>>>>>>>>// Otherwise, the parameter is a long pointer to a null-terminated string.
290>>>>>>>>>>>>>// If the first character of the String is a pound sign (#), the remaining
290>>>>>>>>>>>>>// characters represent a Decimal Number that specifies the Integer identifier
290>>>>>>>>>>>>>// of the resource's type. For example, the string "#1" represents the integer type 1
290>>>>>>>>>>>>>//
290>>>>>>>>>>>>>Define RT_CURSOR       for '#1'     // Hardware-dependent cursor resource.
290>>>>>>>>>>>>>Define RT_BITMAP       for '#2'     // Bitmap resource.
290>>>>>>>>>>>>>Define RT_ICON         for '#3'     // Hardware-dependent icon resource.
290>>>>>>>>>>>>>Define RT_MENU         for '#4'     // Menu resource.
290>>>>>>>>>>>>>Define RT_DIALOG       for '#5'     // Dialog box.
290>>>>>>>>>>>>>Define RT_ACCELERATOR  for '#9'     // Accelerator table.
290>>>>>>>>>>>>>Define RT_STRING       for '#6'     // String-table entry.
290>>>>>>>>>>>>>Define RT_FONTDIR      for '#7'     // Font directory resource.
290>>>>>>>>>>>>>Define RT_FONT         for '#8'     // Font resource.
290>>>>>>>>>>>>>Define RT_RCDATA       for '#10'    // Application-defined resource (raw data).
290>>>>>>>>>>>>>Define RT_MESSAGETABLE for '#11'    // Message-table entry.
290>>>>>>>>>>>>>Define RT_GROUP_CURSOR for '#12'    // Hardware-independent cursor resource.
290>>>>>>>>>>>>>Define RT_GROUP_ICON   for '#14'    // Hardware-independent icon resource.
290>>>>>>>>>>>>>Define RT_VERSION      for '#16'    // Version resource.
290>>>>>>>>>>>>>Define RT_DLGINCLUDE   for '#17'    // Allows a resource editing tool to associate a String with an .rc file. Typically, the String is the name of the header file that provides symbolic names. The resource compiler parses the String but otherwise ignores the value.
290>>>>>>>>>>>>>Define RT_PLUGPLAY     for '#19'    // Plug and Play resource.
290>>>>>>>>>>>>>Define RT_VXD          for '#20'    // VXD.
290>>>>>>>>>>>>>Define RT_ANICURSOR    for '#21'    // Animated cursor.
290>>>>>>>>>>>>>Define RT_ANIICON      for '#22'    // Animated icon.
290>>>>>>>>>>>>>Define RT_HTML         for '#23'    // HTML resource.
290>>>>>>>>>>>>>Define RT_MANIFEST     for '#24'    // Side-by-Side Assembly Manifest.
290>>>>>>>>>>>>>
290>>>>>>>>>>>>>
290>>>>>>>>>>>>>External_Function CopyMemory "RtlMoveMemory" Kernel32.dll ;    Pointer psDest Pointer psSource Longptr cChars Returns VOID_TYPE        // cChars is number of bytes
291>>>>>>>>>>>>>
291>>>>>>>>>>>>>// When called directly: lpFilename must be pointer of a WString.
291>>>>>>>>>>>>>External_Function DeleteFileW "DeleteFileW" Kernel32.Dll ;   Pointer lpFileName ;   Returns Integer
292>>>>>>>>>>>>>
292>>>>>>>>>>>>>// Wrapper Function DeleteFile
292>>>>>>>>>>>>>Function DeleteFile Global ;   Pointer lpFileName ;   Returns Integer
294>>>>>>>>>>>>>    
294>>>>>>>>>>>>>    Integer iResult
294>>>>>>>>>>>>>    UWide   uwFileName
294>>>>>>>>>>>>>    UWide   uwFileName
294>>>>>>>>>>>>>
294>>>>>>>>>>>>>    Send StringToWide lpFileName (&uwFileName)
295>>>>>>>>>>>>>                    
295>>>>>>>>>>>>>    Move (DeleteFileW (uwFileName.lpUText)) to iResult
296>>>>>>>>>>>>>          
296>>>>>>>>>>>>>    Function_Return iResult
297>>>>>>>>>>>>>End_Function
298>>>>>>>>>>>>>
298>>>>>>>>>>>>>// Do not call directly, use the wrapper function instead
298>>>>>>>>>>>>>External_Function FormatMessageW "FormatMessageW" KERNEL32.DLL ;    DWord   dwFlags ;    Pointer lpSource ;    DWord   dwMessageId ;    DWord   dwLanguageId ;    Pointer lpwBuffer ;    DWord   nSize ;    Pointer Arguments ;    Returns DWord
299>>>>>>>>>>>>>
299>>>>>>>>>>>>>// Compatibility Wrapper Function FormatMessage
299>>>>>>>>>>>>>Function FormatMessage Global ;    DWord   dwFlags ;    Pointer lpSource ;    DWord   dwMessageId ;    DWord   dwLanguageId ;    Pointer lpBuffer ;    DWord   nSize ;    Pointer Arguments ;    Returns DWord
301>>>>>>>>>>>>>    
301>>>>>>>>>>>>>    DWord dwResult
301>>>>>>>>>>>>>    UWide uwBuffer
301>>>>>>>>>>>>>    UWide uwBuffer
301>>>>>>>>>>>>>
301>>>>>>>>>>>>>    Send WideSetBuffer lpBuffer nSize (&uwBuffer)
302>>>>>>>>>>>>>                    
302>>>>>>>>>>>>>    Move (FormatMessageW (dwFlags, lpSource, dwMessageId, dwLanguageId, uwBuffer.lpUText, nSize, Arguments)) to dwResult 
303>>>>>>>>>>>>>          
303>>>>>>>>>>>>>    Send WideToString (&uwBuffer) lpBuffer
304>>>>>>>>>>>>>    
304>>>>>>>>>>>>>    Function_Return dwResult
305>>>>>>>>>>>>>End_Function
306>>>>>>>>>>>>>
306>>>>>>>>>>>>>External_Function FreeLibrary "FreeLibrary" Kernel32.dll ;    Handle hInstLib Returns VOID_TYPE
307>>>>>>>>>>>>>
307>>>>>>>>>>>>>// Make sure to treat the return pointer as a WString
307>>>>>>>>>>>>>External_Function GetCommandLineW "GetCommandLineW" Kernel32.dll ;    Returns Pointer
308>>>>>>>>>>>>>
308>>>>>>>>>>>>>External_Function GetFullPathNameW "GetFullPathNameW" Kernel32.dll ;    WString sFileName ;    DWord   nBufferLength ;    Pointer lpBuffer ;    Pointer lpFilePart ;    Returns Integer
309>>>>>>>>>>>>>
309>>>>>>>>>>>>>// Compatibility Wrapper Function GetFullPathName
309>>>>>>>>>>>>>Function GetFullPathName Global ;    String  sFileName ;    DWord   nBufferLength ;    Pointer lpBuffer ;    Pointer lpFilePart ;    // Address of a pointer to a string    Returns Integer
311>>>>>>>>>>>>>    
311>>>>>>>>>>>>>    Integer iResult iVoid
311>>>>>>>>>>>>>    Pointer lplpFP
311>>>>>>>>>>>>>    String  sFilePart
311>>>>>>>>>>>>>    UWide   uwBuffer
311>>>>>>>>>>>>>    UWide   uwBuffer
311>>>>>>>>>>>>>    
311>>>>>>>>>>>>>    Send WideSetBuffer lpBuffer (AddressOf(nBufferLength)) (&uwBuffer)
312>>>>>>>>>>>>>                    
312>>>>>>>>>>>>>    Move (GetFullPathNameW (sFileName, nBufferLength, uwBuffer.lpUText, lpFilePart)) to iResult 
313>>>>>>>>>>>>>    
313>>>>>>>>>>>>>    Send WideToString (&uwBuffer) lpBuffer
314>>>>>>>>>>>>>    
314>>>>>>>>>>>>>    // lpFilePart is a pointer to a buffer that receives the address (within lpBuffer) of the final file name 
314>>>>>>>>>>>>>    // component in the path. But it is pointing to the UWide struct. Convert it to UTF8 and copy it to lpFilePart.
314>>>>>>>>>>>>>    Move (DeRefPtr(lpFilePart, 0)) to lplpFP       // Get the Address of the string
315>>>>>>>>>>>>>    Move (PointerToWString(lplpFP)) to sFilePart
316>>>>>>>>>>>>>    Move (MemCopy(lplpFP, AddressOf(sFilePart), SizeOfString(sFilePart) + 1)) to iVoid
317>>>>>>>>>>>>>    
317>>>>>>>>>>>>>    Function_Return iResult
318>>>>>>>>>>>>>End_Function
319>>>>>>>>>>>>>
319>>>>>>>>>>>>>External_Function GetModuleHandleW "GetModuleHandleW" Kernel32.dll ;    Pointer lpModule ;    Returns Handle
320>>>>>>>>>>>>>
320>>>>>>>>>>>>>// Compatibility Wrapper Function GetModuleHandle
320>>>>>>>>>>>>>Function GetModuleHandle Global ;    Pointer pModule ;    Returns Handle
322>>>>>>>>>>>>>    
322>>>>>>>>>>>>>    Handle hResult
322>>>>>>>>>>>>>    UWide  uwModule
322>>>>>>>>>>>>>    UWide  uwModule
322>>>>>>>>>>>>>
