32834>>>>>    // Hides all active dialogs
32834>>>>>    Procedure HideAllDialogs
32836>>>>>        Handle hoView
32836>>>>>        String sInvokingView
32836>>>>>        Integer eViewStyle iCount
32836>>>>>        tWebViewInfo[] aViewStack
32836>>>>>        tWebViewInfo[] aViewStack
32837>>>>>        
32837>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
32838>>>>>        // We start from the 2nd last element going down
32838>>>>>        Move (SizeOfArray(aViewStack)-1) to iCount
32839>>>>>        
32839>>>>>        While (iCount <> 0)
32843>>>>>            Get WebObjectByName aViewStack[iCount].sViewName False to hoView
32844>>>>>            Get peWebViewStyle of hoView to eViewStyle
32845>>>>>            //If the previous view isnt a dialog we can stop looking back
32845>>>>>            If (eViewStyle <> wvsDialog) Begin
32847>>>>>                Procedure_Return
32848>>>>>            End
32848>>>>>>
32848>>>>>            
32848>>>>>            Send Hide of hoView
32849>>>>>            
32849>>>>>            Decrement iCount
32850>>>>>        Loop
32851>>>>>>
32851>>>>>    End_Procedure
32852>>>>>    
32852>>>>>    // Shows a dialog again. It does this by showing All the previous dialogs in the viewstack up untill the first actual view.
32852>>>>>    Procedure RestoreDialog
32854>>>>>        Handle hoView hoNextView
32854>>>>>        String sViewName
32854>>>>>        Integer eViewStyle iIndex iCount iViewsInStack iAmountOfViewsToShow
32854>>>>>        Handle[] aViewsToShow
32855>>>>>        Boolean bFirstNonDialogView
32855>>>>>        tWebViewInfo[] aViewStack
32855>>>>>        tWebViewInfo[] aViewStack
32856>>>>>        tWebViewInfo searchStack
32856>>>>>        tWebViewInfo searchStack
32856>>>>>        
32856>>>>>        Get psStateViewName to sViewName
32857>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
32858>>>>>        Move sViewName to searchStack.sViewName        
32859>>>>>        Move (SearchArray(searchStack, aViewStack)) to iIndex
32860>>>>>        Move Self to aViewsToShow[-1]
32861>>>>>        
32861>>>>>        // This should never be possible
32861>>>>>        If (iIndex = -1) Begin
32863>>>>>            Procedure_Return
32864>>>>>        End
32864>>>>>>
32864>>>>>        
32864>>>>>        //Start going down the viewstack, and start showing each view that isnt a drill down view.
32864>>>>>        While (not(bFirstNonDialogView))
32868>>>>>            Decrement iIndex
32869>>>>>            Get FindWebObject of (Owner(Self)) aViewStack[iIndex].sViewName to hoView
32870>>>>>            Get peWebViewStyle of hoView to eViewStyle
32871>>>>>            Move (InsertInArray(aViewsToShow, 0, hoView)) to aViewsToShow
32872>>>>>            
32872>>>>>            If (eViewStyle <> wvsDialog) Begin
32874>>>>>                Move True to bFirstNonDialogView
32875>>>>>            End
32875>>>>>>
32875>>>>>        Loop
32876>>>>>>
32876>>>>>        
32876>>>>>        //Now loop through the array of views we should be showing
32876>>>>>        Move (SizeOfArray(aViewsToShow)-1) to iAmountOfViewsToShow
32877>>>>>        For iCount from 0 to iAmountOfViewsToShow
32883>>>>>>
32883>>>>>            Send ShowView to (Host(Self)) aViewsToShow[iCount]
32884>>>>>        Loop
32885>>>>>>
32885>>>>>    End_Procedure
