26249>>>>>>>>>>>>>>>>>>>    // Returns the comment of the table enumerated at the given position
26249>>>>>>>>>>>>>>>>>>>    //
26249>>>>>>>>>>>>>>>>>>>    Function TableComment Integer iIndex Returns String
26251>>>>>>>>>>>>>>>>>>>        String  sDriver
26251>>>>>>>>>>>>>>>>>>>        String  sTableComment
