31407>>>>>    // Event that is fired when the size of the browser window changes. This event can be used to 
31407>>>>>    // make the web application layout responsive to the browser size. It gets the new dimensions
31407>>>>>    // of the browser window passed as parameters.
31407>>>>>    //
31407>>>>>    // Params:
31407>>>>>    //  iWindowWidth    Width of the browser window in pixels.
31407>>>>>    //  iWindowHeight   Height of the browser window in pixels.
31407>>>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
31409>>>>>    End_Procedure    
31410>>>>>
31410>>>>>    // Generic request find method for handling Request_Find
31410>>>>>    // Currently this will get delegated here by objects that do not understand Requset_Find. In the
31410>>>>>    // future we could use DEO_Find_Object to not send these messages at all.
31410>>>>>    // eFindMode - Can be one of... lt, le, eq, ge, gt, or it may be either Next_Record, First_Record, or Last_Record
31410>>>>>    Procedure Request_Find Integer eFindMode
31412>>>>>        // Do nothing. Ignore this message in this class.
31412>>>>>    End_Procedure
31413>>>>>
31413>>>>>
31413>>>>>    //  Performs the initialization of the view when it is loaded to the client. It is called by 
31413>>>>>    //  cWebApp at the right moment (pbOverrideStateOnShow influences this). Clears the DDO 
31413>>>>>    //  structures, adds key handlers and sends OnResizeWindow.
31413>>>>>    //    
31413>>>>>    Procedure InitForShow
31415>>>>>        Integer i iCount iWidth iHeight
31415>>>>>        Handle hoMainDD
31415>>>>>        Handle[] aAdditionalDDOStructures 
31416>>>>>        tNameHandlePair[] aDDOs
31416>>>>>        tNameHandlePair[] aDDOs
31417>>>>>        Boolean bOnResize bPreLoaded bDynamicConstraints
31417>>>>>        tDDRemembered[] aEmptyRemembered
31417>>>>>        tDDRemembered[] aEmptyRemembered
31418>>>>>        
31418>>>>>        //  If this is a preloaded view we skip initforshow
31418>>>>>        WebGet pbPreLoaded to bPreLoaded
31419>>>>>        If (bPreLoaded) Begin
31421>>>>>            WebSet pbPreLoaded to False
31422>>>>>            Procedure_Return
31423>>>>>        End
31423>>>>>>
31423>>>>>        
31423>>>>>        Get Main_DD to hoMainDD
31424>>>>>        If (hoMainDD <> 0) Begin
31426>>>>>            // Clear dynamic constraints that might have been left from previous show
31426>>>>>            Get IsDynamicConstraints to bDynamicConstraints
31427>>>>>            If (bDynamicConstraints) Begin
31429>>>>>                Send ClearConstrainFiles hoMainDD
31430>>>>>                Send Rebuild_Constraints of hoMainDD
31431>>>>>            End
31431>>>>>>
31431>>>>>        End
31431>>>>>>
31431>>>>>        
31431>>>>>        Set pbInitForShow to True
31432>>>>>        
31432>>>>>        // Clear remember values
31432>>>>>        Get paDDOIndex to aDDOs
31433>>>>>        Move (SizeOfArray(aDDOs) - 1) to iCount
31434>>>>>        For i from 0 to iCount
31440>>>>>>
31440>>>>>            Set pDDDefaults of aDDOs[i].hValue to aEmptyRemembered
31441>>>>>        Loop
31442>>>>>>
31442>>>>>        
31442>>>>>        // Clear the main DDO structure
31442>>>>>        If (hoMainDD <> 0) Begin
31444>>>>>            Send Clear_All of hoMainDD
31445>>>>>        End
31445>>>>>>
31445>>>>>        
31445>>>>>        // Now clear the main dd of any 'additional' DDO structures
31445>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
31446>>>>>        Move (SizeOfArray(aAdditionalDDOStructures)) to iCount
31447>>>>>        
31447>>>>>        For i from 0 to (iCount - 1)
31453>>>>>>
31453>>>>>            If (aAdditionalDDOStructures[i] <> 0) Begin
31455>>>>>                Send Clear_All of aAdditionalDDOStructures[i]
31456>>>>>            End
31456>>>>>>
31456>>>>>        Loop
31457>>>>>>
31457>>>>>        
31457>>>>>        //  Rebuild constraints
31457>>>>>        Send RebuildDDConstraints
31458>>>>>        
31458>>>>>        //  Trigger resize event
31458>>>>>        Get pbServerOnResizeWindow to bOnResize
31459>>>>>        If (bOnResize) Begin
31461>>>>>            WebGet piWindowWidth of (Host(Self)) to iWidth
31462>>>>>            WebGet piWindowHeight of (Host(Self)) to iHeight
31463>>>>>            
31463>>>>>            Send OnResizeWindow iWidth iHeight
31464>>>>>        End
31464>>>>>>
31464>>>>>        
31464>>>>>        Set pbInitForShow to False
31465>>>>>    End_Procedure
31466>>>>>    
31466>>>>>    
31466>>>>>    //  Called always when the view is shown.
31466>>>>>    //  
31466>>>>>    Procedure DoShow
31468>>>>>        Boolean bOnShow
31468>>>>>        Integer eViewStyle
31468>>>>>        String sPrevHash sView sHashView
31468>>>>>        
31468>>>>>        //  Fire OnShow (optimization, used to be fired from JavaScript)
31468>>>>>        Send OnBeforeShow
31469>>>>>        
31469>>>>>        Get peWebViewStyle to eViewStyle
31470>>>>>        If (eViewStyle = wvsDesktop) Begin
31472>>>>>            
31472>>>>>            If (peStateMode(Self) <> vsmOff) Begin 
31474>>>>>                //  Replace state if the hash no location url
31474>>>>>                Get psStateViewName to sView
31475>>>>>                Get StateHash of (Host(Self)) to sPrevHash
31476>>>>>                Send ParseViewStateHash sPrevHash (&sHashView)
31477>>>>>                
31477>>>>>                If (Lowercase(sHashView) <> Lowercase(sView)) Begin
31479>>>>>                    Send UpdateStateHash ((Trim(sPrevHash) = "") or pbStateReplace(Self))            
31480>>>>>                End
31480>>>>>>
31480>>>>>            End
31480>>>>>>
31480>>>>>            Send UpdatePageTitle
31481>>>>>        End
31481>>>>>>
31481>>>>>        
31481>>>>>    End_Procedure
31482>>>>>    
31482>>>>>    
31482>>>>>    Procedure HandleFindKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
31484>>>>>        Handle hoFocus
31484>>>>>        
31484>>>>>        If (pbFindKeys(Self)) Begin
31486>>>>>            Get DEOControlFocusObject to hoFocus
31487>>>>>            If (hoFocus) Begin
31489>>>>>                Case Begin
31489>>>>>                    Case (iKey = 119)
31491>>>>>                        Send Request_Find of hoFocus  GT
31492>>>>>                        Case Break
31493>>>>>                    Case (iKey = 118)
31496>>>>>                        Send Request_Find of hoFocus  LT
31497>>>>>                        Case Break
31498>>>>>                    Case (iKey = 120)
31501>>>>>                        Send Request_Find of hoFocus  GE
31502>>>>>                        Case Break
31503>>>>>                    Case (iKey = 36 and bCtrl)
31506>>>>>                        Send Request_Find of hoFocus  FIRST_RECORD
31507>>>>>                        Case Break
31508>>>>>                    Case (iKey = 35 and bCtrl)
31511>>>>>                        Send Request_Find of hoFocus  LAST_RECORD
31512>>>>>                        Case Break
31513>>>>>                Case End
31513>>>>>                
31513>>>>>            End
31513>>>>>>
31513>>>>>        End
31513>>>>>>
31513>>>>>    End_Procedure
31514>>>>>    
31514>>>>>    Procedure HandleClearKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
31516>>>>>        Handle hoFocus
31516>>>>>        
31516>>>>>        If (pbClearKeys(Self) and iKey = 116) Begin 
31518>>>>>            Get DEOControlFocusObject to hoFocus
31519>>>>>            
31519>>>>>            If (hoFocus) Begin
31521>>>>>                If (bCtrl) Begin
31523>>>>>                    Send Request_Clear_All of hoFocus
31524>>>>>                End
31524>>>>>>
31524>>>>>                Else Begin
31525>>>>>                    Send Request_Clear of hoFocus
31526>>>>>                End
31526>>>>>>
31526>>>>>            End
31526>>>>>>
31526>>>>>        End
31526>>>>>>
31526>>>>>    End_Procedure
31527>>>>>    
31527>>>>>    Procedure HandleDeleteKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
31529>>>>>        Handle hoFocus
31529>>>>>        
31529>>>>>        If (pbDeleteKeys(Self) and iKey = 113 and bShift) Begin
31531>>>>>            Get DEOFocusObject to hoFocus
31532>>>>>            If hoFocus Begin
31534>>>>>                Send Request_Delete of hoFocus
31535>>>>>            End
31535>>>>>>
31535>>>>>        End
31535>>>>>>
31535>>>>>    End_Procedure
31536>>>>>    
31536>>>>>    Procedure HandleSaveKey Integer iKey Boolean bShift Boolean bAlt Boolean bCtrl
31538>>>>>        Handle hoFocus
31538>>>>>        
31538>>>>>        If (pbSaveKeys(Self) and iKey = 113 and not(bShift)) Begin
31540>>>>>            Get DEOFocusObject to hoFocus
31541>>>>>            If hoFocus Begin
31543>>>>>                Send Request_Save of hoFocus
31544>>>>>            End
31544>>>>>>
31544>>>>>        End
31544>>>>>>
31544>>>>>    End_Procedure
31545>>>>>    
31545>>>>>    
31545>>>>>    
31545>>>>>    Procedure DefaultKeyHandlers
31547>>>>>        If (pbFindKeys(Self)) Begin
31549>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 119 False False False   //  F8
31550>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 118 False False False   //  F7
31551>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 120 False False False   //  F9
31552>>>>>            
31552>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 36 False False True     //  Ctrl - home
31553>>>>>            Send AddKeyHandler (RefProc(HandleFindKey)) 35 False False True     //  Ctrl - end
31554>>>>>        End
31554>>>>>>
31554>>>>>        
31554>>>>>        If (pbClearKeys(Self)) Begin
31556>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False False  //  F5
31557>>>>>            Send AddKeyHandler (RefProc(HandleClearKey)) 116 False False True   //  Ctrl - F5
31558>>>>>        End
31558>>>>>>
31558>>>>>        
31558>>>>>        If (pbDeleteKeys(Self)) Begin
31560>>>>>            Send AddKeyHandler (RefProc(HandleDeleteKey)) 113 True False False  //  Shift - F2
31561>>>>>        End
31561>>>>>>
31561>>>>>        
31561>>>>>        If (pbSaveKeys(Self)) Begin
31563>>>>>            Send AddKeyHandler (RefProc(HandleSaveKey)) 113 False False False   //  F2
31564>>>>>        End
31564>>>>>>
31564>>>>>        
31564>>>>>    End_Procedure
31565>>>>>    
31565>>>>>    // Show an unhandled refind error for this DDO.
31565>>>>>    Procedure CannotRefindRecordUnhandledError Handle hoDDO
31567>>>>>        Integer iFile
31567>>>>>        String sExtMess sFile sView
31567>>>>>        Get WebObjectName to sView
31568>>>>>        Get Main_File of hoDDO to iFile
31569>>>>>        Get ErrorMessageTableName of hoDDO iFile to sFile
31570>>>>>        Move ("View:" * sView - "." * DD_FILE_TEXT * String(iFile) * "-" * sFile) to sExtMess
31571>>>>>        Error DFERR_REC_NOT_FOUND sExtMess
31572>>>>>>
31572>>>>>    End_Procedure
31573>>>>>
31573>>>>>    
31573>>>>>    // Sent when a NavigateForward fails. 
31573>>>>>    // By default call standard OnRefindRecordError and a NavigateCancel. This allows for customization
31573>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
31573>>>>>    Procedure OnNavigateForwardRefindError Handle hoDD Integer eReason
31575>>>>>        Send OnRefindRecordError hoDD reoNavigateForward eReason
31576>>>>>        // we will cancel this navigation forward
31576>>>>>        Send NavigateCancel
31577>>>>>    End_Procedure
31578>>>>>
31578>>>>>    // Sent when a Navigate Back fails. 
31578>>>>>    // By default call standard OnRefindRecordError. This allows for customization
31578>>>>>    // eReason can be retCannotRereadMain or retCannotRereadConstrainingParent
31578>>>>>    Procedure OnNavigateBackRefindError Handle hoDD Integer eReason
31580>>>>>        Send OnRefindRecordError hoDD reoNavigateBack eReason
31581>>>>>    End_Procedure
