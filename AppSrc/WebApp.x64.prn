12937>>>>>>>>>>>
12937>>>>>>>>>>>    // This procedure can be used to set the Item_Options of a field. This can
12937>>>>>>>>>>>    // be passed any number of arguments.
12937>>>>>>>>>>>    // Support the following special first parameters:
12937>>>>>>>>>>>    //      DD_CLEAR_FIELD_OPTIONS     - clear all following passed otpions
12937>>>>>>>>>>>    //      DD_CLEAR_ALL_FIELD_OPTIONS - clear all options
12937>>>>>>>>>>>    Procedure Set Field_Options Integer iField Integer iArg1 // plus unknown arguments
12939>>>>>>>>>>>        Integer iObj
12939>>>>>>>>>>>        Integer iOptions
12939>>>>>>>>>>>        Integer iOption
12939>>>>>>>>>>>        Integer iArg
12939>>>>>>>>>>>        Integer iClear
12939>>>>>>>>>>>        Integer iType
12939>>>>>>>>>>>        Move (Record_Buffer(Self)) to iObj
12940>>>>>>>>>>>        Get Item_Options of iObj iField to iOptions
12941>>>>>>>>>>>        //
12941>>>>>>>>>>>        For iArg from 2 to Num_Arguments
12947>>>>>>>>>>>>
12947>>>>>>>>>>>            Move iArg& to iOption // tricky way to parse passed arguments
12948>>>>>>>>>>>
12948>>>>>>>>>>>            If (iOption = DD_CLEAR_ALL_FIELD_OPTIONS) ;                Move 0 to iOptions
12951>>>>>>>>>>>            Else If (iOption = DD_CLEAR_FIELD_OPTIONS) ;                Move 1 to iClear
12955>>>>>>>>>>>            Else If not iClear ;                Move (iOptions ior iOption) to iOptions
12959>>>>>>>>>>>            Else ; // only unset bits already set! Note multiple bits can be passed                Move (iOptions - (iOptions iand iOption)) to iOptions
12961>>>>>>>>>>>        Loop
12962>>>>>>>>>>>>
12962>>>>>>>>>>>        //
12962>>>>>>>>>>>        //Get_Attribute DF_FIELD_TYPE of (Main_File(self)) iField to iType
12962>>>>>>>>>>>        //If (iType=DF_TEXT or iType=DF_BINARY) ;            // if text of binary
12962>>>>>>>>>>>        //    Move (iOptions iOR DD_DISPLAYONLY) to iOptions // make sure DO is set
12962>>>>>>>>>>>
12962>>>>>>>>>>>        Set Item_Options of iObj iField to iOptions
12963>>>>>>>>>>>    End_Procedure
12964>>>>>>>>>>>
12964>>>>>>>>>>>    // This function returns all the item_options which have been set for
12964>>>>>>>>>>>    // a field. The value from the Record_Buffer object will be binary or'ed
12964>>>>>>>>>>>    // with constand Default_Item_Options and the DD_AUTOCLEAR constants when
12964>>>>>>>>>>>    // the Autoclear_State of the field has been set.
12964>>>>>>>>>>>    // Keep in mind that Autoclear is *not* kept in the Item_Options
12964>>>>>>>>>>>    // property.
12964>>>>>>>>>>>    Function Field_Options Integer iField Returns Integer
12966>>>>>>>>>>>        Function_Return (Item_Options(Record_Buffer(Self), iField))
12967>>>>>>>>>>>    End_Function
12968>>>>>>>>>>>
12968>>>>>>>>>>>    Function Field_Option Integer iField Integer iOption Returns Integer
12970>>>>>>>>>>>        Integer iOptions
12970>>>>>>>>>>>        Integer iState
12970>>>>>>>>>>>        Get Item_Options of (Record_Buffer(Self)) iField to iOptions
12971>>>>>>>>>>>        // All bits must match for it to be True (e.g., displayonly requires noput & noenter)
12971>>>>>>>>>>>        Move ((iOptions iand iOption)=iOption) to iState
12972>>>>>>>>>>>        Function_Return iState
12973>>>>>>>>>>>    End_Function
12974>>>>>>>>>>>
12974>>>>>>>>>>>
12974>>>>>>>>>>>    Procedure Set Foreign_Field_Options Integer iField Integer iArg1 // Integer iOption
12976>>>>>>>>>>>        Integer iObj
12976>>>>>>>>>>>        Integer iOptions
12976>>>>>>>>>>>        Integer iOption
12976>>>>>>>>>>>        Integer iArg
12976>>>>>>>>>>>        Integer iClear
12976>>>>>>>>>>>
12976>>>>>>>>>>>
12976>>>>>>>>>>>        Move (Record_Buffer(Self)) to iObj
12977>>>>>>>>>>>        Get Aux_Value of iObj iField to iOptions
12978>>>>>>>>>>>        //
12978>>>>>>>>>>>        For iArg from 2 to Num_Arguments
12984>>>>>>>>>>>>
12984>>>>>>>>>>>            Move iArg& to iOption // tricky way to parse passed arguments
12985>>>>>>>>>>>            If (iOption = DD_CLEAR_ALL_FIELD_OPTIONS) ;                Move 0 to iOptions
12988>>>>>>>>>>>            Else If (iOption = DD_CLEAR_FIELD_OPTIONS) ;                Move 1 to iClear
12992>>>>>>>>>>>            Else If not iClear ;                Move (iOptions ior iOption) to iOptions
12996>>>>>>>>>>>            Else ; // only unset bits already set! Note multiple bits can be passed                Move (iOptions - (iOptions iand iOption)) to iOptions
12998>>>>>>>>>>>        Loop
12999>>>>>>>>>>>>
12999>>>>>>>>>>>        //
12999>>>>>>>>>>>        Set Aux_Value of iObj iField to iOptions
13000>>>>>>>>>>>    End_Procedure
