24316>>>>>>>>>>>    //
24316>>>>>>>>>>>    //  Looks up the web property type based on the object handle and the index and returns the right handler.
24316>>>>>>>>>>>    //
24316>>>>>>>>>>>    Function PropertyHandler Handle hoObject Integer eMode Returns Handle
24318>>>>>>>>>>>        Handle hoHandler hoNeighborhood
24318>>>>>>>>>>>        Handle[] aHandlers
24319>>>>>>>>>>>        
24319>>>>>>>>>>>        Move -1 to hoHandler
24320>>>>>>>>>>>        
24320>>>>>>>>>>>        If (eMode = wptClient) Begin
24322>>>>>>>>>>>            Get phoClientHandler to hoHandler    
24323>>>>>>>>>>>        End
24323>>>>>>>>>>>>
24323>>>>>>>>>>>        Else If (eMode = wptServerPage) Begin
24326>>>>>>>>>>>            Get phoServerHandler to hoHandler
24327>>>>>>>>>>>        End
24327>>>>>>>>>>>>
24327>>>>>>>>>>>        Else If (eMode = wptServerSession) Begin
24330>>>>>>>>>>>            //  The server properties with page lifetime are stored per neighborhood (per view..)
24330>>>>>>>>>>>            Get phoSessionHandler to hoHandler
24331>>>>>>>>>>>        End
24331>>>>>>>>>>>>
24331>>>>>>>>>>>        Else If (eMode = wptClientProtected) Begin
24334>>>>>>>>>>>            Get phoClientProtectedHandler to hoHandler
24335>>>>>>>>>>>        End
24335>>>>>>>>>>>>
24335>>>>>>>>>>>        
24335>>>>>>>>>>>        Function_Return hoHandler
24336>>>>>>>>>>>    End_Function
