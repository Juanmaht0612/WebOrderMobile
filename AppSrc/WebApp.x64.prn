33406>>>>>>>    // Parses a content-type header string and splits it into just the content-type (put into 
33406>>>>>>>    // sContenttype passed by reference) and returns an array of name value pairs that were in the 
33406>>>>>>>    // content-type string.
33406>>>>>>>    Function ParseContentType String ByRef sContentType Returns tNameValuePair[]
33408>>>>>>>        tNameValuePair[] aValues
33408>>>>>>>        tNameValuePair[] aValues
33409>>>>>>>        String[] aParts aPair
33411>>>>>>>        Integer iPart iVal
33411>>>>>>>        
33411>>>>>>>        Move (StrSplitToArray(sContentType, ";")) to aParts
33412>>>>>>>        If (SizeOfArray(aParts) > 0) Begin
33414>>>>>>>            Move aParts[0] to sContentType
33415>>>>>>>            
33415>>>>>>>            For iPart from 1 to (SizeOfArray(aParts) - 1)
33421>>>>>>>>
33421>>>>>>>                Move (StrSplitToArray(aParts[iPart], "=")) to aPair
33422>>>>>>>                If (SizeOfArray(aPair) > 1) Begin
33424>>>>>>>                    Move (Trim(Uppercase(aPair[0]))) to aValues[iVal].sName
33425>>>>>>>                    Move (Trim(aPair[1])) to aValues[iVal].sValue
33426>>>>>>>                End
33426>>>>>>>>
33426>>>>>>>            Loop
33427>>>>>>>>
33427>>>>>>>        End
33427>>>>>>>>
33427>>>>>>>        
33427>>>>>>>        Function_Return aValues
33428>>>>>>>    End_Function
