5159>>>>>    // low level notification that wm_mouseWheel was sent. Passes windows
5159>>>>>    // defined parameters. If you need to do something special, use OnMouseWheel
5159>>>>>    //
5159>>>>>    Procedure OnWmMouseWheel Integer wParam Integer lParam
5161>>>>>        Integer iWheelDelta iKeys iDelta iClicks
5161>>>>>        Move (low(abs(wParam))) to iKeys           // any keys down when pressed
5162>>>>>        Move (hi(abs(wParam))) to iDelta           // number of click units
5163>>>>>        If (wParam<0) ;            Move (-iDelta) to iDelta     // can be up or down
5166>>>>>        Get  piWheelDelta to iWheelDelta           // Current accumulated micro clicks
5167>>>>>        Move (iWheelDelta+iDelta) to iWheelDelta
5168>>>>>        // C_WHEELDATA is 120 as defined by MS as the delta to react to. Once click is usually 120
5168>>>>>        Move (iWheelDelta/C_WHEELDELTA) to iClicks // Number of clicks to react to
5169>>>>>        Set  piWheelDelta to (mod(iWheelDelta,C_WHEELDELTA)) // remainder unused microclicks
5170>>>>>        // If we have enough Clicks send OnMouseWheel
5170>>>>>        If (iClicks<>0) ;            Send OnMouseWheel iClicks iKeys
5173>>>>>    End_Procedure
5174>>>>>    
5174>>>>>    // By default just move up or down a line
5174>>>>>    //
5174>>>>>    Procedure OnMouseWheel Integer iClicks Integer iKey
5176>>>>>        Integer i iKeyValue
5176>>>>>        Move (If(iClicks>0,kUpArrow, kDownArrow)) to iKeyValue
5177>>>>>        Move (abs(iClicks)) to iClicks
5178>>>>>        For i from 1 to iClicks
5184>>>>>>
5184>>>>>            Send key iKeyValue
5185>>>>>        Loop
5186>>>>>>
5186>>>>>    End_Procedure
5187>>>>>End_Class
