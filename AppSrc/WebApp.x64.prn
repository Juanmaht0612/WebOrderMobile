22762>>>>>>>
22762>>>>>>>    // Server-Action
22762>>>>>>>    //
22762>>>>>>>    // Server action that is called by the JavaScript engine opun initialization. It makes sure 
22762>>>>>>>    // that the object definitions of the global object and the initial view (phoLoginView or 
22762>>>>>>>    // phoDefaultView) including its DDO state. Also makes sure that translations are sent to the 
22762>>>>>>>    // client.
22762>>>>>>>    //
22762>>>>>>>    // Params:
22762>>>>>>>    //  bLoadInitial     If true (or not passed) the default (or login) view is loaded immediately 
22762>>>>>>>    //          and sent to the client. If displayView is used on the client this will be false.
22762>>>>>>>    // Returns:
22762>>>>>>>    //      The name of the initial view or dialog.
22762>>>>>>>    Function LoadWebApp Boolean bLoadInitial Returns String
22764>>>>>>>        String[] asBrowserLanguages asParams
22766>>>>>>>        Integer eAppStyle iBrowserTimezoneOffset iWidth iHeight
22766>>>>>>>        Boolean bIsLoggedIn bAllowAccess bOverrideState bOnResize
22766>>>>>>>        Handle hoView hoDefaultView hjObjectDef hjTranslations
22766>>>>>>>        tWebNameValue[] aTranslations
22766>>>>>>>        tWebNameValue[] aTranslations
22767>>>>>>>        
22767>>>>>>>        //  Trigger event allowing application to initialize things based on the client locales
22767>>>>>>>        WebGet pasBrowserLanguages to asBrowserLanguages
22768>>>>>>>        WebGet piBrowserTimezoneOffset to iBrowserTimezoneOffset
22769>>>>>>>        
22769>>>>>>>        Send OnInitializeLocales (If(SizeOfArray(asBrowserLanguages) > 0, asBrowserLanguages[0], "")) iBrowserTimezoneOffset
22770>>>>>>>        
22770>>>>>>>        //  Load translations (mark as 'early' client action so it executes before anything else)
22770>>>>>>>        Get ClientTranslations to aTranslations
22771>>>>>>>        Get Create (RefClass(cJsonObject)) to hjTranslations
22772>>>>>>>        Send DataTypeToJson of hjTranslations aTranslations 
22773>>>>>>>        Send ClientActionEarly "initTranslations" asParams hjTranslations
22774>>>>>>>        Send Destroy of hjTranslations
22775>>>>>>>        
22775>>>>>>>        //  Trigger resize event
22775>>>>>>>        Get pbServerOnResizeWindow to bOnResize
22776>>>>>>>        If (bOnResize) Begin
22778>>>>>>>            WebGet piWindowWidth to iWidth
22779>>>>>>>            WebGet piWindowHeight to iHeight
22780>>>>>>>            
22780>>>>>>>            Send OnResizeWindow iWidth iHeight
22781>>>>>>>        End
22781>>>>>>>>
22781>>>>>>>        
22781>>>>>>>        //  Serialize Global Objects
22781>>>>>>>        Get SerializeObject to hjObjectDef
22782>>>>>>>        Send ClientActionEarly "createWebApp" asParams hjObjectDef 
22783>>>>>>>        Send Destroy of hjObjectDef
22784>>>>>>>        
22784>>>>>>>        WebSet pbIsLoaded to True
22785>>>>>>>        
22785>>>>>>>        If (bLoadInitial) Begin
22787>>>>>>>            Send Load_InitialView
22788>>>>>>>        End
22788>>>>>>>>
22788>>>>>>>         
22788>>>>>>>        Function_Return ""
22789>>>>>>>    End_Function
22790>>>>>>>    
22790>>>>>>>    //  Empty stub, called from loadWebApp, implemented in cWebViewHost_mixin
22790>>>>>>>    Procedure Load_InitialView
22792>>>>>>>        
22792>>>>>>>    End_Procedure
