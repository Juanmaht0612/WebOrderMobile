17742>>>>>>>>>>>>>    //  Perform version checking logic
17742>>>>>>>>>>>>>    Procedure Call_VersionCheck tWebCallContext ByRef cctx
17744>>>>>>>>>>>>>        String sClientVersion sServerVersion sReason
17744>>>>>>>>>>>>>        String[] aServer aClient
17746>>>>>>>>>>>>>        Integer iVersionBlock iClientV iServerV
17746>>>>>>>>>>>>>        Boolean bRes bTrapped
17746>>>>>>>>>>>>>        
17746>>>>>>>>>>>>>        Move True to bRes
17747>>>>>>>>>>>>>        Get psVersionID to sServerVersion
17748>>>>>>>>>>>>>        Get MemberValue of cctx.hoJsonRequest "v" to sClientVersion
17749>>>>>>>>>>>>>        
17749>>>>>>>>>>>>>        Move True to cctx.bSuccess
17750>>>>>>>>>>>>>        
17750>>>>>>>>>>>>>        If (sServerVersion <> sClientVersion) Begin
17752>>>>>>>>>>>>>            //  Parse into components
17752>>>>>>>>>>>>>            Get StrSplitToArray sClientVersion "." to aClient
17753>>>>>>>>>>>>>            If (SizeOfArray(aClient) <> 4) Begin
17755>>>>>>>>>>>>>                Move "Version check: Invalid client version string." to sReason
17756>>>>>>>>>>>>>                Move False to bRes
17757>>>>>>>>>>>>>            End
17757>>>>>>>>>>>>>>
17757>>>>>>>>>>>>>            
17757>>>>>>>>>>>>>            If (bRes) Begin
17759>>>>>>>>>>>>>                Get StrSplitToArray sServerVersion "." to aServer
17760>>>>>>>>>>>>>                If (SizeOfArray(aServer) <> 4) Begin
17762>>>>>>>>>>>>>                    Move "Version check: Invalid server version string." to sReason
17763>>>>>>>>>>>>>                    Move False to bRes
17764>>>>>>>>>>>>>                End
17764>>>>>>>>>>>>>>
17764>>>>>>>>>>>>>            End
17764>>>>>>>>>>>>>>
17764>>>>>>>>>>>>>            
17764>>>>>>>>>>>>>            If (bRes) Begin
17766>>>>>>>>>>>>>                //  Check individual pieces
17766>>>>>>>>>>>>>                Get IsTrapped of ghoWebErrorHandler 56 to bTrapped
17767>>>>>>>>>>>>>                If (bTrapped) ;                    Send IgnoreError of ghoWebErrorHandler 56 
17770>>>>>>>>>>>>>                
17770>>>>>>>>>>>>>                Move 0 to iVersionBlock
17771>>>>>>>>>>>>>                While (bRes and (iVersionBlock <= 3))
17775>>>>>>>>>>>>>                    Move (Convert(aClient[iVersionBlock], Integer)) to iClientV
17776>>>>>>>>>>>>>                    Move (Convert(aServer[iVersionBlock], Integer)) to iServerV
17777>>>>>>>>>>>>>                    If (iServerV > iClientV) Begin
17779>>>>>>>>>>>>>                        Move "The version check failed because the server is newer than the client. This could be a caching issue, try using CTRL-F5 to refresh the page." to sReason
17780>>>>>>>>>>>>>                        Move False to bRes
17781>>>>>>>>>>>>>                    End
17781>>>>>>>>>>>>>>
17781>>>>>>>>>>>>>                    Else If (iServerV < iClientV) Begin
17784>>>>>>>>>>>>>                        Move "The version check failed because the client is newer than the server." to sReason
17785>>>>>>>>>>>>>                        Move False to bRes
17786>>>>>>>>>>>>>                    End
17786>>>>>>>>>>>>>>
17786>>>>>>>>>>>>>                    Increment iVersionBlock
17787>>>>>>>>>>>>>                Loop
17788>>>>>>>>>>>>>>
17788>>>>>>>>>>>>>                
17788>>>>>>>>>>>>>                If (bTrapped) ;                    Send TrapError of ghoWebErrorHandler 56
17791>>>>>>>>>>>>>            End
17791>>>>>>>>>>>>>>
17791>>>>>>>>>>>>>            
17791>>>>>>>>>>>>>            //  Extend error message
17791>>>>>>>>>>>>>            If (not(bRes)) Begin
17793>>>>>>>>>>>>>                Move (sReason + C_NewLine + C_NewLine + SFormat("Client version: %1 %3Server version: %2", HtmlEncode(sClientVersion), sServerVersion, C_NewLine)) to sReason
17794>>>>>>>>>>>>>                Move True to cctx.bCancel
17795>>>>>>>>>>>>>                Move False to cctx.bSuccess
17796>>>>>>>>>>>>>                Move sReason to cctx.sFatalError
17797>>>>>>>>>>>>>                Move 500 to cctx.iFatalErrorCode
17798>>>>>>>>>>>>>                If (pbLogInvalidRequests(Self)) Begin
17800>>>>>>>>>>>>>                    Error DFERR_WEBAPP_BAD_REQUEST sReason //  Put the error in the log
17801>>>>>>>>>>>>>>
17801>>>>>>>>>>>>>                End
17801>>>>>>>>>>>>>>
17801>>>>>>>>>>>>>            End
17801>>>>>>>>>>>>>>
17801>>>>>>>>>>>>>        End
17801>>>>>>>>>>>>>>
17801>>>>>>>>>>>>>    End_Procedure
