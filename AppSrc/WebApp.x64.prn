30170>>>>>>>    // returns true if this would be a client sorted field. This is used by
30170>>>>>>>    // grid columns to determine a default setting.
30170>>>>>>>    Function ClientSortable Returns Boolean
30172>>>>>>>        Integer eDBGridType
30172>>>>>>>        Boolean bDataAware bScrollable
30172>>>>>>>        Get pbDataAware to bDataAware
30173>>>>>>>        Get peDbGridType to eDBGridType
30174>>>>>>>        Get pbScroll to bScrollable
30175>>>>>>>        // It can be client sortable as long as it is static
30175>>>>>>>        Function_Return (not(bDataAware) or eDBGridType<>gtAutomatic or not(bScrollable))
30176>>>>>>>    End_Function
30177>>>>>>>    
30177>>>>>>>    // find in DD using eFindMode adjusting for reverse ordering. Use the current index 
30177>>>>>>>    Function FindInDD Handle hoDD Integer eMode Returns Boolean
30179>>>>>>>        Integer iOrdering
30179>>>>>>>        Boolean bReverseOrdering
30179>>>>>>>
30179>>>>>>>        If (pbNotifyingExternalDD(Self)) Begin
30181>>>>>>>            Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
30182>>>>>>>>
30182>>>>>>>        End
30182>>>>>>>>
30182>>>>>>>
30182>>>>>>>        Get IndexOrder to iOrdering
30183>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
30184>>>>>>>        Get FindMode eMode bReverseOrdering to eMode
30185>>>>>>>        Send Find of hoDD eMode iOrdering    
30186>>>>>>>        Function_Return (Found)
30187>>>>>>>    End_Function
30188>>>>>>>    
30188>>>>>>>    // used by public FindFromTop and FindFromBottom
30188>>>>>>>    Procedure FindFromTB Boolean bFirst
30190>>>>>>>        Handle hoDD
30190>>>>>>>        Boolean bDataAware bFound
30190>>>>>>>        Get pbDataAware to bDataAware
30191>>>>>>>        If bDataAware Begin
30193>>>>>>>            Get Server to hoDD
30194>>>>>>>            Get FindInDD hoDD (If(bFirst,FIRST_RECORD, LAST_RECORD)) to bFound
30195>>>>>>>            If bFound Begin
30197>>>>>>>                Send UpdateCurrentRowID
30198>>>>>>>            End
30198>>>>>>>>
30198>>>>>>>            Else Begin
30199>>>>>>>                // If not found then the DD didn't change so we must clear the grid.
30199>>>>>>>                Send ClearGrid
30200>>>>>>>            End
30200>>>>>>>>
30200>>>>>>>        End
30200>>>>>>>>
30200>>>>>>>    End_Procedure
30201>>>>>>>    
30201>>>>>>>    // Server action
30201>>>>>>>    //
30201>>>>>>>    // Sent when the client navigates the focus from one row to another.
30201>>>>>>>    // sGoToRow - Indicates how to treat the second parameter:
30201>>>>>>>    //            "row"   - indicates that we are going to a specific row as specified in sToRowID
30201>>>>>>>    //            "first" - indicates that we are going to the first row in the data set. Ignore sToRowID.
30201>>>>>>>    //            "last"  - indicates that we are going to the last row in the data set. Ignore sToRowID.
30201>>>>>>>    //            "new"   - indicates that we are creating a new row. Ignore sToRowID.
30201>>>>>>>    // Returns  - True if the navigation is allowed, otherwise returns False.
30201>>>>>>>    Function ChangeCurrentRow String sGotoRow String sToRowID Returns Boolean 
30203>>>>>>>        Handle hoDD
30203>>>>>>>        Integer iMainFile
30203>>>>>>>        RowID riRowID
30203>>>>>>>        Boolean bReturn bOldGridAction bDataAware bSuccess
30203>>>>>>>        String sPreviousRowId
30203>>>>>>>        String[] aParams
30204>>>>>>>        
30204>>>>>>>        Get pbDataAware to bDataAware
30205>>>>>>>        WebGet psCurrentRowId to sPreviousRowId
30206>>>>>>>        
30206>>>>>>>        // Give grid a chance to do its row change logic via AllowChangeSelectedRow
30206>>>>>>>        Get AllowChangeSelectedRow sGotoRow sToRowID to bReturn
30207>>>>>>>
30207>>>>>>>        // load the new row
30207>>>>>>>        If (bReturn) Begin   
30209>>>>>>>            If (bDataAware) Begin
30211>>>>>>>                // data-aware
30211>>>>>>>                Get Server to hoDD
30212>>>>>>>                
30212>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
30213>>>>>>>                If (hoDD) Begin
30215>>>>>>>                    Move (Lowercase(sGotoRow)) to sGotoRow
30216>>>>>>>                    
30216>>>>>>>                    Case Begin
30216>>>>>>>                        Case (sGotoRow = "row")
30218>>>>>>>                            Set pbNotifyingExternalDD to True // indicate that we are simply in a client row change event.
30219>>>>>>>                            // Load the ToRowID's record into the DDO structure. This triggers a refresh to all
30219>>>>>>>                            // connected DDO's including cWebColumn objects
30219>>>>>>>                            Get Main_File of hoDD to iMainFile
30220>>>>>>>                            Move (DeserializeRowID(sToRowID)) to riRowID
30221>>>>>>>                            // load the "to" row into the DDO. Should indirectly set psCurrentRowId
30221>>>>>>>                            Get FindByRowIdEx of hoDD iMainFile riRowID to bSuccess
30222>>>>>>>                            // Handle errors
30222>>>>>>>                            If (not(bSuccess)) Begin
30224>>>>>>>                                Set pbNotifyingExternalDD to False
30225>>>>>>>                                Send HandleCacheError
30226>>>>>>>                            End
30226>>>>>>>>
30226>>>>>>>                            Case Break
30227>>>>>>>        
30227>>>>>>>                        Case (sGotoRow = "first")
30230>>>>>>>                        Case (sGotoRow = "last")
30233>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
30233>>>>>>>                            Set pbNotifyingExternalDD to False
30234>>>>>>>                            // With first and last, we do a dd Find, which should refresh the entire grid
30234>>>>>>>                            If (sGotoRow = "first") Begin
30236>>>>>>>                                Get FindInDD hoDD FIRST_RECORD to bSuccess
30237>>>>>>>                            End
30237>>>>>>>>
30237>>>>>>>                            Else Begin
30238>>>>>>>                                Get FindInDD hoDD LAST_RECORD to bSuccess
30239>>>>>>>                            End
30239>>>>>>>>
30239>>>>>>>
30239>>>>>>>                            //  If not found then the DD didn't cause a refresh so we do it manually here
30239>>>>>>>                            If (not(bSuccess)) Begin
30241>>>>>>>                                Send ClearGrid
30242>>>>>>>                            End
30242>>>>>>>>
30242>>>>>>>                            
30242>>>>>>>                            
30242>>>>>>>                            Case Break
30243>>>>>>>        
30243>>>>>>>                    Case End               
30243>>>>>>>                    Set pbNotifyingExternalDD to bOldGridAction
30244>>>>>>>                                    
30244>>>>>>>                End
30244>>>>>>>>
30244>>>>>>>                Else Begin
30245>>>>>>>                    Error DFERR_PROGRAM C_$WebGridDoesNotHaveDDOServer
30246>>>>>>>>
30246>>>>>>>                End
30246>>>>>>>>
30246>>>>>>>            End
30246>>>>>>>>
30246>>>>>>>            Else Begin
30247>>>>>>>                // non-data-aware: We simply load the row sent by the client into the DEOs (columns)
30247>>>>>>>                If (sGotoRow = "row") Begin
30249>>>>>>>                    Send FillFromActionData 
30250>>>>>>>                End
30250>>>>>>>>
30250>>>>>>>            End
30250>>>>>>>>
30250>>>>>>>            
30250>>>>>>>            //  Fire user event
30250>>>>>>>            Send OnChangeCurrentRow sPreviousRowId sToRowID
30251>>>>>>>        End
30251>>>>>>>>
30251>>>>>>>        
30251>>>>>>>        //  Send client action that processes the row change (this is done to preserve the order combined with list refreshes)
30251>>>>>>>        Move bReturn to aParams[0]
30252>>>>>>>        Send ClientAction "handleRowChange" aParams
30253>>>>>>>        
30253>>>>>>>        Function_Return bReturn
30254>>>>>>>    End_Function
30255>>>>>>>    
