3274>>>>>    // Register the tooltip with the tooltip control.
3274>>>>>    Procedure AddToolTip
3276>>>>>        Boolean bCenterToolTip
3276>>>>>        UInteger uFlags
3276>>>>>        Handle hToolWnd
3276>>>>>        Handle hoToolTip
3276>>>>>        WString sText
3276>>>>>        Pointer lpText lpToolInfo
3276>>>>>        tWinToolInfo ToolInfo
3276>>>>>        tWinToolInfo ToolInfo
3276>>>>>        
3276>>>>>        Get phoToolTipController to hoToolTip
3277>>>>>        If (hoToolTip = 0) ;            Procedure_Return
3280>>>>>        
3280>>>>>        Move (TTF_SUBCLASS ior TTF_IDISHWND) to uFlags
3281>>>>>        Get pbCenterToolTip to bCenterToolTip
3282>>>>>        If (bCenterToolTip) ;            Move (AddBitValueUInt(TTF_CENTERTIP, uFlags)) to uFlags
3285>>>>>        
3285>>>>>        Get psToolTip_private to sText
3286>>>>>        Move (Trim(sText)) to sText
3287>>>>>        
3287>>>>>        If (sText <> "" and hoToolTip <> 0) Begin
3289>>>>>            If (pbUseFormWindowHandle(Self)) ;                Get Form_Window_Handle to hToolWnd
3292>>>>>            Else ;                Get Window_Handle to hToolWnd
3294>>>>>            
3294>>>>>            
3294>>>>>            
3294>>>>>            Move (SizeOfType(tWinToolInfo)) to ToolInfo.cbSize
3295>>>>>            Move uFlags       to ToolInfo.uFlags
3296>>>>>            Move hToolWnd     to ToolInfo.hwnd
3297>>>>>            Move (Cast(hToolWnd,ULongptr)) to ToolInfo.uID
3298>>>>>            Move (AddressOf(sText))       to ToolInfo.lpszText
3299>>>>>            
3299>>>>>            Move (AddressOf(ToolInfo)) to lpToolInfo
3300>>>>>            
3300>>>>>            Send AddToolTip to hoToolTip lpToolInfo
3301>>>>>            Set phToolWnd to hToolWnd
3302>>>>>        End
3302>>>>>>
3302>>>>>    End_Procedure
3303>>>>>    
3303>>>>>    
3303>>>>>    // Remove the registered tooltip from the ToolTip control.
3303>>>>>    Procedure DeleteToolTip
3305>>>>>        Handle hToolWnd
3305>>>>>        Handle hoToolTip
3305>>>>>        Integer iRet
3305>>>>>        Pointer lpToolInfo
3305>>>>>        tWinToolInfo ToolInfo
3305>>>>>        tWinToolInfo ToolInfo
3305>>>>>        
3305>>>>>        Get phoToolTipController to hoToolTip
3306>>>>>        If (hoToolTip = 0) ;            Procedure_Return
3309>>>>>        Get phToolWnd to hToolWnd
3310>>>>>        
3310>>>>>        If (hToolWnd <> 0 and hoToolTip <> 0) Begin
3312>>>>>            Move (SizeOfType(tWinToolInfo)) to ToolInfo.cbSize
3313>>>>>            Move hToolWnd                to ToolInfo.hwnd
3314>>>>>            Move (Cast(hToolWnd,ULongptr)) to ToolInfo.uID
3315>>>>>            Move (AddressOf(ToolInfo))   to lpToolInfo
3316>>>>>            
3316>>>>>            // Remove the tool from the ToolTip control.
3316>>>>>            Send DeleteTooltip to hoToolTip lpToolInfo
3317>>>>>            Set phToolWnd to 0
3318>>>>>        End
3318>>>>>>
3318>>>>>    End_Procedure
3319>>>>>    
3319>>>>>    // Register the tooltip with the tooltip control.
3319>>>>>    Procedure UpdateToolTip
3321>>>>>        Boolean bCenterToolTip
3321>>>>>        UInteger uFlags
3321>>>>>        Handle hToolWnd
3321>>>>>        Handle hoToolTip
3321>>>>>        WString sText
3321>>>>>        Pointer lpText lpToolInfo
3321>>>>>        tWinToolInfo ToolInfo
3321>>>>>        tWinToolInfo ToolInfo
3321>>>>>                
3321>>>>>        Get phToolWnd to hToolWnd
3322>>>>>        
3322>>>>>        If (hToolWnd = 0) Begin
3324>>>>>            Error DFERR_PROGRAM "Assertion: UpdateToolTip called before AddToolTip"
3325>>>>>>
3325>>>>>        End
3325>>>>>>
3325>>>>>        
3325>>>>>        Get phoToolTipController to hoToolTip
3326>>>>>        If (hoToolTip = 0) ;            Procedure_Return
3329>>>>>        
3329>>>>>        Move (TTF_SUBCLASS ior TTF_IDISHWND) to uFlags
3330>>>>>        Get pbCenterToolTip to bCenterToolTip
3331>>>>>        If (bCenterToolTip) ;            Move (AddBitValueUInt(TTF_CENTERTIP, uFlags)) to uFlags
3334>>>>>        
3334>>>>>        Get psToolTip_private to sText
3335>>>>>        Move (Trim(sText)) to sText
3336>>>>>        
3336>>>>>        If (sText <> "" and hoToolTip <> 0) Begin
3338>>>>>            Move (SizeOfType(tWinToolInfo)) to ToolInfo.cbSize
3339>>>>>            Move uFlags                  to ToolInfo.uFlags
3340>>>>>            Move hToolWnd                to ToolInfo.hwnd
3341>>>>>            Move (Cast(hToolWnd,ULongptr)) to ToolInfo.uID
3342>>>>>            Move (AddressOf(sText))        to ToolInfo.lpszText
3343>>>>>            
3343>>>>>            Move (AddressOf(ToolInfo)) to lpToolInfo
3344>>>>>            
3344>>>>>            Send UpdateToolTip to hoToolTip lpToolInfo
3345>>>>>        End
3345>>>>>>
3345>>>>>    End_Procedure
3346>>>>>End_Class
