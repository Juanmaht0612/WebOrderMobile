20032>>>>>>>>>>>>>>>>>        
20032>>>>>>>>>>>>>>>>>        If (Num_Arguments > 4) Begin
20034>>>>>>>>>>>>>>>>>           Move eOptDfltBtn to eDflt
20035>>>>>>>>>>>>>>>>>        End
20035>>>>>>>>>>>>>>>>>>
20035>>>>>>>>>>>>>>>>>        Else Begin
20036>>>>>>>>>>>>>>>>>           Move 3 to eDflt //cmCancel to eDflt
20037>>>>>>>>>>>>>>>>>        End
20037>>>>>>>>>>>>>>>>>>
20037>>>>>>>>>>>>>>>>>    
20037>>>>>>>>>>>>>>>>>        Move "WebMsgBoxConfirm" to sCSSClass // assume this defines any images and other features for a yes/no dialog.    
20038>>>>>>>>>>>>>>>>>    
20038>>>>>>>>>>>>>>>>>        Send ShowMessageBox hoCallBack hmCallback sMessage sCaption sCSSClass eDflt ButtonTextArray
20039>>>>>>>>>>>>>>>>>    End_Procedure
20040>>>>>>>>>>>>>>>>>    
20040>>>>>>>>>>>>>>>>>    // Updates the title of the web page based on the provided string.
20040>>>>>>>>>>>>>>>>>    //
20040>>>>>>>>>>>>>>>>>    // Params:
20040>>>>>>>>>>>>>>>>>    //  sTitle  The new page title.
20040>>>>>>>>>>>>>>>>>    //
20040>>>>>>>>>>>>>>>>>    Procedure SetPageTitle String sTitle
20042>>>>>>>>>>>>>>>>>        String[] aParams
20043>>>>>>>>>>>>>>>>>        
20043>>>>>>>>>>>>>>>>>        Move sTitle to aParams[0]
20044>>>>>>>>>>>>>>>>>        
20044>>>>>>>>>>>>>>>>>        Send ClientAction "setPageTitle" aParams
20045>>>>>>>>>>>>>>>>>    End_Procedure
20046>>>>>>>>>>>>>>>>>    
20046>>>>>>>>>>>>>>>>>    //  Client Action: Shows the provided text on the console of JavaScript debuggers (like 
20046>>>>>>>>>>>>>>>>>    //  FireBug). This is a common debugging method in web applications comparable to Showln in 
20046>>>>>>>>>>>>>>>>>    //  windows. The "Server: " String is added before the text to identify server-side log lines 
20046>>>>>>>>>>>>>>>>>    //  on the client.
20046>>>>>>>>>>>>>>>>>    Procedure ClientLog String sText
20048>>>>>>>>>>>>>>>>>        String[] aParams
20049>>>>>>>>>>>>>>>>>        
20049>>>>>>>>>>>>>>>>>        Move ("Server: " * sText) to aParams[0]
20050>>>>>>>>>>>>>>>>>        
20050>>>>>>>>>>>>>>>>>        Send ClientAction "log" aParams
20051>>>>>>>>>>>>>>>>>    End_Procedure
20052>>>>>>>>>>>>>>>>>    
20052>>>>>>>>>>>>>>>>>    //  Client Action: Sends a forceResize which triggers a resize action after handling this call. 
20052>>>>>>>>>>>>>>>>>    //  Usually this should happen autmatically when needed but this method provides a way to force
20052>>>>>>>>>>>>>>>>>    //  it.
20052>>>>>>>>>>>>>>>>>    Procedure ClientResize
20054>>>>>>>>>>>>>>>>>        String[] aParams
20055>>>>>>>>>>>>>>>>>        
20055>>>>>>>>>>>>>>>>>        Send ClientAction "forceResize" aParams
20056>>>>>>>>>>>>>>>>>    End_Procedure
20057>>>>>>>>>>>>>>>>>    
20057>>>>>>>>>>>>>>>>>    // Pushes a new state item to the browser its history stack. Implemented as a client action 
20057>>>>>>>>>>>>>>>>>    // (see history.pushState JavaScript API).
20057>>>>>>>>>>>>>>>>>    //
20057>>>>>>>>>>>>>>>>>    // Params:
20057>>>>>>>>>>>>>>>>>    //      sUrl        URL for the new history item.
20057>>>>>>>>>>>>>>>>>    //      sTitle      Page title for the new history item.
20057>>>>>>>>>>>>>>>>>    //      stateData   Valuetree struct that is added as data to the history item. This allows 
20057>>>>>>>>>>>>>>>>>    //                  custom information to be added for usage on back navigation.
20057>>>>>>>>>>>>>>>>>    Procedure HistoryPushState String sUrl String sTitle  tWebValueTree stateData
20059>>>>>>>>>>>>>>>>>        String[] aParams
20060>>>>>>>>>>>>>>>>>        
20060>>>>>>>>>>>>>>>>>        Move sUrl to aParams[0]
20061>>>>>>>>>>>>>>>>>        If (num_arguments > 1) Begin
20063>>>>>>>>>>>>>>>>>            Move sTitle to aParams[1]
20064>>>>>>>>>>>>>>>>>        End
20064>>>>>>>>>>>>>>>>>>
20064>>>>>>>>>>>>>>>>>        If (num_arguments > 2) Begin
20066>>>>>>>>>>>>>>>>>            Send ClientAction "historyPushState" aParams stateData
20067>>>>>>>>>>>>>>>>>        End
20067>>>>>>>>>>>>>>>>>>
20067>>>>>>>>>>>>>>>>>        Else Begin
20068>>>>>>>>>>>>>>>>>            Send ClientAction "historyPushState" aParams 
20069>>>>>>>>>>>>>>>>>        End
20069>>>>>>>>>>>>>>>>>>
20069>>>>>>>>>>>>>>>>>    End_Procedure
20070>>>>>>>>>>>>>>>>>    
20070>>>>>>>>>>>>>>>>>    // Replaces the current item in the browser its history stack. Implemented as client action and
20070>>>>>>>>>>>>>>>>>    // maps to the history.replaceState JavaScript API.
20070>>>>>>>>>>>>>>>>>    //
20070>>>>>>>>>>>>>>>>>    // Params:
20070>>>>>>>>>>>>>>>>>    //      sUrl        URL for the new history item.
20070>>>>>>>>>>>>>>>>>    //      sTitle      Page title for the new history item.
20070>>>>>>>>>>>>>>>>>    //      stateData   Valuetree struct that is added as data to the history item. This allows 
20070>>>>>>>>>>>>>>>>>    //                  custom information to be added for usage on back navigation.
20070>>>>>>>>>>>>>>>>>    Procedure HistoryReplaceState String sUrl String sTitle  tWebValueTree stateData
20072>>>>>>>>>>>>>>>>>        String[] aParams
20073>>>>>>>>>>>>>>>>>        
20073>>>>>>>>>>>>>>>>>        Move sUrl to aParams[0]
20074>>>>>>>>>>>>>>>>>        If (num_arguments > 1) Begin
20076>>>>>>>>>>>>>>>>>            Move sTitle to aParams[1]
20077>>>>>>>>>>>>>>>>>        End
20077>>>>>>>>>>>>>>>>>>
20077>>>>>>>>>>>>>>>>>        If (num_arguments > 2) Begin
20079>>>>>>>>>>>>>>>>>            Send ClientAction "historyReplaceState" aParams stateData
20080>>>>>>>>>>>>>>>>>        End
20080>>>>>>>>>>>>>>>>>>
20080>>>>>>>>>>>>>>>>>        Else Begin
20081>>>>>>>>>>>>>>>>>            Send ClientAction "historyReplaceState" aParams 
20082>>>>>>>>>>>>>>>>>        End
20082>>>>>>>>>>>>>>>>>>
20082>>>>>>>>>>>>>>>>>    End_Procedure
20083>>>>>>>>>>>>>>>>>    
20083>>>>>>>>>>>>>>>>>    // Server-Action
20083>>>>>>>>>>>>>>>>>    //
20083>>>>>>>>>>>>>>>>>    // Triggered by the client when a history popstate event occurs. This is a browser back 
20083>>>>>>>>>>>>>>>>>    // navigation to an item that was added to the history stack using HistoryPushState. The 
20083>>>>>>>>>>>>>>>>>    // ptActionData contains the tWebValueTree struct with data passed to HistoryPushItem.
20083>>>>>>>>>>>>>>>>>    //
20083>>>>>>>>>>>>>>>>>    // Params:
20083>>>>>>>>>>>>>>>>>    //      sTitle      Page title for the history item.
20083>>>>>>>>>>>>>>>>>    //      sUrl        URL for the history item.
20083>>>>>>>>>>>>>>>>>    Procedure HistoryPopState String sTitle String sUrl
20085>>>>>>>>>>>>>>>>>        String sStateHash
20085>>>>>>>>>>>>>>>>>        tWebValueTree stateData
20085>>>>>>>>>>>>>>>>>        tWebValueTree stateData
20085>>>>>>>>>>>>>>>>>        
20085>>>>>>>>>>>>>>>>>        Get ptActionData to stateData
20086>>>>>>>>>>>>>>>>>        
20086>>>>>>>>>>>>>>>>>        //  Trigger public event
20086>>>>>>>>>>>>>>>>>        Send OnHistoryPopState sTitle sUrl stateData
20087>>>>>>>>>>>>>>>>>    End_Procedure
20088>>>>>>>>>>>>>>>>>    
20088>>>>>>>>>>>>>>>>>    // This event is called when the browser navigates back to a history item added using 
20088>>>>>>>>>>>>>>>>>    // HistoryPushState. This allows the application to respond to the back navigation. If 
20088>>>>>>>>>>>>>>>>>    // peApplicationStateMode is set to asmHistoryOnly or asmHistoryAndUrls then the framework will
20088>>>>>>>>>>>>>>>>>    // have restored the state before this event is triggered.
20088>>>>>>>>>>>>>>>>>    //
20088>>>>>>>>>>>>>>>>>    // Params:
20088>>>>>>>>>>>>>>>>>    //      sTitle      Page title of the history item.
20088>>>>>>>>>>>>>>>>>    //      sUrl        URL of the history item.
20088>>>>>>>>>>>>>>>>>    //      stateData   Custom state data passed to HistoryPushState or HistoryReplaceState.
20088>>>>>>>>>>>>>>>>>    Procedure OnHistoryPopState String sTitle String sUrl tWebValueTree stateData
20090>>>>>>>>>>>>>>>>>        
20090>>>>>>>>>>>>>>>>>    End_Procedure
20091>>>>>>>>>>>>>>>>>    
20091>>>>>>>>>>>>>>>>>    // Server-Action
20091>>>>>>>>>>>>>>>>>    //
20091>>>>>>>>>>>>>>>>>    // Called by the client when the location hash changes (hashchange browser event) and triggers
20091>>>>>>>>>>>>>>>>>    // a restorestate if needed and calls OnLocationHashChange.
20091>>>>>>>>>>>>>>>>>    // 
20091>>>>>>>>>>>>>>>>>    // Params:
20091>>>>>>>>>>>>>>>>>    //      sHash       New location hash.
20091>>>>>>>>>>>>>>>>>    Procedure LocationHashChange String sHash
20093>>>>>>>>>>>>>>>>>        Send OnLocationHashChange sHash
20094>>>>>>>>>>>>>>>>>    End_Procedure
20095>>>>>>>>>>>>>>>>>    
20095>>>>>>>>>>>>>>>>>    // Triggers when the location hash changes (#.. part of the URL). Only fires if the hash change
20095>>>>>>>>>>>>>>>>>    // is not caused by an pop state event, in that case OnHistoryPopState should be used.
20095>>>>>>>>>>>>>>>>>    //
20095>>>>>>>>>>>>>>>>>    // Params:
20095>>>>>>>>>>>>>>>>>    //      sHash   New location hash.
20095>>>>>>>>>>>>>>>>>    Procedure OnLocationHashChange String sHash
20097>>>>>>>>>>>>>>>>>    End_Procedure
20098>>>>>>>>>>>>>>>>>    
20098>>>>>>>>>>>>>>>>>    Procedure OnOrientationChange Integer iOrientation
20100>>>>>>>>>>>>>>>>>    End_Procedure
20101>>>>>>>>>>>>>>>>>    
20101>>>>>>>>>>>>>>>>>    // Event that is fired when the size of the browser window changes. This event can be used to 
20101>>>>>>>>>>>>>>>>>    // make the web application layout responsive to the browser size. It gets the new dimensions
20101>>>>>>>>>>>>>>>>>    // of the browser window passed as parameters.
20101>>>>>>>>>>>>>>>>>    //
20101>>>>>>>>>>>>>>>>>    // Params:
20101>>>>>>>>>>>>>>>>>    //  iWindowWidth    Width of the browser window in pixels.
20101>>>>>>>>>>>>>>>>>    //  iWindowHeight   Height of the browser window in pixels.
20101>>>>>>>>>>>>>>>>>    Procedure OnResizeWindow Integer iWindowWidth Integer iWindowHeight
20103>>>>>>>>>>>>>>>>>    End_Procedure
20104>>>>>>>>>>>>>>>>>    
20104>>>>>>>>>>>>>>>>>    // Event that is fired when the operating systems prefered theme changes.
20104>>>>>>>>>>>>>>>>>    // It gets the new prefered theme of the operating system as a string
20104>>>>>>>>>>>>>>>>>    //
20104>>>>>>>>>>>>>>>>>    // Params:
20104>>>>>>>>>>>>>>>>>    // peThemePreference    Name of the new prefered theme
20104>>>>>>>>>>>>>>>>>    Procedure OnSystemThemePreferenceChange Integer eSystemThemePreference
20106>>>>>>>>>>>>>>>>>    End_Procedure
20107>>>>>>>>>>>>>>>>>    
20107>>>>>>>>>>>>>>>>>    Procedure End_Construct_cWebHostAPI_mixin
20109>>>>>>>>>>>>>>>>>        WebPublishProcedure OnOrientationChange
20110>>>>>>>>>>>>>>>>>        WebPublishProcedure OnResizeWindow
20111>>>>>>>>>>>>>>>>>        WebPublishProcedure HistoryPopState
20112>>>>>>>>>>>>>>>>>        WebPublishProcedure LocationHashChange
20113>>>>>>>>>>>>>>>>>        WebPublishProcedure OnSystemThemePreferenceChange
20114>>>>>>>>>>>>>>>>>    End_Procedure
20115>>>>>>>>>>>>>>>>>End_Class
20116>>>>>>>>>>>>>>>
20116>>>>>>>>>>>>>>>Class cWebBaseUIObject_mixin is a mixin
20117>>>>>>>>>>>>>>>    Procedure Define_cWebBaseUIObject_mixin
20119>>>>>>>>>>>>>>>        // Published Properties
20119>>>>>>>>>>>>>>>        Property Boolean pbEnabled True          // If False, the control cannot get the focus.
20122>>>>>>>>>>>>>>>        Property Boolean pbRender True           // If False, the control's elements are removed from the HTML (see also pbVisible)
20125>>>>>>>>>>>>>>>        Property Boolean pbVisible True          // If False, the control's elements are hidden (but still present) (see also pbRender)
20128>>>>>>>>>>>>>>>        Property Integer piTabIndex 0            // Determines the control's position in the page tab order
20131>>>>>>>>>>>>>>>        Property String psBackgroundColor ""     // CSS Inline Style - Color of the control's background
20134>>>>>>>>>>>>>>>        Property String psCSSClass ""            // CSS Class
20137>>>>>>>>>>>>>>>        Property String psHtmlId ""              // HTML Element ID
20140>>>>>>>>>>>>>>>        Property String psTextColor ""           // CSS Inline Style - Color of control's text
20143>>>>>>>>>>>>>>>        
20143>>>>>>>>>>>>>>>        Property String psClientOnRender ""      // Can be set to a JavaScript Event Handler that will be triggered immediately after rendering the control.
20146>>>>>>>>>>>>>>>        
20146>>>>>>>>>>>>>>>        Property Boolean pbNoAccessibilityCheck False   //  Use this property to disable the accessibility check (to allow JavaScript to show/enable controls)
20147>>>>>>>>>>>>>>>        
20147>>>>>>>>>>>>>>>        Property Integer piAccessibilityCacheCall 0 //  giWebAccCacheCtx value indicating if cached value is valid
20148>>>>>>>>>>>>>>>        Property Integer piAccessibilityCache 0     //  Cached value of the accessibility number
20149>>>>>>>>>>>>>>>    End_Procedure
20150>>>>>>>>>>>>>>>    
20150>>>>>>>>>>>>>>>    Procedure OnCloseModalDialog Handle hoModalDialog
20152>>>>>>>>>>>>>>>    End_Procedure
20153>>>>>>>>>>>>>>>    
20153>>>>>>>>>>>>>>>    //  Gives the focus to the control. If the control can't take the focus nothing will happen. If 
20153>>>>>>>>>>>>>>>    //  sent to a container the focus will go to the first focusable control in that container.
20153>>>>>>>>>>>>>>>    Procedure Focus
20155>>>>>>>>>>>>>>>        Send ClientAction "svrFocus"        
20156>>>>>>>>>>>>>>>    End_Procedure
20157>>>>>>>>>>>>>>>
20157>>>>>>>>>>>>>>>    // Apply focus to object within this view but only do it with
20157>>>>>>>>>>>>>>>    // non mobile clients.
20157>>>>>>>>>>>>>>>    Procedure ConditionalFocus
20159>>>>>>>>>>>>>>>        Boolean bIsMobile
20159>>>>>>>>>>>>>>>        WebGet pbIsMobile of (Host(Self)) to bIsMobile
20160>>>>>>>>>>>>>>>        If not bIsMobile Begin
20162>>>>>>>>>>>>>>>            Send Focus
20163>>>>>>>>>>>>>>>        End
20163>>>>>>>>>>>>>>>>
20163>>>>>>>>>>>>>>>    End_Procedure
20164>>>>>>>>>>>>>>>    
20164>>>>>>>>>>>>>>>
20164>>>>>>>>>>>>>>>    
20164>>>>>>>>>>>>>>>    Procedure AddKeyHandler Handle hMsg Integer iKeyCode Boolean bShift Boolean bAlt Boolean bCtrl
20166>>>>>>>>>>>>>>>        String[] aParams
20167>>>>>>>>>>>>>>>        String sMsg
20167>>>>>>>>>>>>>>>        
20167>>>>>>>>>>>>>>>        Get WebMethodName hMsg to sMsg
20168>>>>>>>>>>>>>>>        
20168>>>>>>>>>>>>>>>        If (sMsg <> "") Begin
20170>>>>>>>>>>>>>>>            Move sMsg       to aParams[0]
20171>>>>>>>>>>>>>>>            Move iKeyCode   to aParams[1]
20172>>>>>>>>>>>>>>>            Move bShift     to aParams[2]
20173>>>>>>>>>>>>>>>            Move bAlt       to aParams[3]
20174>>>>>>>>>>>>>>>            Move bCtrl      to aParams[4]
20175>>>>>>>>>>>>>>>            
20175>>>>>>>>>>>>>>>            Send ClientAction "addKeyHandler" aParams
20176>>>>>>>>>>>>>>>        End
20176>>>>>>>>>>>>>>>>
20176>>>>>>>>>>>>>>>    End_Procedure
20177>>>>>>>>>>>>>>>    
20177>>>>>>>>>>>>>>>    Procedure RemoveKeyHandler Handle hMsg Integer iKeyCode Boolean bShift Boolean bAlt Boolean bCtrl
20179>>>>>>>>>>>>>>>        String[] aParams
20180>>>>>>>>>>>>>>>        String sMsg
20180>>>>>>>>>>>>>>>        
20180>>>>>>>>>>>>>>>        Get WebMethodName hMsg to sMsg
20181>>>>>>>>>>>>>>>        
20181>>>>>>>>>>>>>>>        If (sMsg <> "") Begin
20183>>>>>>>>>>>>>>>            Move sMsg       to aParams[0]
20184>>>>>>>>>>>>>>>            Move iKeyCode   to aParams[1]
20185>>>>>>>>>>>>>>>            Move bShift     to aParams[2]
20186>>>>>>>>>>>>>>>            Move bAlt       to aParams[3]
20187>>>>>>>>>>>>>>>            Move bCtrl      to aParams[4]
20188>>>>>>>>>>>>>>>            
20188>>>>>>>>>>>>>>>            Send ClientAction "removeKeyHandler" aParams
20189>>>>>>>>>>>>>>>        End
20189>>>>>>>>>>>>>>>>
20189>>>>>>>>>>>>>>>    End_Procedure
20190>>>>>>>>>>>>>>>    
20190>>>>>>>>>>>>>>>    
20190>>>>>>>>>>>>>>>    // Will attempt to scroll this UI object into the view. So parent containers will scroll if
20190>>>>>>>>>>>>>>>    // nessecary to make this element visible.
20190>>>>>>>>>>>>>>>    Procedure ScrollIntoView Boolean bAlignToTop
20192>>>>>>>>>>>>>>>        String[] aParams
20193>>>>>>>>>>>>>>>        
20193>>>>>>>>>>>>>>>        Move bAlignToTop to aParams[0]
20194>>>>>>>>>>>>>>>        
20194>>>>>>>>>>>>>>>        Send ClientAction "scrollIntoView" aParams
20195>>>>>>>>>>>>>>>    End_Procedure
20196>>>>>>>>>>>>>>>    
20196>>>>>>>>>>>>>>>    Procedure End_Construct_cWebBaseUIObject_mixin
20198>>>>>>>>>>>>>>>        WebPublishProcedure OnCloseModalDialog
20199>>>>>>>>>>>>>>>    End_Procedure
20200>>>>>>>>>>>>>>>End_Class
20201>>>>>>>>>>>>>
20201>>>>>>>>>>>>>// Base class for Ajax Web Objects that model some client-side user interface.
20201>>>>>>>>>>>>>//
20201>>>>>>>>>>>>>// Supports:
20201>>>>>>>>>>>>>// - Properties to control rendering, visible, enabled etc.
20201>>>>>>>>>>>>>// - HTML element support (#ID, Class, etc).
20201>>>>>>>>>>>>>// - Common CSS properties (color etc).
20201>>>>>>>>>>>>>// - Data binding to DDO server.
20201>>>>>>>>>>>>>Class cWebBaseUIObject is a cWebObject
20202>>>>>>>>>>>>>    
20202>>>>>>>>>>>>>    Procedure Construct_Object
20204>>>>>>>>>>>>>        Forward Send Construct_Object
20206>>>>>>>>>>>>>
20206>>>>>>>>>>>>>        Send Define_cWebBaseUIObject_mixin
20207>>>>>>>>>>>>>        Send DefineWebDragDropMixin
20208>>>>>>>>>>>>>    End_Procedure
20209>>>>>>>>>>>>>    
20209>>>>>>>>>>>>>    Import_Class_Protocol cWebDragDropMixin
20210>>>>>>>>>>>>>    Import_Class_Protocol cWebBaseUIObject_mixin
20211>>>>>>>>>>>>>    
20211>>>>>>>>>>>>>    //  Determines if a control is rendered (if pbRender is true of itself and its parents)
20211>>>>>>>>>>>>>    Function IsControlRendered Returns Boolean
20213>>>>>>>>>>>>>        Boolean bRendered
20213>>>>>>>>>>>>>        Handle hoParent
20213>>>>>>>>>>>>>        
20213>>>>>>>>>>>>>        WebGet pbRender to bRendered
20214>>>>>>>>>>>>>        
20214>>>>>>>>>>>>>        If (bRendered) Begin
20216>>>>>>>>>>>>>            Get Parent to hoParent
20217>>>>>>>>>>>>>            If (hoParent > 0) Begin
20219>>>>>>>>>>>>>                If (IsObjectOfClass(hoParent, RefClass(cWebBaseUIObject))) Begin
20221>>>>>>>>>>>>>                    Get IsControlRendered of hoParent to bRendered
20222>>>>>>>>>>>>>                End
20222>>>>>>>>>>>>>>
20222>>>>>>>>>>>>>            End
20222>>>>>>>>>>>>>>
20222>>>>>>>>>>>>>        End
20222>>>>>>>>>>>>>>
20222>>>>>>>>>>>>>        
20222>>>>>>>>>>>>>        Function_Return bRendered
20223>>>>>>>>>>>>>    End_Function
20224>>>>>>>>>>>>>    
20224>>>>>>>>>>>>>    //  Determines if a control is visible (if pbVisible is true of itself and its parents)
20224>>>>>>>>>>>>>    Function IsControlVisible Returns Boolean
20226>>>>>>>>>>>>>        Boolean bVisible
20226>>>>>>>>>>>>>        Handle hoParent
20226>>>>>>>>>>>>>        
20226>>>>>>>>>>>>>        WebGet pbVisible to bVisible
20227>>>>>>>>>>>>>        
20227>>>>>>>>>>>>>        If (bVisible) Begin
20229>>>>>>>>>>>>>            Get Parent to hoParent
20230>>>>>>>>>>>>>            If (hoParent > 0) Begin
20232>>>>>>>>>>>>>                If (IsObjectOfClass(hoParent, RefClass(cWebBaseUIObject))) Begin
20234>>>>>>>>>>>>>                    Get IsControlVisible of hoParent to bVisible
20235>>>>>>>>>>>>>                End
20235>>>>>>>>>>>>>>
20235>>>>>>>>>>>>>            End
20235>>>>>>>>>>>>>>
20235>>>>>>>>>>>>>        End
20235>>>>>>>>>>>>>>
20235>>>>>>>>>>>>>        
20235>>>>>>>>>>>>>        Function_Return bVisible
20236>>>>>>>>>>>>>    End_Function
20237>>>>>>>>>>>>>    
20237>>>>>>>>>>>>>    //  Determines if a control is enabled (if pbEnabled is true of itself and its parents)
20237>>>>>>>>>>>>>    Function IsControlEnabled Returns Boolean
20239>>>>>>>>>>>>>        Boolean bEnabled
20239>>>>>>>>>>>>>        Handle hoParent
20239>>>>>>>>>>>>>        
20239>>>>>>>>>>>>>        WebGet pbEnabled to bEnabled
20240>>>>>>>>>>>>>        
20240>>>>>>>>>>>>>        If (bEnabled) Begin
20242>>>>>>>>>>>>>            Get Parent to hoParent
20243>>>>>>>>>>>>>            If (hoParent > 0) Begin
20245>>>>>>>>>>>>>                If (IsObjectOfClass(hoParent, RefClass(cWebBaseUIObject))) Begin
20247>>>>>>>>>>>>>                    Get IsControlEnabled of hoParent to bEnabled
20248>>>>>>>>>>>>>                End
20248>>>>>>>>>>>>>>
20248>>>>>>>>>>>>>            End
20248>>>>>>>>>>>>>>
20248>>>>>>>>>>>>>        End
20248>>>>>>>>>>>>>>
20248>>>>>>>>>>>>>        
20248>>>>>>>>>>>>>        Function_Return bEnabled
20249>>>>>>>>>>>>>    End_Function
20250>>>>>>>>>>>>>
20250>>>>>>>>>>>>>    //  Augmented to invalidate the accessibility cache for the involved properties
20250>>>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject Handle hmSetter String sPropName Variant vPropValue
20252>>>>>>>>>>>>>        //  Invalidate accessibility cache
20252>>>>>>>>>>>>>        If (hmSetter = RefProcSet(pbRender) or hmSetter = RefProcSet(pbEnabled) or hmSetter = RefProcSet(pbVisible)) Begin
20254>>>>>>>>>>>>>            Increment giWebAccCacheCtx
20255>>>>>>>>>>>>>        End
20255>>>>>>>>>>>>>>
20255>>>>>>>>>>>>>        
20255>>>>>>>>>>>>>        Forward Send SetSyncProp hoObject hmSetter sPropName vPropValue
20257>>>>>>>>>>>>>    End_Procedure
20258>>>>>>>>>>>>>    
20258>>>>>>>>>>>>>    //  Determines if the control is currently accessible. Accessible means that it is a view that
20258>>>>>>>>>>>>>    //  is available on the client and it is rendered, visible and enabled. This check takes the 
20258>>>>>>>>>>>>>    //  state of parent controls into account, but not for example if the control is on the current 
20258>>>>>>>>>>>>>    //  tab page or if the group it is on is expanded.
20258>>>>>>>>>>>>>    //
20258>>>>>>>>>>>>>    //  This is used to check if a control should accept server messages and if DEO objects should 
20258>>>>>>>>>>>>>    //  communicate with DD's. Because it can be called a lot and the determination goes up in the 
20258>>>>>>>>>>>>>    //  object structure and involves server properties this value is cached.
20258>>>>>>>>>>>>>    Function IsControlAccessible Boolean bVerifyEnabled Boolean bVerifyVisibility Returns Boolean
20260>>>>>>>>>>>>>        Boolean bAccessible
20260>>>>>>>>>>>>>        Integer iAccessible
20260>>>>>>>>>>>>>        
20260>>>>>>>>>>>>>        Get GetAccessible to iAccessible
20261>>>>>>>>>>>>>        
20261>>>>>>>>>>>>>        Move (iAccessible iand C_UIA_InSync) to bAccessible
20262>>>>>>>>>>>>>        
20262>>>>>>>>>>>>>        If (bVerifyEnabled and bAccessible) Begin
20264>>>>>>>>>>>>>            Move (iAccessible iand C_UIA_Enabled) to bAccessible
20265>>>>>>>>>>>>>        End
20265>>>>>>>>>>>>>>
20265>>>>>>>>>>>>>        If (bVerifyVisibility and bAccessible) Begin
20267>>>>>>>>>>>>>            Move (iAccessible iand C_UIA_Rendered and iAccessible iand C_UIA_Visible) to bAccessible
20268>>>>>>>>>>>>>        End
20268>>>>>>>>>>>>>>
20268>>>>>>>>>>>>>        
20268>>>>>>>>>>>>>        Function_Return bAccessible
20269>>>>>>>>>>>>>    End_Function
20270>>>>>>>>>>>>>    
20270>>>>>>>>>>>>>    //  Determines th accessibility which is expressed folded into an integer and can be checked 
20270>>>>>>>>>>>>>    //  using IAND.
20270>>>>>>>>>>>>>    Function GetAccessible Returns Integer
20272>>>>>>>>>>>>>        Integer iAccessible iAccessibleParent
20272>>>>>>>>>>>>>        Boolean bVal
20272>>>>>>>>>>>>>        
20272>>>>>>>>>>>>>        If (piAccessibilityCacheCall(Self) <> giWebAccCacheCtx) Begin
20274>>>>>>>>>>>>>            Move C_UIA_InSync to iAccessible
20275>>>>>>>>>>>>>            
20275>>>>>>>>>>>>>            If (pbNoAccessibilityCheck(Self)) Begin
20277>>>>>>>>>>>>>               Move C_UIA_All to iAccessible
20278>>>>>>>>>>>>>            End
20278>>>>>>>>>>>>>>
20278>>>>>>>>>>>>>            Else Begin
20279>>>>>>>>>>>>>                WebGet pbRender to bVal
20280>>>>>>>>>>>>>                If (bVal) ;                    Move (iAccessible + C_UIA_Rendered) to iAccessible
20283>>>>>>>>>>>>>                
20283>>>>>>>>>>>>>                WebGet pbVisible to bVal
20284>>>>>>>>>>>>>                If (bVal) ;                    Move (iAccessible + C_UIA_Visible) to iAccessible
20287>>>>>>>>>>>>>                
20287>>>>>>>>>>>>>                WebGet pbEnabled to bVal
20288>>>>>>>>>>>>>                If (bVal) ;                    Move (iAccessible + C_UIA_Enabled) to iAccessible
20291>>>>>>>>>>>>>            End
20291>>>>>>>>>>>>>>
20291>>>>>>>>>>>>>            
20291>>>>>>>>>>>>>            Delegate Get GetAccessible to iAccessibleParent
20293>>>>>>>>>>>>>            Move (iAccessibleParent iand iAccessible) to iAccessible
20294>>>>>>>>>>>>>            
20294>>>>>>>>>>>>>            Set piAccessibilityCache to iAccessible
20295>>>>>>>>>>>>>            Set piAccessibilityCacheCall to giWebAccCacheCtx
20296>>>>>>>>>>>>>        End
20296>>>>>>>>>>>>>>
20296>>>>>>>>>>>>>        Else Begin
20297>>>>>>>>>>>>>            Get piAccessibilityCache to iAccessible
20298>>>>>>>>>>>>>        End
20298>>>>>>>>>>>>>>
20298>>>>>>>>>>>>>        
20298>>>>>>>>>>>>>
20298>>>>>>>>>>>>>        
20298>>>>>>>>>>>>>        Function_Return iAccessible
20299>>>>>>>>>>>>>    End_Function
20300>>>>>>>>>>>>>    
20300>>>>>>>>>>>>>    //  By default UI objects are only accessible if they are visible and enabled.
20300>>>>>>>>>>>>>    Procedure AllowServerAction Boolean ByRef bAllow String sMethodName Handle hoMessage Boolean bIsFunction String[] ByRef aParams
20302>>>>>>>>>>>>>        Get IsControlAccessible True True to bAllow
20303>>>>>>>>>>>>>    End_Procedure
20304>>>>>>>>>>>>>    
20304>>>>>>>>>>>>>    // We don't support dragging by default, so just return a blank String
20304>>>>>>>>>>>>>    Function DragData Returns Variant
20306>>>>>>>>>>>>>        Function_Return ""
20307>>>>>>>>>>>>>    End_Function
20308>>>>>>>>>>>>>    
20308>>>>>>>>>>>>>    Function DropData Returns Variant
20310>>>>>>>>>>>>>        tWebControlDropData DropData
20310>>>>>>>>>>>>>        tWebControlDropData DropData
20310>>>>>>>>>>>>>        Handle hoJsonData
20310>>>>>>>>>>>>>        
20310>>>>>>>>>>>>>        Get phoJsonDropData to hoJsonData
20311>>>>>>>>>>>>>        If (hoJsonData <> C_WebUnresolvedObject and IsOfJsonType(hoJsonData, jsonTypeObject)) Begin
20313>>>>>>>>>>>>>            Set pbRequireAllMembers of hoJsonData to False
20314>>>>>>>>>>>>>            Get JsonToDataType of hoJsonData to DropData
20315>>>>>>>>>>>>>        End
20315>>>>>>>>>>>>>>
20315>>>>>>>>>>>>>        
20315>>>>>>>>>>>>>        Function_Return DropData
20316>>>>>>>>>>>>>    End_Function
20317>>>>>>>>>>>>>    
20317>>>>>>>>>>>>>    // By default, we only want to support dropping, so we always return false here
20317>>>>>>>>>>>>>    Function SupportsDragAction Integer eAction Returns Boolean
20319>>>>>>>>>>>>>        Function_Return False
20320>>>>>>>>>>>>>    End_Function
20321>>>>>>>>>>>>>    
20321>>>>>>>>>>>>>    Function SupportsDropAction Integer eAction Returns Boolean
20323>>>>>>>>>>>>>        If (eAction = C_WebDropOnControl) Begin
20325>>>>>>>>>>>>>            Function_Return True
20326>>>>>>>>>>>>>        End
20326>>>>>>>>>>>>>>
20326>>>>>>>>>>>>>        
20326>>>>>>>>>>>>>        Function_Return False
20327>>>>>>>>>>>>>    End_Function
20328>>>>>>>>>>>>>    
20328>>>>>>>>>>>>>    Procedure End_Construct_Object
20330>>>>>>>>>>>>>        Send End_Construct_cWebBaseUIObject_mixin
20331>>>>>>>>>>>>>        Forward Send End_Construct_Object
20333>>>>>>>>>>>>>    End_Procedure
20334>>>>>>>>>>>>>End_Class
