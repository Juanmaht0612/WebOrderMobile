34790>>>>>    Procedure Call_PreValidateSession tWebCallContext ByRef cctx
34792>>>>>        Boolean bSetCookie bLoadWebApp bValidSession
34792>>>>>        String sSessionKey sRemoteAddress
34792>>>>>        Handle hoSessionManager
34792>>>>>        
34792>>>>>        Get IsLoadWebAppCall (&cctx) to bLoadWebApp
34793>>>>>        
34793>>>>>        Move bLoadWebApp to bSetCookie
34794>>>>>        
34794>>>>>        //  Read the session key
34794>>>>>        Get ReadSessionKey to sSessionKey
34795>>>>>        
34795>>>>>        // Get the handle here so we do not have to call the function multiple times
34795>>>>>        Get SessionManager to hoSessionManager
34796>>>>>        
34796>>>>>        //  Create new session if no session key is sent
34796>>>>>        If (Trim(sSessionKey) = "" and bLoadWebApp) Begin
34798>>>>>            Get ServerVariable of (ServiceDispatcher(Self)) "REMOTE_ADDR" to sRemoteAddress
34799>>>>>            Get CreateSession of hoSessionManager sRemoteAddress to sSessionKey
34800>>>>>            Move True to bSetCookie
34801>>>>>        End
34801>>>>>>
34801>>>>>
34801>>>>>        //  Validate session
34801>>>>>        Get ValidateSession of hoSessionManager sSessionKey bLoadWebApp to bValidSession
34802>>>>>        Get psSessionKey of hoSessionManager to sSessionKey //  The session key might have changed during validaiton
34803>>>>>        If (bValidSession) Begin
34805>>>>>
34805>>>>>            //  Write the cookie if session is created or on initial call
34805>>>>>            If (bSetCookie) Begin
34807>>>>>                Send StoreSessionKey sSessionKey
34808>>>>>                Move True to cctx.bNotifyChangeRights
34809>>>>>            End
34809>>>>>>
34809>>>>>        End
34809>>>>>>
34809>>>>>        Else Begin
34810>>>>>            //  Clear the vaulty session cookie
34810>>>>>            Send StoreSessionKey ""
34811>>>>>            Move False to cctx.bSuccess
34812>>>>>        End
34812>>>>>>
34812>>>>>    End_Procedure
34813>>>>>    
34813>>>>>    Procedure Call_PreNotifyChangeRights tWebCallContext ByRef cctx
34815>>>>>        If (cctx.bNotifyChangeRights) ;            Send NotifyChangeRights to (SessionManager(Self))
34818>>>>>    End_Procedure
34819>>>>>    
34819>>>>>    // Adds a new client object to the set of listeners to NotifyChangeRights.
34819>>>>>    // This is only supported for object in the global scope, i.e. not supported
34819>>>>>    // for menus/toolbars declared inside a view.
34819>>>>>    // See also OnChangeRights.
34819>>>>>    Procedure AddChangeRightsClient Handle hoClient
34821>>>>>        Integer iPos
34821>>>>>        Handle[] aClients
34822>>>>>        
34822>>>>>        Get paChangeRightsClients to aClients
34823>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
34824>>>>>        
34824>>>>>        If (iPos = -1) Begin
34826>>>>>            Move (InsertInArray(aClients, BinarySearchInsertPos(), hoClient)) to aClients
34827>>>>>            Set paChangeRightsClients to aClients
34828>>>>>        End
34828>>>>>>
34828>>>>>    End_Procedure
34829>>>>>    
34829>>>>>    // Removes a new client object from the set of listeners to NotifyChangeRights.
34829>>>>>    Procedure RemoveChangeRightsClient Handle hoClient
34831>>>>>        Integer iPos
34831>>>>>        Handle[] aClients
34832>>>>>        
34832>>>>>        Get paChangeRightsClients to aClients
34833>>>>>        Move (BinarySearchArray(hoClient, aClients, False)) to iPos
34834>>>>>        
34834>>>>>        If (iPos <> -1) Begin
34836>>>>>            Move (RemoveFromArray(aClients, iPos)) to aClients
34837>>>>>            Set paChangeRightsClients to aClients
34838>>>>>        End
34838>>>>>>
34838>>>>>    End_Procedure
