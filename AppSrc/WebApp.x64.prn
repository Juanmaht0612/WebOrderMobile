18178>>>>>>>>>    // Returns the owner of the object which is the host (cWebApp/cLocalWebControlHost) or the cWebDynamicObjectContainer.
18178>>>>>>>>>    Function Owner Returns Handle
18180>>>>>>>>>        Handle hoOwner
18180>>>>>>>>>
18180>>>>>>>>>        Get phoOwner to hoOwner
18181>>>>>>>>>        
18181>>>>>>>>>        If (hoOwner = C_WebUnresolvedObject) Begin
18183>>>>>>>>>            Delegate Get FindOwner to hoOwner
18185>>>>>>>>>
18185>>>>>>>>>            If (hoOwner = C_WebUnresolvedObject) ;                Error DFERR_PROGRAM "WebObject without owner"
18188>>>>>>>>>            
18188>>>>>>>>>            Set phoOwner to hoOwner
18189>>>>>>>>>        End
18189>>>>>>>>>>
18189>>>>>>>>>        
18189>>>>>>>>>        Function_Return hoOwner
18190>>>>>>>>>    End_Function
18191>>>>>>>>>    
18191>>>>>>>>>    // Uses delegation to find the owner object.
18191>>>>>>>>>    Function FindOwner Returns Handle
18193>>>>>>>>>        Handle hoOwner
18193>>>>>>>>>
18193>>>>>>>>>        Get phoOwner to hoOwner
18194>>>>>>>>>        
18194>>>>>>>>>        If (hoOwner = C_WebUnresolvedObject) Begin
18196>>>>>>>>>            Delegate Get FindOwner to hoOwner
18198>>>>>>>>>        End
18198>>>>>>>>>>
18198>>>>>>>>>        
18198>>>>>>>>>        Function_Return hoOwner
18199>>>>>>>>>    End_Function
18200>>>>>>>>>    
