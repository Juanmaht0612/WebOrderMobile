12219>>>>>>>>>>>
12219>>>>>>>>>>>Class DataDictionary is a DataSet
12220>>>>>>>>>>>
12220>>>>>>>>>>>    Procedure Construct_Object
12222>>>>>>>>>>>        Forward Send Construct_Object
12224>>>>>>>>>>>
12224>>>>>>>>>>>        Property String  Existing_Key_Value                           ""
12225>>>>>>>>>>>        Property Integer Protect_Key_State                            True
12226>>>>>>>>>>>
12226>>>>>>>>>>>        Property String  Key_Fields                                   ""
12227>>>>>>>>>>>
12227>>>>>>>>>>>        // These are added to support the checking of DSO connections
12227>>>>>>>>>>>        // during deletes and saves. Only the first two properties are Public
12227>>>>>>>>>>>        Property Integer Validate_Save_Structure_Mode   DD_Validate_Structure_Once
12228>>>>>>>>>>>        Property Integer Validate_Delete_Structure_Mode DD_Validate_Structure_Once
12229>>>>>>>>>>>        Property Integer Save_Structure_Validated_State              False
12230>>>>>>>>>>>        Property Integer Cascade_Delete_Structure_Validated_State    False
12231>>>>>>>>>>>        Property Integer No_Cascade_Delete_Structure_Validated_State False
12232>>>>>>>>>>>
12232>>>>>>>>>>>        Property Integer Last_Mark_Sequence_Id                       0
12233>>>>>>>>>>>
12233>>>>>>>>>>>        // These are added for optimized traversal of
12233>>>>>>>>>>>        // entry-update and validation and maybe more
12233>>>>>>>>>>>        Property String  Visited_Fields          ""
12234>>>>>>>>>>>        Property Integer Visited_State           False
12235>>>>>>>>>>>        // means will be part of a downward delete (cascade deletable). This only has meaning
12235>>>>>>>>>>>        // when cascade_delete_state is True
12235>>>>>>>>>>>        Property Boolean DownDelete_State        False
12236>>>>>>>>>>>
12236>>>>>>>>>>>        // these are set by the define_auto_increment, which is obsolete and has been replaced
12236>>>>>>>>>>>        // the Set Field_auto_increment method.
12236>>>>>>>>>>>        Property Integer Auto_Increment_Source_File  0
12237>>>>>>>>>>>        Property Integer Auto_Increment_Source_Field 0
12238>>>>>>>>>>>        Property Integer Auto_Increment_Dest_Field   0
12239>>>>>>>>>>>
12239>>>>>>>>>>>        // used by the set Field_auto_increment method
12239>>>>>>>>>>>        // these are split into two arrays to make searching for the field easier
12239>>>>>>>>>>>        // the arrays should always be synched.
12239>>>>>>>>>>>        Property Integer[] pAutoIncrementFields
12240>>>>>>>>>>>        Property tDDFileField[] pAutoIncrementSysFileFields
12241>>>>>>>>>>>
12241>>>>>>>>>>>        // Error Reporting Related
12241>>>>>>>>>>>        // If DD_Error_No_Report errors would be supressed (only ERR gets set)
12241>>>>>>>>>>>        Property Integer Error_Report_Mode           DD_Error_Report
12242>>>>>>>>>>>
12242>>>>>>>>>>>        // During validation, this is the field being validated.
12242>>>>>>>>>>>        Property Integer Current_Validate_Field      0
12243>>>>>>>>>>>
12243>>>>>>>>>>>        // when errors are redirected locally this maintains the original handler.
12243>>>>>>>>>>>        Property Integer Old_Error_Object_Id         0
12244>>>>>>>>>>>
12244>>>>>>>>>>>        // Must be provided if local error handler is to be created
12244>>>>>>>>>>>        Property Integer Error_Processing_State      0
12245>>>>>>>>>>>
12245>>>>>>>>>>>        // These should be changed most carefully and possible only and the
12245>>>>>>>>>>>        // DSO level. These allow you to defeat full field validation which
12245>>>>>>>>>>>        // makes it easier to corrupt data! Validate_DEO_Only_State limits
12245>>>>>>>>>>>        // save validation to DEOs (which is what data-sets have always done).
12245>>>>>>>>>>>        // Validate_foreign_File_State will skip validation under the following
12245>>>>>>>>>>>        // conditions: 1) DSO if for a parent (it did not originate the save).
12245>>>>>>>>>>>        //
12245>>>>>>>>>>>        Property Integer Validate_DEOs_Only_State    False
12246>>>>>>>>>>>        Property Integer Validate_Foreign_File_State True
12247>>>>>>>>>>>        // if set true, a field validation requested started with this
12247>>>>>>>>>>>        // DD will check all fields, even in an error is encountered
12247>>>>>>>>>>>        Property Integer Validate_All_Fields_State   False
12248>>>>>>>>>>>
12248>>>>>>>>>>>        // If true, all entry updates will occur through the DD. Else
12248>>>>>>>>>>>        // saves occur through the DD and find occur through the DEOs
12248>>>>>>>>>>>        Property Integer EntryUpdateLocalState True // changed from false to true in 17.0
12249>>>>>>>>>>>
12249>>>>>>>>>>>        // can be used by Refind_records method (remote refind of recs). Obsolete. Use prFindRowId
12249>>>>>>>>>>>        Property Integer Find_Record_Id 0
12250>>>>>>>>>>>
12250>>>>>>>>>>>        // can be used by Refind_records method (remote refind of recs)
12250>>>>>>>>>>>        Property RowID prFindRowId (NullRowId())
12251>>>>>>>>>>>        // can be used by Refind_records method (remote refind of recs)
12251>>>>>>>>>>>        Property tDDChangedInfo pDDChangedInfo
12252>>>>>>>>>>>
12252>>>>>>>>>>>        // Private: Id of field_objects container. This is not created until needed
12252>>>>>>>>>>>        Property Integer Field_Objects 0
12253>>>>>>>>>>>
12253>>>>>>>>>>>        // Public: If set the DDO will never be foreign, allowing
12253>>>>>>>>>>>        // you to create new parents when a child is saved. This would
12253>>>>>>>>>>>        // normally only be set within the DDO and not the class. This would be
12253>>>>>>>>>>>        // used where a child table wants to save the parent (header) when the
12253>>>>>>>>>>>        // first child is saved. It would disable the foreign key and index
12253>>>>>>>>>>>        // find_Req and required settings (as well as any displayonly).
12253>>>>>>>>>>>        Property Integer Allow_Foreign_New_Save_State False
12254>>>>>>>>>>>
12254>>>>>>>>>>>        Set pbDDAttach to True // set false to get (very) old attach_main_file_behavior
12255>>>>>>>>>>>        Set pbSmartRelate to True // Only relate if parent is attached via a DDO
12256>>>>>>>>>>>
12256>>>>>>>>>>>        // If this is an alias file, this is the master file it is based on
12256>>>>>>>>>>>        Property Handle piMasterTable 0
12257>>>>>>>>>>>
12257>>>>>>>>>>>        Property tDDServerInformation[] pServerInformation
12258>>>>>>>>>>>
12258>>>>>>>>>>>        Property tDDRemembered[] pDDDefaults
12259>>>>>>>>>>>
12259>>>>>>>>>>>        Property Boolean pbInSuperFind False
12260>>>>>>>>>>>
12260>>>>>>>>>>>        // Create the local buffer.
12260>>>>>>>>>>>        Object Record_Buffer is a cRecordBuffer
12262>>>>>>>>>>>        End_Object
12263>>>>>>>>>>>
12263>>>>>>>>>>>        // Create the extended field attributes array.
12263>>>>>>>>>>>        Object Field_Attributes is a Field_Attributes
12265>>>>>>>>>>>        End_Object
12266>>>>>>>>>>>
12266>>>>>>>>>>>        // Create an array to maintain Status help values for each field
12266>>>>>>>>>>>        Object Statushelp_Array is an array
12268>>>>>>>>>>>        End_Object
12269>>>>>>>>>>>
12269>>>>>>>>>>>        Object FieldMask_Array is an Field_Mask_array
12271>>>>>>>>>>>        End_Object
12272>>>>>>>>>>>
12272>>>>>>>>>>>
12272>>>>>>>>>>>        // keep track of all system/unknown files that must be set to
12272>>>>>>>>>>>        // default for smart file mode to work right.
12272>>>>>>>>>>>        Object System_File_obj is an Array
12274>>>>>>>>>>>        End_Object
12275>>>>>>>>>>>
12275>>>>>>>>>>>        // used during Request_Validate
12275>>>>>>>>>>>        Property Handle[] pDDsWithFindReqErrors
12276>>>>>>>>>>>
12276>>>>>>>>>>>        // Apply SQL filters in constrained finds
12276>>>>>>>>>>>        Property Boolean pbUseDDSQLFilters False
12277>>>>>>>>>>>        // If pbUseDDSQLFilters is true, this determines if the table global filter should be applied as well
12277>>>>>>>>>>>        Property Boolean pbApplyGlobalSQLFilters False
12278>>>>>>>>>>>        // Filter which will get applied before each DDO constrained find. If "", no filter is applied
12278>>>>>>>>>>>        Property String psSQLFilter ""
12279>>>>>>>>>>>
12279>>>>>>>>>>>        // Old values for SQL Filters which are pushed and popped by StoreSQLDefaultFilters and RestoreSQLDefaultFilters
12279>>>>>>>>>>>        Property String psOldFilter ""
12280>>>>>>>>>>>        Property Boolean pbOldFilterActive
12281>>>>>>>>>>>        Property Boolean pbOldFilterEq
12282>>>>>>>>>>>
12282>>>>>>>>>>>        // used to point to the composite child object that provides the SQL
12282>>>>>>>>>>>        // interfaces for a driver. This can be used with DAW drivers. Other drivers may require
12282>>>>>>>>>>>        // that you sub-class your DD and create a different object based on a custom class
12282>>>>>>>>>>>        Property Handle phoSQLHelper (Create(Self,RefClass(cDAWSQLDriverHelper)))
12283>>>>>>>>>>>
12283>>>>>>>>>>>
12283>>>>>>>>>>>        Property Handle pbInResync False
12284>>>>>>>>>>>
12284>>>>>>>>>>>        Property Integer piPrimaryIndex -1      // Indicates the unique index used by the webapp view state system (-1 defaults to the primary key or recnum for embedded).
12285>>>>>>>>>>>
12285>>>>>>>>>>>        Set Smart_FileMode_State to True  // extended DSOs should default to true
12286>>>>>>>>>>>
12286>>>>>>>>>>>        Send Define_Fields // Developer Hook - define all field rules
12287>>>>>>>>>>>    End_Procedure
12288>>>>>>>>>>>
12288>>>>>>>>>>>    // Returns 1 to indicate that this is a DD class.
12288>>>>>>>>>>>    Function Extended_DSO_State Returns Integer
12290>>>>>>>>>>>        Function_Return 1
12291>>>>>>>>>>>    End_Function
12292>>>>>>>>>>>
12292>>>>>>>>>>>
12292>>>>>>>>>>>    // Used to set up all XDS functions and rules. Called by construct_object
12292>>>>>>>>>>>    // and considered a bit more user friendly.
12292>>>>>>>>>>>    Procedure Define_Fields
12294>>>>>>>>>>>    End_Procedure
12295>>>>>>>>>>>
12295>>>>>>>>>>>
12295>>>>>>>>>>>
12295>>>>>>>>>>>    // This message has been augmented to create a local recordbuffer for a
12295>>>>>>>>>>>    // file. We cannot do this earlier because we need the file to count the
12295>>>>>>>>>>>    // number of necessary fields.
12295>>>>>>>>>>>    Procedure Set Main_File Integer iFile
12297>>>>>>>>>>>        Integer iCurrent_File iMaster
12297>>>>>>>>>>>        Get piMasterTable to iMaster
12298>>>>>>>>>>>        If iMaster Begin
12300>>>>>>>>>>>            // is an alias condition
12300>>>>>>>>>>>            Forward Set Main_File to iFile
12302>>>>>>>>>>>            Send ReDefineAliasItems to (Record_Buffer(Self)) iFile
12303>>>>>>>>>>>        End
12303>>>>>>>>>>>>
12303>>>>>>>>>>>        Else If iFile Begin
12306>>>>>>>>>>>            Get Main_File to iCurrent_File
12307>>>>>>>>>>>            If (iCurrent_File and iCurrent_File <> iFile) Begin
12309>>>>>>>>>>>                Send Data_Set_Error -1 DFERR_PROGRAM DD_CANNOT_CHANGE_MAIN_FILE
12310>>>>>>>>>>>                Procedure_Return
12311>>>>>>>>>>>            End
12311>>>>>>>>>>>>
12311>>>>>>>>>>>            Forward Set Main_File to iFile
12313>>>>>>>>>>>            Send Create_Items to (Record_Buffer(Self)) iFile
12314>>>>>>>>>>>            Send Create_Items to (Field_Attributes(Self))
12315>>>>>>>>>>>        End
12315>>>>>>>>>>>>
12315>>>>>>>>>>>    End_Procedure
12316>>>>>>>>>>>
12316>>>>>>>>>>>    // This procedure will update the Key_Fields property to include or
12316>>>>>>>>>>>    // excluded the fieldnumber passed in the list of fieldnumbers which make
12316>>>>>>>>>>>    // up an keyvalue.
12316>>>>>>>>>>>    Procedure Set Key_Field_State Integer iField Integer iState
12318>>>>>>>>>>>        String  sKeys
12318>>>>>>>>>>>        Set Key_Field_State of Record_Buffer iField to iState
12319>>>>>>>>>>>        Get Key_Fields to sKeys
12320>>>>>>>>>>>        Set Key_Fields to (Overstrike(If(iState, "X", " "), sKeys, iField))
12321>>>>>>>>>>>    End_Procedure
12322>>>>>>>>>>>
12322>>>>>>>>>>>    // Will return TRUE if the field passed has been defined as a key.
12322>>>>>>>>>>>    Function Key_Field_State Integer iField Returns Integer
12324>>>>>>>>>>>        Integer iState
12324>>>>>>>>>>>        Get Key_Field_State of Record_Buffer iField to iState
12325>>>>>>>>>>>        Function_Return iState
12326>>>>>>>>>>>    End_Function
12327>>>>>>>>>>>
12327>>>>>>>>>>>    // Returns complete key value.
12327>>>>>>>>>>>    Function Key_Value Returns String
12329>>>>>>>>>>>        String  sKeys
12329>>>>>>>>>>>        String  sKey_Value
12329>>>>>>>>>>>        String  sValue
12329>>>>>>>>>>>        Integer iField
12329>>>>>>>>>>>        Get Key_Fields to sKeys
12330>>>>>>>>>>>        Move "" to sKey_Value
12331>>>>>>>>>>>        Repeat
12331>>>>>>>>>>>>
12331>>>>>>>>>>>            Move (Pos( "X",sKeys)) to iField
12332>>>>>>>>>>>            If iField Begin
12334>>>>>>>>>>>                Get Field_Current_Value iField to sValue
12335>>>>>>>>>>>                Append sKey_Value sValue
12336>>>>>>>>>>>                Move (Overstrike(" ", sKeys, iField)) to sKeys
12337>>>>>>>>>>>            End
12337>>>>>>>>>>>>
12337>>>>>>>>>>>        Until not iField
12339>>>>>>>>>>>        Function_Return sKey_Value
12340>>>>>>>>>>>    End_Function
12341>>>>>>>>>>>
12341>>>>>>>>>>>    // This procedure will be called whenever the Data_Set changes its
12341>>>>>>>>>>>    // Current_Record property, or after a Save, Delete or Clear operation.
12341>>>>>>>>>>>    // We send this message to the Record_Buffer object to update its values.
12341>>>>>>>>>>>    Procedure New_Current_Record Integer iOld Integer iNew
12343>>>>>>>>>>>        // does nothing, but exists if developer is using this for some purpose. Is called after
12343>>>>>>>>>>>        // OnNewCurrentRecord (if recnum based table)
12343>>>>>>>>>>>    End_Procedure
12344>>>>>>>>>>>
12344>>>>>>>>>>>    Procedure OnNewCurrentRecord RowID riOld RowID riNew
12346>>>>>>>>>>>        Integer iObj
12346>>>>>>>>>>>        Integer iOldst
12346>>>>>>>>>>>        Integer iFoc
12346>>>>>>>>>>>        Integer iIsExt
12346>>>>>>>>>>>        Forward Send OnNewCurrentRecord riOld riNew
12348>>>>>>>>>>>        Move (Record_Buffer(Self)) to iObj
12349>>>>>>>>>>>        If iObj Begin
12351>>>>>>>>>>>            Send OnNewCurrentRecord of iObj riOld riNew
12352>>>>>>>>>>>            // must also refresh all defined extended fields
12352>>>>>>>>>>>            Send ExtendedFieldsRefresh (IsNullRowId(riNew)) // pass bCleared (true if a clear)
12353>>>>>>>>>>>            Get Focus of Desktop to iFoc
12354>>>>>>>>>>>            Get Extended_DEO_State of iFoc to iIsExt     // if focus is deo item
12355>>>>>>>>>>>            If iIsExt Begin                               // disable the state so
12357>>>>>>>>>>>                Get Entry_Refresh_State of iFoc to iOldSt // value will come
12358>>>>>>>>>>>                Set Entry_Refresh_State of iFoc to True   // from Local buffer.
12359>>>>>>>>>>>            End
12359>>>>>>>>>>>>
12359>>>>>>>>>>>            Set Existing_Key_Value to (Key_Value(Self))
12360>>>>>>>>>>>            If iIsExt ;                Set Entry_Refresh_State of iFoc to iOldSt
12363>>>>>>>>>>>            // Only set defaults when the record is new
12363>>>>>>>>>>>            If (IsNullRowId(riNew)) ;                Send Prepare_Default_Values
12366>>>>>>>>>>>        End
12366>>>>>>>>>>>>
12366>>>>>>>>>>>    End_Procedure
12367>>>>>>>>>>>
12367>>>>>>>>>>>    // Shuts off change mode and sends initialize_default_values which is
12367>>>>>>>>>>>    // a user hook routine.
12367>>>>>>>>>>>    Procedure Prepare_Default_Values
12369>>>>>>>>>>>        Integer iOldState
12369>>>>>>>>>>>        Get Change_disabled_State to iOldState
12370>>>>>>>>>>>        Set Change_disabled_State to True
12371>>>>>>>>>>>        Send Private_Field_Defaults
12372>>>>>>>>>>>        // set defaults if this is the main DDO or the DDO is
12372>>>>>>>>>>>        // flagged as supporting saving new records when foreign (a parent)
12372>>>>>>>>>>>        If (Operation_Origin=Self or ;            Allow_Foreign_New_Save_State(Self)) ;            Send Field_Defaults
12375>>>>>>>>>>>        Send AssignDynamicDefaults
12376>>>>>>>>>>>        Set Change_disabled_State to iOldState
12377>>>>>>>>>>>    End_Procedure
12378>>>>>>>>>>>
12378>>>>>>>>>>>    // Set all checkbox fields to default to False data value.
12378>>>>>>>>>>>    Procedure Private_Field_Defaults
12380>>>>>>>>>>>        Integer iField
12380>>>>>>>>>>>        Repeat
12380>>>>>>>>>>>>
12380>>>>>>>>>>>            Get Next_Validation_Type of (Field_Attributes(Self)) ;                FA_VALIDATION_TYPE_CHECKBOX iField to iField
12381>>>>>>>>>>>            If (iField = 0) ;                Procedure_Return
12384>>>>>>>>>>>            Set Field_Select_State  iField to False
12385>>>>>>>>>>>            Set Field_Changed_State iField to True
12386>>>>>>>>>>>        Loop
12387>>>>>>>>>>>>
12387>>>>>>>>>>>    End_Procedure
12388>>>>>>>>>>>
12388>>>>>>>>>>>    // Will be called after a clear operation to let the application
12388>>>>>>>>>>>    // programmer set the default values for the record. This should be done
12388>>>>>>>>>>>    // by sending SET Field_Current_Value.
12388>>>>>>>>>>>    Procedure Field_Defaults
12390>>>>>>>>>>>    End_Procedure
12391>>>>>>>>>>>
12391>>>>>>>>>>>    // Pass type and string value and see if this is valid data for this
12391>>>>>>>>>>>    // type. Currently we check for numbers and dates. Return non-zero
12391>>>>>>>>>>>    // if invalid.
12391>>>>>>>>>>>    Function IsDataInvalid Integer iType String sValue Returns Integer
12393>>>>>>>>>>>        Date    dVal
12393>>>>>>>>>>>        DateTime dtVal
12393>>>>>>>>>>>        Number  nVal
12393>>>>>>>>>>>        Integer bOK
12393>>>>>>>>>>>        Boolean bInvalid
12393>>>>>>>>>>>
12393>>>>>>>>>>>        Move False to bInvalid
12394>>>>>>>>>>>        If (iType=DF_BCD or iType=DF_DATE or iType=DF_DATETIME) Begin
12396>>>>>>>>>>>            If (iType=DF_DATE) Begin
12398>>>>>>>>>>>                MoveTrapErr sValue to dVal
12399>>>>>>>>>>>                Move (Err) to bInvalid
12400>>>>>>>>>>>            End
12400>>>>>>>>>>>>
12400>>>>>>>>>>>            Else If (iType=DF_DATETIME) Begin
12403>>>>>>>>>>>                MoveTrapErr sValue to dtVal
12404>>>>>>>>>>>                Move (Err) to bInvalid
12405>>>>>>>>>>>//          Move (not(IsDateValid(dtVal))) to bInvalid //jjt-uncomment when working
12405>>>>>>>>>>>            End
12405>>>>>>>>>>>>
12405>>>>>>>>>>>            Else Begin
12406>>>>>>>>>>>                MoveTrapErr sValue to nVal // this may gen an error.
12407>>>>>>>>>>>                Move (Err) to bInvalid
12408>>>>>>>>>>>            End
12408>>>>>>>>>>>>
12408>>>>>>>>>>>            Move False to Err
12409>>>>>>>>>>>        End
12409>>>>>>>>>>>>
12409>>>>>>>>>>>        Function_Return bInvalid
12410>>>>>>>>>>>    End_Function
12411>>>>>>>>>>>
12411>>>>>>>>>>>    // Return 1 if the passed DEO is part of the DDs list of connected DEOs
12411>>>>>>>>>>>    // First check if server of DEO is this DD. If so, we are owned. If not
12411>>>>>>>>>>>    // we must check the DD's UI DEO list.
12411>>>>>>>>>>>    // The passed object MUST be a valid DEO or an error will occur.
12411>>>>>>>>>>>    Function IsDEOOwned Integer iDEO Returns Integer
12413>>>>>>>>>>>        Integer iMax iCount
12413>>>>>>>>>>>        // if DEOs server is same as current DD it is owned. This is the
12413>>>>>>>>>>>        // fast check
12413>>>>>>>>>>>        If (Server(iDEO)=Self) ;            Function_Return 1
12416>>>>>>>>>>>        // else see if the DEO is in the DD's DEO list
12416>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iMax
12417>>>>>>>>>>>        Decrement iMax
12418>>>>>>>>>>>        For iCount from 0 to iMax
12424>>>>>>>>>>>>
12424>>>>>>>>>>>            If (Data_Set_User_Interface(Self,iCount)=iDEO) ;                Function_Return 1
12427>>>>>>>>>>>        Loop
12428>>>>>>>>>>>>
12428>>>>>>>>>>>        Function_Return 0
12429>>>>>>>>>>>    End_Function
12430>>>>>>>>>>>
12430>>>>>>>>>>>    // This procedure changes the field value of the given field in the
12430>>>>>>>>>>>    // record-buffer object.
12430>>>>>>>>>>>    // It also sends Field_Value_Changed to notify every the attached DEOs.
12430>>>>>>>>>>>    // This has been optimized so this message is only sent when data is
12430>>>>>>>>>>>    // actually changed.
12430>>>>>>>>>>>    Procedure Set Field_Current_Value Integer iField String sValue
12432>>>>>>>>>>>        Integer iObj
12432>>>>>>>>>>>        String sOldVal
12432>>>>>>>>>>>        Integer iChanged
12432>>>>>>>>>>>        Integer iType
12432>>>>>>>>>>>        Integer iFile
12432>>>>>>>>>>>        Integer iFocObj
12432>>>>>>>>>>>        Integer iCrnt
12432>>>>>>>>>>>        Integer bInvalid
12432>>>>>>>>>>>        Integer iIdentity
12432>>>>>>>>>>>        Address pData
12432>>>>>>>>>>>        Integer iLen
12432>>>>>>>>>>>
12432>>>>>>>>>>>        Get Main_File to iFile
12433>>>>>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12436>>>>>>>>>>>
12436>>>>>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
12436>>>>>>>>>>>        // that you will use the underlying fields instead
12436>>>>>>>>>>>        If (iType = DF_OVERLAP) Begin
12438>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
12439>>>>>>>>>>>            Procedure_Return
12440>>>>>>>>>>>        End
12440>>>>>>>>>>>>
12440>>>>>>>>>>>
12440>>>>>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if text or binary direct to pointer
12442>>>>>>>>>>>            Move sValue to sValue // intentional code: make sure passed sValue is a really string
12443>>>>>>>>>>>            Move (SizeOfString(sValue)) to iLen // length to copy
12444>>>>>>>>>>>            Move (AddressOf(sValue)) to pData   // first byte of string
12445>>>>>>>>>>>            // will gen error if ext. field does not exist
12445>>>>>>>>>>>            Set Field_Current_Pointer_Value iField iLen to pData
12446>>>>>>>>>>>            Procedure_Return
12447>>>>>>>>>>>        End
12447>>>>>>>>>>>>
12447>>>>>>>>>>>
12447>>>>>>>>>>>
12447>>>>>>>>>>>        // If date or number, force conversion so any error is detected before
12447>>>>>>>>>>>        // the buffer is updated. We don't want the record buffer to contain
12447>>>>>>>>>>>        // invalid data
12447>>>>>>>>>>>        Get IsDataInvalid iType sValue to bInvalid
12448>>>>>>>>>>>        If bInvalid ;         // If an error occurred we have            Procedure_Return  // a bad number or a bad date. Do no more!
12451>>>>>>>>>>>
12451>>>>>>>>>>>        Move (Record_Buffer(Self)) to iObj
12452>>>>>>>>>>>        Get Value of iObj iField to sOldVal
12453>>>>>>>>>>>
12453>>>>>>>>>>>        Set Value of iObj iField to sValue
12454>>>>>>>>>>>
12454>>>>>>>>>>>        // Augmented to handle non DF databases JJT
12454>>>>>>>>>>>        // Some tables may use some field other then recnum for their record identity.
12454>>>>>>>>>>>        // This will be dfrecnum or some other numeric field. When this happens the DD have
12454>>>>>>>>>>>        // to field buffers for the same value. When an update occurs from the DD to the DB buffer
12454>>>>>>>>>>>        // an update can occur twice. If the values are the same, this does not matter. Else the highest
12454>>>>>>>>>>>        // field value will get the update (not recnum). So if someone changes recnum but not its real field
12454>>>>>>>>>>>        // finding may not work right. The DD is updated when a record is found and the API keeps the two values
12454>>>>>>>>>>>        // the same. If the user changes recnum, the real field does not get changed. That is what we are fixing
12454>>>>>>>>>>>        // here. Note that: 1) this has no effect on Dataflex databases (or any DB that has a 0 field recnum).
12454>>>>>>>>>>>        // 2) this type of update is rarely seen anyway (you have to change just the recnum and perform an entry_update).
12454>>>>>>>>>>>        //
12454>>>>>>>>>>>        // if field is recnum and record identity is not 0, we must also update the other field.
12454>>>>>>>>>>>        If (iField=0) Begin
12456>>>>>>>>>>>            Get_Attribute DF_FILE_RECORD_IDENTITY of iFile to iIdentity
12459>>>>>>>>>>>            If (iIdentity>0) ;                Set Value of iObj iIdentity to sValue
12462>>>>>>>>>>>        End
12462>>>>>>>>>>>>
12462>>>>>>>>>>>
12462>>>>>>>>>>>        // When data-sets are working they should not update the
12462>>>>>>>>>>>        // DEOs.
12462>>>>>>>>>>>
12462>>>>>>>>>>>        // prior to vdf7, we stopped all operation modes of non-zero. We now allow
12462>>>>>>>>>>>        // validates to pass through and we have a new operation mode for this. This
12462>>>>>>>>>>>        // should be ok, since we already allowed navigation validation through - we just
12462>>>>>>>>>>>        // stopped request_validate validations.
12462>>>>>>>>>>>        If (Operation_Mode=0 or Operation_Mode=MODE_VALIDATING) Begin
12464>>>>>>>>>>>            If (iType=DF_BCD) ;                Move (Number(sValue)<>Number(sOldVal)) to iChanged
12467>>>>>>>>>>>            Else If (iType=DF_DATE) ;                Move (Date(sValue)<>Date(sOldVal)) to iChanged
12471>>>>>>>>>>>            Else If (iType=DF_DATETIME) ;                Move (Cast(sValue,DateTime)<>Cast(sOldVal,DateTime)) to iChanged
12475>>>>>>>>>>>            Else ;                Move (sValue<>sOldVal) to iChanged
12477>>>>>>>>>>>            // if changed, notify all DEOs of this change
12477>>>>>>>>>>>            If iChanged ;                Send Field_Value_Changed iField sValue
12480>>>>>>>>>>>            Else Begin
12481>>>>>>>>>>>                // If here the set value did not change the contents of the DD.
12481>>>>>>>>>>>                // However, it is possible that the current focus DEO may contain
12481>>>>>>>>>>>                // a different value than the one we are setting. In such a case
12481>>>>>>>>>>>                // we must re-synchronize the DEO. Only the one DEO can be affected
12481>>>>>>>>>>>                // because it is the current focus deo/item that can contain a value
12481>>>>>>>>>>>                // that is not yet updated in the DD. This fixes a bug where the
12481>>>>>>>>>>>                // iexit was setting a value which was different from what was in
12481>>>>>>>>>>>                // the DEO but was the same as the old DD value (iExit is called
12481>>>>>>>>>>>                // before the DD is re-synched with the DEO). This could happen
12481>>>>>>>>>>>                // also by sending this message directly with a different value in
12481>>>>>>>>>>>                // the DEO focus item.
12481>>>>>>>>>>>                Get Focus of Desktop to iFocObj
12482>>>>>>>>>>>                // similar logic to Get Field_Current_Value. We check that the DEO
12482>>>>>>>>>>>                // is extended, that entry_refresh is not disabled and that the
12482>>>>>>>>>>>                // DEO's server is this DD.
12482>>>>>>>>>>>                If ( Extended_DEO_State(iFocObj) and ;                    (Entry_Refresh_State(iFocObj)=0)) Begin
12484>>>>>>>>>>>                    Get Current_item of iFocObj to iCrnt
12485>>>>>>>>>>>                    // If Focus DEO has same file and field and it is not checkbox
12485>>>>>>>>>>>                    // we must set its value. Set local value directly sets the value
12485>>>>>>>>>>>                    // in the DEO item. If we used value we'd get recursion!
12485>>>>>>>>>>>                    If ( Data_File(iFocObj,iCrnt)=iFile and ;                        Data_Field(iFocObj,iCrnt)=iField and ;                        IsDEOOwned(Self,iFocObj) and ;                        Checkbox_item_State(iFocObj,iCrnt)=0 ) ;                        Send File_Field_Value_Changed to iFocObj iFile iField sValue True
12488>>>>>>>>>>>                    //Set Local_Value of iFocObj iCrnt to sValue
12488>>>>>>>>>>>                End
12488>>>>>>>>>>>>
12488>>>>>>>>>>>            End
12488>>>>>>>>>>>>
12488>>>>>>>>>>>        End
12488>>>>>>>>>>>>
12488>>>>>>>>>>>    End_Procedure
12489>>>>>>>>>>>
12489>>>>>>>>>>>    // Sets Field_Current_Value and Sets Field_Changed_State for passed field.
12489>>>>>>>>>>>    Procedure Set Field_Changed_Value Integer iField String sValue
12491>>>>>>>>>>>        Set Field_Changed_State iField to True
12492>>>>>>>>>>>        Set Field_Current_Value iField to sValue
12493>>>>>>>>>>>    End_Procedure
12494>>>>>>>>>>>
12494>>>>>>>>>>>
12494>>>>>>>>>>>    // This should only be set by a DEO that is changing a NoPut value. This should only happen when NoEnter=F
12494>>>>>>>>>>>    // for indexed findable noput deos. With foreign-field noputs we may store the value and update them
12494>>>>>>>>>>>    // for finds but we don't want them for saves. The cDDBuffer class handles this but it needs to
12494>>>>>>>>>>>    // know if this was a DEO NoPut update. DDOs have always allowed you to directly update foreign NoPut
12494>>>>>>>>>>>    // fields when the change did not come from a DEO.
12494>>>>>>>>>>>    Procedure Set Field_NoPutValueChangedByDeo Integer iField Boolean bChange
12496>>>>>>>>>>>        Set Item_ChangedByDeo of Record_Buffer iField to bChange
12497>>>>>>>>>>>    End_Procedure
12498>>>>>>>>>>>
12498>>>>>>>>>>>    Procedure Set File_Field_NoPutValueChangedByDeo Integer iFile Integer iField Boolean bChange
12500>>>>>>>>>>>        Integer iDSO
12500>>>>>>>>>>>        Get Data_set iFile to iDSO
12501>>>>>>>>>>>        If iDSO Begin
12503>>>>>>>>>>>            Set Field_NoPutValueChangedByDeo of iDSO iField to bChange
12504>>>>>>>>>>>        End
12504>>>>>>>>>>>>
12504>>>>>>>>>>>    End_Procedure
12505>>>>>>>>>>>
12505>>>>>>>>>>>    // Returns the value from the record buffer for the field of which the
12505>>>>>>>>>>>    // fieldnumber has been passed.
12505>>>>>>>>>>>    // If the file/field requested is the focus file/field the use the DEO's
12505>>>>>>>>>>>    // value.
12505>>>>>>>>>>>    Function Field_Current_Value Integer iField Returns String
12507>>>>>>>>>>>        Integer iType
12507>>>>>>>>>>>        Integer iFile
12507>>>>>>>>>>>        String  sValue
12507>>>>>>>>>>>        Integer iFoc
12507>>>>>>>>>>>        Integer iCrnt
12507>>>>>>>>>>>        Integer iFldSize iVoid
12507>>>>>>>>>>>        UChar[] UCData
12508>>>>>>>>>>>
12508>>>>>>>>>>>        Get Focus of desktop to iFoc
12509>>>>>>>>>>>        Get Main_File to iFile
12510>>>>>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12513>>>>>>>>>>>
12513>>>>>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
12513>>>>>>>>>>>        // that you will use the underlying fields instead
12513>>>>>>>>>>>        If (iType=DF_OVERLAP) Begin
12515>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
12516>>>>>>>>>>>            Function_Return ''
12517>>>>>>>>>>>        End
12517>>>>>>>>>>>>
12517>>>>>>>>>>>
12517>>>>>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if overlap, text or binary direct to pointer
12519>>>>>>>>>>>            Get Field_Current_UCAValue iField to UCData
12520>>>>>>>>>>>
12520>>>>>>>>>>>            // we assume a string is passed here. If we return to a string the
12520>>>>>>>>>>>            // pointer message will convert this to a string. Check that max string
12520>>>>>>>>>>>            // length is not larger than Max_Argument_Size has been removed.
12520>>>>>>>>>>>            Move (SizeOfArray(UCData)) to iFldSize
12521>>>>>>>>>>>            Move (UCharArrayToString(UCData)) to sValue
12522>>>>>>>>>>>            // This function has always returned the value as a 0 delimited string.
12522>>>>>>>>>>>            // Therefore trim at first zero. This means that you should not use this method
12522>>>>>>>>>>>            // with Binary types as embedded zeros will cause a truncation.
12522>>>>>>>>>>>            Move (CString(sValue)) to sValue
12523>>>>>>>>>>>            Function_Return sValue
12524>>>>>>>>>>>        End
12524>>>>>>>>>>>>
12524>>>>>>>>>>>
12524>>>>>>>>>>>        // This was extended to also make sure that the focus's server
12524>>>>>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
12524>>>>>>>>>>>        // file/field being the right file/field but for a different view.
12524>>>>>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
12524>>>>>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
12524>>>>>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
12524>>>>>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
12524>>>>>>>>>>>        // DEO field, so the buffer is always correct.
12524>>>>>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
12526>>>>>>>>>>>            Get Current_item of iFoc to iCrnt
12527>>>>>>>>>>>            If ( Data_File(iFoc,iCrnt)=iFile and Data_Field(iFoc,iCrnt)=iField and ;                IsDEOOwned(Self,iFoc) and ;                (Checkbox_item_State(iFoc,iCrnt)=0) ) Begin
12529>>>>>>>>>>>                Get Data_Value of iFoc iCrnt to sValue
12530>>>>>>>>>>>            End
12530>>>>>>>>>>>>
12530>>>>>>>>>>>            Else Begin
12531>>>>>>>>>>>                Get Value of (Record_Buffer(Self)) iField to sValue
12532>>>>>>>>>>>            End
12532>>>>>>>>>>>>
12532>>>>>>>>>>>        End
12532>>>>>>>>>>>>
12532>>>>>>>>>>>        Else Begin
12533>>>>>>>>>>>            Get Value of (Record_Buffer(Self)) iField to sValue
12534>>>>>>>>>>>        End
12534>>>>>>>>>>>>
12534>>>>>>>>>>>
12534>>>>>>>>>>>        // cast value to the proper datatype
12534>>>>>>>>>>>        If (iType=DF_BCD) Begin
12536>>>>>>>>>>>            Function_Return (Number(sValue))
12537>>>>>>>>>>>        End
12537>>>>>>>>>>>>
12537>>>>>>>>>>>        Else If (iType=DF_DATE) Begin
12540>>>>>>>>>>>            Function_Return (Date(sValue))
12541>>>>>>>>>>>        End
12541>>>>>>>>>>>>
12541>>>>>>>>>>>        Else If (iType=DF_DATETIME) Begin
12544>>>>>>>>>>>            Function_Return (Cast(sValue,DateTime))
12545>>>>>>>>>>>        End
12545>>>>>>>>>>>>
12545>>>>>>>>>>>        // else return as string
12545>>>>>>>>>>>        Function_Return sValue
12546>>>>>>>>>>>    End_Function
12547>>>>>>>>>>>
12547>>>>>>>>>>>    // This sets a default value without setting the DSO's changed_State
12547>>>>>>>>>>>    Procedure Set Field_Default_Value Integer iField String sValue
12549>>>>>>>>>>>        Integer iOldState
12549>>>>>>>>>>>        Get Change_disabled_State to iOldState
12550>>>>>>>>>>>        Set Change_disabled_State to True
12551>>>>>>>>>>>        Set Field_Changed_Value iField to sValue
12552>>>>>>>>>>>        Set Change_disabled_State to iOldState
12553>>>>>>>>>>>    End_Procedure
12554>>>>>>>>>>>
12554>>>>>>>>>>>    Procedure Set File_Field_default_Value Integer iFile Integer iField String sValue
12556>>>>>>>>>>>        Integer iDSO
12556>>>>>>>>>>>        Get Data_set iFile to iDSO
12557>>>>>>>>>>>        If iDSO ;            Set Field_default_Value of iDSO iField to sValue
12560>>>>>>>>>>>    End_Procedure
12561>>>>>>>>>>>
12561>>>>>>>>>>>    // Methods to set and get the value of a field. When set all DSOs and
12561>>>>>>>>>>>    // DEOs are notified.
12561>>>>>>>>>>>    Procedure Set File_Field_Current_Value Integer iFile Integer iField String sValue
12563>>>>>>>>>>>        Integer iDSO
12563>>>>>>>>>>>        Get Data_set iFile to iDSO
12564>>>>>>>>>>>        If iDSO ;            Set Field_Current_Value of iDSO iField to sValue
12567>>>>>>>>>>>    End_Procedure
12568>>>>>>>>>>>
12568>>>>>>>>>>>    Procedure Set File_Field_Changed_Value Integer iFile Integer iField String sValue
12570>>>>>>>>>>>        Integer iDSO
12570>>>>>>>>>>>        Get Data_set iFile to iDSO
12571>>>>>>>>>>>        If iDSO ;            Set Field_Changed_Value of iDSO iField to sValue
12574>>>>>>>>>>>    End_Procedure
12575>>>>>>>>>>>
12575>>>>>>>>>>>    Function File_Field_Current_Value Integer iFile Integer iField Returns String
12577>>>>>>>>>>>        Integer iDSO
12577>>>>>>>>>>>        String sValue
12577>>>>>>>>>>>        Get Data_set iFile to iDSO
12578>>>>>>>>>>>        If iDSO ;            Get Field_Current_Value of iDSO iField to sValue
12581>>>>>>>>>>>        Function_Return sValue
12582>>>>>>>>>>>    End_Function
12583>>>>>>>>>>>
12583>>>>>>>>>>>    // This procedure will notify every attached DEO that the value of a
12583>>>>>>>>>>>    // field has been changed. Every DEO needs to update its value to reflect
12583>>>>>>>>>>>    // the new value.
12583>>>>>>>>>>>    Procedure Field_Value_Changed Integer iField String sValue
12585>>>>>>>>>>>        Integer iMax
12585>>>>>>>>>>>        Integer iCount
12585>>>>>>>>>>>        Integer iDEO
12585>>>>>>>>>>>        Integer iMain_File
12585>>>>>>>>>>>        Integer iNoChange
12585>>>>>>>>>>>        Get Change_Disabled_State to iNoChange
12586>>>>>>>>>>>        Get Main_File to iMain_File
12587>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iMax
12588>>>>>>>>>>>        Decrement iMax
12589>>>>>>>>>>>        For iCount from 0 to iMax
12595>>>>>>>>>>>>
12595>>>>>>>>>>>            Get Data_Set_User_Interface iCount to iDEO
12596>>>>>>>>>>>            If (Extended_DEO_State(iDEO) ) Begin
12598>>>>>>>>>>>                Send File_Field_Value_Changed to iDEO iMain_File iField sValue iNoChange
12599>>>>>>>>>>>            End
12599>>>>>>>>>>>>
12599>>>>>>>>>>>        Loop
12600>>>>>>>>>>>>
12600>>>>>>>>>>>    End_Procedure
12601>>>>>>>>>>>
12601>>>>>>>>>>>    // Gets/Sets Field_Changed_State of the passed field. Will Set Changed_
12601>>>>>>>>>>>    // state if appropriate (if change_disabled_state is false)
12601>>>>>>>>>>>    Function Field_Changed_State Integer iField Returns Integer
12603>>>>>>>>>>>        Function_Return ;            (Item_Changed_State(Record_Buffer(Self), iField))
12604>>>>>>>>>>>    End_Function
12605>>>>>>>>>>>
12605>>>>>>>>>>>
12605>>>>>>>>>>>    // Handle NoPut here. If the field is noput set the field_changed_State but do not set the
12605>>>>>>>>>>>    // DD's changed_state. As of 17.0, we changed the rule so that noput DEOs always update the DD.
12605>>>>>>>>>>>    // They set the field_Current_value and they set the field_changed_state. If noput they will
12605>>>>>>>>>>>    // not set changed_state. This now makes windows and web consistent.
12605>>>>>>>>>>>    Procedure Set Field_Changed_State Integer iField Integer iState
12607>>>>>>>>>>>        Boolean bNoPut bOldSt bIsCommitted
12607>>>>>>>>>>>
12607>>>>>>>>>>>        Get Field_Option iField DD_NOPUT to bNoPut
12608>>>>>>>>>>>        If not bNoPut Begin // if not noput, see if this is a committed and therefore noput
12610>>>>>>>>>>>            Get IsCommitted to bIsCommitted
12611>>>>>>>>>>>            If bIsCommitted Begin
12613>>>>>>>>>>>                Get IsFieldCommitted iField to bNoPut
12614>>>>>>>>>>>            End
12614>>>>>>>>>>>>
12614>>>>>>>>>>>        End
12614>>>>>>>>>>>>
12614>>>>>>>>>>>
12614>>>>>>>>>>>        If bNoPut Begin
12616>>>>>>>>>>>            Get Change_disabled_State to bOldSt
12617>>>>>>>>>>>            Set Change_disabled_State to True
12618>>>>>>>>>>>        End
12618>>>>>>>>>>>>
12618>>>>>>>>>>>
12618>>>>>>>>>>>        Set Item_Changed_State of (Record_Buffer(Self)) iField to iState
12619>>>>>>>>>>>        // the cDDBuffer class item_changed_state does not attempt to set
12619>>>>>>>>>>>        // changed_state, so we do it here. This will allow for future
12619>>>>>>>>>>>        // greater flexibilities.
12619>>>>>>>>>>>        If (iState) Begin
12621>>>>>>>>>>>            Set Changed_State of (Record_Buffer(Self)) to True
12622>>>>>>>>>>>        End
12622>>>>>>>>>>>>
12622>>>>>>>>>>>        If bNoPut Begin
12624>>>>>>>>>>>            Set Change_disabled_State to bOldSt
12625>>>>>>>>>>>        End
12625>>>>>>>>>>>>
12625>>>>>>>>>>>
12625>>>>>>>>>>>    End_Procedure
12626>>>>>>>>>>>
12626>>>>>>>>>>>    // As above, but passes both file and field
12626>>>>>>>>>>>    Function File_Field_Changed_State Integer iFile Integer iField Returns Integer
12628>>>>>>>>>>>        Integer iDSO
12628>>>>>>>>>>>        Get Data_Set iFile to iDSO
12629>>>>>>>>>>>        If iDSO ;            Function_Return (Field_Changed_State(iDSO, iField))
12632>>>>>>>>>>>    End_Function
12633>>>>>>>>>>>
12633>>>>>>>>>>>    Procedure Set File_Field_Changed_State Integer iFile Integer iField Integer iState
12635>>>>>>>>>>>        Integer iDSO
12635>>>>>>>>>>>        Get Data_Set iFile to iDSO
12636>>>>>>>>>>>        If iDSO ;            Set Field_Changed_State of iDSO iField to iState
12639>>>>>>>>>>>    End_Procedure
12640>>>>>>>>>>>
12640>>>>>>>>>>>    // This simulates entering a value into a field from a keyboard. Pass the
12640>>>>>>>>>>>    // Field and DD Options and the value. It is up to you to pass the proper
12640>>>>>>>>>>>    // DD options. This is normally sent by File_Field_Entry and you are
12640>>>>>>>>>>>    // advised to use that message and not this one.
12640>>>>>>>>>>>    Procedure Set Field_Entry Integer iField Integer iOpts Integer bShowErr String sValue
12642>>>>>>>>>>>        Integer iFile
12642>>>>>>>>>>>        Integer iType
12642>>>>>>>>>>>        Integer bChanged
12642>>>>>>>>>>>        Integer bInvalid
12642>>>>>>>>>>>        Integer hObj
12642>>>>>>>>>>>        String sOldVal
12642>>>>>>>>>>>        Address pData
12642>>>>>>>>>>>        Integer iLen
12642>>>>>>>>>>>
12642>>>>>>>>>>>        Get Main_File to iFile
12643>>>>>>>>>>>
12643>>>>>>>>>>>        // if No-enter or Displayonly, this shouldn't be changed. We will
12643>>>>>>>>>>>        // let NoPut through, since a user might need it for finding.
12643>>>>>>>>>>>        If (iOpts iand DD_NOENTER) ;            Procedure_Return
12646>>>>>>>>>>>
12646>>>>>>>>>>>        // Force a caplsock if required
12646>>>>>>>>>>>        If (iOpts iand DD_CAPSLOCK) ;            Move (Uppercase(sValue)) to sValue
12649>>>>>>>>>>>
12649>>>>>>>>>>>        // If date or number, force conversion so any error is detected before
12649>>>>>>>>>>>        // the buffer is updated. We don't want the record buffer to contain
12649>>>>>>>>>>>        // invalid data
12649>>>>>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12652>>>>>>>>>>>
12652>>>>>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
12652>>>>>>>>>>>        // that you will use the underlying fields instead
12652>>>>>>>>>>>        If (iType = DF_OVERLAP) Begin
12654>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
12655>>>>>>>>>>>            Procedure_Return
12656>>>>>>>>>>>        End
12656>>>>>>>>>>>>
12656>>>>>>>>>>>
12656>>>>>>>>>>>        If (iType=DF_TEXT or iType=DF_BINARY) Begin // if text or binary direct to pointer
12658>>>>>>>>>>>            Move sValue to sValue // intentional code: make sure passed sValue is a really string
12659>>>>>>>>>>>            Move (SizeOfString(sValue)) to iLen // length to copy
12660>>>>>>>>>>>            Move (AddressOf(sValue)) to pData   // first byte of string
12661>>>>>>>>>>>            // will gen error if ext. field does not exist
12661>>>>>>>>>>>            Set Field_Pointer_Entry iField iOpts iLen bShowErr to pData
12662>>>>>>>>>>>            Procedure_Return
12663>>>>>>>>>>>        End
12663>>>>>>>>>>>>
12663>>>>>>>>>>>
12663>>>>>>>>>>>        Get IsDataInvalid iType sValue to bInvalid
12664>>>>>>>>>>>        If bInvalid Begin     // If an error occurred we have
12666>>>>>>>>>>>            If bShowErr ;                Send Data_set_error iField (If(iType=DF_DATE or iType=DF_DATETIME, DFERR_ENTER_VALID_DATE, DFERR_BAD_ENTRY)) ;                (" ("-sValue-")")
12669>>>>>>>>>>>            Procedure_Return  // a bad number or a bad date. Do no more!
12670>>>>>>>>>>>        End
12670>>>>>>>>>>>>
12670>>>>>>>>>>>        // update the value only if the value is changed.
12670>>>>>>>>>>>        Move (Record_Buffer(Self)) to hObj
12671>>>>>>>>>>>        Get Value of hObj iField to sOldVal
12672>>>>>>>>>>>        If (iType=DF_BCD) ;            Move (Number(sValue)<>Number(sOldVal)) to bChanged
12675>>>>>>>>>>>        Else If (iType=DF_DATE) ;            Move (Date(sValue)<>Date(sOldVal)) to bChanged
12679>>>>>>>>>>>        Else If (iType=DF_DATETIME) ;            Move (Cast(sValue,DateTime)<>Cast(sOldVal,DateTime)) to bChanged
12683>>>>>>>>>>>        Else ;            Move (sValue<>sOldVal) to bChanged
12685>>>>>>>>>>>
12685>>>>>>>>>>>        // if changed or force put, update the value.
12685>>>>>>>>>>>        If ( bChanged or (iOpts iand DD_FORCEPUT) ) ;            Set Field_Current_Value iField to sValue
12688>>>>>>>>>>>
12688>>>>>>>>>>>        // Set changed state if changed. This is an improvement on DEOs which would set changed-state for
12688>>>>>>>>>>>        // a no-put. Set Field_Changed_State will not set Changed_state if it is noput
12688>>>>>>>>>>>        If ( bChanged) Begin
12690>>>>>>>>>>>            Set Field_Changed_State iField to True
12691>>>>>>>>>>>            // if noput (but not noenter) we must tell the DDO that this should not be
12691>>>>>>>>>>>            // updated during a save.
12691>>>>>>>>>>>            If (iOpts iand DD_NOPUT) Begin
12693>>>>>>>>>>>                Set Field_NoPutValueChangedByDeo iField to True
12694>>>>>>>>>>>            End
12694>>>>>>>>>>>>
12694>>>>>>>>>>>        End
12694>>>>>>>>>>>>
12694>>>>>>>>>>>
12694>>>>>>>>>>>        // perform autofinds if needed. Note that required checking will occur as
12694>>>>>>>>>>>        // part of validation.
12694>>>>>>>>>>>        // We will only autofind if the field value is changed. This is consistent with
12694>>>>>>>>>>>        // DEOs which do not autofind on unchanged values. This provides optimizations
12694>>>>>>>>>>>        // when a parent record is already loaded.
12694>>>>>>>>>>>        If (bChanged or Field_Changed_state(Self,iField)) Begin
12696>>>>>>>>>>>            // note that autofind is 1 and _ge is 100000001 (8th bit set). So order of
12696>>>>>>>>>>>            // testing is important and make sure we test for exact bit match. Must first
12696>>>>>>>>>>>            // test _GE and the EQ (because EQ bit is part of GE)
12696>>>>>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE)=DD_AUTOFIND_GE) ;                Send File_Field_AutoFind iFile iField GE
12699>>>>>>>>>>>            Else If ((iOpts iand DD_AUTOFIND)=DD_AUTOFIND) ;                Send File_Field_AutoFind iFile iField EQ
12703>>>>>>>>>>>        End
12703>>>>>>>>>>>>
12703>>>>>>>>>>>
12703>>>>>>>>>>>    End_Procedure
12704>>>>>>>>>>>
12704>>>>>>>>>>>    // This returns file-field options for a Field_Entry type of environment.
12704>>>>>>>>>>>    // It will strip autofind from main-file DDs but leave foreign field alone.
12704>>>>>>>>>>>    // This is needed for Field_entry. Otherwise adding a field value to an autofind
12704>>>>>>>>>>>    // for save or find causes an autofind to trigger first which either causes the
12704>>>>>>>>>>>    // wrong rec to save or for a double find.
12704>>>>>>>>>>>    Function File_Field_Entry_Options Integer iFile Integer iField Returns Integer
12706>>>>>>>>>>>        Integer iOpts
12706>>>>>>>>>>>        // this will get the appropriate field and foreign field opts
12706>>>>>>>>>>>        Get File_Field_Options iFile iField to iOpts
12707>>>>>>>>>>>        // If the main file (not foreign) we will strip autofind. Autofind should not
12707>>>>>>>>>>>        // be an automatic part of main file entry while it should with foreign fields.
12707>>>>>>>>>>>        If (iFile=Main_File(Self)) Begin
12709>>>>>>>>>>>            // note that autofind is 1 and _ge is 100000001 (8th bit set). So order of
12709>>>>>>>>>>>            // testing is important and make sure we test for exact bit match. Must first
12709>>>>>>>>>>>            // test _GE and the EQ (because EQ bit is part of GE)
12709>>>>>>>>>>>            If ((iOpts iand DD_AUTOFIND_GE)=DD_AUTOFIND_GE) ;                Move (iOpts - DD_AUTOFIND_GE) to iOpts
12712>>>>>>>>>>>            Else If ((iOpts iand DD_AUTOFIND)=DD_AUTOFIND)  ;                Move (iOpts - DD_AUTOFIND)    to iOpts
12716>>>>>>>>>>>        End
12716>>>>>>>>>>>>
12716>>>>>>>>>>>        Function_Return iOpts
12717>>>>>>>>>>>    End_Function
12718>>>>>>>>>>>
12718>>>>>>>>>>>    // This simulates entering a value into a field from a keyboard. The DD
12718>>>>>>>>>>>    // receiving this message determines if it is Main or Foreign (just like
12718>>>>>>>>>>>    // server). It will do an uppercase, will respect No_Enter and DisplayOnly
12718>>>>>>>>>>>    // and will do a autofind if required. It does not do a field validation.
12718>>>>>>>>>>>    Procedure Set File_Field_Entry Integer iFile Integer iField Integer bShowErr String sValue
12720>>>>>>>>>>>        Integer iOpts
12720>>>>>>>>>>>        Integer hDD
12720>>>>>>>>>>>        Get Data_Set iFile to hDD
12721>>>>>>>>>>>        If hDD Begin
12723>>>>>>>>>>>            // this will get the appropriate field and foreign field opts
12723>>>>>>>>>>>            Get File_Field_Entry_Options iFile iField to iOpts
12724>>>>>>>>>>>            Set Field_Entry of hDD iField iOpts bShowErr to sValue
12725>>>>>>>>>>>        End
12725>>>>>>>>>>>>
12725>>>>>>>>>>>    End_Procedure
12726>>>>>>>>>>>
12726>>>>>>>>>>>    // return object ID of extended field, 0 if none
12726>>>>>>>>>>>    Function Field_Object Integer iField Returns Integer
12728>>>>>>>>>>>        Integer hoFlds hoField
12728>>>>>>>>>>>        Boolean bAutoAssign
12728>>>>>>>>>>>        Get Field_Objects to hoFlds
12729>>>>>>>>>>>        If hoFlds Begin
12731>>>>>>>>>>>            Get Field_Object of hoFlds iField to hoField
12732>>>>>>>>>>>        End
12732>>>>>>>>>>>>
12732>>>>>>>>>>>        If not hoField Begin
12734>>>>>>>>>>>            Send DefineExtendedField iField // will create field_objects and Field_Object as needed
12735>>>>>>>>>>>            Get Field_Objects to hoFlds
12736>>>>>>>>>>>            Get Field_Object of hoFlds iField to hoField
12737>>>>>>>>>>>        End
12737>>>>>>>>>>>>
12737>>>>>>>>>>>        Function_Return hoField
12738>>>>>>>>>>>    End_Function
12739>>>>>>>>>>>
12739>>>>>>>>>>>    // This is the same as Field_entry except the value is passed via a
12739>>>>>>>>>>>    // pointer. If data-type is extended (text/binary) it will use and an
12739>>>>>>>>>>>    // extended field object to handle this. If date/number/string we will
12739>>>>>>>>>>>    // convert this to a string and use Field_Entry. It is the caller's
12739>>>>>>>>>>>    // responsibility to pass a valid pointer to valid data...else !@#$%^&^
12739>>>>>>>>>>>    // If an extended Field object is needed and not defined, an error is
12739>>>>>>>>>>>    // returned. If pointer is null, assume empty string passed (this is a
12739>>>>>>>>>>>    // change as of 8.3 - it used to ignore null pointers)
12739>>>>>>>>>>>    Procedure Set Field_Pointer_Entry Integer iField Integer iOpts Integer iLen Integer bShowErr Address pData
12741>>>>>>>>>>>        Integer hFld
12741>>>>>>>>>>>        String  sValue
12741>>>>>>>>>>>        Integer iFile
12741>>>>>>>>>>>        Integer iType
12741>>>>>>>>>>>
12741>>>>>>>>>>>        Get Main_file to iFile
12742>>>>>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12745>>>>>>>>>>>
12745>>>>>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
12745>>>>>>>>>>>        // that you will use the underlying fields instead
12745>>>>>>>>>>>        If (iType = DF_OVERLAP) ;            Send Data_set_Error iField DFERR_PROGRAM  DD_EXTENDED_OVERLAP_ERROR
12748>>>>>>>>>>>        Else If (iType=DF_TEXT or iType=DF_BINARY) Begin
12751>>>>>>>>>>>            Get Field_Object iField to hFld // the object that handles this large text
12752>>>>>>>>>>>            If hFld ;                Set Field_pEntry of hFld iOpts iLen bShowErr to pData
12755>>>>>>>>>>>            Else ;                Send Data_set_Error iField DFERR_PROGRAM  DD_EXTENDED_FIELD_NOT_DEFINED
12757>>>>>>>>>>>        End
12757>>>>>>>>>>>>
12757>>>>>>>>>>>        Else Begin
12758>>>>>>>>>>>            // if number,date or string convert the pointer data to
12758>>>>>>>>>>>            // string data and do a normal entry with it.
12758>>>>>>>>>>>            Move (PointerToString(pData)) to sValue
12759>>>>>>>>>>>            Set Field_Entry iField iOpts bShowErr to sValue
12760>>>>>>>>>>>        End
12760>>>>>>>>>>>>
12760>>>>>>>>>>>    End_Procedure
12761>>>>>>>>>>>
12761>>>>>>>>>>>    // This is the same as File_Field_entry except the value is passed via a
12761>>>>>>>>>>>    // pointer. See Field_Pointer_Entry for more on this
12761>>>>>>>>>>>    Procedure Set File_Field_Pointer_Entry Integer iFile Integer iField Integer iLen Integer bShowErr Address pData
12763>>>>>>>>>>>        Integer iOpts
12763>>>>>>>>>>>        Integer hDD
12763>>>>>>>>>>>        Get Data_Set iFile to hDD
12764>>>>>>>>>>>        If hDD Begin
12766>>>>>>>>>>>            // this will get the appropriate field and foreign field opts
12766>>>>>>>>>>>            Get File_Field_Entry_Options iFile iField to iOpts
12767>>>>>>>>>>>            Set Field_Pointer_Entry of hDD iField iOpts iLen bShowErr to pData
12768>>>>>>>>>>>        End
12768>>>>>>>>>>>>
12768>>>>>>>>>>>    End_Procedure
12769>>>>>>>>>>>
12769>>>>>>>>>>>    // This is the same as Field_Current_Value except the value is passed via
12769>>>>>>>>>>>    // a pointer. If data-type is extended (text/binary) it will use and an
12769>>>>>>>>>>>    // extended field object to handle this. If date/number/string we will
12769>>>>>>>>>>>    // convert this to a string and use Field_Entry. It is the caller's
12769>>>>>>>>>>>    // responsibility to pass a valid pointer to valid data...else !@#$%^&^
12769>>>>>>>>>>>    // If an extended Field object is needed and not defined, an error is
12769>>>>>>>>>>>    // returned. If pointer is null, assume empty string passed (this is a
12769>>>>>>>>>>>    // change as of 8.3 - it used to ignore null pointers)
12769>>>>>>>>>>>    Procedure Set Field_Current_Pointer_Value Integer iField Integer iLen Address pData
12771>>>>>>>>>>>        Integer hFld
12771>>>>>>>>>>>        String  sValue
12771>>>>>>>>>>>        Integer iFile iType iCrnt
12771>>>>>>>>>>>        Handle iFocObj
12771>>>>>>>>>>>        Boolean bChanged
12771>>>>>>>>>>>
12771>>>>>>>>>>>        Get Main_file to iFile
12772>>>>>>>>>>>        Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12775>>>>>>>>>>>
12775>>>>>>>>>>>        // Overlap fields are not supported directly in DDs. It is expected
12775>>>>>>>>>>>        // that you will use the underlying fields instead
12775>>>>>>>>>>>        If (iType = DF_OVERLAP) Begin
12777>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_OVERLAP_ERROR
12778>>>>>>>>>>>            Procedure_Return
12779>>>>>>>>>>>        End
12779>>>>>>>>>>>>
12779>>>>>>>>>>>
12779>>>>>>>>>>>        If (iType<>DF_TEXT and iType<>DF_BINARY) Begin
12781>>>>>>>>>>>            // if number,date or string convert the pointer data to
12781>>>>>>>>>>>            // string data and do a normal entry with it.
12781>>>>>>>>>>>            Move (PointerToString(pData)) to sValue  // create string from pointer data
12782>>>>>>>>>>>            Set Field_Current_Value iField to sValue
12783>>>>>>>>>>>            Procedure_Return
12784>>>>>>>>>>>        End
12784>>>>>>>>>>>>
12784>>>>>>>>>>>
12784>>>>>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
12785>>>>>>>>>>>        If not hFld Begin
12787>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
12788>>>>>>>>>>>            Procedure_Return
12789>>>>>>>>>>>        End
12789>>>>>>>>>>>>
12789>>>>>>>>>>>
12789>>>>>>>>>>>        Get Is_pValueChanged of hFld iLen pData to bChanged
12790>>>>>>>>>>>        If bChanged Begin
12792>>>>>>>>>>>            Set Field_pValue of hFld iLen to pData
12793>>>>>>>>>>>            Send Field_Pointer_Value_Changed iField pData
12794>>>>>>>>>>>        End
12794>>>>>>>>>>>>
12794>>>>>>>>>>>        Else Begin
12795>>>>>>>>>>>            // If here the set value did not change the contents of the DD.
12795>>>>>>>>>>>            // However, it is possible that the current focus DEO may contain
12795>>>>>>>>>>>            // a different value than the one we are setting. In such a case
12795>>>>>>>>>>>            // we must re-synchronize the DEO. Only the one DEO can be affected
12795>>>>>>>>>>>            // because it is the current focus deo/item that can contain a value
12795>>>>>>>>>>>            // that is not yet updated in the DD. This fixes a bug where the
12795>>>>>>>>>>>            // iexit was setting a value which was different from what was in
12795>>>>>>>>>>>            // the DEO but was the same as the old DD value (iExit is called
12795>>>>>>>>>>>            // before the DD is re-synched with the DEO). This could happen
12795>>>>>>>>>>>            // also by sending this message directly with a different value in
12795>>>>>>>>>>>            // the DEO focus item.
12795>>>>>>>>>>>            Get Focus of Desktop to iFocObj
12796>>>>>>>>>>>            // similar logic to Get Field_Pointer_Current_Value. We check that the DEO
12796>>>>>>>>>>>            // is extended, that entry_refresh is not disabled and that the
12796>>>>>>>>>>>            // DEO's server is this DD.
12796>>>>>>>>>>>            If ( Extended_DEO_State(iFocObj) and (Entry_Refresh_State(iFocObj)=0)) Begin
12798>>>>>>>>>>>                // If Focus DEO has same file and field and it is not checkbox
12798>>>>>>>>>>>                // we must set its value. Set local value directly sets the value
12798>>>>>>>>>>>                // in the DEO item. If we used value we'd get recursion!
12798>>>>>>>>>>>                Get Current_item of iFocObj to iCrnt
12799>>>>>>>>>>>                If ( Data_File(iFocObj,iCrnt)=iFile and ;                    Data_Field(iFocObj,iCrnt)=iField and ;                    IsDEOOwned(Self,iFocObj) ) Begin
12801>>>>>>>>>>>                    Send File_Field_Pointer_Value_Changed to iFocObj iFile iField pData True
12802>>>>>>>>>>>                End
12802>>>>>>>>>>>>
12802>>>>>>>>>>>            End
12802>>>>>>>>>>>>
12802>>>>>>>>>>>        End
12802>>>>>>>>>>>>
12802>>>>>>>>>>>    End_Procedure
12803>>>>>>>>>>>
12803>>>>>>>>>>>    // This is never called but it needed for the compiler. Required for apps DDs that don't compile in a DEO interface
12803>>>>>>>>>>>    Procedure File_Field_Pointer_Value_Changed Integer iFile Integer iField Address pValue Integer iChangeDisabled
12805>>>>>>>>>>>    End_Procedure
12806>>>>>>>>>>>
12806>>>>>>>>>>>    Procedure Field_Pointer_Value_Changed Integer iField Address pValue
12808>>>>>>>>>>>        Integer iMax
12808>>>>>>>>>>>        Integer iCount
12808>>>>>>>>>>>        Integer iDEO
12808>>>>>>>>>>>        Integer iMain_File
12808>>>>>>>>>>>        Integer iNoChange
12808>>>>>>>>>>>        Get Change_Disabled_State to iNoChange
12809>>>>>>>>>>>        Get Main_File to iMain_File
12810>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iMax
12811>>>>>>>>>>>        Decrement iMax
12812>>>>>>>>>>>        For iCount from 0 to iMax
12818>>>>>>>>>>>>
12818>>>>>>>>>>>            Get Data_Set_User_Interface iCount to iDEO
12819>>>>>>>>>>>            If (Extended_DEO_State(iDEO) ) Begin
12821>>>>>>>>>>>                Send File_Field_Pointer_Value_Changed to iDEO iMain_File iField pValue iNoChange
12822>>>>>>>>>>>            End
12822>>>>>>>>>>>>
12822>>>>>>>>>>>        Loop
12823>>>>>>>>>>>>
12823>>>>>>>>>>>    End_Procedure
12824>>>>>>>>>>>
12824>>>>>>>>>>>    // This is the same as File_Field_Current_Value except the value is passed
12824>>>>>>>>>>>    // via a pointer. See Field_current_Pointer_Value for more on this
12824>>>>>>>>>>>    Procedure Set File_Field_Current_Pointer_Value Integer iFile Integer iField Integer iLen Address pData
12826>>>>>>>>>>>        Integer hDD
12826>>>>>>>>>>>        Get Data_Set iFile to hDD
12827>>>>>>>>>>>        If hDD ;            Set Field_Current_Pointer_Value of hDD iField iLen to pData
12830>>>>>>>>>>>    End_Procedure
12831>>>>>>>>>>>
12831>>>>>>>>>>>    // This returns the data pointer to the extended field. At this point
12831>>>>>>>>>>>    // this is the data. Be careful if you change the data, be even more
12831>>>>>>>>>>>    // careful if you change the pointer (don't do it!!!!)
12831>>>>>>>>>>>    Function Field_Current_Pointer_Value Integer iField Returns Address
12833>>>>>>>>>>>        Integer hFld
12833>>>>>>>>>>>        Handle iFoc
12833>>>>>>>>>>>
12833>>>>>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
12834>>>>>>>>>>>        If not hFld Begin
12836>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
12837>>>>>>>>>>>            Function_Return 0
12838>>>>>>>>>>>        End
12838>>>>>>>>>>>>
12838>>>>>>>>>>>
12838>>>>>>>>>>>
12838>>>>>>>>>>>        // This was extended to also make sure that the focus's server
12838>>>>>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
12838>>>>>>>>>>>        // file/field being the right file/field but for a different view.
12838>>>>>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
12838>>>>>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
12838>>>>>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
12838>>>>>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
12838>>>>>>>>>>>        // DEO field, so the buffer is always correct.
12838>>>>>>>>>>>        Get Focus of Desktop to iFoc
12839>>>>>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
12841>>>>>>>>>>>            If ( Data_File(iFoc,0)=Main_File(Self) and Data_Field(iFoc,0)=iField and ;                IsDEOOwned(Self,iFoc) ) Begin
12843>>>>>>>>>>>                Send Update_Focus_Field
12844>>>>>>>>>>>            End
12844>>>>>>>>>>>>
12844>>>>>>>>>>>        End
12844>>>>>>>>>>>>
12844>>>>>>>>>>>
12844>>>>>>>>>>>        Function_Return (FieldPointer(hFld))
12845>>>>>>>>>>>    End_Function
12846>>>>>>>>>>>
12846>>>>>>>>>>>
12846>>>>>>>>>>>    Function Field_Current_UCAValue Integer iField Returns UChar[]
12848>>>>>>>>>>>        Integer hFld
12848>>>>>>>>>>>        Handle iFoc
12848>>>>>>>>>>>        UChar[] Data
12849>>>>>>>>>>>
12849>>>>>>>>>>>        Get Field_Object iField to hFld // the object that handles this large text
12850>>>>>>>>>>>        If not hFld Begin
12852>>>>>>>>>>>            Send Data_set_Error iField DFERR_PROGRAM DD_EXTENDED_FIELD_NOT_DEFINED
12853>>>>>>>>>>>            Function_Return 0
12854>>>>>>>>>>>        End
12854>>>>>>>>>>>>
12854>>>>>>>>>>>
12854>>>>>>>>>>>
12854>>>>>>>>>>>        // This was extended to also make sure that the focus's server
12854>>>>>>>>>>>        // is this DD. This prevent the (very unlikely) case of a focus
12854>>>>>>>>>>>        // file/field being the right file/field but for a different view.
12854>>>>>>>>>>>        // 12.1: Also check operation mode, if within an operation assume that the
12854>>>>>>>>>>>        // ddos have the information they need from the deos. During a refresh we don't
12854>>>>>>>>>>>        // the data to be taken from a DEO - the DD buffer has the information you want. Note that
12854>>>>>>>>>>>        // we also changed all methods that set operation_mode to update the DD with the current
12854>>>>>>>>>>>        // DEO field, so the buffer is always correct.
12854>>>>>>>>>>>        Get Focus of Desktop to iFoc
12855>>>>>>>>>>>        If ( (OPERATION_MODE=MODE_WAITING) and ;            Extended_DEO_State(iFoc) and (Entry_Refresh_State(iFoc)=0) ) Begin
12857>>>>>>>>>>>            If ( Data_File(iFoc,0)=Main_File(Self) and Data_Field(iFoc,0)=iField and ;                IsDEOOwned(Self,iFoc) ) Begin
12859>>>>>>>>>>>                Send Update_Focus_Field
12860>>>>>>>>>>>            End
12860>>>>>>>>>>>>
12860>>>>>>>>>>>        End
12860>>>>>>>>>>>>
12860>>>>>>>>>>>        Get FieldArray of hFld to Data
12861>>>>>>>>>>>        Function_Return Data
12862>>>>>>>>>>>    End_Function
12863>>>>>>>>>>>
12863>>>>>>>>>>>    Function File_Field_Current_Pointer_Value Integer iFile Integer iField Returns Address
12865>>>>>>>>>>>        Address pValue
12865>>>>>>>>>>>        Integer hDD
12865>>>>>>>>>>>        Get Data_Set iFile to hDD
12866>>>>>>>>>>>        If hDD Begin
12868>>>>>>>>>>>            Get Field_Current_Pointer_Value of hDD iField to pValue // return pointer to first byte of
12869>>>>>>>>>>>            Function_Return pValue                                  // data
12870>>>>>>>>>>>        End
12870>>>>>>>>>>>>
12870>>>>>>>>>>>    End_Function
12871>>>>>>>>>>>
12871>>>>>>>>>>>    Procedure Set Field_Current_UCAValue Integer iField UChar[] Data
12873>>>>>>>>>>>        Set Field_Current_Pointer_Value iField (SizeOfArray(Data)) to (AddressOf(Data))
12874>>>>>>>>>>>    End_Procedure
12875>>>>>>>>>>>
12875>>>>>>>>>>>    Procedure Set File_Field_Current_UCAValue Integer iFile Integer iField UChar[] Data
12877>>>>>>>>>>>        Integer hDD
12877>>>>>>>>>>>        Get Data_Set iFile to hDD
12878>>>>>>>>>>>        If hDD Begin
12880>>>>>>>>>>>            Set Field_Current_UCAValue of hDD iField to Data
12881>>>>>>>>>>>        End
12881>>>>>>>>>>>>
12881>>>>>>>>>>>    End_Procedure
12882>>>>>>>>>>>
12882>>>>>>>>>>>    Function File_Field_Current_UCAValue Integer iFile Integer iField Returns UChar[]
12884>>>>>>>>>>>        UChar[] UCValue
12885>>>>>>>>>>>        Handle hDD
12885>>>>>>>>>>>        Get Data_Set iFile to hDD
12886>>>>>>>>>>>        If hDD Begin
12888>>>>>>>>>>>            Get Field_Current_UCAValue of hDD iField to UCValue // return pointer to first byte of
12889>>>>>>>>>>>            Function_Return UCValue                              // data
12890>>>>>>>>>>>        End
12890>>>>>>>>>>>>
12890>>>>>>>>>>>    End_Function
12891>>>>>>>>>>>
12891>>>>>>>>>>>    // Create an extended field object for the passed field. .
12891>>>>>>>>>>>    // If field already exists, do nothing. This should only be used with
12891>>>>>>>>>>>    // text and binary fields.
12891>>>>>>>>>>>    Procedure DefineExtendedField Integer iField
12893>>>>>>>>>>>        Integer hFlds
12893>>>>>>>>>>>        Get Field_Objects to hFlds // this may not be created yet.
12894>>>>>>>>>>>        If not hFlds Begin         // if not created, create extended-fields wrapper
12896>>>>>>>>>>>            Object ExtendedFieldObjects is a FieldObjects
12898>>>>>>>>>>>                Move Self to hFlds
12899>>>>>>>>>>>            End_Object
12900>>>>>>>>>>>            Set Field_Objects to hFlds
12901>>>>>>>>>>>        End
12901>>>>>>>>>>>>
12901>>>>>>>>>>>        Send DefineFieldObject to hFlds iField
12902>>>>>>>>>>>    End_Procedure
12903>>>>>>>>>>>
12903>>>>>>>>>>>    // create extended DD fields for all text and binary files
12903>>>>>>>>>>>    Procedure DefineAllExtendedFields
12905>>>>>>>>>>>        Integer iCount iType iField iFile
12905>>>>>>>>>>>        Get Main_file to iFile
12906>>>>>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iFile to iCount
12909>>>>>>>>>>>        For iField from 1 to iCount
12915>>>>>>>>>>>>
12915>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to iType
12918>>>>>>>>>>>            If (iType=DF_TEXT or iType=DF_BINARY) ; // if text or binary                Send DefineExtendedField iField
12921>>>>>>>>>>>        Loop
12922>>>>>>>>>>>>
12922>>>>>>>>>>>    End_Procedure
