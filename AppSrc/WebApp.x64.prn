6567>>>>>>>    Procedure Set peTabPosition Integer eTabPosition
6569>>>>>>>        Handle hWnd
6569>>>>>>>        Integer iStyle iVoid
6569>>>>>>>        Integer iPage icPage
6569>>>>>>>        
6569>>>>>>>        If (eTabPosition <> private_peTabPosition(Self)) Begin
6571>>>>>>>            Set private_peTabPosition to eTabPosition
6572>>>>>>>            If (eTabPosition = tpBottom) ;                Set peTabStyle to tsTabs // Windows error prevents buttons at the bottom
6575>>>>>>>            Get Window_Handle to hWnd
6576>>>>>>>            If hWnd Begin
6578>>>>>>>                Move (GetWindowLongPtr(hWnd, GWL_STYLE)) to iStyle
6579>>>>>>>                If (eTabPosition = tpBottom) ;                    Move (AddBitValue(TCS_BOTTOM, iStyle))    to iStyle
6582>>>>>>>                Else ;                    Move (RemoveBitValue(TCS_BOTTOM, iStyle)) to iStyle
6584>>>>>>>                Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle)) to iVoid
6585>>>>>>>                // Now relocate the pages:
6585>>>>>>>                Get Item_Count to icPage
6586>>>>>>>                For iPage from 0 to (icPage -1)
6592>>>>>>>>
6592>>>>>>>                    Send Auto_Page (Aux_Value(Self, iPage))
6593>>>>>>>                Loop
6594>>>>>>>>
6594>>>>>>>            End
6594>>>>>>>>
6594>>>>>>>            
6594>>>>>>>        End
6594>>>>>>>>
6594>>>>>>>    End_Procedure
