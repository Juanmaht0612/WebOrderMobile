1121>>>>>>>>>>>// This provides a single call global procedure call to get windows help.
1121>>>>>>>>>>>//
1121>>>>>>>>>>>// Send gDoWinHelp iHelpType {sHelpFile {String sContext}}
1121>>>>>>>>>>>//
1121>>>>>>>>>>>// Where iHelpType can be:
1121>>>>>>>>>>>//        WH_STRINGCONTEXT  - find by passed context keyword string
1121>>>>>>>>>>>//        WH_INTCONTEXT     - find by passed context integer id
1121>>>>>>>>>>>//        WH_FINDER         - load help topics dialog
1121>>>>>>>>>>>//        WH_HELPONHELP     - windows help on help
1121>>>>>>>>>>>//
1121>>>>>>>>>>>// This is used by DfHlpCl.pkg (HelpSystem class) to make a API call. You are encouraged to use the
1121>>>>>>>>>>>// messages provided by the HelpSystem class. You ARE STRONGLY DISCOURAGED from making direct
1121>>>>>>>>>>>// calls to gDoWinHelp!
1121>>>>>>>>>>>//
1121>>>>>>>>>>>
1121>>>>>>>>>>>Use DLL.pkg
1121>>>>>>>>>>>
1121>>>>>>>>>>>// Commands to pass WinHelp
1121>>>>>>>>>>>//
1121>>>>>>>>>>>
1121>>>>>>>>>>>
1121>>>>>>>>>>>//  Call Windows Help engine with string parameter (for searching)
1121>>>>>>>>>>>//
1121>>>>>>>>>>>External_Function WinHelpStr "WinHelpW" user32.dll ;    Handle  hWnd ;    WString lpHelpFile ;    DWord   cmnd ;    WString lpstr ;    Returns Integer
1122>>>>>>>>>>>
1122>>>>>>>>>>>//  Call Windows Help engine with dword parameter (for context ID)
1122>>>>>>>>>>>//
1122>>>>>>>>>>>External_Function WinHelpCntx "WinHelpW" user32.dll ;    Handle  hWnd ;    WString lpHelpFile ;    DWord   cmnd ;    ULongptr cntx ;    Returns Integer
1123>>>>>>>>>>>
1123>>>>>>>>>>>Enumeration_List
1123>>>>>>>>>>>    Define WH_STRINGCONTEXT    // find by context string
1123>>>>>>>>>>>    Define WH_INTCONTEXT       // find by context integer id
1123>>>>>>>>>>>    Define WH_FINDER           // load help topics dialog
1123>>>>>>>>>>>    Define WH_HELPONHELP       // help on help
1123>>>>>>>>>>>End_Enumeration_List
1123>>>>>>>>>>>
1123>>>>>>>>>>>// Protected Global message: Use with care
1123>>>>>>>>>>>//  Displays help topic from sHelpFile based on a string context.
1123>>>>>>>>>>>//
1123>>>>>>>>>>>Procedure gDoWinHelp Global Integer iHelpType String sHelpFile String sContext
1125>>>>>>>>>>>    Integer iVal
1125>>>>>>>>>>>    If (sHelpFile<>"") Begin
1127>>>>>>>>>>>        If (iHelpType = WH_STRINGCONTEXT) ;            Move (WinHelpStr(0, sHelpFile, HELP_PARTIALKEY, sContext)) to iVal
1130>>>>>>>>>>>        Else If (iHelpType = WH_INTCONTEXT) ;            Move (WinHelpCntx(0, sHelpFile, HELP_WCONTEXT, sContext)) to iVal
1134>>>>>>>>>>>        Else If (iHelpType = WH_FINDER) ;            Move (WinHelpCntx(0, sHelpFile, HELP_FINDER, 0)) to iVal
1138>>>>>>>>>>>        Else If (iHelpType = WH_HELPONHELP) ;            Move (WinHelpCntx(0, "", HELP_HELPONHELP, 0)) to iVal
1142>>>>>>>>>>>    End
1142>>>>>>>>>>>>
1142>>>>>>>>>>>End_Procedure
