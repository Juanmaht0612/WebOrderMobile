31032>>>>>>>    
31032>>>>>>>    // called for Select views to refresh the select list during back navigation.
31032>>>>>>>    // If a cancel, there is no target DD and no rowId. Just refresh around what's in the DDO
31032>>>>>>>    // If a close, we have a RowId for a target DDO. If the DDO matches this list's DDO, refresh 
31032>>>>>>>    // around that. 
31032>>>>>>>    // For now this is private
31032>>>>>>>    Procedure RefreshListForBackNavigation Boolean bCancel Handle hoDDTarget RowID riTarget
31034>>>>>>>        Boolean bDataAware bSuccess
31034>>>>>>>        Handle hoDD
31034>>>>>>>        Integer iMain
31034>>>>>>>        RowID riId
31034>>>>>>>        
31034>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
31037>>>>>>>        
31037>>>>>>>        Get pbDataAware to bDataAware
31038>>>>>>>        // if non-data aware there is no list update
31038>>>>>>>        If bDataAware Begin
31040>>>>>>>            // if close & update, with a different rowid refind the rowid passed in. 
31040>>>>>>>            If not bCancel Begin
31042>>>>>>>                Get Server to hoDD
31043>>>>>>>                If (hoDD and hoDD=hoDDTarget) Begin // test to make sure this is an appropriate list to update
31045>>>>>>>                    Get Main_File of hoDD to iMain
31046>>>>>>>                    Get CurrentRowId of hoDD to riId
31047>>>>>>>                    If (not(IsNullRowID(riTarget)) and not(IsSameRowID(riId,riTarget))) Begin
31049>>>>>>>                        // this will cause the list to refresh itself
31049>>>>>>>                        Get FindByRowIdEx of hoDD iMain riTarget to bSuccess
31050>>>>>>>                        If not bSuccess Begin
31052>>>>>>>                            Send HandleCacheError
31053>>>>>>>                        End
31053>>>>>>>>
31053>>>>>>>                        Procedure_Return
31054>>>>>>>                    End
31054>>>>>>>>
31054>>>>>>>                End
31054>>>>>>>>
31054>>>>>>>            End
31054>>>>>>>>
31054>>>>>>>            // else, refresh with current information around existing DD
31054>>>>>>>            Send RefreshListFromDD
31055>>>>>>>        End
31055>>>>>>>>
31055>>>>>>>    End_Procedure
31056>>>>>>>
31056>>>>>>>    
31056>>>>>>>    
31056>>>>>>>    // Refresh a data-aware grid around the current record in the DD
31056>>>>>>>    // If that record is 0 or not found, which you really don't want to happen,
31056>>>>>>>    // just refresh from firsts record
31056>>>>>>>    Procedure RefreshListFromDD
31058>>>>>>>        Handle hoDD
31058>>>>>>>        RowID riId
31058>>>>>>>        Integer iMain
31058>>>>>>>        Boolean bDataAware bSuccess
31058>>>>>>>        Get pbDataAware to bDataAware
31059>>>>>>>        If bDataAware Begin
31061>>>>>>>
31061>>>>>>>            If (pbNotifyingExternalDD(Self)) Begin
31063>>>>>>>                Error DFERR_PROGRAM "Assert: RefreshListFromDD called with pbNotifyingExternalDD set"
31064>>>>>>>>
31064>>>>>>>            End
31064>>>>>>>>
31064>>>>>>>
31064>>>>>>>            Get Server to hoDD
31065>>>>>>>            Get Main_File of hoDD to iMain
31066>>>>>>>            Get CurrentRowId of hoDD to riId
31067>>>>>>>            Move False to bSuccess
31068>>>>>>>            
31068>>>>>>>            If (not(IsNullRowID(riId))) Begin
31070>>>>>>>                // test to see if the record still exists
31070>>>>>>>                Get FindByRowIdEx of hoDD iMain riId to bSuccess 
31071>>>>>>>            End
31071>>>>>>>>
31071>>>>>>>            
31071>>>>>>>            If (not(bSuccess)) Begin
31073>>>>>>>                // missing record, we don't know what to do.
31073>>>>>>>                // Just refresh the entire list
31073>>>>>>>                Get FindInDD hoDD FIRST_RECORD to bSuccess
31074>>>>>>>                If (not(bSuccess)) Begin
31076>>>>>>>                    Send ClearGrid
31077>>>>>>>                End
31077>>>>>>>>
31077>>>>>>>            End
31077>>>>>>>>
31077>>>>>>>        End
31077>>>>>>>>
31077>>>>>>>    End_Procedure
31078>>>>>>>    
31078>>>>>>>    
31078>>>>>>>    // This event procedure is called when a row is clicked within the list and pbServerOnRowClick 
31078>>>>>>>    // is true. It is called after the actual row change is performed which means that if the row 
31078>>>>>>>    // change succeeded the psCurrentRowId matches the clicked row id. In case of a cWebGrid row 
31078>>>>>>>    // changes can fail due to validation issues so in that case the clicked row can be different. 
31078>>>>>>>    // Note that if pbOfflineEditing is true the buffer will not contain the selected row.
31078>>>>>>>    //
31078>>>>>>>    // Params:
31078>>>>>>>    //  sRowID          The rowid of the clicked row.
31078>>>>>>>    //  iColumnIndex    The cWebColumn object index (excl. non-cWebColumn siblings).
31078>>>>>>>    //                  When pressing enter in a cWebList this will be -1.
31078>>>>>>>    Procedure OnRowClick String sRowID Integer iColumnIndex
31080>>>>>>>        //  Empty event stub
31080>>>>>>>    End_Procedure
31081>>>>>>>
31081>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
31081>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
31081>>>>>>>    Procedure GetNavigateBackData Handle hoView tWebNavigateData ByRef NavigateData
31083>>>>>>>        Integer eGridType
31083>>>>>>>        String sId
31083>>>>>>>        Handle hoServer 
31083>>>>>>>        RowID ri
31083>>>>>>>        Boolean bOk bDataAware
31083>>>>>>>        
31083>>>>>>>        // Populate the Navigate Data struct with the best guess values from
31083>>>>>>>        // this control's server DDO
31083>>>>>>>        Get Server to hoServer
31084>>>>>>>        If (hoServer) Begin
31086>>>>>>>            WebGet peDbGridType to eGridType
31087>>>>>>>            WebGet pbDataAware to bDataAware
31088>>>>>>>            If (bDataAware and  eGridType<>gtAutomatic) Begin
31090>>>>>>>                WebGet psCurrentRowId     to sId
31091>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
31092>>>>>>>            End
31092>>>>>>>>
31092>>>>>>>            
31092>>>>>>>            WebGet psCurrentRowId     to sId
31093>>>>>>>            Get CurrentRowId of hoServer to ri
31094>>>>>>>            If (not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
31096>>>>>>>                Error DFERR_PROGRAM "Assert: Different ids in weblist"
31097>>>>>>>>
31097>>>>>>>            End
31097>>>>>>>>
31097>>>>>>>
31097>>>>>>>        End
31097>>>>>>>>
31097>>>>>>>        Forward Send GetNavigateBackData hoView (&NavigateData)
31099>>>>>>>        
31099>>>>>>>    End_Procedure
31100>>>>>>>    
31100>>>>>>>    
31100>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
31100>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
31100>>>>>>>    Procedure GetNavigateForwardData Handle hoView tWebNavigateData ByRef NavigateData
31102>>>>>>>        Integer eGridType
31102>>>>>>>        String sId
31102>>>>>>>        Handle hoServer 
31102>>>>>>>        RowID ri
31102>>>>>>>        Boolean bOk bOldGridAction bFromDynamic
31102>>>>>>>        
31102>>>>>>>        // Populate the Navigate Data struct with the best guess values from
31102>>>>>>>        // this control's server DDO
31102>>>>>>>        Get Server to hoServer
31103>>>>>>>        // if not dataaware there will be no server!
31103>>>>>>>        If (hoServer) Begin
31105>>>>>>>            WebGet peDbGridType to eGridType
31106>>>>>>>            WebGet psCurrentRowId     to sId
31107>>>>>>>            // if not automatic, the server's row Id may not be current yet. 
31107>>>>>>>            If (eGridType<>gtAutomatic) Begin
31109>>>>>>>                Get pbNotifyingExternalDD to bOldGridAction
31110>>>>>>>                Set pbNotifyingExternalDD to True
31111>>>>>>>                Get FindByRowIdEx of hoServer (Main_File(hoServer)) (DeserializeRowID(sId)) to bOk
31112>>>>>>>                Set pbNotifyingExternalDD to bOldGridAction
31113>>>>>>>            End
31113>>>>>>>>
31113>>>>>>>            
31113>>>>>>>            // If the navigation is executed by a dynamic object, we don't care about this sanity check - especially durin initialization
31113>>>>>>>            Get IsDynamicObject to bFromDynamic
31114>>>>>>>            If (not(bFromDynamic) and not(pbGhost(Self))) Begin
31116>>>>>>>                // Assert that the Server's rowid matches the weblist's current row id
31116>>>>>>>                // if the DDO has no record, it is possible it could not refind what it
31116>>>>>>>                // needed and cleared it. We will not consider this an error, although it
31116>>>>>>>                // may display odd stuff (like a cleared parent).
31116>>>>>>>                Get CurrentRowId of hoServer to ri
31117>>>>>>>                If (not(IsNullRowID(ri)) and  not(IsSameRowID(ri,(DeserializeRowID(sId))))) Begin
31119>>>>>>>                    Error DFERR_PROGRAM "Assert: Different ids in weblist"
31120>>>>>>>>
31120>>>>>>>                End
31120>>>>>>>>
31120>>>>>>>            End
31120>>>>>>>>
31120>>>>>>>
31120>>>>>>>        End
31120>>>>>>>>
31120>>>>>>>        Forward Send GetNavigateForwardData hoView (&NavigateData)
31122>>>>>>>    
31122>>>>>>>    End_Procedure
31123>>>>>>>    
31123>>>>>>>    // Special augmentation for weblists. If this is not a dataaware grid, we want the server
31123>>>>>>>    // to be 0. We also want any child DEOs to have a 0 server, which they will
31123>>>>>>>    Function Server Returns Integer
31125>>>>>>>        Boolean bDataAware
31125>>>>>>>        Handle hoServer
31125>>>>>>>        
31125>>>>>>>        // note we use the property and not the web-property. Even though this is a web-property
31125>>>>>>>        // it is not expected that this would ever be webset changed
31125>>>>>>>        Get pbDataAware to bDataAware
31126>>>>>>>        If (bDataAware) Begin
31128>>>>>>>            Forward Get Server to hoServer
31130>>>>>>>        End
31130>>>>>>>>
31130>>>>>>>        Function_Return hoServer
31131>>>>>>>    End_Function
31132>>>>>>>
31132>>>>>>>    // This message is broadcast to all controls in a list view when
31132>>>>>>>    // navigating to the view. It is intended to allow the controls to set the
31132>>>>>>>    // ordering of row data (e.g. piOrdering)
31132>>>>>>>    Procedure InitOrdering tWebNavigateData NavigateData Handle hoInvokingObject
31134>>>>>>>        Integer iMainTable iSortCol
31134>>>>>>>        Integer eDbGridType
31134>>>>>>>        Handle hoServer hoMainDD
31134>>>>>>>        Boolean bDataAware bReverseOrdering
31134>>>>>>>    
31134>>>>>>>        Get Server to hoServer
31135>>>>>>>        Get Main_DD to hoMainDD
31136>>>>>>>        
31136>>>>>>>        // If no server or the server is not the view's main server, do nothing
31136>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
31138>>>>>>>            Procedure_Return
31139>>>>>>>        End
31139>>>>>>>>
31139>>>>>>>        
31139>>>>>>>        Get pbDataAware to bDataAware
31140>>>>>>>        Get peDbGridType to eDbGridType
31141>>>>>>>        
31141>>>>>>>        // restore to design time values
31141>>>>>>>        Get pbReverseOrdering to bReverseOrdering
31142>>>>>>>        WebSet pbReverseOrdering to bReverseOrdering
31143>>>>>>>
31143>>>>>>>        Get piSortColumn to iSortCol
31144>>>>>>>        WebSet piSortColumn to iSortCol
31145>>>>>>>
31145>>>>>>>        // if data-aware and autoloading we assign an automatic sort column    
31145>>>>>>>        If (eDbGridType <> gtManual and bDataAware) Begin
31147>>>>>>>            If (NavigateData.eNavigateType <> nfFromParent) Begin
31149>>>>>>>                Get Main_File of hoServer to iMainTable
31150>>>>>>>                If (iMainTable = NavigateData.iTable and iMainTable <> 0) Begin
31152>>>>>>>                    Get SelectBestColumn NavigateData.iTable NavigateData.iColumn to iSortCol
31153>>>>>>>                    If (iSortCol>=0) Begin
31155>>>>>>>                        WebSet piSortColumn to iSortCol
31156>>>>>>>                    End
31156>>>>>>>>
31156>>>>>>>                End
31156>>>>>>>>
31156>>>>>>>            End
31156>>>>>>>>
31156>>>>>>>        End
31156>>>>>>>>
31156>>>>>>>    End_Procedure 
31157>>>>>>>    
31157>>>>>>>    // This message is broadcast to a Select view when navigating to the view and there is no 
31157>>>>>>>    // record for the grid. It is intended to allow the list control to fill itself
31157>>>>>>>    // automatically when appropriate. It only does a fill if this is data aware grid,
31157>>>>>>>    // and the grid's server is the view's main DD. It simply loads from the "first" record 
31157>>>>>>>    Procedure InitGrid tWebNavigateData NavigateData Handle hoInvokingObject
31159>>>>>>>        Integer iIndex iMainTable
31159>>>>>>>        Integer eDbGridType
31159>>>>>>>        Handle hoServer hoMainDD
31159>>>>>>>        Boolean bSeeded bReverseOrdering bDataAware
31159>>>>>>>        Boolean bOldGridAction
31159>>>>>>>    
31159>>>>>>>        Get Server to hoServer
31160>>>>>>>        Get Main_DD to hoMainDD
31161>>>>>>>        If (hoServer=0 or hoServer<>hoMainDD) Begin
31163>>>>>>>            Procedure_Return
31164>>>>>>>        End
31164>>>>>>>>
31164>>>>>>>        
31164>>>>>>>        Get pbDataAware to bDataAware
31165>>>>>>>        Get peDbGridType to eDbGridType
31166>>>>>>>        
31166>>>>>>>        // if manually loaded or not data aware we will not do any init here. It can be done
31166>>>>>>>        // in OnNavigateForward
31166>>>>>>>        If (eDbGridType = gtManual or not(bDataAware)) Begin
31168>>>>>>>            Procedure_Return
31169>>>>>>>        End
31169>>>>>>>>
31169>>>>>>>        
31169>>>>>>>        Get pbReverseOrdering to bReverseOrdering
31170>>>>>>>        Get Main_File of hoServer to iMainTable
31171>>>>>>>        Get IndexOrder to iIndex
31172>>>>>>>
31172>>>>>>>        // Init list at the "start"
31172>>>>>>>        If (bReverseOrdering) Begin
31174>>>>>>>            Send Find of hoServer LAST_RECORD iIndex
31175>>>>>>>        End
31175>>>>>>>>
31175>>>>>>>        Else Begin
31176>>>>>>>            Send Find of hoServer FIRST_RECORD iIndex
31177>>>>>>>        End
31177>>>>>>>>
31177>>>>>>>
31177>>>>>>>        // If the seeding succeeded then ensure that all controls latch onto this
31177>>>>>>>        // otherwise just clear the DDOs
31177>>>>>>>        Get HasRecord of hoServer to bSeeded
31178>>>>>>>        
31178>>>>>>>        If bSeeded Begin
31180>>>>>>>            // this only updates the current record and does not refill the grid
31180>>>>>>>            Get pbNotifyingExternalDD to bOldGridAction
31181>>>>>>>            Set pbNotifyingExternalDD to True
31182>>>>>>>            Send Request_Assign of hoServer
31183>>>>>>>            Set pbNotifyingExternalDD to bOldGridAction
31184>>>>>>>        End
31184>>>>>>>>
31184>>>>>>>        Else Begin
31185>>>>>>>            Send ClearGrid
31186>>>>>>>        End
31186>>>>>>>>
31186>>>>>>>    End_Procedure 
31187>>>>>>>
31187>>>>>>>    Function SelectBestColumn Integer iFile Integer iField Returns Integer
31189>>>>>>>        Integer iCol iColFile iColField
31189>>>>>>>        Boolean bCol
31189>>>>>>>        Handle[] hoColumnObjects
31190>>>>>>>        
31190>>>>>>>        Get phoColumnObjects to hoColumnObjects
31191>>>>>>>        For iCol from 0 to (SizeOfArray(hoColumnObjects)-1)
31197>>>>>>>>
31197>>>>>>>            Get pbIsWebColumn of hoColumnObjects[iCol] to bCol
31198>>>>>>>            If (bCol) Begin
31200>>>>>>>                Get Data_File of hoColumnObjects[iCol] iCol to iColFile
31201>>>>>>>                If iFile Begin
31203>>>>>>>                    Get Data_Field of hoColumnObjects[iCol] iCol to iColField
31204>>>>>>>                    If (iColFile=iFile and iColField=iField) Begin
31206>>>>>>>                        Function_Return iCol
31207>>>>>>>                    End
31207>>>>>>>>
31207>>>>>>>                End
31207>>>>>>>>
31207>>>>>>>            End
31207>>>>>>>>
31207>>>>>>>        Loop
31208>>>>>>>>
31208>>>>>>>        Function_Return -1
31209>>>>>>>    End_Function
