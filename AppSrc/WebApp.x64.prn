33051>>>>>>>>>    // Variant functions that allow you to move between a variant string (wide char) and other
33051>>>>>>>>>    // buffer and string types. Normally a Move vVar to sVar does a OEM/Unicode translation. These
33051>>>>>>>>>    // allow you translate to other formats (UTF8, OEM and ANSI)
33051>>>>>>>>>    
33051>>>>>>>>>    // Create data buffer from variant string. data buffer is encoded by eCharType
33051>>>>>>>>>    Function VariantStrToBuffer Variant vValue Integer eCharType Returns Pointer
33053>>>>>>>>>        Pointer pBSTR pRetStr
33053>>>>>>>>>        Integer iLen iBufLen
33053>>>>>>>>>        Boolean bOk
33053>>>>>>>>>        Move 0 to pRetStr
33054>>>>>>>>>        Move (VariantStringLength( vValue)) to iLen
33055>>>>>>>>>        If (iLen) Begin
33057>>>>>>>>>            Move (DeRefPtr(AddressOf(vValue),8)) to pBSTR
33058>>>>>>>>>            Move (WideToMultiBuffer(eCharType,pBSTR,iLen,AddressOf(pRetStr))) to iBufLen
33059>>>>>>>>>        End
33059>>>>>>>>>>
33059>>>>>>>>>        Function_Return pRetStr
33060>>>>>>>>>    End_Function
33061>>>>>>>>>    
33061>>>>>>>>>    // Create string from variant string. data buffer is encoded by eCharType
33061>>>>>>>>>    
33061>>>>>>>>>    Function VariantStrToStr Variant vValue Integer eCharType Returns String
33063>>>>>>>>>        String sValue
33063>>>>>>>>>        Pointer pValue
33063>>>>>>>>>        Boolean bOk
33063>>>>>>>>>        Get VariantStrToBuffer vValue eCharType to pValue
33064>>>>>>>>>        If (not(ValidStringBufferLength(pValue))) Begin
33066>>>>>>>>>            Error DFERR_PROGRAM "Buffer exceeds maximum string size"
33067>>>>>>>>>>
33067>>>>>>>>>        End
33067>>>>>>>>>>
33067>>>>>>>>>        Move (PointerToString(pValue)) to sValue
33068>>>>>>>>>        Move (Free(pValue)) to bOk
33069>>>>>>>>>        Function_Return sValue
33070>>>>>>>>>    End_Function
33071>>>>>>>>>    
33071>>>>>>>>>    // Create variant string from data buffer. data buffer is encoded by eCharType
33071>>>>>>>>>    
33071>>>>>>>>>    Function VariantStrFromBuffer Pointer pSource Integer eCodeType Returns Variant
33073>>>>>>>>>        Variant vValue
33073>>>>>>>>>        Pointer pvValue
33073>>>>>>>>>        Boolean bOk
33073>>>>>>>>>        Pointer pWStr
33073>>>>>>>>>        Move "" to vValue
33074>>>>>>>>>        If (pSource) Begin
33076>>>>>>>>>            //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
33076>>>>>>>>>            Move 0 to pWStr
33077>>>>>>>>>            //Convert the Ansi string to Unicode
33077>>>>>>>>>            Move (MultiToWideBuffer( eCodeType, pSource, CStringSize(pSource), AddressOf(pWStr))) to bOk
33078>>>>>>>>>            //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
33078>>>>>>>>>            Move 0 to vValue
33079>>>>>>>>>            Move (AddressOf(vValue)) to pvValue
33080>>>>>>>>>            //Change the Variant type to VT_BSTR
33080>>>>>>>>>            Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk
33081>>>>>>>>>            //Allocate a proper COM BSTR, assign the Unicode string, and store the BSTR in the Variant variable
33081>>>>>>>>>            Move (StorePtr(pvValue,8,SysAllocString(pWStr))) to bOk
33082>>>>>>>>>            //Now clear up the Unicode string, the Variant owns a BSTR copy of the string
33082>>>>>>>>>            Move (Free(pWStr)) to bOk
33083>>>>>>>>>        End
33083>>>>>>>>>>
33083>>>>>>>>>        Function_Return vValue
33084>>>>>>>>>    End_Function
33085>>>>>>>>>    
33085>>>>>>>>>    // Create variant string from data string. data string is encoded by eCharType
33085>>>>>>>>>    
33085>>>>>>>>>    Function VariantStrFromStr String sValue Integer eCodeType Returns Variant
33087>>>>>>>>>        Variant vValue
33087>>>>>>>>>        Get VariantStrFromBuffer (AddressOf(sValue)) eCodeType to vValue
33088>>>>>>>>>        Function_Return vValue
33089>>>>>>>>>    End_Function
33090>>>>>>>>>    
33090>>>>>>>>>    // Create buffer of utf16 data from variant.
33090>>>>>>>>>    // Returns newly created memory address and length (by reference)
33090>>>>>>>>>    Function VariantStrToUTF16 Variant vValue Integer ByRef iLen Returns Pointer
33092>>>>>>>>>        Pointer pBSTR pRetStr
33092>>>>>>>>>        Boolean bOk
33092>>>>>>>>>        Move 0 to pRetStr
33093>>>>>>>>>        Move (VariantStringLength( vValue)) to iLen
33094>>>>>>>>>        If (iLen) Begin
33096>>>>>>>>>            Move (DeRefPtr(AddressOf(vValue),8)) to pBSTR
33097>>>>>>>>>            Move (Alloc(iLen+1 * 2)) to pRetStr
33098>>>>>>>>>            Move (MemCopy(pRetStr,pBSTR,(iLen+1 * 2))) to bOk
33099>>>>>>>>>        End
33099>>>>>>>>>>
33099>>>>>>>>>        Function_Return pRetStr
33100>>>>>>>>>    End_Function
33101>>>>>>>>>    
33101>>>>>>>>>    // Create variant from buffer of utf16 data
33101>>>>>>>>>    Function VariantStrFromUTF16 Pointer pSource Returns Variant
33103>>>>>>>>>        Variant vValue
33103>>>>>>>>>        Pointer pvValue
33103>>>>>>>>>        Boolean bOk
33103>>>>>>>>>        Move "" to vValue
33104>>>>>>>>>        If (pSource) Begin
33106>>>>>>>>>            //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
33106>>>>>>>>>            //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
33106>>>>>>>>>            Move 0 to vValue
33107>>>>>>>>>            Move (AddressOf(vValue)) to pvValue
33108>>>>>>>>>            //Change the Variant type to VT_BSTR
33108>>>>>>>>>            Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk
33109>>>>>>>>>            //Allocate a proper COM BSTR, assign the Unicode string, and store the BSTR in the Variant variable
33109>>>>>>>>>            Move (StorePtr(pvValue,8,SysAllocString(pSource))) to bOk
33110>>>>>>>>>        End
33110>>>>>>>>>>
33110>>>>>>>>>        Function_Return vValue
33111>>>>>>>>>    End_Function
33112>>>>>>>>>    
33112>>>>>>>>>    // Create Uchar array from variant string.
33112>>>>>>>>>    // Data buffer is encoded by eCharType
33112>>>>>>>>>    Function VariantStrToUCharArray Variant vValue Integer eCharType Returns UChar[]
33114>>>>>>>>>        Pointer pBSTR pRetStr
33114>>>>>>>>>        Integer iLen iBufLen
33114>>>>>>>>>        Boolean bOk
33114>>>>>>>>>        UChar[] UC1
33115>>>>>>>>>        Move 0 to pRetStr
33116>>>>>>>>>        Move (VariantStringLength( vValue)) to iLen
33117>>>>>>>>>        If (iLen) Begin
33119>>>>>>>>>            Move (DeRefPtr(AddressOf(vValue),8)) to pBSTR
33120>>>>>>>>>            If (eCharType=CP_UTF16) Begin
33122>>>>>>>>>                Move (iLen*2) to iBufLen
33123>>>>>>>>>                Move (ResizeArray(UC1,iBufLen)) to UC1
33124>>>>>>>>>                Move (MemCopy(AddressOf(UC1),pBSTR,iBufLen)) to bOk
33125>>>>>>>>>            End
33125>>>>>>>>>>
33125>>>>>>>>>            Else Begin
33126>>>>>>>>>                Move (WideToMultiBuffer(eCharType,pBSTR,iLen,AddressOf(pRetStr))) to iBufLen
33127>>>>>>>>>                Move (ResizeArray(UC1,iBufLen)) to UC1
33128>>>>>>>>>                Move (MemCopy(AddressOf(UC1),pRetStr,iBufLen)) to bOk
33129>>>>>>>>>                Move (Free(pRetStr)) to bOk
33130>>>>>>>>>            End
33130>>>>>>>>>>
33130>>>>>>>>>        End
33130>>>>>>>>>>
33130>>>>>>>>>        Function_Return UC1
33131>>>>>>>>>    End_Function
33132>>>>>>>>>    
33132>>>>>>>>>    // Create variant string from UChar array. data is encoded by eCharType
33132>>>>>>>>>    Function VariantStrFromUCharArray UChar[] ucSource Integer eCodeType Returns Variant
33134>>>>>>>>>        Variant vValue
33134>>>>>>>>>        Pointer pvValue
33134>>>>>>>>>        Boolean bOk
33134>>>>>>>>>        Pointer pWStr
33134>>>>>>>>>        Move "" to vValue
33135>>>>>>>>>        
33135>>>>>>>>>        //Initialize pWstr variable so it has the correct type and AddressOf will return a proper pointer
33135>>>>>>>>>        Move 0 to pWStr
33136>>>>>>>>>        //Convert the Ansi string to Unicode
33136>>>>>>>>>        If (eCodeType=CP_UTF16) Begin
33138>>>>>>>>>            Move 0 to ucSource[SizeOfArray(ucSource)]
33139>>>>>>>>>            Move 0 to ucSource[SizeOfArray(ucSource)]
33140>>>>>>>>>            Move (AddressOf(ucSource)) to pWStr
33141>>>>>>>>>        End
33141>>>>>>>>>>
33141>>>>>>>>>        Else Begin
33142>>>>>>>>>            Move (MultiToWideBuffer( eCodeType, AddressOf(ucSource), SizeOfArray(ucSource), AddressOf(pWStr))) to bOk
33143>>>>>>>>>        End
33143>>>>>>>>>>
33143>>>>>>>>>        //Initialize vValue variable so it has the correct type and AddressOf will return a proper pointer
33143>>>>>>>>>        Move 0 to vValue
33144>>>>>>>>>        Move (AddressOf(vValue)) to pvValue
33145>>>>>>>>>        //Change the Variant type to VT_BSTR
33145>>>>>>>>>        Move (StoreDw(pvValue,0,OLE_VT_Bstr)) to bOk
33146>>>>>>>>>        //Allocate a proper COM BSTR, assign the Unicode string, and store the BSTR in the Variant variable
33146>>>>>>>>>        Move (StorePtr(pvValue,8,SysAllocString(pWStr))) to bOk
33147>>>>>>>>>        //Now clear up the Unicode string, the Variant owns a BSTR copy of the string
33147>>>>>>>>>        If (eCodeType<>CP_UTF16) Begin
33149>>>>>>>>>            Move (Free(pWStr)) to bOk
33150>>>>>>>>>        End
33150>>>>>>>>>>
33150>>>>>>>>>        Function_Return vValue
33151>>>>>>>>>    End_Function
33152>>>>>>>>>    
33152>>>>>>>>>    
33152>>>>>>>>>    // UChar array conversions. Converts a passed uchar array with from-encoding to
33152>>>>>>>>>    // a new UChar array with to-encoding
33152>>>>>>>>>    
33152>>>>>>>>>    Function ConvertUCharArray UChar[] UCharData Integer iFromCP Integer iToCP Returns UChar[]
33154>>>>>>>>>        Pointer pFromBuf pToBuf
33154>>>>>>>>>        Integer iBytes iChars
33154>>>>>>>>>        Boolean bOk
33154>>>>>>>>>        
33154>>>>>>>>>        Move (SizeOfArray(UCharData)) to iBytes
33155>>>>>>>>>        If (iFromCP=iToCP or iBytes=0) Begin
33157>>>>>>>>>            Function_Return UCharData
33158>>>>>>>>>        End
33158>>>>>>>>>>
33158>>>>>>>>>        
33158>>>>>>>>>        If (iFromCP<>CP_UTF16) Begin
33160>>>>>>>>>            Move 0 to UCharData[iBytes] // extend to make sure we have 0 at end
33161>>>>>>>>>            Get Utf16FromBuffer (AddressOf(UCharData)) iFromCP (&iChars) to pFromBuf
33162>>>>>>>>>        End
33162>>>>>>>>>>
33162>>>>>>>>>        Else Begin
33163>>>>>>>>>            Move (iBytes/2) to iChars // if from is utf16
33164>>>>>>>>>        End
33164>>>>>>>>>>
33164>>>>>>>>>        
33164>>>>>>>>>        If (iToCP<>CP_UTF16) Begin
33166>>>>>>>>>            If (iFromCP=CP_UTF16) Begin
33168>>>>>>>>>                Get Utf16ToBuffer (AddressOf(UCharData)) iToCP iChars to pToBuf
33169>>>>>>>>>            End
33169>>>>>>>>>>
33169>>>>>>>>>            Else Begin
33170>>>>>>>>>                Get Utf16ToBuffer pFromBuf iToCP iChars to pToBuf
33171>>>>>>>>>                Move (Free(pFromBuf)) to bOk
33172>>>>>>>>>            End
33172>>>>>>>>>>
33172>>>>>>>>>            Move (CStringSize(pToBuf)) to iBytes
33173>>>>>>>>>        End
33173>>>>>>>>>>
33173>>>>>>>>>        Else Begin
33174>>>>>>>>>            Move (iChars*2) to iBytes
33175>>>>>>>>>            Move pFromBuf to pToBuf
33176>>>>>>>>>        End
33176>>>>>>>>>>
33176>>>>>>>>>        Move (ResizeArray(UCharData,iBytes)) to UCharData
33177>>>>>>>>>        Move (MemCopy(AddressOf(UCharData),pToBuf,iBytes)) to bOk
33178>>>>>>>>>        Move (Free(pToBuf)) to bOk
33179>>>>>>>>>        Function_Return UCharData
33180>>>>>>>>>    End_Function
