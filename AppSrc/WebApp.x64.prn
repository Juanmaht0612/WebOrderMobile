3946>>>>>    // Augment to remove Page Label if required
3946>>>>>    //
3946>>>>>    Procedure Page_Delete
3948>>>>>        Handle hoLabel
3948>>>>>        Get Label_object to hoLabel
3949>>>>>        If (hoLabel and Window_Handle(hoLabel)) Begin
3951>>>>>            // if the textbox is still paged we must unpage it. We must use page_object
3951>>>>>            // and not page_delete or the runtime will still think the object is in the "paged list".
3951>>>>>            Send Page_Object of hoLabel False
3952>>>>>        End
3952>>>>>>
3952>>>>>        Forward Send Page_Delete
3954>>>>>    End_Procedure
