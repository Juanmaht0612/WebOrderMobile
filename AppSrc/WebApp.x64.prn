26438>>>>>>>>>>>>>>>>>    Integer iVariableDataType
26438>>>>>>>>>>>>>>>>>End_Struct
26438>>>>>>>>>>>>>>>>>
26438>>>>>>>>>>>>>>>>>// Statement object for embedded sql                           
26438>>>>>>>>>>>>>>>>>//   An object is created for each statement. These will be children    
26438>>>>>>>>>>>>>>>>>//   of cSQLConnection objects which manage the create and destruction  
26438>>>>>>>>>>>>>>>>>//   of these.                                                          
26438>>>>>>>>>>>>>>>>>
26438>>>>>>>>>>>>>>>>>Class cSQLStatement is a cObject
26439>>>>>>>>>>>>>>>>>    
26439>>>>>>>>>>>>>>>>>    Procedure Construct_object
26441>>>>>>>>>>>>>>>>>        Forward Send Construct_object
26443>>>>>>>>>>>>>>>>>        
26443>>>>>>>>>>>>>>>>>        Property Handle  phCLIStatementHandle   0
26444>>>>>>>>>>>>>>>>>        Property Handle  phCLIConnectionHandle  0
26445>>>>>>>>>>>>>>>>>        Property String  psDriverID             ""
26446>>>>>>>>>>>>>>>>>        
26446>>>>>>>>>>>>>>>>>        Property Integer piLastColumn      0
26447>>>>>>>>>>>>>>>>>        Property Integer piLastArgument    0
26448>>>>>>>>>>>>>>>>>        Property Integer piBindFile        0
26449>>>>>>>>>>>>>>>>>        
26449>>>>>>>>>>>>>>>>>        Property Integer piColumnCount     0
26450>>>>>>>>>>>>>>>>>        
26450>>>>>>>>>>>>>>>>>        // True if there is at least 1 column with a variable length data type
26450>>>>>>>>>>>>>>>>>        Property Integer piHasVariableDataType  0
26451>>>>>>>>>>>>>>>>>        
26451>>>>>>>>>>>>>>>>>        // Max size of buffer for variable length data. Default 16000
26451>>>>>>>>>>>>>>>>>        Property Integer piMaxVariableBufferLength 16000
26452>>>>>>>>>>>>>>>>>        
26452>>>>>>>>>>>>>>>>>        // Allocated buffer for SQLGetData.
26452>>>>>>>>>>>>>>>>>        Property WString psVariableBuffer  ""
26453>>>>>>>>>>>>>>>>>        
26453>>>>>>>>>>>>>>>>>        // Allocated size of psVariableBuffer
26453>>>>>>>>>>>>>>>>>        Property Integer piVariableBufferLength 0
26454>>>>>>>>>>>>>>>>>        
26454>>>>>>>>>>>>>>>>>        // Stores column properties of a result set.
26454>>>>>>>>>>>>>>>>>        Property tSQLColumn[] paSQLColumns
26455>>>>>>>>>>>>>>>>>        
26455>>>>>>>>>>>>>>>>>        // piFetchResult is set by SQLFetchRowValues and SQLFetchResultSetValues
26455>>>>>>>>>>>>>>>>>        //   0    = Fetch returned no data.
26455>>>>>>>>>>>>>>>>>        //   <> 0 = Row fetched
26455>>>>>>>>>>>>>>>>>        Property Integer piFetchResult     0
26456>>>>>>>>>>>>>>>>>        
26456>>>>>>>>>>>>>>>>>        
26456>>>>>>>>>>>>>>>>>        Property String psDummyZeroDate              '0001-01-01'
26457>>>>>>>>>>>>>>>>>        Property String psDummyZeroDateMssqlDatetime '1753-01-01'
26458>>>>>>>>>>>>>>>>>        
26458>>>>>>>>>>>>>>>>>    End_Procedure
26459>>>>>>>>>>>>>>>>>    
26459>>>>>>>>>>>>>>>>>    // Store basic information about the statement.
26459>>>>>>>>>>>>>>>>>    Procedure StoreStatementInfo Handle hCLIStatementHandle String sDrvrId Handle hCLIConnectionHandle
26461>>>>>>>>>>>>>>>>>        
26461>>>>>>>>>>>>>>>>>        Set phCLIStatementHandle   to hCLIStatementHandle
26462>>>>>>>>>>>>>>>>>        Set phCLIConnectionHandle  to hCLIConnectionHandle
26463>>>>>>>>>>>>>>>>>        Set psDriverID             to sDrvrId
26464>>>>>>>>>>>>>>>>>        
26464>>>>>>>>>>>>>>>>>    End_Procedure
26465>>>>>>>>>>>>>>>>>    
26465>>>>>>>>>>>>>>>>>    
26465>>>>>>>>>>>>>>>>>    // Destroy the cSQLStatement object
26465>>>>>>>>>>>>>>>>>    Procedure DestroySQLStatement
26467>>>>>>>>>>>>>>>>>        Send Destroy
26468>>>>>>>>>>>>>>>>>    End_Procedure
26469>>>>>>>>>>>>>>>>>    
26469>>>>>>>>>>>>>>>>>    // Handle an error that has occurred while checking properties.
26469>>>>>>>>>>>>>>>>>    Procedure HandleError Integer ihstmt Integer ihdbc String sDrvrId String sOriginMsg
26471>>>>>>>>>>>>>>>>>        Integer iErrHandle
26471>>>>>>>>>>>>>>>>>        Integer iErrNum
26471>>>>>>>>>>>>>>>>>        String  sLocationInfo
26471>>>>>>>>>>>>>>>>>        
26471>>>>>>>>>>>>>>>>>        // Get the DataFlex statement identifier
26471>>>>>>>>>>>>>>>>>        Move Self to iErrHandle
26472>>>>>>>>>>>>>>>>>        
26472>>>>>>>>>>>>>>>>>        // Determine error number
26472>>>>>>>>>>>>>>>>>        If (ihstmt = 0) ;            Move CLIERR_SQLINVALID_CLI_STMT_HANDLE to iErrNum
26475>>>>>>>>>>>>>>>>>        Else If (ihdbc = 0) ;            Move CLIERR_SQLINVALID_CLI_CONN_HANDLE to iErrNum
26479>>>>>>>>>>>>>>>>>        Else If (sDrvrId = "") ;            Move CLIERR_SQLINVALID_DRIVER_ID to iErrNum
26483>>>>>>>>>>>>>>>>>        Else ;            Move CLIERR_SQL_ERROR to iErrNum
26485>>>>>>>>>>>>>>>>>        
26485>>>>>>>>>>>>>>>>>        // Create location ifnormation
26485>>>>>>>>>>>>>>>>>        Move "[" to sLocationInfo
26486>>>>>>>>>>>>>>>>>        If (sOriginMsg <> "") Begin
26488>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, sOriginMsg)) to sLocationInfo
26489>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, ", "))       to sLocationInfo
26490>>>>>>>>>>>>>>>>>        End
26490>>>>>>>>>>>>>>>>>>
26490>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) to sLocationInfo
26491>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, iErrHandle))          to sLocationInfo
26492>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, "]"))                 to sLocationInfo
26493>>>>>>>>>>>>>>>>>        
26493>>>>>>>>>>>>>>>>>        // Generate the error
26493>>>>>>>>>>>>>>>>>        Error iErrNum sLocationInfo
26494>>>>>>>>>>>>>>>>>>
26494>>>>>>>>>>>>>>>>>    End_Procedure
26495>>>>>>>>>>>>>>>>>    
26495>>>>>>>>>>>>>>>>>    // Handle general error not related to the properties
26495>>>>>>>>>>>>>>>>>    Procedure StmtError Integer iErrNum String sErrText String sOriginMsg
26497>>>>>>>>>>>>>>>>>        Integer iErrHandle
26497>>>>>>>>>>>>>>>>>        String  sLocationInfo
26497>>>>>>>>>>>>>>>>>        
26497>>>>>>>>>>>>>>>>>        // Get the DataFlex statement identifier
26497>>>>>>>>>>>>>>>>>        Move Self to iErrHandle
26498>>>>>>>>>>>>>>>>>        
26498>>>>>>>>>>>>>>>>>        // Create location information
26498>>>>>>>>>>>>>>>>>        Move "[" to sLocationInfo
26499>>>>>>>>>>>>>>>>>        If (sOriginMsg <> "") Begin
26501>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, sOriginMsg)) to sLocationInfo
26502>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, ", "))       to sLocationInfo
26503>>>>>>>>>>>>>>>>>        End
26503>>>>>>>>>>>>>>>>>>
26503>>>>>>>>>>>>>>>>>        If (sErrtext <> "") Begin
26505>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, sErrtext)) to sLocationInfo
26506>>>>>>>>>>>>>>>>>            Move (Append(sLocationInfo, ", "))     to sLocationInfo
26507>>>>>>>>>>>>>>>>>        End
26507>>>>>>>>>>>>>>>>>>
26507>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, "DataFlex hstmt = ")) to sLocationInfo
26508>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, iErrHandle))          to sLocationInfo
26509>>>>>>>>>>>>>>>>>        Move (Append(sLocationInfo, "]"))                 to sLocationInfo
26510>>>>>>>>>>>>>>>>>        
26510>>>>>>>>>>>>>>>>>        // Generate the error
26510>>>>>>>>>>>>>>>>>        Error iErrNum sLocationInfo
26511>>>>>>>>>>>>>>>>>>
26511>>>>>>>>>>>>>>>>>    End_Procedure
26512>>>>>>>>>>>>>>>>>    
26512>>>>>>>>>>>>>>>>>    // Handle an illegal attribute error
26512>>>>>>>>>>>>>>>>>    Procedure SQLIllegalAttribute String sErrText String sOriginMsg
26514>>>>>>>>>>>>>>>>>        Integer bReport
26514>>>>>>>>>>>>>>>>>        
26514>>>>>>>>>>>>>>>>>        Get_Attribute DF_REPORT_UNSUPPORTED_ATTRIBUTES to bReport
26517>>>>>>>>>>>>>>>>>        If (bReport) ;            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE sErrtext sOriginMsg
26520>>>>>>>>>>>>>>>>>    End_Procedure
26521>>>>>>>>>>>>>>>>>    
26521>>>>>>>>>>>>>>>>>    // Check if a column number is legal
26521>>>>>>>>>>>>>>>>>    Function SQLPrivateColumnIsLegal Integer ihdbc String sDrvrId Integer ihstmt Integer iCol Returns Integer
26523>>>>>>>>>>>>>>>>>        Integer bLegal
26523>>>>>>>>>>>>>>>>>        Integer iNumColumns
26523>>>>>>>>>>>>>>>>>        
26523>>>>>>>>>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
26524>>>>>>>>>>>>>>>>>        If (iCol > 0 and iCol <= iNumColumns) ;            Move DFTRUE to bLegal
26527>>>>>>>>>>>>>>>>>        Else ;            Move DFFALSE to bLegal
26529>>>>>>>>>>>>>>>>>        
26529>>>>>>>>>>>>>>>>>        Function_Return bLegal
26530>>>>>>>>>>>>>>>>>    End_Function
26531>>>>>>>>>>>>>>>>>    
26531>>>>>>>>>>>>>>>>>    
26531>>>>>>>>>>>>>>>>>    
26531>>>>>>>>>>>>>>>>>    // Close a statement and free all alllocated resources
26531>>>>>>>>>>>>>>>>>    Procedure SQLClose
26533>>>>>>>>>>>>>>>>>        Integer ihdbc
26533>>>>>>>>>>>>>>>>>        Integer ihstmt
26533>>>>>>>>>>>>>>>>>        Integer iVoid
26533>>>>>>>>>>>>>>>>>        String  sDrvrId
26533>>>>>>>>>>>>>>>>>        String  sEmpty
26533>>>>>>>>>>>>>>>>>        
26533>>>>>>>>>>>>>>>>>        // Initialize
26533>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26534>>>>>>>>>>>>>>>>>        
26534>>>>>>>>>>>>>>>>>        // Get the cli handles
26534>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26535>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26536>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26537>>>>>>>>>>>>>>>>>        
26537>>>>>>>>>>>>>>>>>        // Free the CLI handle
26537>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26539>>>>>>>>>>>>>>>>>            // Call the driver function to close
26539>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCLOSE ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
26544>>>>>>>>>>>>>>>>>            
26544>>>>>>>>>>>>>>>>>            Move -1 to giLastSQLhstmt
26545>>>>>>>>>>>>>>>>>            // Free the DataFlex handle
26545>>>>>>>>>>>>>>>>>            Send DestroySQLStatement
26546>>>>>>>>>>>>>>>>>        End
26546>>>>>>>>>>>>>>>>>>
26546>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLClose"
26548>>>>>>>>>>>>>>>>>    End_Procedure
26549>>>>>>>>>>>>>>>>>    
26549>>>>>>>>>>>>>>>>>    // Prepare a statement for execution
26549>>>>>>>>>>>>>>>>>    Procedure SQLPrepare String sStatement
26551>>>>>>>>>>>>>>>>>        Integer ihdbc
26551>>>>>>>>>>>>>>>>>        Integer ihstmt
26551>>>>>>>>>>>>>>>>>        Integer iVoid
26551>>>>>>>>>>>>>>>>>        String  sDrvrId
26551>>>>>>>>>>>>>>>>>        
26551>>>>>>>>>>>>>>>>>        // Get the cli handles
26551>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26552>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26553>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26554>>>>>>>>>>>>>>>>>        
26554>>>>>>>>>>>>>>>>>        // Prepare
26554>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26556>>>>>>>>>>>>>>>>>            // Call the driver function to prepare
26556>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLPREPARE ;                Callback Self ;                Passing ihdbc sStatement ihstmt ;                Result iVoid
26561>>>>>>>>>>>>>>>>>            Set piLastArgument to 0
26562>>>>>>>>>>>>>>>>>
26562>>>>>>>>>>>>>>>>>        End
26562>>>>>>>>>>>>>>>>>>
26562>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrepare"
26564>>>>>>>>>>>>>>>>>    End_Procedure
26565>>>>>>>>>>>>>>>>>    
26565>>>>>>>>>>>>>>>>>    Procedure SQLGetStatementAttributes
26567>>>>>>>>>>>>>>>>>        Integer ihdbc ihstmt iNumColumns iCol iMaxSize
26567>>>>>>>>>>>>>>>>>        String sMaxValue
26567>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26567>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26568>>>>>>>>>>>>>>>>>        
26568>>>>>>>>>>>>>>>>>        Integer iSqlType
26568>>>>>>>>>>>>>>>>>        Integer iSQLSize
26568>>>>>>>>>>>>>>>>>        Integer iSQLprecision
26568>>>>>>>>>>>>>>>>>        Integer iVariableDataType
26568>>>>>>>>>>>>>>>>>        
26568>>>>>>>>>>>>>>>>>        String  sDrvrId
26568>>>>>>>>>>>>>>>>>        
26568>>>>>>>>>>>>>>>>>        Integer iHasVariableDataType
26568>>>>>>>>>>>>>>>>>        
26568>>>>>>>>>>>>>>>>>        Move 0 to iHasVariableDataType
26569>>>>>>>>>>>>>>>>>        
26569>>>>>>>>>>>>>>>>>        
26569>>>>>>>>>>>>>>>>>        // Get the cli handles
26569>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26570>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26571>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26572>>>>>>>>>>>>>>>>>        
26572>>>>>>>>>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
26573>>>>>>>>>>>>>>>>>        
26573>>>>>>>>>>>>>>>>>        Set piColumnCount to iNumColumns
26574>>>>>>>>>>>>>>>>>        
26574>>>>>>>>>>>>>>>>>        // Fill columns array
26574>>>>>>>>>>>>>>>>>        For iCol from 1 to iNumColumns
26580>>>>>>>>>>>>>>>>>>
26580>>>>>>>>>>>>>>>>>            Move 0 to iVariableDataType
26581>>>>>>>>>>>>>>>>>            
26581>>>>>>>>>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_SQLTYPE ihdbc sDrvrId ihstmt to iSQLType
26582>>>>>>>>>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_SIZE ihdbc sDrvrId ihstmt to iSQLSize
26583>>>>>>>>>>>>>>>>>            Get SQLPrivateColAttribute iCol SQLCOLATTRIB_PRECISION ihdbc sDrvrId ihstmt to iSQLPrecision
26584>>>>>>>>>>>>>>>>>            
26584>>>>>>>>>>>>>>>>>            If ( (iSQLType = SQL_LONGVARCHAR) or (iSQLType = SQL_WLONGVARCHAR) ) Begin
26586>>>>>>>>>>>>>>>>>                // text type
26586>>>>>>>>>>>>>>>>>                Move 1 to iVariableDataType
26587>>>>>>>>>>>>>>>>>            End
26587>>>>>>>>>>>>>>>>>>
26587>>>>>>>>>>>>>>>>>            Else Begin
26588>>>>>>>>>>>>>>>>>                If (sDrvrId = "MSSQLDRV") Begin
26590>>>>>>>>>>>>>>>>>                    // SQL Server varchar(max) and nvarchar(max) types return Size = 0
26590>>>>>>>>>>>>>>>>>                    If ( ((iSQLType = SQL_VARCHAR) and (iSQLSize = 0) ) or ;                        ((iSQLType = SQL_WVARCHAR) and (iSQLSize = 0) ) ) Begin
26592>>>>>>>>>>>>>>>>>                        
26592>>>>>>>>>>>>>>>>>                        Move 1 to iVariableDataType
26593>>>>>>>>>>>>>>>>>                    End
26593>>>>>>>>>>>>>>>>>>
26593>>>>>>>>>>>>>>>>>                End
26593>>>>>>>>>>>>>>>>>>
26593>>>>>>>>>>>>>>>>>            End
26593>>>>>>>>>>>>>>>>>>
26593>>>>>>>>>>>>>>>>>            
26593>>>>>>>>>>>>>>>>>            Move iSqlType           to aSQLColumns[iCol].iSQLType
26594>>>>>>>>>>>>>>>>>            Move iSQLSize           to aSQLColumns[iCol].iSQLSize
26595>>>>>>>>>>>>>>>>>            Move iSQLPrecision      to aSQLColumns[iCol].iSQLPrecision
26596>>>>>>>>>>>>>>>>>            Move iVariableDataType  to aSQLColumns[iCol].iVariableDataType
26597>>>>>>>>>>>>>>>>>            
26597>>>>>>>>>>>>>>>>>            If (not(iVariableDataType)) Begin
26599>>>>>>>>>>>>>>>>>                If (iSQLSize > iMaxSize) Begin
26601>>>>>>>>>>>>>>>>>                    Move iSQLSize to iMaxSize
26602>>>>>>>>>>>>>>>>>                End
26602>>>>>>>>>>>>>>>>>>
26602>>>>>>>>>>>>>>>>>            End
26602>>>>>>>>>>>>>>>>>>
26602>>>>>>>>>>>>>>>>>            Else Begin
26603>>>>>>>>>>>>>>>>>                Move 1 to iHasVariableDataType
26604>>>>>>>>>>>>>>>>>            End
26604>>>>>>>>>>>>>>>>>>
26604>>>>>>>>>>>>>>>>>            
26604>>>>>>>>>>>>>>>>>        Loop
26605>>>>>>>>>>>>>>>>>>
26605>>>>>>>>>>>>>>>>>        
26605>>>>>>>>>>>>>>>>>        Set paSQLColumns   to aSQLColumns
26606>>>>>>>>>>>>>>>>>        Set piHasVariableDataType to iHasVariableDataType
26607>>>>>>>>>>>>>>>>>        
26607>>>>>>>>>>>>>>>>>    End_Procedure
26608>>>>>>>>>>>>>>>>>    
26608>>>>>>>>>>>>>>>>>    // Execute a prepared statement
26608>>>>>>>>>>>>>>>>>    Procedure SQLExecute
26610>>>>>>>>>>>>>>>>>        Integer ihdbc
26610>>>>>>>>>>>>>>>>>        Integer ihstmt
26610>>>>>>>>>>>>>>>>>        Integer iVoid
26610>>>>>>>>>>>>>>>>>        String  sDrvrId
26610>>>>>>>>>>>>>>>>>        String  sEmpty
26610>>>>>>>>>>>>>>>>>        
26610>>>>>>>>>>>>>>>>>        // Initialize
26610>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26611>>>>>>>>>>>>>>>>>        
26611>>>>>>>>>>>>>>>>>        // Get the cli handles
26611>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26612>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26613>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26614>>>>>>>>>>>>>>>>>        
26614>>>>>>>>>>>>>>>>>        // Execute
26614>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26616>>>>>>>>>>>>>>>>>            // Call the driver function to execute
26616>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLEXECUTE ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
26621>>>>>>>>>>>>>>>>>            Send SQLGetStatementAttributes
26622>>>>>>>>>>>>>>>>>            Set piLastArgument to 0
26623>>>>>>>>>>>>>>>>>        End
26623>>>>>>>>>>>>>>>>>>
26623>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecute"
26625>>>>>>>>>>>>>>>>>    End_Procedure
26626>>>>>>>>>>>>>>>>>    
26626>>>>>>>>>>>>>>>>>    
26626>>>>>>>>>>>>>>>>>    
26626>>>>>>>>>>>>>>>>>    // Prepare and execute a statement
26626>>>>>>>>>>>>>>>>>    Procedure SQLExecDirect String sStatement
26628>>>>>>>>>>>>>>>>>        Integer ihdbc
26628>>>>>>>>>>>>>>>>>        Integer ihstmt
26628>>>>>>>>>>>>>>>>>        Integer iVoid
26628>>>>>>>>>>>>>>>>>        String  sDrvrId
26628>>>>>>>>>>>>>>>>>        
26628>>>>>>>>>>>>>>>>>        // Get the cli handles
26628>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26629>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26630>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26631>>>>>>>>>>>>>>>>>        
26631>>>>>>>>>>>>>>>>>        // ExecDirect
26631>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26633>>>>>>>>>>>>>>>>>            // Call the driver function to execdirect
26633>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLEXECDIRECT ;                Callback Self ;                Passing ihdbc sStatement ihstmt ;                Result iVoid
26638>>>>>>>>>>>>>>>>>            Send SQLGetStatementAttributes
26639>>>>>>>>>>>>>>>>>        End
26639>>>>>>>>>>>>>>>>>>
26639>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLExecDirect"
26641>>>>>>>>>>>>>>>>>    End_Procedure
26642>>>>>>>>>>>>>>>>>    
26642>>>>>>>>>>>>>>>>>    // Fetch the next row
26642>>>>>>>>>>>>>>>>>    // Returns  : 0   = No more data
26642>>>>>>>>>>>>>>>>>    //<>0 = Success
26642>>>>>>>>>>>>>>>>>    Function SQLFetch Returns Integer
26644>>>>>>>>>>>>>>>>>        Integer ihdbc
26644>>>>>>>>>>>>>>>>>        Integer ihstmt
26644>>>>>>>>>>>>>>>>>        Integer iResult
26644>>>>>>>>>>>>>>>>>        String  sDrvrId
26644>>>>>>>>>>>>>>>>>        String  sEmpty
26644>>>>>>>>>>>>>>>>>        
26644>>>>>>>>>>>>>>>>>        // Initialize
26644>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26645>>>>>>>>>>>>>>>>>        Move 0  to iResult
26646>>>>>>>>>>>>>>>>>        
26646>>>>>>>>>>>>>>>>>        // Get the cli handles
26646>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26647>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26648>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26649>>>>>>>>>>>>>>>>>        
26649>>>>>>>>>>>>>>>>>        // Fetch
26649>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26651>>>>>>>>>>>>>>>>>            Move False to Err
26652>>>>>>>>>>>>>>>>>            
26652>>>>>>>>>>>>>>>>>            // Call the driver function to fetch
26652>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLFETCH Callback Self Passing ihdbc sEmpty ihstmt Result iResult
26657>>>>>>>>>>>>>>>>>            
26657>>>>>>>>>>>>>>>>>            // If something went wrong, adjust the result
26657>>>>>>>>>>>>>>>>>            If (Err) ;                Move 0 to iResult
26660>>>>>>>>>>>>>>>>>            
26660>>>>>>>>>>>>>>>>>            Set piLastcolumn to 0
26661>>>>>>>>>>>>>>>>>        End
26661>>>>>>>>>>>>>>>>>>
26661>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLFetch"
26663>>>>>>>>>>>>>>>>>        
26663>>>>>>>>>>>>>>>>>        Function_Return iResult
26664>>>>>>>>>>>>>>>>>    End_Function
26665>>>>>>>>>>>>>>>>>    
26665>>>>>>>>>>>>>>>>>    // Fetch the next row and return an array with all column values
26665>>>>>>>>>>>>>>>>>    // Returns  : Array of strings with all column values
26665>>>>>>>>>>>>>>>>>    // Sets piFetchResult property
26665>>>>>>>>>>>>>>>>>    //   0    = No more data
26665>>>>>>>>>>>>>>>>>    //   <> 0 = Success
26665>>>>>>>>>>>>>>>>>    Function SQLFetchRowValues Returns String[]
26667>>>>>>>>>>>>>>>>>        
26667>>>>>>>>>>>>>>>>>        String[] asValues
26668>>>>>>>>>>>>>>>>>        
26668>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26668>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26669>>>>>>>>>>>>>>>>>        
26669>>>>>>>>>>>>>>>>>        Integer ihdbc
26669>>>>>>>>>>>>>>>>>        Integer ihstmt
26669>>>>>>>>>>>>>>>>>        Integer iResult iVoid
26669>>>>>>>>>>>>>>>>>        Integer iColCount iCol
26669>>>>>>>>>>>>>>>>>        String  sDrvrId
26669>>>>>>>>>>>>>>>>>        String  sEmpty
26669>>>>>>>>>>>>>>>>>        Longptr pResultWStr
26669>>>>>>>>>>>>>>>>>        WString wVariableResult
26669>>>>>>>>>>>>>>>>>        Integer iHasVariableDataType
26669>>>>>>>>>>>>>>>>>        Integer iLen
26669>>>>>>>>>>>>>>>>>        Integer iVariableBufferLength
26669>>>>>>>>>>>>>>>>>        
26669>>>>>>>>>>>>>>>>>        // Initialize
26669>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26670>>>>>>>>>>>>>>>>>        Move 0  to iResult
26671>>>>>>>>>>>>>>>>>        
26671>>>>>>>>>>>>>>>>>        // Get the cli handles
26671>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26672>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26673>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26674>>>>>>>>>>>>>>>>>        
26674>>>>>>>>>>>>>>>>>        Get paSQLColumns to aSQLColumns
26675>>>>>>>>>>>>>>>>>        Get piColumnCount to iColCount
26676>>>>>>>>>>>>>>>>>        Get piHasVariableDataType to iHasVariableDataType
26677>>>>>>>>>>>>>>>>>        
26677>>>>>>>>>>>>>>>>>        If (iHasVariableDataType) Begin
26679>>>>>>>>>>>>>>>>>            
26679>>>>>>>>>>>>>>>>>            Get piVariableBufferLength      to iVariableBufferLength
26680>>>>>>>>>>>>>>>>>            Get piMaxVariableBufferLength   to iLen
26681>>>>>>>>>>>>>>>>>            
26681>>>>>>>>>>>>>>>>>            If (iLen > iVariableBufferLength) Begin
26683>>>>>>>>>>>>>>>>>                // Allocate
26683>>>>>>>>>>>>>>>>>                Move (Repeat(' ', iLen)) to wVariableResult
26684>>>>>>>>>>>>>>>>>                
26684>>>>>>>>>>>>>>>>>                Set piVariableBufferLength to iLen
26685>>>>>>>>>>>>>>>>>                Set psVariableBuffer       to wVariableResult
26686>>>>>>>>>>>>>>>>>                
26686>>>>>>>>>>>>>>>>>                Get piVariableBufferLength to iVariableBufferLength
26687>>>>>>>>>>>>>>>>>            End
26687>>>>>>>>>>>>>>>>>>
26687>>>>>>>>>>>>>>>>>        End
26687>>>>>>>>>>>>>>>>>>
26687>>>>>>>>>>>>>>>>>        
26687>>>>>>>>>>>>>>>>>        // Fetch
26687>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26689>>>>>>>>>>>>>>>>>            Move (False) to Err
26690>>>>>>>>>>>>>>>>>            
26690>>>>>>>>>>>>>>>>>            // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
26690>>>>>>>>>>>>>>>>>            // in the next FUNC_SQLCOLUMNVALUE call.
26690>>>>>>>>>>>>>>>>>            // If hdbc and hstmt have not changed since the last call we don't have to set it.
26690>>>>>>>>>>>>>>>>>            If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
26692>>>>>>>>>>>>>>>>>                // Setup function arguments
26692>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO Callback 0 Passing ihdbc iCol ihstmt Result iVoid
26697>>>>>>>>>>>>>>>>>                Move ihstmt to giLastSQLhstmt
26698>>>>>>>>>>>>>>>>>                Move ihdbc to giLastSQLhdbc
26699>>>>>>>>>>>>>>>>>            End
26699>>>>>>>>>>>>>>>>>>
26699>>>>>>>>>>>>>>>>>            
26699>>>>>>>>>>>>>>>>>            // Call the driver function to fetch
26699>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLFETCH Callback 0 Passing ihdbc sEmpty ihstmt Result iResult
26704>>>>>>>>>>>>>>>>>            
26704>>>>>>>>>>>>>>>>>            // If something went wrong, adjust the result
26704>>>>>>>>>>>>>>>>>            If (Err) ;                Move 0 to iResult
26707>>>>>>>>>>>>>>>>>            
26707>>>>>>>>>>>>>>>>>            If (iResult) Begin
26709>>>>>>>>>>>>>>>>>                For iCol from 1 to iColCount
26715>>>>>>>>>>>>>>>>>>
26715>>>>>>>>>>>>>>>>>                    
26715>>>>>>>>>>>>>>>>>                    If (not(aSQLColumns[iCol].iVariableDataType)) Begin
26717>>>>>>>>>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                            Callback 0 ;                            Passing sEmpty sEmpty iCol ;                            Result pResultWStr
26722>>>>>>>>>>>>>>>>>                            
26722>>>>>>>>>>>>>>>>>                        If (pResultWStr) Begin
26724>>>>>>>>>>>>>>>>>                            Move (CString(PointerToWString(pResultWStr))) to asValues[iCol - 1]
26725>>>>>>>>>>>>>>>>>                        End
26725>>>>>>>>>>>>>>>>>>
26725>>>>>>>>>>>>>>>>>                        Else Begin
26726>>>>>>>>>>>>>>>>>                            Move "" to asValues[iCol - 1]
26727>>>>>>>>>>>>>>>>>                        End
26727>>>>>>>>>>>>>>>>>>
26727>>>>>>>>>>>>>>>>>                        
26727>>>>>>>>>>>>>>>>>                    End
26727>>>>>>>>>>>>>>>>>>
26727>>>>>>>>>>>>>>>>>                    Else Begin
26728>>>>>>>>>>>>>>>>>                        Get psVariableBuffer       to wVariableResult
26729>>>>>>>>>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                            Callback 0 ;                            Passing iCol iVariableBufferLength (AddressOf(wVariableResult));                            Result iVoid
26734>>>>>>>>>>>>>>>>>                        
26734>>>>>>>>>>>>>>>>>                        Move (CString(wVariableResult)) to asValues[iCol - 1]
26735>>>>>>>>>>>>>>>>>                    End
26735>>>>>>>>>>>>>>>>>>
26735>>>>>>>>>>>>>>>>>                    
26735>>>>>>>>>>>>>>>>>                Loop
26736>>>>>>>>>>>>>>>>>>
26736>>>>>>>>>>>>>>>>>            End
26736>>>>>>>>>>>>>>>>>>
26736>>>>>>>>>>>>>>>>>        End
26736>>>>>>>>>>>>>>>>>>
26736>>>>>>>>>>>>>>>>>        Else Begin
26737>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLFetchRowValues"
26738>>>>>>>>>>>>>>>>>        End
26738>>>>>>>>>>>>>>>>>>
26738>>>>>>>>>>>>>>>>>        
26738>>>>>>>>>>>>>>>>>        Set piFetchResult to iResult
26739>>>>>>>>>>>>>>>>>        
26739>>>>>>>>>>>>>>>>>        Function_Return asValues
26740>>>>>>>>>>>>>>>>>        
26740>>>>>>>>>>>>>>>>>    End_Function
26741>>>>>>>>>>>>>>>>>    
26741>>>>>>>>>>>>>>>>>    // Fetch a complete result set.
26741>>>>>>>>>>>>>>>>>    // Returns  : 2-dimensional array of strings with result set
26741>>>>>>>>>>>>>>>>>    // Sets piFetchResult property
26741>>>>>>>>>>>>>>>>>    //   0    = No more data
26741>>>>>>>>>>>>>>>>>    //   <> 0 = Success
26741>>>>>>>>>>>>>>>>>    Function SQLFetchResultsetValues Returns String[][]
26743>>>>>>>>>>>>>>>>>        
26743>>>>>>>>>>>>>>>>>        String[][] asValues
26744>>>>>>>>>>>>>>>>>        
26744>>>>>>>>>>>>>>>>>        Integer ihdbc ihstmt iResult iVoid iColCount iCol iRow
26744>>>>>>>>>>>>>>>>>        String sDrvrId sEmpty sMax
26744>>>>>>>>>>>>>>>>>        Longptr pResultWStr
26744>>>>>>>>>>>>>>>>>        WString wResult
26744>>>>>>>>>>>>>>>>>        
26744>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26744>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26745>>>>>>>>>>>>>>>>>        WString  wVariableResult
26745>>>>>>>>>>>>>>>>>        Integer iHasVariableDataType
26745>>>>>>>>>>>>>>>>>        Integer iLen
26745>>>>>>>>>>>>>>>>>        Integer iVariableBufferLength
26745>>>>>>>>>>>>>>>>>        
26745>>>>>>>>>>>>>>>>>        // Initialize
26745>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26746>>>>>>>>>>>>>>>>>        Move 0  to iResult
26747>>>>>>>>>>>>>>>>>        
26747>>>>>>>>>>>>>>>>>        // Get the cli handles
26747>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26748>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26749>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26750>>>>>>>>>>>>>>>>>        
26750>>>>>>>>>>>>>>>>>        // Fetch
26750>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26752>>>>>>>>>>>>>>>>>            Move False to Err
26753>>>>>>>>>>>>>>>>>            
26753>>>>>>>>>>>>>>>>>            // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
26753>>>>>>>>>>>>>>>>>            // in the next FUNC_SQLCOLUMNVALUE call.
26753>>>>>>>>>>>>>>>>>            // If hdbc and hstmt have not changed since the last call we don't have to set it.
26753>>>>>>>>>>>>>>>>>            If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
26755>>>>>>>>>>>>>>>>>                // Setup function arguments
26755>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO Callback 0 Passing ihdbc iCol ihstmt Result iVoid
26760>>>>>>>>>>>>>>>>>                Move ihstmt to giLastSQLhstmt
26761>>>>>>>>>>>>>>>>>                Move ihdbc to giLastSQLhdbc
26762>>>>>>>>>>>>>>>>>            End
26762>>>>>>>>>>>>>>>>>>
26762>>>>>>>>>>>>>>>>>            
26762>>>>>>>>>>>>>>>>>            Get piColumnCount to iColCount
26763>>>>>>>>>>>>>>>>>            If (iColCount) Begin
26765>>>>>>>>>>>>>>>>>                Get paSQLColumns to aSQLColumns
26766>>>>>>>>>>>>>>>>>                Get piHasVariableDataType to iHasVariableDataType
26767>>>>>>>>>>>>>>>>>                If (iHasVariableDataType) Begin
26769>>>>>>>>>>>>>>>>>                    Get piVariableBufferLength      to iVariableBufferLength
26770>>>>>>>>>>>>>>>>>                    Get piMaxVariableBufferLength   to iLen
26771>>>>>>>>>>>>>>>>>                    If (iLen > iVariableBufferLength) Begin
26773>>>>>>>>>>>>>>>>>                        // Allocate
26773>>>>>>>>>>>>>>>>>                        Move (Repeat(' ', iLen)) to wVariableResult
26774>>>>>>>>>>>>>>>>>                        
26774>>>>>>>>>>>>>>>>>                        Set piVariableBufferLength to iLen
26775>>>>>>>>>>>>>>>>>                        Set psVariableBuffer       to wVariableResult
26776>>>>>>>>>>>>>>>>>                        
26776>>>>>>>>>>>>>>>>>                        Get piVariableBufferLength to iVariableBufferLength
26777>>>>>>>>>>>>>>>>>                    End
26777>>>>>>>>>>>>>>>>>>
26777>>>>>>>>>>>>>>>>>                    Else Begin
26778>>>>>>>>>>>>>>>>>                        Set psVariableBuffer       to wVariableResult
26779>>>>>>>>>>>>>>>>>                    End
26779>>>>>>>>>>>>>>>>>>
26779>>>>>>>>>>>>>>>>>                End
26779>>>>>>>>>>>>>>>>>>
26779>>>>>>>>>>>>>>>>>                
26779>>>>>>>>>>>>>>>>>                // Call the driver function to fetch
26779>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLFETCH Callback Self Passing ihdbc sEmpty ihstmt Result iResult
26784>>>>>>>>>>>>>>>>>                If (Err) ;                    Move 0 to iResult
26787>>>>>>>>>>>>>>>>>                
26787>>>>>>>>>>>>>>>>>                While (iResult <> 0)
26791>>>>>>>>>>>>>>>>>                    
26791>>>>>>>>>>>>>>>>>                    For iCol from 1 to (iColCount)
26797>>>>>>>>>>>>>>>>>>
26797>>>>>>>>>>>>>>>>>                        
26797>>>>>>>>>>>>>>>>>                        If (not(aSQLColumns[iCol].iVariableDataType)) Begin
26799>>>>>>>>>>>>>>>>>                            
26799>>>>>>>>>>>>>>>>>                            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                                Callback 0 ;                                Passing sEmpty sEmpty iCol ;                                Result pResultWStr
26804>>>>>>>>>>>>>>>>>                            
26804>>>>>>>>>>>>>>>>>                            If (pResultWStr) Begin
26806>>>>>>>>>>>>>>>>>                                Move (CString(PointerToWString(pResultWStr))) to asValues[iRow][iCol - 1]
26807>>>>>>>>>>>>>>>>>                            End
26807>>>>>>>>>>>>>>>>>>
26807>>>>>>>>>>>>>>>>>                            Else Begin
26808>>>>>>>>>>>>>>>>>                                Move "" to asValues[iRow][iCol - 1]
26809>>>>>>>>>>>>>>>>>                            End
26809>>>>>>>>>>>>>>>>>>
26809>>>>>>>>>>>>>>>>>                        End
26809>>>>>>>>>>>>>>>>>>
26809>>>>>>>>>>>>>>>>>                        Else Begin
26810>>>>>>>>>>>>>>>>>                            //Variable data
26810>>>>>>>>>>>>>>>>>                            Move wVariableResult to wResult
26811>>>>>>>>>>>>>>>>>                            Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                                Callback 0 ;                                Passing iCol iVariableBufferLength (AddressOf(wResult)) ;                                Result iVoid
26816>>>>>>>>>>>>>>>>>                            
26816>>>>>>>>>>>>>>>>>                            Move (CString(wResult)) to asValues[iRow][iCol - 1]
26817>>>>>>>>>>>>>>>>>                        End
26817>>>>>>>>>>>>>>>>>>
26817>>>>>>>>>>>>>>>>>                    Loop
26818>>>>>>>>>>>>>>>>>>
26818>>>>>>>>>>>>>>>>>                    
26818>>>>>>>>>>>>>>>>>                    Increment iRow
26819>>>>>>>>>>>>>>>>>                    
26819>>>>>>>>>>>>>>>>>                    // Call the driver function to fetch
26819>>>>>>>>>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLFETCH Callback Self Passing ihdbc sEmpty ihstmt Result iResult
26824>>>>>>>>>>>>>>>>>                    If (Err) ;                        Move 0 to iResult
26827>>>>>>>>>>>>>>>>>                    
26827>>>>>>>>>>>>>>>>>                Loop
26828>>>>>>>>>>>>>>>>>>
26828>>>>>>>>>>>>>>>>>            End
26828>>>>>>>>>>>>>>>>>>
26828>>>>>>>>>>>>>>>>>        End
26828>>>>>>>>>>>>>>>>>>
26828>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLFetchResultsetValues"
26830>>>>>>>>>>>>>>>>>        
26830>>>>>>>>>>>>>>>>>        Set piFetchResult to iResult
26831>>>>>>>>>>>>>>>>>        
26831>>>>>>>>>>>>>>>>>        Function_Return asValues
26832>>>>>>>>>>>>>>>>>    End_Function
26833>>>>>>>>>>>>>>>>>    
26833>>>>>>>>>>>>>>>>>    // Get the next column
26833>>>>>>>>>>>>>>>>>    Function SQLNextColumn Returns String
26835>>>>>>>>>>>>>>>>>        Integer iCol
26835>>>>>>>>>>>>>>>>>        String  sResult
26835>>>>>>>>>>>>>>>>>        
26835>>>>>>>>>>>>>>>>>        Get piLastColumn to iCol
26836>>>>>>>>>>>>>>>>>        Increment iCol
26837>>>>>>>>>>>>>>>>>        Get SQLColumnValue iCol to sResult
26838>>>>>>>>>>>>>>>>>        Set piLastColumn to iCol
26839>>>>>>>>>>>>>>>>>        
26839>>>>>>>>>>>>>>>>>        Function_Return sResult
26840>>>>>>>>>>>>>>>>>    End_Function
26841>>>>>>>>>>>>>>>>>    
26841>>>>>>>>>>>>>>>>>    
26841>>>>>>>>>>>>>>>>>    // Returns the native type of a column
26841>>>>>>>>>>>>>>>>>    Function SQLColumnType Integer iCol Returns Integer
26843>>>>>>>>>>>>>>>>>        Integer ihdbc
26843>>>>>>>>>>>>>>>>>        Integer ihstmt
26843>>>>>>>>>>>>>>>>>        String  sDrvrId
26843>>>>>>>>>>>>>>>>>        Integer iSQLType
26843>>>>>>>>>>>>>>>>>        Integer iColumns
26843>>>>>>>>>>>>>>>>>        
26843>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26843>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26844>>>>>>>>>>>>>>>>>        
26844>>>>>>>>>>>>>>>>>        // Get the cli handles
26844>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26845>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26846>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26847>>>>>>>>>>>>>>>>>        
26847>>>>>>>>>>>>>>>>>        // Get the value
26847>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26849>>>>>>>>>>>>>>>>>            
26849>>>>>>>>>>>>>>>>>            Get paSQLColumns   to aSQLColumns
26850>>>>>>>>>>>>>>>>>            Move (SizeOfArray(aSQLColumns)) to iColumns
26851>>>>>>>>>>>>>>>>>            
26851>>>>>>>>>>>>>>>>>            If (iCol >= 1 and iCol <= iColumns) Begin
26853>>>>>>>>>>>>>>>>>                Move aSQLColumns[iCol].iSQLType to iSQLType
26854>>>>>>>>>>>>>>>>>            End
26854>>>>>>>>>>>>>>>>>>
26854>>>>>>>>>>>>>>>>>            Else Begin
26855>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnType"
26856>>>>>>>>>>>>>>>>>            End
26856>>>>>>>>>>>>>>>>>>
26856>>>>>>>>>>>>>>>>>        End
26856>>>>>>>>>>>>>>>>>>
26856>>>>>>>>>>>>>>>>>        Else Begin
26857>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLColumnType"
26858>>>>>>>>>>>>>>>>>        End
26858>>>>>>>>>>>>>>>>>>
26858>>>>>>>>>>>>>>>>>        
26858>>>>>>>>>>>>>>>>>        Function_Return iSQLType
26859>>>>>>>>>>>>>>>>>    End_Function
26860>>>>>>>>>>>>>>>>>    
26860>>>>>>>>>>>>>>>>>    // Returns the size (max length) of a column
26860>>>>>>>>>>>>>>>>>    Function SQLColumnSize Integer iCol Returns Integer
26862>>>>>>>>>>>>>>>>>        Integer ihdbc
26862>>>>>>>>>>>>>>>>>        Integer ihstmt
26862>>>>>>>>>>>>>>>>>        String  sDrvrId
26862>>>>>>>>>>>>>>>>>        Integer iSQLSize
26862>>>>>>>>>>>>>>>>>        Integer iColumns
26862>>>>>>>>>>>>>>>>>        
26862>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26862>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26863>>>>>>>>>>>>>>>>>        
26863>>>>>>>>>>>>>>>>>        // Get the cli handles
26863>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26864>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26865>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26866>>>>>>>>>>>>>>>>>        
26866>>>>>>>>>>>>>>>>>        // Get the value
26866>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26868>>>>>>>>>>>>>>>>>            
26868>>>>>>>>>>>>>>>>>            Get paSQLColumns   to aSQLColumns
26869>>>>>>>>>>>>>>>>>            Move (SizeOfArray(aSQLColumns)) to iColumns
26870>>>>>>>>>>>>>>>>>            
26870>>>>>>>>>>>>>>>>>            If (iCol >= 1 and iCol <= iColumns) Begin
26872>>>>>>>>>>>>>>>>>                Move aSQLColumns[iCol].iSQLSize to iSQLSize
26873>>>>>>>>>>>>>>>>>            End
26873>>>>>>>>>>>>>>>>>>
26873>>>>>>>>>>>>>>>>>            Else Begin
26874>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnSize"
26875>>>>>>>>>>>>>>>>>            End
26875>>>>>>>>>>>>>>>>>>
26875>>>>>>>>>>>>>>>>>        End
26875>>>>>>>>>>>>>>>>>>
26875>>>>>>>>>>>>>>>>>        Else Begin
26876>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLColumnSize"
26877>>>>>>>>>>>>>>>>>        End
26877>>>>>>>>>>>>>>>>>>
26877>>>>>>>>>>>>>>>>>        
26877>>>>>>>>>>>>>>>>>        Function_Return iSQLSize
26878>>>>>>>>>>>>>>>>>    End_Function
26879>>>>>>>>>>>>>>>>>    
26879>>>>>>>>>>>>>>>>>    //  Returns 1 for variable length datatypes.
26879>>>>>>>>>>>>>>>>>    //  For example SQL Server varchar(max) or text type
26879>>>>>>>>>>>>>>>>>    //  The data of variable length datatype columns should be retrieved with SQLGetData
26879>>>>>>>>>>>>>>>>>    Function SQLColumnVariableDatatype Integer iCol Returns Integer
26881>>>>>>>>>>>>>>>>>        Integer ihdbc
26881>>>>>>>>>>>>>>>>>        Integer ihstmt
26881>>>>>>>>>>>>>>>>>        String  sDrvrId
26881>>>>>>>>>>>>>>>>>        Integer iVariableDataType
26881>>>>>>>>>>>>>>>>>        Integer iColumns
26881>>>>>>>>>>>>>>>>>        
26881>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26881>>>>>>>>>>>>>>>>>        tSQLColumn[] aSQLColumns
26882>>>>>>>>>>>>>>>>>        
26882>>>>>>>>>>>>>>>>>        // Get the cli handles
26882>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26883>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26884>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26885>>>>>>>>>>>>>>>>>        
26885>>>>>>>>>>>>>>>>>        // Get the value
26885>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26887>>>>>>>>>>>>>>>>>            
26887>>>>>>>>>>>>>>>>>            Get paSQLColumns   to aSQLColumns
26888>>>>>>>>>>>>>>>>>            Move (SizeOfArray(aSQLColumns)) to iColumns
26889>>>>>>>>>>>>>>>>>            
26889>>>>>>>>>>>>>>>>>            If (iCol >= 1 and iCol <= iColumns) Begin
26891>>>>>>>>>>>>>>>>>                Move aSQLColumns[iCol].iVariableDataType to iVariableDataType
26892>>>>>>>>>>>>>>>>>            End
26892>>>>>>>>>>>>>>>>>>
26892>>>>>>>>>>>>>>>>>            Else Begin
26893>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnVariableDatatype"
26894>>>>>>>>>>>>>>>>>            End
26894>>>>>>>>>>>>>>>>>>
26894>>>>>>>>>>>>>>>>>        End
26894>>>>>>>>>>>>>>>>>>
26894>>>>>>>>>>>>>>>>>        Else Begin
26895>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLColumnVariableDatatype"
26896>>>>>>>>>>>>>>>>>        End
26896>>>>>>>>>>>>>>>>>>
26896>>>>>>>>>>>>>>>>>        
26896>>>>>>>>>>>>>>>>>        Function_Return iVariableDataType
26897>>>>>>>>>>>>>>>>>    End_Function
26898>>>>>>>>>>>>>>>>>    
26898>>>>>>>>>>>>>>>>>    
26898>>>>>>>>>>>>>>>>>    // Return the value of a column in a fetched row of a given
26898>>>>>>>>>>>>>>>>>    // statement.
26898>>>>>>>>>>>>>>>>>    Function SQLColumnValue Integer iCol Returns String
26900>>>>>>>>>>>>>>>>>        Integer ihdbc
26900>>>>>>>>>>>>>>>>>        Integer ihstmt
26900>>>>>>>>>>>>>>>>>        String  sDrvrId sResult
26900>>>>>>>>>>>>>>>>>        Longptr pResultWStr
26900>>>>>>>>>>>>>>>>>        
26900>>>>>>>>>>>>>>>>>        Integer iVoid
26900>>>>>>>>>>>>>>>>>        Integer iColSize
26900>>>>>>>>>>>>>>>>>        Integer iColPrecision
26900>>>>>>>>>>>>>>>>>        String  sEmpty
26900>>>>>>>>>>>>>>>>>        Integer bLegalColumn
26900>>>>>>>>>>>>>>>>>        
26900>>>>>>>>>>>>>>>>>        // Initialize
26900>>>>>>>>>>>>>>>>>        Move "" to sResult
26901>>>>>>>>>>>>>>>>>        
26901>>>>>>>>>>>>>>>>>        // Get the cli handles
26901>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26902>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26903>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26904>>>>>>>>>>>>>>>>>        
26904>>>>>>>>>>>>>>>>>        // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
26904>>>>>>>>>>>>>>>>>        // in the next FUNC_SQLCOLUMNVALUE call.
26904>>>>>>>>>>>>>>>>>        // If hdbc and hstmt have not changed since the last call we don't have to set it.
26904>>>>>>>>>>>>>>>>>        If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
26906>>>>>>>>>>>>>>>>>            // Setup function arguments
26906>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback 0 ;                Passing ihdbc iCol ihstmt ;                Result iVoid
26911>>>>>>>>>>>>>>>>>            Move ihstmt to giLastSQLhstmt
26912>>>>>>>>>>>>>>>>>            Move ihdbc to giLastSQLhdbc
26913>>>>>>>>>>>>>>>>>        End
26913>>>>>>>>>>>>>>>>>>
26913>>>>>>>>>>>>>>>>>        
26913>>>>>>>>>>>>>>>>>        If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
26915>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNVALUE ;                Callback 0 ;                Passing sResult sEmpty iCol ;                Result pResultWStr
26920>>>>>>>>>>>>>>>>>            
26920>>>>>>>>>>>>>>>>>            If (pResultWStr) Begin
26922>>>>>>>>>>>>>>>>>                Move (PointerToWString(pResultWStr)) to sResult
26923>>>>>>>>>>>>>>>>>            End
26923>>>>>>>>>>>>>>>>>>
26923>>>>>>>>>>>>>>>>>            Else Begin
26924>>>>>>>>>>>>>>>>>                Move "" to sResult
26925>>>>>>>>>>>>>>>>>            End
26925>>>>>>>>>>>>>>>>>>
26925>>>>>>>>>>>>>>>>>        End
26925>>>>>>>>>>>>>>>>>>
26925>>>>>>>>>>>>>>>>>        Else Begin
26926>>>>>>>>>>>>>>>>>            Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLColumnValue"
26927>>>>>>>>>>>>>>>>>        End
26927>>>>>>>>>>>>>>>>>>
26927>>>>>>>>>>>>>>>>>        
26927>>>>>>>>>>>>>>>>>        Function_Return sResult
26928>>>>>>>>>>>>>>>>>        
26928>>>>>>>>>>>>>>>>>    End_Function
26929>>>>>>>>>>>>>>>>>    
26929>>>>>>>>>>>>>>>>>    // Add a file to the files used to place the statement result in.
26929>>>>>>>>>>>>>>>>>    Procedure SQLBindFile Integer iFileNum
26931>>>>>>>>>>>>>>>>>        Integer ihdbc
26931>>>>>>>>>>>>>>>>>        Integer ihstmt
26931>>>>>>>>>>>>>>>>>        Integer iVoid
26931>>>>>>>>>>>>>>>>>        String  sDrvrId
26931>>>>>>>>>>>>>>>>>        String  sFileType
26931>>>>>>>>>>>>>>>>>        Integer bIsOpen
26931>>>>>>>>>>>>>>>>>        
26931>>>>>>>>>>>>>>>>>        // Get the cli handles
26931>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26932>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26933>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26934>>>>>>>>>>>>>>>>>        
26934>>>>>>>>>>>>>>>>>        // If a file number is not passed see if we can use the statement's
26934>>>>>>>>>>>>>>>>>        // default file number which is usually set with SetFileConnection
26934>>>>>>>>>>>>>>>>>        If (iFileNum = 0) Begin
26936>>>>>>>>>>>>>>>>>            Get piBindFile to iFileNum
26937>>>>>>>>>>>>>>>>>            If (iFileNum = 0) Begin
26939>>>>>>>>>>>>>>>>>                // Logic error, if 0 is passed as filenumber, piBindFile should be set.
26939>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_BIND_FILE "piBindFile should be set" "SQLBindFile"
26940>>>>>>>>>>>>>>>>>                
26940>>>>>>>>>>>>>>>>>                Move 0 to SQLResult
26941>>>>>>>>>>>>>>>>>                Procedure_Return
26942>>>>>>>>>>>>>>>>>            End
26942>>>>>>>>>>>>>>>>>>
26942>>>>>>>>>>>>>>>>>        End
26942>>>>>>>>>>>>>>>>>>
26942>>>>>>>>>>>>>>>>>        
26942>>>>>>>>>>>>>>>>>        // Bind the file
26942>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26944>>>>>>>>>>>>>>>>>            // Chek if the file is open
26944>>>>>>>>>>>>>>>>>            Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
26947>>>>>>>>>>>>>>>>>            If (bIsOpen) Begin
26949>>>>>>>>>>>>>>>>>                // Check if the file has the correct type
26949>>>>>>>>>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sFileType
26952>>>>>>>>>>>>>>>>>                If (sFileType = sDrvrId) Begin
26954>>>>>>>>>>>>>>>>>                    // Call the driver function to add a file to a statement
26954>>>>>>>>>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLBINDFILE ;                        Callback Self ;                        Passing ihdbc iFileNum ihstmt ;                        Result iVoid
26959>>>>>>>>>>>>>>>>>                End
26959>>>>>>>>>>>>>>>>>>
26959>>>>>>>>>>>>>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
26961>>>>>>>>>>>>>>>>>            End
26961>>>>>>>>>>>>>>>>>>
26961>>>>>>>>>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File not open (number =" * String(iFileNum) + ")") "SQLBindFile"
26963>>>>>>>>>>>>>>>>>        End
26963>>>>>>>>>>>>>>>>>>
26963>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLBindFile"
26965>>>>>>>>>>>>>>>>>    End_Procedure
26966>>>>>>>>>>>>>>>>>    
26966>>>>>>>>>>>>>>>>>    
26966>>>>>>>>>>>>>>>>>    
26966>>>>>>>>>>>>>>>>>    // Get data of a column.                                  
26966>>>>>>>>>>>>>>>>>    Function SQLGetData Integer iCol Integer iLen Returns String
26968>>>>>>>>>>>>>>>>>        Integer ihdbc
26968>>>>>>>>>>>>>>>>>        Integer ihstmt
26968>>>>>>>>>>>>>>>>>        Integer iVoid
26968>>>>>>>>>>>>>>>>>        Integer iColSize
26968>>>>>>>>>>>>>>>>>        Integer iResult
26968>>>>>>>>>>>>>>>>>        String  sDrvrId
26968>>>>>>>>>>>>>>>>>        WString wResult
26968>>>>>>>>>>>>>>>>>        String  sEmpty
26968>>>>>>>>>>>>>>>>>        Integer bLegalColumn
26968>>>>>>>>>>>>>>>>>        
26968>>>>>>>>>>>>>>>>>        Integer iVariableBufferLength
26968>>>>>>>>>>>>>>>>>        
26968>>>>>>>>>>>>>>>>>        // Initialize
26968>>>>>>>>>>>>>>>>>        Move "" to sEmpty
26969>>>>>>>>>>>>>>>>>        Move 0 to iResult
26970>>>>>>>>>>>>>>>>>        
26970>>>>>>>>>>>>>>>>>        // Get the cli handles
26970>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
26971>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
26972>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
26973>>>>>>>>>>>>>>>>>        
26973>>>>>>>>>>>>>>>>>        // Get the data
26973>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
26975>>>>>>>>>>>>>>>>>            // Check if the column exists
26975>>>>>>>>>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
26977>>>>>>>>>>>>>>>>>                If (iLen = 0) Begin
26979>>>>>>>>>>>>>>>>>                    Get SQLColumnValue iCol to wResult
26980>>>>>>>>>>>>>>>>>                End
26980>>>>>>>>>>>>>>>>>>
26980>>>>>>>>>>>>>>>>>                Else Begin
26981>>>>>>>>>>>>>>>>>                    // Add 1 for string terminator
26981>>>>>>>>>>>>>>>>>                    Move (iLen + 1) to iLen
26982>>>>>>>>>>>>>>>>>                    
26982>>>>>>>>>>>>>>>>>                    Get piVariableBufferLength to iVariableBufferLength
26983>>>>>>>>>>>>>>>>>                    If (iLen > iVariableBufferLength) Begin
26985>>>>>>>>>>>>>>>>>                        // Allocate
26985>>>>>>>>>>>>>>>>>                        Move (Repeat(' ', iLen)) to wResult
26986>>>>>>>>>>>>>>>>>                        
26986>>>>>>>>>>>>>>>>>                        Set piVariableBufferLength to iLen
26987>>>>>>>>>>>>>>>>>                        Set psVariableBuffer       to wResult
26988>>>>>>>>>>>>>>>>>                    End
26988>>>>>>>>>>>>>>>>>>
26988>>>>>>>>>>>>>>>>>                    Else Begin
26989>>>>>>>>>>>>>>>>>                        Get psVariableBuffer       to wResult
26990>>>>>>>>>>>>>>>>>                    End
26990>>>>>>>>>>>>>>>>>>
26990>>>>>>>>>>>>>>>>>                    
26990>>>>>>>>>>>>>>>>>                    
26990>>>>>>>>>>>>>>>>>                    // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
26990>>>>>>>>>>>>>>>>>                    // in the next FUNC_SQLCOLUMNVALUE call.
26990>>>>>>>>>>>>>>>>>                    // If hdbc and hstmt have not changed since the last call we don't have to set it.
26990>>>>>>>>>>>>>>>>>                    If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
26992>>>>>>>>>>>>>>>>>                        // Setup function arguments
26992>>>>>>>>>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                            Callback 0 ;                            Passing ihdbc iCol ihstmt ;                            Result iVoid
26997>>>>>>>>>>>>>>>>>                        Move ihstmt to giLastSQLhstmt
26998>>>>>>>>>>>>>>>>>                        Move ihdbc to giLastSQLhdbc
26999>>>>>>>>>>>>>>>>>                    End
26999>>>>>>>>>>>>>>>>>>
26999>>>>>>>>>>>>>>>>>                    
26999>>>>>>>>>>>>>>>>>                    Move False to Err
27000>>>>>>>>>>>>>>>>>                    // Call the driver function to get the data
27000>>>>>>>>>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                        Callback Self ;                        Passing iCol iLen (AddressOf(wResult)) ;                        Result iResult
27005>>>>>>>>>>>>>>>>>                    
27005>>>>>>>>>>>>>>>>>                    // If something went wrong, adjust the result
27005>>>>>>>>>>>>>>>>>                    If (Err) Begin
27007>>>>>>>>>>>>>>>>>                        Move 0 to iResult
27008>>>>>>>>>>>>>>>>>                    End
27008>>>>>>>>>>>>>>>>>>
27008>>>>>>>>>>>>>>>>>                    
27008>>>>>>>>>>>>>>>>>                    // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
27008>>>>>>>>>>>>>>>>>                    If (iResult = -4) Begin
27010>>>>>>>>>>>>>>>>>                        Move (SizeOfWString(wResult)) to iResult
27011>>>>>>>>>>>>>>>>>                    End
27011>>>>>>>>>>>>>>>>>>
27011>>>>>>>>>>>>>>>>>                End
27011>>>>>>>>>>>>>>>>>>
27011>>>>>>>>>>>>>>>>>            End
27011>>>>>>>>>>>>>>>>>>
27011>>>>>>>>>>>>>>>>>            Else Begin
27012>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
27013>>>>>>>>>>>>>>>>>            End
27013>>>>>>>>>>>>>>>>>>
27013>>>>>>>>>>>>>>>>>        End
27013>>>>>>>>>>>>>>>>>>
27013>>>>>>>>>>>>>>>>>        Else Begin
27014>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
27015>>>>>>>>>>>>>>>>>        End
27015>>>>>>>>>>>>>>>>>>
27015>>>>>>>>>>>>>>>>>        
27015>>>>>>>>>>>>>>>>>        // Fill global result
27015>>>>>>>>>>>>>>>>>        If (iResult > 0) Begin
27017>>>>>>>>>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
27018>>>>>>>>>>>>>>>>>        End
27018>>>>>>>>>>>>>>>>>>
27018>>>>>>>>>>>>>>>>>        Else Begin
27019>>>>>>>>>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
27020>>>>>>>>>>>>>>>>>        End
27020>>>>>>>>>>>>>>>>>>
27020>>>>>>>>>>>>>>>>>        
27020>>>>>>>>>>>>>>>>>        Function_Return (CString(wResult))
27021>>>>>>>>>>>>>>>>>    End_Function
27022>>>>>>>>>>>>>>>>>
27022>>>>>>>>>>>>>>>>>    // SQLGetDataToUChar (SQLGetData returning uchar array)
27022>>>>>>>>>>>>>>>>>    // Use for binary data and for character data containing Unicode non-bmp characters
27022>>>>>>>>>>>>>>>>>    Function SQLGetDataToUChar Integer iCol Integer iLen Returns UChar[]
27024>>>>>>>>>>>>>>>>>        Integer ihdbc
27024>>>>>>>>>>>>>>>>>        Integer ihstmt
27024>>>>>>>>>>>>>>>>>        Integer iVoid
27024>>>>>>>>>>>>>>>>>        Integer iColSize
27024>>>>>>>>>>>>>>>>>        Integer iResult
27024>>>>>>>>>>>>>>>>>        String  sDrvrId
27024>>>>>>>>>>>>>>>>>        UChar[] uaResult
27025>>>>>>>>>>>>>>>>>        
27025>>>>>>>>>>>>>>>>>        Integer iSQLType
27025>>>>>>>>>>>>>>>>>        Integer iBinaryType
27025>>>>>>>>>>>>>>>>>        Integer iLenArray
27025>>>>>>>>>>>>>>>>>        Integer iResizeSize
27025>>>>>>>>>>>>>>>>>        
27025>>>>>>>>>>>>>>>>>        Move 0 to iResult
27026>>>>>>>>>>>>>>>>>        
27026>>>>>>>>>>>>>>>>>        // Get the cli handles
27026>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27027>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27028>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27029>>>>>>>>>>>>>>>>>        
27029>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27031>>>>>>>>>>>>>>>>>            // Check if the column exists
27031>>>>>>>>>>>>>>>>>            If (iCol >= 1 and iCol <= piColumnCount(Self)) Begin
27033>>>>>>>>>>>>>>>>>                            
27033>>>>>>>>>>>>>>>>>                Get SQLColumnType iCol to iSQLType
27034>>>>>>>>>>>>>>>>>                If ( (iSQLType = SQL_BINARY) or (iSQLType = SQL_VARBINARY) or (iSQLType = SQL_LONGVARBINARY) ) Begin
27036>>>>>>>>>>>>>>>>>                    Move 1 to iBinaryType
27037>>>>>>>>>>>>>>>>>                End
27037>>>>>>>>>>>>>>>>>>
27037>>>>>>>>>>>>>>>>>                Else Begin
27038>>>>>>>>>>>>>>>>>                    Move 0 to iBinaryType 
27039>>>>>>>>>>>>>>>>>                End
27039>>>>>>>>>>>>>>>>>>
27039>>>>>>>>>>>>>>>>>    
27039>>>>>>>>>>>>>>>>>                If (iBinaryType) Begin
27041>>>>>>>>>>>>>>>>>                    Move (ResizeArray(uaResult,iLen)) to uaResult
27042>>>>>>>>>>>>>>>>>                End
27042>>>>>>>>>>>>>>>>>>
27042>>>>>>>>>>>>>>>>>                Else Begin
27043>>>>>>>>>>>>>>>>>                    // Character type
27043>>>>>>>>>>>>>>>>>                    // returned as wstring (2 bytes per character)
27043>>>>>>>>>>>>>>>>>                    // Add 1 for string terminator
27043>>>>>>>>>>>>>>>>>                    Move (iLen + 1) to iLen
27044>>>>>>>>>>>>>>>>>                    Move (iLen * 2) to iLenArray // wstring 2 bytes per char
27045>>>>>>>>>>>>>>>>>                    Move (ResizeArray(uaResult,iLenArray)) to uaResult
27046>>>>>>>>>>>>>>>>>                End
27046>>>>>>>>>>>>>>>>>>
27046>>>>>>>>>>>>>>>>>
27046>>>>>>>>>>>>>>>>>                // FUNC_SQLCOLUMNINFO will tell the driver which hdbc and hstmt to use
27046>>>>>>>>>>>>>>>>>                // in the next FUNC_SQLCOLUMNVALUE call.
27046>>>>>>>>>>>>>>>>>                If (ihstmt <> giLastSQLhstmt or ihdbc <> giLastSQLhdbc) Begin
27048>>>>>>>>>>>>>>>>>                    // Setup function arguments
27048>>>>>>>>>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback 0 ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
27053>>>>>>>>>>>>>>>>>                    Move ihstmt to giLastSQLhstmt
27054>>>>>>>>>>>>>>>>>                    Move ihdbc to giLastSQLhdbc
27055>>>>>>>>>>>>>>>>>                End
27055>>>>>>>>>>>>>>>>>>
27055>>>>>>>>>>>>>>>>>                
27055>>>>>>>>>>>>>>>>>                Move False to Err
27056>>>>>>>>>>>>>>>>>                
27056>>>>>>>>>>>>>>>>>                // Call the driver function to get the data
27056>>>>>>>>>>>>>>>>>                // iResult will be the length of the data in bytes 
27056>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETDATA ;                    Callback Self ;                    Passing iCol iLen (AddressOf(uaResult[0])) ;                    Result iResult
27061>>>>>>>>>>>>>>>>>                
27061>>>>>>>>>>>>>>>>>                // If something went wrong, adjust the result
27061>>>>>>>>>>>>>>>>>                If (Err) Begin
27063>>>>>>>>>>>>>>>>>                    Move 0 to iResult
27064>>>>>>>>>>>>>>>>>                End
27064>>>>>>>>>>>>>>>>>>
27064>>>>>>>>>>>>>>>>>                
27064>>>>>>>>>>>>>>>>>                // SQL_NO_TOTAL (-4) Not all data retrieved. Unknown how much is left. 
27064>>>>>>>>>>>>>>>>>                If (iResult = -4) Begin
27066>>>>>>>>>>>>>>>>>                    Move (SizeOfArray(uaResult)) to iResult
27067>>>>>>>>>>>>>>>>>                End
27067>>>>>>>>>>>>>>>>>>
27067>>>>>>>>>>>>>>>>>                
27067>>>>>>>>>>>>>>>>>                If (iBinaryType) Begin
27069>>>>>>>>>>>>>>>>>                    If (iResult < iLen) Begin
27071>>>>>>>>>>>>>>>>>                        Move (ResizeArray(uaResult,iResult)) to uaResult
27072>>>>>>>>>>>>>>>>>                    End
27072>>>>>>>>>>>>>>>>>>
27072>>>>>>>>>>>>>>>>>                End
27072>>>>>>>>>>>>>>>>>>
27072>>>>>>>>>>>>>>>>>                Else Begin
27073>>>>>>>>>>>>>>>>>                    // Character data
27073>>>>>>>>>>>>>>>>>                    //   iResult has length of data in bytes (without zero terminator)
27073>>>>>>>>>>>>>>>>>                    //   uaResult will have data + zero terminator
27073>>>>>>>>>>>>>>>>>                    If (iResult < (iLenArray - 2) ) Begin
27075>>>>>>>>>>>>>>>>>                        // Received less than requested, strip off trailing zeroes.
27075>>>>>>>>>>>>>>>>>                        Move iResult to iResizeSize
27076>>>>>>>>>>>>>>>>>                    End
27076>>>>>>>>>>>>>>>>>>
27076>>>>>>>>>>>>>>>>>                    Else Begin
27077>>>>>>>>>>>>>>>>>                        // Strip off zero terminator
27077>>>>>>>>>>>>>>>>>                        Move (iLenArray - 2) to iResizeSize
27078>>>>>>>>>>>>>>>>>                    End
27078>>>>>>>>>>>>>>>>>>
27078>>>>>>>>>>>>>>>>>                    
27078>>>>>>>>>>>>>>>>>                    Move (ResizeArray(uaResult,iResizeSize)) to uaResult
27079>>>>>>>>>>>>>>>>>                    
27079>>>>>>>>>>>>>>>>>                End
27079>>>>>>>>>>>>>>>>>>
27079>>>>>>>>>>>>>>>>>            End
27079>>>>>>>>>>>>>>>>>>
27079>>>>>>>>>>>>>>>>>            Else Begin
27080>>>>>>>>>>>>>>>>>                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLGetData"
27081>>>>>>>>>>>>>>>>>            End
27081>>>>>>>>>>>>>>>>>>
27081>>>>>>>>>>>>>>>>>        End
27081>>>>>>>>>>>>>>>>>>
27081>>>>>>>>>>>>>>>>>        Else Begin
27082>>>>>>>>>>>>>>>>>            Send HandleError ihstmt ihdbc sDrvrId "SQLGetData"
27083>>>>>>>>>>>>>>>>>        End
27083>>>>>>>>>>>>>>>>>>
27083>>>>>>>>>>>>>>>>>        
27083>>>>>>>>>>>>>>>>>        // Fill global result
27083>>>>>>>>>>>>>>>>>        If (iResult > 0) Begin
27085>>>>>>>>>>>>>>>>>            Move 1 to SQLResult // SQLResult == 1 : Something was found
27086>>>>>>>>>>>>>>>>>        End
27086>>>>>>>>>>>>>>>>>>
27086>>>>>>>>>>>>>>>>>        Else Begin
27087>>>>>>>>>>>>>>>>>           Move 0 to SQLResult // SQLResult == 0 : no (more) data found
27088>>>>>>>>>>>>>>>>>        End
27088>>>>>>>>>>>>>>>>>>
27088>>>>>>>>>>>>>>>>>        
27088>>>>>>>>>>>>>>>>>        Function_Return uaResult
27089>>>>>>>>>>>>>>>>>
27089>>>>>>>>>>>>>>>>>    End_Function
27090>>>>>>>>>>>>>>>>>    
27090>>>>>>>>>>>>>>>>>    
27090>>>>>>>>>>>>>>>>>    // Map a column name to a number, if the name id not found no
27090>>>>>>>>>>>>>>>>>    // error is generated the returned number will be 0 (zero) in
27090>>>>>>>>>>>>>>>>>    // that case
27090>>>>>>>>>>>>>>>>>    Function SQLColumnMap String sColname Returns Integer
27092>>>>>>>>>>>>>>>>>        Integer ihdbc
27092>>>>>>>>>>>>>>>>>        Integer ihstmt
27092>>>>>>>>>>>>>>>>>        Integer iNumColumns
27092>>>>>>>>>>>>>>>>>        Integer iColCount
27092>>>>>>>>>>>>>>>>>        Integer iColNum
27092>>>>>>>>>>>>>>>>>        String  sDrvrId
27092>>>>>>>>>>>>>>>>>        String  sCurColName
27092>>>>>>>>>>>>>>>>>        
27092>>>>>>>>>>>>>>>>>        // Get the cli handles
27092>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27093>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27094>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27095>>>>>>>>>>>>>>>>>        
27095>>>>>>>>>>>>>>>>>        // Get the number by looping through the column names
27095>>>>>>>>>>>>>>>>>        Move 0 to iColNum
27096>>>>>>>>>>>>>>>>>        Get SQLPrivateStmtAttribute SQLSTMTATTRIB_COLUMNCOUNT ihdbc sDrvrId ihstmt to iNumColumns
27097>>>>>>>>>>>>>>>>>        For iColCount from 1 to iNumColumns
27103>>>>>>>>>>>>>>>>>>
27103>>>>>>>>>>>>>>>>>            Get SQLPrivateColAttribute iColCount SQLCOLATTRIB_LABEL ihdbc sDrvrId ihstmt to sCurColName
27104>>>>>>>>>>>>>>>>>            If (Uppercase(Trim(sColName)) = Uppercase(Trim(sCurColName))) ;                Move iColCount to iColNum
27107>>>>>>>>>>>>>>>>>            
27107>>>>>>>>>>>>>>>>>            If (iColNum) ;                Break
27110>>>>>>>>>>>>>>>>>        Loop
27111>>>>>>>>>>>>>>>>>>
27111>>>>>>>>>>>>>>>>>        
27111>>>>>>>>>>>>>>>>>        Function_Return iColNum
27112>>>>>>>>>>>>>>>>>    End_Function
27113>>>>>>>>>>>>>>>>>    
27113>>>>>>>>>>>>>>>>>    
27113>>>>>>>>>>>>>>>>>    // SQLStmtAttribute
27113>>>>>>>>>>>>>>>>>    // Moved to SQLGetStatementAttribute. 
27113>>>>>>>>>>>>>>>>>    // This function is still here for backward compatibility.
27113>>>>>>>>>>>>>>>>>
27113>>>>>>>>>>>>>>>>>    Function SQLStmtAttribute Integer iAttribId Returns String
27115>>>>>>>>>>>>>>>>>        String  sResult
27115>>>>>>>>>>>>>>>>>
27115>>>>>>>>>>>>>>>>>        Get SQLGetStmtAttribute iAttribId to sResult        
27116>>>>>>>>>>>>>>>>>        
27116>>>>>>>>>>>>>>>>>        Function_Return sResult
27117>>>>>>>>>>>>>>>>>    End_Function
27118>>>>>>>>>>>>>>>>>
27118>>>>>>>>>>>>>>>>> 
27118>>>>>>>>>>>>>>>>>   Function SQLGetStmtAttribute Integer iAttribId Returns String
27120>>>>>>>>>>>>>>>>>        Integer ihdbc
27120>>>>>>>>>>>>>>>>>        Integer ihstmt
27120>>>>>>>>>>>>>>>>>        String  sResult
27120>>>>>>>>>>>>>>>>>        String  sDrvrId
27120>>>>>>>>>>>>>>>>>        
27120>>>>>>>>>>>>>>>>>        // Initialize
27120>>>>>>>>>>>>>>>>>        Move "" to sResult
27121>>>>>>>>>>>>>>>>>        
27121>>>>>>>>>>>>>>>>>        // Get the cli handles
27121>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27122>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27123>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27124>>>>>>>>>>>>>>>>>        
27124>>>>>>>>>>>>>>>>>        // Get the attribute
27124>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") ;            Get SQLPrivateStmtAttribute iAttribId ihdbc sDrvrId ihstmt to sResult
27127>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetStmtAttribute"
27129>>>>>>>>>>>>>>>>>        
27129>>>>>>>>>>>>>>>>>        Function_Return sResult
27130>>>>>>>>>>>>>>>>>    End_Function
27131>>>>>>>>>>>>>>>>>
27131>>>>>>>>>>>>>>>>>    
27131>>>>>>>>>>>>>>>>>    Procedure SQLSetStmtAttribute Integer iAttribId String sAttribValue 
27133>>>>>>>>>>>>>>>>>
27133>>>>>>>>>>>>>>>>>        Integer ihdbc
27133>>>>>>>>>>>>>>>>>        Integer ihstmt
27133>>>>>>>>>>>>>>>>>        String  sDrvrId
27133>>>>>>>>>>>>>>>>>        
27133>>>>>>>>>>>>>>>>>        Integer iLen
27133>>>>>>>>>>>>>>>>>        Integer bLegalAttrib
27133>>>>>>>>>>>>>>>>>        Integer iVoid
27133>>>>>>>>>>>>>>>>>        Integer iAttribValue
27133>>>>>>>>>>>>>>>>>
27133>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27134>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27135>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27136>>>>>>>>>>>>>>>>>        
27136>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27138>>>>>>>>>>>>>>>>>            Case Begin
27138>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)
27140>>>>>>>>>>>>>>>>>                    Move DFTRUE to bLegalAttrib
27141>>>>>>>>>>>>>>>>>                    Break
27142>>>>>>>>>>>>>>>>>                    
27142>>>>>>>>>>>>>>>>>                Case Else
27142>>>>>>>>>>>>>>>>>                    Move DFFALSE to bLegalAttrib
27143>>>>>>>>>>>>>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLSetStmtAttribute"
27144>>>>>>>>>>>>>>>>>            Case End
27144>>>>>>>>>>>>>>>>>
27144>>>>>>>>>>>>>>>>>            If (bLegalAttrib) Begin
27146>>>>>>>>>>>>>>>>>                If (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE) Begin
27148>>>>>>>>>>>>>>>>>                    
27148>>>>>>>>>>>>>>>>>                    Move sAttribValue to iAttribValue // Check numeric?
27149>>>>>>>>>>>>>>>>>                    Case Begin
27149>>>>>>>>>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_FORWARD_ONLY)
27151>>>>>>>>>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_DYNAMIC)
27154>>>>>>>>>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_KEYSET_DRIVEN)
27157>>>>>>>>>>>>>>>>>                        Case (iAttribValue = SQL_CURSOR_STATIC)
27160>>>>>>>>>>>>>>>>>                            Break
27161>>>>>>>>>>>>>>>>>                            
27161>>>>>>>>>>>>>>>>>                        Case Else
27161>>>>>>>>>>>>>>>>>                            Move DFFALSE to bLegalAttrib
27162>>>>>>>>>>>>>>>>>                            Send StmtError CLIERR_SQLINVALID_ATTRIBUTE (SFormat("Invalid value for SQLSTMTATTRIB_CURSOR_TYPE: %1", iAttribValue)) "SQLSetStmtAttribute"
27163>>>>>>>>>>>>>>>>>
27163>>>>>>>>>>>>>>>>>                    Case End
27163>>>>>>>>>>>>>>>>>                End
27163>>>>>>>>>>>>>>>>>>
27163>>>>>>>>>>>>>>>>>            End
27163>>>>>>>>>>>>>>>>>>
27163>>>>>>>>>>>>>>>>>
27163>>>>>>>>>>>>>>>>>            
27163>>>>>>>>>>>>>>>>>            If (bLegalAttrib) Begin
27165>>>>>>>>>>>>>>>>>                
27165>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                    Callback Self ;                    Passing ihdbc iVoid ihstmt ;                    Result iVoid
27170>>>>>>>>>>>>>>>>>                
27170>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSETSTMTINTATTRIB ;                    Callback Self ;                    Passing iAttribId iAttribValue 0 ;                    Result iVoid
27175>>>>>>>>>>>>>>>>>            End
27175>>>>>>>>>>>>>>>>>>
27175>>>>>>>>>>>>>>>>>        End
27175>>>>>>>>>>>>>>>>>>
27175>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
27177>>>>>>>>>>>>>>>>>        
27177>>>>>>>>>>>>>>>>>        
27177>>>>>>>>>>>>>>>>>        
27177>>>>>>>>>>>>>>>>>    End_Procedure
27178>>>>>>>>>>>>>>>>>    
27178>>>>>>>>>>>>>>>>>    
27178>>>>>>>>>>>>>>>>>    
27178>>>>>>>>>>>>>>>>>    Function SQLPrivateStmtAttribute Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
27180>>>>>>>>>>>>>>>>>        String  sResult
27180>>>>>>>>>>>>>>>>>        Integer iLen
27180>>>>>>>>>>>>>>>>>        Integer bLegalAttrib
27180>>>>>>>>>>>>>>>>>        
27180>>>>>>>>>>>>>>>>>        // Initialize
27180>>>>>>>>>>>>>>>>>        Move ""     to sResult
27181>>>>>>>>>>>>>>>>>        
27181>>>>>>>>>>>>>>>>>        // Get the attribute
27181>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27183>>>>>>>>>>>>>>>>>            Case Begin
27183>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_COLUMNCOUNT)
27185>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT)
27188>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_ROWCOUNT_TYPE)
27191>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_NUMMESSAGES)
27194>>>>>>>>>>>>>>>>>                Case (iAttribId = SQLSTMTATTRIB_CURSOR_TYPE)
27197>>>>>>>>>>>>>>>>>                    Move DFTRUE to bLegalAttrib
27198>>>>>>>>>>>>>>>>>                    Break
27199>>>>>>>>>>>>>>>>>                    
27199>>>>>>>>>>>>>>>>>                Case Else
27199>>>>>>>>>>>>>>>>>                    Move DFFALSE to bLegalAttrib
27200>>>>>>>>>>>>>>>>>                    Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateStmtAttribute"
27201>>>>>>>>>>>>>>>>>            Case End
27201>>>>>>>>>>>>>>>>>            
27201>>>>>>>>>>>>>>>>>            If (bLegalAttrib) Begin
27203>>>>>>>>>>>>>>>>>                // Setup function arguments
27203>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSTMTINTATTRIB ;                    Callback Self ;                    Passing ihdbc iAttribId ihstmt ;                    Result sResult
27208>>>>>>>>>>>>>>>>>            End
27208>>>>>>>>>>>>>>>>>>
27208>>>>>>>>>>>>>>>>>        End
27208>>>>>>>>>>>>>>>>>>
27208>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateStmtAttribute"
27210>>>>>>>>>>>>>>>>>        
27210>>>>>>>>>>>>>>>>>        Function_Return sResult
27211>>>>>>>>>>>>>>>>>    End_Function
27212>>>>>>>>>>>>>>>>>    
27212>>>>>>>>>>>>>>>>>    
27212>>>>>>>>>>>>>>>>>    
27212>>>>>>>>>>>>>>>>>    // Get a column's attribute
27212>>>>>>>>>>>>>>>>>    Function SQLColAttribute Integer iCol Integer iAttribId Returns String
27214>>>>>>>>>>>>>>>>>        Integer ihdbc
27214>>>>>>>>>>>>>>>>>        Integer ihstmt
27214>>>>>>>>>>>>>>>>>        String  sResult
27214>>>>>>>>>>>>>>>>>        String  sDrvrId
27214>>>>>>>>>>>>>>>>>        
27214>>>>>>>>>>>>>>>>>        // Initialize
27214>>>>>>>>>>>>>>>>>        Move "" to sResult
27215>>>>>>>>>>>>>>>>>        
27215>>>>>>>>>>>>>>>>>        // Get the cli handles
27215>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27216>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27217>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27218>>>>>>>>>>>>>>>>>        
27218>>>>>>>>>>>>>>>>>        // Get the attribute
27218>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") ;            Get SQLPrivateColAttribute iCol iAttribId ihdbc sDrvrId ihstmt to sResult
27221>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLColAttribute"
27223>>>>>>>>>>>>>>>>>        
27223>>>>>>>>>>>>>>>>>        Function_Return sResult
27224>>>>>>>>>>>>>>>>>    End_Function
27225>>>>>>>>>>>>>>>>>    
27225>>>>>>>>>>>>>>>>>    Function SQLPrivateColAttribute Integer iCol Integer iAttribId Integer ihdbc String sDrvrId Integer ihstmt Returns String
27227>>>>>>>>>>>>>>>>>        String  sResult
27227>>>>>>>>>>>>>>>>>        String  sEmpty
27227>>>>>>>>>>>>>>>>>        Integer bIsStringAttribute
27227>>>>>>>>>>>>>>>>>        Integer iLen
27227>>>>>>>>>>>>>>>>>        Integer iVoid
27227>>>>>>>>>>>>>>>>>        Integer bLegalAttrib
27227>>>>>>>>>>>>>>>>>        Integer bLegalColumn
27227>>>>>>>>>>>>>>>>>        
27227>>>>>>>>>>>>>>>>>        // Initialize
27227>>>>>>>>>>>>>>>>>        Move "" to sResult
27228>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27229>>>>>>>>>>>>>>>>>        Move 0  to iLen
27230>>>>>>>>>>>>>>>>>        
27230>>>>>>>>>>>>>>>>>        // Get the attribute
27230>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27232>>>>>>>>>>>>>>>>>            Get SQLPrivateColumnIsLegal ihdbc sDrvrId ihstmt iCol to bLegalColumn
27233>>>>>>>>>>>>>>>>>            If (bLegalColumn) Begin
27235>>>>>>>>>>>>>>>>>                // Determine the atributes type
27235>>>>>>>>>>>>>>>>>                Case Begin
27235>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SIZE)
27237>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LENGTH)
27240>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_PRECISION)
27243>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_SQLTYPE)
27246>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_NULLABLE)
27249>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_DFTYPE)
27252>>>>>>>>>>>>>>>>>                        Move DFFALSE to bIsStringAttribute
27253>>>>>>>>>>>>>>>>>                        Move DFTRUE to bLegalAttrib
27254>>>>>>>>>>>>>>>>>                        Break
27255>>>>>>>>>>>>>>>>>                        
27255>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_LABEL)
27258>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASECOLUMNNAME)
27261>>>>>>>>>>>>>>>>>                    Case (iAttribId = SQLCOLATTRIB_BASETABLENAME)
27264>>>>>>>>>>>>>>>>>                        Move DFTRUE to bIsStringAttribute
27265>>>>>>>>>>>>>>>>>                        Move DFTRUE to bLegalAttrib
27266>>>>>>>>>>>>>>>>>                        Break
27267>>>>>>>>>>>>>>>>>                        
27267>>>>>>>>>>>>>>>>>                    Case Else
27267>>>>>>>>>>>>>>>>>                        Move DFFALSE to bLegalAttrib
27268>>>>>>>>>>>>>>>>>                        Send SQLIllegalAttribute ("Attribute is = " + String(iAttribId) + ")") "SQLPrivateColAttribute"
27269>>>>>>>>>>>>>>>>>                Case End
27269>>>>>>>>>>>>>>>>>                
27269>>>>>>>>>>>>>>>>>                If (bLegalAttrib) Begin
27271>>>>>>>>>>>>>>>>>                    // Setup function arguments
27271>>>>>>>>>>>>>>>>>                    Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                        Callback Self ;                        Passing ihdbc iCol ihstmt ;                        Result iVoid
27276>>>>>>>>>>>>>>>>>                    
27276>>>>>>>>>>>>>>>>>                    If (bIsStringAttribute) Begin
27278>>>>>>>>>>>>>>>>>                        // Call the driver function to get the data length
27278>>>>>>>>>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIBLEN ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result iLen
27283>>>>>>>>>>>>>>>>>                        
27283>>>>>>>>>>>>>>>>>                        If (iLen) Begin
27285>>>>>>>>>>>>>>>>>                            // Allocate
27285>>>>>>>>>>>>>>>>>                            Move (Repeat(' ', iLen)) to sResult
27286>>>>>>>>>>>>>>>>>                            
27286>>>>>>>>>>>>>>>>>                            // Call the driver function to get the name
27286>>>>>>>>>>>>>>>>>                            Call_Driver 0 sDrvrId Function FUNC_SQLCOLSTRINGATTRIB ;                                Callback Self ;                                Passing sResult sEmpty iAttribId ;                                Result iVoid
27291>>>>>>>>>>>>>>>>>                        End
27291>>>>>>>>>>>>>>>>>>
27291>>>>>>>>>>>>>>>>>                    End
27291>>>>>>>>>>>>>>>>>>
27291>>>>>>>>>>>>>>>>>                    Else Begin
27292>>>>>>>>>>>>>>>>>                        // get the attribute
27292>>>>>>>>>>>>>>>>>                        Call_Driver 0 sDrvrId Function FUNC_SQLCOLINTATTRIB ;                            Callback Self ;                            Passing sEmpty sEmpty iAttribId ;                            Result sResult
27297>>>>>>>>>>>>>>>>>                    End
27297>>>>>>>>>>>>>>>>>>
27297>>>>>>>>>>>>>>>>>                End
27297>>>>>>>>>>>>>>>>>>
27297>>>>>>>>>>>>>>>>>            End
27297>>>>>>>>>>>>>>>>>>
27297>>>>>>>>>>>>>>>>>            Else ;                Send StmtError CLIERR_SQLINVALID_COLUMN ("(Column number = " + String(iCol) + ")") "SQLPrivateColAttribute"
27299>>>>>>>>>>>>>>>>>        End
27299>>>>>>>>>>>>>>>>>>
27299>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLPrivateColAttribute"
27301>>>>>>>>>>>>>>>>>        
27301>>>>>>>>>>>>>>>>>        Function_Return sResult
27302>>>>>>>>>>>>>>>>>    End_Function
27303>>>>>>>>>>>>>>>>>    
27303>>>>>>>>>>>>>>>>>    
27303>>>>>>>>>>>>>>>>>    // Preapre for calling a stored procedure, pass the procedure name.
27303>>>>>>>>>>>>>>>>>    Procedure SQLSetProcedureName String sProcName String sSchemaArg
27305>>>>>>>>>>>>>>>>>        Integer ihdbc
27305>>>>>>>>>>>>>>>>>        Integer ihstmt
27305>>>>>>>>>>>>>>>>>        String  sDrvrId
27305>>>>>>>>>>>>>>>>>        Integer iVoid
27305>>>>>>>>>>>>>>>>>        String  sSchema
27305>>>>>>>>>>>>>>>>>        String  sEmpty
27305>>>>>>>>>>>>>>>>>        
27305>>>>>>>>>>>>>>>>>        // Initialize
27305>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27306>>>>>>>>>>>>>>>>>        
27306>>>>>>>>>>>>>>>>>        // Get the cli handles
27306>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27307>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27308>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27309>>>>>>>>>>>>>>>>>        
27309>>>>>>>>>>>>>>>>>        // Call the procedure
27309>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27311>>>>>>>>>>>>>>>>>            If (Num_Arguments >= 2) ;                Move sSchemaArg to sSchema
27314>>>>>>>>>>>>>>>>>            Else ;                Move "" to sSchema
27316>>>>>>>>>>>>>>>>>            
27316>>>>>>>>>>>>>>>>>            If (sSchema <> "") Begin
27318>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCSCHEMA ;                    Callback Self ;                    Passing ihdbc sSchema ihstmt ;                    Result iVoid
27323>>>>>>>>>>>>>>>>>            End
27323>>>>>>>>>>>>>>>>>>
27323>>>>>>>>>>>>>>>>>            
27323>>>>>>>>>>>>>>>>>            // Call the procedure
27323>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCNAME ;                Callback Self ;                Passing ihdbc sProcName ihstmt ;                Result iVoid
27328>>>>>>>>>>>>>>>>>            
27328>>>>>>>>>>>>>>>>>            Set piLastArgument to 0
27329>>>>>>>>>>>>>>>>>        End
27329>>>>>>>>>>>>>>>>>>
27329>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLSetProcedurename"
27331>>>>>>>>>>>>>>>>>    End_Procedure
27332>>>>>>>>>>>>>>>>>    
27332>>>>>>>>>>>>>>>>>    // Pass the next argument
27332>>>>>>>>>>>>>>>>>    Procedure SQLSetNextArgument String sArgument
27334>>>>>>>>>>>>>>>>>        Integer iArgnum
27334>>>>>>>>>>>>>>>>>        
27334>>>>>>>>>>>>>>>>>        Get piLastArgument to iArgnum
27335>>>>>>>>>>>>>>>>>        Increment iArgnum
27336>>>>>>>>>>>>>>>>>        Send SQLSetArgument iArgnum sArgument
27337>>>>>>>>>>>>>>>>>        Set piLastArgument to iArgnum
27338>>>>>>>>>>>>>>>>>    End_Procedure
27339>>>>>>>>>>>>>>>>>    
27339>>>>>>>>>>>>>>>>>    
27339>>>>>>>>>>>>>>>>>    
27339>>>>>>>>>>>>>>>>>    // Set the next argument
27339>>>>>>>>>>>>>>>>>    Procedure SQLSetArgument Integer iArgnum String sArgument
27341>>>>>>>>>>>>>>>>>        Integer ihdbc
27341>>>>>>>>>>>>>>>>>        Integer ihstmt
27341>>>>>>>>>>>>>>>>>        String  sDrvrId
27341>>>>>>>>>>>>>>>>>        Integer iVoid
27341>>>>>>>>>>>>>>>>>        String  sEmpty
27341>>>>>>>>>>>>>>>>>        
27341>>>>>>>>>>>>>>>>>        // Initialize
27341>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27342>>>>>>>>>>>>>>>>>        
27342>>>>>>>>>>>>>>>>>        // Get the cli handles
27342>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27343>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27344>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27345>>>>>>>>>>>>>>>>>        
27345>>>>>>>>>>>>>>>>>        // Call the procedure
27345>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27347>>>>>>>>>>>>>>>>>            // Pass the information
27347>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iArgnum ihstmt ;                Result iVoid
27352>>>>>>>>>>>>>>>>>            
27352>>>>>>>>>>>>>>>>>            // Pass the argument
27352>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCARG ;                Callback Self ;                Passing sArgument sEmpty 0 ;                Result iVoid
27357>>>>>>>>>>>>>>>>>        End
27357>>>>>>>>>>>>>>>>>>
27357>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLSetArgument"
27359>>>>>>>>>>>>>>>>>    End_Procedure
27360>>>>>>>>>>>>>>>>>    
27360>>>>>>>>>>>>>>>>>    Procedure SQLSetNextParameter String sParamValue Integer iParamType
27362>>>>>>>>>>>>>>>>>        Integer iParamNum 
27362>>>>>>>>>>>>>>>>>        Integer iType
27362>>>>>>>>>>>>>>>>>        
27362>>>>>>>>>>>>>>>>>        If (num_arguments < 2) Begin
27364>>>>>>>>>>>>>>>>>            Move typeString to iType
27365>>>>>>>>>>>>>>>>>        End
27365>>>>>>>>>>>>>>>>>>
27365>>>>>>>>>>>>>>>>>        Else Begin
27366>>>>>>>>>>>>>>>>>            Move iParamType to iType
27367>>>>>>>>>>>>>>>>>        End
27367>>>>>>>>>>>>>>>>>>
27367>>>>>>>>>>>>>>>>>        
27367>>>>>>>>>>>>>>>>>        Get piLastArgument to iParamNum
27368>>>>>>>>>>>>>>>>>        Increment iParamNum
27369>>>>>>>>>>>>>>>>>        Send SQLSetParameter iParamNum sParamValue iType
27370>>>>>>>>>>>>>>>>>        Set piLastArgument to iParamNum
27371>>>>>>>>>>>>>>>>>    End_Procedure
27372>>>>>>>>>>>>>>>>>
27372>>>>>>>>>>>>>>>>>    Procedure SQLSetParameter Integer iParamNum String sParamValue Integer iParamType
27374>>>>>>>>>>>>>>>>>        
27374>>>>>>>>>>>>>>>>>        Integer ihdbc
27374>>>>>>>>>>>>>>>>>        Integer ihstmt
27374>>>>>>>>>>>>>>>>>        String  sDrvrId
27374>>>>>>>>>>>>>>>>>        Integer iVoid
27374>>>>>>>>>>>>>>>>>        String  sEmpty
27374>>>>>>>>>>>>>>>>>        Integer iType
27374>>>>>>>>>>>>>>>>>        
27374>>>>>>>>>>>>>>>>>        If (num_arguments < 3) Begin
27376>>>>>>>>>>>>>>>>>            Move typeString to iType
27377>>>>>>>>>>>>>>>>>        End
27377>>>>>>>>>>>>>>>>>>
27377>>>>>>>>>>>>>>>>>        Else Begin
27378>>>>>>>>>>>>>>>>>            Move iParamType to iType
27379>>>>>>>>>>>>>>>>>        End
27379>>>>>>>>>>>>>>>>>>
27379>>>>>>>>>>>>>>>>>        
27379>>>>>>>>>>>>>>>>>        Case Begin
27379>>>>>>>>>>>>>>>>>            Case (iType = typeDate )    
27381>>>>>>>>>>>>>>>>>
27381>>>>>>>>>>>>>>>>>                If (sParamValue <> "") Begin
27383>>>>>>>>>>>>>>>>>                    ConvertToXml typeDate sParamValue to sParamValue
27384>>>>>>>>>>>>>>>>>                End
27384>>>>>>>>>>>>>>>>>>
27384>>>>>>>>>>>>>>>>>                
27384>>>>>>>>>>>>>>>>>                Break
27385>>>>>>>>>>>>>>>>>
27385>>>>>>>>>>>>>>>>>            Case (iType = typeDatetime )    
27388>>>>>>>>>>>>>>>>>
27388>>>>>>>>>>>>>>>>>                If (sParamValue <> "") Begin
27390>>>>>>>>>>>>>>>>>                    ConvertToXml esqlDatetime sParamValue to sParamValue
27391>>>>>>>>>>>>>>>>>                    Move (Replace('T',sParamValue,' ')) to sParamValue 
27392>>>>>>>>>>>>>>>>>                End
27392>>>>>>>>>>>>>>>>>>
27392>>>>>>>>>>>>>>>>>
27392>>>>>>>>>>>>>>>>>                Break
27393>>>>>>>>>>>>>>>>>
27393>>>>>>>>>>>>>>>>>            Case (iType = typeNumber )    
27396>>>>>>>>>>>>>>>>>
27396>>>>>>>>>>>>>>>>>                If (sParamValue <> "") Begin
27398>>>>>>>>>>>>>>>>>                    ConvertToXml typeNumber sParamValue to sParamValue
27399>>>>>>>>>>>>>>>>>                End
27399>>>>>>>>>>>>>>>>>>
27399>>>>>>>>>>>>>>>>>                
27399>>>>>>>>>>>>>>>>>                Break
27400>>>>>>>>>>>>>>>>>            
27400>>>>>>>>>>>>>>>>>            Case (iType = typeTime )    
27403>>>>>>>>>>>>>>>>>
27403>>>>>>>>>>>>>>>>>                If (sParamValue <> "") Begin
27405>>>>>>>>>>>>>>>>>                    ConvertToXml esqlTime sParamValue to sParamValue
27406>>>>>>>>>>>>>>>>>                End
27406>>>>>>>>>>>>>>>>>>
27406>>>>>>>>>>>>>>>>>                
27406>>>>>>>>>>>>>>>>>                Break
27407>>>>>>>>>>>>>>>>>                
27407>>>>>>>>>>>>>>>>>            Case Else
27407>>>>>>>>>>>>>>>>>                    // sParamValue is a string type or a type that must be passed as a string
27407>>>>>>>>>>>>>>>>>                    Break
27408>>>>>>>>>>>>>>>>>                
27408>>>>>>>>>>>>>>>>>        Case End
27408>>>>>>>>>>>>>>>>>        
27408>>>>>>>>>>>>>>>>>        
27408>>>>>>>>>>>>>>>>>        // Initialize
27408>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27409>>>>>>>>>>>>>>>>>        
27409>>>>>>>>>>>>>>>>>        // Get the cli handles
27409>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27410>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27411>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27412>>>>>>>>>>>>>>>>>        
27412>>>>>>>>>>>>>>>>>        // Call the procedure
27412>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27414>>>>>>>>>>>>>>>>>            // Pass the information
27414>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iParamnum ihstmt ;                Result iVoid
27419>>>>>>>>>>>>>>>>>            
27419>>>>>>>>>>>>>>>>>            // Pass the argument
27419>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLSETPROCARG ;                Callback Self ;                Passing sParamValue sEmpty 0 ;                Result iVoid
27424>>>>>>>>>>>>>>>>>        End
27424>>>>>>>>>>>>>>>>>>
27424>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLSetParameter"
27426>>>>>>>>>>>>>>>>>    End_Procedure
27427>>>>>>>>>>>>>>>>>    
27427>>>>>>>>>>>>>>>>>    
27427>>>>>>>>>>>>>>>>>    // Call a stored procedure
27427>>>>>>>>>>>>>>>>>    Procedure SQLCall
27429>>>>>>>>>>>>>>>>>        Integer ihdbc
27429>>>>>>>>>>>>>>>>>        Integer ihstmt
27429>>>>>>>>>>>>>>>>>        String  sDrvrId
27429>>>>>>>>>>>>>>>>>        Integer iVoid
27429>>>>>>>>>>>>>>>>>        String  sEmpty
27429>>>>>>>>>>>>>>>>>        
27429>>>>>>>>>>>>>>>>>        // Initialize
27429>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27430>>>>>>>>>>>>>>>>>        
27430>>>>>>>>>>>>>>>>>        // Get the cli handles
27430>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27431>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27432>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27433>>>>>>>>>>>>>>>>>        
27433>>>>>>>>>>>>>>>>>        // Call the procedure
27433>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27435>>>>>>>>>>>>>>>>>            // Call the procedure
27435>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCALL ;                Callback Self ;                Passing ihdbc sEmpty ihstmt ;                Result iVoid
27440>>>>>>>>>>>>>>>>>            
27440>>>>>>>>>>>>>>>>>            Send SQLGetStatementAttributes
27441>>>>>>>>>>>>>>>>>            Set piLastArgument to 0
27442>>>>>>>>>>>>>>>>>        End
27442>>>>>>>>>>>>>>>>>>
27442>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLCall"
27444>>>>>>>>>>>>>>>>>    End_Procedure
27445>>>>>>>>>>>>>>>>>    
27445>>>>>>>>>>>>>>>>>    
27445>>>>>>>>>>>>>>>>>    // Get the next argument
27445>>>>>>>>>>>>>>>>>    Function SQLGetNextArgument Returns String
27447>>>>>>>>>>>>>>>>>        Integer iArgnum
27447>>>>>>>>>>>>>>>>>        String  sResult
27447>>>>>>>>>>>>>>>>>        
27447>>>>>>>>>>>>>>>>>        Get piLastArgument to iArgnum
27448>>>>>>>>>>>>>>>>>        Increment iArgnum
27449>>>>>>>>>>>>>>>>>        Get SQLGetArgument iArgnum to sResult
27450>>>>>>>>>>>>>>>>>        Set piLastArgument to iArgnum
27451>>>>>>>>>>>>>>>>>        
27451>>>>>>>>>>>>>>>>>        Function_Return sResult
27452>>>>>>>>>>>>>>>>>    End_Function
27453>>>>>>>>>>>>>>>>>    
27453>>>>>>>>>>>>>>>>>    
27453>>>>>>>>>>>>>>>>>    
27453>>>>>>>>>>>>>>>>>    // Get the specified argument from a procedure
27453>>>>>>>>>>>>>>>>>    Function SQLGetArgument Integer iArgnum Returns String
27455>>>>>>>>>>>>>>>>>        Integer ihdbc
27455>>>>>>>>>>>>>>>>>        Integer ihstmt
27455>>>>>>>>>>>>>>>>>        String  sDrvrId
27455>>>>>>>>>>>>>>>>>        Integer iVoid
27455>>>>>>>>>>>>>>>>>        String  sEmpty
27455>>>>>>>>>>>>>>>>>        String  sArgument
27455>>>>>>>>>>>>>>>>>        Integer iLen
27455>>>>>>>>>>>>>>>>>        
27455>>>>>>>>>>>>>>>>>        // Initialize
27455>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27456>>>>>>>>>>>>>>>>>        Move "" to sArgument
27457>>>>>>>>>>>>>>>>>        
27457>>>>>>>>>>>>>>>>>        // Get the cli handles
27457>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27458>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27459>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27460>>>>>>>>>>>>>>>>>        
27460>>>>>>>>>>>>>>>>>        // Call the procedure
27460>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27462>>>>>>>>>>>>>>>>>            // Pass the information
27462>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iArgnum ihstmt ;                Result iVoid
27467>>>>>>>>>>>>>>>>>            
27467>>>>>>>>>>>>>>>>>            // Get the length
27467>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCARGLEN ;                Callback Self ;                Passing sEmpty sEmpty 0 ;                Result iLen
27472>>>>>>>>>>>>>>>>>            
27472>>>>>>>>>>>>>>>>>            If (iLen) Begin
27474>>>>>>>>>>>>>>>>>                // Allocate
27474>>>>>>>>>>>>>>>>>                Move (Repeat(' ', iLen)) to sArgument
27475>>>>>>>>>>>>>>>>>                
27475>>>>>>>>>>>>>>>>>                // Pass the argument
27475>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCARG ;                    Callback Self ;                    Passing sArgument sEmpty 0 ;                    Result iVoid
27480>>>>>>>>>>>>>>>>>            End
27480>>>>>>>>>>>>>>>>>>
27480>>>>>>>>>>>>>>>>>        End
27480>>>>>>>>>>>>>>>>>>
27480>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetArgument"
27482>>>>>>>>>>>>>>>>>        
27482>>>>>>>>>>>>>>>>>        Function_Return sArgument
27483>>>>>>>>>>>>>>>>>    End_Function
27484>>>>>>>>>>>>>>>>>    
27484>>>>>>>>>>>>>>>>>    
27484>>>>>>>>>>>>>>>>>    // Get the return value of a stored function
27484>>>>>>>>>>>>>>>>>    Function SQLReturnValue Returns String
27486>>>>>>>>>>>>>>>>>        Integer ihdbc
27486>>>>>>>>>>>>>>>>>        Integer ihstmt
27486>>>>>>>>>>>>>>>>>        String  sDrvrId
27486>>>>>>>>>>>>>>>>>        Integer iVoid
27486>>>>>>>>>>>>>>>>>        String  sEmpty
27486>>>>>>>>>>>>>>>>>        String  sRetval
27486>>>>>>>>>>>>>>>>>        Integer iLen
27486>>>>>>>>>>>>>>>>>        
27486>>>>>>>>>>>>>>>>>        // Initialize
27486>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27487>>>>>>>>>>>>>>>>>        Move "" to sRetval
27488>>>>>>>>>>>>>>>>>        
27488>>>>>>>>>>>>>>>>>        // Get the cli handles
27488>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27489>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27490>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27491>>>>>>>>>>>>>>>>>        
27491>>>>>>>>>>>>>>>>>        // Call the procedure
27491>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27493>>>>>>>>>>>>>>>>>            // Get the length
27493>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCRETVALLEN ;                Callback Self ;                Passing ihdbc sEmpty ihstmt  ;                Result iLen
27498>>>>>>>>>>>>>>>>>            
27498>>>>>>>>>>>>>>>>>            If (iLen) Begin
27500>>>>>>>>>>>>>>>>>                // Allocate
27500>>>>>>>>>>>>>>>>>                Move (Repeat(' ', iLen)) to sRetval
27501>>>>>>>>>>>>>>>>>                
27501>>>>>>>>>>>>>>>>>                // Pass the argument
27501>>>>>>>>>>>>>>>>>                Call_Driver 0 sDrvrId Function FUNC_SQLGETPROCRETVAL ;                    Callback Self ;                    Passing ihdbc sRetval ihstmt ;                    Result iVoid
27506>>>>>>>>>>>>>>>>>            End
27506>>>>>>>>>>>>>>>>>>
27506>>>>>>>>>>>>>>>>>        End
27506>>>>>>>>>>>>>>>>>>
27506>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLReturnValue"
27508>>>>>>>>>>>>>>>>>        
27508>>>>>>>>>>>>>>>>>        Function_Return sRetval
27509>>>>>>>>>>>>>>>>>    End_Function
27510>>>>>>>>>>>>>>>>>    
27510>>>>>>>>>>>>>>>>>    
27510>>>>>>>>>>>>>>>>>    // Switch to the next set
27510>>>>>>>>>>>>>>>>>    // Returns : 0   = No more result sets
27510>>>>>>>>>>>>>>>>>    //     <>0 = Switched to next set
27510>>>>>>>>>>>>>>>>>    Function SQLNextResultSet Returns Integer
27512>>>>>>>>>>>>>>>>>        Integer ihdbc
27512>>>>>>>>>>>>>>>>>        Integer ihstmt
27512>>>>>>>>>>>>>>>>>        String  sDrvrId
27512>>>>>>>>>>>>>>>>>        Integer iResult
27512>>>>>>>>>>>>>>>>>        String  sEmpty
27512>>>>>>>>>>>>>>>>>        
27512>>>>>>>>>>>>>>>>>        // Initialize
27512>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27513>>>>>>>>>>>>>>>>>        Move 0  to iResult
27514>>>>>>>>>>>>>>>>>        
27514>>>>>>>>>>>>>>>>>        // Get the cli handles
27514>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27515>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27516>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27517>>>>>>>>>>>>>>>>>        
27517>>>>>>>>>>>>>>>>>        // Call the procedure
27517>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27519>>>>>>>>>>>>>>>>>            // Get the length
27519>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLNEXTRESULTSET ;                Callback Self ;                Passing ihdbc sEmpty ihstmt  ;                Result iResult
27524>>>>>>>>>>>>>>>>>            
27524>>>>>>>>>>>>>>>>>            Send SQLGetStatementAttributes
27525>>>>>>>>>>>>>>>>>            Set piLastArgument to 0
27526>>>>>>>>>>>>>>>>>        End
27526>>>>>>>>>>>>>>>>>>
27526>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLNextResultSet"
27528>>>>>>>>>>>>>>>>>        
27528>>>>>>>>>>>>>>>>>        Function_Return iResult
27529>>>>>>>>>>>>>>>>>    End_Function
27530>>>>>>>>>>>>>>>>>    
27530>>>>>>>>>>>>>>>>>    
27530>>>>>>>>>>>>>>>>>    // Setup a file that will be acivated after a succesfull
27530>>>>>>>>>>>>>>>>>    //fetch on the statement
27530>>>>>>>>>>>>>>>>>    Procedure SQLFetchActivatesBuffer Integer iFileNum Integer bState
27532>>>>>>>>>>>>>>>>>        Integer ihdbc
27532>>>>>>>>>>>>>>>>>        Integer ihstmt
27532>>>>>>>>>>>>>>>>>        String  sDrvrId
27532>>>>>>>>>>>>>>>>>        Integer iResult
27532>>>>>>>>>>>>>>>>>        Integer bIsOpen
27532>>>>>>>>>>>>>>>>>        Integer iVoid
27532>>>>>>>>>>>>>>>>>        String  sFileType
27532>>>>>>>>>>>>>>>>>        
27532>>>>>>>>>>>>>>>>>        // Check if file is open
27532>>>>>>>>>>>>>>>>>        Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
27535>>>>>>>>>>>>>>>>>        If (bIsOpen) Begin
27537>>>>>>>>>>>>>>>>>            // Get the cli handles
27537>>>>>>>>>>>>>>>>>            Get phCLIStatementHandle  to ihstmt
27538>>>>>>>>>>>>>>>>>            Get phCLIConnectionHandle to ihdbc
27539>>>>>>>>>>>>>>>>>            Get psDriverId            to sDrvrId
27540>>>>>>>>>>>>>>>>>            
27540>>>>>>>>>>>>>>>>>            // Call the procedure
27540>>>>>>>>>>>>>>>>>            If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27542>>>>>>>>>>>>>>>>>                // Check if the file has the correct type
27542>>>>>>>>>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sFileType
27545>>>>>>>>>>>>>>>>>                If (sFileType = sDrvrId) Begin
27547>>>>>>>>>>>>>>>>>                    // Setup the buffer
27547>>>>>>>>>>>>>>>>>                    Call_Driver iFileNum sDrvrId Function FUNC_SQLBUFFERSTATUS ;                        Callback Self ;                        Passing ihdbc bState ihstmt  ;                        Result iVoid
27552>>>>>>>>>>>>>>>>>                End
27552>>>>>>>>>>>>>>>>>>
27552>>>>>>>>>>>>>>>>>                Else ;                    Send StmtError CLIERR_SQLINVALID_BIND_FILE ("File" * String(iFileNum) * "type incompatible with statement ("  + sFileType + ")") "SQLBindFile"
27554>>>>>>>>>>>>>>>>>            End
27554>>>>>>>>>>>>>>>>>>
27554>>>>>>>>>>>>>>>>>            Else ;                Send HandleError ihstmt ihdbc sDrvrId "SQLFetchActivatesBuffer"
27556>>>>>>>>>>>>>>>>>        End
27556>>>>>>>>>>>>>>>>>>
27556>>>>>>>>>>>>>>>>>        Else ;            Send StmtError CLIERR_SQLINVALID_BUFFER ("File not open (number =" * String(iFileNum) + ")") "SQLFetchActivatesBuffer"
27558>>>>>>>>>>>>>>>>>    End_Procedure
27559>>>>>>>>>>>>>>>>>    
27559>>>>>>>>>>>>>>>>>    
27559>>>>>>>>>>>>>>>>>    
27559>>>>>>>>>>>>>>>>>    Function SQLGetMessage Integer iMessageNum Returns String
27561>>>>>>>>>>>>>>>>>        Integer ihdbc
27561>>>>>>>>>>>>>>>>>        Integer ihstmt
27561>>>>>>>>>>>>>>>>>        String  sDrvrId
27561>>>>>>>>>>>>>>>>>        String  sMessage
27561>>>>>>>>>>>>>>>>>        Integer iVoid
27561>>>>>>>>>>>>>>>>>        
27561>>>>>>>>>>>>>>>>>        // Initialize
27561>>>>>>>>>>>>>>>>>        Move "" to sMessage
27562>>>>>>>>>>>>>>>>>        
27562>>>>>>>>>>>>>>>>>        // Get the cli handles
27562>>>>>>>>>>>>>>>>>        Get phCLIStatementHandle  to ihstmt
27563>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27564>>>>>>>>>>>>>>>>>        Get psDriverId            to sDrvrId
27565>>>>>>>>>>>>>>>>>        
27565>>>>>>>>>>>>>>>>>        // Call the procedure
27565>>>>>>>>>>>>>>>>>        If (ihstmt <> 0 and ihdbc <> 0 and sDrvrId <> "") Begin
27567>>>>>>>>>>>>>>>>>            // Setup function arguments
27567>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLCOLUMNINFO ;                Callback Self ;                Passing ihdbc iMessageNum ihstmt ;                Result iVoid
27572>>>>>>>>>>>>>>>>>            
27572>>>>>>>>>>>>>>>>>            Move (Repeat(' ', 1024)) to sMessage
27573>>>>>>>>>>>>>>>>>            // Get the length
27573>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLGETMESSAGE ;                Callback Self ;                Passing iVoid sMessage iVoid ;                Result iVoid
27578>>>>>>>>>>>>>>>>>        End
27578>>>>>>>>>>>>>>>>>>
27578>>>>>>>>>>>>>>>>>        Else ;            Send HandleError ihstmt ihdbc sDrvrId "SQLGetDiagRec"
27580>>>>>>>>>>>>>>>>>        
27580>>>>>>>>>>>>>>>>>        Function_Return sMessage
27581>>>>>>>>>>>>>>>>>    End_Function
27582>>>>>>>>>>>>>>>>>    
27582>>>>>>>>>>>>>>>>>    
27582>>>>>>>>>>>>>>>>>    
27582>>>>>>>>>>>>>>>>>    // Remove the component identifier from a diagnostic message
27582>>>>>>>>>>>>>>>>>    Function RemoveComponentIdentifier String sDiagMessage Returns String
27584>>>>>>>>>>>>>>>>>        While (Left(sDiagMessage, 1) = "[")
27588>>>>>>>>>>>>>>>>>            Move (Right(sDiagMessage, Length(sDiagMessage) - Pos("]", sDiagMessage))) to sDiagMessage
27589>>>>>>>>>>>>>>>>>        Loop
27590>>>>>>>>>>>>>>>>>>
27590>>>>>>>>>>>>>>>>>        
27590>>>>>>>>>>>>>>>>>        Function_Return sDiagMessage
27591>>>>>>>>>>>>>>>>>    End_Function
27592>>>>>>>>>>>>>>>>>    
27592>>>>>>>>>>>>>>>>>    
27592>>>>>>>>>>>>>>>>>    
27592>>>>>>>>>>>>>>>>>    // Convert a DataFlex date to a SQL Date. Use dummy zero dates.
27592>>>>>>>>>>>>>>>>>    Function DFDateToSQLDate Date dDFDate Integer iSQLType Returns String
27594>>>>>>>>>>>>>>>>>        
27594>>>>>>>>>>>>>>>>>        Integer iType
27594>>>>>>>>>>>>>>>>>        String  sSQLDate
27594>>>>>>>>>>>>>>>>>        Integer iOrgDateFmt
27594>>>>>>>>>>>>>>>>>        Integer iOrgDateSep
27594>>>>>>>>>>>>>>>>>        
27594>>>>>>>>>>>>>>>>>        String sDriverId
27594>>>>>>>>>>>>>>>>>        String sDummyZeroDate
27594>>>>>>>>>>>>>>>>>        String sDummyZeroDateMssqlDatetime
27594>>>>>>>>>>>>>>>>>        
27594>>>>>>>>>>>>>>>>>        // Change date format to military, SQL dates are military dates
27594>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
27597>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
27600>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
27603>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
27606>>>>>>>>>>>>>>>>>        
27606>>>>>>>>>>>>>>>>>        // We only need to convert if the date is 0
27606>>>>>>>>>>>>>>>>>        If (Integer(dDFDate) = 0) Begin
27608>>>>>>>>>>>>>>>>>            
27608>>>>>>>>>>>>>>>>>            If (num_arguments < 2) Begin
27610>>>>>>>>>>>>>>>>>                Move SQL_TYPE_TIMESTAMP to iType
27611>>>>>>>>>>>>>>>>>            End
27611>>>>>>>>>>>>>>>>>>
27611>>>>>>>>>>>>>>>>>            Else Begin
27612>>>>>>>>>>>>>>>>>                Move iSQLType to iType
27613>>>>>>>>>>>>>>>>>            End
27613>>>>>>>>>>>>>>>>>>
27613>>>>>>>>>>>>>>>>>            
27613>>>>>>>>>>>>>>>>>            
27613>>>>>>>>>>>>>>>>>            Get psDriverID to sDriverId
27614>>>>>>>>>>>>>>>>>            Get psDummyZeroDate to sDummyZeroDate
27615>>>>>>>>>>>>>>>>>            
27615>>>>>>>>>>>>>>>>>            If ( (iType = SQL_TYPE_TIMESTAMP) and (sDriverID = 'MSSQLDRV') ) Begin
27617>>>>>>>>>>>>>>>>>                Get psDummyZeroDateMssqlDatetime to sDummyZeroDateMssqlDatetime
27618>>>>>>>>>>>>>>>>>                Move sDummyZeroDateMssqlDatetime to sSQLDate
27619>>>>>>>>>>>>>>>>>            End
27619>>>>>>>>>>>>>>>>>>
27619>>>>>>>>>>>>>>>>>            Else Begin
27620>>>>>>>>>>>>>>>>>                Move sDummyZeroDate to sSQLDate
27621>>>>>>>>>>>>>>>>>            End
27621>>>>>>>>>>>>>>>>>>
27621>>>>>>>>>>>>>>>>>            
27621>>>>>>>>>>>>>>>>>        End
27621>>>>>>>>>>>>>>>>>>
27621>>>>>>>>>>>>>>>>>        Else Begin
27622>>>>>>>>>>>>>>>>>            Move dDFDate to sSQLDate
27623>>>>>>>>>>>>>>>>>        End
27623>>>>>>>>>>>>>>>>>>
27623>>>>>>>>>>>>>>>>>        
27623>>>>>>>>>>>>>>>>>        // Change date format back to original
27623>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
27626>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
27629>>>>>>>>>>>>>>>>>        
27629>>>>>>>>>>>>>>>>>        Function_Return sSQLDate
27630>>>>>>>>>>>>>>>>>    End_Function
27631>>>>>>>>>>>>>>>>>    
27631>>>>>>>>>>>>>>>>>    
27631>>>>>>>>>>>>>>>>>    // Convert a SQL date to a DataFlex Date. Use dummy zero dates.
27631>>>>>>>>>>>>>>>>>    Function SQLDateToDFDate String sSQLDate Returns Date
27633>>>>>>>>>>>>>>>>>        
27633>>>>>>>>>>>>>>>>>        Integer iType
27633>>>>>>>>>>>>>>>>>        Date    dDFDate
27633>>>>>>>>>>>>>>>>>        Integer iOrgDateFmt
27633>>>>>>>>>>>>>>>>>        Integer iOrgDateSep
27633>>>>>>>>>>>>>>>>>        
27633>>>>>>>>>>>>>>>>>        String  sDriverId
27633>>>>>>>>>>>>>>>>>        String  sDummyZeroDate
27633>>>>>>>>>>>>>>>>>        String  sDummyZeroDateMssqlDatetime
27633>>>>>>>>>>>>>>>>>        
27633>>>>>>>>>>>>>>>>>        Get psDriverID to sDriverId
27634>>>>>>>>>>>>>>>>>        
27634>>>>>>>>>>>>>>>>>        Get psDummyZeroDate to sDummyZeroDate
27635>>>>>>>>>>>>>>>>>        Get psDummyZeroDateMssqlDatetime to sDummyZeroDateMssqlDatetime
27636>>>>>>>>>>>>>>>>>        
27636>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
27639>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
27642>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
27645>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
27648>>>>>>>>>>>>>>>>>        
27648>>>>>>>>>>>>>>>>>        Move (Left(sSQLDate,10)) to sSQLDate
27649>>>>>>>>>>>>>>>>>        
27649>>>>>>>>>>>>>>>>>        If ( (sSQLDate = sDummyZeroDate) or ;            ( (sDriverId = 'MSSQLDRV') and (sSQLDate = sDummyZeroDateMssqlDatetime) ) )  Begin
27651>>>>>>>>>>>>>>>>>            Move 0 to dDFDate
27652>>>>>>>>>>>>>>>>>        End
27652>>>>>>>>>>>>>>>>>>
27652>>>>>>>>>>>>>>>>>        Else Begin
27653>>>>>>>>>>>>>>>>>            Move sSQLDate to dDFDate
27654>>>>>>>>>>>>>>>>>        End
27654>>>>>>>>>>>>>>>>>>
27654>>>>>>>>>>>>>>>>>        
27654>>>>>>>>>>>>>>>>>        // Change date format back to original
27654>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
27657>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
27660>>>>>>>>>>>>>>>>>        
27660>>>>>>>>>>>>>>>>>        Function_Return dDFDate
27661>>>>>>>>>>>>>>>>>    End_Function
27662>>>>>>>>>>>>>>>>>    
27662>>>>>>>>>>>>>>>>>End_Class
27663>>>>>>>>>>>>>>>>>
27663>>>>>>>>>>>>>>>>>
27663>>>>>>>>>>>>>>>>>// Connection object for embedded SQL                          
27663>>>>>>>>>>>>>>>>>// This provides the ability to create a connection for a driver.     
27663>>>>>>>>>>>>>>>>>// It will contain child statement objects                            
27663>>>>>>>>>>>>>>>>>
27663>>>>>>>>>>>>>>>>>Class cSQLConnection is a cObject
27664>>>>>>>>>>>>>>>>>    
27664>>>>>>>>>>>>>>>>>    Procedure Construct_object
27666>>>>>>>>>>>>>>>>>        Forward Send Construct_object
27668>>>>>>>>>>>>>>>>>        
27668>>>>>>>>>>>>>>>>>        Property Integer phCLIConnectionHandle       0
27669>>>>>>>>>>>>>>>>>        
27669>>>>>>>>>>>>>>>>>        Property String  psDriverID        ""
27670>>>>>>>>>>>>>>>>>        Property Integer piBindFile        0
27671>>>>>>>>>>>>>>>>>        
27671>>>>>>>>>>>>>>>>>        Property String psDummyZeroDate              '0001-01-01'
27672>>>>>>>>>>>>>>>>>        Property String psDummyZeroDateMssqlDatetime '1753-01-01'
27673>>>>>>>>>>>>>>>>>        
27673>>>>>>>>>>>>>>>>>    End_Procedure
27674>>>>>>>>>>>>>>>>>    
27674>>>>>>>>>>>>>>>>>    
27674>>>>>>>>>>>>>>>>>    
27674>>>>>>>>>>>>>>>>>    // Store basic information about the connection
27674>>>>>>>>>>>>>>>>>    Procedure StoreConnectionInfo Handle hCLIConnectionHandle String sDrvrId
27676>>>>>>>>>>>>>>>>>        
27676>>>>>>>>>>>>>>>>>        String sDummyZeroDate
27676>>>>>>>>>>>>>>>>>        Integer iDriverIndex
27676>>>>>>>>>>>>>>>>>        
27676>>>>>>>>>>>>>>>>>        Set phCLIConnectionHandle to hCLIConnectionHandle
27677>>>>>>>>>>>>>>>>>        Set psDriverID            to sDrvrId
27678>>>>>>>>>>>>>>>>>        
27678>>>>>>>>>>>>>>>>>        Case Begin
27678>>>>>>>>>>>>>>>>>            Case (sDrvrId = "MSSQLDRV")
27680>>>>>>>>>>>>>>>>>                Set psDummyZeroDate to '0001-01-01'
27681>>>>>>>>>>>>>>>>>                Set psDummyZeroDateMssqlDatetime to '1753-01-01'
27682>>>>>>>>>>>>>>>>>                Break
27683>>>>>>>>>>>>>>>>>            Case (sDrvrId = "DB2_DRV")
27686>>>>>>>>>>>>>>>>>                Set psDummyZeroDate to '0001-01-01'
27687>>>>>>>>>>>>>>>>>                Break
27688>>>>>>>>>>>>>>>>>            Case (sDrvrId = "ODBC_DRV")
27691>>>>>>>>>>>>>>>>>                Get DriverIndex "ODBC_DRV" to iDriverIndex
27692>>>>>>>>>>>>>>>>>                If (iDriverIndex <> 0) Begin
27694>>>>>>>>>>>>>>>>>                    Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sDummyZeroDate
27697>>>>>>>>>>>>>>>>>                End
27697>>>>>>>>>>>>>>>>>>
27697>>>>>>>>>>>>>>>>>                Else Begin
27698>>>>>>>>>>>>>>>>>                    Move '0001-01-01' to sDummyZeroDate
27699>>>>>>>>>>>>>>>>>                End
27699>>>>>>>>>>>>>>>>>>
27699>>>>>>>>>>>>>>>>>
27699>>>>>>>>>>>>>>>>>                Set psDummyZeroDate to sDummyZeroDate
27700>>>>>>>>>>>>>>>>>                Break
27701>>>>>>>>>>>>>>>>>                
27701>>>>>>>>>>>>>>>>>        Case End
27701>>>>>>>>>>>>>>>>>        
27701>>>>>>>>>>>>>>>>>    End_Procedure
27702>>>>>>>>>>>>>>>>>    
27702>>>>>>>>>>>>>>>>>    Function DriverIndex String sDriver Returns Integer
27704>>>>>>>>>>>>>>>>>        
27704>>>>>>>>>>>>>>>>>        String  sCurrentDriver
27704>>>>>>>>>>>>>>>>>        Integer iNumberOfDrivers iDriver iCount
27704>>>>>>>>>>>>>>>>>        
27704>>>>>>>>>>>>>>>>>        Move 0 to iDriver
27705>>>>>>>>>>>>>>>>>        
27705>>>>>>>>>>>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
27708>>>>>>>>>>>>>>>>>        For iCount from 1 to iNumberOfDrivers
27714>>>>>>>>>>>>>>>>>>
27714>>>>>>>>>>>>>>>>>            
27714>>>>>>>>>>>>>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
27717>>>>>>>>>>>>>>>>>            If ( Uppercase(sCurrentDriver) = Uppercase(sDriver) ) Begin
27719>>>>>>>>>>>>>>>>>                Move iCount to iDriver
27720>>>>>>>>>>>>>>>>>            End
27720>>>>>>>>>>>>>>>>>>
27720>>>>>>>>>>>>>>>>>        Loop
27721>>>>>>>>>>>>>>>>>>
27721>>>>>>>>>>>>>>>>>        
27721>>>>>>>>>>>>>>>>>        Function_Return iDriver
27722>>>>>>>>>>>>>>>>>        
27722>>>>>>>>>>>>>>>>>    End_Function
27723>>>>>>>>>>>>>>>>>
27723>>>>>>>>>>>>>>>>>    
27723>>>>>>>>>>>>>>>>>    // Destroy the SQLConnection object
27723>>>>>>>>>>>>>>>>>    Procedure DestroySQLConnection
27725>>>>>>>>>>>>>>>>>        Send Destroy
27726>>>>>>>>>>>>>>>>>    End_Procedure
27727>>>>>>>>>>>>>>>>>    
27727>>>>>>>>>>>>>>>>>    
27727>>>>>>>>>>>>>>>>>    // Connect to a database server
27727>>>>>>>>>>>>>>>>>    // Returns : 1 Succesfully connected
27727>>>>>>>>>>>>>>>>>    //           0 Not connected
27727>>>>>>>>>>>>>>>>>    Function SQLConnect String sDrvrID String sConnect Returns Integer
27729>>>>>>>>>>>>>>>>>        Integer ihdbc
27729>>>>>>>>>>>>>>>>>        String  sEmpty
27729>>>>>>>>>>>>>>>>>        
27729>>>>>>>>>>>>>>>>>        // Initialize
27729>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27730>>>>>>>>>>>>>>>>>        Move 0  to ihdbc
27731>>>>>>>>>>>>>>>>>        
27731>>>>>>>>>>>>>>>>>        Move False to Err
27732>>>>>>>>>>>>>>>>>        
27732>>>>>>>>>>>>>>>>>        // Call the driver function to connect
27732>>>>>>>>>>>>>>>>>        Call_Driver 0 sDrvrId Function FUNC_SQLCONNECT ;            Callback Self ;            Passing sConnect sEmpty Self ;            Result ihdbc
27737>>>>>>>>>>>>>>>>>        
27737>>>>>>>>>>>>>>>>>        // If there was an error, make result invalid
27737>>>>>>>>>>>>>>>>>        If (Err) ;            Move 0 to ihdbc
27740>>>>>>>>>>>>>>>>>        
27740>>>>>>>>>>>>>>>>>        // Check result and store it
27740>>>>>>>>>>>>>>>>>        If (ihdbc <> 0) ;            Send StoreConnectionInfo ihdbc sDrvrId
27743>>>>>>>>>>>>>>>>>        
27743>>>>>>>>>>>>>>>>>        // Return success status
27743>>>>>>>>>>>>>>>>>        Function_Return (ihdbc <> 0)
27744>>>>>>>>>>>>>>>>>    End_Function
27745>>>>>>>>>>>>>>>>>    
27745>>>>>>>>>>>>>>>>>    
27745>>>>>>>>>>>>>>>>>    // Use a connection of an already open file
27745>>>>>>>>>>>>>>>>>    Function SQLFileConnect Integer iFileNum Returns Integer
27747>>>>>>>>>>>>>>>>>        Integer ihdbc
27747>>>>>>>>>>>>>>>>>        Integer bIsOpen
27747>>>>>>>>>>>>>>>>>        String  sDrvrId
27747>>>>>>>>>>>>>>>>>        String  sEmpty
27747>>>>>>>>>>>>>>>>>        
27747>>>>>>>>>>>>>>>>>        // Initialize
27747>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27748>>>>>>>>>>>>>>>>>        Move 0  to ihdbc
27749>>>>>>>>>>>>>>>>>        
27749>>>>>>>>>>>>>>>>>        // Check if file is open
27749>>>>>>>>>>>>>>>>>        Get_Attribute DF_FILE_OPENED of iFileNum to bIsOpen
27752>>>>>>>>>>>>>>>>>        If (bIsOpen) Begin
27754>>>>>>>>>>>>>>>>>            // Fill the driver id, assume longest is 255 characters
27754>>>>>>>>>>>>>>>>>            Move (Repeat(' ', 255)) to sDrvrId
27755>>>>>>>>>>>>>>>>>            Get_Attribute DF_FILE_DRIVER of iFileNum to sDrvrId
27758>>>>>>>>>>>>>>>>>            
27758>>>>>>>>>>>>>>>>>            Move False to Err
27759>>>>>>>>>>>>>>>>>            
27759>>>>>>>>>>>>>>>>>            // Call the driver function to connect
27759>>>>>>>>>>>>>>>>>            Call_Driver iFileNum sDrvrId Function FUNC_SQLFILECONNECT ;                Callback Self ;                Passing sEmpty sEmpty 0 ;                Result ihdbc
27764>>>>>>>>>>>>>>>>>            
27764>>>>>>>>>>>>>>>>>            // If there was an error, make result invalid
27764>>>>>>>>>>>>>>>>>            If (Err) ;                Move 0 to ihdbc
27767>>>>>>>>>>>>>>>>>            
27767>>>>>>>>>>>>>>>>>            // Check result and store it
27767>>>>>>>>>>>>>>>>>            If (ihdbc <> 0) Begin
27769>>>>>>>>>>>>>>>>>                // Somehow Call_driver overwrites the sDrvrId variable, restore it here
27769>>>>>>>>>>>>>>>>>                Get_Attribute DF_FILE_DRIVER of iFileNum to sDrvrId
27772>>>>>>>>>>>>>>>>>                Send StoreConnectionInfo ihdbc sDrvrId
27773>>>>>>>>>>>>>>>>>                
27773>>>>>>>>>>>>>>>>>                // Set filenum so it can be used for fetching
27773>>>>>>>>>>>>>>>>>                Set piBindFile to iFileNum
27774>>>>>>>>>>>>>>>>>            End
27774>>>>>>>>>>>>>>>>>>
27774>>>>>>>>>>>>>>>>>        End
27774>>>>>>>>>>>>>>>>>>
27774>>>>>>>>>>>>>>>>>        
27774>>>>>>>>>>>>>>>>>        // Return success status
27774>>>>>>>>>>>>>>>>>        Function_Return (ihdbc <> 0)
27775>>>>>>>>>>>>>>>>>    End_Function
27776>>>>>>>>>>>>>>>>>    
27776>>>>>>>>>>>>>>>>>    
27776>>>>>>>>>>>>>>>>>    // Establish an embedded SQL connection that uses an existing connection from an earlier login or open.
27776>>>>>>>>>>>>>>>>>    // Existing connections are identified by there connectstring. (can be obtained with DF_DRIVER_SERVER_NAME attribute)
27776>>>>>>>>>>>>>>>>>    // If sConnectString exist in the list of existing connections, that connection will be used for embedded SQL.
27776>>>>>>>>>>>>>>>>>    // The connectstring must be an exact match, but can be case insensitive
27776>>>>>>>>>>>>>>>>>    // The connectstring can contain a connection id. For example: "DFCONNID=MyConnectionID"
27776>>>>>>>>>>>>>>>>>    // If no matching connectstring is found, this function will return 0
27776>>>>>>>>>>>>>>>>>    // This function will only work with CLI connectivity kits 6.2 or later
27776>>>>>>>>>>>>>>>>>    Function SQLConnectionConnect String sDrvrID String sConnectString Returns Integer
27778>>>>>>>>>>>>>>>>>        Integer ihdbc
27778>>>>>>>>>>>>>>>>>        String  sEmpty
27778>>>>>>>>>>>>>>>>>        Integer iFileNum
27778>>>>>>>>>>>>>>>>>        
27778>>>>>>>>>>>>>>>>>        // Initialize
27778>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27779>>>>>>>>>>>>>>>>>        Move 0  to ihdbc
27780>>>>>>>>>>>>>>>>>        
27780>>>>>>>>>>>>>>>>>        Move False to Err
27781>>>>>>>>>>>>>>>>>        
27781>>>>>>>>>>>>>>>>>        // Call the driver function
27781>>>>>>>>>>>>>>>>>        //   Note we call FUNC_SQLFILECONNECT with iFileNum = 0.
27781>>>>>>>>>>>>>>>>>        //   This will perform SQLConnectionConnect instead of SQLFileConnect
27781>>>>>>>>>>>>>>>>>        Move 0 to iFileNum
27782>>>>>>>>>>>>>>>>>        Call_Driver iFileNum sDrvrId Function FUNC_SQLFILECONNECT ;            Callback Self ;            Passing sConnectString sEmpty Self ;            Result ihdbc
27787>>>>>>>>>>>>>>>>>        
27787>>>>>>>>>>>>>>>>>        // If there was an error, make result invalid
27787>>>>>>>>>>>>>>>>>        If (Err) ;            Move 0 to ihdbc
27790>>>>>>>>>>>>>>>>>        
27790>>>>>>>>>>>>>>>>>        // Check result and store it
27790>>>>>>>>>>>>>>>>>        If (ihdbc <> 0) ;            Send StoreConnectionInfo ihdbc sDrvrId
27793>>>>>>>>>>>>>>>>>        
27793>>>>>>>>>>>>>>>>>        // Return success status
27793>>>>>>>>>>>>>>>>>        Function_Return (ihdbc <> 0)
27794>>>>>>>>>>>>>>>>>    End_Function
27795>>>>>>>>>>>>>>>>>    
27795>>>>>>>>>>>>>>>>>    
27795>>>>>>>>>>>>>>>>>    // Disconnect from an embedded SQL server and free allocated
27795>>>>>>>>>>>>>>>>>    // resources
27795>>>>>>>>>>>>>>>>>    Procedure SQLDisconnect
27797>>>>>>>>>>>>>>>>>        Integer ihdbc
27797>>>>>>>>>>>>>>>>>        Integer iVoid
27797>>>>>>>>>>>>>>>>>        String  sDrvrId
27797>>>>>>>>>>>>>>>>>        String  sEmpty
27797>>>>>>>>>>>>>>>>>        
27797>>>>>>>>>>>>>>>>>        // Initialize
27797>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27798>>>>>>>>>>>>>>>>>        
27798>>>>>>>>>>>>>>>>>        // Get the cli handle
27798>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27799>>>>>>>>>>>>>>>>>        Get psDriverId to sDrvrId
27800>>>>>>>>>>>>>>>>>        
27800>>>>>>>>>>>>>>>>>        // Free the CLI handle
27800>>>>>>>>>>>>>>>>>        If (ihdbc <> 0) Begin
27802>>>>>>>>>>>>>>>>>            // Call the driver function to disconnect
27802>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLDISCONNECT ;                Callback Self ;                Passing sEmpty sEmpty ihdbc ;                Result iVoid
27807>>>>>>>>>>>>>>>>>            
27807>>>>>>>>>>>>>>>>>            Move -1 to giLastSQLhdbc
27808>>>>>>>>>>>>>>>>>            
27808>>>>>>>>>>>>>>>>>            // Free the DataFlex handle
27808>>>>>>>>>>>>>>>>>            Send DestroySQLConnection
27809>>>>>>>>>>>>>>>>>        End
27809>>>>>>>>>>>>>>>>>>
27809>>>>>>>>>>>>>>>>>    End_Procedure
27810>>>>>>>>>>>>>>>>>    
27810>>>>>>>>>>>>>>>>>    // Create a cSQLStatement object
27810>>>>>>>>>>>>>>>>>    Function CreateSQLStatement Returns Handle
27812>>>>>>>>>>>>>>>>>        
27812>>>>>>>>>>>>>>>>>        Handle hoSQLStatement
27812>>>>>>>>>>>>>>>>>        Get Create (RefClass(cSQLStatement)) to hoSQLStatement
27813>>>>>>>>>>>>>>>>>        
27813>>>>>>>>>>>>>>>>>        // If the connection has a default Bind File, assign it to the
27813>>>>>>>>>>>>>>>>>        // statement object. The default is set when you open a file with a
27813>>>>>>>>>>>>>>>>>        // SetFileConnection command.
27813>>>>>>>>>>>>>>>>>        Set piBindFile of hoSQLStatement to (piBindFile(Self))
27814>>>>>>>>>>>>>>>>>        
27814>>>>>>>>>>>>>>>>>        Function_Return hoSQLStatement
27815>>>>>>>>>>>>>>>>>    End_Function
27816>>>>>>>>>>>>>>>>>    
27816>>>>>>>>>>>>>>>>>    
27816>>>>>>>>>>>>>>>>>    // Open a statement for use
27816>>>>>>>>>>>>>>>>>    Function SQLOpen Returns Handle
27818>>>>>>>>>>>>>>>>>        Handle  hoSQLStatement
27818>>>>>>>>>>>>>>>>>        Integer ihdbc
27818>>>>>>>>>>>>>>>>>        Integer ihstmt
27818>>>>>>>>>>>>>>>>>        Integer iVoid
27818>>>>>>>>>>>>>>>>>        String  sDrvrId
27818>>>>>>>>>>>>>>>>>        String  sEmpty
27818>>>>>>>>>>>>>>>>>        String  sDummyZeroDate
27818>>>>>>>>>>>>>>>>>        String  sDummyZeroDateMssqlDatetime
27818>>>>>>>>>>>>>>>>>        
27818>>>>>>>>>>>>>>>>>        // Initialize
27818>>>>>>>>>>>>>>>>>        Move "" to sEmpty
27819>>>>>>>>>>>>>>>>>        
27819>>>>>>>>>>>>>>>>>        // Get the cli handle to the connection
27819>>>>>>>>>>>>>>>>>        Get phCLIConnectionHandle to ihdbc
27820>>>>>>>>>>>>>>>>>        Get psDriverId  to sDrvrId
27821>>>>>>>>>>>>>>>>>        
27821>>>>>>>>>>>>>>>>>        // Allocate a new handle and populate it
27821>>>>>>>>>>>>>>>>>        If (ihdbc <> 0) Begin
27823>>>>>>>>>>>>>>>>>            // Create a new cSQLStatement object
27823>>>>>>>>>>>>>>>>>            Get CreateSQLStatement to hoSQLStatement
27824>>>>>>>>>>>>>>>>>            
27824>>>>>>>>>>>>>>>>>            // Call the driver function to allocate a cli statement handle
27824>>>>>>>>>>>>>>>>>            Call_Driver 0 sDrvrId Function FUNC_SQLOPEN ;                Callback Self ;                Passing hoSQLStatement sEmpty ihdbc ;                Result ihstmt
27829>>>>>>>>>>>>>>>>>            
27829>>>>>>>>>>>>>>>>>            // If unsuccessful destroy hoSQLStatement
27829>>>>>>>>>>>>>>>>>            If (ihstmt = 0) Begin
27831>>>>>>>>>>>>>>>>>                Send DestroySQLStatement of hoSQLStatement
27832>>>>>>>>>>>>>>>>>                Move 0 to hoSQLStatement
