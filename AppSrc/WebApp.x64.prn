9750>>>>>Class cVersionInfo is a cObject
9751>>>>>    Procedure Construct_Object
9753>>>>>        Forward Send Construct_Object
9755>>>>>        
9755>>>>>        
9755>>>>>        Property Integer piVersionMajor
9756>>>>>        Property Integer piVersionMinor
9757>>>>>        Property Integer piVersionRelease
9758>>>>>        Property Integer piVersionBuild
9759>>>>>        
9759>>>>>        Property Boolean pbIncluded
9760>>>>>        Property Boolean pbSpecialBuild
9761>>>>>        Property Boolean pbPrivateBuild
9762>>>>>        
9762>>>>>    End_Procedure
9763>>>>>    
9763>>>>>    Procedure DoCreate WString sFileName
9765>>>>>        DWord dwHandle
9765>>>>>        Integer iInfoSize iVerSize iSuccess iVersion iVoid iFlags
9765>>>>>        WString sData
9765>>>>>        tWinVs_FixedFileInfo VsFixedFileInfo
9765>>>>>        tWinVs_FixedFileInfo VsFixedFileInfo
9765>>>>>        WString sSubBlock
9765>>>>>        Pointer pVsFixedFileInfo
9765>>>>>        
9765>>>>>        Move 0 to pVsFixedFileInfo
9766>>>>>        Move 0 to dwHandle
9767>>>>>        Move 0 to iVerSize
9768>>>>>        
9768>>>>>        Move (GetFileVersionInfoSizeW(AddressOf(sFilename), AddressOf(dwHandle))) to iInfoSize
9769>>>>>        Set pbIncluded to (iInfoSize <>0)
9770>>>>>        
9770>>>>>        If (pbIncluded(Self)) Begin
9772>>>>>            Move (Repeat(Character(0), iInfoSize)) to sData
9773>>>>>            Move (GetFileVersionInfoW(AddressOf(sFilename), 0, iInfoSize, AddressOf(sData))) to iSuccess
9774>>>>>            
9774>>>>>            If (iSuccess <>0) Begin
9776>>>>>                Move "\" to sSubBlock
9777>>>>>                If (VerQueryValueW(AddressOf(sData), AddressOf(sSubBlock), AddressOf(pVsFixedFileInfo), AddressOf(iVerSize))) Begin
9779>>>>>                    Move (memcopy(AddressOf(VsFixedFileInfo), pVsFixedFileInfo, iVerSize)) to iVoid // copy the structure
9780>>>>>                    
9780>>>>>                    Move VsFixedFileInfo.dwFileVersionMS to iVersion
9781>>>>>                    Set piVersionMajor to (Hi(iVersion))
9782>>>>>                    Set piVersionMinor to (Low(iVersion))
9783>>>>>                    
9783>>>>>                    Move VsFixedFileInfo.dwFileVersionLS to iVersion
9784>>>>>                    Set piVersionRelease to (Hi(iVersion))
9785>>>>>                    Set piVersionBuild   to (Low(iVersion))
9786>>>>>                    
9786>>>>>                    Move VsFixedFileInfo.dwFileFlags to iFlags
9787>>>>>                    Set pbSpecialBuild    to (iFlags iand VS_FF_SPECIALBUILD)
9788>>>>>                    Set pbPrivateBuild    to (iFlags iand VS_FF_PRIVATEBUILD)
9789>>>>>                End
9789>>>>>>
9789>>>>>            End
9789>>>>>>
9789>>>>>            
9789>>>>>        End
9789>>>>>>
9789>>>>>    End_Procedure
9790>>>>>    
9790>>>>>End_Class
