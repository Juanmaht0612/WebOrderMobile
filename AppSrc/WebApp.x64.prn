22026>>>>>>>>>/*Defines the API used by radio's to register themselves to their container. Used by cWebWindow and cLocalWebControlHost.  */
22026>>>>>>>>>Class cWebRadioContainer_mixin is a Mixin
22027>>>>>>>>>      
22027>>>>>>>>>    Procedure Define_cWebRadioContainer_mixin
22029>>>>>>>>>        Property tWebRadioGroup[] paRadioGroups   // collection of radio button groups in this View\Dialog 
22030>>>>>>>>>        Property String[] paRadioGroupNames       // searchable array of group names that are stored in paRagioGroups. One member of paRadioGroups exists for each paRadioGroupNames
22031>>>>>>>>>    End_Procedure
22032>>>>>>>>>    
22032>>>>>>>>>    
22032>>>>>>>>>    Procedure AddRadio Handle hoRadio
22034>>>>>>>>>        // Radio Button Helper:
22034>>>>>>>>>        //
22034>>>>>>>>>        // Registers the passed cWebRadio object. The object's group is determined and the radio
22034>>>>>>>>>        // is registered with the rest of the objects in that group. If this is the first radio
22034>>>>>>>>>        // object in the group then it will become the "master" radio object for that group.
22034>>>>>>>>>        String sGroupName
22034>>>>>>>>>        Integer iGroup icGroup icRadio
22034>>>>>>>>>        String[] aRadioGroupNames
22035>>>>>>>>>        tWebRadioGroup[] aRadioGroups
22035>>>>>>>>>        tWebRadioGroup[] aRadioGroups
22036>>>>>>>>>        
22036>>>>>>>>>        Get psGroupName of hoRadio to sGroupName
22037>>>>>>>>>        Get paRadioGroups to aRadioGroups
22038>>>>>>>>>        Get paRadioGroupNames to aRadioGroupNames
22039>>>>>>>>>        
22039>>>>>>>>>        // Is this a new group?....
22039>>>>>>>>>        Move (SearchArray(sGroupName, aRadioGroupNames, Desktop, RefFunc(DFSTRICMP))) to iGroup   // case insensitive search
22040>>>>>>>>>        
22040>>>>>>>>>        If (iGroup = -1) Begin
22042>>>>>>>>>            // Create a new group amd make this radio button the master....
22042>>>>>>>>>            Move (SizeOfArray(aRadioGroups)) to icGroup
22043>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].hoMaster
22044>>>>>>>>>            Move hoRadio    to aRadioGroups[icGroup].aRadioButtons[0]
22045>>>>>>>>>            Move sGroupName to aRadioGroups[icGroup].sGroupName
22046>>>>>>>>>            Move sGroupName to aRadioGroupNames[icGroup]
22047>>>>>>>>>            
22047>>>>>>>>>            // Save the changes....
22047>>>>>>>>>            Set paRadioGroups to aRadioGroups
22048>>>>>>>>>            Set paRadioGroupNames to aRadioGroupNames
22049>>>>>>>>>        End
22049>>>>>>>>>>
22049>>>>>>>>>        Else Begin
22050>>>>>>>>>            // Add this radio to the existing group....
22050>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
22051>>>>>>>>>            Move hoRadio to aRadioGroups[iGroup].aRadioButtons[icRadio]
22052>>>>>>>>>            
22052>>>>>>>>>            // Save the changes....
22052>>>>>>>>>            Set paRadioGroups to aRadioGroups
22053>>>>>>>>>        End
22053>>>>>>>>>>
22053>>>>>>>>>    End_Procedure
22054>>>>>>>>>    
22054>>>>>>>>>    
22054>>>>>>>>>    Procedure ConnectRadioButtons
22056>>>>>>>>>        // Radio button Helper:
22056>>>>>>>>>        //
22056>>>>>>>>>        // Iterate all of the registered radio groups and connect the cWebRadio objects to their master
22056>>>>>>>>>        // radio buttons.
22056>>>>>>>>>        String sValue sTemp sMaster
22056>>>>>>>>>        Handle hoRadio
22056>>>>>>>>>        Integer iGroup icGroup 
22056>>>>>>>>>        Integer iRadio icRadio
22056>>>>>>>>>        tWebRadioGroup[] aRadioGroups
22056>>>>>>>>>        tWebRadioGroup[] aRadioGroups
22057>>>>>>>>>        
22057>>>>>>>>>        Get paRadioGroups to aRadioGroups
22058>>>>>>>>>        Move (SizeOfArray(aRadioGroups)) to icGroup
22059>>>>>>>>>        
22059>>>>>>>>>        For iGroup from 0 to (icGroup-1)
22065>>>>>>>>>>
22065>>>>>>>>>            Move (SizeOfArray(aRadioGroups[iGroup].aRadioButtons)) to icRadio
22066>>>>>>>>>            Move "" to sValue
22067>>>>>>>>>            Get WebObjectName of aRadioGroups[iGroup].hoMaster to sMaster 
22068>>>>>>>>>            
22068>>>>>>>>>            For iRadio from 0 to (icRadio-1)
22074>>>>>>>>>>
22074>>>>>>>>>                // Set the master radio....
22074>>>>>>>>>                Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
22075>>>>>>>>>                Set phoMasterRadio of hoRadio to aRadioGroups[iGroup].hoMaster
22076>>>>>>>>>                If (hoRadio <> aRadioGroups[iGroup].hoMaster) Begin
22078>>>>>>>>>                    Set psMasterName of hoRadio to sMaster
22079>>>>>>>>>                End
22079>>>>>>>>>>
22079>>>>>>>>>                
22079>>>>>>>>>                // Get the last non-null psValue setting....
22079>>>>>>>>>                Get psValue of hoRadio to sTemp
22080>>>>>>>>>                If (sTemp <> "") Begin
22082>>>>>>>>>                    Move sTemp to sValue
22083>>>>>>>>>                End
22083>>>>>>>>>>
22083>>>>>>>>>            Loop
22084>>>>>>>>>>
22084>>>>>>>>>            
22084>>>>>>>>>            // If there is no psValue setting then set it to the psRadioValue value of the master radio....
22084>>>>>>>>>            If (sValue = "") Begin
22086>>>>>>>>>                Get psRadioValue of aRadioGroups[iGroup].hoMaster to sValue
22087>>>>>>>>>            End
22087>>>>>>>>>>
22087>>>>>>>>>            
22087>>>>>>>>>            // Synchronize all radios in this group to the same psValue...
22087>>>>>>>>>            If (sValue <> "") Begin
22089>>>>>>>>>                For iRadio from 0 to (icRadio-1)
22095>>>>>>>>>>
22095>>>>>>>>>                    Move aRadioGroups[iGroup].aRadioButtons[iRadio] to hoRadio
22096>>>>>>>>>                    Set psValue of hoRadio to sValue
22097>>>>>>>>>                Loop
22098>>>>>>>>>>
22098>>>>>>>>>            End
22098>>>>>>>>>>
22098>>>>>>>>>        Loop
22099>>>>>>>>>>
22099>>>>>>>>>    End_Procedure
22100>>>>>>>>>End_Class
