33831>>>>>>>>>            Function_Return False
33832>>>>>>>>>        End
33832>>>>>>>>>>
33832>>>>>>>>>        Move ("--" + Trim(aContentValues[iIndex].sValue)) to sBoundary
33833>>>>>>>>>        
33833>>>>>>>>>        Move (StringToUCharArray(sBoundary))    to parsedata.ucBoundary
33834>>>>>>>>>        Move False                              to parsedata.bAbort
33835>>>>>>>>>        Move 0                                  to parsedata.iChunkOffset
33836>>>>>>>>>        Move 13 to ucNewLine[0]
33837>>>>>>>>>        Move 10 to ucNewLine[1]
33838>>>>>>>>>        
33838>>>>>>>>>        //Send LogEvent 1 (SFormat("Boundary size: %1, '%2'", SizeOfArray(parsedata.ucBoundary), sBoundary))
33838>>>>>>>>>        
33838>>>>>>>>>        //  Initialize parsedata by filling the next chunk and calling ReadChunk
33838>>>>>>>>>        Get RequestDataUChar HTTP_DEFAULT_CHUNK_SIZE to parsedata.ucNextChunk
33839>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk) < HTTP_DEFAULT_CHUNK_SIZE) to parsedata.bEndOfReq
33840>>>>>>>>>        Move (SizeOfArray(parsedata.ucNextChunk)) to parsedata.iSize
33841>>>>>>>>>        
33841>>>>>>>>>        Send ReadChunk (&parsedata)
