5036>>>>>        Handle  hBtn
5036>>>>>        Integer eButtonStyle
5036>>>>>        Integer iVal
5036>>>>>        Get Form_button iItem to eButtonStyle
5037>>>>>        If (eButtonStyle=FORM_BUTTON_PROMPT) ;            Send Prompt
5040>>>>>        Else If (eButtonStyle=FORM_BUTTON_SPIN or eButtonStyle=FORM_BUTTON_SPIN_WRAP) Begin
5043>>>>>            Get Form_Button_Window_Handle 0 to hBtn
5044>>>>>            If hBtn Begin
5046>>>>>                Move (SendMessage(hBtn, UDM_GETPOS32, 0, 0) ) to iPos
5047>>>>>                Get Current_Position to iVal
5048>>>>>                If (iVal <> iPos) Begin
5050>>>>>                    Set Current_Position to iPos
5051>>>>>                    Send Value_Spinned iPos
5052>>>>>                End
5052>>>>>>
5052>>>>>            End
5052>>>>>>
5052>>>>>        End
5052>>>>>>
5052>>>>>    End_Procedure
