32993>>>>>>>>>    Function Utf16ToBuffer Pointer pWideBuf Integer eCharType Integer iLen Returns Pointer
32995>>>>>>>>>        Pointer pRetBuf
32995>>>>>>>>>        Integer iRetBufLen
32995>>>>>>>>>        Move 0 to pRetBuf
32996>>>>>>>>>        If (pWideBuf and iLen) Begin
32998>>>>>>>>>            Move (WideToMultiBuffer(eCharType,pWideBuf,iLen,AddressOf(pRetBuf))) to iRetBufLen
32999>>>>>>>>>            If (iRetBufLen=0) Begin
33001>>>>>>>>>                Function_Return 0
33002>>>>>>>>>            End
33002>>>>>>>>>>
33002>>>>>>>>>        End
33002>>>>>>>>>>
33002>>>>>>>>>        Function_Return pRetBuf
33003>>>>>>>>>    End_Function
33004>>>>>>>>>    
33004>>>>>>>>>    Function Utf16ToStr Pointer pWideBuf Integer eCharType Integer iLen Returns String
33006>>>>>>>>>        String sValue
33006>>>>>>>>>        Pointer pValue
33006>>>>>>>>>        Boolean bOk
33006>>>>>>>>>        Get Utf16ToBuffer pWideBuf eCharType iLen to pValue
33007>>>>>>>>>        If (not(ValidStringBufferLength(pValue))) Begin
33009>>>>>>>>>            Error DFERR_PROGRAM "Buffer exceeds maximum string size"
33010>>>>>>>>>>
33010>>>>>>>>>        End
33010>>>>>>>>>>
33010>>>>>>>>>        Move (PointerToString(pValue)) to sValue
33011>>>>>>>>>        Move (Free(pValue)) to bOk
33012>>>>>>>>>        Function_Return sValue
