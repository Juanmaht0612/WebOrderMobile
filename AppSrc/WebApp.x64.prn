17045>>>>>>>    // Error Interface:
17045>>>>>>>    
17045>>>>>>>    // ReportCriticalError is sent for critical errors by the error handler object. For the HTTP 
17045>>>>>>>    // handler it sends a fatal error to the end-point so it can properly return an error 500.
17045>>>>>>>    Procedure ReportCriticalError Integer iErr String sErrMsg Integer iLine  Integer iFileNr Integer iFieldNr
17047>>>>>>>        String sLineBreak sDtl
17047>>>>>>>        String sFileName sFieldName
17047>>>>>>>        Integer eWebAppEndPointEnvironment
17047>>>>>>>        
17047>>>>>>>        // At some point we should figure out how to make HTTP handler throw error here!
17047>>>>>>>        Get CurrentWebAppEnvironment to eWebAppEndPointEnvironment
17048>>>>>>>        If (eWebAppEndPointEnvironment=WebAppHttpModule) Begin
17050>>>>>>>            If (pbVerboseErrors(Self)) Begin
17052>>>>>>>                Move (SFormat(C_$VDFErrorInLine, iErr, iLine)) to sDtl
17053>>>>>>>                If (iFileNr  > 0) ;                    Move (sDtl * DD_FILE_TEXT  * String(iFileNr))  to sDtl
17056>>>>>>>                If (iFieldNr > 0) ;                    Move (sDtl * DD_FIELD_TEXT * String(iFieldNr)) to sDtl
17059>>>>>>>                Move (sErrMsg + C_NewLine + sDtl) to sErrMsg
17060>>>>>>>            End
17060>>>>>>>>
17060>>>>>>>            
17060>>>>>>>            Move (Replaces("\n",sErrMsg, Character(13)+Character(10))) to sErrMsg
17061>>>>>>>            Send ReportFatalError "Critical DataFlex Error" sErrMsg
17062>>>>>>>        End
17062>>>>>>>>
17062>>>>>>>    End_Procedure
17063>>>>>>>    
17063>>>>>>>    // ReportError and ReportErrorEvent is private and should never be sent. It is sent
17063>>>>>>>    // from within the error handler object to report errors
17063>>>>>>>    Procedure ReportError Integer iErr String sErrMsg Integer iLine  Integer iFileNr Integer iFieldNr
17065>>>>>>>        String sLineBreak sDtl
17065>>>>>>>        String sFileName sFieldName
17065>>>>>>>        Integer eWebAppEndPointEnvironment
17065>>>>>>>        
17065>>>>>>>        Get CurrentWebAppEnvironment to eWebAppEndPointEnvironment
17066>>>>>>>        If (eWebAppEndPointEnvironment<>WebAppHttpModule) Begin
17068>>>>>>>            //  It must be Classic ASP
17068>>>>>>>            Move (HtmlEncode(sErrMsg)) to sErrMsg
17069>>>>>>>            Move "<br />" to sLineBreak
17070>>>>>>>            // The extended error message will contain \n to mark end of line. We will
17070>>>>>>>            // convert these to HTML style.
17070>>>>>>>            Move (Replaces("\n",sErrMSg,sLineBreak)) to sErrmsg
17071>>>>>>>            If (pbVerboseErrors(Self)) Begin
17073>>>>>>>                Move (SFormat(C_$VDFErrorInLine, iErr, iLine)) to sDtl
17074>>>>>>>                If (iFileNr  > 0) ;                    Move (sDtl * DD_FILE_TEXT  * String(iFileNr))  to sDtl
17077>>>>>>>                If (iFieldNr > 0) ;                    Move (sDtl * DD_FIELD_TEXT * String(iFieldNr)) to sDtl
17080>>>>>>>                Append sErrMsg sLineBreak sDtl
17082>>>>>>>            End
17082>>>>>>>>
17082>>>>>>>            Append sErrMsg sLineBreak sLineBreak
17084>>>>>>>            Send OutputHTML sErrMsg
17085>>>>>>>        End
17085>>>>>>>>
17085>>>>>>>    End_Procedure
17086>>>>>>>    
17086>>>>>>>    Procedure ReportErrorEvent Integer iErr String sErrMsg Integer iLine  Integer iFileNr Integer iFieldNr
17088>>>>>>>        String sHtml sLineBreak sDtl
17088>>>>>>>        String sFileName sFieldName
17088>>>>>>>        //Move ". " To sLineBreak
17088>>>>>>>        Move (Character(13)+Character(10)) to sLineBreak
17089>>>>>>>        // The extended error message will contain \n to mark end of line. We will
17089>>>>>>>        // convert these to HTML style.
17089>>>>>>>        Move (Replaces("\n",sErrMSg,sLineBreak)) to sErrmsg
17090>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iErr, iLine)) to sDtl
17091>>>>>>>        If (iFileNr  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iFileNr))  to sDtl
17094>>>>>>>        If (iFieldNr > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iFieldNr)) to sDtl
17097>>>>>>>        Append sErrMsg sLineBreak sDtl
17099>>>>>>>        Send LogEvent iErr sErrMsg
17100>>>>>>>    End_Procedure
