30274>>>>>>>
30274>>>>>>>    // Send this message to fire an action on the client telling it to refresh the grid.
30274>>>>>>>    Procedure GridRefresh
30276>>>>>>>        Boolean bFirst bLast
30276>>>>>>>        tWebListData listData
30276>>>>>>>        tWebListData listData
30276>>>>>>>        String[] asParams
30277>>>>>>>        Handle hoJsonData
30277>>>>>>>                
30277>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
30277>>>>>>>        Send CancelClientAction "gridRefresh"
30278>>>>>>>        
30278>>>>>>>        // Forward call to the load data
30278>>>>>>>        Get LoadData "page" "" (&bFirst) (&bLast) to listData
30279>>>>>>>        WebSet pbUnOrdered to False
30280>>>>>>>        
30280>>>>>>>        //  Convert data to JSON
30280>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
30281>>>>>>>        Send DataTypeToJson of hoJsonData listData
30282>>>>>>>
30282>>>>>>>        //  Call client action with new data page
30282>>>>>>>        Move bFirst         to asParams[0]
30283>>>>>>>        Move bLast          to asParams[1]
30284>>>>>>>        Send ClientActionEx "gridRefresh" asParams hoJsonData
30285>>>>>>>        
30285>>>>>>>        Send Destroy of hoJsonData
30286>>>>>>>    End_Procedure
30287>>>>>>>
30287>>>>>>>    
30287>>>>>>>    // Does a empty grid refresh
30287>>>>>>>    Procedure EmptyGridRefresh
30289>>>>>>>        String[] asParams
30290>>>>>>>        tWebListData listData
30290>>>>>>>        tWebListData listData
30290>>>>>>>        
30290>>>>>>>        //  We cancel previous gridRefresh client actions that might be queued before
30290>>>>>>>        Send CancelClientAction "gridRefresh"
30291>>>>>>>        
30291>>>>>>>        //  Call client action with empty data set
30291>>>>>>>        Move True to asParams[0]
30292>>>>>>>        Move True to asParams[1]
30293>>>>>>>        Send ClientAction "gridRefresh" asParams listData
30294>>>>>>>    End_Procedure
30295>>>>>>>    
30295>>>>>>>    
30295>>>>>>>    // This message is sent by the client to load a page of data. Usually caused by the user 
30295>>>>>>>    // scrolling to the end of the virtual list.
30295>>>>>>>    Procedure LoadDataPage String sType String sStartRowID
30297>>>>>>>        Boolean bFirst bLast
30297>>>>>>>        tWebListData listData
30297>>>>>>>        tWebListData listData
30297>>>>>>>        Handle hoJsonData
30297>>>>>>>        String[] asParams
30298>>>>>>>        
30298>>>>>>>        //  Forward call to the load data
30298>>>>>>>        Get LoadData sType sStartRowID (&bFirst) (&bLast) to listData
30299>>>>>>>        
30299>>>>>>>        //  Convert data to JSON
30299>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJsonData
30300>>>>>>>        Send DataTypeToJson of hoJsonData listData
30301>>>>>>>        
30301>>>>>>>        //  Call client action with new data page
30301>>>>>>>        Move sType          to asParams[0]
30302>>>>>>>        Move sStartRowId    to asParams[1]
30303>>>>>>>        Move bFirst         to asParams[2]
30304>>>>>>>        Move bLast          to asParams[3]
30305>>>>>>>        Send ClientActionEx "handleDataPage" asParams hoJsonData
30306>>>>>>>        
30306>>>>>>>        Send Destroy of hoJsonData
30307>>>>>>>    End_Procedure
30308>>>>>>>    
30308>>>>>>>    // OnManualLoadData is False - DDO LoadData
30308>>>>>>>    // Returns a set of data to be passed back to the client side grid.
30308>>>>>>>    // sType - is the type of data to be loaded. Options are: 
30308>>>>>>>    //         "page": returns a set of records around (above and below) the current row
30308>>>>>>>    //         "first": loads the first page of data
30308>>>>>>>    //         "last": loads the last page of data
30308>>>>>>>    //         "next": loads the next page of data relative to the passed sStartRowID
30308>>>>>>>    //         "prev": loads the previous page of data relative to the passed sStartRowID
30308>>>>>>>    //         Note that these values are case sensitive.
30308>>>>>>>    // sStartRowID - Is the server table's RowID to begin from when loading "next" or "prev" pages.
30308>>>>>>>    // bFirst - [out] True if the returned data is the first page in the total data set.
30308>>>>>>>    // bLast - [out] true if the returned data is the last page in the total data set.
30308>>>>>>>    //
30308>>>>>>>    // OnManualLoadData is True - Manual Load Data
30308>>>>>>>    // Populates list via OnManualLoadData and sets bFirst & bLast to True
30308>>>>>>>    //
30308>>>>>>>    // Returns - the requested page of data.
30308>>>>>>>    Function LoadData String sType String sStartRowID Boolean ByRef bFirst Boolean ByRef bLast Returns tWebListData
30310>>>>>>>        tWebListData listData
30310>>>>>>>        tWebListData listData
30310>>>>>>>        Handle hoDD
30310>>>>>>>        Integer iMainFile iPageSize iHalfPageSize iOrdering
30310>>>>>>>        Integer iRow iCol icColumn iFile iField iLimit
30310>>>>>>>        RowID riRowID
30310>>>>>>>        String sValue sRowID
30310>>>>>>>        Boolean bUsePageSize bReverseOrdering bDataAware bLastFound bScrollable
30310>>>>>>>        Integer eDBGridType
30310>>>>>>>        Variant vFilterState
30310>>>>>>>
30310>>>>>>>        // Test if OnManualLoadData has been agumented. If this event returns True then we
30310>>>>>>>        // will use that to populate the grid and the DDO (data-aware) grid loading will be
30310>>>>>>>        // skipped.  
30310>>>>>>>        Get pbDataAware to bDataAware
30311>>>>>>>        Get peDbGridType to eDBGridType
30312>>>>>>>        Get pbScroll to bScrollable
30313>>>>>>>        
30313>>>>>>>        // Data is loaded manually if the data is not-data aware or if
30313>>>>>>>        // it is data aware and manual loaded.
30313>>>>>>>        If (not(bDataAware) or (eDBGridType=gtManual)) Begin      
30315>>>>>>>            WebGet psCurrentRowId to sRowID
30316>>>>>>>                
30316>>>>>>>            Send OnManualLoadData (&listData.aRows) (&sRowID) (&listData.aGroups) (&listData.aGroupHeaders)
30317>>>>>>>        
30317>>>>>>>            Move True to bFirst
30318>>>>>>>            Move True to bLast
30319>>>>>>>            WebSet psCurrentRowId to sRowID
30320>>>>>>>            Function_Return listData 
30321>>>>>>>        End
30321>>>>>>>>
30321>>>>>>>        
30321>>>>>>>        Get ReadingServer to hoDD
30322>>>>>>>        Get IndexOrder to iOrdering
30323>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
30324>>>>>>>        WebGet piLimitRows to iLimit
30325>>>>>>>
30325>>>>>>>        Move False to bFirst
30326>>>>>>>        Move False to bLast
30327>>>>>>>
30327>>>>>>>        If (hoDD) Begin
30329>>>>>>>            Send ApplyFilter hoDD (&vFilterState)
30330>>>>>>>            Move 0 to iRow
30331>>>>>>>            Get piPageSize to iPageSize
30332>>>>>>>            Move (eDBGridType=gtAutomatic and bScrollable and (iPageSize > 0)) to bUsePageSize
30333>>>>>>>            Get Main_File of hoDD to iMainFile
30334>>>>>>>            
30334>>>>>>>            WebGet psCurrentRowId to sRowID    // Get the RowID of the current row
30335>>>>>>>            Move (DeserializeRowID(sRowID)) to riRowID
30336>>>>>>>            If (IsNullRowID(riRowID)) Begin
30338>>>>>>>                // if no row id, we don't do anything. We return an empty set of rows
30338>>>>>>>                // and indicate that we have all the records we can find
30338>>>>>>>                Move True to bFirst
30339>>>>>>>                Move True to bLast
30340>>>>>>>            End
30340>>>>>>>>
30340>>>>>>>            Else Begin
30341>>>>>>>                // Handle the different request "types"
30341>>>>>>>                
30341>>>>>>>                // "page" request type (usually initial request) returns records 
30341>>>>>>>                // above and below the current row
30341>>>>>>>                If (sType = "page") Begin
30343>>>>>>>                    
30343>>>>>>>                    // Find half a page reading backwards from the current row
30343>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID     // Read the current row
30344>>>>>>>    
30344>>>>>>>                    Send EstablishDDFindMode LT hoDD iOrdering bReverseOrdering
30345>>>>>>>                    Send Locate_Next to hoDD
30346>>>>>>>                    Move Found to bLastFound
30347>>>>>>>                    Move (iPageSize / 2) to iHalfPageSize
30348>>>>>>>                                        
30348>>>>>>>                    While (bLastFound and (not(bUsePageSize) or (iRow < iHalfPageSize)) and (iLimit = 0 or iRow < iLimit))
30352>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
30354>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
30355>>>>>>>                            Increment iRow
30356>>>>>>>                        End
30356>>>>>>>>
30356>>>>>>>                        
30356>>>>>>>                        Send Locate_Next to hoDD
30357>>>>>>>                        Move Found to bLastFound    //  Store Found value since LoadGridRow triggers user events that might change the Found indicator
30358>>>>>>>                    Loop
30359>>>>>>>>
30359>>>>>>>                    
30359>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and iRow >= iLimit)) to bFirst              // Determine 'bFirst'
30360>>>>>>>                    Move (ReverseArray(listData.aRows)) to listData.aRows  // Now reverse the array and add the rows below the current row
30361>>>>>>>    
30361>>>>>>>                    // load the current record
30361>>>>>>>                    Send ReadByRowId of hoDD iMainFile riRowID
30362>>>>>>>                    Move Found to bLastFound
30363>>>>>>>                    If (OnCheckCustomConstrains(Self)) Begin
30365>>>>>>>                        Get LoadGridRow to listData.aRows[iRow]
30366>>>>>>>                        Increment iRow
30367>>>>>>>                    End
30367>>>>>>>>
30367>>>>>>>    
30367>>>>>>>                    // Find the remaining records
30367>>>>>>>                    Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
30368>>>>>>>                    While ((not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
30372>>>>>>>                        Send Locate_Next to hoDD
30373>>>>>>>                        Move Found to bLastFound
30374>>>>>>>                        If (not(Found)) ;                            Break
30377>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
30379>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
30380>>>>>>>                            Increment iRow
30381>>>>>>>                        End
30381>>>>>>>>
30381>>>>>>>                    Loop
30382>>>>>>>>
30382>>>>>>>                    
30382>>>>>>>                    // Set the bLast flag
30382>>>>>>>                    Move (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) to bLast      
30383>>>>>>>                End
30383>>>>>>>>
30383>>>>>>>                Else Begin
30384>>>>>>>                    Case Begin
30384>>>>>>>                        Case (sType = "first")
30386>>>>>>>                            //  Load the first record
30386>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
30386>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
30386>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
30386>>>>>>>                            Get ReadDDFirstRecord hoDD iOrdering bReverseOrdering to riRowID
30387>>>>>>>                            Move True to bFirst
30388>>>>>>>                            Case Break
30389>>>>>>>                        
30389>>>>>>>                        Case (sType = "last")
30392>>>>>>>                            //  Load the last record
30392>>>>>>>                            // NOTE: Request_Read when called during DEO Refresh (or any other DDO operation) from DDO will screw up the
30392>>>>>>>                            // DDO's ability to track the array of DDO's in the DDO structure who need to be listeners to the DDO operation!
30392>>>>>>>                            // Therefore make sure that this case never gets called indirectly via a DDO to DEO Refresh
30392>>>>>>>                            Get ReadDDLastRecord hoDD iOrdering bReverseOrdering to riRowID
30393>>>>>>>                            Move True to bLast
30394>>>>>>>                            Case Break
30395>>>>>>>                    
30395>>>>>>>                        Case (sType = "next")
30398>>>>>>>                            //  Load the start record
30398>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
30399>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
30400>>>>>>>                            Send EstablishDDFindMode GT  hoDD iOrdering bReverseOrdering
30401>>>>>>>                            Send Locate_Next of hoDD
30402>>>>>>>                            Case Break
30403>>>>>>>                    
30403>>>>>>>                        Case (sType = "prev")
30406>>>>>>>                            //  Load the start record
30406>>>>>>>                            Move (DeserializeRowID(sStartRowId)) to riRowID
30407>>>>>>>                            Send ReadByRowId of hoDD iMainFile riRowID
30408>>>>>>>                            Send EstablishDDFindMode LT  hoDD iOrdering bReverseOrdering
30409>>>>>>>                            Send Locate_Next of hoDD
30410>>>>>>>                    Case End
30410>>>>>>>                    Move Found to bLastFound
30411>>>>>>>                    
30411>>>>>>>                    //  Find remaining records
30411>>>>>>>                    While (Found and (not(bUsePageSize) or (iRow < iPageSize)) and (iLimit = 0 or iRow < iLimit))
30415>>>>>>>                        If (OnCheckCustomConstrains(Self)) Begin
30417>>>>>>>                            Get LoadGridRow to listData.aRows[iRow]
30418>>>>>>>                            Increment iRow
30419>>>>>>>                        End
30419>>>>>>>>
30419>>>>>>>                        Send Locate_Next to hoDD
30420>>>>>>>                        Move Found to bLastFound
30421>>>>>>>                    Loop
30422>>>>>>>>
30422>>>>>>>                
30422>>>>>>>                    // Set the bLast and bFirst flags
30422>>>>>>>                    If (not(bLastFound) or (iLimit > 0 and  iRow >= iLimit)) Begin
30424>>>>>>>                        If (sType = "next" or sType = "first") Begin
30426>>>>>>>                            Move True to bLast
30427>>>>>>>                        End
30427>>>>>>>>
30427>>>>>>>                        Else Begin
30428>>>>>>>                            Move True to bFirst
30429>>>>>>>                        End
30429>>>>>>>>
30429>>>>>>>                    End            
30429>>>>>>>>
30429>>>>>>>                End
30429>>>>>>>>
30429>>>>>>>            End
30429>>>>>>>>
30429>>>>>>>
30429>>>>>>>            Send DisregardFilter vFilterState
30430>>>>>>>        End
30430>>>>>>>>
30430>>>>>>>        Else Begin
30431>>>>>>>            //  Stop the list from trying to find records while there is no DD
30431>>>>>>>            Move True to bLast
30432>>>>>>>            Move True to bFirst
30433>>>>>>>        End
30433>>>>>>>>
30433>>>>>>>
30433>>>>>>>        Function_Return listData
30434>>>>>>>    End_Function
30435>>>>>>>    
30435>>>>>>>    
30435>>>>>>>    // Sent by LoadData. User hook to manually populate the grid. To use this create some loop where each
30435>>>>>>>    // iteration populates one row of the grid.
30435>>>>>>>    // aTheRows      - [out] Array of tWebRow members to be populated. This is the grid data. 
30435>>>>>>>    //                 The aValues member should contain one array member for each column, starting with
30435>>>>>>>    //                 array member 1 for column one. aValues[0] should be populated with a unique RowID.
30435>>>>>>>    // sCurrentRowID - [out] Set this to the unique rowID of the row you wish to become the currently 
30435>>>>>>>    //                 selected row after the grid data is sent to the client.
30435>>>>>>>    Procedure OnManualLoadData tWebRow[] ByRef aTheRows String ByRef sCurrentRowID tWebGroupConfig[] ByRef aTheGroups tWebGroupHeader[] ByRef aTheGroupHeaders
30437>>>>>>>        
30437>>>>>>>    End_Procedure
30438>>>>>>>
30438>>>>>>>    
30438>>>>>>>    // Populates a single row of data.
30438>>>>>>>    // This is sent by LoadData when loading data from DDO server.
30438>>>>>>>    // It assumes that the global record buffers contain the grid row data that we want to display
30438>>>>>>>    // in the returned tWebGridRow.s
30438>>>>>>>
30438>>>>>>>    Function LoadGridRow Returns tWebRow
30440>>>>>>>        Boolean bDataAware
30440>>>>>>>        RowID riRowID
30440>>>>>>>        Integer iFile iField iCol icColumn eDataType iMainFile
30440>>>>>>>        String sValue
30440>>>>>>>        Handle hoDD
30440>>>>>>>        Handle[] aColumns
30441>>>>>>>        tWebRow tRow
30441>>>>>>>        tWebRow tRow
30441>>>>>>>        
30441>>>>>>>        Get pbDataAware to bDataAware
30442>>>>>>>        Get Server to hoDD
30443>>>>>>>        
30443>>>>>>>        Get phoColumnObjects to aColumns
30444>>>>>>>        Move (SizeOfArray(aColumns)) to icColumn
30445>>>>>>>        Move (ResizeArray(tRow.aCells, icColumn)) to tRow.aCells
30446>>>>>>>        Move -1 to tRow.iGroupHeaderIndex
30447>>>>>>>        
30447>>>>>>>        If (bDataAware) Begin
30449>>>>>>>            Get Main_File of hoDD to iMainFile
30450>>>>>>>            
30450>>>>>>>            Move (GetRowID(iMainFile)) to riRowID
30451>>>>>>>            Move (SerializeRowID(riRowID)) to tRow.sRowID
30452>>>>>>>            
30452>>>>>>>            // Iterate the grid columns
30452>>>>>>>            For iCol from 0 to (icColumn-1)
30458>>>>>>>>
30458>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
30459>>>>>>>            Loop
30460>>>>>>>>
30460>>>>>>>        End
30460>>>>>>>>
30460>>>>>>>        Else Begin
30461>>>>>>>            WebGet psCurrentRowId to tRow.sRowID
30462>>>>>>>            
30462>>>>>>>            //  Determine if a value was changed
30462>>>>>>>            For iCol from 0 to (icColumn-1)
30468>>>>>>>>
30468>>>>>>>                Send LoadGridCell of aColumns[iCol] (&tRow.aCells[iCol])
30469>>>>>>>            Loop
30470>>>>>>>>
30470>>>>>>>        End
30470>>>>>>>>
30470>>>>>>>        
30470>>>>>>>        Send OnDefineRowCssClass (&tRow.sCssClassName)
30471>>>>>>>        
30471>>>>>>>        Function_Return tRow
30472>>>>>>>    End_Function 
30473>>>>>>>    
30473>>>>>>>    
30473>>>>>>>    // Loads the row posted from the action data into the buffer. It gets the row from a the 
30473>>>>>>>    // paActionData property and updates the psValue from the colums with its values. It also sets 
30473>>>>>>>    // the psCurrentRowId to the new row.
30473>>>>>>>    Procedure FillFromActionData
30475>>>>>>>        Handle[] aColumns
30476>>>>>>>        tWebRow[] aActionData
30476>>>>>>>        tWebRow[] aActionData
30477>>>>>>>        Handle hoJson
30477>>>>>>>        tWebRow tSelectRow
30477>>>>>>>        tWebRow tSelectRow
30477>>>>>>>        Integer iCol
30477>>>>>>>        String sValue
30477>>>>>>>        Boolean bCol
30477>>>>>>>        
30477>>>>>>>        //  Get the row from the action data
30477>>>>>>>        Get phoActionJsonData to hoJson
30478>>>>>>>        Get JsonToDataType of hoJson to aActionData
30479>>>>>>>        
30479>>>>>>>        If (SizeOfArray(aActionData) > 0) Begin
30481>>>>>>>            Move aActionData[0] to tSelectRow
30482>>>>>>>            
30482>>>>>>>            //  Update rowid
30482>>>>>>>            WebSet psCurrentRowId to tSelectRow.sRowID
30483>>>>>>>            
30483>>>>>>>            //  Update the DEO's (columns)
30483>>>>>>>            Get phoColumnObjects to aColumns
30484>>>>>>>            For iCol from 0 to (SizeOfArray(aColumns) - 1)
30490>>>>>>>>
30490>>>>>>>                Get pbIsWebColumn of aColumns[iCol] to bCol
30491>>>>>>>                If (bCol) Begin
30493>>>>>>>                    Get ConvertFromTransport of aColumns[iCol] (RefFunc(psValue)) tSelectRow.aCells[iCol].sValue cArgStr to sValue
30494>>>>>>>                    WebSet psValue of aColumns[iCol] to sValue
30495>>>>>>>                    
30495>>>>>>>                    WebSet pbChanged of aColumns[iCol] to False
30496>>>>>>>                End
30496>>>>>>>>
30496>>>>>>>            Loop
30497>>>>>>>>
30497>>>>>>>                            
30497>>>>>>>        End
30497>>>>>>>>
30497>>>>>>>        Else Begin
30498>>>>>>>            Error DFERR_PROGRAM "Assert: No row data in a action data."
30499>>>>>>>>
30499>>>>>>>        End
30499>>>>>>>>
30499>>>>>>>    End_Procedure
30500>>>>>>>    
