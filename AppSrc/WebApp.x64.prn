9345>>>>>    Function PathAtIndex String sPaths Integer iIndex Returns String
9347>>>>>        // Returns the path at the 1-based index of passed paths.
9347>>>>>        // If the path contains a trailing "\", it will be removed
9347>>>>>        Integer iChar icPath iPath iPos
9347>>>>>        String sPath
9347>>>>>        
9347>>>>>        Move (sPaths +";") to sPaths
9348>>>>>        For iPath from 1 to iIndex
9354>>>>>>
9354>>>>>            Move (Pos(";", sPaths)) to iPos
9355>>>>>            If iPos Begin
9357>>>>>                Move (Left(sPaths, iPos -1)) to sPath
9358>>>>>                If (Right(sPath,1) = '\') ;                    Move (Left(sPath, Length(sPath) -1)) to sPath
9361>>>>>                Move (Right(sPaths, Length(sPaths) -iPos)) to sPaths
9362>>>>>            End
9362>>>>>>
9362>>>>>            Else ;                Function_Return "" // index past number of paths
9364>>>>>        Loop
9365>>>>>>
9365>>>>>        
9365>>>>>        Function_Return sPath
9366>>>>>    End_Function
