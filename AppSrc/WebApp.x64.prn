32595>>>>>    
32595>>>>>    // Converts a record id from a hash for a specific table into a rowid. By default it offloads
32595>>>>>    // this to RecordIdToRowId of the Data Dictionary.
32595>>>>>    //
32595>>>>>    // Params:
32595>>>>>    //      iFile       File number.
32595>>>>>    //      sRecordId   String representing the record id.
32595>>>>>    //      rRowId      (ByRef) Filled with the rowid by this function.
32595>>>>>    // Returns:
32595>>>>>    //      True if the record id is valid.
32595>>>>>    Function HashRecordIdToRowId Integer iFile String sRecordId RowID ByRef rRowId Returns Boolean
32597>>>>>        Handle hoMainDD hoDD
32597>>>>>        Boolean bFound
32597>>>>>        
32597>>>>>        Move True to bFound
32598>>>>>        
32598>>>>>        Get Main_DD to hoMainDD
32599>>>>>        If (hoMainDD > 0) Begin
32601>>>>>            Get Data_Set of hoMainDD iFile to hoDD
32602>>>>>            
32602>>>>>            If (hoDD > 0) Begin
32604>>>>>                If (Lowercase(sRecordId) <> (Lowercase(psStateNewRecordId(Self)))) Begin
32606>>>>>                    Get RecordIdToRowId of hoDD sRecordId (&rRowId) to bFound
32607>>>>>                End
32607>>>>>>
32607>>>>>            End
32607>>>>>>
32607>>>>>        End
32607>>>>>>
32607>>>>>        
32607>>>>>        Function_Return bFound
32608>>>>>    End_Function
32609>>>>>    
32609>>>>>    
32609>>>>>    // Converts a rowid into a state hash record id (a readable format). By default this is
32609>>>>>    // offloaded to the Data Dictionary RowIdToRecordId logic that works on the primary key.
32609>>>>>    //
32609>>>>>    // Params:
32609>>>>>    //      iFile       File number.
32609>>>>>    //      sRowId      Serialized rowid.
32609>>>>>    // Returns:
32609>>>>>    //      Record id.
32609>>>>>    Function GenerateStateHashRecordId Integer iFile RowID rRowId Returns String
32611>>>>>        Handle hoMainDD hoDD
32611>>>>>        String sRecordId
32611>>>>>        
32611>>>>>        
32611>>>>>        Get Main_DD to hoMainDD
32612>>>>>        If (hoMainDD > 0) Begin
32614>>>>>            Get Data_Set of hoMainDD iFile to hoDD
32615>>>>>            
32615>>>>>            If (hoDD > 0) Begin
32617>>>>>                If (IsNullRowID(rRowId)) Begin
32619>>>>>                    Move (psStateNewRecordId(Self)) to sRecordId
32620>>>>>                End
32620>>>>>>
32620>>>>>                Else Begin
32621>>>>>                    Get RowIdToRecordId of hoDD rRowId to sRecordId
32622>>>>>                End
32622>>>>>>
32622>>>>>            End
32622>>>>>>
32622>>>>>        End
32622>>>>>>
32622>>>>>        
32622>>>>>        Function_Return sRecordId
32623>>>>>    End_Function
