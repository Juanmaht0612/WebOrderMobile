10337>>>>>>>>>>>Define MAX_ERROR_NUMBER for 32766
10337>>>>>>>>>>>
10337>>>>>>>>>>>// This array stores the set of trapped errors as toggled ranges starting
10337>>>>>>>>>>>// with the errors that are trapped. The array should always contain 0 and
10337>>>>>>>>>>>// MAX_ERROR_NUMBER + 1, which are the limits. If an array contained the
10337>>>>>>>>>>>// following items...
10337>>>>>>>>>>>//
10337>>>>>>>>>>>// { 0, 5, 10, MAX_ERROR_NUMBER + 1 }.
10337>>>>>>>>>>>//
10337>>>>>>>>>>>// This would mean that errors 1 - 4 are trapped, 5 - 9 are ignored, and
10337>>>>>>>>>>>// 10 through the rest are trapped.
10337>>>>>>>>>>>//
10337>>>>>>>>>>>Class cTrappedErrors is an array
10338>>>>>>>>>>>    Procedure Construct_Object
10340>>>>>>>>>>>        Forward Send Construct_Object
10342>>>>>>>>>>>        
10342>>>>>>>>>>>        Send initArray
10343>>>>>>>>>>>    End_Procedure
10344>>>>>>>>>>>    
10344>>>>>>>>>>>    // Find largest error LE targetError. Assumes array is sorted.
10344>>>>>>>>>>>    Function findErrorLE Integer targetError Returns Integer
10346>>>>>>>>>>>        
10346>>>>>>>>>>>        Integer lowIndex hiIndex midIndex currError
10346>>>>>>>>>>>        
10346>>>>>>>>>>>        // If error is outside of boudary conditions, use
10346>>>>>>>>>>>        // value of closest valid error# instead.
10346>>>>>>>>>>>        If (targetError <= 0);            Move 1 to targetError
10349>>>>>>>>>>>        Else If (targetError >= MAX_ERROR_NUMBER) ;            Move ( MAX_ERROR_NUMBER - 1 ) to targetError
10353>>>>>>>>>>>        
10353>>>>>>>>>>>        Move 0 to lowIndex
10354>>>>>>>>>>>        Move ( item_count( Self ) - 1 ) to hiIndex
10355>>>>>>>>>>>        
10355>>>>>>>>>>>        // midIndex will contain the closest error LE to target upon exit.
10355>>>>>>>>>>>        Repeat
10355>>>>>>>>>>>>
10355>>>>>>>>>>>            
10355>>>>>>>>>>>            Move ( ( lowIndex + hiIndex ) / 2 ) to midIndex
10356>>>>>>>>>>>            Move ( integer_value( Self, midIndex ) )  to currError
10357>>>>>>>>>>>            
10357>>>>>>>>>>>            // midIndex is targetIndex if a match occurs
10357>>>>>>>>>>>            If (currError = targetError) ;                Function_Return midIndex
10360>>>>>>>>>>>            
10360>>>>>>>>>>>            // We are either on it or just below it.
10360>>>>>>>>>>>            If ( lowIndex = midIndex ) Begin
10362>>>>>>>>>>>                
10362>>>>>>>>>>>                If ( integer_value( Self, hiIndex ) le targetError ) ;                    Move hiIndex to midIndex
10365>>>>>>>>>>>                
10365>>>>>>>>>>>                Function_Return midIndex
10366>>>>>>>>>>>                
10366>>>>>>>>>>>            End
10366>>>>>>>>>>>>
10366>>>>>>>>>>>            
10366>>>>>>>>>>>            // No match, so move the boundaries.
10366>>>>>>>>>>>            If (currError > targetError) ;                Move ( midIndex - 1 ) to hiIndex
10369>>>>>>>>>>>            Else ;                Move midIndex to lowIndex
10371>>>>>>>>>>>            
10371>>>>>>>>>>>        Until lowIndex gt hiIndex
10373>>>>>>>>>>>        
10373>>>>>>>>>>>        Function_Return midIndex
10374>>>>>>>>>>>        
10374>>>>>>>>>>>    End_Function
10375>>>>>>>>>>>    
10375>>>>>>>>>>>    // Boundaries of the table are assumed to hold error limits.
10375>>>>>>>>>>>    Procedure initArray
10377>>>>>>>>>>>        Send delete_data
10378>>>>>>>>>>>        Set array_value  0 to 0
10379>>>>>>>>>>>        Set array_value  1 to ( MAX_ERROR_NUMBER + 1 )
10380>>>>>>>>>>>    End_Procedure
10381>>>>>>>>>>>    
10381>>>>>>>>>>>    // Return 1 if Error is trapped, 0 otherwise.
10381>>>>>>>>>>>    Function IsTrapped Integer Error# Returns Integer
10383>>>>>>>>>>>        Function_Return ( not ( mod( findErrorLE( Self, Error# ), 2 ) ) )
10384>>>>>>>>>>>    End_Function
10385>>>>>>>>>>>    
10385>>>>>>>>>>>    // Add the error as long as it doesn't violate boundary conditions.
10385>>>>>>>>>>>    // This routine leaves the array unsorted.
10385>>>>>>>>>>>    Procedure addError Integer Error#
10387>>>>>>>>>>>        If ( ( Error# lt MAX_ERROR_NUMBER ) and ( Error# gt 0 ) ) ;            Set array_value  ( item_count( Self ) ) to ( Integer( Error# ) )
10390>>>>>>>>>>>    End_Procedure
10391>>>>>>>>>>>    
10391>>>>>>>>>>>    // Set error to flagged state.
10391>>>>>>>>>>>    Procedure handleError Integer Error# Integer trapFlag
10393>>>>>>>>>>>        
10393>>>>>>>>>>>        Integer prevErrIndex prevErrFlag prevErrValue nextErrValue
10393>>>>>>>>>>>        
10393>>>>>>>>>>>        If ( ( Error# gt MAX_ERROR_NUMBER ) or ( Error# lt 0 ) ) Begin
10395>>>>>>>>>>>            Error DFERR_ERROR_NUMBER_OUT_OF_RANGE
10396>>>>>>>>>>>>
10396>>>>>>>>>>>            Procedure_Return
10397>>>>>>>>>>>        End
10397>>>>>>>>>>>>
10397>>>>>>>>>>>        
10397>>>>>>>>>>>        Get findErrorLE Error# to prevErrIndex
10398>>>>>>>>>>>        Get isTrapped   Error# to prevErrFlag
10399>>>>>>>>>>>        
10399>>>>>>>>>>>        // if eq, Error already handled in some range.
10399>>>>>>>>>>>        If (PrevErrFlag <> trapFlag) Begin
10401>>>>>>>>>>>            
10401>>>>>>>>>>>            // This is kind of complicated. If we are adding an error,
10401>>>>>>>>>>>            // we have to account for the error already being in the
10401>>>>>>>>>>>            // array as well as rejoining ranges that have been previously
10401>>>>>>>>>>>            // split and splitting ranges when adding a new flag.
10401>>>>>>>>>>>            
10401>>>>>>>>>>>            Get integer_value  ( prevErrIndex + 1 ) to nextErrValue
10402>>>>>>>>>>>            Get integer_value  prevErrIndex         to prevErrValue
10403>>>>>>>>>>>            
10403>>>>>>>>>>>            // Do this first so prevErrIndex stays valid.
10403>>>>>>>>>>>            If (nextErrValue = ( Error# + 1 )) ;                Send delete_item ( prevErrIndex + 1 )
10406>>>>>>>>>>>            Else ;                Send addError ( Error# + 1 )
10408>>>>>>>>>>>            
10408>>>>>>>>>>>            If ( prevErrValue < Error# ) ;                Send addError Error#
10411>>>>>>>>>>>            Else ;                Send delete_item prevErrIndex
10413>>>>>>>>>>>        End
10413>>>>>>>>>>>>
10413>>>>>>>>>>>        Send sort_items UPWARD_DIRECTION
10414>>>>>>>>>>>        
10414>>>>>>>>>>>    End_Procedure
10415>>>>>>>>>>>    
10415>>>>>>>>>>>    // Flag error as trappable
10415>>>>>>>>>>>    Procedure Trap_Error Integer Error#
10417>>>>>>>>>>>        Send handleError Error# 1
10418>>>>>>>>>>>    End_Procedure
10419>>>>>>>>>>>    
10419>>>>>>>>>>>    // Flag error as non-trappable
10419>>>>>>>>>>>    Procedure Ignore_Error Integer Error#
10421>>>>>>>>>>>        Send handleError Error# 0
10422>>>>>>>>>>>    End_Procedure
10423>>>>>>>>>>>    
10423>>>>>>>>>>>    // Flag all errors as trappable
10423>>>>>>>>>>>    Procedure Trap_All
10425>>>>>>>>>>>        Send initArray
10426>>>>>>>>>>>    End_Procedure
10427>>>>>>>>>>>    
10427>>>>>>>>>>>    // Flag all errors as non-trappable
10427>>>>>>>>>>>    Procedure Ignore_All
10429>>>>>>>>>>>        Send delete_data
10430>>>>>>>>>>>        Set array_value 0 to 0
10431>>>>>>>>>>>        Set array_value 1 to 1
10432>>>>>>>>>>>        Set array_value 2 to ( MAX_ERROR_NUMBER + 1 )
10433>>>>>>>>>>>    End_Procedure
10434>>>>>>>>>>>End_Class
