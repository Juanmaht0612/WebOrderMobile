23128>>>>>>>    // Returns the collection of DDO object name and RowID pairs for the view's DDO structure.
23128>>>>>>>    // The collection is specially ordered so that the first DDO is the view's Main DD, followed
23128>>>>>>>    // by the child DDO sub-tree, then the parent DDO sub-tree. This is the order that you want
23128>>>>>>>    // to traverse the DDO tree when synchronizing each server DDO to the client RowIDs.
23128>>>>>>>    Procedure StoreDDOStates
23130>>>>>>>        Integer i icDDO iFile
23130>>>>>>>        RowID riRowID
23130>>>>>>>        String sCheck
23130>>>>>>>        Boolean bDynamicConstraints
23130>>>>>>>        Integer iSrvr iSrvrs
