33883>>>>>>>>>                        End
33883>>>>>>>>>>
33883>>>>>>>>>                        Else Begin
33884>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
33885>>>>>>>>>                        End
33885>>>>>>>>>>
33885>>>>>>>>>                        
33885>>>>>>>>>                        Send ReadChunk (&parsedata)             
33886>>>>>>>>>                    End
33887>>>>>>>>>>
33887>>>>>>>>>                    
