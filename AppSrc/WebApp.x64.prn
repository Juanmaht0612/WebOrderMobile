18769>>>>>>>>>        tWebPropMetaData result
18769>>>>>>>>>        tWebPropMetaData result
18769>>>>>>>>>        
18769>>>>>>>>>        //  Look in object properties if we have them
18769>>>>>>>>>        Get FindWebPropertyByGetter hmGetter to result
18770>>>>>>>>>        
18770>>>>>>>>>        //  Look in class properties if we did not find it yet
18770>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyByGetter of (phoClassPropMeta(Self)) hmGetter to result
18773>>>>>>>>>            
18773>>>>>>>>>        Function_Return result
18774>>>>>>>>>    End_Function
18775>>>>>>>>>    
18775>>>>>>>>>    // Looks up the meta data for a web property based on its name. Returns the meta data in a tWebPropMetaData struct.
18775>>>>>>>>>    Function FindWebPropertyMetaByName String sName Returns tWebPropMetaData
18777>>>>>>>>>        tWebPropMetaData result
18777>>>>>>>>>        tWebPropMetaData result
18777>>>>>>>>>        
18777>>>>>>>>>        //  Look in object properties if we have them
18777>>>>>>>>>        Get FindWebPropertyByName sName to result
18778>>>>>>>>>        
18778>>>>>>>>>        //  Look in class properties if we did not find it yet
18778>>>>>>>>>        If (result.hmGetter = 0) ;            Get FindWebPropertyByName of (phoClassPropMeta(Self)) sName to result
