3807>>>>>        If (Label_Needs_Sizing_State(Self)) ;            Send Locate_label
3810>>>>>    End_Procedure
3811>>>>>    
3811>>>>>    // called when a label color is set. It sets new text and back colors
3811>>>>>    // if needed. It handle clNone colors, which means get the color from the
3811>>>>>    // container. If both colors are clNone it makes sure they are not the same.
3811>>>>>    Procedure AdjustLabelColors Handle hoLabel
3813>>>>>        Integer iTxtClr iBackClr
3813>>>>>        Integer iCurrentColor
3813>>>>>        Boolean bTestColor
3813>>>>>        
3813>>>>>        Get Label_Color to iBackClr
3814>>>>>        Get Label_TextColor to iTxtClr
3815>>>>>        
3815>>>>>        // if both colors are inherited from container we do
3815>>>>>        // a test for them being the same color.
3815>>>>>        Move (iTxtClr=clNone and iBackClr=clNone) to bTestColor
3816>>>>>        
3816>>>>>        If (iTxtClr=clNone) Begin
3818>>>>>            Delegate Get TextColor to iTxtClr
3820>>>>>        End
3820>>>>>>
3820>>>>>        If (iBackClr=clNone) Begin
3822>>>>>            Delegate Get Color to iBackClr
3824>>>>>        End
3824>>>>>>
3824>>>>>        If (bTestColor and iBackClr=iTxtClr) Begin
3826>>>>>            Move clBtnText to iTxtClr
3827>>>>>        End
3827>>>>>>
3827>>>>>        Get Color of hoLabel to iCurrentColor
3828>>>>>        If (iCurrentColor<>iBackClr) Begin
3830>>>>>            Set Color of hoLabel to iBackClr
3831>>>>>        End
3831>>>>>>
3831>>>>>        Get TextColor of hoLabel to iCurrentColor
3832>>>>>        If (iCurrentColor<>iTxtClr) Begin
3834>>>>>            Set TextColor of hoLabel to iTxtClr
3835>>>>>        End
3835>>>>>>
3835>>>>>    End_Procedure
3836>>>>>    
3836>>>>>    Function LabelHeightMetric Returns Integer
3838>>>>>        Integer iSz iPointHt iFontSz
3838>>>>>        String sFace
3838>>>>>        Boolean bLabelHt
3838>>>>>        Get pbLabelUseCtrlHeight to bLabelHt
3839>>>>>        If (bLabelHt) Begin
3841>>>>>            Get Label_FontPointHeight to iPointHt
3842>>>>>            Get Label_TypeFace to sFace
3843>>>>>            Get Label_FontSize to iFontSz
3844>>>>>            If (iPointHt=-1 and sFace="" and iFontSz=0) Begin
3846>>>>>                Get GuiSize  to iSz
3847>>>>>                Function_Return (hi(iSz))
3848>>>>>            End
3848>>>>>>
3848>>>>>        End
3848>>>>>>
3848>>>>>        Function_Return 0
3849>>>>>    End_Function
3850>>>>>    
3850>>>>>    Procedure Locate_Label
3852>>>>>        Integer iLoc  iRow iCol iRowOff iColOff iSz
3852>>>>>        Integer eDelMode eJMode
3852>>>>>        String sLabel
3852>>>>>        Handle hoLabel
3852>>>>>        
3852>>>>>        Get Label_object to hoLabel
3853>>>>>        If hoLabel Begin
3855>>>>>            Get Delegation_mode to eDelMode
3856>>>>>            Set Delegation_mode to Delegate_to_Parent // for label sizing to work, delegation *must* be enabled
3857>>>>>            
3857>>>>>            Send Adjust_Logicals
3858>>>>>            Get Value of hoLabel to sLabel
3859>>>>>            Set Auto_Size_State of hoLabel to True
3860>>>>>            Set Value of hoLabel to sLabel // this forces an autosize & Adjust logicals
3861>>>>>            Set Auto_Size_State of hoLabel to False
3862>>>>>            Get Label_Row_Offset to iRowOff
3863>>>>>            Get Label_Col_Offset to iColOff
3864>>>>>            Get Location to iLoc
3865>>>>>            Get Label_Justification_Mode to eJMode
3866>>>>>            
3866>>>>>            Move (Low(iLoc)-iColOff) to iCol
3867>>>>>            Get GuiSize  to iSz
3868>>>>>            Integer iHt iWd
3868>>>>>            Move (Low(GuiSize(hoLabel))) to iWd
3869>>>>>            If (iRowOff=0 and (eJMode=JMode_Right or eJMode=JMode_Left)) Begin
3871>>>>>                Get LabelHeightMetric to iHt
3872>>>>>            End
3872>>>>>>
3872>>>>>            
3872>>>>>            If (iHt=0) Begin
3874>>>>>                Move (iRowOff-2) to iRowOff // This forces this down so that it properly aligns against text in a form
3875>>>>>                Move (hi(GuiSize(hoLabel))) to iHt
3876>>>>>            End
3876>>>>>>
3876>>>>>            
3876>>>>>            // we get the GuiSize of the Label object and then convert it
3876>>>>>            // to Dialog units using dialog container object. This way it is
3876>>>>>            // located relative to the container and not the label
3876>>>>>            Set GuiSize of hoLabel to iHt iWd
3877>>>>>            Send Adjust_Logicals of hoLabel
3878>>>>>            Delegate Get GuiToDialog iHt iWd to iSz // as of 15.0, dialog units based on container
3880>>>>>            
3880>>>>>            If (eJMode iand JMODE_Right) Begin
3882>>>>>                Move (iCol - Low(iSz)-1) to iCol
3883>>>>>            End
3883>>>>>>
3883>>>>>            
3883>>>>>            If (eJMode iand JMODE_TOP) Begin
3885>>>>>                Move (iRowOff + Hi(iSz) + 2) to iRowOff
3886>>>>>                If (eJMode iand JMODE_Right) ;                    Move (iCol + Low(iSz)) to iCol
3889>>>>>            End
3889>>>>>>
3889>>>>>            
3889>>>>>            Move (Hi(iLoc)-iRowOff) to iRow
3890>>>>>            
3890>>>>>            Set Location of hoLabel to iRow iCol
3891>>>>>            Set Justification_Mode of hoLabel to JMode_VCenter
3892>>>>>            
3892>>>>>            // legacy behavior. Anytime we adjust the location we check the colors
3892>>>>>            Send AdjustLabelColors hoLabel
3893>>>>>            
3893>>>>>            Set Label_Needs_Sizing_state to False
3894>>>>>            
3894>>>>>            Set Delegation_mode to eDelMode
3895>>>>>        End
3895>>>>>>
3895>>>>>    End_Procedure
3896>>>>>
3896>>>>>    Procedure Set GuiSize Integer cy Integer cx
3898>>>>>        Integer Sz NewSz
3898>>>>>        Get GuiSize to Sz
3899>>>>>        Forward Set GuiSize to cy cx
3901>>>>>        If (not(BuildingObjectId)) Begin
3903>>>>>            Get GuiSize to NewSz
3904>>>>>            If (NewSz <> Sz) ;                Send Resize_Label
3907>>>>>        End
3907>>>>>>
3907>>>>>    End_Procedure
3908>>>>>    
3908>>>>>    Procedure Set GuiLocation Integer y Integer x
3910>>>>>        Integer lc NewLc
