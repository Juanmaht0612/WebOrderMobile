15149>>>>>>>>>>>    Procedure Request_Superfind Integer eFindMode Integer iFile Integer iField
15151>>>>>>>>>>>        Boolean bInSuperFind
15151>>>>>>>>>>>        // we need to set pbInSuperFind so Entry_update in the DEOs will know that
15151>>>>>>>>>>>        // they should perform an entry_update. Superfind entry_updates have never gone through
15151>>>>>>>>>>>        // the DD's field buffer.
15151>>>>>>>>>>>        Get pbInSuperFind to bInSuperFind
15152>>>>>>>>>>>        Set pbInSuperFind to True
