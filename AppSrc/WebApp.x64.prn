17588>>>>>>>>>>>>>    End_Procedure
17589>>>>>>>>>>>>>    
17589>>>>>>>>>>>>>    // Core webapp framework request handling. Initiates all individual steps (Core_...) that
17589>>>>>>>>>>>>>    // together process the call.  Note that most steps are implemented in other mixins, and 
17589>>>>>>>>>>>>>    // some might remain empty depending on the WebControlHost type (cWebApp vs 
17589>>>>>>>>>>>>>    // cLocalWebControlHost vs cWebControlViewhost).
17589>>>>>>>>>>>>>    //
17589>>>>>>>>>>>>>    // Preconditions:
17589>>>>>>>>>>>>>    //  cctx.hoRequest should contain a valid JSON handle to the request data.
17589>>>>>>>>>>>>>    //  cctx.hoResponse should contain a valid JSON handle to an empty JSON object.
17589>>>>>>>>>>>>>    // Postconditions:
17589>>>>>>>>>>>>>    //  cctx.hoResponse will be filled with the response or cctx.iFatalError will contain an 
17589>>>>>>>>>>>>>    //  HTTP Error code.
17589>>>>>>>>>>>>>    Procedure ProcessRequest tWebCallContext ByRef cctx
17591>>>>>>>>>>>>>        //  Clear data from previous requests
17591>>>>>>>>>>>>>        Send Call_ClearData (&cctx)
17592>>>>>>>>>>>>>        If (cctx.bCancel) Begin
17594>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
17595>>>>>>>>>>>>>            Procedure_Return
17596>>>>>>>>>>>>>        End
17596>>>>>>>>>>>>>>
17596>>>>>>>>>>>>>        
17596>>>>>>>>>>>>>        //  Initiate error handling
17596>>>>>>>>>>>>>        Send Call_PreErrorHandling (&cctx)
17597>>>>>>>>>>>>>        If (cctx.bCancel) Begin
17599>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
17600>>>>>>>>>>>>>            Procedure_Return
17601>>>>>>>>>>>>>        End
17601>>>>>>>>>>>>>>
17601>>>>>>>>>>>>>            
17601>>>>>>>>>>>>>        //  Validate the basic request structre
17601>>>>>>>>>>>>>        Send Call_ValidateData (&cctx)
17602>>>>>>>>>>>>>        If (cctx.bCancel) Begin
17604>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
17605>>>>>>>>>>>>>            Procedure_Return
17606>>>>>>>>>>>>>        End
17606>>>>>>>>>>>>>>
17606>>>>>>>>>>>>>        
17606>>>>>>>>>>>>>        //  Check the passed version number
17606>>>>>>>>>>>>>        Send Call_VersionCheck (&cctx)
17607>>>>>>>>>>>>>        If (cctx.bCancel) Begin
17609>>>>>>>>>>>>>            Send Call_FinishErrorHandling (&cctx)
17610>>>>>>>>>>>>>            Procedure_Return
17611>>>>>>>>>>>>>        End
17611>>>>>>>>>>>>>>
17611>>>>>>>>>>>>>        If (cctx.bSuccess) Begin
17613>>>>>>>>>>>>>            Increment giWebAccCacheCtx  //  Invalidate accessibility cache
17614>>>>>>>>>>>>>            
17614>>>>>>>>>>>>>            //  Parse the core request structure
17614>>>>>>>>>>>>>            Send Call_ParseRequestBody (&cctx)
17615>>>>>>>>>>>>>            If (cctx.bCancel) Begin
17617>>>>>>>>>>>>>                Send Call_FinishErrorHandling (&cctx)
17618>>>>>>>>>>>>>                Procedure_Return
17619>>>>>>>>>>>>>            End
17619>>>>>>>>>>>>>>
17619>>>>>>>>>>>>>            If (cctx.bSuccess) Begin
17621>>>>>>>>>>>>>                
17621>>>>>>>>>>>>>                //  Validate / initiate session
17621>>>>>>>>>>>>>                Send Call_PreValidateSession (&cctx)
17622>>>>>>>>>>>>>                If (cctx.bCancel) Begin
17624>>>>>>>>>>>>>                    Send Call_CancelWithError (&cctx)
17625>>>>>>>>>>>>>                    Procedure_Return
17626>>>>>>>>>>>>>                End
17626>>>>>>>>>>>>>>
17626>>>>>>>>>>>>>                If (cctx.bSuccess) Begin 
17628>>>>>>>>>>>>>                    
17628>>>>>>>>>>>>>                    //  Initialize attachment handling            
17628>>>>>>>>>>>>>                    Send Call_PreAttachments (&cctx)
17629>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17631>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17632>>>>>>>>>>>>>                        Procedure_Return
17633>>>>>>>>>>>>>                    End
17633>>>>>>>>>>>>>>
17633>>>>>>>>>>>>>                    
17633>>>>>>>>>>>>>                    //  Initialize web property system
17633>>>>>>>>>>>>>                    Send Call_PreWebProps (&cctx)
17634>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17636>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17637>>>>>>>>>>>>>                        Procedure_Return
17638>>>>>>>>>>>>>                    End   
17638>>>>>>>>>>>>>>
17638>>>>>>>>>>>>>                    
17638>>>>>>>>>>>>>                    //  Notify change rights (if nessecary)
17638>>>>>>>>>>>>>                    Send Call_PreNotifyChangeRights (&cctx)
17639>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17641>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17642>>>>>>>>>>>>>                        Procedure_Return
17643>>>>>>>>>>>>>                    End
17643>>>>>>>>>>>>>>
17643>>>>>>>>>>>>>                    
17643>>>>>>>>>>>>>                    //  Synchronize DDO's (if nessecary)
17643>>>>>>>>>>>>>                    Send Call_PreSync (&cctx)
17644>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17646>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17647>>>>>>>>>>>>>                        Procedure_Return
17648>>>>>>>>>>>>>                    End
17648>>>>>>>>>>>>>>
17648>>>>>>>>>>>>>                    
17648>>>>>>>>>>>>>                    //  Execute the core actions (OnClick / OnChange / ...)
17648>>>>>>>>>>>>>                    Send Call_Action (&cctx)
17649>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17651>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17652>>>>>>>>>>>>>                        Procedure_Return
17653>>>>>>>>>>>>>                    End                    
17653>>>>>>>>>>>>>>
17653>>>>>>>>>>>>>                    
17653>>>>>>>>>>>>>                    //  Store DDO states if nessecary
