31693>>>>>    // Returns the invokingobject when used in a drilldown
31693>>>>>    // NavigateFoward context. This should be an object within an invoking
31693>>>>>    // view or the invoking view. Often this would be the focus object when
31693>>>>>    // a prompt action is called.
31693>>>>>    Function GetInvokingObject Returns Handle 
31695>>>>>        Handle hoInvoker
31695>>>>>        String sInvoker
31695>>>>>        
31695>>>>>        Move C_WebUnresolvedObject to hoInvoker
31696>>>>>        
31696>>>>>        WebGet psInvokingObject to sInvoker
31697>>>>>        If (sInvoker <> "[NULL]") Begin
31699>>>>>            Get WebObjectByName sInvoker to hoInvoker
31700>>>>>        End
31700>>>>>>
31700>>>>>        
31700>>>>>        Function_Return hoInvoker        
31701>>>>>    End_Function
31702>>>>>
31702>>>>>    // Sets the invoking object for this view to hoInvokingObject.
31702>>>>>    Procedure SetInvokingObject Handle hoInvokingObject
31704>>>>>        Handle hoView
31704>>>>>        String sInvoker
31704>>>>>        
31704>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
31706>>>>>            Get WebObjectName of hoInvokingObject to sInvoker
31707>>>>>        End
31707>>>>>>
31707>>>>>        Else Begin
31708>>>>>            Move "[NULL]" to sInvoker
31709>>>>>        End
31709>>>>>>
31709>>>>>        
31709>>>>>        WebSet psInvokingObject to sInvoker
31710>>>>>    End_Procedure
31711>>>>>    
31711>>>>>    // Unconditionally navigate back to this view.
31711>>>>>    // We assume any data-loss checking has been done (if not, it's too late)
31711>>>>>    // If bCancel is true this is a Cancel operation (NavigateCancel), else a Close operation (NavigateClose)
31711>>>>>    // If a Close a callback, can and should be passed to update the NavigateData data before processing the close.
31711>>>>>    // This can be called when this view is not synched, in which case you should not trust the
31711>>>>>    // data or the web properties.
31711>>>>>    Procedure NavigateBackToHere Boolean bCancel Handle hoCallback
31713>>>>>        Handle hoTopView hoInvokingView
31713>>>>>        tWebValueTree tVT
31713>>>>>        tWebValueTree tVT
31713>>>>>        tWebNavigateData NavigateData
31713>>>>>        tWebNavigateData NavigateData
31713>>>>>        String[] aParams
31714>>>>>        
31714>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
31715>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
31716>>>>>        
31716>>>>>        
31716>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
31718>>>>>            // Get NavigateData from the view that is being closed
31718>>>>>            // start with the NavigateData from the view being closed
31718>>>>>            Get GetNavigateData of hoTopView to NavigateData
31719>>>>>            // if we are not going back to the invoking view this means you are jumping back several 
31719>>>>>            // breadcrumb items. The navigate type is always undefined and it is up to the developer to
31719>>>>>            // decide what to do with the returned data in OnNavigateBack
31719>>>>>            If (Self <> hoInvokingView) Begin
31721>>>>>                Move nfUndefined to NavigateData.eNavigateType
31722>>>>>            End
31722>>>>>>
31722>>>>>            Send GetNavigateBackData to hoCallback Self (&NavigateData)
31723>>>>>        End
31723>>>>>>
31723>>>>>        
31723>>>>>        // if we are the invoking object, both the top object and invoking are synched and we can proceed directly
31723>>>>>        // or if we are performing a cancel the extra round trip would have no real meaning
31723>>>>>        If (bCancel or Self = hoInvokingView) Begin
31725>>>>>            Send NavigateBackToHereExec (&NavigateData) bCancel hoCallback
31726>>>>>        End
31726>>>>>>
31726>>>>>        Else Begin
31727>>>>>            //  Navigating back multiple levels means that we need another round trip as the view we are navigating towards is nto synchronized
31727>>>>>                        
31727>>>>>            Move bCancel to aParams[0]
31728>>>>>            
31728>>>>>            //  Because "" indicates the WebApp object we have an extra boolean indicating if there actually is a callback object
31728>>>>>            If (hoCallback > 0) Begin
31730>>>>>                Move True to aParams[1]
31731>>>>>                Get WebObjectName of hoCallback to aParams[2]
31732>>>>>            End
31732>>>>>>
31732>>>>>            Else Begin
31733>>>>>                Move False to aParams[1]
31734>>>>>                Move "" to aParams[2]
31735>>>>>            End
31735>>>>>>
31735>>>>>            
31735>>>>>            ValueTreeSerializeParameter NavigateData to tVT
31736>>>>>            
31736>>>>>            //  Perform client action that will call NavigateBackToHere_Callback
31736>>>>>            Send ClientAction "navigateBackToHere" aParams tVT
31737>>>>>        End
31737>>>>>>
31737>>>>>        
31737>>>>>    End_Procedure
31738>>>>>
31738>>>>>    //  Actually performs the navigateBackToHere operation, either called directly or asynchronously
31738>>>>>    //  by NavigateBackToHere_Callback.
31738>>>>>    Procedure NavigateBackToHereExec tWebNavigateData ByRef NavigateData Boolean bCancel Handle hoCallback
31740>>>>>        Handle hoTopView 
31740>>>>>        Handle hoDD hoMainDD hoTarget hoInvokingObject hoInvokingObjectDD hoInvokingView hoNextView
31740>>>>>        String psInvoker sTitle sStateHash
31740>>>>>        Integer eViewType eTopViewStyle eViewStyle
31740>>>>>        RowID ri
31740>>>>>        Boolean bParentLookup bOverrideViewState
31740>>>>>        Integer iConstrainingFile eRefindError
31740>>>>>        Handle hoConstrainingParent hoRefindError
31740>>>>>        RowID riConstrainingParent
31740>>>>>        Boolean bSuccess
31740>>>>>        
31740>>>>>        //  Indicate that we are navigating
31740>>>>>        Set pbNavigating to True
31741>>>>>        
31741>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView   // handle to the current top of view
31742>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoInvokingView // 2nd to top
31743>>>>>        
31743>>>>>        If (hoTopView = Self) Begin
31745>>>>>            Error DFERR_PROGRAM "NavigateBackToHere is already the top of the stack"
31746>>>>>>
31746>>>>>        End
31746>>>>>>
31746>>>>>        
31746>>>>>        Get NextViewHandleByView of (ViewStack(Self)) Self to hoNextView
31747>>>>>        Get GetInvokingObject of hoNextView to hoInvokingObject 
31748>>>>>        
31748>>>>>        Get peWebViewStyle to eViewStyle
31749>>>>>        Get peWebViewStyle of hoTopView to eTopViewStyle       
31750>>>>>        
31750>>>>>        // send ShowView directly (this shows the view without clearing the 
31750>>>>>        // entire viewstack)
31750>>>>>        Get pbOverrideStateOnShow to bOverrideViewState
31751>>>>>        Set pbOverrideStateOnShow to False
31752>>>>>        // if we navigate from a regular drill down view to a dialog we need to perform some more logic
31752>>>>>        If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
31754>>>>>            Send RestoreDialog
31755>>>>>        End
31755>>>>>>
31755>>>>>        Else Begin
31756>>>>>            Send ShowView to (Host(Self)) Self 
31757>>>>>        End
31757>>>>>>
31757>>>>>        
31757>>>>>        Set pbOverrideStateOnShow to bOverrideViewState
31758>>>>>        // pop all unwanted views off the stack...
31758>>>>>        Send PopDownToView of (ViewStack(Self)) Self
31759>>>>>        Send UpdateInvokingViewDrillDownStyle
31760>>>>>
31760>>>>>        
31760>>>>>        // In this case we need to consider what to do with the data that
31760>>>>>        // is passed back from the previous top view.
31760>>>>>        Get peViewType to eViewType
31761>>>>>        Get Main_DD to hoMainDD  
31762>>>>>        
31762>>>>>        If hoMainDD Begin
31764>>>>>            Send Refind_Records of hoMainDD
31765>>>>>        End
31765>>>>>>
31765>>>>>
31765>>>>>        // if a close / update 
31765>>>>>        If (not(bCancel) and hoCallback <> 0) Begin
31767>>>>>
31767>>>>>            // if navigate from was relational (child, parent or main) we can do refinding
31767>>>>>            If (NavigateData.eNavigateType = nfFromChild or NavigateData.eNavigateType = nfFromMain or NavigateData.eNavigateType = nfFromParent) Begin
31769>>>>>                Get FindDDOForTable NavigateData.iTable to hoDD
31770>>>>>                If hoDD Begin
31772>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
31773>>>>>                    
31773>>>>>                    If (eViewType = vtZoom) Begin
31775>>>>>                        // This will force constrained parents to update if appropriate
31775>>>>>                        
31775>>>>>                        // Use the DD of the invoking object as our starting point 
31775>>>>>                        If hoInvokingObject Begin
31777>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
31778>>>>>                        End
31778>>>>>>
31778>>>>>                        // if no server (unlikely) use the view's main dd 
31778>>>>>                        If not (hoInvokingObjectDD) Begin
31780>>>>>                            Get Main_DD to hoInvokingObjectDD        
31781>>>>>                        End
31781>>>>>>
31781>>>>>                        If (hoInvokingObjectDD) Begin
31783>>>>>                            // assume a parent DD is a parent lookup. If so, we don't update
31783>>>>>                            // the rest of the view. If not a lookup, do a clear_all so the
31783>>>>>                            // findbyrowid updates all deos 
31783>>>>>                            // which_data_Set only searches up.
31783>>>>>                            Get Which_Data_Set of hoInvokingObjectDD NavigateData.iTable to hoTarget
31784>>>>>                            Move (hoTarget and hoTarget<>hoInvokingObjectDD) to bParentLookup
31785>>>>>                            If not bParentLookup Begin
31787>>>>>                                // if constrained we will need to constraining parent
31787>>>>>                                // DD and row in case this is a null child RowId
31787>>>>>                                Get Constrain_File of hoDD to iConstrainingFile
31788>>>>>                                If (iConstrainingFile) Begin
31790>>>>>                                    Get Which_Data_Set of hoDD iConstrainingFile to hoConstrainingParent
31791>>>>>                                    If hoConstrainingParent Begin
31793>>>>>                                        Get CurrentRowId of hoConstrainingParent to riConstrainingParent
31794>>>>>                                    End
31794>>>>>>
31794>>>>>                                End
31794>>>>>>
31794>>>>>                                Send Clear_All of hoDD
31795>>>>>                                If (IsNullRowID(ri) and hoConstrainingParent) Begin
31797>>>>>                                    Get FindByRowIdEx of hoConstrainingParent iConstrainingFile riConstrainingParent to bSuccess
31798>>>>>                                    If not bSuccess Begin
31800>>>>>                                        // this is quite unlikely
31800>>>>>                                        // This is kind of complex because it means that the constraining parent cannot be
31800>>>>>                                        // reloaded. In such a case you probably should not be in the view at all and
31800>>>>>                                        // should navigate back
31800>>>>>                                        Move hoDD to hoRefindError
31801>>>>>                                        Move retCannotRereadConstrainingParent to eRefindError
31802>>>>>                                    End
31802>>>>>>
31802>>>>>                                End
31802>>>>>>
31802>>>>>                            End
31802>>>>>>
31802>>>>>                        End
31802>>>>>>
31802>>>>>                        If (hoRefindError=0) Begin
31804>>>>>                            If (IsNullRowID(ri)) Begin
31806>>>>>                                // Assume Create New Record
31806>>>>>                                Send Clear to hoDD
31807>>>>>                            End
31807>>>>>>
31807>>>>>                            Else Begin
31808>>>>>                                // Load up the selected rowID
31808>>>>>                                Get FindByRowIdEx of hoDD NavigateData.iTable ri to bSuccess
31809>>>>>                                If not bSuccess Begin
31811>>>>>                                    // this is quite unlikely
31811>>>>>                                    Send Clear of hoDD // this will leave the zoom cleared
31812>>>>>                                    Move hoDD to hoRefindError
31813>>>>>                                    Move retCannotRereadMain to eRefindError
31814>>>>>                                End
31814>>>>>>
31814>>>>>                            End
31814>>>>>>
31814>>>>>                        End
31814>>>>>>
31814>>>>>                    End
31814>>>>>>
31814>>>>>                    // else... if vtSelect the test below will catch this for any non cancel
31814>>>>>                    //         vtSelect. That way we catch hoDD=0 cases and nfundefined.
31814>>>>>                End
31814>>>>>>
31814>>>>>            End
31814>>>>>>
31814>>>>>
31814>>>>>            // This handles all select and weblist closes.        
31814>>>>>            // We do this for all view types because a zoom might contain a list
31814>>>>>            // If there is a missing hoDD or ri is null it will do a refresh of whatever
31814>>>>>            // is in the DD. If there is a rowid, it will refind around that.
31814>>>>>            Broadcast Recursive Send RefreshListForBackNavigation bCancel hoDD ri
31816>>>>>            
31816>>>>>        End
31816>>>>>>
31816>>>>>        // cancel
31816>>>>>        Else Begin
31817>>>>>            
31817>>>>>            // case of a cancel going back one level
31817>>>>>            If (Self = hoInvokingView) Begin
31819>>>>>                // This handles all select and weblist cancels.        
31819>>>>>                // We do this for all view types because a zoom might contain a list
31819>>>>>                Broadcast Recursive Send RefreshListForBackNavigation bCancel 0 (NullRowID())
31821>>>>>            End
31821>>>>>>
31821>>>>>            // if going back multiple levels, we don't do an update on the list because the list is not in scope. 
31821>>>>>            // Currently we are choosing not to  incur the overhead of extra roundtrip for a multi-level cancel.
31821>>>>>        End
31821>>>>>>
31821>>>>>            
31821>>>>>        
31821>>>>>        If hoInvokingObject Begin
31823>>>>>            Send ConditionalFocus of hoInvokingObject
31824>>>>>        End            
31824>>>>>>
31824>>>>>
31824>>>>>        //  Update the URL      
31824>>>>>        Send UpdateStateHash False
31825>>>>>        Send UpdatePageTitle
31826>>>>>        
31826>>>>>        //  We are done navigating now
31826>>>>>        Set pbNavigating to False
31827>>>>>
31827>>>>>        If (hoRefindError) Begin
31829>>>>>            // last thing that happens, you can do whatever
31829>>>>>            Send OnNavigateBackRefindError hoConstrainingParent eRefindError
31830>>>>>        End
31830>>>>>>
31830>>>>>        Else If (not(bCancel)) Begin
31833>>>>>        
31833>>>>>            // this is the object within the invoking view that called this
31833>>>>>            If (hoInvokingObject and hoCallback) Begin
31835>>>>>                // We are now the focus. You can use this to customize the update
31835>>>>>                // of to do another navigation 
31835>>>>>                Send OnNavigateBack of hoInvokingObject hoCallback NavigateData
31836>>>>>            End
31836>>>>>>
31836>>>>>        End
31836>>>>>>
31836>>>>>    End_Procedure
31837>>>>>    
31837>>>>>    //  Published procedure called by the client when it gets the navigateToClient client-action. 
31837>>>>>    //  This is done when navigating back multiple levels and the view we are navigating too was 
31837>>>>>    //  not synchronized. When this procedure is called the current view and the top view are both
31837>>>>>    //  being synchronized.
31837>>>>>    Procedure NavigateBackToHere_Callback Boolean bCancel Boolean bCallback String sCallback
31839>>>>>        tWebValueTree VT
31839>>>>>        tWebValueTree VT
31839>>>>>        tWebNavigateData NavigateData
31839>>>>>        tWebNavigateData NavigateData
31839>>>>>        Handle hoCallback
31839>>>>>        
31839>>>>>        Get ptActionData to VT
31840>>>>>        ValueTreeDeserializeParameter VT to NavigateData
31841>>>>>        
31841>>>>>        If (bCallback) Begin
31843>>>>>            Get WebObjectByName sCallback to hoCallback
31844>>>>>        End
31844>>>>>>
31844>>>>>        
31844>>>>>        Send NavigateBackToHereExec NavigateData bCancel hoCallback
31845>>>>>        
31845>>>>>    End_Procedure
31846>>>>>    
31846>>>>>    // determine the navigateFrom type based on the view being activated (self) and the
31846>>>>>    // invoking view and object (passed)
31846>>>>>    Function DetermineNavigateFromType Handle hoInvokingView Handle hoInvokingObject Handle ByRef iNavigateFile Returns Integer
31848>>>>>        Handle hoInvokingDD hoMainDD hoDDO
31848>>>>>        Integer iInvokingFile iMainFile
31848>>>>>        Integer iServers iServer iServerFile
31848>>>>>        Boolean bDataBindable
31848>>>>>        Move 0 to iNavigateFile
31849>>>>>        
31849>>>>>        If (hoInvokingView) Begin
31851>>>>>            
31851>>>>>            If (hoInvokingObject) Begin
31853>>>>>                Get Server of hoInvokingObject to hoInvokingDD
31854>>>>>            End
31854>>>>>>
31854>>>>>            Else Begin
31855>>>>>                Get Server of hoInvokingView to hoInvokingDD
31856>>>>>            End
31856>>>>>>
31856>>>>>            
31856>>>>>            Get Server to hoMainDD
31857>>>>>            
31857>>>>>            If (hoInvokingDD and hoMainDD) Begin
31859>>>>>                Get Main_File of hoInvokingDD to iInvokingFile
31860>>>>>                Get Main_File of hoMainDD to iMainFile
31861>>>>>                
31861>>>>>                If (iInvokingFile = iMainFile) Begin
31863>>>>>                    Move iMainFile to iNavigateFile
31864>>>>>                    Function_Return nfFromMain
31865>>>>>                End
31865>>>>>>
31865>>>>>                Else If ( Which_Data_Set(hoInvokingDD, iMainFile)) Begin
31868>>>>>                    Move iMainFile to iNavigateFile
31869>>>>>                    Function_Return nfFromChild
31870>>>>>                End
31870>>>>>>
31870>>>>>                Else Begin
31871>>>>>                    Get Data_Set_Server_Count of hoMainDD to iServers
31872>>>>>                    For iServer from 0 to (iServers-1)
31878>>>>>>
31878>>>>>                        Get Data_Set_Server of hoMainDD iServer to hoDDO
31879>>>>>                        Get Main_File of hoDDO to iServerFile
31880>>>>>                        If (iInvokingFile = iServerFile) Begin
31882>>>>>                            Move iInvokingFile to iNavigateFile
31883>>>>>                            Function_Return nfFromParent
31884>>>>>                        End
31884>>>>>>
31884>>>>>                    Loop
31885>>>>>>
31885>>>>>                End
31885>>>>>>
31885>>>>>            End
31885>>>>>>
31885>>>>>        End
31885>>>>>>
31885>>>>>        Function_Return nfUndefined
31886>>>>>    End_Function
31887>>>>>    
31887>>>>>    // Send this to navigate to the target view and add it to the view stack.
31887>>>>>    //
31887>>>>>    // eNavigateType - The Navigate From Type (i.e. nfFromMain, nfFromParent, etc)
31887>>>>>    // hoInvokingObject - This is the control in the "from view" that will populate the Navigate Data.
31887>>>>>    //                    The navigate data describes the role this view will play. Typically you will
31887>>>>>    //                    pass the object handle of the control that called NavigateForward.
31887>>>>>    //                    This control must understand the GetNavigateForwardData callback message.
31887>>>>>    Procedure NavigateForward Handle hoInvokingObject
31889>>>>>        Handle hoInvokingView hoTestInvokingObject
31889>>>>>        tWebNavigateData NavigateData
31889>>>>>        tWebNavigateData NavigateData
31889>>>>>        Integer iExpectedTable eNavigateType// eAppStateMode eTestNavType iTestTable
31889>>>>>        
31889>>>>>        // temporary for conversion. This will raise an error for older style NavigateFoward
31889>>>>>        // which passed two arguments. 
31889>>>>>        If (num_arguments<>1) Begin
31891>>>>>            Error DFERR_PROGRAM "NavigateForward has wrong number of parameters. Probably old style call"
31892>>>>>>
31892>>>>>            Procedure_Return
31893>>>>>        End
31893>>>>>>
31893>>>>>        
31893>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
31894>>>>>        
31894>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForward
31895>>>>>    End_Procedure
31896>>>>>
31896>>>>>    // Just like NavigateForward but it always makes this an nfUndefined navigation. This provides a way
31896>>>>>    // for developers to perform a custom forward navigation (nfUndefined) when the natural navigation would be
31896>>>>>    // some other navigation. When doing a custom navigation, the only option is nfUndefined because allowing a 
31896>>>>>    // developer to assign any other navigate-from type when it is not what is expected will probably not work.
31896>>>>>    // Note that the NavigateData data can be further customized in OnGetNavigateForwardData
31896>>>>>    // this is for advanced use - normally NavigateForward is used.
31896>>>>>    Procedure NavigateForwardCustom Handle hoInvokingObject
31898>>>>>        tWebNavigateData NavigateData
31898>>>>>        tWebNavigateData NavigateData
31898>>>>>        
31898>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" initStateDefault to NavigateData.NamedValues
31899>>>>>        
31899>>>>>        Send NavigateForward2 hoInvokingObject NavigateData ntNavigateForwardCustom
31900>>>>>    End_Procedure
31901>>>>>    
31901>>>>>    
31901>>>>>    // Navigates into this view when restoring a state. This means that most likely the view will 
31901>>>>>    // not be shown but is just initialzed to correct the view stack. The view will be loaded to 
31901>>>>>    // the client asynchronously to optimize performance.
31901>>>>>    //
31901>>>>>    // Params:
31901>>>>>    //      bTopView    If true this is the topmost view that will be displayed.
31901>>>>>    //      sMainId     Record ID of the main DD (from the state hash).
31901>>>>>    //      sStateHash  The full state hash for this view.
31901>>>>>    // Returns:
31901>>>>>    //      False if the main ID is not a valid record.
31901>>>>>    Function NavigateInitialize Handle hoInvokingObject Boolean bTopView String sStateHash Integer eNavMode Returns Boolean
31903>>>>>        tWebNavigateData NavigateData
31903>>>>>        tWebNavigateData NavigateData
31903>>>>>        Handle hoInvokingView hoMainDD
31903>>>>>        RowID rRowId
31903>>>>>        Boolean bFound bSuccess bIsDynamic
31903>>>>>        
31903>>>>>        
31903>>>>>        // Add extra properties used during initialization
31903>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_Mode" (If(bTopView, initStateReinitializeTopView, initStateReinitialize)) to NavigateData.NamedValues
31904>>>>>        Get NamedValueAdd NavigateData.NamedValues "Init_StateHash" sStateHash to NavigateData.NamedValues
31905>>>>>        
31905>>>>>        // Get into the standard initialization
31905>>>>>        Set pbNavReinitError to False
31906>>>>>        Send NavigateForward2 hoInvokingObject NavigateData eNavMode
31907>>>>>        Get pbNavReinitError to bSuccess
31908>>>>>        Move (not(bSuccess)) to bSuccess
31909>>>>>        
31909>>>>>        Function_Return bSuccess
31910>>>>>    End_Function
31911>>>>>    
31911>>>>>    // Reads the record id from the statehash and puts it in the NavigateData struct, this is called during 
31911>>>>>    // the forward navigation (only for NavigateInitialize).
31911>>>>>    //
31911>>>>>    // Params:
31911>>>>>    //      NavigateData    Byreference navigationdata struct (so it can be altered).
31911>>>>>    Procedure NavigateInitializeUpdateRowId tWebNavigateData ByRef NavigateData
31913>>>>>        String sHash sMainId sView sCustom
31913>>>>>        Integer eStateMode iTable
31913>>>>>        Handle hoMainDD
31913>>>>>        RowID rRowID
31913>>>>>        Boolean bSuccess
31913>>>>>        
31913>>>>>        Get peStateMode to eStateMode
31914>>>>>        Get Main_DD to hoMainDD
31915>>>>>        
31915>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_StateHash" to sHash
31916>>>>>        Send ParseViewStateHash of (Host(Self)) sHash (&sView) (&sMainId) (&sCustom)
31917>>>>>        
31917>>>>>        // Set rowid from the state hash
31917>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
31919>>>>>            If (hoMainDD <> 0) Begin
31921>>>>>                Move (Main_File(hoMainDD)) to iTable
31922>>>>>                Get HashRecordIdToRowId iTable sMainId (&rRowId) to bSuccess
31923>>>>>                If (bSuccess) Begin
31925>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
31926>>>>>                    Move iTable to  NavigateData.iTable
31927>>>>>                    // Keep new-record state when the state hash contains the configured new-record id.
31927>>>>>                    Move (Lowercase(sMainId) = Lowercase(psStateNewRecordId(Self))) to NavigateData.bNewRecord
31928>>>>>                End
31928>>>>>>
31928>>>>>                Else Begin
31929>>>>>                    Set pbNavReinitError to True
31930>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
31932>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
31933>>>>>>
31933>>>>>                    End
31933>>>>>>
31933>>>>>                End
31933>>>>>>
31933>>>>>            End
31933>>>>>>
31933>>>>>        End
31933>>>>>>
31933>>>>>        Else If (eStateMode = vsmDefault) Begin
31936>>>>>            If (NavigateData.iTable > 0) Begin
31938>>>>>                Get HashRecordIdToRowId NavigateData.iTable sMainId (&rRowId) to bSuccess
31939>>>>>                If (bSuccess) Begin
31941>>>>>                    Move (SerializeRowID(rRowId)) to NavigateData.sRowID
31942>>>>>                End
31942>>>>>>
31942>>>>>                Else Begin
31943>>>>>                    Set pbNavReinitError to True
31944>>>>>                    If (pbStateHashInvalidError(Host(Self))) Begin
31946>>>>>                        Error DFERR_WEBAPP_INVALID_URL_REC
31947>>>>>>
31947>>>>>                    End
31947>>>>>>
31947>>>>>                End
31947>>>>>>
31947>>>>>            End
31947>>>>>>
31947>>>>>        End
31947>>>>>>
31947>>>>>    End_Procedure
31948>>>>>    
31948>>>>>    // Determines if this view needs to be reininitialized when restoring the state looking at the
31948>>>>>    // record id.
31948>>>>>    //
31948>>>>>    // Params:
31948>>>>>    //      sExpectedMainId     Record ID of the main table navigation table to compare to record buffer.
31948>>>>>    Function NeedReinitialize String sExpectedMainId Returns Boolean
31950>>>>>        tWebNavigateData navData
31950>>>>>        tWebNavigateData navData
31950>>>>>        Integer eStateMode
31950>>>>>        Handle hoMainDD
31950>>>>>        RowID rRowId
31950>>>>>        Boolean bValid
31950>>>>>        
31950>>>>>        Get peStateMode to eStateMode
31951>>>>>        Get Main_DD to hoMainDD
31952>>>>>        
31952>>>>>        If ((peViewType(Self) = vtZoom and eStateMode = vsmDefault) or eStateMode = vsmRecord) Begin
31954>>>>>            Get GetNavigateData to navData
31955>>>>>            
31955>>>>>            If (hoMainDD <> 0) Begin
31957>>>>>                If (sExpectedMainId <> "" ) Begin    
31959>>>>>                    Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
31960>>>>>                    If (bValid and IsSameRowID(rRowId, CurrentRowId(hoMainDD))) Begin
31962>>>>>                        Function_Return False
31963>>>>>                    End
31963>>>>>>
31963>>>>>                End
31963>>>>>>
31963>>>>>                Else If (navData.bNewRecord and not(HasRecord(hoMainDD))) Begin
31966>>>>>                    Function_Return False
31967>>>>>                End
31967>>>>>>
31967>>>>>            End
31967>>>>>>
31967>>>>>            Else Begin
31968>>>>>                Function_Return False
31969>>>>>            End
31969>>>>>>
31969>>>>>        End
31969>>>>>>
31969>>>>>        Else If (eStateMode = vsmDefault) Begin
31972>>>>>            Get GetNavigateData to navData
31973>>>>>            
31973>>>>>            If (navData.iTable > 0) Begin
31975>>>>>                Get HashRecordIdToRowId (navData.iTable) sExpectedMainId (&rRowId) to bValid
31976>>>>>                If (bValid and navData.sRowID = SerializeRowID(rRowId)) Begin
31978>>>>>                    Function_Return False
31979>>>>>                End
31979>>>>>>
31979>>>>>            End
31979>>>>>>
31979>>>>>            
31979>>>>>            If (navData.eNavigateType = nfUndefined) Begin
31981>>>>>                Function_Return False
31982>>>>>            End
31982>>>>>>
31982>>>>>        End
31982>>>>>>
31982>>>>>        
31982>>>>>        Function_Return True
31983>>>>>    End_Function
