36062>>>    // Gets the value of a URL parameter based on its name. It parses the URL to determine the 
36062>>>    // parameters that are sent and returns the value of the requested parameter ("" if not found).
36062>>>    Function UrlParameter String sName Returns String
36064>>>        Integer iPos iPos2 iVoid
36064>>>        String sUrl
36064>>>        WString wsUnescape
36064>>>        
36064>>>        //  Get the URL from the HTTP header
36064>>>        Get ServerVariable of (ServiceDispatcher(Self)) "HTTP_REFERER" to sUrl
36065>>>        
36065>>>        If (Trim(sUrl) <> "") Begin
36067>>>            //  Find ? indicating GET parameters
36067>>>            Move (Pos("?", sUrl)) to iPos
36068>>>            If (iPos > 0) Begin
36070>>>                
36070>>>                Move (Uppercase(sName)) to sName
36071>>>
36071>>>                //  Loop over GET parameters
36071>>>                Repeat
36071>>>>
36071>>>                    //  Determine position of the name
36071>>>                    Increment iPos  //  Step over the ? or &
36072>>>                    Move (Pos("=", sUrl, iPos)) to iPos2
36073>>>                    
36073>>>                    //  Check the name
36073>>>                    Move (Mid(sURl, iPos2 - iPos, iPos)) to wsUnescape
36074>>>                    If (SizeOfWString(wsUnescape) > 0) Begin
36076>>>                        Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
36077>>>                    End
36077>>>>
36077>>>                    If (Uppercase(CString(wsUnescape)) = sName) Begin
36079>>>                        
36079>>>                        //  Determine position of the value
36079>>>                        Increment iPos2 //  Step over the =
36080>>>                        Move (Pos("&", sUrl, iPos2)) to iPos
36081>>>                        
36081>>>                        If (iPos > 0) Begin
36083>>>                            Move (Mid(sUrl, iPos - iPos2, iPos2)) to wsUnescape
36084>>>                        End
36084>>>>
36084>>>                        Else Begin
36085>>>                            Move ((Mid(sUrl, (Length(sUrl) - iPos2 + 1), iPos2))) to wsUnescape
36086>>>                        End
36086>>>>
36086>>>                        If (SizeOfWString(wsUnescape) > 0) Begin
36088>>>                            Move (UrlUnescapeW(AddressOf(wsUnescape), 0, 0, URL_UNESCAPE_INPLACE ior URL_UNESCAPE_AS_UTF8)) to iVoid
36089>>>                        End
36089>>>>
36089>>>                        Function_Return (CString(wsUnescape))
36090>>>                    End
36090>>>>
36090>>>                    
36090>>>                    Move (Pos("&", sUrl, iPos2)) to iPos
36091>>>                Until (not(iPos > 0)) 
36093>>>                
36093>>>            End
36093>>>>
36093>>>        End
36093>>>>
36093>>>        
36093>>>        Function_Return ""
36094>>>    End_Function
