28898>>>>>>>>>>>    Function StrSplitToArrayUnescapedWithTrim String sStr String sDel Returns String[]
28900>>>>>>>>>>>        Integer iCounter iLast iLength iDelLength iEscapedLength
28900>>>>>>>>>>>        String sEscapedDel
28900>>>>>>>>>>>        String[] aValues
28901>>>>>>>>>>>        
28901>>>>>>>>>>>        Move 1 to iLast
28902>>>>>>>>>>>        Move (Length(sStr)) to iLength
28903>>>>>>>>>>>        Move (Length(sDel)) to iDelLength
28904>>>>>>>>>>>        Move ("\" + sDel) to sEscapedDel
28905>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
28906>>>>>>>>>>>        
28906>>>>>>>>>>>        If (iLength = 0) Begin
28908>>>>>>>>>>>             Function_Return aValues
28909>>>>>>>>>>>        End
28909>>>>>>>>>>>>
28909>>>>>>>>>>>        
28909>>>>>>>>>>>        For iCounter from 1 to iLength
28915>>>>>>>>>>>>
28915>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sDel and ;                Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
28917>>>>>>>>>>>                Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
28918>>>>>>>>>>>                Move (iCounter + 1) to iLast
28919>>>>>>>>>>>            End
28919>>>>>>>>>>>>
28919>>>>>>>>>>>        Loop
28920>>>>>>>>>>>>
28920>>>>>>>>>>>        Move (Trim(Replaces(sEscapedDel, Mid(sStr, iCounter - iLast, iLast), sDel))) to aValues[SizeOfArray(aValues)]
28921>>>>>>>>>>>        Function_Return aValues
28922>>>>>>>>>>>    End_Function
28923>>>>>>>>>>>    
28923>>>>>>>>>>>    Function StrReplacesUnescaped String sReplace String sStr String sWith Returns String
28925>>>>>>>>>>>        Integer iCounter iLast iDelLength iEscapedLength
28925>>>>>>>>>>>        String sEscapedDel sPre sPost
28925>>>>>>>>>>>        
28925>>>>>>>>>>>        Move 1 to iLast
28926>>>>>>>>>>>        Move (Length(sReplace)) to iDelLength
28927>>>>>>>>>>>        Move ("\" + sReplace) to sEscapedDel
28928>>>>>>>>>>>        Move (Length(sEscapedDel)) to iEscapedLength
28929>>>>>>>>>>>        
28929>>>>>>>>>>>        If ((Length(sStr)) = 0) Begin
28931>>>>>>>>>>>            Function_Return sStr
28932>>>>>>>>>>>        End
28932>>>>>>>>>>>>
28932>>>>>>>>>>>        
28932>>>>>>>>>>>        While (iCounter <= Length(sStr))
28936>>>>>>>>>>>            If (Mid(sStr, iDelLength, iCounter) = sReplace and Mid(sStr, iEscapedLength, iCounter - 1) <> sEscapedDel) Begin
28938>>>>>>>>>>>                Move (Left(sStr, iCounter - iDelLength) + sWith + Mid(sStr, (Length(sStr)) - iCounter, iCounter + 1)) to sStr
28939>>>>>>>>>>>                Move (iCounter + iEscapedLength - 1) to iCounter
28940>>>>>>>>>>>                Move (iCounter + 1) to iLast
28941>>>>>>>>>>>            End
28941>>>>>>>>>>>>
28941>>>>>>>>>>>            Increment iCounter
28942>>>>>>>>>>>        Loop
28943>>>>>>>>>>>>
28943>>>>>>>>>>>        Function_Return sStr
28944>>>>>>>>>>>    End_Function
