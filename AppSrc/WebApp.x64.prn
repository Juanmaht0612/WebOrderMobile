35666>>>>>>>    
35666>>>>>>>    // This is the Error_Report for non AJAX style applications. This could be 
35666>>>>>>>    // Web Service, HTTP Handler, ASP or old style webapps. We've copied it here
35666>>>>>>>    // rather than trying to integrate it directly into Error_Report. It gets called by
35666>>>>>>>    // Error_Report as needed.
35666>>>>>>>    Procedure BasicErrorReport Integer iError Integer iLine String ErrMsg
35668>>>>>>>        String sSystemErr sMess sLabel sFile sDtl sFullError
35668>>>>>>>        String sStack sSystemAndStack
35668>>>>>>>        Integer iErrFile iErrField
35668>>>>>>>        Boolean bCritical bQueueErrors bLogAllErrors bLocal bHtmlErrors
35668>>>>>>>        Handle hoInetSession
35668>>>>>>>        Boolean bUnhandledSupport
35668>>>>>>>        Boolean bDebugging bTrapped
35668>>>>>>>        Integer iSrc iTxtlen
35668>>>>>>>        String sCaption
35668>>>>>>>
35668>>>>>>>        
35668>>>>>>>        Get phoInetSession to hoInetSession // this may or may not be set yet.
35669>>>>>>>        
35669>>>>>>>        Get IsCritical iError to bCritical
35670>>>>>>>        Get pbUnhandledErrorSupport to bUnhandledSupport
35671>>>>>>>        Move (IsDebuggerPresent()) to bDebugging
35672>>>>>>>        
35672>>>>>>>        // if an operator error this may be a Procedure UserError situation where the
35672>>>>>>>        // caption is passed in the error text. This handler does not support setting the caption so we just remove it.
35672>>>>>>>        // The ajax superclass handler will support this
35672>>>>>>>        If (iError=DFERR_OPERATOR) Begin
35674>>>>>>>            Move (pos(C_ErrorCaption,ErrMsg)) to iSrc
35675>>>>>>>            If iSrc Begin
35677>>>>>>>                Move (length(C_ErrorCaption)) to  iTxtLen
35678>>>>>>>                Move (remove(ErrMsg, 1, iSrc-1 + iTxtLen )) to sCaption // will not get used here
35679>>>>>>>                Move (Left(ErrMsg,iSrc-1)) to ErrMsg
35680>>>>>>>            End
35680>>>>>>>>
35680>>>>>>>        End
35680>>>>>>>>
35680>>>>>>>        
35680>>>>>>>        Get Error_Description iError ErrMsg  to sSystemErr
35681>>>>>>>        
35681>>>>>>>        // if the error source is identified we can get extended error
35681>>>>>>>        // text for our error message. This capability is a standard part
35681>>>>>>>        // of VDF5
35681>>>>>>>        If ghoErrorSource Begin
35683>>>>>>>            // These messages were just added to the DD.
35683>>>>>>>            Get Extended_Error_file   of ghoErrorSource to iErrFile
35684>>>>>>>            Get Extended_Error_Field  of ghoErrorSource to iErrField
35685>>>>>>>            // we are making the assumption that ghoErrorSource is a DD object
35685>>>>>>>            // If it is not, we will have problems.....but it will be!
35685>>>>>>>            If (iErrFile>0) Begin
35687>>>>>>>                Get_Attribute DF_FILE_DISPLAY_NAME of iErrFile to sFile
35690>>>>>>>                If (iErrField>0) Begin
35692>>>>>>>                    Get File_Field_Label of ghoErrorSource iErrFile iErrField DD_LABEL_LONG to sLabel
35693>>>>>>>                    Move (SFormat(C_$FieldInDataFile,sLabel, sFile)) to sMess
35694>>>>>>>                End
35694>>>>>>>>
35694>>>>>>>                Else Begin
35695>>>>>>>                    Move (SFormat(C_$InDataFile,sFile)) to sMess
35696>>>>>>>                End
35696>>>>>>>>
35696>>>>>>>                Append sSystemErr "\n" sMess
35698>>>>>>>            End
35698>>>>>>>>
35698>>>>>>>        End
35698>>>>>>>>
35698>>>>>>>        
35698>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iError, iLine)) to sDtl
35699>>>>>>>        If (iErrFile  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iErrFile))  to sDtl
35702>>>>>>>        If (iErrField > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iErrField)) to sDtl
35705>>>>>>>        // full error is systemError + Error and line numbers
35705>>>>>>>        Move (sSystemErr + "\n" + sDtl) to sFullError
35706>>>>>>>        
35706>>>>>>>        // If 0, the COM object is not yet ready to be used. If an error occurs in this
35706>>>>>>>        // condition, we consider this error to always be fatal and will notify WebApp
35706>>>>>>>        // Server of this error via WebAppFatalError command
35706>>>>>>>        If (hoInetSession=0) Begin
35708>>>>>>>            
35708>>>>>>>            If bDebugging Begin
35710>>>>>>>                Send UnhandledErrorDisplay iLine sFullError
35711>>>>>>>            End
35711>>>>>>>>
35711>>>>>>>            Else Begin
35712>>>>>>>                CallStackDump sStack
35713>>>>>>>                WebAppFatalError (Replaces("\n", (sFullError + "\n\n" + sStack) , character(13)+character(10)))
35714>>>>>>>                // we only arrive here if WebApp cannot handle the error. All we can
35714>>>>>>>                // do is abort.
35714>>>>>>>                //Send MessageBoxError sFullError 1 // might be useful for VDF debugging, but cannot be used on server
35714>>>>>>>            End
35714>>>>>>>>
35714>>>>>>>            Abort
35715>>>>>>>>
35715>>>>>>>        End
35715>>>>>>>>
35715>>>>>>>        Else Begin
35716>>>>>>>            
35716>>>>>>>            Get pbAllErrorstoLocal    of hoInetSession to bLocal
35717>>>>>>>            Get pbQueueErrors         of hoInetSession to bQueueErrors
35718>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bLogAllErrors
35719>>>>>>>            Get pbAllErrorsToHtml     of hoInetSession to bHtmlErrors
35720>>>>>>>            
35720>>>>>>>            // If error is critical, we cannot go on.
35720>>>>>>>            If bCritical Begin
35722>>>>>>>                CallStackDump sStack
35723>>>>>>>                Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
35724>>>>>>>                Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
35725>>>>>>>                Send ReportCriticalError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
35726>>>>>>>                
35726>>>>>>>                // also attempt to send message to client (html browser)
35726>>>>>>>                If bHtmlErrors Begin
35728>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
35728>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
35728>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
35728>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
35729>>>>>>>                End
35729>>>>>>>>
35729>>>>>>>                
35729>>>>>>>                // if we are passing errors to VDF console, report the error
35729>>>>>>>                // if we we debugging, thereis no point in doing this
35729>>>>>>>                If (not(bDebugging) and bLocal) Begin
35731>>>>>>>                    Send MessageBoxError (sFullError + "\n\n" + sStack) // 1 means critical
35732>>>>>>>                End
35732>>>>>>>>
35732>>>>>>>                
35732>>>>>>>                // log the critical error to the event log
35732>>>>>>>                // if debugging, this can be an unhandled error
35732>>>>>>>                If bDebugging Begin
35734>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
35735>>>>>>>                End
35735>>>>>>>>
35735>>>>>>>                Else Begin
35736>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack  iLine iErrFile iErrField
35737>>>>>>>                    Send ReportErrorEvent to hoInetSession iError C_$CriticalErrorProgramHalted iLine 0 0
35738>>>>>>>                End
35738>>>>>>>>
35738>>>>>>>                // and end it all
35738>>>>>>>                Abort
35739>>>>>>>>
35739>>>>>>>            End
35739>>>>>>>>
35739>>>>>>>            
35739>>>>>>>            // if we are passing errors to VDF console, report the error
35739>>>>>>>            If bLocal Begin
35741>>>>>>>                Send MessageBoxError sFullError 0 // 0 means non-critical
35742>>>>>>>            End
35742>>>>>>>>
35742>>>>>>>            
35742>>>>>>>            // we make the following assumptions:
35742>>>>>>>            // If errors are queue
35742>>>>>>>            //    We assume the error is expected, and controlled
35742>>>>>>>            //    Write error to queue
35742>>>>>>>            //    Ddo not write to Event Log unless we are logging all errors.
35742>>>>>>>            //
35742>>>>>>>            // if errors are not queued
35742>>>>>>>            //    We assume the error is unexpected, and must be controlled
35742>>>>>>>            //    Display HTML error to browser unless this is disabled
35742>>>>>>>            //    Send to the event log (under the assumption that the error is unexpected).
35742>>>>>>>            CallStackDump sStack
35743>>>>>>>            Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
35744>>>>>>>            Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
35745>>>>>>>                
35745>>>>>>>            If bQueueErrors Begin
35747>>>>>>>                Send Set_Error iError sSystemErr sFullError iLine iErrFile iErrField
35748>>>>>>>                If bLogAllErrors Begin
35750>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
35751>>>>>>>                End
35751>>>>>>>>
35751>>>>>>>            End
35751>>>>>>>>
35751>>>>>>>            Else Begin
35752>>>>>>>                If bHtmlErrors Begin
35754>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
35754>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
35754>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
35754>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
35755>>>>>>>                End
35755>>>>>>>>
35755>>>>>>>                If bDebugging  Begin
35757>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
35758>>>>>>>                End
35758>>>>>>>>
35758>>>>>>>                Else Begin
35759>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
35760>>>>>>>                End
35760>>>>>>>>
35760>>>>>>>            End
35760>>>>>>>>
35760>>>>>>>        End
35760>>>>>>>>
35760>>>>>>>        
35760>>>>>>>        
35760>>>>>>>    End_Procedure
35761>>>>>>>
35761>>>>>>>    //  Is called by df on errors. It searches additional information and
35761>>>>>>>    //  saves the error. The main part of this is the error handler for AJAX framework
35761>>>>>>>    // applications If a basic or a legacy webapp, this Error is "forwarded" to BasicErrorReport.
35761>>>>>>>    //
35761>>>>>>>    Procedure HandleError Integer iErrNum Integer iErrLine String sErrText
35763>>>>>>>        String sSystemErr  sCaption  sExtErr
35763>>>>>>>        Boolean bUserError bDisplayControl
35763>>>>>>>        Boolean bOldAllErrorsToHtml bAllErrorstoEventLog bInRecording bTrapped
35763>>>>>>>        Integer iErrFile iErrField iSrc iTxtlen
35763>>>>>>>        Handle hoCurrentView hoTargetControl hoInetSession
35763>>>>>>>        
35763>>>>>>>                
35763>>>>>>>        Get phoInetSession to hoInetSession
35764>>>>>>>        Get pbInErrorRecording to bInRecording
35765>>>>>>>        
35765>>>>>>>        // This means is not happening during an AJAX style Request or it means that this is an
35765>>>>>>>        // old webapp style error. If hoInetSession is 0, it is fatal
35765>>>>>>>        If (not(bInRecording)) Begin
35767>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
35768>>>>>>>        End
35768>>>>>>>>
35768>>>>>>>        Else If (hoInetSession=0) Begin
35771>>>>>>>            // this should not be possible at this point.
35771>>>>>>>            // If it is, it's fatal and program will abort
35771>>>>>>>            Send BasicErrorReport iErrNum iErrLine sErrText
35772>>>>>>>            // will abort
35772>>>>>>>        End
35772>>>>>>>>
35772>>>>>>>        Else Begin
35773>>>>>>>            
35773>>>>>>>            // process an error that occurs during an AJAX Server request
35773>>>>>>>            
35773>>>>>>>            Move False to bDisplayControl
35774>>>>>>>            
35774>>>>>>>            // the caption normally used for handled user errors
35774>>>>>>>            Get psUserErrorCaption to sCaption
35775>>>>>>>            // if an operator error this may be a Procedure UserError situation where the
35775>>>>>>>            // caption is passed in the error text. If so, get the caption
35775>>>>>>>            If (iErrNum=DFERR_OPERATOR) Begin
35777>>>>>>>                Move (pos(C_ErrorCaption,sErrText)) to iSrc
35778>>>>>>>                If iSrc Begin
35780>>>>>>>                    Move (length(C_ErrorCaption)) to  iTxtLen
35781>>>>>>>                    Move (remove(sErrText, 1, iSrc-1 + iTxtLen )) to sCaption
35782>>>>>>>                    Move (Left(sErrText,iSrc-1)) to sErrText
35783>>>>>>>                End
35783>>>>>>>>
35783>>>>>>>            End
35783>>>>>>>>
35783>>>>>>>            
35783>>>>>>>            // Get the message....
35783>>>>>>>            Get Error_Description iErrNum sErrText to sSystemErr
35784>>>>>>>            
35784>>>>>>>            // Get file and field (of data dictionary error) if available
35784>>>>>>>            // and use this to determine the target control by searching
35784>>>>>>>            // for the first control with the same data binding....
35784>>>>>>>            If (ghoErrorSource <> 0) Begin
35786>>>>>>>                Get Extended_Error_file  of ghoErrorSource to iErrFile
35787>>>>>>>                Get Extended_Error_Field of ghoErrorSource to iErrField
35788>>>>>>>                
35788>>>>>>>                If (iErrFile > 0) Begin
35790>>>>>>>                    Get DetermineCurrentView to hoCurrentView
35791>>>>>>>                    Move False to bDisplayControl
35792>>>>>>>                    If (iErrField > 0 and hoCurrentView <> C_WebUnresolvedObject) Begin
35794>>>>>>>                        Get FirstControlWithDataBinding of hoCurrentView iErrFile iErrField to hoTargetControl
35795>>>>>>>                        
35795>>>>>>>                        If (hoTargetControl <> C_WebUnresolvedObject) Begin
35797>>>>>>>                            //  Try to display local error balloon
35797>>>>>>>                            Get ShowControlError of hoTargetControl iErrNum sSystemErr to bDisplayControl
35798>>>>>>>                        End
35798>>>>>>>>
35798>>>>>>>                    End
35798>>>>>>>>
35798>>>>>>>                    //  If no control found (or capable of showing errors) then we extend the error message with file and field name
35798>>>>>>>                    If (not(bDisplayControl)) Begin
35800>>>>>>>                        Get Extended_Error_Message of ghoErrorSource to sExtErr
35801>>>>>>>                        Move (sErrText + "\n" + sExtErr) to sErrText
35802>>>>>>>                        Move (sSystemErr + "\n" + sExtErr) to sSystemErr
35803>>>>>>>                        Move (Replaces("\n",sSystemErr,"\n\r")) to sSystemErr
35804>>>>>>>                    End
35804>>>>>>>>
35804>>>>>>>                End
35804>>>>>>>>
35804>>>>>>>            End
35804>>>>>>>>
35804>>>>>>>            
35804>>>>>>>            // Test if this is a user error or an unhandled error (i.e. "find past end of file")....
35804>>>>>>>            Get IsUserError iErrNum to bUserError
35805>>>>>>>            If not bUserError Begin
35807>>>>>>>                Get psUnhandledErrorCaption to sCaption
35808>>>>>>>            End
35808>>>>>>>>
35808>>>>>>>            
35808>>>>>>>            //  Forward the error to the webapp object (if not already handled by the contorl)
35808>>>>>>>            If (phoWebHost(Self) > 0) Begin
35810>>>>>>>                If (not(bDisplayControl)) Begin
35812>>>>>>>                    Send ShowError of (phoWebHost(Self)) iErrNum iErrLine sSystemErr sCaption bUserError
35813>>>>>>>                End
35813>>>>>>>>
35813>>>>>>>            End
35813>>>>>>>>
35813>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bAllErrorstoEventLog
35814>>>>>>>            If (not(bUserError) or bAllErrorstoEventLog) Begin
35816>>>>>>>                Send BasicErrorReport iErrNum iErrLine sErrText
35817>>>>>>>            End
35817>>>>>>>>
35817>>>>>>>        End
35817>>>>>>>>
35817>>>>>>>    End_Procedure
35818>>>>>>>    
35818>>>>>>>    // FinishRecording:
35818>>>>>>>    
35818>>>>>>>    // Stops fetching the error by resetting the origional error handler.
35818>>>>>>>    //
35818>>>>>>>    // Returns - Array with error structs of occurred errors
35818>>>>>>>    Procedure FinishRecording
35820>>>>>>>        Boolean bInErrorRecording
35820>>>>>>>        Get pbInErrorRecording to bInErrorRecording
35821>>>>>>>        If bInErrorRecording Begin
35823>>>>>>>            Set pbInErrorRecording to False
35824>>>>>>>        End
35824>>>>>>>>
35824>>>>>>>    End_Procedure
35825>>>>>>>    
35825>>>>>>>    
35825>>>>>>>    // Starts fetching the errors by setting this object as the error handler
35825>>>>>>>    // and clearing the error array.
35825>>>>>>>    Procedure StartRecording Handle hoHost
35827>>>>>>>        Boolean bInErrorRecording
35827>>>>>>>        
35827>>>>>>>        Get pbInErrorRecording to bInErrorRecording
35828>>>>>>>        If (not(bInErrorRecording)) Begin
35830>>>>>>>            Set pbInErrorRecording to True
35831>>>>>>>        End
35831>>>>>>>>
35831>>>>>>>        
35831>>>>>>>        Set phoWebHost to hoHost
35832>>>>>>>    End_Procedure
35833>>>>>>>    
35833>>>>>>>    
