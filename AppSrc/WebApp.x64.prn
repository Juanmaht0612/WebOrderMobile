20968>>>>>>>>>>>>>>>    //  Shows an info balloon next to the control (below or above) containing HTML.
20968>>>>>>>>>>>>>>>    //
20968>>>>>>>>>>>>>>>    //  Params:
20968>>>>>>>>>>>>>>>    //      sCssClass   CSS Classname applied to the info balloon for custom styling.
20968>>>>>>>>>>>>>>>    //      sText       The content of the info balloon (HTML).
20968>>>>>>>>>>>>>>>    //
20968>>>>>>>>>>>>>>>    Procedure ShowInfoBalloon String sCssClass String sText Boolean bOptShow
20970>>>>>>>>>>>>>>>        String[] aParams
20971>>>>>>>>>>>>>>>        
20971>>>>>>>>>>>>>>>        Move sCssClass      to aParams[0]
20972>>>>>>>>>>>>>>>        Move sText          to aParams[1]
20973>>>>>>>>>>>>>>>        If (num_arguments >= 3) Begin
20975>>>>>>>>>>>>>>>            Move bOptShow   to aParams[2]
20976>>>>>>>>>>>>>>>        End
20976>>>>>>>>>>>>>>>>
20976>>>>>>>>>>>>>>>        Else Begin
20977>>>>>>>>>>>>>>>            Move True       to aParams[2]
20978>>>>>>>>>>>>>>>        End
20978>>>>>>>>>>>>>>>>
20978>>>>>>>>>>>>>>>        
20978>>>>>>>>>>>>>>>        
20978>>>>>>>>>>>>>>>        Send ClientAction "showInfoBalloon" aParams
20979>>>>>>>>>>>>>>>    End_Procedure
