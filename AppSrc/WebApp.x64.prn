659>>>>>>>>>>>
659>>>>>>>>>>>// Unicode support, wide version of GetTextMetrics.
659>>>>>>>>>>>// NOTE: The referred TEXTMETRIC structure (lptm) is assumed to contain UTF16 characters for tmFirstChar, tmLastChar, tmDefaultChar and tmBreakChar.
659>>>>>>>>>>>External_Function GetTextMetrics "GetTextMetricsW" Gdi32.dll ;  Handle hdc ;  Pointer lptm ;   Returns Boolean  
660>>>>>>>>>>>
660>>>>>>>>>>>// When called directly, be sure to use WString types.
660>>>>>>>>>>>External_Function CreateFontIndirectW "CreateFontIndirectW" Gdi32.dll ;  Pointer lplf ;  Returns Handle
661>>>>>>>>>>>  
661>>>>>>>>>>>// Compatibility wrapper function CreateFontIndirect
661>>>>>>>>>>>Function CreateFontIndirect Global ;    Pointer lplf ;    Returns Handle
663>>>>>>>>>>>    
663>>>>>>>>>>>    // lplf is a pointer to a LogFont struct, which contains a UChar array.
663>>>>>>>>>>>    // This string must be converted to UTF-16 and afterwards back to UTF-8.
663>>>>>>>>>>>    Integer hResult iVoid
663>>>>>>>>>>>    Pointer pLogF pOrigLogF
663>>>>>>>>>>>    WString  wFaceName
663>>>>>>>>>>>    String sFaceName
663>>>>>>>>>>>    tWinLogFontW tLogF
663>>>>>>>>>>>    tWinLogFontW tLogF
663>>>>>>>>>>>    
663>>>>>>>>>>>    // Copy the struct to a local struct that can be modified to UTF-16.
663>>>>>>>>>>>    Move (AddressOf(tLogF)) to pLogF
664>>>>>>>>>>>    Move (CopyMemory(pLogF, lplf, SizeOfType(tWinLogFont))) to iVoid
665>>>>>>>>>>>    
665>>>>>>>>>>>    // lfFaceName is expected to be coming in as UTF-8 Char[]. 
665>>>>>>>>>>>    // Convert in place to UTF16 Short[] (be sure to terminate with zero).
665>>>>>>>>>>>    Move (PointerToString(AddressOf(tLogF.lfFaceName))) to sFaceName
666>>>>>>>>>>>    Append sFaceName (character(0))
667>>>>>>>>>>>    Move sFaceName to wFaceName
668>>>>>>>>>>>    Move (MemCopy(AddressOf(tLogF.lfFaceName), AddressOf(wFaceName), SizeOfWString(wFaceName) * 2)) to iVoid
669>>>>>>>>>>>    
669>>>>>>>>>>>    // Call the function using the local struct
669>>>>>>>>>>>    Move (CreateFontIndirectW(pLogF)) to hResult
670>>>>>>>>>>>    
670>>>>>>>>>>>    // Convert facename back to UTF-8 (in place).
670>>>>>>>>>>>    Move (PointerToWString(AddressOf(tLogF.lfFaceName))) to sFaceName
671>>>>>>>>>>>    // Extend string with 0 to the maximum number of characters
671>>>>>>>>>>>    If (SizeOfString(sFaceName)<LF_FACESIZE) ;        Append sFaceName (Repeat(Character(0), LF_FACESIZE - SizeOfString(sFaceName)))
674>>>>>>>>>>>    
674>>>>>>>>>>>    Move (MemCopy(AddressOf(tLogF.lfFaceName), AddressOf(sFaceName), SizeOfString(sFaceName))) to iVoid
675>>>>>>>>>>>
675>>>>>>>>>>>    // Copy the struct back to the incoming one
675>>>>>>>>>>>    Move (CopyMemory(lplf, pLogF, SizeOfType(tWinLogFont))) to iVoid
676>>>>>>>>>>>
676>>>>>>>>>>>    Function_Return hResult
677>>>>>>>>>>>End_Function
678>>>>>>>>>>>
678>>>>>>>>>>>// Returns the VDF physical_FontSize value for the primary screen device for the passed typeface & pointsize.
678>>>>>>>>>>>// This can be used to set the font size of a VDF control for any Font/Point Size.
678>>>>>>>>>>>Function PointSizeToPhysicalFontSize Global WString wTypeFace Integer iPointSize Returns Integer
680>>>>>>>>>>>    Integer iFontSize iLogPixelsY
680>>>>>>>>>>>    Number nFontSize
680>>>>>>>>>>>    Boolean bVoid bOK
680>>>>>>>>>>>    Handle hDC hFont hOldFont
680>>>>>>>>>>>    Pointer lpLogFont lptm
680>>>>>>>>>>>    tWinTextMetricW tm
680>>>>>>>>>>>    tWinTextMetricW tm
680>>>>>>>>>>>    tWinLogFontW ALogFont
680>>>>>>>>>>>    tWinLogFontW ALogFont
680>>>>>>>>>>>    
680>>>>>>>>>>>    // Convert Font point size to logical pixels....
680>>>>>>>>>>>    Move (GetDC(0)) to hDC
681>>>>>>>>>>>    Move (GetDeviceCaps(hDC, LOGPIXELSY)) to iLogPixelsY
682>>>>>>>>>>>    Move ((iPointSize * iLogPixelsY / 72.0) + 0.5) to nFontSize
683>>>>>>>>>>>    Move nFontSize to iFontSize    // nFontSize is rounded up, then we truncate it into iFontSize - this reduces rounding error due to integer truncation
684>>>>>>>>>>>    
684>>>>>>>>>>>    // Convert the TypeFace name from WString into a Short Array (WChar).
684>>>>>>>>>>>    Move (MemCopy(AddressOf(ALogFont.lfFaceName), AddressOf(wTypeFace), SizeOfWString(wTypeFace)*2+2)) to bOK
685>>>>>>>>>>>    
685>>>>>>>>>>>    // Convert Logical Pixels into physical pixels....
685>>>>>>>>>>>    Move (0-iFontSize) to ALogFont.lfHeight  // use -ve value to instruct system to scale font to device
686>>>>>>>>>>>    Move (AddressOf(ALogFont)) to lpLogFont
687>>>>>>>>>>>    
687>>>>>>>>>>>    Move (CreateFontIndirectW(lpLogFont)) to hFont   // Here we create the font
688>>>>>>>>>>>    Move (SelectObject(hDC, hFont)) to hOldFont     // Now we select it to the device context
689>>>>>>>>>>>    Move (AddressOf(tm)) to lptm
690>>>>>>>>>>>    Move (GetTextMetrics(hDC, lptm)) to bVoid       // Now we can get the font's text metrics
691>>>>>>>>>>>    
691>>>>>>>>>>>    Move (tm.tmHeight + tm.tmExternalLeading) to iFontSize   // Here is the font's physical size for this device
692>>>>>>>>>>>    
692>>>>>>>>>>>    Move (SelectObject(hDC, holdFont)) to hOldFont
693>>>>>>>>>>>    Move (DeleteObject(hFont)) to bVoid
694>>>>>>>>>>>    Move (ReleaseDC(0, hDC)) to hDC
695>>>>>>>>>>>    
695>>>>>>>>>>>    Function_Return iFontSize
696>>>>>>>>>>>End_Function
