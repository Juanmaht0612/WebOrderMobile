1054>>>>>>>>>>>External_Function MessageBox "MessageBoxW" User32.dll ;    Handle  hWndParent ;    WString lpText ;    WString lpCaption ;    DWord   wType ;    Returns Integer
1055>>>>>>>>>>>
1055>>>>>>>>>>>
1055>>>>>>>>>>>Function Message_Box Global String sMessage String sCaption ;        Integer Btns Integer Icon Returns Integer
1057>>>>>>>>>>>    Boolean bEnabled
1057>>>>>>>>>>>    Handle hWnd hwPrnt hwTest hwOwner
1057>>>>>>>>>>>    String IncorrectNewline
1057>>>>>>>>>>>    String szMessage szCaption
1057>>>>>>>>>>>    Integer rval iVoid Obj
1057>>>>>>>>>>>    
1057>>>>>>>>>>>    Move (Replaces("\n",sMessage,Character(13))) to sMessage
1058>>>>>>>>>>>    Move (sMessage +character(0)) to szMessage
1059>>>>>>>>>>>    
1059>>>>>>>>>>>    Move "" to IncorrectNewline
1060>>>>>>>>>>>    Append IncorrectNewline "\" (Character(13))
1062>>>>>>>>>>>    Move (Replaces(IncorrectNewline, szMessage, "\n")) to szMessage
1063>>>>>>>>>>>       
1063>>>>>>>>>>>    Move (sCaption +character(0)) to szCaption
1064>>>>>>>>>>>    
1064>>>>>>>>>>>    // 8.3 change. Global methods should not be using self. We will have message boxes use
1064>>>>>>>>>>>    // the focus as a starting point for looking for a container handle. (this was changed for 12.0 - see below)    
1064>>>>>>>>>>>    
1064>>>>>>>>>>>    Get Focus of desktop to Obj // start with the focus
1065>>>>>>>>>>>    Move (gOwnerWindowHandle(Obj)) to hWnd // global function finds the right handle for us
1066>>>>>>>>>>>    // If no main-window, use container_handle of focus. If no window handle, use MB_TASKMODAL. We don't always use this
1066>>>>>>>>>>>    // because it adds the message box to the caption bar.
1066>>>>>>>>>>>    Move (MessageBox (hWnd, szMessage, szCaption, Btns ior Icon ior If(hWnd=0,MB_TASKMODAL,0))) to rval
1067>>>>>>>>>>>    Function_Return rVal
1068>>>>>>>>>>>End_Function
