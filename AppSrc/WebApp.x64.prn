19322>>>>>
19322>>>>>
19322>>>>>// Singleton object that implements a library of methods that can be used for 
19322>>>>>// returning target cWebView, cWebControl or cWebApp handles from an object name
19322>>>>>// string.
19322>>>>>//
19322>>>>>// Only controls that implement the cWebControl_mixin interface can be located
19322>>>>>// with this object
19322>>>>>Class cWebControlLocator is a cObject
19323>>>>>    Procedure Construct_Object
19325>>>>>        Forward Send Construct_Object
19327>>>>>        
19327>>>>>        // Object Reference Arrays
19327>>>>>        
19327>>>>>        // These two arrays have synchronized members. This means that paWebControlNames
19327>>>>>        // can be searched to lookup the corresponding object handle.
19327>>>>>        Property tWebControlMapItem[] paWebControls
19328>>>>>        
19328>>>>>        Property Handle phoWebHost C_WebUnresolvedObject //    Handle to the host (cWebApp / cLocalWebControlHost)
19329>>>>>    End_Procedure
19330>>>>>
19330>>>>>    
19330>>>>>    // Analyses a partial object name of a cWebObject and returns the corresponding object handle.
19330>>>>>    // - The object name must be in the long name format, e.g. oCustomerView.oSaveButton
19330>>>>>    // - The object name must be a child of the global cWebApp object (note, this might also
19330>>>>>    //   be a child of a cWebView that is itself a child of the cWebApp).
19330>>>>>    // - The name of the cWebApp object is ommitted from the passed object name,
19330>>>>>    //   e.g. a reference "oCustomerView.oSaveButton" indicates a reference to oSaveButton
19330>>>>>    //   that is a child of oCustomerView that is a child of the object referenced by ghoWebApp.
19330>>>>>    // - If an empty string is passed as the object name, then that is considered a reference
19330>>>>>    //   to ghoWebApp.
19330>>>>>    // - Only objects that understand the cWebControl_mixin interface can be found.
19330>>>>>    // - If the object name cannot be resolved then this function returns C_WebUnresolvedObject.
19330>>>>>    Function FindWebObject String sObjectLongName Boolean bOptErr Returns Handle
19332>>>>>        String sContainer sDynamicObjectId
19332>>>>>        Integer iIndex
19332>>>>>        Handle hoControl hoContainer
19332>>>>>        tWebControlMapItem[] aItems
19332>>>>>        tWebControlMapItem[] aItems
19333>>>>>        tWebControlMapItem searchItem
19333>>>>>        tWebControlMapItem searchItem
19333>>>>>        
19333>>>>>        // First test for the global cWebApp object
19333>>>>>        If (sObjectLongName = "") Begin
19335>>>>>            Function_Return (phoWebHost(Self))
19336>>>>>        End
19336>>>>>>
19336>>>>>        
19336>>>>>        // Dynamic objects use a $ character to display the separation
19336>>>>>        // between the "static" container and its dynamic content.
19336>>>>>        If (sObjectLongName contains "$") Begin
19338>>>>>            Move (Pos("$", sObjectLongName)) to iIndex
19339>>>>>            Move (Left(sObjectLongName, iIndex - 1)) to sContainer
19340>>>>>            Move (Right(sObjectLongName, (Length(sObjectLongName) - iIndex))) to sDynamicObjectId
19341>>>>>            
19341>>>>>            // Find the container of the dynamic object
19341>>>>>            If (num_arguments > 1) ;                Get FindWebObject sContainer bOptErr to hoContainer
19344>>>>>            Else ;                Get FindWebObject sContainer to hoContainer
19346>>>>>            
19346>>>>>            // Redirect query to container      
19346>>>>>            Get OwnerFindWebObject of hoContainer sDynamicObjectId to hoControl
19347>>>>>
19347>>>>>            Function_Return hoControl
19348>>>>>        End
19348>>>>>>
19348>>>>>        
19348>>>>>        Get paWebControls to aItems
19349>>>>>        Move sObjectLongName to searchItem.sName
19350>>>>>        Move (BinarySearchArray(searchItem, aItems, False)) to iIndex
19351>>>>>        
19351>>>>>        If (iIndex = -1) Begin
19353>>>>>            Function_Return C_WebUnresolvedObject
19354>>>>>        End
19354>>>>>>
19354>>>>>        Else Begin
19355>>>>>            Function_Return (aItems[iIndex].hoObj)
19356>>>>>        End
19356>>>>>>
19356>>>>>    End_Function
19357>>>>>    
19357>>>>>    
19357>>>>>    //  Searches the requested webobject and checks if it is a valid webapp View.
19357>>>>>    //  Note: Self is also considered a valid target.
19357>>>>>    //
19357>>>>>    //  Returns:
19357>>>>>    //      Handle to the webapp view (C_WebUnresolvedObject if not a valid Ajax view)
19357>>>>>    //
19357>>>>>    Function GetAjaxWebAppView String sView Returns Handle
19359>>>>>        Function_Return (FindWebObject(Self, sView))
19360>>>>>    End_Function
