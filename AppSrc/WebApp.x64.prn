7655>>>>>    // augmented to trigger a radio group entering message, if the focus is
7655>>>>>    // coming from outside of the radio group
7655>>>>>    //
7655>>>>>    Procedure Entering Returns Integer
7657>>>>>        Integer iFail
7657>>>>>        Forward Get msg_entering to iFail
7659>>>>>        // we check if the focus is already a radio button, if it is not (-1)
7659>>>>>        // then we know we are entering from outside of radio group
7659>>>>>        If (iFail=0 and Radio_Object_Item(parent(Self),focus(desktop))=-1) ;            Delegate Get OnRadioGroupEntering to iFail
7663>>>>>        Procedure_Return iFail
