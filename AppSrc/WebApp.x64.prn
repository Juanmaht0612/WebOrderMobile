25032>>>>>>>//        Loop
25032>>>>>>>//        Function_Return hoShouldSaveViews
25032>>>>>>>//    End_Function
25032>>>>>>>
25032>>>>>>>
25032>>>>>>>    // Returns the view handle of the top of stack. Returns 0 if the Stack is empty.
25032>>>>>>>    // See also InvokingViewHandle.
25032>>>>>>>    Function TopViewHandle Returns Handle
25034>>>>>>>        Integer iTop
25034>>>>>>>        Handle hoView
25034>>>>>>>        tWebViewInfo[] aViewStack
25034>>>>>>>        tWebViewInfo[] aViewStack
25035>>>>>>>
25035>>>>>>>        // Update the stack
25035>>>>>>>        WebGet paViewStack to aViewStack
25036>>>>>>>        Move (SizeOfArray(aViewStack)) to iTop
25037>>>>>>>            
25037>>>>>>>        If (iTop = 0) Begin
25039>>>>>>>            Function_Return C_WebUnresolvedObject
25040>>>>>>>        End
25040>>>>>>>>
25040>>>>>>>        Else Begin
25041>>>>>>>            Get WebObjectByName aViewStack[iTop-1].sViewName to hoView
25042>>>>>>>            Function_Return hoView
25043>>>>>>>        End
25043>>>>>>>>
25043>>>>>>>    End_Function
25044>>>>>>>    
25044>>>>>>>    
25044>>>>>>>    // Updates the Should Save value of the top view in the view stack
25044>>>>>>>    Procedure UpdateShouldSave
25046>>>>>>>        Integer iTop
25046>>>>>>>        Handle hoView hoMain_DD
25046>>>>>>>        tWebViewInfo[] aViewStack
25046>>>>>>>        tWebViewInfo[] aViewStack
25047>>>>>>>
