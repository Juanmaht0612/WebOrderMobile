5531>>>>>>>    
5531>>>>>>>    // Create a prompt Button. This was created so the process of creating
5531>>>>>>>    // a prompt button object can be augmented. This will normally get
5531>>>>>>>    // called if a prompt object id exists for this object. However, you
5531>>>>>>>    // can send this message yourself.
5531>>>>>>>    // Avoid using this message - use the property Prompt_Button_Mode
5531>>>>>>>    Procedure Create_Prompt_Button Integer CreateMode // 0=auto, 1=make, 2=remove
5533>>>>>>>        Integer Obj
5533>>>>>>>        Integer Fg tsz sz Create
5533>>>>>>>        If (Num_Arguments = 0) ;            Move 1 to Create
5536>>>>>>>        Else ;            Move CreateMode to Create
5538>>>>>>>        If (CreateMode = PB_PromptAuto) Begin // 0 = if auto-create and prompt object
5540>>>>>>>            Move (Prompt_Object(Self,0) and ;                Shadow_State(Self,0)=0 ) to Fg
5541>>>>>>>        End
5541>>>>>>>>
5541>>>>>>>        Else ;                  // 1 = make an object, 2= remove object            Move (Create=PB_PromptOn) to fg
5543>>>>>>>        If Fg Begin
5545>>>>>>>            Set Form_Button_Value 0 to (Prompt_Button_Value(Self))
5546>>>>>>>            Set Form_Button 0 to FORM_BUTTON_PROMPT
5547>>>>>>>        End
5547>>>>>>>>
5547>>>>>>>        Else ;            Set Form_Button 0 to FORM_BUTTON_NONE
5549>>>>>>>    End_Procedure
5550>>>>>>>    
5550>>>>>>>    //  Send prompt if object can be made the focus (or is the focus)
5550>>>>>>>    //
5550>>>>>>>    Procedure Form_Button_Notification Integer Item# Integer Dummy
5552>>>>>>>        Integer rval
5552>>>>>>>        If (Focus(desktop)<>Self) ;            Get msg_Activate to rval
5555>>>>>>>        If (Focus(desktop)=Self) ;            Send Prompt
5558>>>>>>>    End_Procedure
5559>>>>>>>    
5559>>>>>>>    // as of 15.1 we changed all deactivating/activating signatures to not return values (see windows.pkg / ComboForm / Activating for more)
5559>>>>>>>    Procedure Activating //Returns Integer
5561>>>>>>>        Integer iMode iRet
