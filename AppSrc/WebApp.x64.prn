22675>>>>>>>
22675>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
22675>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
22675>>>>>>>    //  find the Object it will cause an Error and return C_WebUnresolvedObject (0).
22675>>>>>>>    //      sObjectName - Name of the web object.
22675>>>>>>>    Function FindWebObject String sObjectName Boolean bOptErr Returns Handle
22677>>>>>>>        Handle hoObj
22677>>>>>>>        Boolean bErr
22677>>>>>>>        
22677>>>>>>>        Move True to bErr
22678>>>>>>>        If (num_arguments > 1) ;            Move bOptErr to bErr
22681>>>>>>>        
22681>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName bErr to hoObj
22682>>>>>>>        
22682>>>>>>>        If (hoObj = C_WebUnresolvedObject and bErr) Begin
22684>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, sObjectName))
22685>>>>>>>>
22685>>>>>>>        End
22685>>>>>>>>
22685>>>>>>>        
22685>>>>>>>        Function_Return hoObj
22686>>>>>>>    End_Function
22687>>>>>>>    
22687>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
22687>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
22687>>>>>>>    //  find the Object it will return C_WebUnresolvedObject (0).
22687>>>>>>>    //      sObjectName - Name of the web object.
22687>>>>>>>    Function FindWebObjectSilent String sObjectName Returns Handle
22689>>>>>>>        Handle hoObj
22689>>>>>>>        
22689>>>>>>>        Get FindWebObject of (phoWebControlLocator(Self)) sObjectName False to hoObj
22690>>>>>>>        
22690>>>>>>>        Function_Return hoObj
22691>>>>>>>    End_Function
