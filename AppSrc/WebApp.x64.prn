11658>>>>>>>>>>>    End_Function
11659>>>>>>>>>>>
11659>>>>>>>>>>>    // returns the name of the Schema and File and Field suitable for an SQL where statement ("Schema"."Table"."Column")
11659>>>>>>>>>>>    Function SQLStrSchemaFileFieldName Integer iField Returns String
11661>>>>>>>>>>>        String sFile sField sSchema
11661>>>>>>>>>>>        Integer iFile
11661>>>>>>>>>>>        String sIdentifierQuote
11661>>>>>>>>>>>
11661>>>>>>>>>>>        Get Main_File to iFile
11662>>>>>>>>>>>        Get_Attribute DF_FILE_SQL_TABLE_NAME of iFile to sFile
11665>>>>>>>>>>>        Get_Attribute DF_FIELD_SQL_COLUMN_NAME of iFile iField to sField
11668>>>>>>>>>>>        Get_Attribute DF_FILE_OWNER of iFile to sSchema
11671>>>>>>>>>>>
11671>>>>>>>>>>>        Get SQLIdentifierQuote iFile to sIdentifierQuote
11672>>>>>>>>>>>
11672>>>>>>>>>>>        If (Trim(sSchema) <> "") ;            Function_Return (sIdentifierQuote + sSchema + sIdentifierQuote + '.' + sIdentifierQuote + sFile + sIdentifierQuote + '.' + sIdentifierQuote + sField + sIdentifierQuote )
11675>>>>>>>>>>>        Else ;            Function_Return (sIdentifierQuote + sFile + sIdentifierQuote + '.' + sIdentifierQuote + sField + sIdentifierQuote )
11677>>>>>>>>>>>    End_Function
11678>>>>>>>>>>>
11678>>>>>>>>>>>    // returns the name of a table suitable for a SQL statement
