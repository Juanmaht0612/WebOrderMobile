3356>>>>>        Set Justification_Mode to JMode_VCenter // Vcenter/Left
3357>>>>>        Send Use_Parent_Color
3358>>>>>        
3358>>>>>        Send Define_Shadow_Mixin
3359>>>>>        // we don't set this because you can get an odd bleed through with panels
3359>>>>>        //Set Transparent_State to True
3359>>>>>        Send Define_Bitmap_Support_Mixin
3360>>>>>        Send Define_ToolTip_Support_Mixin
3361>>>>>        
3361>>>>>        Set pbUseFormWindowHandle to False   // must come after Define_ToolTip_Support_Mixin
3362>>>>>    End_Procedure
