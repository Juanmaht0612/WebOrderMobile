8227>>>>>            Set Window_Style to CBS_SORT (Combo_Sort_State(Self))
8228>>>>>            // if entry_state we will allow scrolling within the form.
8228>>>>>            Set Window_Style CBS_AUTOHSCROLL to bEntry
8229>>>>>        End
8229>>>>>>
8229>>>>>        Forward Send Page iState
8231>>>>>        If (iState and bEntry) Begin
8233>>>>>            // if form_margin is set and entry_state we will set a character limit
8233>>>>>            Get Form_Margin to iMargin
8234>>>>>            If (iMargin>0) Begin
8236>>>>>                Move (WindowsMessage(CB_LIMITTEXT, iMargin, 0)) to iRetVal
8237>>>>>            End
8237>>>>>>
8237>>>>>        End
8237>>>>>>
8237>>>>>        If (iState =1) Begin
8239>>>>>            Send DoSetListWidth
8240>>>>>            Send DoSetSize
8241>>>>>        End
8241>>>>>>
8241>>>>>    End_Procedure
