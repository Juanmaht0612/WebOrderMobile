25461>>>>>>>>>>>>>>>    Procedure Attach_Deo_To_Server
25463>>>>>>>>>>>>>>>        Handle hoPrompt
25463>>>>>>>>>>>>>>>        Integer iValue
25463>>>>>>>>>>>>>>>
25463>>>>>>>>>>>>>>>        Forward Send Attach_Deo_To_Server
25465>>>>>>>>>>>>>>>
25465>>>>>>>>>>>>>>>        // after DEO is attached, set the prompt button automatically (if needed)
25465>>>>>>>>>>>>>>>        Get pbPromptButton to iValue
25466>>>>>>>>>>>>>>>
25466>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
25468>>>>>>>>>>>>>>>            Get PromptObject to hoPrompt
25469>>>>>>>>>>>>>>>            If (hoPrompt <> 0) Begin
25471>>>>>>>>>>>>>>>                Set pbPromptButton to True
25472>>>>>>>>>>>>>>>            End
25472>>>>>>>>>>>>>>>>
25472>>>>>>>>>>>>>>>        End
25472>>>>>>>>>>>>>>>>
25472>>>>>>>>>>>>>>>    End_Procedure
25473>>>>>>>>>>>>>>>
25473>>>>>>>>>>>>>>>
25473>>>>>>>>>>>>>>>    Procedure AfterAttachDDO
25475>>>>>>>>>>>>>>>        // Sent after each DEO Object has been attached to its DDO server and had all the DDO field settings
25475>>>>>>>>>>>>>>>        // applied to its published properties. We will set default values to any cWebControl properties that
25475>>>>>>>>>>>>>>>        // are still unassigned...
25475>>>>>>>>>>>>>>>        Integer iValue eDataType iPrecision
25475>>>>>>>>>>>>>>>        String sInputMode
25475>>>>>>>>>>>>>>>
25475>>>>>>>>>>>>>>>        Forward Send AfterAttachDDO
25477>>>>>>>>>>>>>>>
25477>>>>>>>>>>>>>>>        //  Determine sInputMode
25477>>>>>>>>>>>>>>>        Get peDataType to eDataType
25478>>>>>>>>>>>>>>>        Get psInputMode to sInputMode
25479>>>>>>>>>>>>>>>        If (eDataType = typeNumber and sInputMode = "") Begin
25481>>>>>>>>>>>>>>>            Get piPrecision to iPrecision
25482>>>>>>>>>>>>>>>            If (iPrecision > 0) Begin
25484>>>>>>>>>>>>>>>                Set psInputMode to "decimal"
25485>>>>>>>>>>>>>>>            End
25485>>>>>>>>>>>>>>>>
25485>>>>>>>>>>>>>>>            Else Begin
25486>>>>>>>>>>>>>>>                Set psInputMode to "numeric"
25487>>>>>>>>>>>>>>>            End
25487>>>>>>>>>>>>>>>>
25487>>>>>>>>>>>>>>>        End
25487>>>>>>>>>>>>>>>>
25487>>>>>>>>>>>>>>>
25487>>>>>>>>>>>>>>>        //  Correct pbPromptButton
25487>>>>>>>>>>>>>>>        Get pbPromptButton to iValue
25488>>>>>>>>>>>>>>>
25488>>>>>>>>>>>>>>>        If (iValue = C_WebDefault) Begin
25490>>>>>>>>>>>>>>>            Set pbPromptButton to False
25491>>>>>>>>>>>>>>>        End
25491>>>>>>>>>>>>>>>>
25491>>>>>>>>>>>>>>>    End_Procedure
25492>>>>>>>>>>>>>>>
25492>>>>>>>>>>>>>>>
25492>>>>>>>>>>>>>>>    // On prompt button click event stub.
25492>>>>>>>>>>>>>>>    Procedure OnPrompt
25494>>>>>>>>>>>>>>>        Send Prompt
25495>>>>>>>>>>>>>>>    End_Procedure
25496>>>>>>>>>>>>>>>
25496>>>>>>>>>>>>>>>    // returns PromptObject. If phoPrompt is set, it returns this, else checks with DD for web prompt object
25496>>>>>>>>>>>>>>>    Function PromptObject Returns Handle
25498>>>>>>>>>>>>>>>        Handle hoPrompt hoDD
25498>>>>>>>>>>>>>>>        Integer iFile iField
25498>>>>>>>>>>>>>>>        Integer eStyle
25498>>>>>>>>>>>>>>>        Get WebViewStyle to eStyle
25499>>>>>>>>>>>>>>>        If (eStyle = wvsDesktop or eStyle=wvsDialog) Begin
25501>>>>>>>>>>>>>>>            Get phoPrompt to hoPrompt
25502>>>>>>>>>>>>>>>            If (hoPrompt=0) Begin
25504>>>>>>>>>>>>>>>                Get Data_File to iFile
25505>>>>>>>>>>>>>>>                Get Data_Field to iField
25506>>>>>>>>>>>>>>>                Get Server to hoDD
25507>>>>>>>>>>>>>>>                If (iFile and hoDD) Begin
25509>>>>>>>>>>>>>>>                    Get File_Field_WebPrompt_Object of hoDD iFile iField to hoPrompt
25510>>>>>>>>>>>>>>>                End
25510>>>>>>>>>>>>>>>>
25510>>>>>>>>>>>>>>>            End
25510>>>>>>>>>>>>>>>>
25510>>>>>>>>>>>>>>>        End
25510>>>>>>>>>>>>>>>>
25510>>>>>>>>>>>>>>>        Function_Return hoPrompt
25511>>>>>>>>>>>>>>>    End_Function
25512>>>>>>>>>>>>>>>
25512>>>>>>>>>>>>>>>    // Returns true if control supports prompt buttons and the prompt button
25512>>>>>>>>>>>>>>>    // default property value (not webproperty) is enabled. In general when the
25512>>>>>>>>>>>>>>>    // default value is false, the developer has disabled this and does not
25512>>>>>>>>>>>>>>>    // want the dynamic enabling/disabling logic to be messing with it.
25512>>>>>>>>>>>>>>>    Function HasPromptButton Returns Boolean
25514>>>>>>>>>>>>>>>        Boolean bPromptButton
25514>>>>>>>>>>>>>>>        // this is purposefully Get and not WebGet
25514>>>>>>>>>>>>>>>        Get pbPromptButton to bPromptButton
25515>>>>>>>>>>>>>>>        Function_Return bPromptButton
25516>>>>>>>>>>>>>>>    End_Function
25517>>>>>>>>>>>>>>>
25517>>>>>>>>>>>>>>>    // augmented to also remove the prompt button from
25517>>>>>>>>>>>>>>>    // dynamically disabled forms
25517>>>>>>>>>>>>>>>    Procedure SetDynamicEnabled
25519>>>>>>>>>>>>>>>        Handle hoServer
25519>>>>>>>>>>>>>>>        Integer iFile eWebViewStyle
25519>>>>>>>>>>>>>>>        Boolean bEnabled bPrompt
25519>>>>>>>>>>>>>>>
25519>>>>>>>>>>>>>>>        Get Server to hoServer
25520>>>>>>>>>>>>>>>        Get Data_File to iFile
25521>>>>>>>>>>>>>>>        If (not(hoServer) or not (iFile)) Begin
25523>>>>>>>>>>>>>>>            Procedure_Return
25524>>>>>>>>>>>>>>>        End
25524>>>>>>>>>>>>>>>>
25524>>>>>>>>>>>>>>>
25524>>>>>>>>>>>>>>>        Forward Send SetDynamicEnabled
25526>>>>>>>>>>>>>>>
25526>>>>>>>>>>>>>>>        Get WebViewStyle to eWebViewStyle
25527>>>>>>>>>>>>>>>        If (eWebViewStyle = wvsDrillDown) Begin
25529>>>>>>>>>>>>>>>            // note we use the design time pbPromptButton. If it is true then
25529>>>>>>>>>>>>>>>            // there is something to remove.
25529>>>>>>>>>>>>>>>            Get HasPromptButton to bPrompt
25530>>>>>>>>>>>>>>>            If (bPrompt) Begin
25532>>>>>>>>>>>>>>>                WebGet pbEnabled to bEnabled
25533>>>>>>>>>>>>>>>                WebSet pbPromptButton to bEnabled
25534>>>>>>>>>>>>>>>            End
25534>>>>>>>>>>>>>>>>
25534>>>>>>>>>>>>>>>        End
25534>>>>>>>>>>>>>>>>
25534>>>>>>>>>>>>>>>    End_Procedure
