7957>>>>>>>    
7957>>>>>>>    Procedure Set Value Integer iItem String sValue
7959>>>>>>>        Integer ComboItem#
7959>>>>>>>        If (Window_Handle(Self) and Entry_State(Self,0)=0) Begin
7961>>>>>>>            Get WinCombo_Item_Matching sValue to ComboItem#
7962>>>>>>>            If (ComboItem# = -1) Begin // not found
7964>>>>>>>                Get Default_Combo_Item to ComboItem#
7965>>>>>>>                If (ComboItem# = -1) Begin  // -1 means top of list
7967>>>>>>>                    Get WinCombo_Value 0 to sValue
7968>>>>>>>                    Move 0 to ComboItem#
7969>>>>>>>                End
7969>>>>>>>>
7969>>>>>>>                Else Begin
7970>>>>>>>                    Get Combo_Value ComboItem# to sValue
7971>>>>>>>                    Get WinCombo_Item_Matching sValue to ComboItem#
7972>>>>>>>                End
7972>>>>>>>>
7972>>>>>>>            End
7972>>>>>>>>
7972>>>>>>>            Forward Set value iItem to sValue
7974>>>>>>>            If (ComboItem# >= 0) ;                Set WinCombo_Current_Item to ComboItem#
7977>>>>>>>            // set value is called during add-focus (when entry_state is false) we
7977>>>>>>>            // will not consider this a change condition. Skip sending onChange
7977>>>>>>>            If (pbPrivateAddingFocus(Self)) ;                Procedure_Return
7980>>>>>>>        End
7980>>>>>>>>
7980>>>>>>>        Else ;            Forward Set value iItem to sValue
7983>>>>>>>        Send onChange // When value changes, we call onChange
7984>>>>>>>    End_Procedure
7985>>>>>>>    
7985>>>>>>>    Procedure Add_Focus Handle hoParent Returns Integer
7987>>>>>>>        Boolean bOld
7987>>>>>>>        Forward Send Add_Focus hoParent
7989>>>>>>>        If not (Entry_State(Self,0)) Begin
7991>>>>>>>            // if setting value during add-focus set flag to tell set value that this is a special case
7991>>>>>>>            // JJT: This was done in this manner to have minimum impact on pre 8.2 behaviors.
7991>>>>>>>            Get pbPrivateAddingFocus to bOld
7992>>>>>>>            Set pbPrivateAddingFocus to True
7993>>>>>>>            Set Value 0 to (value(Self,0))
7994>>>>>>>            Set pbPrivateAddingFocus to bOld
7995>>>>>>>        End
7995>>>>>>>>
7995>>>>>>>    End_Procedure
7996>>>>>>>    
7996>>>>>>>    Procedure DoSetListWidth
7998>>>>>>>        Integer iListWidth // required width of drop-down list
7998>>>>>>>        
7998>>>>>>>        Get ListWidth to iListWidth
7999>>>>>>>        If (iListWidth <> 0) Begin
8001>>>>>>>            Send Windows_Message CB_SETDROPPEDWIDTH iListWidth 0
8002>>>>>>>        End
8002>>>>>>>>
8002>>>>>>>    End_Procedure
8003>>>>>>>    
8003>>>>>>>    Procedure DoSetSize
8005>>>>>>>        Boolean bApply bSupported
8005>>>>>>>        Integer icRow i iMajor
8005>>>>>>>        Integer iSz iDelta iItemHeight
8005>>>>>>>        Integer cyEdit     // height of edit control
8005>>>>>>>        Integer cyListItem // height of each item in the drop-down list
8005>>>>>>>        Integer cyControl  // height of complete control
8005>>>>>>>        Integer cxControl  // width of control
8005>>>>>>>        tWinRect Rect
8005>>>>>>>        tWinRect Rect
8005>>>>>>>        
8005>>>>>>>        Move (SysConf(SYSCONF_COMCTL_REV)) to iMajor
8006>>>>>>>        // Check for 6.0 or above
8006>>>>>>>        Move (hi(iMajor)>=6) to bSupported
8007>>>>>>>        
8007>>>>>>>        Get ListRowCount to icRow // how many rows are required
8008>>>>>>>        
8008>>>>>>>        If (bSupported) Begin
8010>>>>>>>            If (icRow <>0) Begin
8012>>>>>>>                Move (WindowsMessage( CB_SETMINVISIBLE, icRow, 0)) to i
8013>>>>>>>            End
8013>>>>>>>>
8013>>>>>>>            Get pbApplyComboFormHeight to bApply
8014>>>>>>>            If (bApply) Begin
8016>>>>>>>                Move (GetWindowRect(Window_Handle(Self),AddressOf(Rect))) to i
8017>>>>>>>                Move (WindowsMessage(CB_GETITEMHEIGHT, -1, 0)) to iItemHeight
8018>>>>>>>                Move (Rect.bottom - Rect.top - iItemHeight) to iDelta
8019>>>>>>>                Get GuiSize to iSz
8020>>>>>>>                Move (WindowsMessage(CB_SETITEMHEIGHT, -1, (Hi(iSz) - iDelta))) to i
8021>>>>>>>            End
8021>>>>>>>>
8021>>>>>>>            
8021>>>>>>>        End
8021>>>>>>>>
8021>>>>>>>        // if not 6.0 do what we've always done for sizing. This can happen if you don't
8021>>>>>>>        // have a manifest (which is not a good idea)
8021>>>>>>>        Else Begin
8022>>>>>>>            // if no manifest the guisize will be set. Can't use better label placement
8022>>>>>>>            Set pbLabelUseCtrlHeight to False
8023>>>>>>>            If (icRow=0) Begin
8025>>>>>>>                Move 10 to icRow
8026>>>>>>>            End
8026>>>>>>>>
8026>>>>>>>            // get height of edit portion
8026>>>>>>>            Move (WindowsMessage( CB_GETITEMHEIGHT, -1, 0)) to cyEdit
8027>>>>>>>            
8027>>>>>>>            // get height of single item in list
8027>>>>>>>            Move (WindowsMessage( CB_GETITEMHEIGHT, 0, 0)) to cyListItem
8028>>>>>>>            
8028>>>>>>>            // calculate required height
8028>>>>>>>            Move (cyEdit +8 +(cyListItem *icRow)) to cyControl // 8 is the empirical height of 3d effects
8029>>>>>>>            
8029>>>>>>>            // retain width from initial settings
8029>>>>>>>            Move (Low(GuiSize(Self))) to cxControl
8030>>>>>>>            
8030>>>>>>>            Set GuiSize to cyControl cxControl
8031>>>>>>>        End
8031>>>>>>>>
8031>>>>>>>        
8031>>>>>>>    End_Procedure
8032>>>>>>>    
8032>>>>>>>    // The following three messages are designed to handle accelerator key
8032>>>>>>>    // handling when a list is dropped down. When a list is dropped, we want all
8032>>>>>>>    // accelerator keys to be ignored. In addition, we want the return and enter
8032>>>>>>>    // keys to roll the list up, if return is pressed the value should be updated
8032>>>>>>>    
8032>>>>>>>    // Called by key and Process_Accelerator when a list is dropped down and a
8032>>>>>>>    // key is pressed. We pass the virtual key (not the df key) and a flag telling
8032>>>>>>>    // us if this is an accelerator key (Tells us where it was called from)
8032>>>>>>>    // Return: True if you, want to stop any other actions.
8032>>>>>>>    // Currently this looks for return and escape.
8032>>>>>>>    //
8032>>>>>>>    Function OnDropKey Integer iVKey Boolean bIsAccelerator Returns Boolean
8034>>>>>>>        Integer i iItem
8034>>>>>>>        If (iVKey=vk_escape or iVKey=vk_return) Begin
8036>>>>>>>            If (iVKey=vk_return) Begin
8038>>>>>>>                // this forces the form value to get updated with the list's current value
8038>>>>>>>                Get WinCombo_Current_item to iItem                         // current value in the list
8039>>>>>>>                Move (WindowsMessage( CB_SHOWDROPDOWN, 0, 0)) to i                // roll up list
8040>>>>>>>                Set WinCombo_Current_item to iItem                         // make sure form has new value
8041>>>>>>>                Send Combo_Item_Changed                                    // list changed event
8042>>>>>>>            End
8042>>>>>>>>
8042>>>>>>>            Else ; // if escape, just roll up list                Move (WindowsMessage(CB_SHOWDROPDOWN, 0, 0)) to i                // roll up list
8044>>>>>>>            Function_Return True // if ret or esc, we are done processing
8045>>>>>>>        End
8045>>>>>>>>
8045>>>>>>>        // if accel, we want to do nothing at all.
8045>>>>>>>        Function_Return bIsAccelerator // we want to always ignore accelerator keys.
8046>>>>>>>    End_Function
8047>>>>>>>    
8047>>>>>>>    // note that we must test for both process_accelerator and Key because we
8047>>>>>>>    // don't know if a key (e.g. esc=kCancel) has been assigned to on On_key or
8047>>>>>>>    // not. If an on_key, process_accelerator is called, else Key is called
8047>>>>>>>    
8047>>>>>>>    // augment to check for keys pressed in dropped state. Most likely, when dropped
8047>>>>>>>    // we will trap esc and return and ignore all others
8047>>>>>>>    //
8047>>>>>>>    Procedure Process_Accelerator Integer i1 Integer i2
8049>>>>>>>        Integer bDropped iVKey bDone
8049>>>>>>>        Move (WindowsMessage(CB_GETDROPPEDSTATE, 0, 0)) to bDropped
8050>>>>>>>        If bDropped Begin // if dropped we probably ignore all acc keys
8052>>>>>>>            Get VKeyAscii to iVKey  // get the last virtual key
8053>>>>>>>            Get OnDropKey iVKey True to bDone
8054>>>>>>>        End
8054>>>>>>>>
8054>>>>>>>        If not bDone ;            Forward Send process_accelerator i1 i2
8058>>>>>>>    End_Procedure
8059>>>>>>>    
8059>>>>>>>    // augment to check for keys pressed in dropped state. Most likely, when dropped
8059>>>>>>>    // we will trap esc and return and pass all others through
8059>>>>>>>    //
8059>>>>>>>    Procedure Key Integer iKy Returns Integer
8061>>>>>>>        Integer bDropped iVKey
8061>>>>>>>        Boolean bDone
8061>>>>>>>        Move (WindowsMessage(CB_GETDROPPEDSTATE, 0, 0)) to bDropped
8062>>>>>>>        If bDropped Begin // if dropped we may ignore the key
8064>>>>>>>            Get VKeyAscii to iVKey  // get the last virtual key
8065>>>>>>>            Get OnDropKey iVKey False to bDone
8066>>>>>>>        End
8066>>>>>>>>
8066>>>>>>>        If not bDone ;            Forward Send key iKy
8070>>>>>>>    End_Procedure
8071>>>>>>>    
8071>>>>>>>    // augmented to handle cases where combo form height is set. When this happens
8071>>>>>>>    // setting the anchor restores to default height so it must be reset. This can
8071>>>>>>>    // make things a little jumpy. The combo is a strange control
8071>>>>>>>    Procedure DoApplyAnchors Integer Arg1 Integer Arg2
8073>>>>>>>        Boolean bApply
8073>>>>>>>        Integer iHt
8073>>>>>>>        Get pbApplyComboFormHeight to bApply
8074>>>>>>>        If bApply Begin
8076>>>>>>>            Move (WindowsMessage(CB_GETITEMHEIGHT, -1, 0)) to iHt
8077>>>>>>>            Forward Send DoApplyAnchors Arg1 Arg2
8079>>>>>>>            Move (WindowsMessage(CB_SETITEMHEIGHT, -1, iHt)) to iHt
8080>>>>>>>        End
8080>>>>>>>>
8080>>>>>>>        Else Begin
8081>>>>>>>            Forward Send DoApplyAnchors Arg1 Arg2
8083>>>>>>>        End
8083>>>>>>>>
8083>>>>>>>    End_Procedure
8084>>>>>>>    
8084>>>>>>>End_Class
8085>>>>>
8085>>>>>
8085>>>>>Class ComboForm is a DFBaseComboBox
8086>>>>>    
8086>>>>>    Procedure Construct_Object
8088>>>>>        Forward Send Construct_Object
8090>>>>>        // setting this to zero forces current_item to be correct during object definition
8090>>>>>        Set New_item to 0
8091>>>>>        
8091>>>>>        Send define_standard_Form_Mixin
8092>>>>>        Send Define_Combo_Mixin
8093>>>>>        Send Define_ToolTip_Support_Mixin
8094>>>>>    End_Procedure
8095>>>>>    
8095>>>>>    Import_Class_Protocol Standard_Form_Mixin  // order matters here.
8096>>>>>    Import_Class_Protocol Combo_Mixin          // combo must be 2nd.
8097>>>>>    Import_Class_Protocol ToolTip_Support_Mixin
8098>>>>>    
8098>>>>>    // By default we will fill combo lists during activating. In some cases
8098>>>>>    // the list may already be filled in which case nothing will happen.
8098>>>>>    //
8098>>>>>    
8098>>>>>    // as of 15.1 we changed all deactivating/activating signatures to not return values
8098>>>>>    // We have not recommended using activating for return values and we don't want codesense and events to use the
8098>>>>>    // get msg_activating syntax. We have not changed the actual code in unlikely case that some is successfully
8098>>>>>    // using activating to return a value. This is a "if it ain't broke, don't fix it" kind of thing.
8098>>>>>    // This usage is not recommended and should not be used as a sample.
8098>>>>>    Procedure Activating // returns integer
8100>>>>>        Integer rVal
8100>>>>>        Forward Get MSG_Activating to rVal
8102>>>>>        If not rval ;            Send Combo_initialize_list
8105>>>>>        Procedure_Return rVal
8106>>>>>    End_Procedure
8107>>>>>    
8107>>>>>    Procedure End_Construct_Object
8109>>>>>        Send End_Define_Combo_Mixin
8110>>>>>        Forward Send End_Construct_Object
8112>>>>>    End_Procedure
8113>>>>>    
8113>>>>>    Procedure Set Capslock_State Integer bState
8115>>>>>        Integer iOptions
8115>>>>>        Get form_Options 0 to iOptions
8116>>>>>        If bState ;            Move (AddBitValue(CAPSLOCK_BIT_VALUE, iOptions)) to iOptions
8119>>>>>        Else ;            Move (RemoveBitValue(CAPSLOCK_BIT_VALUE, iOptions)) to iOptions
8121>>>>>        Set form_Options 0 to iOptions
8122>>>>>    End_Procedure
8123>>>>>    
8123>>>>>    Function CapsLock_State Returns Integer
8125>>>>>        Integer iOptions
8125>>>>>        Get form_Options 0 to iOptions
8126>>>>>        Function_Return ( (iOptions iand CAPSLOCK_BIT_VALUE)<>0 )
8127>>>>>    End_Function
8128>>>>>    
8128>>>>>    // We need to do some capslock checking with form combos.
8128>>>>>    // For some reason the runtime does not recognize the capslock bit
8128>>>>>    // in the form_options (as it does in form).
8128>>>>>    // note that comboForm and comboEntry each need their own Page method
8128>>>>>    // and not a common mixin
8128>>>>>    //
8128>>>>>    Procedure Page Integer iMode
8130>>>>>        Integer iStyle hWnd iMargin iRetVal
8130>>>>>        Boolean bEntry  bState
8130>>>>>        Get Entry_State to bEntry
8131>>>>>        If iMode Begin // copied from mixin...
8133>>>>>            Set Window_Style to CBS_SORT (Combo_Sort_State(Self))
8134>>>>>            // if entry_state we will allow scrolling within the form.
8134>>>>>            Set Window_Style CBS_AUTOHSCROLL to bEntry
8135>>>>>        End
8135>>>>>>
8135>>>>>        Forward Send Page iMode
8137>>>>>        // This is required in form versions of combos because
8137>>>>>        // setting capslock in form option does not work.
8137>>>>>        If iMode Begin
8139>>>>>            Get form_window_handle 0 to hWnd
8140>>>>>            If hWnd Begin
8142>>>>>                Get Capslock_State to bState
8143>>>>>                Move (GetWindowLongPtr(hWnd, GWL_STYLE)) to iStyle
8144>>>>>                If bState ;                    Move (AddBitValue(ES_UPPERCASE, iStyle)) to iStyle
8147>>>>>                Else ;                    Move (RemoveBitValue(ES_UPPERCASE, iStyle)) to iStyle
8149>>>>>                Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle)) to iStyle
8150>>>>>            End
8150>>>>>>
8150>>>>>            If bEntry Begin
8152>>>>>                // if form_margin is set and entry_state we will set a character limit
8152>>>>>                Get Form_Margin to iMargin
8153>>>>>                If (iMargin>0) Begin
8155>>>>>                    Move (WindowsMessage( CB_LIMITTEXT, iMargin, 0)) to iRetVal
8156>>>>>                End
8156>>>>>>
8156>>>>>            End
8156>>>>>>
8156>>>>>        End
8156>>>>>>
8156>>>>>        If (iMode =1) Begin
8158>>>>>            Send DoSetListWidth
8159>>>>>            Send DoSetSize
8160>>>>>        End
8160>>>>>>
8160>>>>>    End_Procedure
