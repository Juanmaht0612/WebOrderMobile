17669>>>>>>>>>>>>>                    If (cctx.bCancel) Begin
17671>>>>>>>>>>>>>                        Send Call_CancelWithError (&cctx)
17672>>>>>>>>>>>>>                        Procedure_Return
17673>>>>>>>>>>>>>                    End
17673>>>>>>>>>>>>>>
17673>>>>>>>>>>>>>                End
17673>>>>>>>>>>>>>>
17673>>>>>>>>>>>>>            End
17673>>>>>>>>>>>>>>
17673>>>>>>>>>>>>>        End
17673>>>>>>>>>>>>>>
17673>>>>>>>>>>>>>        
17673>>>>>>>>>>>>>        //  Add client actions to the response
17673>>>>>>>>>>>>>        Send Call_PostClientAction (&cctx)
17674>>>>>>>>>>>>>        
17674>>>>>>>>>>>>>        //  Generate the response body        
17674>>>>>>>>>>>>>        Send Call_BuildResponseBody (&cctx)
17675>>>>>>>>>>>>>        
17675>>>>>>>>>>>>>        //  Stop error handling
17675>>>>>>>>>>>>>        Send Call_FinishErrorHandling (&cctx)
17676>>>>>>>>>>>>>    End_Procedure
