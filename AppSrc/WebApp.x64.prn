5020>>>>>        Integer iRVal
5020>>>>>        
5020>>>>>        Get Form_button iItem to eButtonStyle
5021>>>>>        If (eButtonStyle=FORM_BUTTON_SPIN or eButtonStyle=FORM_BUTTON_SPIN_WRAP) Begin
5023>>>>>            Send OnInitSpin
5024>>>>>            Get Form_Button_Window_Handle 0 to hBtn
5025>>>>>            If hBtn Begin // there will always be a handle..or this should not get called
5027>>>>>                Get Minimum_Position to iMin
5028>>>>>                Get Maximum_Position to iMax
5029>>>>>                Get Spin_Value       to iValue
5030>>>>>                Set Current_Position to iValue
5031>>>>>                Move (SendMessage(hBtn, UDM_SETRANGE32, iMin, iMax)) to iRVal
5032>>>>>                Move (SendMessage(hBtn, UDM_SETPOS32, 0, iValue)) to iRVal
5033>>>>>            End
5033>>>>>>
5033>>>>>        End
5033>>>>>>
5033>>>>>    End_Procedure
