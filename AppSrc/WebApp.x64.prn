7665>>>>>    
7665>>>>>    // augmented to trigger a radio group exiting message, if the focus is
7665>>>>>    // moving outside of the radio group
7665>>>>>    //
7665>>>>>    Procedure Exiting Handle hoDestination Returns Integer
7667>>>>>        Integer iFail
7667>>>>>        Forward Get msg_exiting to ifail
7669>>>>>        // we check if the new focus is a radio button, if it is not (-1)
7669>>>>>        // then we know we are exiting to some other object
7669>>>>>        If (iFail=0 and Radio_Object_Item(parent(Self),hoDestination)=-1) ;            Delegate Get OnRadioGroupExiting to iFail
7673>>>>>        Procedure_Return iFail
7674>>>>>    End_Procedure
