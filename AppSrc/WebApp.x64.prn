34737>>>>>>>    // Performs a logout and a reset of the session. May trigger a login if one is required.
34737>>>>>>>    Procedure RequestLogout
34739>>>>>>>        Boolean bValid
34739>>>>>>>        Integer eLoginMode eAppStateMode 
34739>>>>>>>        String sStateHash
34739>>>>>>>        Handle hoWebApp
34739>>>>>>>        
34739>>>>>>>        Get Host to hoWebApp
34740>>>>>>>        
34740>>>>>>>        //  We end the session and create a new one (so the user is logged out)
34740>>>>>>>        Send EndSession // close the current session key
34741>>>>>>>        Get RecreateSession of hoWebApp to bValid
34742>>>>>>>        
34742>>>>>>>        //  Now we try to 
34742>>>>>>>        Get LoginMode to eLoginMode
34743>>>>>>>        
34743>>>>>>>        If (eLoginMode = lmLoginRequired) Begin
34745>>>>>>>            Get peApplicationStateMode to eAppStateMode
34746>>>>>>>            
34746>>>>>>>            //  If history management is used we add an entry for the default view, and then refresh, so after login the user gets back to the dashboard
34746>>>>>>>            If (eAppStateMode <> asmOff) Begin
34748>>>>>>>                Send SetStateHash of hoWebApp "" "" False
34749>>>>>>>            End
34749>>>>>>>>
34749>>>>>>>
34749>>>>>>>            Send NavigateRefresh of hoWebApp          // refresh the WebApp at the client (triggers a login)
34750>>>>>>>        End
34750>>>>>>>>
34750>>>>>>>    End_Procedure
