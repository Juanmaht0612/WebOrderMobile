8996>>>>>    
8996>>>>>    Function FullPathNames String sShortPathNames Returns String
8998>>>>>        String sFileName
8998>>>>>        String sFullPathNames 
8998>>>>>        WString sFullPathName sShortPathName
8998>>>>>        Pointer lpsFilePart
8998>>>>>        Integer icChar // the number of characters returned
8998>>>>>        Integer iPos
8998>>>>>        
8998>>>>>        Move (Pos(";", sShortPathNames)) to iPos
8999>>>>>        While (length(sShortPathNames) >0)
9003>>>>>            If (iPos =0) Begin
9005>>>>>                Move sShortPathNames to sShortPathName
9006>>>>>                Move "" to sShortPathNames
9007>>>>>            End
9007>>>>>>
9007>>>>>            Else Begin // multiple paths
9008>>>>>                Move (Left(sShortPathNames, iPos -1)) to sShortPathName
9009>>>>>                Move (Right(sShortPathNames, length(sShortPathNames) -iPos)) to sShortPathNames // remove this path from the paths
9010>>>>>            End
9010>>>>>>
9010>>>>>            Move (Repeat(character(0), 4096)) to sFullPathName
9011>>>>>            Move -1 to lpsFilePart
9012>>>>>            Move (GetFullPathNameW(sShortPathName, 4096, AddressOf(sFullPathName), AddressOf(lpsFilePart))) to icChar
9013>>>>>            Append sFullPathNames (CString(sFullPathName))
9014>>>>>            If (sShortPathNames <>"") ;                Append sFullPathNames ";"
9017>>>>>            Move (Pos(";", sShortPathNames)) to iPos
9018>>>>>        Loop
9019>>>>>>
9019>>>>>        
9019>>>>>        Function_Return sFullPathNames
9020>>>>>    End_Function
9021>>>>>    
9021>>>>>    Function GetApplicationPath Returns String
9023>>>>>        // Returns the path of the Application (no trailing "\")
9023>>>>>        WString wApplicationFileName 
9023>>>>>        Boolean bRemoved
9023>>>>>        Integer iNumChars
9023>>>>>        String sFilename sPath
9023>>>>>        
9023>>>>>        Move (Repeat(Character(0), 1024)) to wApplicationFileName
9024>>>>>        Move (GetModuleFileNameW(0, AddressOf(wApplicationFileName), 1024)) to iNumChars
9025>>>>>        Move (CString(wApplicationFileName)) to wApplicationFileName
9026>>>>>        
9026>>>>>        Move (PathRemoveFileSpecW(AddressOf(wApplicationFileName))) to bRemoved
9027>>>>>        Move (CString(wApplicationFileName)) to sPath
9028>>>>>        
9028>>>>>        If (Right(sPath, 1) ="\") ;            Move (Left(sPath, Length(sPath) -1)) to sPath
9031>>>>>        Function_Return sPath
9032>>>>>    End_Function
9033>>>>>    
9033>>>>>    Procedure DoClearPaths
9035>>>>>        // Call this prior to changing from one WorkspAce to another
9035>>>>>        // if you don't, OpenWorkspaceFile will ignore the new paths.
9035>>>>>        Set psHome           to ""
9036>>>>>        Set psAppSrcPath     to ""
9037>>>>>        Set psBitmapPath     to ""
9038>>>>>        Set psDataPath       to ""
9039>>>>>        Set psDdSrcPath      to ""
9040>>>>>        Set psDescription    to ""
9041>>>>>        Set psFileList       to ""
9042>>>>>        Set psHelpPath       to ""
9043>>>>>        Set psIdeSrcPath     to ""
9044>>>>>        Set psAppHtmlPath    to ""
9045>>>>>        Set psProgramPath    to ""
9046>>>>>        Set psWorkspaceName  to ""
9047>>>>>        Set psSystemDfPath   to ""
9048>>>>>        Set psSystemMakePath to ""
9049>>>>>        Set psWorkspaceWSFile to ""
9050>>>>>        Set psConnectionIni to ""
9051>>>>>    End_Procedure
9052>>>>>    
9052>>>>>    Function OpenWorkspaceFile String sWorkspaceFile Returns Integer
9054>>>>>        WString wApplicationStartPath
9054>>>>>        String sWsName // name of Workspace is inferred from the Workspacefile name
9054>>>>>        Boolean bRemoved
9054>>>>>        Handle hoIniFile
9054>>>>>        Boolean bSuccess // call succeeded?
9054>>>>>        String sOldDirectory
9054>>>>>        String sSystemDfPath sSystemMakePath
9054>>>>>        Boolean bExist // does the WS file exist?
9054>>>>>        Boolean bChangingWorkspace
9054>>>>>        
9054>>>>>        String sHome sAppSrcPath sBitmapPath sDataPath sDdSrcPath sDescription sAppHtmlPath
9054>>>>>        String sFileList sHelpPath sIdeSrcPath sProgramPath sWorkspaceName sConnectionIni
9054>>>>>        
9054>>>>>        Set psWorkspaceWSFile to ""
9055>>>>>        If (sWorkspaceFile ="") ;            Function_Return wsWorkspaceFileNotFound
9058>>>>>        
9058>>>>>        // Append extension if not supplied...
9058>>>>>        If (Uppercase(Right(Trim(sWorkspaceFile),3)) <> ".WS") Begin
9060>>>>>            Move (sWorkspaceFile-".ws") to sWorkspaceFile
9061>>>>>        End
9061>>>>>>
9061>>>>>        
9061>>>>>        Get pbWorkspaceOpened to bChangingWorkspace // if we had an existing workspace. We are changing
9062>>>>>        
9062>>>>>        If (IsFilenameQualified(sWorkspaceFile) = False) Begin
9064>>>>>            // Set the properties to the paths of the Workspace
9064>>>>>            // Find the WS file (with program)...
9064>>>>>            Get GetApplicationPath to wApplicationStartPath
9065>>>>>            
9065>>>>>            Move sWorkspaceFile to sWsName
9066>>>>>            Move (wApplicationStartPath +"\" +sWorkspaceFile) to sWorkspaceFile
9067>>>>>        End
9067>>>>>>
9067>>>>>        Else Begin
9068>>>>>            Move (ExtractFileName(sWorkspaceFile)) to sWsName
9069>>>>>            
9069>>>>>            Move sWorkspaceFile to wApplicationStartPath
9070>>>>>            Move (PathRemoveFileSpecW(AddressOf(wApplicationStartPath))) to bRemoved
9071>>>>>        End
9071>>>>>>
9071>>>>>        
9071>>>>>        // Ensure that the file can be found...
9071>>>>>        //File_Exist (ToAnsi(sWorkspaceFile)) bExist        // [JVH] 8.3.8.0 Convert filename to Ansi
9071>>>>>        // [JVH] Turn off support for
9071>>>>>        // Ansi extended characters in workspace until we can
9071>>>>>        // resolve all open issues
9071>>>>>        Set psWorkspaceWSFile to sWorkspaceFile
9072>>>>>        File_Exist sWorkspaceFile bExist
9073>>>>>        If (bExist = False) ;            Function_Return wsWorkspaceFileNotFound
9076>>>>>        
9076>>>>>        Get psHome           to sHome
9077>>>>>        Get psAppSrcPath     to sAppSrcPath
9078>>>>>        Get psAppHtmlPath    to sAppHtmlPath
9079>>>>>        Get psBitmapPath     to sBitmapPath
9080>>>>>        Get psDataPath       to sDataPath
9081>>>>>        Get psDdSrcPath      to sDdSrcPath
9082>>>>>        Get psDescription    to sDescription
9083>>>>>        Get psFileList       to sFileList
9084>>>>>        Get psHelpPath       to sHelpPath
9085>>>>>        Get psIdeSrcPath     to sIdeSrcPath
9086>>>>>        Get psProgramPath    to sProgramPath
9087>>>>>        Get psSystemDfPath   to sSystemDfPath
9088>>>>>        Get psSystemMakePath to sSystemMakePath
9089>>>>>        Get psWorkspaceName  to sWorkspaceName
9090>>>>>        Get psConnectionIni to sConnectionIni
9091>>>>>        
9091>>>>>        Get_Current_Directory to sOldDirectory
9092>>>>>        // Note- this conversion is temporarily rolled back
9092>>>>>        //Move (SetCurrentDirectory(ToAnsi(CString(wApplicationStartPath)))) To bSuccess    // [JVH] 8.3.8.0 Convert AppStartPath to ANSI
9092>>>>>        Move (SetCurrentDirectory(CString(wApplicationStartPath))) to bSuccess
9093>>>>>        
9093>>>>>        Get Create U_cIniFile to hoIniFile
9094>>>>>        Set psFilename of hoIniFile to sWorkspaceFile
9095>>>>>        
9095>>>>>        If (sHome ="") ;            Get ReadString of hoIniFile "Workspace" "Home" ""          to sHome
9098>>>>>        If (sAppSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppSrcPath" ""    to sAppSrcPath
9101>>>>>        If (sAppHtmlPath ="") ;            Get ReadString of hoIniFile "Workspace" "AppHtmlPath" ""   to sAppHtmlPath
9104>>>>>        If (sBitmapPath ="") ;            Get ReadString of hoIniFile "Workspace" "BitmapPath" ""    to sBitmapPath
9107>>>>>        If (sDataPath ="") ;            Get ReadString of hoIniFile "Workspace" "DataPath" ""      to sDataPath
9110>>>>>        If (sDdSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "DdSrcPath" ""     to sDdSrcPath
9113>>>>>        If (sDescription ="") ;            Get ReadString of hoIniFile "Workspace" "Description" ""   to sDescription
9116>>>>>        If (sFileList ="") ;            Get ReadString of hoIniFile "Workspace" "FileList" ""      to sFileList
9119>>>>>        If (sHelpPath ="") ;            Get ReadString of hoIniFile "Workspace" "HelpPath" ""      to sHelpPath
9122>>>>>        If (sIdeSrcPath ="") ;            Get ReadString of hoIniFile "Workspace" "IdeSrcPath" ""    to sIdeSrcPath
9125>>>>>        If (sProgramPath ="") ;            Get ReadString of hoIniFile "Workspace" "ProgramPath" ""   to sProgramPath
9128>>>>>        If (sWorkspaceName ="") ;            Move (Left(sWsName, Length(sWsName) -3))                   to sWorkspaceName
9131>>>>>        If (sConnectionIni ="") ;            Get ReadString of hoIniFile "Workspace" "ConnectionIni" ""   to sConnectionIni
9134>>>>>        
9134>>>>>        If (sSystemDfPath ="") ;            Set psSystemDfPath   to (VdfSystemDfPath(Self))
9137>>>>>        If (sSystemMakePath ="") ;            Set psSystemMakePath to (VdfSystemMakePath(Self))
9140>>>>>        
9140>>>>>        Set psHome          to (FullPathNames(Self, sHome))
9141>>>>>        
9141>>>>>        // Set CWD to Home...
9141>>>>>        Move (SetCurrentDirectory(sHome)) to bSuccess
9142>>>>>        Set psAppSrcPath    to (FullPathNames(Self, sAppSrcPath))
9143>>>>>        Set psAppHtmlPath   to (FullPathNames(Self, sAppHtmlPath))
9144>>>>>        Set psBitmapPath    to (FullPathNames(Self, sBitmapPath))
9145>>>>>        Set psDataPath      to (FullPathNames(Self, sDataPath))
9146>>>>>        Set psDdSrcPath     to (FullPathNames(Self, sDdSrcPath))
9147>>>>>        Set psFileList      to (FullPathNames(Self, sFileList))
9148>>>>>        Set psHelpPath      to (FullPathNames(Self, sHelpPath))
9149>>>>>        Set psIdeSrcPath    to (FullPathNames(Self, sIdeSrcPath))
9150>>>>>        Set psProgramPath   to (FullPathNames(Self, sProgramPath))
9151>>>>>        Set psConnectionIni to (FullPathNames(Self, sConnectionIni))
9152>>>>>        
9152>>>>>        Set psWorkspaceName to sWorkspaceName
9153>>>>>        Set psDescription   to sDescription
9154>>>>>        
9154>>>>>        Send Destroy of hoIniFile // destroy dynaically created inifile object
9155>>>>>        
9155>>>>>        // Restore CWD...
9155>>>>>        Move (SetCurrentDirectory(sOldDirectory)) to sOldDirectory
9156>>>>>        
9156>>>>>        // Check for error conditions:
9156>>>>>        // DataPath and FileList must be defined; the FileList entry must point to a valid FileList.cfg
9156>>>>>        If (psDataPath(Self) = "") ;            Function_Return wsDataPathEmpty
9159>>>>>        If (psFileList(Self) = "") ;            Function_Return wsFileListEmpty
9162>>>>>        
9162>>>>>        Move (DoesFileExist(psFileList(Self))) to bExist
9163>>>>>        If (bExist = False) ;            Function_Return wsFileListNotExist
9166>>>>>        
9166>>>>>        If bChangingWorkspace ;            Close DF_ALL // if there is a WS open, we must close all the files
9169>>>>>        
9169>>>>>        Send DoAssignPaths // set psDfPath
9170>>>>>        Send DoSetPaths    // Set the application's Attributes of Filelist_Name and Open_Path
9171>>>>>        Set pbWorkspaceOpened to True
9172>>>>>        
9172>>>>>        Function_Return wsWorkspaceOpened
9173>>>>>    End_Function
9174>>>>>    
9174>>>>>    Function OpenWorkspace String sWorkspace Returns Integer
9176>>>>>        // Look in the Workspaces.ini file for the name, then open it by path
9176>>>>>        
9176>>>>>        Handle hoSections hoIniFile
9176>>>>>        Integer iWorkspace eOpened
9176>>>>>        String sWorkspaceName sPath
9176>>>>>        String sVdfRootDir
9176>>>>>        
9176>>>>>        Get Create U_Array    to hoSections
9177>>>>>        Get Create U_cIniFile to hoIniFile
9178>>>>>        
9178>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
9181>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
9184>>>>>        
9184>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
9185>>>>>        
9185>>>>>        Send ReadSections of hoIniFile hoSections
9186>>>>>        
9186>>>>>        For iWorkspace from 0 to (Item_Count(hoSections) -1)
9192>>>>>>
9192>>>>>            Get Value of hoSections iWorkspace to sWorkspaceName
9193>>>>>            If (Uppercase(sWorkspaceName) = Uppercase(sWorkspace)) Begin
9195>>>>>                Get ReadString of hoIniFile sWorkspace "Path" "" to sPath
9196>>>>>                If (Right(sPath,1) <>"\") ;                    Move (sPath +"\") to sPath
9199>>>>>                
9199>>>>>                Get OpenWorkspaceFile (sPath + sWorkspace) to eOpened
9200>>>>>                Send Destroy of hoSections
9201>>>>>                Send Destroy of hoIniFile
9202>>>>>                Function_Return eOpened
9203>>>>>            End
9203>>>>>>
9203>>>>>        Loop
9204>>>>>>
9204>>>>>        
9204>>>>>        Send Destroy of hoSections
9205>>>>>        Send Destroy of hoIniFile
9206>>>>>        Function_Return wsWorkspaceNotFound
9207>>>>>    End_Function
9208>>>>>    
9208>>>>>    Function IsRegistered String sWorkspace Returns Boolean
9210>>>>>        Boolean bRegistered
9210>>>>>        Handle hoIniFile
9210>>>>>        String sVdfRootDir
9210>>>>>        
9210>>>>>        Get Create U_cIniFile to hoIniFile
9211>>>>>        
9211>>>>>        Get_Profile_String "Defaults" "VdfRootDir" to sVdfRootDir
9214>>>>>        If (Right(sVdfRootDir,1) <>"\") ;            Move (sVdfRootDir +"\") to sVdfRootDir
9217>>>>>        Set psFilename of hoIniFile to (sVdfRootDir +"bin\Workspaces.ini")
9218>>>>>        Move (SectionExists(hoIniFile, sWorkspace)) to bRegistered
9219>>>>>        
9219>>>>>        Send Destroy of hoIniFile
9220>>>>>        
9220>>>>>        Function_Return bRegistered
9221>>>>>    End_Function
9222>>>>>    
9222>>>>>    Function VdfSystemDfPath Returns String
9224>>>>>        String sSystemDfPath
9224>>>>>        Get_Profile_String "Workspaces" "SystemDfPath" to sSystemDfPath
9227>>>>>        
9227>>>>>        Function_Return sSystemDfPath
9228>>>>>    End_Function
9229>>>>>    
