6151>>>>>    
6151>>>>>    Procedure SetActiveImageList Handle hoImageList
6153>>>>>        Handle hWnd
6153>>>>>        tWinButton_ImageList BIL
6153>>>>>        tWinButton_ImageList BIL
6153>>>>>        Handle hIml
6153>>>>>        Integer i
6153>>>>>        Get Form_Window_Handle to hWnd
6154>>>>>        If (hWnd) Begin
6156>>>>>            If (hoImageList) Begin
6158>>>>>                Get Window_Handle of hoImageList to hIml
6159>>>>>            End
6159>>>>>>
6159>>>>>            Move hIml to BIL.himl
6160>>>>>            Get piImageMarginLeft to BIL.margin.left
6161>>>>>            Get piImageMarginRight to BIL.margin.right
6162>>>>>            Get piImageMarginTop to BIL.margin.top
6163>>>>>            Get piImageMarginBottom to BIL.margin.bottom
6164>>>>>            Get peImageAlign to BIL.uAlign
6165>>>>>            Move (SendMessage(hwnd, BCM_SETIMAGELIST, 0, AddressOf(BIL))) to i
6166>>>>>        End
6166>>>>>>
6166>>>>>    End_Procedure
6167>>>>>    
6167>>>>>    Procedure Set psImage String sImage
6169>>>>>        Handle hoButtonImageList hoOldImage hWnd
6169>>>>>        Integer iImageSize
6169>>>>>        Set psPrivateImage to sImage
6170>>>>>        Get phoExternalButtonImageList to hoButtonImageList
6171>>>>>        // if external button list, we ignore psImage
6171>>>>>        If (hoButtonImageList=0) Begin
6173>>>>>            // remove old internal image list, create new one if needed
6173>>>>>            Get phoInternalButtonImageList to hoOldImage
6174>>>>>            Set phoInternalButtonImageList to 0
6175>>>>>            Get Window_Handle to hWnd
6176>>>>>            If hWnd Begin
6178>>>>>                If (sImage<>"") Begin
6180>>>>>                    Get piImageSize to iImageSize
6181>>>>>                    Get CreateButtonImageList sImage iImageSize iImageSize to hoButtonImageList
6182>>>>>                    Set phoInternalButtonImageList to hoButtonImageList
6183>>>>>                End
6183>>>>>>
6183>>>>>                Send SetActiveImageList hoButtonImageList // if 0, will clear list
6184>>>>>            End
6184>>>>>>
6184>>>>>            If hoOldImage Begin
6186>>>>>                Send Destroy of hoOldImage
6187>>>>>            End
6187>>>>>>
6187>>>>>        End
6187>>>>>>
6187>>>>>    End_Procedure
