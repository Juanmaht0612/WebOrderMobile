35880>>>>>>>    //
35880>>>>>>>    // Enumerate all errors.
35880>>>>>>>    // For each error send iMsg to hObj passing all required error
35880>>>>>>>    // information: iErr#, sErrorMsg, iLine, iFile, iField
35880>>>>>>>    //
35880>>>>>>>    Procedure EnumerateErrors Integer iMsg Integer hObj
35882>>>>>>>        Integer iCount i
35882>>>>>>>        Get ErrorCount to iCount
35883>>>>>>>        Decrement iCount
35884>>>>>>>        For i from 0 to iCount
35890>>>>>>>>
35890>>>>>>>            Send ErrorReportCallback i iMsg hObj
35891>>>>>>>        Loop
35892>>>>>>>>
35892>>>>>>>    End_Procedure
35893>>>>>>>    
35893>>>>>>>    // if item is -1 it is last error
35893>>>>>>>    Procedure ErrorReportCallback Integer iItem Integer iMsg Integer hObj
35895>>>>>>>        String  sErrMsg
35895>>>>>>>        Integer iFileNr iFieldNr iErrNr iLineNr
35895>>>>>>>        Integer iCount
35895>>>>>>>        Get ErrorCount to iCount
35896>>>>>>>        If (iItem=-1) ;            Move (iCount-1) to iItem // if -1, use last error
35899>>>>>>>        If (iItem>=0 and iCount>iItem) Begin
35901>>>>>>>            Get Error_ErrNr   iItem to iErrNr
35902>>>>>>>            Get Error_ErrMsg  iItem to sErrMsg
35903>>>>>>>            Get Error_LineNr  iItem to iLineNr
35904>>>>>>>            Get Error_FileNr  iItem to iFileNr
35905>>>>>>>            Get Error_FieldNr iItem to iFieldNr
35906>>>>>>>            Send iMsg to hObj iErrNr sErrMsg iLineNr iFileNr iFieldNr
35907>>>>>>>        End
35907>>>>>>>>
35907>>>>>>>    End_Procedure
35908>>>>>>>    
35908>>>>>>>    // this is used to remove a single error from the queue
35908>>>>>>>    // if iItem is -1, last error
35908>>>>>>>    Procedure ClearError Integer iItem
35910>>>>>>>        Integer iCount
35910>>>>>>>        Get ErrorCount to iCount
35911>>>>>>>        If (iItem=-1) ;            Move (iCount-1) to iItem // if -1, use last error
35914>>>>>>>        If (iItem>=0 and iCount>iItem) Begin
35916>>>>>>>            Send Delete_Item iItem
35917>>>>>>>            Send Delete_Item to oErrorText iItem
35918>>>>>>>            Send Delete_Item to oLineNr    iItem
35919>>>>>>>            Send Delete_Item to oFileNr    iItem
35920>>>>>>>            Send Delete_Item to oFieldNr   iItem
35921>>>>>>>        End
35921>>>>>>>>
35921>>>>>>>    End_Procedure
