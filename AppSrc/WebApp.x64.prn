1947>>>>>Use VersionControl.pkg   // version control checking commands and procedure
Including file: VersionControl.pkg    (C:\Program Files\DataFlex 26.0\Pkg\VersionControl.pkg)
1947>>>>>>>//This is an internal pakcage and is USEd within vdfbase.pkg
1947>>>>>>>//
1947>>>>>>>//This contains two compiler commands and one Runtime command:
1947>>>>>>>//Validate_Fmac Ver# Rev# Build#
1947>>>>>>>//    If version number in fmac is not equal to or greater than the value
1947>>>>>>>//    passed here, a compile error is declared. This command is invoked within this
1947>>>>>>>//    package. The Version numbers are stored in fmac as :
1947>>>>>>>//          FMAC_Version FMAC_Revision FMAC_Build
1947>>>>>>>//    The required version numbers are defined in dfbase.pkg as:
1947>>>>>>>//          Required_FMAC_Version Required_FMAC_Revision Required_FMAC_Build
1947>>>>>>>
1947>>>>>>>
1947>>>>>>>//Validate_Packages Ver# Rev# Build#
1947>>>>>>>//    If version number of package is not equal to or greater than the value
1947>>>>>>>//    passed here, a compile error is declared. The package number is defined in
1947>>>>>>>//    dfbase.pkg as:
1947>>>>>>>//          PKG_Version PKG_Revision PKG_Build
1947>>>>>>>//    This is not invoked automatically but may be added to a developer's
1947>>>>>>>//    program. You must define and pass the minimum required version numbers.
1947>>>>>>>
1947>>>>>>>//Send ValidateVersion
1947>>>>>>>//   This is called at runtime (and is called by this package). It insures that the
1947>>>>>>>//   runtime version (which is stored in dfrun.dll) is equal to or greater than the
1947>>>>>>>//   minimum required runtime version. The minimum is defined in dfbase.pkg as:
1947>>>>>>>//        Required_RT_Version Required_RT_Revision Required_RT_Build
1947>>>>>>>Use LanguageText.pkg
1947>>>>>>>Use GlobalFunctionsProcedures.pkg
1947>>>>>>>
1947>>>>>>>// Validate fmac version against a passed minumum
1947>>>>>>>
1947>>>>>>>// Validate fmac version against a passed minumum
1947>>>>>>>
1947>>>>>>>Procedure gValidate$Version Global Integer iReqVersion Integer iReqRevision Integer iReqBuild
1949>>>>>>>    Integer iVersion iRevision iBuild
1949>>>>>>>    Version_Information iVersion iRevision iBuild
1951>>>>>>>    //
1951>>>>>>>    If (iVersion < iReqVersion or ;        (iVersion=iReqVersion and iRevision<iReqRevision) or ;        (iVersion=iReqVersion and iRevision=iReqRevision and iBuild<iReqBuild) ) Begin
1953>>>>>>>        
1953>>>>>>>        Error DFERR_WRONG_REVISION (SFormat(C_$RuntimePackageMismatch, iVersion, iRevision, iBuild, iReqVersion, iReqRevision, iReqBuild))
1954>>>>>>>>
1954>>>>>>>        
1954>>>>>>>        Abort
1955>>>>>>>>
1955>>>>>>>    End
1955>>>>>>>>
1955>>>>>>>End_Procedure
1956>>>>>>>
1956>>>>>>>// This will gen compiler error if fmac is too old
1956>>>>>>>Validate_Fmac Required_FMAC_Version Required_FMAC_Revision Required_FMAC_Build
1956>>>>>>>// This generates a runtime error packages are old
