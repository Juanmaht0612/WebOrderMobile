29688>>>>>>>>>    // special Request_Find logic for web-lists. cWebColumn will direct a Request_Find
29688>>>>>>>>>    // to here. This understands non-data aware and static lists and ignores those
29688>>>>>>>>>    // requests. It also understands peRequestFindMode which can filter out finds that
29688>>>>>>>>>    // don't make sense in a grid.
29688>>>>>>>>>    
29688>>>>>>>>>    Procedure Request_Find Integer eFindMode
29690>>>>>>>>>        Integer iFile iField iIndex iMain iRelField 
29690>>>>>>>>>        Integer eRequestFindMode eDbGridType
29690>>>>>>>>>        Boolean bFound
29690>>>>>>>>>        Handle hoServer
29690>>>>>>>>>        Boolean bAllowSwitch bDataAware
29690>>>>>>>>>        
29690>>>>>>>>>        // only data aware grids process request_find
29690>>>>>>>>>        Get pbDataAware to bDataAware
29691>>>>>>>>>        If not bDataAware Begin
29693>>>>>>>>>            Move False to Found
29694>>>>>>>>>            Procedure_Return
29695>>>>>>>>>        End
29695>>>>>>>>>>
29695>>>>>>>>>        
29695>>>>>>>>>        // find mode determines what kind of finding is supported
29695>>>>>>>>>        Get peRequestFindMode to eRequestFindMode
29696>>>>>>>>>        
29696>>>>>>>>>        // if finding not allowed at all, no find
29696>>>>>>>>>        If (eRequestFindMode=rfmFindNone) Begin
29698>>>>>>>>>            Move False to Found
29699>>>>>>>>>            Procedure_Return
29700>>>>>>>>>        End
29700>>>>>>>>>>
29700>>>>>>>>>
29700>>>>>>>>>        Get peDbGridType to eDbGridType
29701>>>>>>>>>        Get Server to hoServer
29702>>>>>>>>>        Get Data_File to iFile
29703>>>>>>>>>        Get Data_Field to iField
29704>>>>>>>>>
29704>>>>>>>>>        If (hoServer=0 or iFile=0) Begin
29706>>>>>>>>>            Move False to Found
29707>>>>>>>>>            Procedure_Return
29708>>>>>>>>>        End
29708>>>>>>>>>>
29708>>>>>>>>>
29708>>>>>>>>>        Get Main_File of hoServer to iMain
29709>>>>>>>>>        
29709>>>>>>>>>        // if no finding index, no find
29709>>>>>>>>>        Get File_Field_Index of hoServer iFile iField to iIndex
29710>>>>>>>>>        If (iIndex=-1) Begin
29712>>>>>>>>>            Move False to Found
29713>>>>>>>>>            Procedure_Return
29714>>>>>>>>>        End
29714>>>>>>>>>>
29714>>>>>>>>>            
29714>>>>>>>>>        // if this is a main file find we will ignore it if main-file finds are
29714>>>>>>>>>        // not allowed or the grid is static. If Static, you should not be doing finds
29714>>>>>>>>>        // on the mainfile as it will cause the data to all be reloaded.
29714>>>>>>>>>        If (iFile=iMain and ( (eRequestFindMode=rfmFindParentOnly) or (eDbGridType<>gtAutomatic) ) ) Begin
29716>>>>>>>>>            Move False to Found
29717>>>>>>>>>            Procedure_Return
29718>>>>>>>>>        End
29718>>>>>>>>>>
29718>>>>>>>>>        // if main or find all or findparentonly (with a parent find)
29718>>>>>>>>>        Else If (iFile=iMain or eRequestFindMode=rfmFindAll or eRequestFindMode=rfmFindParentOnly ) Begin
29721>>>>>>>>>            Send Item_Find of hoServer eFindMode iFile iField True True False
29722>>>>>>>>>            Move (Found) to bFound
29723>>>>>>>>>        End
29723>>>>>>>>>>
29723>>>>>>>>>        // if parent with find mainonly
29723>>>>>>>>>        Else If (eRequestFindMode=rfmFindMainOnly) Begin
29726>>>>>>>>>           Move False to Found
29727>>>>>>>>>           Procedure_Return 
29728>>>>>>>>>        End
29728>>>>>>>>>>
29728>>>>>>>>>        // is parent with find superfind logic (used by prompt lists)
29728>>>>>>>>>        Else Begin
29729>>>>>>>>>           Get RelatingField iFile to iRelField
29730>>>>>>>>>           If (iRelField=-1) Begin
29732>>>>>>>>>               Move False to Found
29733>>>>>>>>>               Procedure_Return   
29734>>>>>>>>>           End
29734>>>>>>>>>>
29734>>>>>>>>>           
29734>>>>>>>>>           // if superfind mode, which means this is a prompt list we want to be able to change the
29734>>>>>>>>>           // parent, even if committed w/ no parent switch set. 
29734>>>>>>>>>           //So Clear that parentNoSwitch for the main-dd for this parent Find and then restore it
29734>>>>>>>>>           Get ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
29735>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to False
29736>>>>>>>>>           Send Item_Find of hoServer eFindMode iFile iField True True False
29737>>>>>>>>>           Move (Found) to bFound
29738>>>>>>>>>           Set ParentNoSwitchIfCommitted of hoServer iFile to bAllowSwitch
29739>>>>>>>>>           If ( (bFound) ) Begin
29741>>>>>>>>>                Send Item_Find to hoServer GE iMain iRelField True True False
29742>>>>>>>>>                Move (Found) to bFound
29743>>>>>>>>>           End
29743>>>>>>>>>>
29743>>>>>>>>>        End
29743>>>>>>>>>>
29743>>>>>>>>>        
29743>>>>>>>>>        Move bFound to Found
29744>>>>>>>>>            
29744>>>>>>>>>    End_Procedure
