4236>>>>>    
4236>>>>>    // when the object takes the focus make sure that the default button, if any
4236>>>>>    // is highlighted. Note that buttons override this message and handle this
4236>>>>>    // a bit differently.
4236>>>>>    //
4236>>>>>    Procedure PrivateSetCurrentButton
4238>>>>>        Integer hoButton
4238>>>>>        If not (disable_default_action_button_state(Self)) Begin
4240>>>>>            Get Default_Action_Button to hoButton
4241>>>>>            If hoButton ;                Set CurrentButtonState of hoButton to True
4244>>>>>        End
4244>>>>>>
4244>>>>>    End_Procedure
4245>>>>>    
4245>>>>>    // when the object loses the focus the default button highlight must
4245>>>>>    // be removed - it will be restored, as needed, by the next object
4245>>>>>    // that takes the focus. If we do not do this, the button will not
4245>>>>>    // lose the highlight when switching between other panels and
4245>>>>>    // programs (and it should).
4245>>>>>    //
4245>>>>>    Procedure PrivateKillCurrentButton
4247>>>>>        Integer hoButton
4247>>>>>        Get Current_Action_Button to hoButton
4248>>>>>        If hoButton ;            Set CurrentButtonState of hoButton to False
4251>>>>>    End_Procedure
4252>>>>>    
4252>>>>>    // this forces a reset of the default button....This should only be sent to this
4252>>>>>    // object when it is the focus object since it is the focus that determines
4252>>>>>    // what should or should not be highlighted.
