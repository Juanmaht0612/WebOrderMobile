2264>>>>>>>    // Make sure this fits properly for a multi-display.  Adjust iCol and iRow as needed
2264>>>>>>>    Procedure AdjustForMultiDisplay  Integer iHeight Integer iWidth Integer ByRef iCol Integer ByRef iRow
2266>>>>>>>        Integer iScreenHt iScreenWd
2266>>>>>>>        Boolean  bOk
2266>>>>>>>        Handle hMonitor
2266>>>>>>>        tWinMonitorInfo MonitorInfo
2266>>>>>>>        tWinMonitorInfo MonitorInfo
2266>>>>>>>        
2266>>>>>>>        Move (MonitorFromPoint(iCol, iRow, MONITOR_DEFAULTONPRIMARY)) to hMonitor
2267>>>>>>>        If (hMonitor=0) Begin
2269>>>>>>>            Error DFERR_PROGRAM "Cannot retrieve a monitor handle."
2270>>>>>>>>
2270>>>>>>>            Procedure_Return
2271>>>>>>>        End
2271>>>>>>>>
2271>>>>>>>        Move (SizeOfType(tWinMonitorInfo)) to MonitorInfo.cbSize
2272>>>>>>>        Move (GetMonitorInfo(hMonitor, AddressOf(MonitorInfo))) to bOK
2273>>>>>>>        If (not(bOK)) Begin
2275>>>>>>>            Error DFERR_PROGRAM "Cannot retrieve monitor info."
2276>>>>>>>>
2276>>>>>>>            Procedure_Return
2277>>>>>>>        End
2277>>>>>>>>
2277>>>>>>>        
2277>>>>>>>        // Get the height & width of the target monitor
2277>>>>>>>        Move MonitorInfo.rcWork.bottom to iScreenHt              // height to the bottom of the monitor's work area
2278>>>>>>>        Move MonitorInfo.rcWork.right  to iScreenWd              // width to the right of the monitor's work area
2279>>>>>>>        
2279>>>>>>>        If (iRow + iHeight > iScreenHt) Begin
2281>>>>>>>            Move (iScreenHt - iHeight ) to iRow
2282>>>>>>>        End
2282>>>>>>>>
2282>>>>>>>        
2282>>>>>>>        If (iCol + iWidth > iScreenWd) Begin
2284>>>>>>>            Move (iScreenWd - iWidth ) to iCol
2285>>>>>>>        End
2285>>>>>>>>
2285>>>>>>>        
2285>>>>>>>        // Test that the adjusted Row & column still exists on some monitor....
2285>>>>>>>        Move (MonitorFromPoint(iCol, iRow, MONITOR_DEFAULTONNULL)) to hMonitor
2286>>>>>>>        
2286>>>>>>>        If (hMonitor = 0) Begin
2288>>>>>>>            // If the location is not on any monitor then set the location to 2,2....
2288>>>>>>>            Move 2 to iCol
2289>>>>>>>            Move 2 to iRow
2290>>>>>>>        End
2290>>>>>>>>
2290>>>>>>>    End_Procedure
2291>>>>>>>    
2291>>>>>>>    
2291>>>>>>>    // Procedure Auto_Locate
2291>>>>>>>    // rewritten for 14.1 to handle multiple monitors
2291>>>>>>>    
2291>>>>>>>    Procedure Auto_Locate Handle hoInvokingObj
2293>>>>>>>        Integer iLocation iHeight iWidth iRow iColumn iPhysSize iRowOffset iColOffset
2293>>>>>>>        If (hoInvokingObj > Desktop) Begin
2295>>>>>>>            Get Absolute_GUIOrigin of hoInvokingObj to iLocation  // location of inv obj
2296>>>>>>>            Move (Hi(iLocation)) to iRow                         // row
2297>>>>>>>            Move (Low(iLocation)) to iColumn                        // col
2298>>>>>>>            If (iColumn>32767) Begin
2300>>>>>>>                Move (iColumn - 65536 ) to iColumn
2301>>>>>>>            End
2301>>>>>>>>
2301>>>>>>>            If (iRow>32767) Begin
2303>>>>>>>                Move (iRow - 65536 ) to iRow
2304>>>>>>>            End
2304>>>>>>>>
2304>>>>>>>            
2304>>>>>>>            Get Physical_FontSize to iPhysSize // size of the font
2305>>>>>>>            Get Row_Offset to iRowOffset
2306>>>>>>>            Get Column_Offset to iColOffset
2307>>>>>>>            Move (iRow + (iRowOffset * (Hi(iPhysSize)+4)) ) to iRow
2308>>>>>>>            Move (iColumn + (iColOffset * (Low(iPhysSize)+4)) ) to iColumn
2309>>>>>>>            
2309>>>>>>>            Get GuiWindowSize to iLocation
2310>>>>>>>            Move (Hi(iLocation))  to iHeight
2311>>>>>>>            Move (Low(iLocation)) to iWidth
2312>>>>>>>            
2312>>>>>>>            Send AdjustForMultiDisplay  iHeight iWidth (&iColumn) (&iRow)
2313>>>>>>>            Set GuiLocation to iRow iColumn
2314>>>>>>>            Send Adjust_Logicals
2315>>>>>>>        End
2315>>>>>>>>
2315>>>>>>>    End_Procedure
2316>>>>>>>    
2316>>>>>>>    //  Locate Panel on Screen/df desktop/current panel
2316>>>>>>>    // rewritten for 14.1 to handle multiple monitors
2316>>>>>>>    Procedure Locate_Panel
2318>>>>>>>        Handle hoTarget hoFocus
2318>>>>>>>        Integer iSize iLocation
2318>>>>>>>        Integer iScreenHt iScreenWd iScreenRow iScreenCol
2318>>>>>>>        Integer iHeight iWidth iRow iCol
2318>>>>>>>        Integer eLocateMode
2318>>>>>>>        Boolean bModal
2318>>>>>>>        
2318>>>>>>>        Get Locate_Mode to eLocateMode
2319>>>>>>>        Get Focus of Desktop to hoFocus
2320>>>>>>>        
2320>>>>>>>        If (eLocateMode=SMART_LOCATE) Begin
2322>>>>>>>            Get GuiLocation to iLocation
2323>>>>>>>            Get Modal_State to bModal
2324>>>>>>>            If (bModal and hoFocus>Desktop and hoFocus<>Self) Begin
2326>>>>>>>                Move POPUP_LOCATE to eLocateMode
2327>>>>>>>            End
2327>>>>>>>>
2327>>>>>>>            Else If (iLocation<>0) Begin
2330>>>>>>>                Procedure_Return
2331>>>>>>>            End
2331>>>>>>>>
2331>>>>>>>            Else Begin
2332>>>>>>>                Delegate Get Main_Panel_Id to hoTarget
2334>>>>>>>                Move (If(hoTarget>Desktop, CENTER_ON_PANEL, CENTER_ON_SCREEN)) to eLocateMode
2335>>>>>>>            End
2335>>>>>>>>
2335>>>>>>>        End
2335>>>>>>>>
2335>>>>>>>        
2335>>>>>>>        If (eLocateMode=POPUP_LOCATE) Begin
2337>>>>>>>            If (hoFocus>Desktop and hoFocus<>Self) Begin
2339>>>>>>>                Send Auto_Locate hoFocus
2340>>>>>>>            End
2340>>>>>>>>
2340>>>>>>>            Procedure_Return
2341>>>>>>>        End
2341>>>>>>>>
2341>>>>>>>        
2341>>>>>>>        
2341>>>>>>>        // this was changed for 12.1 to work better when the panel is not nested in another panel
2341>>>>>>>        // If center on parent, it will check if the parent is the desktop - if so, it will try center on panel
2341>>>>>>>        // If center on panel is not in a panel, it will try to center in the main panel. If
2341>>>>>>>        // there is no main panel, it will center on screen.
2341>>>>>>>        
2341>>>>>>>        // if center on parent, use the parent. If there is no parent, try center on panel
2341>>>>>>>        If (eLocateMode=CENTER_ON_PARENT) Begin
2343>>>>>>>            Get Parent to hoTarget
2344>>>>>>>            If (hoTarget<=Desktop) Begin
2346>>>>>>>                Move CENTER_ON_PANEL to eLocateMode
2347>>>>>>>            End
2347>>>>>>>>
2347>>>>>>>        End
2347>>>>>>>>
2347>>>>>>>        
2347>>>>>>>        If (eLocateMode=CENTER_ON_PANEL) Begin
2349>>>>>>>            Delegate Get Main_Panel_ID to hoTarget
2351>>>>>>>            // if this does not have a panel, attempt to center on main panel
2351>>>>>>>            If (hoTarget=0) Begin
2353>>>>>>>                Get Main_Window of Desktop to hoTarget
2354>>>>>>>            End
2354>>>>>>>>
2354>>>>>>>        End
2354>>>>>>>>
2354>>>>>>>        
2354>>>>>>>        // only do this if the object exists and is not the desktop
2354>>>>>>>        If (hoTarget and hoTarget>Desktop) Begin
2356>>>>>>>            Get Absolute_GUIOrigin of hoTarget to iLocation
2357>>>>>>>            Get GuiClientSize of hoTarget to iSize
2358>>>>>>>        End
2358>>>>>>>>
2358>>>>>>>        Else Begin
2359>>>>>>>            // this is the center on the primary screen and is our fallback position if
2359>>>>>>>            // the other modes don't work right
2359>>>>>>>            Move (GuiScreen_Size(1)) to iSize
2360>>>>>>>            Move 0 to iLocation
2361>>>>>>>        End
2361>>>>>>>>
2361>>>>>>>        
2361>>>>>>>        // this is the origin row and column of "the containing" object
2361>>>>>>>        Move (Hi(iLocation))  to iScreenRow
2362>>>>>>>        Move (Low(iLocation))  to iScreenCol
2363>>>>>>>        If (iScreenCol > 32767) Begin
2365>>>>>>>            Move (iScreenCol - 65536 ) to iScreenCol
2366>>>>>>>        End
2366>>>>>>>>
2366>>>>>>>        If (iScreenRow > 32767) Begin
2368>>>>>>>            Move (iScreenRow - 65536 ) to iScreenRow
2369>>>>>>>        End
2369>>>>>>>>
2369>>>>>>>        
2369>>>>>>>        // this is the height and width of the "containing" object or screen
2369>>>>>>>        Move (Hi(iSize)) to iScreenHt
2370>>>>>>>        Move (Low(iSize)) to iScreenWd
2371>>>>>>>        
2371>>>>>>>        // this is the height and width of the actual object we are locating
2371>>>>>>>        Get GuiWindowSize to iSize
2372>>>>>>>        Move (hi(iSize))   to iHeight
2373>>>>>>>        Move (low(iSize))  to iWidth
2374>>>>>>>        // ideal location should be in the center
2374>>>>>>>        Move ( (iScreenHt - iHeight)/2 + iScreenRow) to iRow
2375>>>>>>>        Move ( (iScreenWd - iWidth)/2 + iScreenCol) to iCol
2376>>>>>>>        
2376>>>>>>>        // now adjust it to fit
2376>>>>>>>        Send AdjustForMultiDisplay  iHeight iWidth (&iCol) (&iRow)
2377>>>>>>>        
2377>>>>>>>        Set GuiLocation to iRow iCol
2378>>>>>>>        Send Adjust_Logicals
2379>>>>>>>    End_Procedure
