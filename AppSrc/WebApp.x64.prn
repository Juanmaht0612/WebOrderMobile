8792>>>>>>>        Get FindKey (&aIniData[iSection]) sKey to iKey
8793>>>>>>>        Function_Return (iKey <> -1)
8794>>>>>>>    End_Function
8795>>>>>>>    
8795>>>>>>>    /*    Deletes a section and all of its keys from the ini data. To apply the changes to disk call     WriteToFile.    */
8795>>>>>>>    Procedure RemoveSection String sSection
8797>>>>>>>        tIniSection[] aIniData
8797>>>>>>>        tIniSection[] aIniData
8798>>>>>>>        Integer iSection iKey
8798>>>>>>>        
8798>>>>>>>        Get FindSection sSection to iSection
8799>>>>>>>        If (iSection <> -1) Begin
8801>>>>>>>            Get paIniData to aIniData
8802>>>>>>>       
8802>>>>>>>            Move (RemoveFromArray(aIniData, iSection)) to aIniData
8803>>>>>>>            Set paIniData to aIniData
8804>>>>>>>        End
8804>>>>>>>>
8804>>>>>>>    End_Procedure
8805>>>>>>>    
8805>>>>>>>    /*    Deletes a key from the ini data, an error will occur if the key did not exist. To apply the     changes to disk call WriteToFile.    */
8805>>>>>>>    Procedure RemoveKey String sSection String sKey
8807>>>>>>>        tIniSection[] aIniData
8807>>>>>>>        tIniSection[] aIniData
8808>>>>>>>        Integer iSection iKey
8808>>>>>>>        
8808>>>>>>>        Get FindSection sSection to iSection
8809>>>>>>>        If (iSection <> -1) Begin
8811>>>>>>>            Get paIniData to aIniData
8812>>>>>>>            Get FindKey (&aIniData[iSection]) sKey to iKey
8813>>>>>>>            If (iKey <> -1) Begin
8815>>>>>>>                Move (RemoveFromArray(aIniData[iSection].aValues, iKey)) to aIniData[iSection].aValues
8816>>>>>>>                
8816>>>>>>>                //  Remove empty section
8816>>>>>>>                If (SizeOfArray(aIniData[iSection].aValues) = 0) ;                    Move (RemoveFromArray(aIniData, iSection)) to aIniData
8819>>>>>>>                
8819>>>>>>>                Set paIniData to aIniData
8820>>>>>>>            End
8820>>>>>>>>
8820>>>>>>>        End
8820>>>>>>>>
8820>>>>>>>    End_Procedure
8821>>>>>>>    
8821>>>>>>>    /*    Returns all sections that are defined in the ini data. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
8821>>>>>>>    Function Sections Returns String[]
8823>>>>>>>        tIniSection[] aIniData
8823>>>>>>>        tIniSection[] aIniData
8824>>>>>>>        Integer iSection iSectionTo
8824>>>>>>>        String[] aSections
8825>>>>>>>        
8825>>>>>>>        Get paIniData to aIniData
8826>>>>>>>        
8826>>>>>>>        Move (SizeOfArray(aIniData) - 1) to iSectionTo
8827>>>>>>>        For iSection from 0 to iSectionTo
8833>>>>>>>>
8833>>>>>>>            If (pbCaseSensitive(Self)) ;                Move aIniData[iSection].sName to aSections[iSection]
8836>>>>>>>            Else ;                Move aIniData[iSection].sCaseName to aSections[iSection]
8838>>>>>>>        Loop
8839>>>>>>>>
8839>>>>>>>        
8839>>>>>>>        Function_Return aSections
8840>>>>>>>    End_Function
8841>>>>>>>    
8841>>>>>>>    /*    Returns all keys available within the provided section. Note that this works on the data in     memory, call ReadFromFile to load an ini file from disk.    */
8841>>>>>>>    Function Keys String sSection Returns String[]
8843>>>>>>>        String[] aKeys
8844>>>>>>>        tIniSection[] aIniData
8844>>>>>>>        tIniSection[] aIniData
8845>>>>>>>        Integer iVal iValTo iSection
8845>>>>>>>        
8845>>>>>>>        Get FindSection sSection to iSection
8846>>>>>>>        If (iSection = -1) Begin
8848>>>>>>>            If (pbReportReadErrors(Self)) ;                Error DFERR_INI_FILE "Ini file section does not exist."
8851>>>>>>>        End
8851>>>>>>>>
8851>>>>>>>        Else Begin
8852>>>>>>>            Get paIniData to aIniData
8853>>>>>>>            Move (SizeOfArray(aIniData[iSection].aValues) - 1) to iValTo
8854>>>>>>>            
8854>>>>>>>            For iVal from 0 to iValTo
8860>>>>>>>>
8860>>>>>>>                If (not(aIniData[iSection].aValues[iVal].bComment)) Begin
8862>>>>>>>                    If (pbCaseSensitive(Self)) ;                        Move aIniData[iSection].aValues[iVal].sName to aKeys[iVal]
8865>>>>>>>                    Else ;                        Move aIniData[iSection].aValues[iVal].sCaseName to aKeys[iVal]
8867>>>>>>>                End
8867>>>>>>>>
8867>>>>>>>            Loop
8868>>>>>>>>
8868>>>>>>>        End
8868>>>>>>>>
8868>>>>>>>        
8868>>>>>>>        Function_Return aKeys
8869>>>>>>>    End_Function
8870>>>>>>>    
8870>>>>>>>End_Class
8871>>>>>>>
8871>>>>>>>
8871>>>>>>>/*Reads and writes ini files directly. Is compatible with the classic cIniFile.*/
8871>>>>>>>Class cIniFile is a cIniProcessor
8872>>>>>>>    Procedure Construct_Object
8874>>>>>>>        Forward Send Construct_Object
8876>>>>>>>        
8876>>>>>>>        Set pbReportReadErrors to False
8877>>>>>>>    End_Procedure
8878>>>>>>>    
8878>>>>>>>    Function OpenForWrite Returns Boolean
8880>>>>>>>        Boolean bSuccess bExists
8880>>>>>>>        
8880>>>>>>>        File_Exist (psFileName(Self)) bExists
8881>>>>>>>        
8881>>>>>>>        If (bExists) Begin
8883>>>>>>>            Get ReadFromFile to bSuccess
8884>>>>>>>            If (not(bSuccess)) ;                Function_Return False
8887>>>>>>>        End
8887>>>>>>>>
8887>>>>>>>        Else Begin
8888>>>>>>>            If (trim(psFileName(Self))="") Begin
8890>>>>>>>                Error DFERR_INI_FILE "Ini file name not defined"
8891>>>>>>>>
8891>>>>>>>                Function_Return False
8892>>>>>>>            End
8892>>>>>>>>
8892>>>>>>>        End
8892>>>>>>>>
8892>>>>>>>        
8892>>>>>>>        Function_Return True
8893>>>>>>>    End_Function
8894>>>>>>>    
8894>>>>>>>    /*    Writes a string directly to an ini file. Note that when setting multiple values it is more     efficient to use ReadFromFile, SetValue and WriteToFile separately.    */
8894>>>>>>>    Procedure WriteString String sSection String sKey String sValue
8896>>>>>>>        If (OpenForWrite(Self)) Begin
8898>>>>>>>            Send SetValue sSection sKey sValue
8899>>>>>>>        
8899>>>>>>>            Send WriteToFile
8900>>>>>>>        End
8900>>>>>>>>
8900>>>>>>>    End_Procedure
8901>>>>>>>    
8901>>>>>>>    /*    Reads a string directly to an ini file. Note that when reading multiple values it is more     efficient to call ReadFromFile and GetValue separately.    */
8901>>>>>>>    Function ReadString String sSection String sKey String sDefault Returns String
8903>>>>>>>        Boolean bSuccess
8903>>>>>>>        String sResult
8903>>>>>>>        
8903>>>>>>>        Move sDefault to sResult
8904>>>>>>>        
8904>>>>>>>        If (ReadFromFile(Self)) ;            Get GetValue sSection sKey sDefault to sResult
8907>>>>>>>            
8907>>>>>>>        Function_Return sResult    
8908>>>>>>>    End_Function
8909>>>>>>>    
8909>>>>>>>    /*    Deletes a section from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveSection and WriteToFile separately is more efficient.    */
8909>>>>>>>    Procedure DeleteSection String sSection
8911>>>>>>>        If (OpenForWrite(Self)) Begin
8913>>>>>>>            Send RemoveSection sSection
8914>>>>>>>        
8914>>>>>>>            Send WriteToFile
8915>>>>>>>        End
8915>>>>>>>>
8915>>>>>>>    End_Procedure
8916>>>>>>>    
8916>>>>>>>    /*    Deletes a key from an ini file. Note that to perform multiple manipulations calling     ReadFromFile, RemoveKey and WriteToFile separately is more efficient.    */
8916>>>>>>>    Procedure DeleteKey String sSection String sKey
8918>>>>>>>        If (OpenForWrite(Self)) Begin
8920>>>>>>>            Send RemoveKey sSection sKey
8921>>>>>>>        
8921>>>>>>>            Send WriteToFile
8922>>>>>>>        End
8922>>>>>>>>
8922>>>>>>>    End_Procedure
8923>>>>>>>    
8923>>>>>>>    /*    Checks if a key exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasKey separately.    */
8923>>>>>>>    Function KeyExists String sSection String sKey Returns Boolean
8925>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasKey(Self, sSection, sKey))
8928>>>>>>>            
8928>>>>>>>        Function_Return False
8929>>>>>>>    End_Function
8930>>>>>>>    
8930>>>>>>>    /*    Checks if a section exists in an ini file. When checking for multiple keys it is more     efficient to call ReadFromFile and HasSection separately.    */
8930>>>>>>>    Function SectionExists String sSection Returns Boolean
8932>>>>>>>        If (ReadFromFile(Self)) ;            Function_Return (HasSection(Self, sSection))
8935>>>>>>>            
8935>>>>>>>        Function_Return False
8936>>>>>>>    End_Function
8937>>>>>>>    
8937>>>>>>>    /*    Reads the sections into the provided array object. Here for compatibility only, please use the     Sections function that returns an array.    */
8937>>>>>>>    Procedure ReadSections Handle hoArray
8939>>>>>>>        String[] aSections
8940>>>>>>>        Integer iSection iSectionTo
8940>>>>>>>        
8940>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
8943>>>>>>>            
8943>>>>>>>        Get Sections to aSections
8944>>>>>>>        
8944>>>>>>>        Move (SizeOfArray(aSections) - 1) to iSectionTo
8945>>>>>>>        For iSection from 0 to iSectionTo
8951>>>>>>>>
8951>>>>>>>            Set Value of hoArray iSection to aSections[iSection]
8952>>>>>>>        Loop
8953>>>>>>>>
8953>>>>>>>    End_Procedure
8954>>>>>>>    
8954>>>>>>>    /*    Reads the keys of a section into the provided array object. Here for compatibility only,     please use the Keys function that retuns an array.    */
8954>>>>>>>    Procedure ReadSection String sSection Handle hoArray
8956>>>>>>>        String[] aKeys
8957>>>>>>>        Integer iKey iKeyTo
8957>>>>>>>        
8957>>>>>>>        If (not(ReadFromFile(Self))) ;            Procedure_Return
8960>>>>>>>        
8960>>>>>>>        Get Keys sSection to aKeys
8961>>>>>>>        
8961>>>>>>>        Move (SizeOfArray(aKeys) - 1) to iKeyTo
8962>>>>>>>        For iKey from 0 to iKeyTo
8968>>>>>>>>
8968>>>>>>>            Set Value of hoArray iKey to aKeys[iKey]
8969>>>>>>>        Loop
8970>>>>>>>>
8970>>>>>>>    End_Procedure
8971>>>>>>>End_Class
