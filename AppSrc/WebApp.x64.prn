7914>>>>>>>    
7914>>>>>>>    Function WinCombo_Current_Item Returns Integer
7916>>>>>>>        Function_Return (SendMessage(Window_Handle(Self), CB_GETCURSEL,0,0))
7917>>>>>>>    End_Function
7918>>>>>>>    
7918>>>>>>>    Function WinCombo_Value Integer item# Returns String
7920>>>>>>>        WString wsValue
7920>>>>>>>        Integer iLen
7920>>>>>>>        
7920>>>>>>>        Move (WindowsMessage(CB_GETLBTEXTLEN, item#, 0)) to iLen
7921>>>>>>>        Move (Pad(wsValue, iLen + 1)) to wsValue
7922>>>>>>>        
7922>>>>>>>        Send Windows_Message CB_GETLBTEXT item# (AddressOf(wsValue))
7923>>>>>>>        Function_Return (CString(wsValue))
7924>>>>>>>    End_Function
7925>>>>>>>    
7925>>>>>>>    Function Validate_Combo_Value Returns Integer
7927>>>>>>>        String val
7927>>>>>>>        Integer ival
7927>>>>>>>        Get value 0 to val
7928>>>>>>>        Move ( (Val='' and allow_Blank_state(Self) ) or ;            (Combo_item_matching(Self,Val)>=0) ) to ival
7929>>>>>>>        Function_Return (not(ival)) // 1=bad, 0=ok
7930>>>>>>>    End_Function
