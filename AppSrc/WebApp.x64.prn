715>>>>>>>>>    Function ConvertSystemColor Integer iColor Returns Integer
717>>>>>>>>>        Integer iSysColor
717>>>>>>>>>        If (iColor = clDefault or iColor = clNone) Begin    // If default color then use -1
719>>>>>>>>>            Move clNone to iColor
720>>>>>>>>>        End
720>>>>>>>>>>
720>>>>>>>>>        Else If (iColor < 0) Begin    // If it is a system color (<0) then convert this into an RGB value
723>>>>>>>>>            Move (iColor iand |CI$7FFFFFFF) to iSysColor    // extract the system color constant
724>>>>>>>>>            Move (GetSysColor(iSysColor)) to iColor
725>>>>>>>>>        End
725>>>>>>>>>>
725>>>>>>>>>        Function_Return iColor
726>>>>>>>>>    End_Function
