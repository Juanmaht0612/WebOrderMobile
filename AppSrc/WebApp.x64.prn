1334>>>>>>>>>// Does an alternte clock style Mod() operation. Modulo vs. Dividend
1334>>>>>>>>>// This is only different from Mod when iNum is negative.
1334>>>>>>>>>// Mod(-1,6) returns -1
1334>>>>>>>>>// ModAlt(-1,6) returns 5
1334>>>>>>>>>//
1334>>>>>>>>>Function ModAlt Global BigInt iNum BigInt iDivisor Returns Integer
1336>>>>>>>>>    Integer iRet
1336>>>>>>>>>    Move (Mod(iNum,iDivisor)) to iRet
1337>>>>>>>>>    Function_Return (If(iRet<0, iRet + Abs(iDivisor), iRet))
1338>>>>>>>>>End_Function
1339>>>>>>>>>
1339>>>>>>>>>//
1339>>>>>>>>>// Splits a string into an array of strings using the given delimiter.
1339>>>>>>>>>//
1339>>>>>>>>>// Params:
1339>>>>>>>>>//     sString     The string to split.
1339>>>>>>>>>//     sDel        The delimiter (like "," or "|")
1339>>>>>>>>>// Returns:
1339>>>>>>>>>//     Array of strings (not including the delimiters itself.
1339>>>>>>>>>Function StrSplitToArray Global String sString String sDel Returns String[]
1341>>>>>>>>>    String[] asResult
1342>>>>>>>>>    Integer iStart iEnd iDel
1342>>>>>>>>>    
1342>>>>>>>>>    If (sString <> "") Begin
1344>>>>>>>>>        
1344>>>>>>>>>        Move 1 to iStart
1345>>>>>>>>>        
1345>>>>>>>>>        Move (Length(sDel)) to iDel
1346>>>>>>>>>        Move (Pos(sDel, sString, iStart)) to iEnd
1347>>>>>>>>>        
1347>>>>>>>>>        If (iEnd > 0) Begin
1349>>>>>>>>>            While (iEnd > 0)
1353>>>>>>>>>                Move (Mid(sString,  iEnd - iStart, iStart)) to asResult[SizeOfArray(asResult)]
1354>>>>>>>>>                
1354>>>>>>>>>                Move (iEnd + iDel) to iStart
1355>>>>>>>>>                Move (Pos(sDel, sString, iStart)) to iEnd
1356>>>>>>>>>            Loop
1357>>>>>>>>>>
1357>>>>>>>>>            
1357>>>>>>>>>            Move (Right(sString,  Length(sString) - iStart + 1)) to asResult[SizeOfArray(asResult)]
1358>>>>>>>>>        End
1358>>>>>>>>>>
1358>>>>>>>>>        Else Begin
1359>>>>>>>>>            Move sString to asResult[0]
1360>>>>>>>>>        End
1360>>>>>>>>>>
1360>>>>>>>>>    End
1360>>>>>>>>>>
1360>>>>>>>>>    
1360>>>>>>>>>    
1360>>>>>>>>>    Function_Return asResult
1361>>>>>>>>>End_Function
1362>>>>>>>>>
1362>>>>>>>>>
1362>>>>>>>>>//
1362>>>>>>>>>//  Joins an array of strings into a single string delimited by the provided separator.
1362>>>>>>>>>//
1362>>>>>>>>>//  Params:
1362>>>>>>>>>//      aStr        Array of strings.
1362>>>>>>>>>//      sDel        Delimiter string.
1362>>>>>>>>>//  Returns:
1362>>>>>>>>>//      Strings joined into single string.
1362>>>>>>>>>//
1362>>>>>>>>>Function StrJoinFromArray Global String[] aStr String sDel Returns String
1364>>>>>>>>>    Integer i iTo
1364>>>>>>>>>    String sResult sValue
1364>>>>>>>>>    
1364>>>>>>>>>    Move (SizeOfArray(aStr) - 1) to iTo
1365>>>>>>>>>    For i from 0 to iTo
1371>>>>>>>>>>
1371>>>>>>>>>        If (i > 0) Begin
1373>>>>>>>>>            Move aStr[i] to sValue  //  Move to string value first to enforce proper conversion might someone pass a different type of array
1374>>>>>>>>>            Move (sResult + sDel + sValue) to sResult
1375>>>>>>>>>        End
1375>>>>>>>>>>
1375>>>>>>>>>        Else Begin
1376>>>>>>>>>            Move aStr[i] to sResult
1377>>>>>>>>>        End
1377>>>>>>>>>>
1377>>>>>>>>>    Loop
1378>>>>>>>>>>
1378>>>>>>>>>    
1378>>>>>>>>>    Function_Return sResult
1379>>>>>>>>>End_Function
