16898>>>>>>>    Procedure OnDDValue String sWebBpo String sFile String sField DWord iOption String sParam String ByRef sValueOut
16900>>>>>>>        Integer hObjId iError
16900>>>>>>>        Get MapWPONametoID sWebBpo to hObjId // will generate an error if not found
16901>>>>>>>        
16901>>>>>>>        If hObjId ;            Get DoGetDDValue of hObjId sFile sField iOption sParam (&sValueOut) to iError
16904>>>>>>>        Else ;            Move 1 to iError
16906>>>>>>>
16906>>>>>>>    End_Procedure
16907>>>>>>>    
16907>>>>>>>    // Note that DfFunc and Call both map to this location. From this point on, it is Call
16907>>>>>>>    // This can be called as part of a webapp or a web-service. We must check and only
16907>>>>>>>    // pass these messages to the correct objects
16907>>>>>>>    // values for WebAppEndPointEnvironment in function CurrentWebAppEnvironment
16907>>>>>>>    Procedure OnDFFunc String sWebBpo UChar[] llrequest UChar[] ByRef llresponse UInteger ByRef llpdwError
16909>>>>>>>        Integer hObjId iVoid
16909>>>>>>>        Integer eWebAppEndPointEnvironment
16909>>>>>>>        tWASCallData callData
16909>>>>>>>        tWASCallData callData
16909>>>>>>>        
16909>>>>>>>        Get CurrentWebAppEnvironment to eWebAppEndPointEnvironment
16910>>>>>>>        If (eWebAppEndPointEnvironment=WebAppEnvASP) Begin
16912>>>>>>>            Get MapWPONametoID sWebBpo to hObjId // will generate an error if not found
16913>>>>>>>        End
16913>>>>>>>>
16913>>>>>>>        Else If (eWebAppEndPointEnvironment=WebAppEnvWebService) Begin
16916>>>>>>>            Get MapWSONametoID sWebBpo to hObjId // will generate an error if not found
16917>>>>>>>        End
16917>>>>>>>>
16917>>>>>>>        
16917>>>>>>>        
16917>>>>>>>        Move (AddressOf(llrequest)) to callData.pRequest
16918>>>>>>>        Move (SizeOfArray(llrequest)) to callData.iRequestSize
16919>>>>>>>        
16919>>>>>>>        Move 0 to callData.pResponse
16920>>>>>>>        Move 0 to callData.iResponseSize
16921>>>>>>>        
16921>>>>>>>        Move 0 to callData.dwError
16922>>>>>>>        
16922>>>>>>>        // It really can't be none, but if it is, the id will be 0 anyway
16922>>>>>>>        If hObjId ;            Get DoCall of hObjId (AddressOf(callData)) to llpdwError
16925>>>>>>>        Else ;            Move 1 to llpdwError
16927>>>>>>>        
16927>>>>>>>        If (callData.pResponse <> 0) Begin
16929>>>>>>>            Move (ResizeArray(llresponse, callData.iResponseSize, 0)) to llresponse
16930>>>>>>>            Move (CopyMemory(AddressOf(llresponse), callData.pResponse, callData.iResponseSize)) to iVoid
16931>>>>>>>            Move (Free(callData.pResponse)) to iVoid
16932>>>>>>>        End
16932>>>>>>>>
16932>>>>>>>    End_Procedure
16933>>>>>>>    
16933>>>>>>>    Procedure OnHttpRequest String lllpszWbo String lllpszMethod String lllpszPath String lllpszQueryString String lllpszContentType String lllpszAcceptType DWord lliSize DWord ByRef llpdwError
16935>>>>>>>        Integer hObjId iError
16935>>>>>>>        Integer eWebAppEndPointEnvironment
16935>>>>>>>        
16935>>>>>>>        //  Make sure this unsigned value shows as unsigned
16935>>>>>>>        Move 0 to iError
16936>>>>>>>        Move lliSize to lliSize
16937>>>>>>>        
16937>>>>>>>        Get CurrentWebAppEnvironment to eWebAppEndPointEnvironment
16938>>>>>>>        If (eWebAppEndPointEnvironment=WebAppHttpModule) Begin
16940>>>>>>>            Get MapHttpHNameToID lllpszWbo to hObjId // will generate an error if not found
16941>>>>>>>        End
16941>>>>>>>>
16941>>>>>>>        
16941>>>>>>>        // It really can't be none, but if it is, the id will be 0 anyway
16941>>>>>>>        If hObjId ;            Send HandleHttpRequest of hObjId lllpszMethod lllpszPath lllpszQueryString lllpszContentType lllpszAcceptType lliSize
16944>>>>>>>        Else ;            Move 1 to iError
16946>>>>>>>        
16946>>>>>>>        // Always write result error to indicate that we did finish
16946>>>>>>>        Move iError to llpdwError
16947>>>>>>>    End_Procedure
16948>>>>>>>    
16948>>>>>>>    Procedure OnRequestFindByRecId String sWBO String sFile String sRecId DWord ByRef dwError
16950>>>>>>>        Integer hObjId
16950>>>>>>>        Get MapWPONametoID sWBO to hObjId // will generate an error if not found
16951>>>>>>>        If hObjId ;            Get DoRequestFindByRecId of hObjId sFile sRecId to dwError
