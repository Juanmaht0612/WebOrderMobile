31257>>>>>>>    
31257>>>>>>>    
31257>>>>>>>    // This method is received by the Web Control that is the target of a CallAction that is sent
31257>>>>>>>    // from the client. Augmented to perform format conversion for parameters passed to OnSearch.
31257>>>>>>>    // methods.
31257>>>>>>>    Function HandleAction String sAction String[] aParams Handle hoAttachment Returns String
31259>>>>>>>        Integer i icParameters iCol
31259>>>>>>>        Integer eDataType
31259>>>>>>>        Handle hoCol
31259>>>>>>>        String sReturnVal
31259>>>>>>>        
31259>>>>>>>        // Get the parameter count
31259>>>>>>>        Move (SizeOfArray(aParams)) to icParameters
31260>>>>>>>        
31260>>>>>>>        // Special Case: OnChange
31260>>>>>>>        If (Uppercase(sAction) = "ONSEARCH") Begin
31262>>>>>>>            // If the action is an OnSearch event then we must test if the data type is a number, 
31262>>>>>>>            // Date or DateTime. If so we must convert each parameter value from the universal 
31262>>>>>>>            // transfer format
31262>>>>>>>            WebGet piSortColumn to iCol
31263>>>>>>>    
31263>>>>>>>            If (iCol >= 0) Begin
31265>>>>>>>                // Query the data type of the current sort column
31265>>>>>>>                Get GetColumnObject iCol to hoCol
31266>>>>>>>                Get peDataType of hoCol to eDataType
31267>>>>>>>                // Note: For efficienty we do not WebGet peDataType! In other words we do not
31267>>>>>>>                // get the "synchronized copy of peDataType (if there is one). This is much more
31267>>>>>>>                // efficient but it also assumes that a control's peDataType does not change 
31267>>>>>>>                // dynamically. This should be OK
31267>>>>>>>                
31267>>>>>>>                // Send Hook for converting the value to format for transport.
31267>>>>>>>                For i from 0 to (icParameters - 1)
31273>>>>>>>>
31273>>>>>>>                    Move (ConvertFromClient(eDataType, aParams[i])) to aParams[i]
31274>>>>>>>                Loop
31275>>>>>>>>
31275>>>>>>>            End
31275>>>>>>>>
31275>>>>>>>        End
31275>>>>>>>>
31275>>>>>>>        
31275>>>>>>>        // Now call the superclass's implementation of HandleAction 
31275>>>>>>>        Forward Get HandleAction sAction aParams hoAttachment to sReturnVal
31277>>>>>>>        
31277>>>>>>>        Function_Return sReturnVal
31278>>>>>>>    End_Function
31279>>>>>>>    
31279>>>>>>>    // Augment to make sure LoadDataPage is allowed when the control is disabled as well.
31279>>>>>>>    Procedure AllowServerAction Boolean  ByRef bAllow String sMethodName Handle hoMessage Boolean bIsFunction
31281>>>>>>>        If (hoMessage = RefProc(LoadDataPage)) Begin
31283>>>>>>>            Get IsControlAccessible False True to bAllow
31284>>>>>>>        End
31284>>>>>>>>
31284>>>>>>>        Else Begin
31285>>>>>>>            Forward Send AllowServerAction (&bAllow) sMethodName hoMessage bIsFunction
31287>>>>>>>        End
31287>>>>>>>>
31287>>>>>>>    End_Procedure
31288>>>>>>>        
