33990>>>>>>>        For iCur from 0 to iTo
33996>>>>>>>>
33996>>>>>>>            If (aFolders[iCur] = Left(sPath, Length(aFolders[iCur]))) Begin
33998>>>>>>>                Function_Return True
33999>>>>>>>            End
33999>>>>>>>>
33999>>>>>>>        Loop
34000>>>>>>>>
34000>>>>>>>        
34000>>>>>>>        Function_Return False
34001>>>>>>>    End_Function
