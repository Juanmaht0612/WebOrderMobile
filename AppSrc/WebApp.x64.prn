3388>>>>>    Procedure Autosize String Val
3390>>>>>        Integer Ext
3390>>>>>        Get Text_Extent Val to Ext
3391>>>>>        Set Guisize to (Hi(Ext)+3) (Low(Ext)+2)
3392>>>>>        Send Adjust_logicals
3393>>>>>    End_Procedure
3394>>>>>    
3394>>>>>    Procedure Shadow_Display
3396>>>>>        Integer iMode iEnable
3396>>>>>        Get Label_Shadow_Display_Mode to iMode
3397>>>>>        If ( ( (iMode=TBSHADOW_ON_GROUP or iMode=TBSHADOW_ON_ALL) and ;            (Implicit_Shadow_State(Self)) ) or ;            ( (iMode=TBSHADOW_ON_LOCAL or iMode=TBSHADOW_ON_ALL) and ;            Explicit_Shadow_State(Self) ) ) ;            Move 0 to iEnable
3400>>>>>        Else ;            Move 1 to iEnable
3402>>>>>        Send Enable_Window iEnable
3403>>>>>    End_Procedure
3404>>>>>    
3404>>>>>    Procedure Enable_Window Integer iState
3406>>>>>        Handle hWnd
3406>>>>>        Get Window_Handle to hWnd
3407>>>>>        If hWnd ;            Move (EnableWindow(hWnd,iState)) to hWnd
3410>>>>>    End_Procedure
3411>>>>>    
3411>>>>>    Procedure Page_Object Integer iState
3413>>>>>        Handle hWnd
3413>>>>>        Get Window_Handle to hWnd
3414>>>>>        Forward Send Page_Object iState
3416>>>>>        
3416>>>>>        // Handle tooltip support....
3416>>>>>        If (iState = 0) Begin
3418>>>>>            Send RequestDeleteToolTip
3419>>>>>        End
3419>>>>>>
3419>>>>>        Else Begin
3420>>>>>            Send RequestAddToolTip
3421>>>>>        End
3421>>>>>>
3421>>>>>        
3421>>>>>        If (hWnd=0 and iState) Begin
3423>>>>>            Send Shadow_Display
3424>>>>>        End
3424>>>>>>
3424>>>>>    End_Procedure
3425>>>>>    
3425>>>>>    
