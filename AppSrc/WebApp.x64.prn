3530>>>>>    
3530>>>>>    Function Create_Label_Object Returns Integer
3532>>>>>        Boolean bOn bTestColor
3532>>>>>        Integer iVal iValP
3532>>>>>        String sVal sValP
3532>>>>>        Handle hoLabel
3532>>>>>        
3532>>>>>        Get Label_object to hoLabel
3533>>>>>        If (hoLabel=0) Begin
3535>>>>>            
3535>>>>>            Object Tb is a AutoLabel
3537>>>>>                Move Self to hoLabel
3538>>>>>            End_Object
3539>>>>>            Set Owner_Object of hoLabel to Self
3540>>>>>            
3540>>>>>            // following added in 15.0 for greater label font support
3540>>>>>            // With the exception of italics and underline, the label will inherit it's font default
3540>>>>>            // from the parent. So we only explicitly set Label_X properties if they are non-default values
3540>>>>>            
3540>>>>>            Delegate Get Font to iVal
3542>>>>>            Set Font of hoLabel to iVal
3543>>>>>            
3543>>>>>            Send AdjustLabelColors hoLabel // sets Color and TextColor of label
3544>>>>>            
3544>>>>>            Get Label_Typeface to sVal
3545>>>>>            If (sVal<>"") Begin
3547>>>>>                Delegate Get Typeface to sValP
3549>>>>>                If (sVal<>sValP) Begin
3551>>>>>                    Set Typeface of hoLabel to sVal
3552>>>>>                End
3552>>>>>>
3552>>>>>            End
3552>>>>>>
3552>>>>>            
3552>>>>>            Get Label_FontSize to iVal
3553>>>>>            If (iVal<>0) Begin
3555>>>>>                Delegate Get FontSize to iValP
3557>>>>>                If (iVal<>iValP) Begin
3559>>>>>                    Set FontSize of hoLabel to (Hi(iVal)) (Low(iVal))
3560>>>>>                End
3560>>>>>>
3560>>>>>            End
3560>>>>>>
3560>>>>>            
3560>>>>>            Get Label_FontPointHeight to iVal
3561>>>>>            If (iVal<>-1) Begin
3563>>>>>                Delegate Get FontPointHeight to iValP
3565>>>>>                If (iVal<>iValP) Begin
3567>>>>>                    Set FontPointHeight of hoLabel to iVal
3568>>>>>                End
3568>>>>>>
3568>>>>>            End
3568>>>>>>
3568>>>>>            
3568>>>>>            Get Label_FontWeight to iVal
3569>>>>>            If (iVal<>0) Begin
3571>>>>>                Delegate Get FontWeight to iValP
3573>>>>>                If (iVal<>iValP) Begin
3575>>>>>                    Set FontWeight of hoLabel to iVal
3576>>>>>                End
3576>>>>>>
3576>>>>>            End
3576>>>>>>
3576>>>>>            
3576>>>>>            // This is not 100% backwards compatible but we will assume that nonone intentionally sets
3576>>>>>            // the control's italics and underline and wants it to appear in label. We are treating the old behavior
3576>>>>>            // as a bug
3576>>>>>            Get Label_FontItalics to iVal
3577>>>>>            Delegate Get FontItalics to iValP
3579>>>>>            If (iVal<>iValP) Begin
3581>>>>>                Set FontItalics of hoLabel to iVal
3582>>>>>            End
3582>>>>>>
3582>>>>>            
3582>>>>>            Get Label_FontUnderline to iVal
3583>>>>>            Delegate Get FontUnderline to iValP
3585>>>>>            If (iVal<>iValP) Begin
3587>>>>>                Set FontUnderline of hoLabel to iVal
3588>>>>>            End
3588>>>>>>
3588>>>>>            
3588>>>>>            Set Label_object to hoLabel
3589>>>>>            
3589>>>>>        End
3589>>>>>>
3589>>>>>        Function_Return hoLabel
3590>>>>>        
3590>>>>>    End_Function
3591>>>>>    
3591>>>>>    // Allow label object to be destroyed. If active, first deactivate
3591>>>>>    // Only destroy if the object is gone,
3591>>>>>    //
3591>>>>>    Procedure Destroy_Label_Object
3593>>>>>        Handle hoLabel hWnd
3593>>>>>        Get Label_object to hoLabel
3594>>>>>        If hoLabel Begin // only if label exists already
3596>>>>>            // if label is paged it must be unpaged. We must check
3596>>>>>            // window handle because this label is not in the focus tree (it's paged)
3596>>>>>            Get Window_Handle of hoLabel to hWnd
3597>>>>>            If (hWnd) Begin
3599>>>>>                Send Page_Object of hoLabel False
3600>>>>>            End
3600>>>>>>
3600>>>>>            Send Destroy of hoLabel    // destroy object and mark it as gone
3601>>>>>            Set Label_object to 0
3602>>>>>        End
3602>>>>>>
3602>>>>>    End_Procedure
3603>>>>>    
3603>>>>>    Procedure Destroy_Object
3605>>>>>        Send Destroy_Label_Object  // make sure label is destroyed first
3606>>>>>        Forward Send Destroy_Object
