5094>>>>>    Procedure DoApplyAnchors Integer x Integer y
5096>>>>>        Integer iOldSize iNewSize iOldDyn
5096>>>>>        // since doAdjustGridWidths might cause painting, shut off
5096>>>>>        // dynamic_update_state so that a grid paint only occurs one time.
5096>>>>>        Get dynamic_update_state to iOldDyn
5097>>>>>        Set dynamic_update_state to False
5098>>>>>        Get guisize to iOldSize
5099>>>>>        Forward Send DoApplyAnchors x y
5101>>>>>        Get guisize to iNewSize
5102>>>>>        Move (low(iNewSize)-low(iOldSize)) to iNewSize
5103>>>>>        If (iNewSize<>0) ;            Send DoAdjustGridWidths iNewSize
5106>>>>>        If iOldDyn ;            Set dynamic_update_state to 2 // 2=only paint what needs painting, and then set state to true
5109>>>>>    End_Procedure
5110>>>>>    
5110>>>>>    // adjust columns when anchors change. Uses delta value passed and property
5110>>>>>    // piResizeColumn
5110>>>>>    Procedure DoadjustGridWidths Integer iGuiDelta
5112>>>>>        Integer iResizeColumn eResizeColumn
5112>>>>>        Integer iCols iCol iColWidth
5112>>>>>        Integer i iWidth
5112>>>>>        Integer iRemain
5112>>>>>        Get peResizeColumn to eResizeColumn
5113>>>>>        If (eResizeColumn=rcLastColumn) Begin
5115>>>>>            Get line_size to iCols
5116>>>>>            Set form_guiwidth (iCols-1) to (form_guiwidth(Self,iCols-1)+iGuiDelta)
5117>>>>>        End
5117>>>>>>
5117>>>>>        Else If (eResizeColumn=rcAll) Begin
5120>>>>>            Get line_size to iCols
5121>>>>>            Move (iGuiDelta/iCols) to iColWidth
5122>>>>>            Move (abs(mod(iGuiDelta,iCols))) to iRemain
5123>>>>>            Get piLastResizedColumn to iCol
5124>>>>>            For i from 1 to iCols
5130>>>>>>
5130>>>>>                Move (mod(iCol+1,iCols)) to iCol
5131>>>>>                Move iColWidth to iWidth
5132>>>>>                If (iRemain>0) Begin
5134>>>>>                    Move (iWidth + If(iGuiDelta>0,1,-1)) to iWidth
5135>>>>>                    Decrement iRemain
5136>>>>>                    If (iRemain=0) ;                        Set piLastResizedColumn to iCol
5139>>>>>                End
5139>>>>>>
5139>>>>>                If (iWidth<>0) ;                    Set form_guiwidth iCol to (form_guiwidth(Self,iCol)+iWidth)
5142>>>>>            Loop
5143>>>>>>
5143>>>>>        End
5143>>>>>>
5143>>>>>        Else If (eResizeColumn=rcSelectedColumn) Begin
5146>>>>>            Get line_size to iCols
5147>>>>>            Get piResizeColumn to iResizeColumn
5148>>>>>            If (iResizeColumn<iCols and iResizeColumn>=0) ;                Set form_guiwidth iResizeColumn to (form_guiwidth(Self,iResizeColumn)+iGuiDelta)
5151>>>>>        End
5151>>>>>>
5151>>>>>        // else if must be rcNone...do nothing
5151>>>>>    End_Procedure
