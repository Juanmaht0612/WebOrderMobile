6193>>>>>    // not used here. provided to keep compiler happy
6193>>>>>    Procedure SetPopupLocation Integer iY Integer iX
6195>>>>>    End_Procedure
6196>>>>>    
6196>>>>>    Procedure OnDropDown
6198>>>>>        Handle hoDrop
6198>>>>>        Integer iLoc iSize iRow iCol
6198>>>>>        Get phoButtonPopup to hoDrop
6199>>>>>        If hoDrop Begin
6201>>>>>            // note that hoButtonPopup assumes that the popup
6201>>>>>            // understands Popup and SetPopupLocation
6201>>>>>            
6201>>>>>            // Get button location....
6201>>>>>            Get Absolute_GuiOrigin to iLoc
6202>>>>>            Move (Hi(iLoc)) to iRow
6203>>>>>            Move (Low(iLoc)) to iCol
6204>>>>>            
6204>>>>>            If (iCol>32767) Begin    // adjust row and column for negative co-ordinates!
6206>>>>>                Move (iCol - 65536 ) to iCol
6207>>>>>            End
6207>>>>>>
6207>>>>>            If (iRow>32767) Begin
6209>>>>>                Move (iRow - 65536 ) to iRow
6210>>>>>            End
6210>>>>>>
6210>>>>>            
6210>>>>>            Get GuiSize to iSize
6211>>>>>            Send SetPopupLocation of hoDrop (iRow+Hi(iSize)) iCol
6212>>>>>            Send Popup to hoDrop
6213>>>>>        End
6213>>>>>>
6213>>>>>    End_Procedure
6214>>>>>    
6214>>>>>    
6214>>>>>    Procedure Page_Object Integer iState
6216>>>>>        Integer iStyle iSize
6216>>>>>        Handle hoButtonImageList
6216>>>>>        Boolean bShield
6216>>>>>        String sLabel sImage
6216>>>>>        
6216>>>>>        If (iState =1) Begin
6218>>>>>            Move (WS_CHILD + WS_VISIBLE +BS_PUSHBUTTON) to iStyle
6219>>>>>            If (MultiLineState(Self)) ;                Add BS_MULTILINE to iStyle
6222>>>>>            If (FlatState(Self)) ;                Add BS_FLAT      to iStyle
6225>>>>>            
6225>>>>>            Get phoExternalButtonImageList to hoButtonImageList
6226>>>>>            If (hoButtonImageList=0) Begin
6228>>>>>                Get phoInternalButtonImageList to hoButtonImageList
6229>>>>>            End
6229>>>>>>
6229>>>>>            Get Label to sLabel
6230>>>>>            Get psImage to sImage
6231>>>>>            If (sLabel="" and (hoButtonImageList or sImage<>"")) Begin
6233>>>>>                // this will create an image only button
6233>>>>>                Move (iStyle ior (BS_BITMAP)) to iStyle
6234>>>>>            End
6234>>>>>>
6234>>>>>            Set Form_Style 0 to iStyle
6235>>>>>            Forward Send Page_Object iState
6237>>>>>            
6237>>>>>            If (hoButtonImageList=0 and sImage<>"") Begin
6239>>>>>                Get piImageSize to iSize
6240>>>>>                Get CreateButtonImageList sImage iSize iSize to hoButtonImageList
6241>>>>>                Set phoInternalButtonImageList to hoButtonImageList
6242>>>>>            End
6242>>>>>>
6242>>>>>            
6242>>>>>            Get pbShield to bShield
6243>>>>>            If bShield Begin
6245>>>>>                Send SetWinShield bShield
6246>>>>>            End
6246>>>>>>
6246>>>>>            Else If hoButtonImageList Begin
6249>>>>>                Send SetActiveImageList hoButtonImageList
6250>>>>>            End
6250>>>>>>
6250>>>>>            Send RequestAddToolTip
6251>>>>>        End
6251>>>>>>
6251>>>>>        Else Begin
6252>>>>>            Forward Send Page_Object iState
6254>>>>>            Send RequestDeleteToolTip
6255>>>>>        End
6255>>>>>>
6255>>>>>    End_Procedure
