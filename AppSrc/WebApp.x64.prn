33846>>>>>>>>>        
33846>>>>>>>>>            //  Element always starts with boundary
33846>>>>>>>>>            Get FindToken (&parsedata) parsedata.ucBoundary True False to iOffset
33847>>>>>>>>>            If (iOffset < 0) Begin
33849>>>>>>>>>                Set piParseErrorCode to 3
33850>>>>>>>>>                Set psParseError to "Invalid request format: expected boundary"
33851>>>>>>>>>                Function_Return False
33852>>>>>>>>>            End
33852>>>>>>>>>>
33852>>>>>>>>>            
33852>>>>>>>>>            
33852>>>>>>>>>            //  Find the next boundary
33852>>>>>>>>>            Get FindToken (&parsedata) parsedata.ucBoundary False False to parsedata.iBoundPos
33853>>>>>>>>>            
33853>>>>>>>>>            //  Parse the element header
33853>>>>>>>>>            Get FindToken (&parsedata) (StringToUCharArray("Content-Disposition")) True True to iOffset
33854>>>>>>>>>            If (iOffset > 0) Begin
33856>>>>>>>>>                
33856>>>>>>>>>                
33856>>>>>>>>>                //  Extract field name
33856>>>>>>>>>                Get FindToken (&parsedata) (StringToUCharArray('name="')) True True to iOffset
33857>>>>>>>>>                Get ExtractField (&parsedata) (StringToUCharArray('"')) True to sFieldname
33858>>>>>>>>>                
33858>>>>>>>>>                //  Look for file name
