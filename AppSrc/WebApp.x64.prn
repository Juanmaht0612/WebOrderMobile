6525>>>>>>>    Procedure Page Integer iState
6527>>>>>>>        If (iState =1) Begin
6529>>>>>>>            Set Window_Style to TCS_FORCEICONLEFT True // only used if fixed-width
6530>>>>>>>            Set Window_Style to TCS_MULTILINE    (Private.MultiLine_State(Self))
6531>>>>>>>            Set Window_Style to TCS_RIGHTJUSTIFY (Private.TabWidth_Mode(Self) = twRightJustify)
6532>>>>>>>            Set Window_Style to TCS_RAGGEDRIGHT  (Private.TabWidth_Mode(Self) = twRaggedRight)
6533>>>>>>>            Set Window_Style to TCS_FIXEDWIDTH   (Private.TabWidth_Mode(Self) = twFixedWidth)
6534>>>>>>>            Set Window_Style to TCS_BOTTOM       (private_peTabPosition(Self) = tpBottom)
6535>>>>>>>            Set Window_Style to TCS_BUTTONS      (private_peTabStyle(Self) <> tsTabs)
6536>>>>>>>            Set Window_Style to TCS_FLATBUTTONS  (private_peTabStyle(Self) = tsFlatButtons)
6537>>>>>>>            Set Window_Style to TCS_HOTTRACK     (pbHotTrack(Self))
6538>>>>>>>        End
6538>>>>>>>>
6538>>>>>>>        
6538>>>>>>>        Forward Send Page iState
6540>>>>>>>        
6540>>>>>>>        If (iState =1) Begin
6542>>>>>>>            If (private_pbFlatSeparators(Self) =False) ;                Send Windows_Message TCM_SETEXTENDEDSTYLE TCS_EX_FLATSEPARATORS 0 // windows creates flat separators by default, and we may not want them!
6545>>>>>>>            Send OnDisplay
6546>>>>>>>            Send private_DoUpdateTabs
6547>>>>>>>            Send OnResize
6548>>>>>>>        End
6548>>>>>>>>
6548>>>>>>>    End_Procedure
