29550>>>>>>>>>    // Return the best index for this column. If -1, there is no good index
29550>>>>>>>>>
29550>>>>>>>>>    Function DefaultIndex Returns Integer
29552>>>>>>>>>        Integer iFile iField iMainFile iIndex iFieldIndex
29552>>>>>>>>>        Integer iRelField eRequestFindMode
29552>>>>>>>>>        Handle hoDDO
29552>>>>>>>>>  
29552>>>>>>>>>        Get Server to hoDDO
29553>>>>>>>>>        Get Data_File  to iFile
29554>>>>>>>>>        Get Data_Field to iField
29555>>>>>>>>>        
29555>>>>>>>>>        // If we are attached to a data binding then apply the data dictionary attributes....
29555>>>>>>>>>        If ((hoDDO = 0) or (iFile = 0)) Begin
29557>>>>>>>>>            Function_Return -1
29558>>>>>>>>>        End
29558>>>>>>>>>>
29558>>>>>>>>>
29558>>>>>>>>>        Get Main_File of hoDDO to iMainFile
29559>>>>>>>>>        
29559>>>>>>>>>        // we don't use the DD FieldIndex message because it respects a DD Ordering override
29559>>>>>>>>>        If (iField>0) Begin
29561>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of iFile iField to iFieldIndex
29564>>>>>>>>>            Move (If(iFieldIndex=0,-1,iFieldIndex)) to iIndex
29565>>>>>>>>>        End
29565>>>>>>>>>>
29565>>>>>>>>>        Else Begin
29566>>>>>>>>>            Move 0 to iIndex // recnum index
29567>>>>>>>>>        End
29567>>>>>>>>>>
29567>>>>>>>>>        
29567>>>>>>>>>        If (iFile <> iMainFile and iIndex<>-1) Begin
29569>>>>>>>>>            // if field is not main-file, we normally don't sort but we allow
29569>>>>>>>>>            // one special mode for prompt lists that sorts on the main-file's
29569>>>>>>>>>            // index that relates to this parent
29569>>>>>>>>>            Delegate Get peRequestFindMode to eRequestFindMode
29571>>>>>>>>>            If (eRequestFindMode<>rfmFindMainSuper) Begin
29573>>>>>>>>>                Move -1 to iIndex
29574>>>>>>>>>            End
29574>>>>>>>>>>
29574>>>>>>>>>            Else Begin
29575>>>>>>>>>                // if non-main file and super find allowed we check for a super-find path
29575>>>>>>>>>                If (iIndex>=0) Begin
29577>>>>>>>>>                    // it has an index, now make that there is a relational link
29577>>>>>>>>>                    // between the main server file and this parent file. If not, no index
29577>>>>>>>>>                    Get RelatingField iFile to iRelField
29578>>>>>>>>>                    If (iRelField=-1) Begin
29580>>>>>>>>>                        Move -1 to iIndex
29581>>>>>>>>>                    End
29581>>>>>>>>>>
29581>>>>>>>>>                    Else Begin
29582>>>>>>>>>                        Get_Attribute DF_FIELD_INDEX of iMainFile iRelField to iIndex
29585>>>>>>>>>                    End
29585>>>>>>>>>>
29585>>>>>>>>>                End
29585>>>>>>>>>>
29585>>>>>>>>>
29585>>>>>>>>>            End
29585>>>>>>>>>>
29585>>>>>>>>>        End
29585>>>>>>>>>>
29585>>>>>>>>>        Function_Return iIndex    
29586>>>>>>>>>    End_Function
