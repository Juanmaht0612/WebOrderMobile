14399>>>>>>>>>>>    // This is not really a DD attribute (it is in the API) but it is
14399>>>>>>>>>>>    // appropriate to be accessed from the DD
14399>>>>>>>>>>>    Function Field_Label_Tag Integer iField Returns String
14401>>>>>>>>>>>        String sName
14401>>>>>>>>>>>        Integer iFile
14401>>>>>>>>>>>        Get Main_File to iFile
14402>>>>>>>>>>>        If iFile ;            Get_Attribute DF_FIELD_NAME of iFile iField to sName
14407>>>>>>>>>>>        Function_Return sName
14408>>>>>>>>>>>    End_Function
14409>>>>>>>>>>>
14409>>>>>>>>>>>    Function SmartCase String sName Returns String
14411>>>>>>>>>>>        Integer iPos iNewPos
14411>>>>>>>>>>>        String sRight
14411>>>>>>>>>>>        Move (Replaces("_",lowercase(sName)," ")) to sName
14412>>>>>>>>>>>        Move (Trim (Replaces(".",sName," "))) to sName
14413>>>>>>>>>>>        Move 1 to iPos
14414>>>>>>>>>>>        Repeat
14414>>>>>>>>>>>>
14414>>>>>>>>>>>            Move (mid(sName,255,iPos+1)) to sRight
14415>>>>>>>>>>>            Move (left(sName,iPos-1) + Uppercase(mid(sName,1,iPos)) + sRight) to sName
14416>>>>>>>>>>>            Move (Pos( " ", sRight)) to iNewPos
14417>>>>>>>>>>>            If (iNewPos = 0) ;                Break
14420>>>>>>>>>>>            Add (iNewPos+1) to iPos
14421>>>>>>>>>>>        Loop
14422>>>>>>>>>>>>
14422>>>>>>>>>>>        Function_Return sName
14423>>>>>>>>>>>    End_Function
14424>>>>>>>>>>>
14424>>>>>>>>>>>    Enumeration_List
14424>>>>>>>>>>>        Define DD_LABEL_SHORT
14424>>>>>>>>>>>        Define DD_LABEL_LONG
14424>>>>>>>>>>>        Define DD_LABEL_TAG
14424>>>>>>>>>>>    End_Enumeration_List
14424>>>>>>>>>>>
14424>>>>>>>>>>>    // Handy function to get the label for a field. Three "types" are
14424>>>>>>>>>>>    // supported:
14424>>>>>>>>>>>    // DD_LABEL_SHORT  use short, if none use long, if none use smart tag
14424>>>>>>>>>>>    // DD_LABEL_LONG   use long, if none use smart tag
14424>>>>>>>>>>>    // DD_LABEL_TAG    use smart tag
14424>>>>>>>>>>>    // If you want an explicit field name use oneof the other messages.
14424>>>>>>>>>>>    Function Field_Label Integer iField Integer iType Returns String
14426>>>>>>>>>>>        Integer iServer
14426>>>>>>>>>>>        String sValue
14426>>>>>>>>>>>        If (iType = DD_LABEL_SHORT) ;  // 0 = Short            Get Field_Label_Short iField to sValue
14429>>>>>>>>>>>        If (iType = DD_LABEL_LONG or (iType=DD_LABEL_SHORT and sValue='')) ;            Get Field_Label_Long iField to sValue
14432>>>>>>>>>>>        If (iType = DD_LABEL_TAG or sValue="") Begin
14434>>>>>>>>>>>            Get Field_Label_Tag iField to sValue
14435>>>>>>>>>>>            Get SmartCase sValue to sValue
14436>>>>>>>>>>>        End
14436>>>>>>>>>>>>
14436>>>>>>>>>>>        Function_Return sValue
14437>>>>>>>>>>>    End_Function
14438>>>>>>>>>>>
14438>>>>>>>>>>>    Function File_Field_Label Integer iFile Integer iField Integer iType Returns String
14440>>>>>>>>>>>        Integer iDSO
14440>>>>>>>>>>>        String sValue
14440>>>>>>>>>>>        Get Data_set iFile to iDSO
14441>>>>>>>>>>>        If iDSO ;            Get Field_Label of iDSO iField iType to sValue
14444>>>>>>>>>>>        Function_Return sValue
14445>>>>>>>>>>>    End_Function
