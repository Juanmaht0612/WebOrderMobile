3260>>>>>            If (Window_Handle(Self) <> 0) Begin
3262>>>>>                // If there has never been any tooltip then create one....
3262>>>>>                Get phToolWnd to hToolWnd
3263>>>>>                
3263>>>>>                If (hToolWnd = 0) Begin
3265>>>>>                    Send AddToolTip
3266>>>>>                End
