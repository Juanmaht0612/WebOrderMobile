35846>>>>>>>    // Pass Err Num, Error Msg, Line#, File, Field and error-type
35846>>>>>>>    Procedure Set_Error Integer iErrNr String sErrMsg String sFullErrMsg Integer iLineNr Integer iFileNr Integer iFieldNr
35848>>>>>>>        Integer iCount
35848>>>>>>>        Get ErrorCount to iCount
35849>>>>>>>        Set Value of oErrorNumber iCount to iErrNr
35850>>>>>>>        Set Value of oErrorText   iCount to sErrMsg
