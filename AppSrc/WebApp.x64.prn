28750>>>>>>>>>>>>>    Procedure FindSuggestions String sFilter Integer iPage Integer iAdditionalItems
28752>>>>>>>>>>>>>        tSelectionItem[] aItems
28752>>>>>>>>>>>>>        tSelectionItem[] aItems
28753>>>>>>>>>>>>>        Handle hoJson hoSelectionSource
28753>>>>>>>>>>>>>        Boolean bLast bIsObj bAllData bSuggestions bPaged
28753>>>>>>>>>>>>>        tSelectionItem prevItem
28753>>>>>>>>>>>>>        tSelectionItem prevItem
28753>>>>>>>>>>>>>        String[] aParams
28754>>>>>>>>>>>>>        Integer iPageSize
28754>>>>>>>>>>>>>            
28754>>>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
28755>>>>>>>>>>>>>        if (hoSelectionSource > 0) Begin
28757>>>>>>>>>>>>>            Get pbAllData of hoSelectionSource to bAllData
28758>>>>>>>>>>>>>            Get pbSuggestions of hoSelectionSource to bSuggestions
28759>>>>>>>>>>>>>            Get pbPaged of hoSelectionSource to bPaged
28760>>>>>>>>>>>>>        End
28760>>>>>>>>>>>>>>
28760>>>>>>>>>>>>>        Else Begin
28761>>>>>>>>>>>>>            WebGet pbAllData to bAllData
28762>>>>>>>>>>>>>            WebGet pbSuggestions to bSuggestions
28763>>>>>>>>>>>>>            WebGet pbPaged to bPaged
28764>>>>>>>>>>>>>        End
28764>>>>>>>>>>>>>>
28764>>>>>>>>>>>>>        WebGet piPageSize to iPageSize
28765>>>>>>>>>>>>>        Send ValidateSuggestionMode bAllData bSuggestions bPaged
28766>>>>>>>>>>>>>        
28766>>>>>>>>>>>>>        If (not(bPaged)) Begin
28768>>>>>>>>>>>>>            Move 0 to iPage
28769>>>>>>>>>>>>>        End
28769>>>>>>>>>>>>>>
28769>>>>>>>>>>>>>        If (not(bPaged) and not(bSuggestions)) Begin
28771>>>>>>>>>>>>>            Move 0 to iAdditionalItems
28772>>>>>>>>>>>>>        End
28772>>>>>>>>>>>>>>
28772>>>>>>>>>>>>>
28772>>>>>>>>>>>>>        // Additional items are required when selected tags are filtered out client-side.
28772>>>>>>>>>>>>>        If (bPaged or bSuggestions) ;            Move (iPageSize + iAdditionalItems) to iPageSize
28775>>>>>>>>>>>>>        
28775>>>>>>>>>>>>>        Get phoActionJsonData to hoJson
28776>>>>>>>>>>>>>        If (hoJson > 0) Begin
28778>>>>>>>>>>>>>            Get JsonToDataType of hoJson to prevItem
28779>>>>>>>>>>>>>        End
28779>>>>>>>>>>>>>>
28779>>>>>>>>>>>>>        If (not(bPaged)) Begin
28781>>>>>>>>>>>>>            Move (ResizeArray(prevItem.aValues, 0)) to prevItem.aValues
28782>>>>>>>>>>>>>            Move "" to prevItem.sRowId
28783>>>>>>>>>>>>>            Move "" to prevItem.sCssClassName
28784>>>>>>>>>>>>>            Move False to prevItem.bServer
28785>>>>>>>>>>>>>        End
28785>>>>>>>>>>>>>>
28785>>>>>>>>>>>>>        
28785>>>>>>>>>>>>>        If (hoSelectionSource > 0) Begin
28787>>>>>>>>>>>>>            Send FetchItems of hoSelectionSource (&aItems) (&bLast) sFilter prevItem iPageSize iPage
28788>>>>>>>>>>>>>            If (pbAllData(hoSelectionSource)) Begin
28790>>>>>>>>>>>>>                Move True to bLast
28791>>>>>>>>>>>>>            End
28791>>>>>>>>>>>>>>
28791>>>>>>>>>>>>>        End
28791>>>>>>>>>>>>>>
28791>>>>>>>>>>>>>        
28791>>>>>>>>>>>>>        Send OnFindSuggestions (&aItems) (&bLast) sFilter prevItem iPage
28792>>>>>>>>>>>>>        If (bSuggestions) Begin
28794>>>>>>>>>>>>>            Move True to bLast
28795>>>>>>>>>>>>>        End
28795>>>>>>>>>>>>>>
28795>>>>>>>>>>>>>        
28795>>>>>>>>>>>>>        Send InitializeCustomButtons (&aItems) bLast sFilter
28796>>>>>>>>>>>>>        
28796>>>>>>>>>>>>>        Move sFilter to aParams[0]
28797>>>>>>>>>>>>>        Move (String(bLast)) to aParams[1]
28798>>>>>>>>>>>>>        Send ClientAction "suggestHandle" aParams aItems iPage
28799>>>>>>>>>>>>>    End_Procedure
28800>>>>>>>>>>>>>    
