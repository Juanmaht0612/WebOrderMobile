1005>>>>>>>>>// define first, so we can use this for strings anywhere else.
1005>>>>>>>>>Function SFormat Global String sText ;        String s1 String s2 String s3 String s4 String s5 String s6 String s7 String s8 String s9 ;        Returns String
1007>>>>>>>>>    String sParam
1007>>>>>>>>>    Integer iArg
1007>>>>>>>>>    If (num_arguments>10) ;        Error DFERR_WRONG_NUMBER_OF_ARGUMENTS // only allow max of 9 params
1010>>>>>>>>>    Move (Replaces("%%",sText,"$%$")) to sText // %% is used when you want a single % followed by a 1-9. e.g. "%%1"=%1
1011>>>>>>>>>    For iArg from 2 to Num_Arguments
1017>>>>>>>>>>
1017>>>>>>>>>        Move iArg& to sParam
1018>>>>>>>>>        Move (Replaces("%"+String(iArg-1),sText,sParam)) to sText
1019>>>>>>>>>    Loop
1020>>>>>>>>>>
1020>>>>>>>>>    Move (Replaces("$%$",sText,"%")) to sText
1021>>>>>>>>>    Function_Return sText
1022>>>>>>>>>End_Function
1023>>>>>>>>>
1023>>>>>>>>>
1023>>>>>>>>>// This returns the appropriate window handle to be used when you need a handle for a modal windows
1023>>>>>>>>>// dialog (e.g. Message box, Open file dialog). The handle returned insures that the proper handle
1023>>>>>>>>>// is used that will provide the required modality. The runtime uses the same logic when creating
1023>>>>>>>>>// DataFlex Modal objects
1023>>>>>>>>>
1023>>>>>>>>>Function gOwnerWindowHandle Global Handle hoObj Returns Handle
1025>>>>>>>>>    Handle hWnd hwPrnt hwTest hwOwner
1025>>>>>>>>>    Boolean bEnabled
1025>>>>>>>>>    
1025>>>>>>>>>    If (hoObj<=Desktop) Begin  // if no focus, use main_window
1027>>>>>>>>>        Get Main_Window of Desktop to hoObj
1028>>>>>>>>>    End
1028>>>>>>>>>>
1028>>>>>>>>>    // find the first container handle.
1028>>>>>>>>>    If (hoObj>desktop) Begin
1030>>>>>>>>>        Get Container_Handle of hoObj to hWnd
1031>>>>>>>>>        While (hWnd=0 and hoObj>Desktop)
1035>>>>>>>>>            Get Parent of hoObj to hoObj
1036>>>>>>>>>            Get Container_Handle of hoObj to hWnd
1037>>>>>>>>>        Loop
1038>>>>>>>>>>
1038>>>>>>>>>    End
1038>>>>>>>>>>
1038>>>>>>>>>    
1038>>>>>>>>>    // 12.0 change: check to make sure we have the correct owner handle for message box. If the message
1038>>>>>>>>>    // box is getting used within a toolpanel (or any top level panel that is not the main_window panel and is
1038>>>>>>>>>    // not a modal panel) then we want to use the main_window handle. When the main panel is used it will disable all other
1038>>>>>>>>>    // top level panels (this is 12.0 r/t change). In addition we only want to do this if windows are not already disabled.
1038>>>>>>>>>    // Therefore, start with the current target handle and search its parents. If the handle or any parent is disabled, we
1038>>>>>>>>>    // don't have to do anything. Check parents until you hit a top level window (parent=0). If this top-level parent has a
1038>>>>>>>>>    // gw_owner it is not the main-window (e.g. it's a toolpanel). These we must adjust. We want to use the main-window as the
1038>>>>>>>>>    // handle, which will give us the proper modality.
1038>>>>>>>>>    // A note about GetParent. This windows message returns the parent or the owner (which is different than
1038>>>>>>>>>    // the gw_owner). Top-level modeless windows (panel, toolpanel), return a parent of 0 (and not the gw_owner). Modal panels return
1038>>>>>>>>>    // the panel that owns them, which is presumably already disabled. Therefore using GetParent works for our needs.
1038>>>>>>>>>    If hWnd Begin
1040>>>>>>>>>        Move hWnd to hwPrnt
1041>>>>>>>>>        Repeat
1041>>>>>>>>>>
1041>>>>>>>>>            Move (IsWindowEnabled(hwPrnt)) to bEnabled
1042>>>>>>>>>            If bEnabled Begin // if we encounter a disabled parent, we are done ... we don't change anything
1044>>>>>>>>>                Move (GetParent(hwPrnt)) to hwTest
1045>>>>>>>>>                If (hwTest=0) Begin // no parent, a top level window
1047>>>>>>>>>                    Move (GetWindow(hwPrnt,GW_Owner)) to hwOwner // if this has a gw_owner, we will use that owner
1048>>>>>>>>>                    // If top level window, either return it's owner or if no owner, that window
1048>>>>>>>>>                    // If no owner it is probably a panel (possibly the main window), if a owner it is probably a toolpanel
1048>>>>>>>>>                    Move (If(hwOwner,hwOwner,hwPrnt)) to hWnd // toolpanels have a gw_owner, Panels do not.
1049>>>>>>>>>                    // so this adjusts toolpanels which is what we want
1049>>>>>>>>>                    //If hwOwner Begin
1049>>>>>>>>>                    //Move hwOwner to hWnd
1049>>>>>>>>>                    //End
1049>>>>>>>>>                End
1049>>>>>>>>>>
1049>>>>>>>>>                Move hwTest to hwPrnt
1050>>>>>>>>>            End
1050>>>>>>>>>>
1050>>>>>>>>>        Until (not(bEnabled) or hwPrnt=0)
1052>>>>>>>>>    End
1052>>>>>>>>>>
1052>>>>>>>>>    Function_Return hWnd
1053>>>>>>>>>End_Function
