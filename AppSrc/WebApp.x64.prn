15849>>>>>>>>>>>
15849>>>>>>>>>>>    // Returns:
15849>>>>>>>>>>>    //       The record id string based on piPrimaryIndex.
15849>>>>>>>>>>>    Function PrimaryRecordId Returns String
15851>>>>>>>>>>>        Integer iIndex iFile iSegments iSegment iField
15851>>>>>>>>>>>        String sVal sId
15851>>>>>>>>>>>
15851>>>>>>>>>>>        Get Main_File to iFile
15852>>>>>>>>>>>        Get piPrimaryIndex to iIndex
15853>>>>>>>>>>>
15853>>>>>>>>>>>        If (iIndex < 0) Begin
15855>>>>>>>>>>>            Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
15858>>>>>>>>>>>        End
15858>>>>>>>>>>>>
15858>>>>>>>>>>>
15858>>>>>>>>>>>        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of iFile iIndex to iSegments
15861>>>>>>>>>>>        For iSegment from 1 to iSegments
15867>>>>>>>>>>>>
15867>>>>>>>>>>>            Get_Attribute DF_INDEX_SEGMENT_FIELD of iFile iIndex iSegment to iField
15870>>>>>>>>>>>
15870>>>>>>>>>>>            Get_Field_Value iFile iField to sVal
15873>>>>>>>>>>>            Move (Trim(sVal)) to sVal
15874>>>>>>>>>>>
15874>>>>>>>>>>>            //  Encode join sign for multi segment indexes
15874>>>>>>>>>>>            If (iSegments > 1) Begin
15876>>>>>>>>>>>                Move (Replaces("_", sVal, "~5F~")) to sVal
15877>>>>>>>>>>>            End
15877>>>>>>>>>>>>
15877>>>>>>>>>>>
15877>>>>>>>>>>>            If (iSegment = 1) Begin
15879>>>>>>>>>>>                Move sVal to sId
15880>>>>>>>>>>>            End
15880>>>>>>>>>>>>
15880>>>>>>>>>>>            Else Begin
15881>>>>>>>>>>>                Move (sId + "_" + sVal) to sId
15882>>>>>>>>>>>            End
15882>>>>>>>>>>>>
15882>>>>>>>>>>>
15882>>>>>>>>>>>        Loop
15883>>>>>>>>>>>>
15883>>>>>>>>>>>
15883>>>>>>>>>>>        Function_Return sId
15884>>>>>>>>>>>    End_Function
15885>>>>>>>>>>>
15885>>>>>>>>>>>
15885>>>>>>>>>>>    // Finds a record on the global buffer based on the record id.
15885>>>>>>>>>>>    //
15885>>>>>>>>>>>    // Params:
15885>>>>>>>>>>>    //       sRecordId   Record id generated by PrimaryRecordId.
15885>>>>>>>>>>>    Function FindByPrimaryRecordId String sRecordId Returns Boolean
15887>>>>>>>>>>>        Integer iIndex iFile iSegments iSegment iField
15887>>>>>>>>>>>        String[] aValues
15888>>>>>>>>>>>        String sVal
15888>>>>>>>>>>>        Boolean bTrapped
15888>>>>>>>>>>>
15888>>>>>>>>>>>        Get Main_File to iFile
15889>>>>>>>>>>>        Get piPrimaryIndex to iIndex
15890>>>>>>>>>>>
15890>>>>>>>>>>>        If (iIndex < 0) Begin
15892>>>>>>>>>>>            Get_Attribute DF_FILE_PRIMARY_INDEX of iFile to iIndex
15895>>>>>>>>>>>        End
15895>>>>>>>>>>>>
15895>>>>>>>>>>>
15895>>>>>>>>>>>        Get_Attribute DF_INDEX_NUMBER_SEGMENTS of iFile iIndex to iSegments
15898>>>>>>>>>>>
15898>>>>>>>>>>>        If (iSegments > 1) Begin
15900>>>>>>>>>>>            Move (StrSplitToArray(sRecordId, "_")) to aValues
15901>>>>>>>>>>>        End
15901>>>>>>>>>>>>
15901>>>>>>>>>>>        Else Begin
15902>>>>>>>>>>>            Move sRecordId to aValues[0]
15903>>>>>>>>>>>        End
15903>>>>>>>>>>>>
15903>>>>>>>>>>>
15903>>>>>>>>>>>        If (iSegments = SizeOfArray(aValues)) Begin
15905>>>>>>>>>>>            Clear iFile
15906>>>>>>>>>>>
15906>>>>>>>>>>>            Send Ignore_Error of Error_Object_Id 56
15907>>>>>>>>>>>            Send Ignore_Error of Error_Object_Id 11
15908>>>>>>>>>>>
15908>>>>>>>>>>>            For iSegment from 1 to iSegments
15914>>>>>>>>>>>>
15914>>>>>>>>>>>                Get_Attribute DF_INDEX_SEGMENT_FIELD of iFile iIndex iSegment to iField
15917>>>>>>>>>>>
15917>>>>>>>>>>>                Move aValues[iSegment - 1] to sVal
15918>>>>>>>>>>>                If (iSegments > 1) Begin
15920>>>>>>>>>>>                    Move (Replaces("~5F~", sVal, "_")) to sVal
15921>>>>>>>>>>>                End
15921>>>>>>>>>>>>
15921>>>>>>>>>>>
15921>>>>>>>>>>>                Set_Field_Value iFile iField to sVal
15924>>>>>>>>>>>            Loop
15925>>>>>>>>>>>>
15925>>>>>>>>>>>            Send Trap_Error of Error_Object_Id 56
15926>>>>>>>>>>>            Send Trap_Error of Error_Object_Id 11
15927>>>>>>>>>>>
15927>>>>>>>>>>>            Vfind iFile iIndex EQ
15929>>>>>>>>>>>
15929>>>>>>>>>>>            Function_Return (Found)
15930>>>>>>>>>>>        End
15930>>>>>>>>>>>>
15930>>>>>>>>>>>
15930>>>>>>>>>>>        Function_Return False
15931>>>>>>>>>>>    End_Function
15932>>>>>>>>>>>
15932>>>>>>>>>>>    // Converts a RecordId to a RowId by finding it on the global buffer.
15932>>>>>>>>>>>    //
15932>>>>>>>>>>>    // Params:
15932>>>>>>>>>>>    //       sRecordId   Record id based on piPrimaryIndex.
15932>>>>>>>>>>>    //       rRowId      (ByRef) Will be filled with the rowid.
15932>>>>>>>>>>>    // Returns:
15932>>>>>>>>>>>    //       True if the record id was valid.
15932>>>>>>>>>>>    Function RecordIdToRowId String sRecordId RowID ByRef rRowId Returns Boolean
15934>>>>>>>>>>>        Boolean bFound
15934>>>>>>>>>>>
15934>>>>>>>>>>>        Get FindByPrimaryRecordId sRecordId to bFound
15935>>>>>>>>>>>        If (bFound) Begin
15937>>>>>>>>>>>            Move (GetRowID(Main_File(Self))) to rRowId
15938>>>>>>>>>>>        End
15938>>>>>>>>>>>>
15938>>>>>>>>>>>        Else Begin
15939>>>>>>>>>>>            Move (NullRowID()) to rRowId
15940>>>>>>>>>>>        End
15940>>>>>>>>>>>>
15940>>>>>>>>>>>
15940>>>>>>>>>>>        Function_Return bFound
15941>>>>>>>>>>>    End_Function
15942>>>>>>>>>>>
15942>>>>>>>>>>>    // Converts a RowId into a record ID. Note that it performs a find on the global buffer.
15942>>>>>>>>>>>    //
15942>>>>>>>>>>>    // Params:
15942>>>>>>>>>>>    //       riRowId     RowID.
15942>>>>>>>>>>>    // Returns:
15942>>>>>>>>>>>    //       Record id based on piPrimaryIndex.
15942>>>>>>>>>>>    Function RowIdToRecordId RowID riRowId Returns String
15944>>>>>>>>>>>        Boolean bFound
15944>>>>>>>>>>>        String sRecId
15944>>>>>>>>>>>
15944>>>>>>>>>>>        If (not(IsNullRowID(riRowId))) Begin
15946>>>>>>>>>>>            Move (FindByRowID(Main_File(Self), riRowId)) to bFound
15947>>>>>>>>>>>
15947>>>>>>>>>>>            If (bFound) Begin
15949>>>>>>>>>>>                Get PrimaryRecordId to sRecId
15950>>>>>>>>>>>            End
15950>>>>>>>>>>>>
15950>>>>>>>>>>>        End
15950>>>>>>>>>>>>
15950>>>>>>>>>>>
15950>>>>>>>>>>>        Function_Return sRecId
15951>>>>>>>>>>>    End_Function
15952>>>>>>>>>>>End_Class
15953>>>>>>>>>>>
15953>>>>>>>>>>>// This message will be send as a notification message from an
15953>>>>>>>>>>>// Extended_Data_Set whenever a fieldvalue has been changed.
15953>>>>>>>>>>>// It has been defined FOR cUIObject or Desktop  here so that attached
15953>>>>>>>>>>>// DEO which do not know anything about Extended_Data_Sets don't get
15953>>>>>>>>>>>// frustrated.
15953>>>>>>>>>>>// All focusable objects and DEOs must understand this. This should be
15953>>>>>>>>>>>// changed at some point in the future.
15953>>>>>>>>>>>Function Extended_DEO_State for cUIObject Returns Integer
15955>>>>>>>>>>>End_Function
15956>>>>>>>>>>>
15956>>>>>>>>>>>
15956>>>>>>>>>>>// this command is now obsolete. use Set Field_auto_increment
15956>>>>>>>>>>>
15956>>>>>>>>>
15956>>>>>>>>>// Error handler uses this function of cWebApp (but never on cWebAppBasic)
15956>>>>>>>>>Register_Function CurrentView Returns Handle
15956>>>>>>>>>Register_Function FirstControlWithDataBinding Integer iFile Integer iField Returns Handle
15956>>>>>>>>>Register_Function ShowControlError Integer iErrNum String sErrText Returns Boolean
15956>>>>>>>>>Register_Procedure ShowError Integer iErrNum Integer iErrLine String sErrText String sCaption Boolean bUserError
15956>>>>>>>>>
15956>>>>>>>>>Class cWebErrorHandler is a cBaseErrorHandler
15957>>>>>>>>>    Procedure Construct_Object
15959>>>>>>>>>        Forward Send Construct_Object
15961>>>>>>>>>    
15961>>>>>>>>>        // this should not get set to a value until the COM object is created
15961>>>>>>>>>        // and is working. When set, the error handler knows it that it can
15961>>>>>>>>>        // send error messages to the COM handler.
15961>>>>>>>>>        Property Handle  phoInetSession  0
15962>>>>>>>>>    
15962>>>>>>>>>        // We will store Err# in the main error object
15962>>>>>>>>>        Object oErrorNumber is an Array
15964>>>>>>>>>        End_Object
15965>>>>>>>>>        Object oErrorText is an Array
15967>>>>>>>>>        End_Object
15968>>>>>>>>>        Object oFullErrorText is an Array
15970>>>>>>>>>        End_Object
15971>>>>>>>>>        Object oFileNr is an Array
15973>>>>>>>>>        End_Object
15974>>>>>>>>>        Object oFieldNr is an Array
15976>>>>>>>>>        End_Object
15977>>>>>>>>>        Object oLineNr is an Array
15979>>>>>>>>>        End_Object
15980>>>>>>>>>    End_Procedure
15981>>>>>>>>>    
15981>>>>>>>>>    Procedure UnhandledErrorDisplay Integer iErrorLine String sMessage
15983>>>>>>>>>        String sCaption
15983>>>>>>>>>        Get psUnhandledErrorCaption to sCaption
15984>>>>>>>>>        Move (Replaces("\n",sMessage,Character(13))) to sMessage
15985>>>>>>>>>        Move (Replaces("\"+Character(13), sMessage, "\n")) to sMessage
15986>>>>>>>>>        ErrorDisplay iErrorLine sMessage sCaption C_$OK C_$Copy
15987>>>>>>>>>    End_Procedure
15988>>>>>>>>>    
15988>>>>>>>>>    Procedure MessageBoxError String sErrorText Boolean bCritical
15990>>>>>>>>>        Integer iIcon iRet
15990>>>>>>>>>        Handle hoOldSelf hoFocus
15990>>>>>>>>>        Move (If(bCritical,MB_IconHand,MB_IconExclamation)) to iIcon
15991>>>>>>>>>        Move Self to hoOldSelf
15992>>>>>>>>>        Get Focus of desktop to hoFocus
15993>>>>>>>>>        If (hoFocus>desktop) ;            Move hoFocus to Self
15996>>>>>>>>>        Move (Message_Box(sErrorText, C_$ERROR, MB_Ok, iIcon)) to iRet
15997>>>>>>>>>        Move hoOldSelf to Self
15998>>>>>>>>>    End_Procedure
15999>>>>>>>>>    
15999>>>>>>>>>
15999>>>>>>>>>    
15999>>>>>>>>>    // This is the Error_Report for non AJAX style applications. This could be 
15999>>>>>>>>>    // Web Service, HTTP Handler, ASP or old style webapps. We've copied it here
15999>>>>>>>>>    // rather than trying to integrate it directly into Error_Report. It gets called by
15999>>>>>>>>>    // Error_Report as needed.
15999>>>>>>>>>    Procedure BasicErrorReport Integer iError Integer iLine String ErrMsg
16001>>>>>>>>>        String sSystemErr sMess sLabel sFile sDtl sFullError
16001>>>>>>>>>        String sStack sSystemAndStack
16001>>>>>>>>>        Integer iErrFile iErrField
16001>>>>>>>>>        Boolean bCritical bQueueErrors bLogAllErrors bLocal bHtmlErrors
16001>>>>>>>>>        Handle hoInetSession
16001>>>>>>>>>        Boolean bUnhandledSupport
16001>>>>>>>>>        Boolean bDebugging bTrapped
16001>>>>>>>>>        Integer iSrc iTxtlen
16001>>>>>>>>>        String sCaption
16001>>>>>>>>>
16001>>>>>>>>>        
16001>>>>>>>>>        Get phoInetSession to hoInetSession // this may or may not be set yet.
16002>>>>>>>>>        
16002>>>>>>>>>        Get IsCritical iError to bCritical
16003>>>>>>>>>        Get pbUnhandledErrorSupport to bUnhandledSupport
16004>>>>>>>>>        Move (IsDebuggerPresent()) to bDebugging
16005>>>>>>>>>        
16005>>>>>>>>>        // if an operator error this may be a Procedure UserError situation where the
16005>>>>>>>>>        // caption is passed in the error text. This handler does not support setting the caption so we just remove it.
16005>>>>>>>>>        // The ajax superclass handler will support this
16005>>>>>>>>>        If (iError=DFERR_OPERATOR) Begin
16007>>>>>>>>>            Move (pos(C_ErrorCaption,ErrMsg)) to iSrc
16008>>>>>>>>>            If iSrc Begin
16010>>>>>>>>>                Move (length(C_ErrorCaption)) to  iTxtLen
16011>>>>>>>>>                Move (remove(ErrMsg, 1, iSrc-1 + iTxtLen )) to sCaption // will not get used here
16012>>>>>>>>>                Move (Left(ErrMsg,iSrc-1)) to ErrMsg
16013>>>>>>>>>            End
16013>>>>>>>>>>
16013>>>>>>>>>        End
16013>>>>>>>>>>
16013>>>>>>>>>        
16013>>>>>>>>>        Get Error_Description iError ErrMsg  to sSystemErr
16014>>>>>>>>>        
16014>>>>>>>>>        // if the error source is identified we can get extended error
16014>>>>>>>>>        // text for our error message. This capability is a standard part
16014>>>>>>>>>        // of VDF5
16014>>>>>>>>>        If ghoErrorSource Begin
16016>>>>>>>>>            // These messages were just added to the DD.
16016>>>>>>>>>            Get Extended_Error_file   of ghoErrorSource to iErrFile
16017>>>>>>>>>            Get Extended_Error_Field  of ghoErrorSource to iErrField
16018>>>>>>>>>            // we are making the assumption that ghoErrorSource is a DD object
16018>>>>>>>>>            // If it is not, we will have problems.....but it will be!
16018>>>>>>>>>            If (iErrFile>0) Begin
16020>>>>>>>>>                Get_Attribute DF_FILE_DISPLAY_NAME of iErrFile to sFile
16023>>>>>>>>>                If (iErrField>0) Begin
16025>>>>>>>>>                    Get File_Field_Label of ghoErrorSource iErrFile iErrField DD_LABEL_LONG to sLabel
16026>>>>>>>>>                    Move (SFormat(C_$FieldInDataFile,sLabel, sFile)) to sMess
16027>>>>>>>>>                End
16027>>>>>>>>>>
16027>>>>>>>>>                Else Begin
16028>>>>>>>>>                    Move (SFormat(C_$InDataFile,sFile)) to sMess
16029>>>>>>>>>                End
16029>>>>>>>>>>
16029>>>>>>>>>                Append sSystemErr "\n" sMess
16031>>>>>>>>>            End
16031>>>>>>>>>>
16031>>>>>>>>>        End
16031>>>>>>>>>>
16031>>>>>>>>>        
16031>>>>>>>>>        Move (SFormat(C_$VDFErrorInLine, iError, iLine)) to sDtl
16032>>>>>>>>>        If (iErrFile  > 0) ;            Move (sDtl * DD_FILE_TEXT  * String(iErrFile))  to sDtl
16035>>>>>>>>>        If (iErrField > 0) ;            Move (sDtl * DD_FIELD_TEXT * String(iErrField)) to sDtl
16038>>>>>>>>>        // full error is systemError + Error and line numbers
16038>>>>>>>>>        Move (sSystemErr + "\n" + sDtl) to sFullError
16039>>>>>>>>>        
16039>>>>>>>>>        // If 0, the COM object is not yet ready to be used. If an error occurs in this
16039>>>>>>>>>        // condition, we consider this error to always be fatal and will notify WebApp
16039>>>>>>>>>        // Server of this error via WebAppFatalError command
16039>>>>>>>>>        If (hoInetSession=0) Begin
16041>>>>>>>>>            
16041>>>>>>>>>            If bDebugging Begin
16043>>>>>>>>>                Send UnhandledErrorDisplay iLine sFullError
16044>>>>>>>>>            End
16044>>>>>>>>>>
16044>>>>>>>>>            Else Begin
16045>>>>>>>>>                CallStackDump sStack
16046>>>>>>>>>                WebAppFatalError (Replaces("\n", (sFullError + "\n\n" + sStack) , character(13)+character(10)))
16047>>>>>>>>>                // we only arrive here if WebApp cannot handle the error. All we can
16047>>>>>>>>>                // do is abort.
16047>>>>>>>>>                //Send MessageBoxError sFullError 1 // might be useful for VDF debugging, but cannot be used on server
16047>>>>>>>>>            End
16047>>>>>>>>>>
16047>>>>>>>>>            Abort
16048>>>>>>>>>>
16048>>>>>>>>>        End
16048>>>>>>>>>>
16048>>>>>>>>>        Else Begin
16049>>>>>>>>>            
16049>>>>>>>>>            Get pbAllErrorstoLocal    of hoInetSession to bLocal
16050>>>>>>>>>            Get pbQueueErrors         of hoInetSession to bQueueErrors
16051>>>>>>>>>            Get pbAllErrorstoEventLog of hoInetSession to bLogAllErrors
16052>>>>>>>>>            Get pbAllErrorsToHtml     of hoInetSession to bHtmlErrors
16053>>>>>>>>>            
16053>>>>>>>>>            // If error is critical, we cannot go on.
16053>>>>>>>>>            If bCritical Begin
16055>>>>>>>>>                CallStackDump sStack
16056>>>>>>>>>                Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
16057>>>>>>>>>                Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
16058>>>>>>>>>                Send ReportCriticalError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
16059>>>>>>>>>                
16059>>>>>>>>>                // also attempt to send message to client (html browser)
16059>>>>>>>>>                If bHtmlErrors Begin
16061>>>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
16061>>>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
16061>>>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
16061>>>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
16062>>>>>>>>>                End
16062>>>>>>>>>>
16062>>>>>>>>>                
16062>>>>>>>>>                // if we are passing errors to VDF console, report the error
16062>>>>>>>>>                // if we we debugging, thereis no point in doing this
16062>>>>>>>>>                If (not(bDebugging) and bLocal) Begin
16064>>>>>>>>>                    Send MessageBoxError (sFullError + "\n\n" + sStack) // 1 means critical
16065>>>>>>>>>                End
16065>>>>>>>>>>
16065>>>>>>>>>                
16065>>>>>>>>>                // log the critical error to the event log
16065>>>>>>>>>                // if debugging, this can be an unhandled error
16065>>>>>>>>>                If bDebugging Begin
16067>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
16068>>>>>>>>>                End
16068>>>>>>>>>>
16068>>>>>>>>>                Else Begin
16069>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack  iLine iErrFile iErrField
16070>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError C_$CriticalErrorProgramHalted iLine 0 0
16071>>>>>>>>>                End
16071>>>>>>>>>>
16071>>>>>>>>>                // and end it all
16071>>>>>>>>>                Abort
16072>>>>>>>>>>
16072>>>>>>>>>            End
16072>>>>>>>>>>
16072>>>>>>>>>            
16072>>>>>>>>>            // if we are passing errors to VDF console, report the error
16072>>>>>>>>>            If bLocal Begin
16074>>>>>>>>>                Send MessageBoxError sFullError 0 // 0 means non-critical
16075>>>>>>>>>            End
16075>>>>>>>>>>
16075>>>>>>>>>            
16075>>>>>>>>>            // we make the following assumptions:
16075>>>>>>>>>            // If errors are queue
16075>>>>>>>>>            //    We assume the error is expected, and controlled
16075>>>>>>>>>            //    Write error to queue
16075>>>>>>>>>            //    Ddo not write to Event Log unless we are logging all errors.
16075>>>>>>>>>            //
16075>>>>>>>>>            // if errors are not queued
16075>>>>>>>>>            //    We assume the error is unexpected, and must be controlled
16075>>>>>>>>>            //    Display HTML error to browser unless this is disabled
16075>>>>>>>>>            //    Send to the event log (under the assumption that the error is unexpected).
16075>>>>>>>>>            CallStackDump sStack
16076>>>>>>>>>            Move (Replaces(Character(13)+Character(10),sStack, "\n")) to sStack
16077>>>>>>>>>            Move (sSystemErr + "\n\n" + sStack) to sSystemAndStack
16078>>>>>>>>>                
16078>>>>>>>>>            If bQueueErrors Begin
16080>>>>>>>>>                Send Set_Error iError sSystemErr sFullError iLine iErrFile iErrField
16081>>>>>>>>>                If bLogAllErrors Begin
16083>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
16084>>>>>>>>>                End
16084>>>>>>>>>>
16084>>>>>>>>>            End
16084>>>>>>>>>>
16084>>>>>>>>>            Else Begin
16085>>>>>>>>>                If bHtmlErrors Begin
16087>>>>>>>>>                    // The option to disable stack dumps only makes sense if the developer is using html errors to report unhandled problems
16087>>>>>>>>>                    // and for some reason the stack dump will mess up existing applications. This seems very unlikely but we are providing
16087>>>>>>>>>                    // a way to disable this if needed via pbUnhandledSupport.
16087>>>>>>>>>                    Send ReportError to hoInetSession iError (If(bUnhandledSupport, sSystemAndStack, sSystemErr)) iLine iErrFile iErrField
16088>>>>>>>>>                End
16088>>>>>>>>>>
16088>>>>>>>>>                If bDebugging  Begin
16090>>>>>>>>>                    Send UnhandledErrorDisplay iLine sFullError
16091>>>>>>>>>                End
16091>>>>>>>>>>
16091>>>>>>>>>                Else Begin
16092>>>>>>>>>                    Send ReportErrorEvent to hoInetSession iError sSystemAndStack iLine iErrFile iErrField
16093>>>>>>>>>                End
16093>>>>>>>>>>
16093>>>>>>>>>            End
16093>>>>>>>>>>
16093>>>>>>>>>        End
16093>>>>>>>>>>
16093>>>>>>>>>        
16093>>>>>>>>>        
16093>>>>>>>>>    End_Procedure
16094>>>>>>>>>
16094>>>>>>>>>    //  Is called by df on errors. It searches additional information and
16094>>>>>>>>>    //  saves the error. The main part of this is the error handler for AJAX framework
16094>>>>>>>>>    // applications If a basic or a legacy webapp, this Error is "forwarded" to BasicErrorReport.
16094>>>>>>>>>    //
16094>>>>>>>>>    Procedure HandleError Integer iErrNum Integer iErrLine String sErrText
16096>>>>>>>>>
16096>>>>>>>>>        Send BasicErrorReport iErrNum iErrLine sErrText
16097>>>>>>>>>        
16097>>>>>>>>>    End_Procedure
16098>>>>>>>>>    
16098>>>>>>>>>    
16098>>>>>>>>>    //
16098>>>>>>>>>    // These are all old style WebApp error interfaces that only exist for compatibility purposes
16098>>>>>>>>>    //    
16098>>>>>>>>>    Procedure ClearErrors
16100>>>>>>>>>        Send Delete_data of oErrorNumber
16101>>>>>>>>>        Send Delete_Data of oErrorText
16102>>>>>>>>>        Send Delete_Data of oFullErrorText
16103>>>>>>>>>        Send Delete_Data of oFileNr
16104>>>>>>>>>        Send Delete_Data of oFieldNr
16105>>>>>>>>>        Send Delete_Data of oLineNr
16106>>>>>>>>>    End_Procedure
16107>>>>>>>>>    
16107>>>>>>>>>    Function ErrorCount Returns Integer
16109>>>>>>>>>        Function_Return (Item_Count(oErrorNumber))
16110>>>>>>>>>    End_Function
16111>>>>>>>>>    
16111>>>>>>>>>    // Pass Err Num, Error Msg, Line#, File, Field and error-type
16111>>>>>>>>>    Procedure Set_Error Integer iErrNr String sErrMsg String sFullErrMsg Integer iLineNr Integer iFileNr Integer iFieldNr
16113>>>>>>>>>        Integer iCount
16113>>>>>>>>>        Get ErrorCount to iCount
16114>>>>>>>>>        Set Value of oErrorNumber iCount to iErrNr
16115>>>>>>>>>        Set Value of oErrorText   iCount to sErrMsg
16116>>>>>>>>>        Set Value of oFullErrorText iCount to sFullErrMsg
16117>>>>>>>>>        Set Value of oLineNr      iCount to iLineNr
16118>>>>>>>>>        Set Value of oFileNr      iCount to iFileNr
16119>>>>>>>>>        Set Value of oFieldNr     iCount to iFieldNr
16120>>>>>>>>>    End_Procedure
16121>>>>>>>>>    
16121>>>>>>>>>    Function Error_ErrNr Integer iItem Returns Integer
16123>>>>>>>>>        Function_Return (Value(oErrorNumber,iItem))
16124>>>>>>>>>    End_Function
16125>>>>>>>>>    
16125>>>>>>>>>    Function Error_LineNr Integer iItem Returns Integer
16127>>>>>>>>>        Function_Return (Value(oLineNr,iItem))
16128>>>>>>>>>    End_Function
16129>>>>>>>>>    
16129>>>>>>>>>    Function Error_FileNr Integer iItem Returns Integer
16131>>>>>>>>>        Function_Return (Value(oFileNr,iItem))
16132>>>>>>>>>    End_Function
16133>>>>>>>>>    
16133>>>>>>>>>    Function Error_FieldNr Integer iItem Returns Integer
16135>>>>>>>>>        Function_Return (Value(oFieldNr,iItem))
16136>>>>>>>>>    End_Function
16137>>>>>>>>>    
16137>>>>>>>>>    Function Error_ErrMsg Integer iItem Returns String
16139>>>>>>>>>        Function_Return (Value(oErrorText,iItem))
16140>>>>>>>>>    End_Function
16141>>>>>>>>>    
16141>>>>>>>>>    Function Error_ErrMsgFull Integer iItem Returns String
16143>>>>>>>>>        Function_Return (Value(oFullErrorText,iItem))
16144>>>>>>>>>    End_Function
16145>>>>>>>>>    
16145>>>>>>>>>     
16145>>>>>>>>>    //
16145>>>>>>>>>    // Enumerate all errors.
16145>>>>>>>>>    // For each error send iMsg to hObj passing all required error
16145>>>>>>>>>    // information: iErr#, sErrorMsg, iLine, iFile, iField
16145>>>>>>>>>    //
16145>>>>>>>>>    Procedure EnumerateErrors Integer iMsg Integer hObj
16147>>>>>>>>>        Integer iCount i
16147>>>>>>>>>        Get ErrorCount to iCount
16148>>>>>>>>>        Decrement iCount
16149>>>>>>>>>        For i from 0 to iCount
16155>>>>>>>>>>
16155>>>>>>>>>            Send ErrorReportCallback i iMsg hObj
16156>>>>>>>>>        Loop
16157>>>>>>>>>>
16157>>>>>>>>>    End_Procedure
16158>>>>>>>>>    
16158>>>>>>>>>    // if item is -1 it is last error
16158>>>>>>>>>    Procedure ErrorReportCallback Integer iItem Integer iMsg Integer hObj
16160>>>>>>>>>        String  sErrMsg
16160>>>>>>>>>        Integer iFileNr iFieldNr iErrNr iLineNr
16160>>>>>>>>>        Integer iCount
16160>>>>>>>>>        Get ErrorCount to iCount
16161>>>>>>>>>        If (iItem=-1) ;            Move (iCount-1) to iItem // if -1, use last error
16164>>>>>>>>>        If (iItem>=0 and iCount>iItem) Begin
16166>>>>>>>>>            Get Error_ErrNr   iItem to iErrNr
16167>>>>>>>>>            Get Error_ErrMsg  iItem to sErrMsg
16168>>>>>>>>>            Get Error_LineNr  iItem to iLineNr
16169>>>>>>>>>            Get Error_FileNr  iItem to iFileNr
16170>>>>>>>>>            Get Error_FieldNr iItem to iFieldNr
16171>>>>>>>>>            Send iMsg to hObj iErrNr sErrMsg iLineNr iFileNr iFieldNr
16172>>>>>>>>>        End
16172>>>>>>>>>>
16172>>>>>>>>>    End_Procedure
16173>>>>>>>>>    
16173>>>>>>>>>    // this is used to remove a single error from the queue
16173>>>>>>>>>    // if iItem is -1, last error
16173>>>>>>>>>    Procedure ClearError Integer iItem
16175>>>>>>>>>        Integer iCount
16175>>>>>>>>>        Get ErrorCount to iCount
16176>>>>>>>>>        If (iItem=-1) ;            Move (iCount-1) to iItem // if -1, use last error
16179>>>>>>>>>        If (iItem>=0 and iCount>iItem) Begin
16181>>>>>>>>>            Send Delete_Item iItem
16182>>>>>>>>>            Send Delete_Item to oErrorText iItem
16183>>>>>>>>>            Send Delete_Item to oLineNr    iItem
16184>>>>>>>>>            Send Delete_Item to oFileNr    iItem
16185>>>>>>>>>            Send Delete_Item to oFieldNr   iItem
16186>>>>>>>>>        End
16186>>>>>>>>>>
16186>>>>>>>>>    End_Procedure
