34199>>>>>// cWebObject_Mixin functions
34199>>>>>Use cWebObject_API.pkg
34199>>>>>
34199>>>>>
34199>>>>>// Class used by cWebApp to handle file streaming requests. Communicates with the resource manager 
34199>>>>>// via the ghoWebResourceManager handle.
34199>>>>>Class cWebResourceManagerProxy is a cWebHttpMultipartFormdataHandler
34200>>>>>    Procedure Construct_Object
34202>>>>>        Forward Send Construct_Object
34204>>>>>        
34204>>>>>        Send Define_cWebResourceManagerProxy_mixin
34205>>>>>        
34205>>>>>        //  Stores the hash during a file upload
34205>>>>>        Property String psHash ""
34206>>>>>        //  Stores the output channel during a file upload
34206>>>>>        Property Integer piChannel -1
34207>>>>>        //  Stores the file path during a file upload
34207>>>>>        Property String psUploadPath ""
34208>>>>>        //  Used to not send the status twice during file upload
34208>>>>>        Property Boolean pbStatusSent False
34209>>>>>        
34209>>>>>        
34209>>>>>        Set psVerbs to "GET,POST"
34210>>>>>        Set psPath to "DfResource"
34211>>>>>    End_Procedure
34212>>>>>    
34212>>>>>    Import_Class_Protocol cWebResourceManagerProxy_mixin
34213>>>>>    
34213>>>>>    //  A get request means we are downloading a file
34213>>>>>    Procedure OnHttpGet String sPath String sAcceptType
34215>>>>>        String[] aParts
34216>>>>>        String sHash sStreamType sFilePath sFileName sContentType sHttpError sAttach
34216>>>>>        Integer iPos iChnl iSize iHttpError
34216>>>>>        UChar[] aData
34217>>>>>        Boolean bOk
34217>>>>>        Handle hoResourceManager
34217>>>>>        
34217>>>>>        Get ResourceManager to hoResourceManager
34218>>>>>        
34218>>>>>        //  Determine key
34218>>>>>        Get UrlParameter "key" to sHash
34219>>>>>        If (Trim(sHash) = "") Begin
34221>>>>>            Send SetResponseStatus 404 "Invalid resource" 1
34222>>>>>            Procedure_Return
34223>>>>>        End
34223>>>>>>
34223>>>>>        
34223>>>>>        // Split the file name from the key 
34223>>>>>        Move (RightPos("/", sPath)) to iPos
34224>>>>>        If (iPos > 0) ;            Move (Right(sPath, Length(sPath) - iPos)) to sFileName
34227>>>>>        Else ;            Move sPath to sFileName
34229>>>>>        
34229>>>>>        //  Determine stream type
34229>>>>>        Get UrlParameter "attach" to sAttach
34230>>>>>        If (Lowercase(Trim(sAttach)) = "true") ;            Move "attachment" to sStreamType
34233>>>>>        Else ;            Move "inline" to sStreamType
34235>>>>>            
34235>>>>>        //  Let resource manager parse the path
34235>>>>>        Get FileDownload of hoResourceManager sHash (&sFilePath) (&iHttpError) (&sHttpError) to bOk
34236>>>>>        
34236>>>>>        If (not(bOk)) Begin
34238>>>>>            Send SetResponseStatus iHttpError sHttpError
34239>>>>>            Procedure_Return
34240>>>>>        End
34240>>>>>>
34240>>>>>                
34240>>>>>        //  Determine contenttype based on extension
34240>>>>>        Move (RightPos(".", sFileName)) to iPos
34241>>>>>        If (iPos >= 0) ;            Get ContentType of hoResourceManager (Right(sFileName, Length(sFileName) - iPos)) to sContentType
34244>>>>>        Else ;            Get ContentType of hoResourceManager "" to sContentType
34246>>>>>                
34246>>>>>        //  Open the file
34246>>>>>        Move (Seq_New_Channel()) to iChnl
34247>>>>>        If (iChnl >= 0) Begin
34249>>>>>            Direct_Input channel iChnl ("binary:" + sFilePath)
34251>>>>>            Get_Channel_Size iChnl to iSize
34252>>>>>            
34252>>>>>            //  Send the response headers
34252>>>>>            Send AddHttpResponseHeader "Content-Type" sContentType
34253>>>>>            Send AddHttpResponseHeader "Content-Disposition" (sStreamType +';filename="' + sFileName + '"')
34254>>>>>            Send AddHttpResponseHeader "Content-Length" iSize
34255>>>>>            
34255>>>>>            //  Send the file
34255>>>>>            While (not(SeqEof))
34259>>>>>                Read_Block channel iChnl aData HTTP_DEFAULT_CHUNK_SIZE
34261>>>>>                
34261>>>>>                Send OutputUChar aData
34262>>>>>            Loop
34263>>>>>>
34263>>>>>            
34263>>>>>            Close_Input channel iChnl
34265>>>>>            Send Seq_Release_Channel iChnl
34266>>>>>            
34266>>>>>            //  Trigger filedownloadfinished
34266>>>>>            Send FileDownloadFinished of hoResourceManager sFilePath
34267>>>>>        End
34267>>>>>>
34267>>>>>        Else If (iChnl = -1) Begin
34270>>>>>            Send SetResponseStatus 500 "I/O Channel Error" 1
34271>>>>>            Procedure_Return
34272>>>>>        End
34272>>>>>>
34272>>>>>        Else If (iChnl = -2) Begin
34275>>>>>            Send SetResponseStatus 500 "No I/O Channel Available" 2
34276>>>>>            Procedure_Return
34277>>>>>        End
34277>>>>>>
34277>>>>>    End_Procedure
34278>>>>>
34278>>>>>    //  In case of a post this is a file upload. The cWebHttpMultipartFormDataHandler base class 
34278>>>>>    //  will tear the request apart and trigger OnField and OnFile.. events. 
34278>>>>>    Procedure OnHttpPost String sPath String sContentType String sAcceptType DWord iSize
34280>>>>>        Send HandleFileUpload
34281>>>>>    End_Procedure
34282>>>>>    
34282>>>>>    // Main entry point for parsing the file upload
34282>>>>>    Procedure HandleFileUpload 
34284>>>>>        Boolean bSuccess bExists
34284>>>>>        String sFilePath
34284>>>>>        
34284>>>>>        Set psHash to ""
34285>>>>>        Set piChannel to -1
34286>>>>>        Set psUploadPath to ""
34287>>>>>        Set pbStatusSent to False
34288>>>>>
34288>>>>>        Get ParseMultipartFormData to bSuccess
34289>>>>>        //Send SetResponseStatus 500 "Invalid request format: test" 8
34289>>>>>        If (not(bSuccess)) Begin
34291>>>>>            Get psUploadPath to sFilePath    
34292>>>>>            If (sFilePath <> "") Begin
34294>>>>>                File_Exist sFilePath bExists
34295>>>>>                If (bExists) Begin
34297>>>>>                    EraseFile sFilePath 
34298>>>>>>
34298>>>>>                End
34298>>>>>>
34298>>>>>            End
34298>>>>>>
34298>>>>>            
34298>>>>>            If (not(pbstatussent(Self))) ;                Send SetResponseStatus 500 (psParseError(Self)) (piParseErrorCode(Self))             
34301>>>>>        End
34301>>>>>>
34301>>>>>        Set psHash to ""
34302>>>>>        Set piChannel to -1
34303>>>>>        Set psUploadPath to ""
34304>>>>>        Set pbStatusSent to False
34305>>>>>    End_Procedure
34306>>>>>    
34306>>>>>    //  The hash is sent as a field before the file is sent.
34306>>>>>    Procedure OnField String sName UChar[] ucData
34308>>>>>        Forward Send OnField sName ucData
34310>>>>>        
34310>>>>>        If (sName = "hash") Begin
34312>>>>>            Set psHash to (UCharArrayToString(ucData))
34313>>>>>        End
34313>>>>>>
34313>>>>>    End_Procedure
34314>>>>>    
34314>>>>>    //  When the file comes in we decrypt the hash and open the file. We store the channel so that
34314>>>>>    //  OnFileChunk can actually write the data.
34314>>>>>    Procedure OnFileStart String sFieldName String sFileName String sContentType Boolean ByRef bAbort
34316>>>>>        String sHash sPath sError
34316>>>>>        Integer iChnl iHttpErr
34316>>>>>        Boolean bExists bOk
34316>>>>>        
34316>>>>>        If (sFieldName = "file") Begin
34318>>>>>            Get psHash to sHash
34319>>>>>            
34319>>>>>            If (sHash = "") Begin
34321>>>>>                Send SetResponseStatus 500 "Invalid request format: expected hash before file." 4
34322>>>>>                Move True to bAbort
34323>>>>>                Set pbStatusSent to True
34324>>>>>                Procedure_Return
34325>>>>>            End
34325>>>>>>
34325>>>>>            
34325>>>>>            Get FileUpload of (ResourceManager(Self)) sFileName sHash (&sPath) (&iHttpErr) (&sError) to bOk
34326>>>>>            If (not(bOk)) Begin
34328>>>>>                Send SetResponseStatus iHttpErr sError
34329>>>>>                Set pbStatusSent to True
34330>>>>>                Move True to bAbort
34331>>>>>                Procedure_Return
34332>>>>>            End
34332>>>>>>
34332>>>>>            
34332>>>>>            File_Exist sPath bExists
34333>>>>>            
34333>>>>>            If (not(bExists)) Begin
34335>>>>>                Move (Seq_New_Channel()) to iChnl
34336>>>>>                If (iChnl >= 0) Begin
34338>>>>>                    Direct_Output channel iChnl ("binary:" + sPath)
34340>>>>>                    Set piChannel to iChnl
34341>>>>>                    Set psUploadPath to sPath
34342>>>>>                End
34342>>>>>>
34342>>>>>                Else If (iChnl = -1) Begin
34345>>>>>                    Send SetResponseStatus 500 "I/O Channel Error" 1
34346>>>>>                    Set pbStatusSent to True
34347>>>>>                    Move True to bAbort
34348>>>>>                End
34348>>>>>>
34348>>>>>                Else If (iChnl = -2) Begin
34351>>>>>                    Send SetResponseStatus 500 "No I/O Channel Available" 2
34352>>>>>                    Set pbStatusSent to True
34353>>>>>                    Move True to bAbort
34354>>>>>                End
34354>>>>>>
34354>>>>>            End
34354>>>>>>
34354>>>>>            Else Begin
34355>>>>>                Send SetResponseStatus 500 "File already exists" 6
34356>>>>>                Set pbStatusSent to True
34357>>>>>                Move True to bAbort
34358>>>>>            End
34358>>>>>>
34358>>>>>        End
34358>>>>>>
34358>>>>>    End_Procedure
34359>>>>>    
34359>>>>>    //  Called for each chunk of data that comes in for a file, we simply write it out to the 
34359>>>>>    //  already opened file channel.
34359>>>>>    Procedure OnFileChunk String sFieldName UChar[] ByRef ucData
34361>>>>>        Integer iChnl
34361>>>>>        
34361>>>>>        If (sFieldName = "file") Begin
34363>>>>>            Get piChannel to iChnl
34364>>>>>            If (iChnl >= 0) Begin
34366>>>>>                Write channel iChnl ucData
34368>>>>>            End
34368>>>>>>
34368>>>>>        End
34368>>>>>>
34368>>>>>    End_Procedure
34369>>>>>    
34369>>>>>    //  The upload is done, we send back a positive response.
34369>>>>>    Procedure OnFileFinished String sFieldName
34371>>>>>        Integer iChnl
34371>>>>>        String sFilePath
34371>>>>>        
34371>>>>>        If (sFieldName = "file") Begin
34373>>>>>            Get piChannel to iChnl
34374>>>>>            If (iChnl >= 0) Begin
34376>>>>>                Close_Output channel iChnl
34378>>>>>                Send Seq_Release_Channel iChnl
34379>>>>>                
34379>>>>>                Get psUploadPath to sFilePath
34380>>>>>                                
34380>>>>>                Set piChannel to -1
34381>>>>>                Set psUploadPath to ""
34382>>>>>                
34382>>>>>                Send SetResponseStatus 201 "Upload succesfull" 0
34383>>>>>                Set pbStatusSent to True
34384>>>>>                Send FileUploadFinished of (ResourceManager(Self)) sFilePath
34385>>>>>            End
34385>>>>>>
34385>>>>>            Else If (iChnl = -1) Begin
34388>>>>>                Send SetResponseStatus 500 "I/O Channel Error" 1
34389>>>>>                Set pbStatusSent to True
34390>>>>>            End
34390>>>>>>
34390>>>>>            Else If (iChnl = -2) Begin
34393>>>>>                Send SetResponseStatus 500 "No I/O Channel Available" 2
34394>>>>>                Set pbStatusSent to True
34395>>>>>            End
34395>>>>>>
34395>>>>>        End
34395>>>>>>
34395>>>>>    End_Procedure
