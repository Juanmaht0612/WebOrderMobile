10648>>>>>>>>>>>>>//   The Data_Set class is implemented as a subclass of Entry_Client, with
10648>>>>>>>>>>>>>//   a C language handler providing the majority of new behavior.  The
10648>>>>>>>>>>>>>//   Data_Set class is intended to be a grouping agent for data-entry objects
10648>>>>>>>>>>>>>//   and a container for subordinate Data_Sets.
10648>>>>>>>>>>>>>//
10648>>>>>>>>>>>>>Use BaseData_Set.pkg
10648>>>>>>>>>>>>>
10648>>>>>>>>>>>>>// Data_Set class definition, public class layer. (Extra class layer needed
10648>>>>>>>>>>>>>// to augment C-based (Constrain) procedure(s).)
10648>>>>>>>>>>>>>
10648>>>>>>>>>>>>>Class DataSet is a BaseData_Set
10649>>>>>>>>>>>>>    
10649>>>>>>>>>>>>>    
10649>>>>>>>>>>>>>    // maintain old name for the time being to maximize compatability
10649>>>>>>>>>>>>>    // between character mode and windows versions. Developers should be
10649>>>>>>>>>>>>>    // able to move DS classes back and forth without changes.
10649>>>>>>>>>>>>>    Replace_Class_Name Data_Set DataSet
10649>>>>>>>>>>>>>    
10649>>>>>>>>>>>>>    Procedure Construct_Object //Integer Img#
10651>>>>>>>>>>>>>        Forward Send Construct_Object No_Image //Img#
10653>>>>>>>>>>>>>        
10653>>>>>>>>>>>>>        Property Integer Constrain_File 0
10654>>>>>>>>>>>>>        Property Integer Auto_Fill_State False
10655>>>>>>>>>>>>>        Property Integer Change_Disabled_State  False
10656>>>>>>>>>>>>>        // RT sets this inside of Mark_components a part of old entry_client DSO behavior. Now it is never used
10656>>>>>>>>>>>>>        Property Integer Component_State False
10657>>>>>>>>>>>>>        
10657>>>>>>>>>>>>>    End_Procedure
10658>>>>>>>>>>>>>    
10658>>>>>>>>>>>>>    
10658>>>>>>>>>>>>>    //
10658>>>>>>>>>>>>>    // This may be called by legacy DSO and DDO code
10658>>>>>>>>>>>>>    //
10658>>>>>>>>>>>>>    // IMPORTANT NOTE of change for 8.2:
10658>>>>>>>>>>>>>    //         DO NOT call or augment this anymore.
10658>>>>>>>>>>>>>    //
10658>>>>>>>>>>>>>    //         for sending: Find all cases of Field_main_index and change it to File_Field_Index
10658>>>>>>>>>>>>>    //
10658>>>>>>>>>>>>>    //         for augmenting: In DSOs - replace Field_main_index with File_field_index
10658>>>>>>>>>>>>>    //                         In DDOs - replace Field_main_Index with Field_Index and do not pass
10658>>>>>>>>>>>>>    //                                   the file parameter.
10658>>>>>>>>>>>>>    //                                   See DDOs Field_index and File_field_Index for more
10658>>>>>>>>>>>>>    //
10658>>>>>>>>>>>>>    Function Field_Main_Index Integer file Integer Field Returns Integer
10660>>>>>>>>>>>>>        Integer dataType fldNdx retval ordr
10660>>>>>>>>>>>>>        Move -1 to retval      //field has no main index (default)
10661>>>>>>>>>>>>>        If (file <> 0) Begin
10663>>>>>>>>>>>>>//      FIELD_DEF file field to dataType fldNdx
10663>>>>>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of file Field to fldNdx // main index field
10666>>>>>>>>>>>>>            If (fldNdx > 0 or Field = 0) ;                Move fldNdx to retval //field has main index
10669>>>>>>>>>>>>>        End
10669>>>>>>>>>>>>>>
10669>>>>>>>>>>>>>        If (file = main_file(Self)) Begin
10671>>>>>>>>>>>>>            Get ordering to ordr
10672>>>>>>>>>>>>>            If (ordr >= 0) ;                Move ordr to retval  //ordering takes precedence over main index
10675>>>>>>>>>>>>>        End
10675>>>>>>>>>>>>>>
10675>>>>>>>>>>>>>        Function_Return retval
10676>>>>>>>>>>>>>    End_Function
10677>>>>>>>>>>>>>    
10677>>>>>>>>>>>>>    // This allows packages that still use data-sets instead of DDOs to use this
10677>>>>>>>>>>>>>    // message syntax.
10677>>>>>>>>>>>>>    // Note that this will never get here if the DD class is used as
10677>>>>>>>>>>>>>    // it has its own handler for this. It only is called if DSOs are used in which
10677>>>>>>>>>>>>>    // case it calls the old message field_main_index above.
10677>>>>>>>>>>>>>    // DDO based objects will NEVER call this code
10677>>>>>>>>>>>>>    //
10677>>>>>>>>>>>>>    Function File_Field_Index Integer iFile Integer iField Returns Integer
10679>>>>>>>>>>>>>        Function_Return (Field_main_Index(Self,iFile,iField))
10680>>>>>>>>>>>>>    End_Function
10681>>>>>>>>>>>>>    
10681>>>>>>>>>>>>>    
10681>>>>>>>>>>>>>    Procedure Item_Find Integer eFindMode ;            Integer iFile Integer iField ;            Integer bDoEntryUpdate Integer bShowFindErr Integer bDeferred
10683>>>>>>>>>>>>>        
10683>>>>>>>>>>>>>        RowID   riRow
10683>>>>>>>>>>>>>        Integer iIndex
10683>>>>>>>>>>>>>        Handle  hoServer
10683>>>>>>>>>>>>>        Integer iSegments iSeg iSegFld iSegFldMainIndex
10683>>>>>>>>>>>>>        Boolean bChanged bDoCheck bOk
10683>>>>>>>>>>>>>        
10683>>>>>>>>>>>>>        //Get Field_Main_Index iFile iField to iIndex
10683>>>>>>>>>>>>>        Get File_Field_Index iFile iField to iIndex
10684>>>>>>>>>>>>>        If (iIndex<>-1) Begin
10686>>>>>>>>>>>>>            // get prior rowId before it get cleared
10686>>>>>>>>>>>>>            Move (GetRowID(iFile)) to riRow
10687>>>>>>>>>>>>>            //  'hold' buffer to prepare for entry_update
10687>>>>>>>>>>>>>            Set_Attribute DF_FILE_STATUS of iFile to DF_FILE_INACTIVE
10690>>>>>>>>>>>>>            If bDoEntryUpdate Begin
10692>>>>>>>>>>>>>                Send Request_Entry_Update iFile 1  //entUpdt all DEOs as required
10693>>>>>>>>>>>>>                
10693>>>>>>>>>>>>>                // If the buffer is cleared (no record and no changed data) then we want
10693>>>>>>>>>>>>>                // to do a constrained_clear which will force the buffer to get cleared
10693>>>>>>>>>>>>>                // according to the rules of the current constraints.
10693>>>>>>>>>>>>>                //Get_field_value iFile 0 to iRec
10693>>>>>>>>>>>>>                //Move (GetRowID(iFile)) to riRow // 12.1 moved above the set file inactive
10693>>>>>>>>>>>>>                
10693>>>>>>>>>>>>>                // If there was an active record to begin with we consider this changed (not cleared)
10693>>>>>>>>>>>>>                If (not(IsNullRowId(riRow))) Begin
10695>>>>>>>>>>>>>                    Move True to bChanged
10696>>>>>>>>>>>>>                End
10696>>>>>>>>>>>>>>
10696>>>>>>>>>>>>>                Else Begin
10697>>>>>>>>>>>>>                    // or, if the record was already changed or the entry_update created a change
10697>>>>>>>>>>>>>                    // we consider this changed
10697>>>>>>>>>>>>>                    Get_Attribute DF_FILE_CHANGED of iFile to bChanged
10700>>>>>>>>>>>>>                End
10700>>>>>>>>>>>>>>
10700>>>>>>>>>>>>>                
10700>>>>>>>>>>>>>                If not bChanged Begin
10702>>>>>>>>>>>>>                    // if buffer is unchanged, do a constrained clear. It is unchanged if there was not
10702>>>>>>>>>>>>>                    // active record, the record was unchanged, and the update didn't change anything.
10702>>>>>>>>>>>>>                    Constrained_Clear eFindMode iFile by iIndex
10705>>>>>>>>>>>>>                End
10705>>>>>>>>>>>>>>
10705>>>>>>>>>>>>>                Else If (eFindMode=GE or eFindMode=LE and iIndex>0) Begin
10708>>>>>>>>>>>>>                    
10708>>>>>>>>>>>>>                    // If mode is GE or LE we need to do some extra processing. We want to clear
10708>>>>>>>>>>>>>                    // all index segemnt fields that occur after this field in the index. This way
10708>>>>>>>>>>>>>                    // dbList searches and find ge searches (f9) will always find the first record
10708>>>>>>>>>>>>>                    // that matches the data in the field being searched. This was if an index like
10708>>>>>>>>>>>>>                    // customer.name x customer.number where you had 10 identical names "john" typing
10708>>>>>>>>>>>>>                    // john will find the first record, because customer.number will get cleared.
10708>>>>>>>>>>>>>                    // Note we can no do this with GT or LT or you'd get stuck in fields
10708>>>>>>>>>>>>>                    
10708>>>>>>>>>>>>>                    // check all fields for index. Once you find the iField field, clear all
10708>>>>>>>>>>>>>                    // fields that follow it. Only do this if the other fields do not use the
10708>>>>>>>>>>>>>                    // same index as its primary index (in which case we assume the data is intentional).
10708>>>>>>>>>>>>>                    // This should handle most cases.
10708>>>>>>>>>>>>>                    Get_Attribute DF_INDEX_NUMBER_SEGMENTS of iFile iIndex to iSegments
10711>>>>>>>>>>>>>                    For iSeg from 1 to iSegments
10717>>>>>>>>>>>>>>
10717>>>>>>>>>>>>>                        Get_Attribute DF_INDEX_SEGMENT_FIELD of iFile iIndex iSeg to iSegFld
10720>>>>>>>>>>>>>                        If not bDoCheck Begin
10722>>>>>>>>>>>>>                            If (iSegFld=iField) ;                                Move True to bDoCheck // marked after we find the find field in the index
10725>>>>>>>>>>>>>                        End
10725>>>>>>>>>>>>>>
10725>>>>>>>>>>>>>                        Else Begin // we get here after we've found the main field segment
10726>>>>>>>>>>>>>                            // if main index if this segment is same as our find index, do nothing
10726>>>>>>>>>>>>>                            Get File_Field_Index iFile iSegFld to iSegFldMainIndex
10727>>>>>>>>>>>>>                            If (iSegFldMainIndex<>iIndex) ;                                Set_Field_Value iFile iSegFld to ''
10732>>>>>>>>>>>>>                        End
10732>>>>>>>>>>>>>>
10732>>>>>>>>>>>>>                    Loop
10733>>>>>>>>>>>>>>
10733>>>>>>>>>>>>>                End
10733>>>>>>>>>>>>>>
10733>>>>>>>>>>>>>                
10733>>>>>>>>>>>>>                Get Which_Data_Set iFile to hoServer
10734>>>>>>>>>>>>>                If (hoServer and iFile=main_file(hoServer)) ;                    Send Attach_Main_File to hoServer
10737>>>>>>>>>>>>>                Else ;                    Attach iFile
10739>>>>>>>>>>>>>            End
10739>>>>>>>>>>>>>>
10739>>>>>>>>>>>>>            
10739>>>>>>>>>>>>>            Move False to Err
10740>>>>>>>>>>>>>            
10740>>>>>>>>>>>>>            If (Is_SuperFind_Required(Self,iFile)) ;                Send Request_SuperFind eFindMode iFile iField
10743>>>>>>>>>>>>>            Else If bDeferred ;                Send Request_Read eFindMode iFile iIndex
10747>>>>>>>>>>>>>            Else ;                Send Request_Find eFindMode iFile iIndex
10749>>>>>>>>>>>>>            
10749>>>>>>>>>>>>>            If (not(Found) and not(err)) Begin
10751>>>>>>>>>>>>>                // refind original record (or leave it cleared if not record)
10751>>>>>>>>>>>>>                Move (FindByRowId(iFile,riRow)) to bOk
10752>>>>>>>>>>>>>                
10752>>>>>>>>>>>>>                If bShowFindErr ;                    Error (If(eFindMode<2, DFERR_FIND_PRIOR_BEG_OF_FILE, DFERR_FIND_PAST_END_OF_FILE))
10755>>>>>>>>>>>>>                Move False to Found
10756>>>>>>>>>>>>>            End
10756>>>>>>>>>>>>>>
10756>>>>>>>>>>>>>        End
10756>>>>>>>>>>>>>>
10756>>>>>>>>>>>>>        Else ;            If bShowFindErr ;                Error DFERR_FIELD_NOT_INDEXED
10760>>>>>>>>>>>>>    End_Procedure
10761>>>>>>>>>>>>>    
10761>>>>>>>>>>>>>    
10761>>>>>>>>>>>>>    // We only care about should_saves of DEOs and not DSOs when
10761>>>>>>>>>>>>>    // exiting the app. Create a handler for data set class. We still
10761>>>>>>>>>>>>>    // broadcast in case we've got nested deos in the dso (hopefully not).
10761>>>>>>>>>>>>>    //
10761>>>>>>>>>>>>>    Function Exit_Application_Check Returns Integer
10763>>>>>>>>>>>>>        Integer rVal
10763>>>>>>>>>>>>>        Broadcast Get Exit_Application_Check to Rval // check w/ kids
10765>>>>>>>>>>>>>        Function_Return rVal
10766>>>>>>>>>>>>>    End_Function
