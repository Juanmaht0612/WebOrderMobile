9925>>>    
9925>>>    Procedure ResetWindowPos tWinRect ByRef WindowPos
9927>>>        Integer ixySize ixSize iySize
9927>>>        Integer ixOffset iyOffset
9927>>>        
9927>>>        // first calculate the offset needed to move onto the main monitor at 0,0
9927>>>        Move (0 - WindowPos.left) to ixOffset
9928>>>        Move (0 - WindowPos.top) to iyOffset
9929>>>        
9929>>>        Move 0 to WindowPos.left
9930>>>        Move 0 to WindowPos.top
9931>>>        
9931>>>        Move (WindowPos.right + ixOffset) to WindowPos.right
9932>>>        Move (WindowPos.bottom + iyOffset) to WindowPos.bottom
9933>>>        
9933>>>        // also make sure that the size of the window is <= the size of the main monitor
9933>>>        Move (GUIScreen_Size(1)) to ixySize    // parameter of 1 means return "available" screen size
9934>>>        Move (low(ixySize))      to ixSize
9935>>>        Move (hi(ixySize))       to iySize
9936>>>        
9936>>>        Move (ixSize min WindowPos.right) to WindowPos.right
9937>>>        Move (iySize min WindowPos.bottom) to WindowPos.bottom
9938>>>    End_Procedure
