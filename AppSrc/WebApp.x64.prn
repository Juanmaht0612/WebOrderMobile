12146>>>>>>>>>>>        If (Item_Count(Self)>iField) ;            Get value iField to sName
12149>>>>>>>>>>>        // sometimes an array value that is undefined returns a 0, we must change this to ''
12149>>>>>>>>>>>        If (sName = '0') ;            Move '' to sName
12152>>>>>>>>>>>        Function_Return sName
