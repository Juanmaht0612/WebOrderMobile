18832>>>>>>>>>
18832>>>>>>>>>    // Serializes this cWebObject, and its child cWebObjects.
18832>>>>>>>>>    Function DoSerializeObject Handle hjClassArray Handle[] ByRef aClasses Returns Handle
18834>>>>>>>>>        Handle hClass hjClass hjProps hjAdvProps hjObject hjVT hjChildren hjChild hoClassMeta
18834>>>>>>>>>        tWebPropMetaData[] aProperties
18834>>>>>>>>>        tWebPropMetaData[] aProperties
18835>>>>>>>>>        Integer iProperty icProperty iChild icChild
18835>>>>>>>>>        Variant vValue
18835>>>>>>>>>        String sValue
18835>>>>>>>>>        tWebValueTree tVT tVTEmpty
18835>>>>>>>>>        tWebValueTree tVT tVTEmpty
18835>>>>>>>>>        Handle[] aChildWebControls
18836>>>>>>>>>        
18836>>>>>>>>>        If (pbGhost(Self)) ;            Function_Return C_WebUnresolvedObject
18839>>>>>>>>>            
18839>>>>>>>>>        // Hook for controls to do pre serialize initialization
18839>>>>>>>>>        Send PreSerializeObject
18840>>>>>>>>>        
18840>>>>>>>>>        // Send a user event hook to each object before fetching the published properties....
18840>>>>>>>>>        Send OnLoad
18841>>>>>>>>>        
18841>>>>>>>>>        Get ObjectClass to hClass
18842>>>>>>>>>        If (SearchArray(hClass, aClasses) = -1) Begin
18844>>>>>>>>>            Get phoClassPropMeta to hoClassMeta
18845>>>>>>>>>            Get paWebPropertyMeta of hoClassMeta to aProperties    
18846>>>>>>>>>            
18846>>>>>>>>>            Move hClass to aClasses[-1]
18847>>>>>>>>>            
18847>>>>>>>>>            If (pjJsonCache(hoClassMeta) <> C_WebUnresolvedObject) Begin
18849>>>>>>>>>                Get pjJsonCache of hoClassMeta to hjClass
18850>>>>>>>>>            End
18850>>>>>>>>>>
18850>>>>>>>>>            Else Begin
18851>>>>>>>>>                Get Create of hoClassMeta (RefClass(cJsonObject)) to hjClass
18852>>>>>>>>>                Send InitializeJsonType of hjClass jsonTypeObject
18853>>>>>>>>>                Send SetMemberValue of hjClass "sType" jsonTypeString (psJSClass(Self))
18854>>>>>>>>>                Send SetMemberValue of hjClass "hClassId" jsonTypeInteger hClass
18855>>>>>>>>>                
18855>>>>>>>>>                Get Create (RefClass(cJsonObject)) to hjProps
18856>>>>>>>>>                Send InitializeJsonType of hjProps jsonTypeObject
18857>>>>>>>>>                
18857>>>>>>>>>                Move (SizeOfArray(aProperties) - 1) to icProperty
18858>>>>>>>>>                For iProperty from 0 to icProperty 
18864>>>>>>>>>>
18864>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClient or aProperties[iProperty].eMode = wptClientProtected) Begin
18866>>>>>>>>>                        If (aProperties[iProperty].eType = cArgArray or aProperties[iProperty].eType = cArgStruct) Begin
18868>>>>>>>>>                            If (hjAdvProps = C_WebUnresolvedObject) Begin
18870>>>>>>>>>                                Get Create (RefClass(cJsonObject)) to hjAdvProps
18871>>>>>>>>>                                Send InitializeJsonType of hjAdvProps jsonTypeObject
18872>>>>>>>>>                            End
18872>>>>>>>>>>
18872>>>>>>>>>                            
18872>>>>>>>>>                            Get aProperties[iProperty].hmGetter to vValue    // call the getter function
18873>>>>>>>>>                                
18873>>>>>>>>>                            ValueTreeSerializeParameter vValue to tVT
18874>>>>>>>>>                            Get Create (RefClass(cJsonObject)) to hjVT
18875>>>>>>>>>                            Send DataTypeToJson of hjVT tVT
18876>>>>>>>>>                            Send SetMember of hjAdvProps aProperties[iProperty].sName hjVT
18877>>>>>>>>>                            Send Destroy of hjVT
18878>>>>>>>>>                            Move tVTEmpty to tVT
18879>>>>>>>>>                        End
18879>>>>>>>>>>
18879>>>>>>>>>                        Else Begin
18880>>>>>>>>>                            Send SetMemberValue of hjProps aProperties[iProperty].sName jsonTypeString aProperties[iProperty].sDefault
18881>>>>>>>>>                        End
18881>>>>>>>>>>
18881>>>>>>>>>                    End
18881>>>>>>>>>>
18881>>>>>>>>>                Loop  
18882>>>>>>>>>>
18882>>>>>>>>>                
18882>>>>>>>>>                Send SetMember of hjClass "props" hjProps 
18883>>>>>>>>>                If (hjAdvProps <> C_WebUnresolvedObject) Begin
18885>>>>>>>>>                    Send SetMember of hjClass "advProps" hjAdvProps
18886>>>>>>>>>                    Send Destroy of hjAdvProps
18887>>>>>>>>>                    Move C_WebUnresolvedObject to hjAdvProps
18888>>>>>>>>>                End
18888>>>>>>>>>>
18888>>>>>>>>>                
18888>>>>>>>>>                Send Destroy of hjProps
18889>>>>>>>>>                
18889>>>>>>>>>                Set pjJsonCache of hoClassMeta to hjClass
18890>>>>>>>>>            End
18890>>>>>>>>>>
18890>>>>>>>>>            
18890>>>>>>>>>            Send AddMember of hjClassArray hjClass
18891>>>>>>>>>        End
18891>>>>>>>>>>
18891>>>>>>>>>        
18891>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjObject
18892>>>>>>>>>        Send InitializeJsonType of hjObject jsonTypeObject
18893>>>>>>>>>        Send SetMemberValue of hjObject "sName" jsonTypeString (Object_Label(Self))
18894>>>>>>>>>        Send SetMemberValue of hjObject "hClassId" jsonTypeInteger hClass
18895>>>>>>>>>        
18895>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjProps
18896>>>>>>>>>        Send InitializeJsonType of hjProps jsonTypeObject
18897>>>>>>>>>        Move C_WebUnresolvedObject to hjAdvProps
18898>>>>>>>>>        
18898>>>>>>>>>        Get paWebPropertyMeta to aProperties
18899>>>>>>>>>            
18899>>>>>>>>>        Move (SizeOfArray(aProperties) - 1) to icProperty
18900>>>>>>>>>        For iProperty from 0 to icProperty 
18906>>>>>>>>>>
18906>>>>>>>>>            If (aProperties[iProperty].eMode = wptClient or aProperties[iProperty].eMode = wptClientProtected and aProperties[iProperty].hmGetter <> 0) Begin
18908>>>>>>>>>                If (aProperties[iProperty].eType = cArgArray or aProperties[iProperty].eType = cArgStruct) Begin
18910>>>>>>>>>                    If (hjAdvProps = C_WebUnresolvedObject) Begin
18912>>>>>>>>>                        Get Create (RefClass(cJsonObject)) to hjAdvProps
18913>>>>>>>>>                        Send InitializeJsonType of hjAdvProps jsonTypeObject
18914>>>>>>>>>                    End
18914>>>>>>>>>>
18914>>>>>>>>>                    
18914>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClientProtected) ;                        Get GetSyncProp Self aProperties[iProperty].hmSetter aProperties[iProperty].sName to vValue // for protected web properties we query the synchronized server value as it might have WebSet before
18917>>>>>>>>>                    Else ;                        Get aProperties[iProperty].hmGetter to vValue    // call the getter function
18919>>>>>>>>>                        
18919>>>>>>>>>                    ValueTreeSerializeParameter vValue to tVT
18920>>>>>>>>>                    Get Create (RefClass(cJsonObject)) to hjVT
18921>>>>>>>>>                    Send DataTypeToJson of hjVT tVT
18922>>>>>>>>>                    Send SetMember of hjAdvProps aProperties[iProperty].sName hjVT
18923>>>>>>>>>                    Send Destroy of hjVT
18924>>>>>>>>>                    Move tVTEmpty to tVT
18925>>>>>>>>>                End
18925>>>>>>>>>>
18925>>>>>>>>>                Else Begin
18926>>>>>>>>>                    If (aProperties[iProperty].eMode = wptClientProtected) ;                        Get GetSyncProp Self aProperties[iProperty].hmSetter aProperties[iProperty].sName to vValue // for protected web properties we query the synchronized server value as it might have WebSet before
18929>>>>>>>>>                    Else ;                        Get aProperties[iProperty].hmGetter to vValue    // call the getter function
18931>>>>>>>>>                    
18931>>>>>>>>>                    Get ConvertToTransport aProperties[iProperty].hmGetter vValue aProperties[iProperty].eType to sValue
18932>>>>>>>>>                    Send SetMemberValue of hjProps aProperties[iProperty].sName jsonTypeString sValue
18933>>>>>>>>>                End
18933>>>>>>>>>>
18933>>>>>>>>>            End
18933>>>>>>>>>>
18933>>>>>>>>>        Loop
18934>>>>>>>>>>
18934>>>>>>>>>        
18934>>>>>>>>>        Send SetMember of hjObject "props" hjProps
18935>>>>>>>>>        Send Destroy of hjProps
18936>>>>>>>>>        If (hjAdvProps <> C_WebUnresolvedObject) Begin
18938>>>>>>>>>            Send SetMember of hjObject "advProps" hjAdvProps
18939>>>>>>>>>            Send Destroy of hjAdvProps
18940>>>>>>>>>        End
18940>>>>>>>>>>
18940>>>>>>>>>        
18940>>>>>>>>>        Send PassPropertyRules
18941>>>>>>>>>        
18941>>>>>>>>>        //  Serialize children
18941>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjChildren
18942>>>>>>>>>        Send InitializeJsonType of hjChildren jsonTypeArray
18943>>>>>>>>>        
18943>>>>>>>>>        Get paChildWebControls to aChildWebControls
18944>>>>>>>>>        Move (SizeOfArray(aChildWebControls) - 1) to icChild
18945>>>>>>>>>        
18945>>>>>>>>>        For iChild from 0 to icChild
18951>>>>>>>>>>
18951>>>>>>>>>            Get DoSerializeObject of aChildWebControls[iChild] hjClassArray (&aClasses) to hjChild
18952>>>>>>>>>            If (hjChild <> C_WebUnresolvedObject) Begin
18954>>>>>>>>>                Send AddMember of hjChildren hjChild
18955>>>>>>>>>                Send Destroy of hjChild
18956>>>>>>>>>            End
18956>>>>>>>>>>
18956>>>>>>>>>        Loop 
18957>>>>>>>>>>
18957>>>>>>>>>        
18957>>>>>>>>>        Send SetMember of hjObject "aObjs" hjChildren
18958>>>>>>>>>        Send Destroy of hjChildren
18959>>>>>>>>>        
18959>>>>>>>>>        
18959>>>>>>>>>        Send PostSerializeObject
18960>>>>>>>>>        
18960>>>>>>>>>        Function_Return hjObject
18961>>>>>>>>>    End_Procedure
18962>>>>>>>>>    
18962>>>>>>>>>    // Serializes this Web Object and its children to JSON and returns a JSON Handle.
18962>>>>>>>>>    Function SerializeObject Returns Handle
18964>>>>>>>>>        Handle hjClasses hjObject hjWrap
18964>>>>>>>>>        Handle[] aClasses
18965>>>>>>>>>        
18965>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjClasses
18966>>>>>>>>>        Send InitializeJsonType of hjClasses jsonTypeArray
18967>>>>>>>>>        
18967>>>>>>>>>        Get DoSerializeObject hjClasses (&aClasses) to hjObject
18968>>>>>>>>>        
18968>>>>>>>>>        Get Create (RefClass(cJsonObject)) to hjWrap
18969>>>>>>>>>        Send InitializeJsonType of hjWrap jsonTypeObject
18970>>>>>>>>>        
18970>>>>>>>>>        If (hjObject <> C_WebUnresolvedObject) Begin
18972>>>>>>>>>            Send SetMember of hjWrap "obj" hjObject
18973>>>>>>>>>            Send Destroy of hjObject
18974>>>>>>>>>        End
18974>>>>>>>>>>
18974>>>>>>>>>        
18974>>>>>>>>>        Send SetMember of hjWrap "aClasses" hjClasses
18975>>>>>>>>>        Send Destroy of hjClasses
18976>>>>>>>>>        
18976>>>>>>>>>        Function_Return hjWrap
18977>>>>>>>>>    End_Function
18978>>>>>>>>>    
18978>>>>>>>>>    // pass the responsive mode property rules to the client. These are passed to the client
18978>>>>>>>>>    // via Client Actions in the response data. This is the most flexible approach.
18978>>>>>>>>>    Procedure PassPropertyRules
18980>>>>>>>>>        Integer iProp icProp iMode icMode
18980>>>>>>>>>        String[] aParams
18981>>>>>>>>>        tWebPropRule PropRule
18981>>>>>>>>>        tWebPropRule PropRule
18981>>>>>>>>>        tWebPropRule[] aPropRules
18981>>>>>>>>>        tWebPropRule[] aPropRules
18982>>>>>>>>>
18982>>>>>>>>>        // Iterate the properties....
18982>>>>>>>>>        Get paPubPropertyRules to aPropRules
18983>>>>>>>>>        Move (SizeOfArray(aPropRules)) to icProp
18984>>>>>>>>>        
18984>>>>>>>>>        For iProp from 0 to (icProp-1)
18990>>>>>>>>>>
18990>>>>>>>>>            // iterate the modes...
18990>>>>>>>>>            Move aPropRules[iProp] to PropRule
18991>>>>>>>>>            Move (SizeOfArray(PropRule.aModeRules)) to icMode
18992>>>>>>>>>            
18992>>>>>>>>>            For iMode from 0 to (icMode-1)
18998>>>>>>>>>>
18998>>>>>>>>>                // Write the client action
18998>>>>>>>>>                Move PropRule.sName                    to aParams[0]
18999>>>>>>>>>                Move PropRule.aModeRules[iMode].eMode  to aParams[1]
19000>>>>>>>>>                Move PropRule.aModeRules[iMode].vValue to aParams[2]
19001>>>>>>>>>                Send ClientAction "propRule" aParams
19002>>>>>>>>>            Loop
19003>>>>>>>>>>
19003>>>>>>>>>        Loop
19004>>>>>>>>>>
19004>>>>>>>>>    End_Procedure
19005>>>>>>>>>
19005>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetSyncProp)
19005>>>>>>>>>    // Simply delegates this message to the global cWebSyncPropsHandler. 
19005>>>>>>>>>    //
19005>>>>>>>>>    // Note that even through we use variant for the value, it is never really converted to a 
19005>>>>>>>>>    // variant for simple types (so no unnessecary UTF-16 conversions). Confirmed in the runtime @ DF20.
19005>>>>>>>>>    //
19005>>>>>>>>>    // hoObject   - Is handle to the object which owns the property.
19005>>>>>>>>>    // hmSetter   - Is a handle to the property's getter message
19005>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
19005>>>>>>>>>    // vPropValue - Is the property value.
19005>>>>>>>>>    //
19005>>>>>>>>>    // Use the WebSet command instead of sending this message.
19005>>>>>>>>>    Procedure SetSyncProp Handle hoObject Handle hmSetter String sPropName Variant vPropValue
19007>>>>>>>>>        String sObject
19007>>>>>>>>>        tWebPropMetaData pubProp
19007>>>>>>>>>        tWebPropMetaData pubProp
19007>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
19010>>>>>>>>>        
19010>>>>>>>>>         //  Find property index
19010>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
19011>>>>>>>>>        
19011>>>>>>>>>        If (pubProp.hmGetter <= 0) Begin
19013>>>>>>>>>            Get Object_Label to sObject
19014>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSet", sPropName, sObject, C_NewLine+C_NewLine))        
19015>>>>>>>>>>
19015>>>>>>>>>            Procedure_Return
19016>>>>>>>>>        End
19016>>>>>>>>>>
19016>>>>>>>>>        
19016>>>>>>>>>        Send OwnerSetSyncProp of (Owner(Self)) hoObject (&pubProp) vPropValue
19017>>>>>>>>>    End_Procedure
19018>>>>>>>>>    
19018>>>>>>>>>    // Marks a web property as changed (different than the class default).
19018>>>>>>>>>    // Called by SetWebProp in cWebBaseObject. 
19018>>>>>>>>>    Procedure MarkWebPropChanged Handle hmSetter
19020>>>>>>>>>        tWebPropMetaData propMeta
19020>>>>>>>>>        tWebPropMetaData propMeta
19020>>>>>>>>>
19020>>>>>>>>>        //  If it is already registered at object level we are done, else look up the class definition and register it if nessecary
19020>>>>>>>>>        Get FindWebPropertyBySetter hmSetter to propMeta
19021>>>>>>>>>        If (propMeta.hmGetter <> 0) ;            Procedure_Return
19024>>>>>>>>>    
19024>>>>>>>>>        Get FindWebPropertyBySetter of (phoClassPropMeta(Self)) hmSetter to propMeta
19025>>>>>>>>>        If (propMeta.hmGetter = 0) Begin
19027>>>>>>>>>            Error DFERR_PROGRAM "Web property administration error!"
19028>>>>>>>>>>
19028>>>>>>>>>            Procedure_Return
19029>>>>>>>>>        End
19029>>>>>>>>>>
19029>>>>>>>>>    
19029>>>>>>>>>        If (propMeta.eMode = wptClient or propMeta.eMode = wptClientProtected) Begin
19031>>>>>>>>>            Send RegisterWebProperty propMeta.hmGetter propMeta.hmSetter propMeta.sName propMeta.eType propMeta.eMode 
19032>>>>>>>>>        End
19032>>>>>>>>>>
19032>>>>>>>>>
19032>>>>>>>>>    End_Procedure
19033>>>>>>>>>
19033>>>>>>>>>    // Unsynchronizes a client web property. Doing this prevents the property value from being sent
19033>>>>>>>>>    // with future requests (until it is webset or changes on the client again).
19033>>>>>>>>>    //
19033>>>>>>>>>    // Usage Example:
19033>>>>>>>>>    //  Send UnSyncWebProperty of oWebLabel1 (RefFunc(psCaption))
19033>>>>>>>>>    Procedure UnSyncWebProperty Handle hmGetter
19035>>>>>>>>>        tWebPropMetaData pubProp
19035>>>>>>>>>        tWebPropMetaData pubProp
19035>>>>>>>>>        String[] aParams
19036>>>>>>>>>    
19036>>>>>>>>>        // Find web property
19036>>>>>>>>>        Get FindWebPropertyMetaByGetter hmGetter to pubProp
19037>>>>>>>>>        
19037>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
19039>>>>>>>>>            Error DFERR_PROGRAM "UnSyncWebProperty is only supported on published client web properties."   
19040>>>>>>>>>>
19040>>>>>>>>>            Procedure_Return
19041>>>>>>>>>        End
19041>>>>>>>>>>
19041>>>>>>>>>                
19041>>>>>>>>>        //  Check the type
19041>>>>>>>>>        If (pubProp.eMode = wptClient or pubProp.eMode = wptClientProtected) Begin
19043>>>>>>>>>            Move pubProp.sName to aParams[0]
19044>>>>>>>>>            Send ClientAction "unSync" aParams
19045>>>>>>>>>        End
19045>>>>>>>>>>
19045>>>>>>>>>        Else Begin
19046>>>>>>>>>            Error DFERR_PROGRAM "UnSyncWebProperty is only supported on client web properties."
19047>>>>>>>>>>
19047>>>>>>>>>        End
19047>>>>>>>>>>
19047>>>>>>>>>    End_Procedure
19048>>>>>>>>>    
19048>>>>>>>>>    // Sets a responsive mode value for a web property. Note that this is here for compatibility, use SetPropertyRuleEx if possible.
19048>>>>>>>>>    // hmGetter   - Is a handle to the property's getter message
19048>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
19048>>>>>>>>>    // eMode      - Responsive mode, e.g. ModeTablet, ModeMobile
19048>>>>>>>>>    // vValue     - Is the property value.
19048>>>>>>>>>    //
19048>>>>>>>>>    // Use the WebSetRule command instead of sending this message.
19048>>>>>>>>>    Procedure SetPropertyRule Handle hmGetter String sPropName Integer eMode Variant vValue
19050>>>>>>>>>        tWebPropMetaData pubProp
19050>>>>>>>>>        tWebPropMetaData pubProp
19050>>>>>>>>>        
19050>>>>>>>>>        Get FindWebPropertyMetaByGetter hmGetter to pubProp
19051>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
19053>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSetRule", sPropName, C_NewLine + C_NewLine))        
19054>>>>>>>>>>
19054>>>>>>>>>            Procedure_Return
19055>>>>>>>>>        End
19055>>>>>>>>>>
19055>>>>>>>>>        
19055>>>>>>>>>        Send SetPropertyRuleEx pubProp.hmSetter sPropName eMode vValue
19056>>>>>>>>>    End_Procedure
19057>>>>>>>>>    
19057>>>>>>>>>    // Sets a responsive mode value for a web property.
19057>>>>>>>>>    // hmSetter   - Is a handle to the property's getter message
19057>>>>>>>>>    // sPropName  - Is the (case sensitive) property name.
19057>>>>>>>>>    // eMode      - Responsive mode, e.g. ModeTablet, ModeMobile
19057>>>>>>>>>    // vValue     - Is the property value.
19057>>>>>>>>>    //
19057>>>>>>>>>    // Use the WebSetRule command instead of sending this message.
19057>>>>>>>>>    Procedure SetPropertyRuleEx Handle hmSetter String sPropName Integer eMode Variant vValue
19059>>>>>>>>>        Integer iModeIndex i iCount iPropIndex
19059>>>>>>>>>        tWebPropRule PropRule
19059>>>>>>>>>        tWebPropRule PropRule
19059>>>>>>>>>        tWebPropRule[] aPropRules
19059>>>>>>>>>        tWebPropRule[] aPropRules
19060>>>>>>>>>        tWebPropMetaData pubProp
19060>>>>>>>>>        tWebPropMetaData pubProp
19060>>>>>>>>>
19060>>>>>>>>>        // Test that the passed property name belongs to the set of web properties 
19060>>>>>>>>>        // for this object.
19060>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
19061>>>>>>>>>        If (pubProp.hmGetter = 0) Begin
19063>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebSetRule", sPropName, C_NewLine + C_NewLine))        
19064>>>>>>>>>>
19064>>>>>>>>>            Procedure_Return
19065>>>>>>>>>        End
19065>>>>>>>>>>
19065>>>>>>>>>        
19065>>>>>>>>>        // sPropName is passed in "UPPERCASE". Use iIndex now to lookup the correctly cased
19065>>>>>>>>>        // property name.
19065>>>>>>>>>        Move pubProp.sName to sPropName
19066>>>>>>>>>        
19066>>>>>>>>>        // Now look to see if we already have an entry for this property. If so, get its index.
19066>>>>>>>>>        Move -1 to iPropIndex
19067>>>>>>>>>        Get paPubPropertyRules to aPropRules
19068>>>>>>>>>        Move (SizeOfArray(aPropRules)) to iCount
19069>>>>>>>>>        
19069>>>>>>>>>        For i from 0 to (iCount-1)
19075>>>>>>>>>>
19075>>>>>>>>>            If (Uppercase(aPropRules[i].sName) = sPropName) Begin
19077>>>>>>>>>                Move i to iPropIndex
19078>>>>>>>>>            End
19078>>>>>>>>>>
19078>>>>>>>>>            If (iPropIndex > -1) ;                Break
19081>>>>>>>>>        Loop
19082>>>>>>>>>>
19082>>>>>>>>>        
19082>>>>>>>>>        If (iPropIndex = -1) Begin
19084>>>>>>>>>            // Create a new entry for this property.
19084>>>>>>>>>            Move iCount to iPropIndex
19085>>>>>>>>>            Move sPropName to PropRule.sName
19086>>>>>>>>>        End
19086>>>>>>>>>>
19086>>>>>>>>>        Else Begin
19087>>>>>>>>>            Move aPropRules[iPropIndex] to PropRule
19088>>>>>>>>>        End
19088>>>>>>>>>>
19088>>>>>>>>>        
19088>>>>>>>>>        // look if we already have an entry for this mode. If so get its index.
19088>>>>>>>>>        Move -1 to iModeIndex
19089>>>>>>>>>        Move (SizeOfArray(PropRule.aModeRules)) to iCount
19090>>>>>>>>>        
19090>>>>>>>>>        For i from 0 to (iCount-1)
19096>>>>>>>>>>
19096>>>>>>>>>            If (PropRule.aModeRules[i].eMode = eMode) Begin
19098>>>>>>>>>                Move i to iModeIndex
19099>>>>>>>>>            End
19099>>>>>>>>>>
19099>>>>>>>>>            If (iModeIndex > -1) ;                Break
19102>>>>>>>>>        Loop
19103>>>>>>>>>>
19103>>>>>>>>>        
19103>>>>>>>>>        // Add or update the mode value...
19103>>>>>>>>>        If (iModeIndex = -1) Begin
19105>>>>>>>>>            Move iCount to iModeIndex
19106>>>>>>>>>        End
19106>>>>>>>>>>
19106>>>>>>>>>        
19106>>>>>>>>>        Move eMode  to PropRule.aModeRules[iModeIndex].eMode
19107>>>>>>>>>        Move vValue to PropRule.aModeRules[iModeIndex].vValue
19108>>>>>>>>>        
19108>>>>>>>>>        // Save the changes back to the array property.
19108>>>>>>>>>        Move PropRule to aPropRules[iPropIndex]
19109>>>>>>>>>        Set paPubPropertyRules to aPropRules
19110>>>>>>>>>    End_Procedure
19111>>>>>>>>>    
19111>>>>>>>>>    
19111>>>>>>>>>    //  This procedure changes the action mode of the specified server action. The action  mode
19111>>>>>>>>>    //  determines how the browser application will behave while the call to the server is being 
19111>>>>>>>>>    //  executed. The client needs to know this upfront which is why this needs to be determined 
19111>>>>>>>>>    //  before the call is actually made. It is advised to set the action mode in the OnLoad event 
19111>>>>>>>>>    //  so that it is immediately set when the object is first loaded to the client. It also needs 
19111>>>>>>>>>    //  to be set for every session independently.
19111>>>>>>>>>    //
19111>>>>>>>>>    //  hMessage - The message for which the action mode needs to be updated. Note that this 
19111>>>>>>>>>    //  message should be on the same object as this procedure is called on.
19111>>>>>>>>>    //  eMode - The action mode that should be used.
19111>>>>>>>>>    //      scModeDefault : The default mode where the browser application is not locked and 
19111>>>>>>>>>    //      multiple actions can be joined to a single action.
19111>>>>>>>>>    //      scModeWait: Locks the user interface and shows the wait cursor.
19111>>>>>>>>>    //      scModeProgress: Locks the user interface and shows the wait dialog.
19111>>>>>>>>>    //  sOptWaitMessage - The message shown in the waiting dialog for scModeWait.
19111>>>>>>>>>    //  
19111>>>>>>>>>    Procedure SetActionMode Handle hMessage Integer eMode String sOptWaitMessage
19113>>>>>>>>>        String sMsg
19113>>>>>>>>>        String[] aParams
19114>>>>>>>>>        
19114>>>>>>>>>        Get WebMethodName hMessage to sMsg
19115>>>>>>>>>        
19115>>>>>>>>>        If (sMsg <> "") Begin
19117>>>>>>>>>            Move sMsg to aParams[0]
19118>>>>>>>>>            Move eMode to aParams[1]
19119>>>>>>>>>            
19119>>>>>>>>>            If (num_arguments > 2) Begin
19121>>>>>>>>>                Move sOptWaitMessage to aParams[2]
19122>>>>>>>>>            End
19122>>>>>>>>>>
19122>>>>>>>>>            
19122>>>>>>>>>            Send ClientAction "setActionMode" aParams
19123>>>>>>>>>        End
19123>>>>>>>>>>
19123>>>>>>>>>    End_Procedure
19124>>>>>>>>>    
19124>>>>>>>>>    
19124>>>>>>>>>    //  Sends a client-action to the client that calls back the specified message on the server. 
19124>>>>>>>>>    //  This extra round-trip causes the UI to be updated which can be interresting for operations 
19124>>>>>>>>>    //  that run longer. The extra parameters are passed back to the server with the calback 
19124>>>>>>>>>    //  message.
19124>>>>>>>>>    //
19124>>>>>>>>>    //  hMsg - The message that will be called in the new round-trip (should be published and on 
19124>>>>>>>>>    //         this web object).
19124>>>>>>>>>    //  sOptArg[1-10] - Arguments passed to the callback handler.
19124>>>>>>>>>    Procedure CallBack Handle hMsg String sOptArg1 String sOptArg2 String sOptArg3 String sOptArg4 String sOptArg5 String sOptArg6 String sOptArg7 String sOptArg8 String sOptArg9 String sOptArg10
19126>>>>>>>>>        String sMethodName
19126>>>>>>>>>        String[] aParams
19127>>>>>>>>>        
19127>>>>>>>>>        
19127>>>>>>>>>        Get WebMethodName hMsg to sMethodName
19128>>>>>>>>>        If (sMethodName <> "") Begin
19130>>>>>>>>>            Move sMethodName to aParams[0]
19131>>>>>>>>>            
19131>>>>>>>>>            If (num_arguments >= 2) ;                Move sOptArg1 to aParams[1]
19134>>>>>>>>>            If (num_arguments >= 3) ;                Move sOptArg2 to aParams[2]
19137>>>>>>>>>            If (num_arguments >= 4) ;                Move sOptArg3 to aParams[3]
19140>>>>>>>>>            If (num_arguments >= 5) ;                Move sOptArg4 to aParams[4]
19143>>>>>>>>>            If (num_arguments >= 6) ;                Move sOptArg5 to aParams[5]
19146>>>>>>>>>            If (num_arguments >= 7) ;                Move sOptArg6 to aParams[6]
19149>>>>>>>>>            If (num_arguments >= 8) ;                Move sOptArg7 to aParams[7]
19152>>>>>>>>>            If (num_arguments >= 9) ;                Move sOptArg8 to aParams[8]
19155>>>>>>>>>            If (num_arguments >= 10) ;                Move sOptArg9 to aParams[0]
19158>>>>>>>>>            If (num_arguments >= 11) ;                Move sOptArg10 to aParams[10]
19161>>>>>>>>>            
19161>>>>>>>>>            Send ClientAction "callBack" aParams
19162>>>>>>>>>        End
19162>>>>>>>>>>
19162>>>>>>>>>        
19162>>>>>>>>>    End_Procedure
19163>>>>>>>>>
19163>>>>>>>>>    
19163>>>>>>>>>    //  This function searches the message handle based on the name of a web method. It will 
19163>>>>>>>>>    //  give an error if the web method is not found (not published). Use the WebPublishProcedure 
19163>>>>>>>>>    //  and WebPublishFunction commands to publish the message.
19163>>>>>>>>>    //      sMethodName - The name of the web method.
19163>>>>>>>>>    Function WebMethodByName String sMethodName Returns Handle
19165>>>>>>>>>        String[] aPubMethodNames
19166>>>>>>>>>        Handle[] aPubMethodHandles
19167>>>>>>>>>        Integer iIndex
19167>>>>>>>>>        
19167>>>>>>>>>        Get paPubMethodHandles to aPubMethodHandles
19168>>>>>>>>>        Get paPubMethodNames   to aPubMethodNames      
19169>>>>>>>>>          // Lookup the passed action....
19169>>>>>>>>>        Move (SearchArray(Uppercase(sMethodName), aPubMethodNames)) to iIndex
19170>>>>>>>>>        
19170>>>>>>>>>        If (iIndex = -1) Begin
19172>>>>>>>>>            // Unregistered methods cannot be called by client (security)
19172>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppMethodNotPublished, sMethodName, Object_Label(Self)))
19173>>>>>>>>>>
19173>>>>>>>>>
19173>>>>>>>>>            Function_Return C_WebUnresolvedObject
19174>>>>>>>>>        End
19174>>>>>>>>>>
19174>>>>>>>>>        Else Begin
19175>>>>>>>>>            Function_Return aPubMethodHandles[iIndex] 
19176>>>>>>>>>        End
19176>>>>>>>>>>
19176>>>>>>>>>    End_Function
19177>>>>>>>>>    
19177>>>>>>>>>    
19177>>>>>>>>>    //  Use this function to determine if a web method is a function or a procedure. An error is 
19177>>>>>>>>>    //  given when the method is not found or published. The function returns true if the method is
19177>>>>>>>>>    //  a function, false for a procedure or if it is not found.
19177>>>>>>>>>    //      hMessage   - The message handle.
19177>>>>>>>>>    Function WebMethodIsFunction Handle hMessage Returns Boolean
19179>>>>>>>>>        Handle[] aPubMethodHandles
19180>>>>>>>>>        Boolean[] aPubMethodIsFunction
19181>>>>>>>>>        Integer iIndex
19181>>>>>>>>>        
19181>>>>>>>>>        Get paPubMethodHandles      to aPubMethodHandles
19182>>>>>>>>>        Get paPubMethodIsFunction   to aPubMethodIsFunction      
19183>>>>>>>>>        Move (SearchArray(hMessage, aPubMethodHandles)) to iIndex
19184>>>>>>>>>        
19184>>>>>>>>>        //  Check if found
19184>>>>>>>>>        If (iIndex = -1) Begin
19186>>>>>>>>>            // Unregistered methods cannot be called by client (security, security, security!)
19186>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppMethodNotPublished, hMessage, Object_Label(Self)))
19187>>>>>>>>>>
19187>>>>>>>>>            
19187>>>>>>>>>            Function_Return False
19188>>>>>>>>>        End
19188>>>>>>>>>>
19188>>>>>>>>>        Else Begin
19189>>>>>>>>>            Function_Return aPubMethodIsFunction[iIndex] 
19190>>>>>>>>>        End
19190>>>>>>>>>>
19190>>>>>>>>>    End_Function
19191>>>>>>>>>    
19191>>>>>>>>>    
19191>>>>>>>>>    //  This function converts the message handle of a web method into a string. It will give an 
19191>>>>>>>>>    //  error if the message is not published and return an empty String. Use the 
19191>>>>>>>>>    //  WebPublishProcedure and WebPublishFunction commands to publish the message.
19191>>>>>>>>>    //      hMessage   - The message handle.
19191>>>>>>>>>    Function WebMethodName Handle hMessage Returns String
19193>>>>>>>>>        String[] aPubMethodNames
19194>>>>>>>>>        Handle[] aPubMethodHandles
19195>>>>>>>>>        Integer iIndex
19195>>>>>>>>>        
19195>>>>>>>>>        Get paPubMethodHandles to aPubMethodHandles
19196>>>>>>>>>        Get paPubMethodNames   to aPubMethodNames      
19197>>>>>>>>>        Move (SearchArray(hMessage, aPubMethodHandles)) to iIndex
19198>>>>>>>>>        
19198>>>>>>>>>        //  Check if found
19198>>>>>>>>>        If (iIndex = -1) Begin
19200>>>>>>>>>            // Unregistered methods cannot be called by client (security, security, security!)
19200>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppMethodNotPublished, hMessage, Object_Label(Self)))
19201>>>>>>>>>>
19201>>>>>>>>>            
19201>>>>>>>>>            Function_Return ""
19202>>>>>>>>>        End
19202>>>>>>>>>>
19202>>>>>>>>>        Else Begin
19203>>>>>>>>>            Function_Return aPubMethodNames[iIndex] 
19204>>>>>>>>>        End
19204>>>>>>>>>>
19204>>>>>>>>>    End_Function
19205>>>>>>>>>    
19205>>>>>>>>>    
19205>>>>>>>>>    //  This function searches the object handle of a web object using its public name. The object 
19205>>>>>>>>>    //  name can be obtained by calling the WebObjectName Function on a web Object. If it can't 
19205>>>>>>>>>    //  find the Object it will cause an Error and return 0.
19205>>>>>>>>>    //      sObjectName - Name of the web object.
19205>>>>>>>>>    Function WebObjectByName String sObjectName Boolean bOptErr Returns Handle
19207>>>>>>>>>        Handle hWO
19207>>>>>>>>>        Boolean bErr
19207>>>>>>>>>        
19207>>>>>>>>>        Move True to bErr
19208>>>>>>>>>        If (num_arguments > 1) ;            Move bOptErr to bErr
19211>>>>>>>>>        
19211>>>>>>>>>        Get FindWebObject of (Owner(Self)) sObjectName bErr to hWO
19212>>>>>>>>>        
19212>>>>>>>>>        If (hWO = C_WebUnresolvedObject and bErr) Begin
19214>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound,sObjectName))
19215>>>>>>>>>>
19215>>>>>>>>>        End
19215>>>>>>>>>>
19215>>>>>>>>>        
19215>>>>>>>>>        Function_Return hWO
19216>>>>>>>>>    End_Function
19217>>>>>>>>>    
19217>>>>>>>>>    //  Get the public web object name of this object. The client knows the object by this name. 
19217>>>>>>>>>    //  The name is the long name of Object without the first level name "oWebApp". for example 
19217>>>>>>>>>    //  "oView.oButton". This name is used because the Object Handle itself should never be sent 
19217>>>>>>>>>    //  to the client (security and reliability).
19217>>>>>>>>>    Function WebObjectName Returns String
19219>>>>>>>>>        Handle hoOwner
19219>>>>>>>>>        Integer iPos
19219>>>>>>>>>        String sObjectName sOwnerName sContainer sDynamicObjectId
19219>>>>>>>>>        
19219>>>>>>>>>        Get Owner to hoOwner
19220>>>>>>>>>        Get Name to sObjectName
19221>>>>>>>>>        
19221>>>>>>>>>        Send OwnerMangleWebObjectName of hoOwner Self (&sObjectName)
19222>>>>>>>>>        
19222>>>>>>>>>        Function_Return sObjectName
19223>>>>>>>>>    End_Function
19224>>>>>>>>>
19224>>>>>>>>>
19224>>>>>>>>>
19224>>>>>>>>>    // Callback method sent to the callback control when a view receives NavigateForward.
19224>>>>>>>>>    // This should populate the tWebNavigateData in the default way according to the control's data bindings.
19224>>>>>>>>>    Procedure GetNavigateBackData Handle hoView tWebNavigateData ByRef NavigateData
19226>>>>>>>>>        // ask the view to load the default data
