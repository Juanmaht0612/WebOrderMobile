6137>>>>>    Function CreateButtonImageList String sImage Integer iHt Integer iWd Returns Handle
6139>>>>>        Handle hoImage
6139>>>>>        Integer iIndex
6139>>>>>        Boolean bAutoSize
6139>>>>>        Get pbAutoResizeIcons to bAutoSize
6140>>>>>        // must do it this way as image size must be set before end_construct_object
6140>>>>>        Object oImageList is a cImageList32
6142>>>>>            Set piMaxImages to 1
