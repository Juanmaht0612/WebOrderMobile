16656>>>>>>>        
16656>>>>>>>        // when errors are reported should technical info be provided. If set
16656>>>>>>>        // to true you get Error#, Line#, File# and Field#. 
16656>>>>>>>        Property Integer pbVerboseErrors False
16657>>>>>>>        
16657>>>>>>>        // When True, VDF errors are queued. This should only be set
16657>>>>>>>        // indirectly with ErrorQueueStart and ErrorQueueEnd
16657>>>>>>>        Property Integer pbQueueErrors False
16658>>>>>>>        
16658>>>>>>>        // If true, ALL errors are recorded in the event log. This
16658>>>>>>>        // is good for debugging. If false only appropriate error
16658>>>>>>>        // are event logged.
16658>>>>>>>        Property Integer pbAllErrorsToEventLog False
16659>>>>>>>        
16659>>>>>>>        // If true, errors are directed to the VDF error handler. This
16659>>>>>>>        // means an error will pop up on your VDF program. Normally not
16659>>>>>>>        // wanted for the web, but this can be useful when debugging at
16659>>>>>>>        // the server
16659>>>>>>>        Property Integer pbAllErrorsToLocal False
16660>>>>>>>        
