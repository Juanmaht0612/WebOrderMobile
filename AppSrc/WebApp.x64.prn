3347>>>>>//  1. Support Autosizing (auto_size_state). Default to T.
3347>>>>>//  2. Set skip_state to true.
3347>>>>>//  3. Determine color by looking at parent object
3347>>>>>//  4. Default J_mode is left, vertical centered.
3347>>>>>//  5. Understands GET/SET Label
3347>>>>>//
3347>>>>>Enum_List
3347>>>>>    Define TBSHADOW_ON_NONE
3347>>>>>    Define TBSHADOW_ON_LOCAL
3347>>>>>    Define TBSHADOW_ON_GROUP
3347>>>>>    Define TBSHADOW_ON_ALL
3347>>>>>End_Enum_List
