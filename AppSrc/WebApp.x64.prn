20335>>>>>>>>>>>
20335>>>>>>>>>>>// This provides DEO to DDO server support for Web DEOs.
20335>>>>>>>>>>>//
20335>>>>>>>>>>>// Notes:
20335>>>>>>>>>>>// Property Add_Focus_msg   - not supported.
20335>>>>>>>>>>>// Property Deferred_State  - not supported.
20335>>>>>>>>>>>// Property Default_static_server_state - not supported.
20335>>>>>>>>>>>// Property Refresh_Dirty_State         - not supported
20335>>>>>>>>>>>// Property Static_Server_State         - not supported.
20335>>>>>>>>>>>//
20335>>>>>>>>>>>// Function Find_Server - not supported.
20335>>>>>>>>>>>Class cWebBaseDEOServer is a cWebBaseUIObject
20336>>>>>>>>>>>    //   Server is the object id of the database agent for this object.
20336>>>>>>>>>>>    //
20336>>>>>>>>>>>    //   Watched_Servers is a set of object ids for database agents whose state
20336>>>>>>>>>>>    //   must also be monitored by this object (but which never receive requests
20336>>>>>>>>>>>    //   directly from this object, unlike the Server).
20336>>>>>>>>>>>    //
20336>>>>>>>>>>>    //   Servers_Scanned determines if the items of this object have been
20336>>>>>>>>>>>    //   scanned to see if this object should be connected to other database
20336>>>>>>>>>>>    //   agents as 'just watching' (see Watched_Servers, above).
20336>>>>>>>>>>>    //
20336>>>>>>>>>>>    Procedure Construct_Object
20338>>>>>>>>>>>        Forward Send Construct_Object
20340>>>>>>>>>>>        
20340>>>>>>>>>>>        Property Boolean Auto_Fill_State False       // Used to tell DDO's whether first record should be found automatically after a clear.
20341>>>>>>>>>>>        Property Boolean pbAutoFillOnInit False      // Used to tell DDO's that we want autofill on initialization when DEO is attaching
20342>>>>>>>>>>>        
20342>>>>>>>>>>>        Property Integer private_Server 0
20343>>>>>>>>>>>        Property Integer Watched_Servers 0          // Handle to Broadcaster object broacasting tos server DDO's
20344>>>>>>>>>>>        // used to send Set Changed_State to "foreign" servers, while Watched_Servers
20344>>>>>>>>>>>        // is used for sending messages from the DDO to DEOs (there are more of them)
20344>>>>>>>>>>>        Property Integer ChangedStateWatched_Servers     0
20345>>>>>>>>>>>        Property Integer private_pbServersScanned 0
20346>>>>>>>>>>>        
20346>>>>>>>>>>>        // added to support DEO request-delegation. This is set true if the
20346>>>>>>>>>>>        // server is explicitly set in this DEO (normally via a USING parameter).
20346>>>>>>>>>>>        Property Integer Explicit_Server_State False
20347>>>>>>>>>>>        
20347>>>>>>>>>>>        // Since this package's SET changed_state is using change_disabled_state
20347>>>>>>>>>>>        // we might as well Define it here. This gets changed by Clear_mx to support
20347>>>>>>>>>>>        // setting of defaults without changing the objects changed_state.
20347>>>>>>>>>>>        //
20347>>>>>>>>>>>        // This stops changed_state from getting changed. It allows item_changed_state
20347>>>>>>>>>>>        // to change without the object's changed_state getting changed. This Should
20347>>>>>>>>>>>        // be considered protected (i.e., likely to change). The new messages Entry_Defaults
20347>>>>>>>>>>>        // and Set Default_Value are both public and Use this. Try to use these messages
20347>>>>>>>>>>>        // instead of this Property.
20347>>>>>>>>>>>        Property Integer Change_Disabled_State False
20348>>>>>>>>>>>        
20348>>>>>>>>>>>        Property Boolean Extended_DEO_State False    // Defines DEO behavior according to Extended_DEO_State of the server DDO
20349>>>>>>>>>>>        
20349>>>>>>>>>>>        Property Boolean Active_State False          // True when the DEO has been attached to the DDO
20350>>>>>>>>>>>        
20350>>>>>>>>>>>        Property Handle Verify_Save_msg (RefProc(SaveConfirmation))
20351>>>>>>>>>>>        Property Handle Verify_Data_Loss_msg (RefProc(DataLossConfirmation))
20352>>>>>>>>>>>        Property Handle Verify_Delete_msg (RefProc(DeleteConfirmation))
20353>>>>>>>>>>>        
20353>>>>>>>>>>>        // pbClearAfterSave: When true forces a DDO Request_Clear after performing a Request_Save. This property is reached
20353>>>>>>>>>>>        // via delegation from the DEO that processes the Request_Save operation. Thus this property will control the
20353>>>>>>>>>>>        // behavior for all DEOs belonging to this view.
20353>>>>>>>>>>>        Property Boolean pbClearAfterSave True
20354>>>>>>>>>>>        
20354>>>>>>>>>>>        // Determines if the Delete callback is allowed, is set to true when the verification dialog is shown. Additional security check.
20354>>>>>>>>>>>        Property Boolean pbDeleteCallbackActive False
20357>>>>>>>>>>>        // Determines if the Save callback is allowed, is set to true when the verification dialog is shown. Additional security check.
20357>>>>>>>>>>>        Property Boolean pbSaveCallbackActive False
20360>>>>>>>>>>>        
20360>>>>>>>>>>>        WebPublishProcedure RequestClearCallback
20361>>>>>>>>>>>        WebPublishProcedure RequestDeleteCallback
20362>>>>>>>>>>>        WebPublishProcedure RequestSaveCallBack
20363>>>>>>>>>>>        WebPublishProcedure RequestClearAllCallback
20364>>>>>>>>>>>    End_Procedure
20365>>>>>>>>>>>    
20365>>>>>>>>>>>    
20365>>>>>>>>>>>    // This procedure adds the specified object id (hoServer) to this object's
20365>>>>>>>>>>>    // set of database agents who are merely 'watched', and establishes a
20365>>>>>>>>>>>    // connection between the database agent and this object.
20365>>>>>>>>>>>    //
20365>>>>>>>>>>>    Procedure Add_Watched_Server Integer hoServer
20367>>>>>>>>>>>        Integer iIndex
20367>>>>>>>>>>>        Handle hoWatchedServers
20367>>>>>>>>>>>        
20367>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
20368>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
20370>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
20371>>>>>>>>>>>            Set Watched_Servers to hoWatchedServers
20372>>>>>>>>>>>        End
20372>>>>>>>>>>>>
20372>>>>>>>>>>>        
20372>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
20373>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
20374>>>>>>>>>>>        
20374>>>>>>>>>>>        If (iIndex < 0) Begin
20376>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
20377>>>>>>>>>>>        End
20377>>>>>>>>>>>>
20377>>>>>>>>>>>        
20377>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
20378>>>>>>>>>>>        
20378>>>>>>>>>>>        If (iIndex < 0 and Active_State(Self)) Begin
20380>>>>>>>>>>>            Send Add_User_Interface to hoServer Self True // TRUE for watchers
20381>>>>>>>>>>>        End
20381>>>>>>>>>>>>
20381>>>>>>>>>>>    End_Procedure
20382>>>>>>>>>>>    
20382>>>>>>>>>>>    Procedure Add_ChangedStateWatched_Server Integer hoServer
20384>>>>>>>>>>>        Integer iIndex
20384>>>>>>>>>>>        Handle hoWatchedServers
20384>>>>>>>>>>>        
20384>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
20385>>>>>>>>>>>        If (hoWatchedServers = 0) Begin
20387>>>>>>>>>>>            Get Create of Desktop U_Broadcaster to hoWatchedServers // modern syntax
20388>>>>>>>>>>>            Set ChangedStateWatched_Servers to hoWatchedServers
20389>>>>>>>>>>>        End
20389>>>>>>>>>>>>
20389>>>>>>>>>>>        
20389>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to False
20390>>>>>>>>>>>        Get Find_Element of hoWatchedServers hoServer to iIndex
20391>>>>>>>>>>>        
20391>>>>>>>>>>>        If (iIndex < 0) Begin
20393>>>>>>>>>>>            Send Add_Element to hoWatchedServers hoServer
20394>>>>>>>>>>>        End
20394>>>>>>>>>>>>
20394>>>>>>>>>>>        
20394>>>>>>>>>>>        Set Broadcast_State of hoWatchedServers to True
20395>>>>>>>>>>>    End_Procedure
20396>>>>>>>>>>>    
20396>>>>>>>>>>>    
20396>>>>>>>>>>>    // Expects the class to understand the Active_State property. Relies on the pbDataBindable interface.
20396>>>>>>>>>>>    Procedure Attach_Deo_To_Server
20398>>>>>>>>>>>        Integer hoServer hoWatchedServers
20398>>>>>>>>>>>        Boolean bServerScan bDataBindable
20398>>>>>>>>>>>        
20398>>>>>>>>>>>        Get Server to hoServer
20399>>>>>>>>>>>        Get pbDataBindable to bDataBindable
20400>>>>>>>>>>>        
20400>>>>>>>>>>>        If (hoServer <> 0) Begin
20402>>>>>>>>>>>            Send Add_User_Interface to hoServer Self
20403>>>>>>>>>>>            // Extended_DEO_State is used to determine whether the object receives the data binding related
20403>>>>>>>>>>>            // message interface from the server DDO...
20403>>>>>>>>>>>            Set Extended_DEO_State to (Extended_DSO_State(hoServer) and bDataBindable)
20404>>>>>>>>>>>        End
20404>>>>>>>>>>>>
20404>>>>>>>>>>>        
20404>>>>>>>>>>>        Get private_pbServersScanned to bServerScan
20405>>>>>>>>>>>        If (not(bServerScan)) Begin
20407>>>>>>>>>>>            Send Scan_Servers
20408>>>>>>>>>>>        End
20408>>>>>>>>>>>>
20408>>>>>>>>>>>        
20408>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
20409>>>>>>>>>>>        If hoWatchedServers Begin
20411>>>>>>>>>>>            Send Add_User_Interface to hoWatchedServers Self True // True for watchers
20412>>>>>>>>>>>        End
20412>>>>>>>>>>>>
20412>>>>>>>>>>>        
20412>>>>>>>>>>>        Set Active_State to True
20413>>>>>>>>>>>    End_Procedure
20414>>>>>>>>>>>    
20414>>>>>>>>>>>    
20414>>>>>>>>>>>    // Changed so that this respects Change_disabled_state. I don't
20414>>>>>>>>>>>    // like this here but its the best I can think of. Therefore, all
20414>>>>>>>>>>>    // objects using server.pkg must understand Change_disabled_state.
20414>>>>>>>>>>>    //
20414>>>>>>>>>>>    // Changed to not remove from server if static.
20414>>>>>>>>>>>    Procedure Set Changed_State Integer newVal
20416>>>>>>>>>>>        Integer hoServer hoWatchedServers
20416>>>>>>>>>>>        
20416>>>>>>>>>>>        If not (Change_Disabled_State(Self)) Begin
20418>>>>>>>>>>>            Get server to hoServer
20419>>>>>>>>>>>            
20419>>>>>>>>>>>            If (newVal and hoServer) Begin
20421>>>>>>>>>>>                Set Changed_State of hoServer to True
20422>>>>>>>>>>>                // We also set changed_state of all "foreign" servers. These
20422>>>>>>>>>>>                // are the ones whose Data_File is a parent File
20422>>>>>>>>>>>                Get ChangedStateWatched_Servers to hoWatchedServers
20423>>>>>>>>>>>                If hoWatchedServers ;                    Set Changed_State of hoWatchedServers to True
20426>>>>>>>>>>>            End
20426>>>>>>>>>>>>
20426>>>>>>>>>>>        End
20426>>>>>>>>>>>>
20426>>>>>>>>>>>    End_Procedure
20427>>>>>>>>>>>    
20427>>>>>>>>>>>    // returns the table's status for the refresh event. A table can either be
20427>>>>>>>>>>>    // cleared, found or not touched by the operation. This can only be called while
20427>>>>>>>>>>>    // within Refresh. This was created to hide the private is_file_included command
20427>>>>>>>>>>>    Function DDRefreshTableStatus Integer iTable Returns Integer
20429>>>>>>>>>>>        Boolean bIncluded
20429>>>>>>>>>>>        is_file_included iTable 1 to bIncluded // see if main file is in find done array
20431>>>>>>>>>>>        If bIncluded Begin
20433>>>>>>>>>>>            Function_Return ddrtsFound
20434>>>>>>>>>>>        End
20434>>>>>>>>>>>>
20434>>>>>>>>>>>        is_file_included iTable 0 to bIncluded // see if main file is in clear done array
20436>>>>>>>>>>>        If bIncluded Begin
20438>>>>>>>>>>>            Function_Return ddrtsCleared
20439>>>>>>>>>>>            
20439>>>>>>>>>>>        End
20439>>>>>>>>>>>>
20439>>>>>>>>>>>        Function_Return ddrtsNone
20440>>>>>>>>>>>    End_Function
20441>>>>>>>>>>>    
20441>>>>>>>>>>>    
20441>>>>>>>>>>>    
20441>>>>>>>>>>>    //   This procedure empties the Watched_Servers broadcaster, after
20441>>>>>>>>>>>    //   detaching this object from all of the broadcaster's elements.
20441>>>>>>>>>>>    //   This procedure is invoked by Find_Servers_to_Watch, in preparation
20441>>>>>>>>>>>    //   for a scan.
20441>>>>>>>>>>>    Procedure Delete_Watched_Servers
20443>>>>>>>>>>>        Integer hoWatchedServers
20443>>>>>>>>>>>        
20443>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
20444>>>>>>>>>>>        If hoWatchedServers Begin
20446>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // detach from all, TRUE for watchers
20447>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
20448>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
20449>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
20450>>>>>>>>>>>        End
20450>>>>>>>>>>>>
20450>>>>>>>>>>>        
20450>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatchedServers
20451>>>>>>>>>>>        If hoWatchedServers Begin
20453>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
20454>>>>>>>>>>>            Send Delete_Data to hoWatchedServers                     // empty it
20455>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
20456>>>>>>>>>>>        End
20456>>>>>>>>>>>>
20456>>>>>>>>>>>    End_Procedure
20457>>>>>>>>>>>    
20457>>>>>>>>>>>    // Required DD/DEO interface. Indicates if this DEO is a data bindable control or a container.
20457>>>>>>>>>>>    // For cWebControls, this is just another way of querying pbDataBindable, used by DD's
20457>>>>>>>>>>>    Function DEO_Control_Object Returns Boolean
20459>>>>>>>>>>>        Boolean bDataBindable
20459>>>>>>>>>>>        Get pbDataBindable to bDataBindable
20460>>>>>>>>>>>        Function_Return bDataBindable
20461>>>>>>>>>>>    End_Function
20462>>>>>>>>>>>    
20462>>>>>>>>>>>    // Required DD/DEO interface. Indicates that this DEO understands the DEO Request_Find protocol
20462>>>>>>>>>>>    Function DEO_Find_Object Returns Boolean
20464>>>>>>>>>>>        Function_Return False
20465>>>>>>>>>>>    End_Function
20466>>>>>>>>>>>    
20466>>>>>>>>>>>    // Used to determine if the object understands the DEO interface.
20466>>>>>>>>>>>    // Probably not used in Ajax WebApps.
20466>>>>>>>>>>>    Function DEO_Object Returns Boolean
20468>>>>>>>>>>>        Function_Return True
20469>>>>>>>>>>>    End_Function
20470>>>>>>>>>>>    
20470>>>>>>>>>>>    // This only gets called when the developer is killing this object. During application
20470>>>>>>>>>>>    // shut-down, only destroy_object is called. This augmentation destroys the watched broadcaster
20470>>>>>>>>>>>    // (which is sitting on the desktop). During program shut down we don't care if this is called
20470>>>>>>>>>>>    // because it is getting destroyed anyway. We are making the assumption that a developer controlled
20470>>>>>>>>>>>    // destroy will always be called with the watcher still existing.
20470>>>>>>>>>>>    Procedure Destroy
20472>>>>>>>>>>>        Handle hoWatched
20472>>>>>>>>>>>        Set Changed_State to False //   is this really needed anymore???
20473>>>>>>>>>>>        // if non 0, The watched server, must still exist.
20473>>>>>>>>>>>        Get Watched_Servers to hoWatched
20474>>>>>>>>>>>        If hoWatched Begin
20476>>>>>>>>>>>            Set Broadcast_State of hoWatched to False
20477>>>>>>>>>>>            Send Destroy of hoWatched     // destroy the broadcaster
20478>>>>>>>>>>>        End
20478>>>>>>>>>>>>
20478>>>>>>>>>>>        // if non 0, The bound watched server, must still exist.
20478>>>>>>>>>>>        Get ChangedStateWatched_Servers to hoWatched
20479>>>>>>>>>>>        If hoWatched Begin
20481>>>>>>>>>>>            Set Broadcast_State of hoWatched to False
20482>>>>>>>>>>>            Send Destroy of hoWatched     // destroy the broadcaster
20483>>>>>>>>>>>        End
20483>>>>>>>>>>>>
20483>>>>>>>>>>>        Forward Send Destroy
20485>>>>>>>>>>>    End_Procedure
20486>>>>>>>>>>>    
20486>>>>>>>>>>>    
20486>>>>>>>>>>>    // Required DD/DEO interface
20486>>>>>>>>>>>    // sent by DD before a find and save. We only care about DD finds which
20486>>>>>>>>>>>    // means DoAll is 1
20486>>>>>>>>>>>    Procedure Entry_Update Integer iFile Integer iDoAll
20488>>>>>>>>>>>        // STUB: Not used with Ajax WebApp
20488>>>>>>>>>>>    End_Procedure
20489>>>>>>>>>>>    
20489>>>>>>>>>>>    
20489>>>>>>>>>>>    //   This procedure scans the fields of this object's items to determine
20489>>>>>>>>>>>    //   what other database agents (data_sets) other than this object's Server
20489>>>>>>>>>>>    //   should be 'watched' (for data changes).
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    //   iTableFlag is a boolean determining whether this object relies on a
20489>>>>>>>>>>>    //   prototype row (TRUE) or an item list (FALSE).
20489>>>>>>>>>>>    //   [JVH] VDF 17.0 - Ignored in this class.
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    //   This object must understand pbDataBindable, and have a private
20489>>>>>>>>>>>    //   boolean property named Private_pbServersScanned to note the event.
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    // Notes
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    //   This procedure is invoked once per object, the first time the object
20489>>>>>>>>>>>    //   is activated.  If the data_file, data_field, and/or main_file of this
20489>>>>>>>>>>>    //   object are changed (don't change them while this object is active!),
20489>>>>>>>>>>>    //   set Private_pbServersScanned to FALSE to force this object to scan
20489>>>>>>>>>>>    //   again (when it is next activated).
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    
20489>>>>>>>>>>>    // 17.0: The logic has been retooled to add more watched servers to the DDOs. This is done so
20489>>>>>>>>>>>    // DD operations will send Refresh to these additional watched-servers. There are two changes:
20489>>>>>>>>>>>    // 1. Containers are now made watched servers for the Server and all parent servers
20489>>>>>>>>>>>    // 2. Non-file.field DEOs (e.g., expressions) are made watched servers for the server (which it
20489>>>>>>>>>>>    //    already did and for all parent servers. Without this, parent entry_item expressions were not
20489>>>>>>>>>>>    //    getting updated
20489>>>>>>>>>>>    // Here is how watched-servers works.
20489>>>>>>>>>>>    // Each DEO attaches and detaches from its Server by sending Add_User_interface and Remove_User_interface
20489>>>>>>>>>>>    // to the server DD. Once attached, the DD knows about this DEO and sends messages to it as needed (Refresh,
20489>>>>>>>>>>>    // Entry_Update, etc.). In addition, a DEO may need to attach a parent DDO so that changes in that parent DD
20489>>>>>>>>>>>    // results in those messages being sent. This is needed if the binding table in entry_item refers to a parent
20489>>>>>>>>>>>    // table. So we need to send Add_User_interface and Remove_User_interface to that parent server as well. If a DEO
20489>>>>>>>>>>>    // has multiple, there could be multiple parent servers. As of 17.0, we are also attaching to parent servers if
20489>>>>>>>>>>>    // we are unsure about how the DEO is being used. If an expression is used, it might need to be updated when
20489>>>>>>>>>>>    // a parent (or any ancestor) changes. Each DEO keeps track of servers that it attaches to and this is referred
20489>>>>>>>>>>>    // to as the watched_server list. This list is maintained so the DEO knows which DDOs to attach and detach to.
20489>>>>>>>>>>>    //
20489>>>>>>>>>>>    // [JVH] VDF 17.1 cWebAppDEOServer_mixin Notes:
20489>>>>>>>>>>>    // - Modified to support only 1 item per control. Get Item_Count interface not supported.
20489>>>>>>>>>>>    // - Modified to not support the Prototype_Object interface (old windows Table class).
20489>>>>>>>>>>>    Procedure Find_Servers_To_Watch Integer iTableFlag
20491>>>>>>>>>>>        Integer iFileNum iServerFile
20491>>>>>>>>>>>        Handle hoServer hoDataSet
20491>>>>>>>>>>>        Boolean bDataBindable
20491>>>>>>>>>>>        
20491>>>>>>>>>>>        Get pbDataBindable to bDataBindable
20492>>>>>>>>>>>        Set Private_pbServersScanned to True
20493>>>>>>>>>>>        Get Server to hoServer
20494>>>>>>>>>>>        
20494>>>>>>>>>>>        If (hoServer = 0) Begin
20496>>>>>>>>>>>            Procedure_Return
20497>>>>>>>>>>>        End
20497>>>>>>>>>>>>
20497>>>>>>>>>>>        
20497>>>>>>>>>>>        Send Delete_Watched_Servers  // empty Watched_Servers broadcaster first
20498>>>>>>>>>>>        Get Main_File of hoServer to iServerFile  // data-set's main-file
20499>>>>>>>>>>>        
20499>>>>>>>>>>>        If (not(bDataBindable)) Begin
20501>>>>>>>>>>>            // containers should get added to all parent DDOs
20501>>>>>>>>>>>            Send WatchAllParentServers hoServer
20502>>>>>>>>>>>            Procedure_Return
20503>>>>>>>>>>>        End
20503>>>>>>>>>>>>
20503>>>>>>>>>>>        
20503>>>>>>>>>>>        Get Data_File to iFileNum
20504>>>>>>>>>>>        // we need watched server if file exists, it is not the main file
20504>>>>>>>>>>>        // and is not an updating file (as opposed to updating data-set).
20504>>>>>>>>>>>        If (iFileNum > 0 and iFileNum <> iServerFile) Begin
20506>>>>>>>>>>>            Get Which_Data_Set of hoServer iFileNum to hoDataSet
20507>>>>>>>>>>>            If (hoDataSet <> 0 and hoDataSet <> hoServer) Begin
20509>>>>>>>>>>>                Send Add_Watched_Server hoDataSet
20510>>>>>>>>>>>                Send Add_ChangedStateWatched_Server hoDataSet
20511>>>>>>>>>>>            End
20511>>>>>>>>>>>>
20511>>>>>>>>>>>        End
20511>>>>>>>>>>>>
20511>>>>>>>>>>>        Else If (iFileNum = 0) Begin
20514>>>>>>>>>>>            // if no file (e.g., expression) we don't know when it changes so we tell all servers
20514>>>>>>>>>>>            // that this is a watcher
20514>>>>>>>>>>>            Send WatchAllParentServers hoServer
20515>>>>>>>>>>>        End
20515>>>>>>>>>>>>
20515>>>>>>>>>>>    End_Procedure
20516>>>>>>>>>>>    
20516>>>>>>>>>>>    // This function returns the object id of the database agent of this object,
20516>>>>>>>>>>>    // or 0.
20516>>>>>>>>>>>    Function Locate_Server Returns Integer
20518>>>>>>>>>>>        Handle hoServer
20518>>>>>>>>>>>        Get Server to hoServer
20519>>>>>>>>>>>        Function_Return hoServer
20520>>>>>>>>>>>    End_Function
20521>>>>>>>>>>>    
20521>>>>>>>>>>>    Procedure Refresh Integer eMode
20523>>>>>>>>>>>    End_Procedure
20524>>>>>>>>>>>    
20524>>>>>>>>>>>    //   This procedure discontinues the connection between this object and its
20524>>>>>>>>>>>    //   database agent(s) (Server and Watched_Servers).
20524>>>>>>>>>>>    Procedure Remove_DEO_From_Server
20526>>>>>>>>>>>        Integer hoServer hoWatchedServers
20526>>>>>>>>>>>        
20526>>>>>>>>>>>        Get Server to hoServer
20527>>>>>>>>>>>        
20527>>>>>>>>>>>        If (hoServer <> 0) Begin
20529>>>>>>>>>>>            Send Remove_User_Interface to hoServer Self
20530>>>>>>>>>>>        End
20530>>>>>>>>>>>>
20530>>>>>>>>>>>        
20530>>>>>>>>>>>        // Only send if watched-server exists
20530>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
20531>>>>>>>>>>>        
20531>>>>>>>>>>>        If hoWatchedServers Begin
20533>>>>>>>>>>>            Send Remove_User_Interface to hoWatchedServers Self True // TRUE for watchers
20534>>>>>>>>>>>        End
20534>>>>>>>>>>>>
20534>>>>>>>>>>>        
20534>>>>>>>>>>>        // when removed the deo is no longer up to date.
20534>>>>>>>>>>>        Set Refresh_Dirty_State to True
20535>>>>>>>>>>>    End_Procedure
20536>>>>>>>>>>>    
20536>>>>>>>>>>>    
20536>>>>>>>>>>>    //   This procedure removes the specified object id (hoServer) from this object's
20536>>>>>>>>>>>    //   set of database agents who are merely 'watched', and destroys the
20536>>>>>>>>>>>    //   connection between the database agent and this object.
20536>>>>>>>>>>>    Procedure Remove_Watched_Server Integer hoServer
20538>>>>>>>>>>>        Integer iIndex
20538>>>>>>>>>>>        Handle hoWatchedServers
20538>>>>>>>>>>>        
20538>>>>>>>>>>>        Get Watched_Servers to hoWatchedServers
20539>>>>>>>>>>>        // Only if w server exists
20539>>>>>>>>>>>        If hoWatchedServers Begin
20541>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to False
20542>>>>>>>>>>>            Get find_element of hoWatchedServers hoServer to iIndex
20543>>>>>>>>>>>            If (iIndex >= 0) Begin
20545>>>>>>>>>>>                Send remove_element to hoWatchedServers hoServer
20546>>>>>>>>>>>            End
20546>>>>>>>>>>>>
20546>>>>>>>>>>>            Set broadcast_state of hoWatchedServers to True
20547>>>>>>>>>>>            If (iIndex >= 0 and Active_State(Self)) Begin
20549>>>>>>>>>>>                Send Remove_User_Interface to hoServer Self True // TRUE for watchers
20550>>>>>>>>>>>            End
20550>>>>>>>>>>>>
20550>>>>>>>>>>>        End
20550>>>>>>>>>>>>
20550>>>>>>>>>>>    End_Procedure
20551>>>>>>>>>>>    
20551>>>>>>>>>>>    
20551>>>>>>>>>>>    // This function returns the object id of the database agent of this object, or 0.
20551>>>>>>>>>>>    // If this object's Server is 0, this object's parent's Server is returned, if any.
20551>>>>>>>>>>>    // This function is used to allow nested data-entry objects to use the
20551>>>>>>>>>>>    // database agent defined by their parent object.
20551>>>>>>>>>>>    Function Server Returns Integer
20553>>>>>>>>>>>        Integer hoServer
20553>>>>>>>>>>>        Get private_Server to hoServer
20554>>>>>>>>>>>        If (hoServer = 0) Begin
20556>>>>>>>>>>>            Function_Return (Locate_Server(parent(Self)))
20557>>>>>>>>>>>        End
20557>>>>>>>>>>>>
20557>>>>>>>>>>>        Function_Return hoServer
20558>>>>>>>>>>>    End_Function
20559>>>>>>>>>>>    
20559>>>>>>>>>>>    
20559>>>>>>>>>>>    // This procedure sets the value of the Server property of this object,
20559>>>>>>>>>>>    // notifying child-objects of the change, and destroying and creating
20559>>>>>>>>>>>    // connections with database agents, as required.
20559>>>>>>>>>>>    // If the Server of this object is changed while this object is inactive,
20559>>>>>>>>>>>    // no notification of child-objects is required or performed.
20559>>>>>>>>>>>    Procedure Set Server Integer newVal
20561>>>>>>>>>>>        Integer oldVal
20561>>>>>>>>>>>        
20561>>>>>>>>>>>        Set Explicit_Server_State to (newVal <> 0)
20562>>>>>>>>>>>        Get Server to oldVal
20563>>>>>>>>>>>        
20563>>>>>>>>>>>        If (newVal <> 0) Begin
20565>>>>>>>>>>>            Set private_Server to (object_id(newVal))
20566>>>>>>>>>>>        End
20566>>>>>>>>>>>>
20566>>>>>>>>>>>        Else Begin
20567>>>>>>>>>>>            Set private_Server to newVal
20568>>>>>>>>>>>        End
20568>>>>>>>>>>>>
20568>>>>>>>>>>>        
20568>>>>>>>>>>>        If (Active_State(Self)) Begin
20570>>>>>>>>>>>            Broadcast Send server_changed oldVal newVal
20572>>>>>>>>>>>            If (oldVal <> 0) Begin
20574>>>>>>>>>>>                Send Remove_DEO_From_Server  // detach from current server
20575>>>>>>>>>>>            End
20575>>>>>>>>>>>>
20575>>>>>>>>>>>            If (newval <> 0) Begin
20577>>>>>>>>>>>                Send Attach_Deo_To_Server    // attach to new server
20578>>>>>>>>>>>            End
20578>>>>>>>>>>>>
20578>>>>>>>>>>>        End
20578>>>>>>>>>>>>
20578>>>>>>>>>>>    End_Procedure
20579>>>>>>>>>>>    
20579>>>>>>>>>>>    
20579>>>>>>>>>>>    //   This procedure servers as notification of a change in the connection
20579>>>>>>>>>>>    //   of this object's parent to its database agent.  If this object uses
20579>>>>>>>>>>>    //   its parent's database agent by default (see the Server and Find_Server
20579>>>>>>>>>>>    //   functions, above), it must disconnect from the old agent and connect
20579>>>>>>>>>>>    //   with the new agent.
20579>>>>>>>>>>>    Procedure Server_Changed Integer oldVal Integer newVal
20581>>>>>>>>>>>        Integer oldSrvr
20581>>>>>>>>>>>        
20581>>>>>>>>>>>        Get private_Server to oldSrvr
20582>>>>>>>>>>>        If (oldSrvr = 0) Begin  //assumes Server(self) = oldVal by deleg
20584>>>>>>>>>>>            If (oldVal <> 0) ;                Send remove_user_interface to oldVal Self
20587>>>>>>>>>>>            If (newVal <> 0) ;                Send add_user_interface to newVal Self
20590>>>>>>>>>>>        End
20590>>>>>>>>>>>>
