29972>>>>>>>// Container class for client side list.
29972>>>>>>>Class cWebList is a cWebBaseControl
29973>>>>>>>    Import_Class_Protocol cFilterExpression_mixin
29974>>>>>>>    Import_Class_Protocol cWebListFilter_mixin
29975>>>>>>>    
29975>>>>>>>    Procedure Construct_Object
29977>>>>>>>        Forward Send Construct_Object
29979>>>>>>>        Send Define_cFilterExpression_mixin
29980>>>>>>>        Send Define_cWebListFilter_mixin
29981>>>>>>>        
29981>>>>>>>        Property Integer piOrdering -1                // initial ordering index see also Function Ordering
29982>>>>>>>        Property Integer piPageSize 80                // Max number of rows to send to the client at a time. 0 = load all available rows
29983>>>>>>>        
29983>>>>>>>        // should columns adjust their pbEnabled based on the DDO binding or should it be static.
29983>>>>>>>        // Normally only grids should be dynamic. This property is queried by cWebColumn objects.
29983>>>>>>>        Property Boolean pbColumnsEnabledStatic True
29984>>>>>>>
29984>>>>>>>        Property Integer peRequestFindMode rfmFindAll
29985>>>>>>>        
29985>>>>>>>        Property Boolean pbDataAware True             // Set True if Grid Columns use data binding to DDO. False if there should be no DDO connection.
29988>>>>>>>
29988>>>>>>>        Property Integer peDbGridType gtAutomatic           // If set to true, data is static and load just once. Only used with pbDataAware=T.
29991>>>>>>>        
29991>>>>>>>        Property Integer peGrouping grpDisabled
29994>>>>>>>        
29994>>>>>>>        Property Boolean pbGroupsCollapsible True
29997>>>>>>>        
29997>>>>>>>        Property Boolean pbGroupsCollapseByDefault False
30000>>>>>>>        
30000>>>>>>>        Property Handle[] phoColumnObjects            // ordered list of cWebColumn objects (in left to right column order)
30001>>>>>>>        Property Boolean pbNotifyingExternalDD False  // Private: Used to indicate to the Refresh event that we are handling an event generated by some action on the list/grid control (i.e. delete row, change row, etc)
30002>>>>>>>        Property Boolean pbGridBehavior False         // Private: Used by cWebColumn objects to test if they live in a cWebList (read only) or a cWebGrid (save and other stuff is supported)
30003>>>>>>>        Property Boolean pbInClearGrid False          // Private: should be set when a DD Clear is supposed refresh an empty grid instead of adding a new row            
30004>>>>>>>        
30004>>>>>>>        Property Boolean pbSuppressCacheError True // if a record cannot be found in cache, do we report the error?        
30005>>>>>>>        // Published Properties
30005>>>>>>>        Property Boolean pbColumnSortable True      // If true, column sorting is allowed (which may be server side or client side)
30008>>>>>>>        Property Boolean pbAutoSearch True          // If true the search dialog will popup automatically when the user starts typing
30011>>>>>>>        Property Boolean pbShowSelected True        // If true the list will visually show which row is selected.
30014>>>>>>>        Property Boolean pbShowHeader True          // If true the list will show a header that allows the user to see the column captions and sorting.
30017>>>>>>>        Property Boolean pbShowFooter False          // If true the list will show a footer that allows the user to see the footer information.
30020>>>>>>>        Property Boolean pbScroll True              // If true the list will scroll vertically
30023>>>>>>>        
30023>>>>>>>        Property Boolean pbReverseOrdering False    // If true then the current grid ordering is reversed
30026>>>>>>>        Property Boolean pbUnOrdered False          // If True then the grid data has potentially become unordered due to changes in the data
30029>>>>>>>        Property Integer piSortColumn -1            // Indicates which column the grid is currently sorted on (-1 means the data is sorted via piOrdering)
30032>>>>>>>        Property String psCurrentRowId ""           // Row ID of the currently selected row.
30035>>>>>>>        Property Integer piCurrentRowIndex -1       // The row index of the currently selected row on the client. Does not reflect row changes on the server within the current request. Note that if peGridType is set to gtAutomatic this number is relative to the rows in cache on the client.
30038>>>>>>>        Property Integer piRowCount 0               // The number of rows currently on the client. Note that if peGridType is set to gtAutomatic this number does not represent the entire set.
30041>>>>>>>        
30041>>>>>>>        Property Boolean pbColumnsResizable True
30044>>>>>>>        
30044>>>>>>>        Property Boolean pbAutoColumnSizing True
30047>>>>>>>        
30047>>>>>>>        Property Boolean pbOfflineEditing False      // Optimization: Disable server call on row change
30050>>>>>>>        Property String psPlaceHolder ""            //  Placeholder text shown if the list has no records
30053>>>>>>>        
30053>>>>>>>        Property Integer piLimitRows 0              // Only show the first x rows (0 = show all), requires peDbGridType to be set to gtAllData or pbScroll to false!
30056>>>>>>>        
30056>>>>>>>        Property String psKeyBuddy ""
30059>>>>>>>        
30059>>>>>>>        Property Handle phoKeyBuddy C_WebUnresolvedObject   //  Can be set to another cWebBaseUIObject and the cWebList will respond to key actions on that control 
30060>>>>>>>        
30060>>>>>>>         
30060>>>>>>>        Property Boolean pbServerOnRowClick False   // Switches the OnRowClick event on and off
30063>>>>>>>        Property String psClientOnRowClick ""       // Can be set to a client-side JavaScript event handler for the OnRowClick event
30066>>>>>>>        
30066>>>>>>>        Property Boolean pbAllowDeleteRow False   // Allows deleting rows.
30067>>>>>>>        
30067>>>>>>>        Property Boolean pbAllowColumnReordering True // Allows the moving of columns by dragging.
30070>>>>>>>        Property Boolean pbAllowColumnHiding True // Allows the showing and hiding of columns by context menu.
30073>>>>>>>        
30073>>>>>>>        Property Boolean pbStoreColumnLayout True
30076>>>>>>>        Property String psClientOnColumnLayoutChanged ""
30079>>>>>>>        Property Boolean pbServerOnColumnLayoutChanged False
30082>>>>>>>        
30082>>>>>>>        Property Boolean pbStoreGroupConfig True
30085>>>>>>>        Property String psClientOnGroupConfigChanged ""
30088>>>>>>>        Property Boolean pbServerOnGroupConfigChanged False
30091>>>>>>>        
30091>>>>>>>        Property Boolean pbServerOnGroupHeaderToggle False
30094>>>>>>>        
30094>>>>>>>        Property Boolean pbUseCustomHeaderMenu False
30095>>>>>>>        Property Boolean pbUseHeaderMenuOnWholeList False // Implicit (True) if pbShowHeader is (False)
30096>>>>>>>        Property Handle phPrivateDefaultHeaderMenu 0
30097>>>>>>>                
30097>>>>>>>        Set psJSClass to "df.WebList"
30098>>>>>>>        Set Auto_Fill_State to True                 // Indicates that server DDO should find first record in it's dataset (important to set True for constrained child grids such as Order Details, for unconstrained lists it does not matter what the value is).
30099>>>>>>>        Set pbShowLabel to False                    // Lists won't have a label by default
30100>>>>>>>        Set piColumnSpan to 0                       // Lists will span the whole width by default (0 does this)
30101>>>>>>>        Set piHeight to 200
30102>>>>>>>    End_Procedure
