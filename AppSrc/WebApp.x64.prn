22646>>>>>>>    // Adds a ClientAction to be executed during the next response.
22646>>>>>>>    // tClientAction    - Is the action to be executed
22646>>>>>>>    Procedure AddClientAction tWebClientAction tClientAction
22648>>>>>>>        tWebClientAction[] aClientActions
22648>>>>>>>        tWebClientAction[] aClientActions
22649>>>>>>>        
22649>>>>>>>        Get paClientActions to aClientActions
22650>>>>>>>        Move tClientAction to aClientActions[SizeOfArray(aClientActions)]
22651>>>>>>>        Set paClientActions to aClientActions
22652>>>>>>>    End_Procedure    
22653>>>>>>>    
22653>>>>>>>    
22653>>>>>>>    // Cancels a client action that was scheduled.
22653>>>>>>>    // tClientAction    - Is the action to be executed
22653>>>>>>>    Procedure OwnerCancelClientAction Handle hoWO String sName
22655>>>>>>>        tWebClientAction[] aClientActions
22655>>>>>>>        tWebClientAction[] aClientActions
22656>>>>>>>        Integer iCur
22656>>>>>>>        String sTarget
22656>>>>>>>        Handle hoAttachments
22656>>>>>>>        
22656>>>>>>>        Get WebObjectName of hoWO to sTarget
22657>>>>>>>        Get paClientActions to aClientActions
22658>>>>>>>        
22658>>>>>>>        For iCur from 0 to (SizeOfArray(aClientActions) - 1)
22664>>>>>>>>
22664>>>>>>>            If (aClientActions[iCur].sTarget = sTarget and aClientActions[iCur].sName = sName) Begin
22666>>>>>>>                //  Clear attachment
22666>>>>>>>                If (aClientActions[iCur].iAttached <> 0) Begin
22668>>>>>>>                    Get phoResponseAttachments to hoAttachments
22669>>>>>>>                    Send SetMemberValue of hoAttachments (aClientActions[iCur].iAttached - 1) jsonTypeNull 0        
22670>>>>>>>                End
22670>>>>>>>>
22670>>>>>>>                
22670>>>>>>>                Move (RemoveFromArray(aClientActions, iCur)) to aClientActions
22671>>>>>>>                
22671>>>>>>>                Decrement iCur
22672>>>>>>>            End
22672>>>>>>>>
22672>>>>>>>        Loop
22673>>>>>>>>
22673>>>>>>>        
22673>>>>>>>        Set paClientActions to aClientActions
22674>>>>>>>    End_Procedure
