20746>>>>>>>>>>>        If (hoServer <> 0 and can_delete(hoServer) <> 0) Begin
20748>>>>>>>>>>>            WebSet pbDeleteCallbackActive to True
20749>>>>>>>>>>>            Send VerifyRequest (RefProc(RequestDeleteCallBack)) (RefFunc(Verify_Delete_Msg))
20750>>>>>>>>>>>        End
