9843>>>    Procedure DoLoadEnvironment Handle hoContainer Boolean bProgram
9845>>>// not used with webapp
9845>>>        Handle hoRegistry hoCommandBars
9845>>>        Handle hMonitor
9845>>>        Integer iError cxy
9845>>>        tWinWindowPlacement WindowPlacement
9845>>>        tWinWindowPlacement WindowPlacement
9845>>>        String sKey
9845>>>        Boolean bSuccess
9845>>>        String sObjectName
9845>>>        
9845>>>        If (pbPreserveEnvironment(Self)) Begin
9847>>>            Get Create U_cRegistry to hoRegistry
9848>>>            Set pfAccessRights of hoRegistry to KEY_READ
9849>>>            
9849>>>            Get RegistryKeyString to sKey
9850>>>            
9850>>>            If (bProgram = False) Begin
9852>>>                Move (sKey +"\WINDOWS") to sKey
9853>>>                Get Object_Label of hoContainer to sObjectName  // just get the local name
9854>>>                Move (sKey +"\" +sObjectName) to sKey
9855>>>            End
9855>>>>
9855>>>            Else ;                Move (sKey + "\Preferences") to sKey
9857>>>            
9857>>>            Get OpenKey of hoRegistry sKey to bSuccess
9858>>>            
9858>>>            If bSuccess Begin
9860>>>                If (ValueExists(hoRegistry, 'Placement')) Begin
9862>>>                    Get ReadBinary of hoRegistry "Placement" (AddressOf(WindowPlacement)) (SizeOfType(tWinWindowPlacement)) to bSuccess
9863>>>                    If bSuccess Begin
9865>>>                        // Do not restore size if the window is not resizable
9865>>>                        If (Border_Style(hoContainer) <> BORDER_THICK) Begin
9867>>>                            // restore always works with outer size
9867>>>                            Get GuiWindowSize     of hoContainer to cxy
9868>>>                            Move (WindowPlacement.NormalPosition.left + Low(cxy)) to WindowPlacement.NormalPosition.right
9869>>>                            Move (WindowPlacement.NormalPosition.top + Hi(cxy)) to WindowPlacement.NormalPosition.bottom
9870>>>                        End
9870>>>>
9870>>>                        
9870>>>                        // Test that the main window's placement location will appear on some connected monitor. If none
9870>>>                        // of the main window is visible then set the location to 0,0 and adjust the size....
9870>>>                        If (bProgram) Begin
9872>>>                            // Test the top left point
9872>>>                            Move (MonitorFromPoint(WindowPlacement.NormalPosition.left, WindowPlacement.NormalPosition.top, MONITOR_DEFAULTONNULL)) to hMonitor
9873>>>                            
9873>>>                            If (hMonitor = 0) Begin
9875>>>                                // test the bottom right point
9875>>>                                Move (MonitorFromPoint(WindowPlacement.NormalPosition.right, WindowPlacement.NormalPosition.bottom, MONITOR_DEFAULTONNULL)) to hMonitor
9876>>>                            End
9876>>>>
9876>>>                            
9876>>>                            // hMonitor = 0 means that the window location is not in any current monitor (probably the monitor layout has changed)
9876>>>                            // or that the window begins and ends outside all monitors (even though it may span across some monitor). We will adjust!
9876>>>                            If (hMonitor = 0) Begin
9878>>>                                Send ResetWindowPos (&WindowPlacement.NormalPosition)
9879>>>                            End
9879>>>>
9879>>>                        End
9879>>>>
9879>>>                        
9879>>>                        // Set the placement
9879>>>                        Move (SetWindowPlacement(Window_Handle(hoContainer), AddressOf(WindowPlacement))) to bSuccess
9880>>>                    End
9880>>>>
9880>>>                End
9880>>>>
9880>>>                If bProgram Begin
9882>>>                    Get phoCommandBars of hoContainer to hoCommandBars
9883>>>                    If not hoCommandBars Begin
9885>>>                        If (ValueExists(hoRegistry, 'IsStatusBarVisible')) ;                            Set Statusbar_State of hoContainer to (ReadDword(hoRegistry, 'IsStatusBarVisible'))
9888>>>                        If (ValueExists(hoRegistry, 'IsToolBarVisible'))   ;                            Set Toolbar_State   of hoContainer to (ReadDword(hoRegistry, 'IsToolBarVisible'))
9891>>>                    End
9891>>>>
9891>>>                End
9891>>>>
9891>>>                
9891>>>                Send CloseKey of hoRegistry
9892>>>            End
9892>>>>
9892>>>            
9892>>>            Send Destroy of hoRegistry
9893>>>        End
9893>>>>
9893>>>    End_Procedure
9894>>>    
9894>>>    Procedure DoSaveEnvironment Handle hoContainer Boolean bProgram
9896>>>// not used with webapp
9896>>>        Handle hoRegistry
9896>>>        Integer iError
9896>>>        tWinWindowPlacement WindowPlacement
9896>>>        tWinWindowPlacement WindowPlacement
9896>>>        String sKey
9896>>>        Boolean bSuccess
9896>>>        Integer eShowCmd
9896>>>        String sObjectName
9896>>>        
9896>>>        If (pbPreserveEnvironment(Self)) Begin
9898>>>            Get Create U_cRegistry to hoRegistry
9899>>>            Get RegistryKeyString to sKey
9900>>>            
9900>>>            If (bProgram = False) Begin
9902>>>                Move (sKey +"\WINDOWS") to sKey
9903>>>                Get Object_Label of hoContainer to sObjectName  // just get the local name
9904>>>                Move (sKey +"\" +sObjectName) to sKey
9905>>>            End
9905>>>>
9905>>>            Else ;                Move (sKey +"\Preferences") to sKey
9907>>>            
9907>>>            Get CreateKey of hoRegistry sKey to iError
9908>>>            If (iError = 0) Begin
9910>>>                Move (SizeOfType(tWinWindowPlacement)) to WindowPlacement.length
9911>>>                Move (GetWindowPlacement(Window_Handle(hoContainer), AddressOf(WindowPlacement))) to bSuccess
9912>>>                If bSuccess Begin
9914>>>                    // if minimized, assume restored, as we don't want to restart minimized!
9914>>>                    If (WindowPlacement.showCmd = SW_SHOWMINIMIZED) Begin
9916>>>                        Move SW_SHOWNORMAL to WindowPlacement.showCmd
9917>>>                    End
9917>>>>
9917>>>                    Send WriteBinary of hoRegistry "Placement" (AddressOf(WindowPlacement)) WindowPlacement.length
9918>>>                End
9918>>>>
9918>>>                
9918>>>                If bProgram Begin
9920>>>                    Send WriteInteger of hoRegistry 'IsStatusBarVisible' (Statusbar_State(hoContainer))
9921>>>                    Send WriteInteger of hoRegistry 'IsToolBarVisible'   (Toolbar_State(hoContainer))
9922>>>                End
9922>>>>
9922>>>                
9922>>>                
9922>>>                Send CloseKey of hoRegistry
9923>>>            End
9923>>>>
9923>>>            
9923>>>            Send Destroy of hoRegistry
9924>>>        End
9924>>>>
9924>>>    End_Procedure
