6044>>>>>    Import_Class_Protocol Bitmap_Support_Mixin
6045>>>>>    Import_Class_Protocol ToolTip_Support_Mixin
6046>>>>>    
6046>>>>>    //  KeyAction is the message that should be sent to a button via
6046>>>>>    //  an on_key in support of an underlined hot-key indicator. For
6046>>>>>    //  example, setting a button label to "&Close" will create an
6046>>>>>    //  underlined "C", indicating to a user that Alt+C should also
6046>>>>>    //  be usable for "close". To support that, simply setup an on_key
6046>>>>>    //  message: On_Key Key_Alt+Key_C Send KeyAction to (closebutton(self))
6046>>>>>    //  this was modified to not send OnClick but to send Message to Aux_value.
6046>>>>>    //  Normally, this will be the same as onCLick (onClick will be the message and
6046>>>>>    //  there will be no aux_value).
6046>>>>>    //
6046>>>>>    Procedure KeyAction
6048>>>>>        Integer bActive bShadow iRetVal
6048>>>>>        Integer hmMsg hObj
6048>>>>>        Get Active_state to bActive
6049>>>>>        Get Object_shadow_state to bShadow
6050>>>>>        Get Message 0 to hmMsg
6051>>>>>        Move 0 to iRetVal                // non-inititalized int can stop the UI!
6052>>>>>        If (bActive and (not(bShadow)) and hmMsg) Begin
6054>>>>>            Get aux_value 0 to hObj
6055>>>>>            If (hObj = 0) ;                Move Self to hObj
6058>>>>>            Get hmMsg of hObj to iRetVal
6059>>>>>        End
6059>>>>>>
6059>>>>>        Procedure_Return iRetVal         // should we. (e.g., to stop the ui)
6060>>>>>    End_Procedure
6061>>>>>    
6061>>>>>    Function CurrentButtonState Returns Integer
6063>>>>>        Function_Return (private.CurrentButtonState(Self))
6064>>>>>    End_Function
6065>>>>>    
6065>>>>>    //  Set CurrentButtonState to FALSE/TRUE will cause the button to display
6065>>>>>    //  the "thick" border seen on "default" buttons. By Default, buttons will
6065>>>>>    //  now set this property to true when ever they take the focus, and false
6065>>>>>    //  when they lose the focus. Logic exists in "panel" objects to set a default
6065>>>>>    //  button which will be highlighted when needed. Note that all highlighting
6065>>>>>    //  is handled by calling this one message.
6065>>>>>    //  Get/Set CurrentButtonState is private, system maintained and dynamic.
6065>>>>>    //  Do not set this as part of an object's attributes.
6065>>>>>    //
6065>>>>>    Procedure Set CurrentButtonState Integer bState
6067>>>>>        Handle hWnd hObj
6067>>>>>        Integer iStyle cxy iTemp
6067>>>>>        // cannot make a shadowed button the default
6067>>>>>        If (object_shadow_state(Self) and bState) ;            Procedure_Return
6070>>>>>        Get Form_Window_Handle 0 to hWnd
6071>>>>>        If (hWnd and (CurrentButtonState(Self)<>bState)) Begin
6073>>>>>            Set private.CurrentButtonState to bState
6074>>>>>            Move (If(bState,Self,0)) to hObj
6075>>>>>            // very private message! Do not send from anywhere else!!!!!
6075>>>>>            Delegate Set private.Current_Action_Button to hObj // delegate to panel
6077>>>>>            Get GuiSize to cxy
6078>>>>>            Move (GetWindowLongPtr(hWnd, GWL_STYLE)) to iStyle
6079>>>>>            If bState Begin
6081>>>>>                Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle ior 1)) to iTemp
6082>>>>>                Set GuiSize to (Hi(cxy)) (Low(cxy)+1)
6083>>>>>            End
6083>>>>>>
6083>>>>>            Else Begin
6084>>>>>                Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle iand $FFFFFFFE)) to iTemp
6085>>>>>                Set GuiSize to (Hi(cxy)) (Low(cxy)-1)
6086>>>>>            End
6086>>>>>>
6086>>>>>        End
6086>>>>>>
6086>>>>>    End_Procedure
6087>>>>>    
6087>>>>>    
6087>>>>>    //  Default_State is the public interface for setting the Default
6087>>>>>    //  Action Button at the button itself. The message CurrentButtonState
6087>>>>>    //  is implementation of part of the mechanism and should not be used
6087>>>>>    //  directly.
6087>>>>>    //
6087>>>>>    Procedure Set Default_State Integer bState
6089>>>>>        Set Default_Action_Button to (If(bState,Self,0))
6090>>>>>    End_Procedure
6091>>>>>    
6091>>>>>    Function Default_State Returns Integer
6093>>>>>        Function_Return (Default_action_Button(Self)=Self)
6094>>>>>    End_Function
6095>>>>>    
6095>>>>>    Procedure Remove_Object
6097>>>>>        // we must make sure that the button is normal before removing it. Otherwise
6097>>>>>        // it will be the wrong size when repaged.
6097>>>>>        Set CurrentButtonState to False
6098>>>>>        Forward Send remove_object
6100>>>>>    End_Procedure
