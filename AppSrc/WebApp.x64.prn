35259>>>>>>>    
35259>>>>>>>    //
35259>>>>>>>    //  Converts the given time to an string that can be saved in the database.
35259>>>>>>>    //
35259>>>>>>>    //  Params:
35259>>>>>>>    //      dtTime  Time to convert
35259>>>>>>>    //  Returns:
35259>>>>>>>    //      String with "HH:MM:SS" format
35259>>>>>>>    //
35259>>>>>>>    Function TimeToString DateTime dtTime Returns String
35261>>>>>>>        String sHours sMinutes sSeconds sMillis
35261>>>>>>>        
35261>>>>>>>        //  Extract parts
35261>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
35262>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
35263>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
35264>>>>>>>        Move (String(DateGetMillisecond(dtTime))) to sMillis
35265>>>>>>>        
35265>>>>>>>        //  Fill out with 0
35265>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
35268>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
35271>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
35274>>>>>>>        Move (Right("00" + sMillis, 3)) to sMillis
35275>>>>>>>        
35275>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds + "." + sMillis)
35276>>>>>>>    End_Function
35277>>>>>>>
35277>>>>>>>
35277>>>>>>>    //
35277>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
35277>>>>>>>    //
35277>>>>>>>    //  Params:
35277>>>>>>>    //      dtTime  Datetime variable to add time to
35277>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
35277>>>>>>>    //  Returns:
35277>>>>>>>    //      dtDateTime with the loaded time
35277>>>>>>>    //
35277>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
35279>>>>>>>        String sHours sMinutes sSeconds sMillis
35279>>>>>>>        
35279>>>>>>>        //  Extract parts
35279>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
35280>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
35281>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
35282>>>>>>>        Move (Right(sTimeString, 3)) to sMillis
35283>>>>>>>        
35283>>>>>>>        //  Set to DateTime
35283>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours))))   to dtTime
35284>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
35285>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
35286>>>>>>>        Move (DateSetMillisecond(dtTime, (Integer(sMillis)))) to dtTime
35287>>>>>>>        
35287>>>>>>>        Function_Return dtTime
35288>>>>>>>    End_Function
35289>>>>>>>    
