31986>>>>>        Send NavigateForwardFinish
31987>>>>>    End_Procedure
31988>>>>>
31988>>>>>    // called by NavigateForward and NavigateForwardCustom only 
31988>>>>>    Procedure NavigateForward2 Handle hoInvokingObject tWebNavigateData NavigateData Integer eNavMode
31990>>>>>        Integer eWebViewStyle eInvokingViewStyle eInitMode iMainFile iStackSize
31990>>>>>        Handle hoInvokingObjectTemp hoInvokingView hoMainDD hoInvokingViewDD 
31990>>>>>        Boolean bOK bChanged bErr bHasRecord bCancel bHandled
31990>>>>>        String sInvokingView sReason sViewName
31990>>>>>        tWebViewInfo[] aViewStack
31990>>>>>        tWebViewInfo[] aViewStack
31991>>>>>        RowID riMainRowId
31991>>>>>        
31991>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
31992>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
31993>>>>>        Get Main_DD to hoMainDD
31994>>>>>                
31994>>>>>        // Test Access rights...
31994>>>>>        Get AllowAccess to bOK
31995>>>>>        If (not(bOK)) Begin
31997>>>>>            Get ViewAccessDenied Self False to bHandled
31998>>>>>            Procedure_Return
31999>>>>>        End
31999>>>>>>
31999>>>>>        
31999>>>>>        // Test for valid view style
31999>>>>>        Get peWebViewStyle to eWebViewStyle
32000>>>>>        If (eWebViewStyle = wvsDesktop) Begin
32002>>>>>            Error DFERR_PROGRAM "Can't navigate forward to a non-drill down view"
32003>>>>>>
32003>>>>>            Procedure_Return
32004>>>>>        End
32004>>>>>>
32004>>>>>
32004>>>>>        // Test that we can actually navigate to this view
32004>>>>>        Get CanPushView of (ViewStack(Self)) Self (&sReason) to bOK
32005>>>>>        
32005>>>>>        If (not(bOK)) Begin
32007>>>>>            Get WebObjectName to sViewName
32008>>>>>            Error DFERR_PROGRAM ("View stack navigate error: Cannot Navigate to (" + sViewName + "). " + sReason)
32009>>>>>>
32009>>>>>            Procedure_Return             
32010>>>>>        End
32010>>>>>>
32010>>>>>
32010>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
32011>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
32012>>>>>        
32012>>>>>        // Populate the Navigate Data struct.
32012>>>>>        If (eNavMode = ntNavigateForwardCustom) Begin
32014>>>>>            Move nfUndefined to NavigateData.eNavigateType
32015>>>>>        End
32015>>>>>>
32015>>>>>        Else Begin      
32016>>>>>            //  Determine navigation type and table
32016>>>>>            Get DetermineNavigateFromType hoInvokingView hoInvokingObject (&NavigateData.iTable) to NavigateData.eNavigateType
32017>>>>>        End 
32017>>>>>>
32017>>>>>        
32017>>>>>        //  Determine rowid and fire OnGetNavigateForwardData
32017>>>>>        If (hoInvokingObject <> C_WebUnresolvedObject) Begin
32019>>>>>            Send GetNavigateForwardData of hoInvokingObject Self (&NavigateData)
32020>>>>>        End
32020>>>>>>
32020>>>>>        
32020>>>>>        //  Override rowid when initializing from a state hash
32020>>>>>        If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
32022>>>>>            Send NavigateInitializeUpdateRowId (&NavigateData)
32023>>>>>            If (pbNavReinitError(Self)) ;                Procedure_Return
32026>>>>>        End
32026>>>>>>
32026>>>>>        
32026>>>>>        //  Give a last change to intervene before actual changes will be made
32026>>>>>        Send SetNavigateData NavigateData   // Set the navigationdata so that Refresh reads the right init_mode
32027>>>>>        Move False to bCancel
32028>>>>>        Send OnNavigating (&NavigateData) hoInvokingView hoInvokingObject (&bCancel)
32029>>>>>        If (bCancel) Begin
32031>>>>>            Set pbNavReinitError to True
32032>>>>>            Procedure_Return
32033>>>>>        End
32033>>>>>>
32033>>>>>        
32033>>>>>        // update the top of the stack with what is now the current record which
32033>>>>>        // should have been returned in NavigateData
32033>>>>>        If (iStackSize and aViewStack[iStackSize-1].iMainTable = NavigateData.iTable) Begin 
32035>>>>>            Move (DeserializeRowID(NavigateData.sRowID)) to aViewStack[iStackSize-1].riMainTable
32036>>>>>            WebSet paViewStack of (ViewStack(Self)) to aViewStack
32037>>>>>        End
32037>>>>>>
32037>>>>>                
32037>>>>>        // Store the NavigateData
32037>>>>>        Send SetNavigateData NavigateData
32038>>>>>        Send SetInvokingObject hoInvokingObject
32039>>>>>        
32039>>>>>        // if we must first save, we require a successful save
32039>>>>>        // or an existing record with no changes
32039>>>>>        If (NavigateData.bSaveBeforeNavigate and eInitMode = initStateDefault) Begin
32041>>>>>            Get Server of hoInvokingView to hoInvokingViewDD
32042>>>>>            If (hoInvokingViewDD) Begin
32044>>>>>                Get HasRecord of hoInvokingViewDD to bHasRecord
32045>>>>>            End
32045>>>>>>
32045>>>>>            Get SaveViewBeforeNavigate of hoInvokingView to bErr
32046>>>>>            If bErr Begin
32048>>>>>                Set pbNavReinitError to True    //  This should never happen!
32049>>>>>                Procedure_Return
32050>>>>>            End
32050>>>>>>
32050>>>>>            // if a new successful save we must udpate navigateData and the
32050>>>>>            // top of the view stack with the new record
32050>>>>>            If (hoInvokingViewDD and not(bHasRecord)) Begin
32052>>>>>                Get Main_File of hoInvokingViewDD to iMainFile
32053>>>>>                If (NavigateData.iTable = iMainFile) Begin
32055>>>>>                    Get CurrentRowId of hoInvokingViewDD to riMainRowId
32056>>>>>                    Move (SerializeRowID(riMainRowId)) to NavigateData.sRowID
32057>>>>>                    Send SetNavigateData NavigateData
32058>>>>>                    
32058>>>>>                    If (iStackSize) Begin 
32060>>>>>                        Move riMainRowId to aViewStack[iStackSize-1].riMainTable
32061>>>>>                        WebSet paViewStack of (ViewStack(Self)) to aViewStack
32062>>>>>                    End
32062>>>>>>
32062>>>>>                End
32062>>>>>>
32062>>>>>            End
32062>>>>>>
32062>>>>>        End
32062>>>>>>
32062>>>>>        
32062>>>>>        //Check if we need to hide a dialog
32062>>>>>        If (hoInvokingView <> 0) Begin
32064>>>>>           Get peWebViewStyle of hoInvokingView to eInvokingViewStyle
32065>>>>>            If (eInvokingViewStyle = wvsDialog and eWebViewStyle <> wvsDialog) Begin
32067>>>>>                //If this happens we navigated from a dialog to a view which means we should hide all dialogs.
32067>>>>>                Send HideAllDialogs
32068>>>>>            End
32068>>>>>>
32068>>>>>        End
32068>>>>>>
32068>>>>>        
32068>>>>>        //  Finish navigation
32068>>>>>        If (eInitMode = initStateReinitialize) Begin
32070>>>>>            Send DelayLoadview of (Host(Self)) Self 
32071>>>>>            Send NavigateForwardFinish 
32072>>>>>        End
32072>>>>>>
32072>>>>>        Else Begin
32073>>>>>            Send ShowView of (Host(Self)) Self (RefProc(NavigateForward_CallBack)) Self
32074>>>>>        End
32074>>>>>>
32074>>>>>    End_Procedure
32075>>>>>    
32075>>>>>    // This message is sent when navigating into a view (forward navigation) and is the last chance
32075>>>>>    // to influence the navigation data before the navigation is performed. It also is the place to 
32075>>>>>    // cancel the navigation.
32075>>>>>    Procedure OnNavigating tWebNavigateData ByRef NavigateData Handle hoInvokingView Handle hoInvokingObject Boolean ByRef bCancel
32077>>>>>    End_Procedure
32078>>>>>    
32078>>>>>    // The last step of the forward navigation where the view navigating to is in sync and finds 
32078>>>>>    // and constraints are performed based on the NavigateDataFinish. This procedure does look at
32078>>>>>    // the DDO structure of the invoking view but that shouldn't be a problem.
32078>>>>>    Procedure NavigateForwardFinish
32080>>>>>        Integer iStackSize iParentTable eInitMode
32080>>>>>        Handle hoMainDD hoParentDD hoInvokingView hoInvokingObject hoTopView
32080>>>>>        Boolean bOK bHasRecord bPrevNav
32080>>>>>        RowID ri
32080>>>>>        tWebNavigateData NavigateData
32080>>>>>        tWebNavigateData NavigateData
32080>>>>>        tWebViewInfo[] aViewStack
32080>>>>>        tWebViewInfo[] aViewStack
32081>>>>>        Handle[] hoStackDDOs
32082>>>>>        RowID[] riStackRowIds
32083>>>>>        Boolean bDynamicConstraints bOverrideViewState bFindParent bErr bSuccess
32083>>>>>        Integer eWebViewStyle eViewType
32083>>>>>        Integer iMainFile iConstrainFile eRefindError
32083>>>>>        String sMainRowId sTitle sCustomStateHash
32083>>>>>        RowID riMainRowId
32083>>>>>        Handle hoInvokingViewDD hoInvokingObjectDD hoRefindError
32083>>>>>        
32083>>>>>        //  Indicate that we are navigating
32083>>>>>        Set pbNavigating to True
32084>>>>>        
32084>>>>>        Get Main_DD to hoMainDD
32085>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoInvokingView
32086>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
32088>>>>>            Get GetInvokingObject to hoInvokingObject
32089>>>>>        End
32089>>>>>>
32089>>>>>        
32089>>>>>        Get GetNavigateData to NavigateData
32090>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack
32091>>>>>        Move (SizeOfArray(aViewStack)) to iStackSize
32092>>>>>        Get NamedValueGet NavigateData.NamedValues "Init_Mode" to eInitMode
32093>>>>>
32093>>>>>        
32093>>>>>        Get peViewType to eViewType
32094>>>>>        Get IsDynamicConstraints to bDynamicConstraints
32095>>>>>        
32095>>>>>        // Interpret the navigate data 
32095>>>>>        
32095>>>>>        If hoMainDD Begin
32097>>>>>            
32097>>>>>            Send Refind_Records of hoMainDD
32098>>>>>            
32098>>>>>            
32098>>>>>            //  We are performing finds on the invoking views here to 'correct' their current records based on our navigate-data
32098>>>>>            If (hoInvokingObject <> C_WebUnresolvedObject and eInitMode <> initStateDefault and NavigateData.iTable > 0) Begin
32100>>>>>                Handle hoInvokingServer hoInvokingDD
32100>>>>>                RowID riNavRowId
32100>>>>>                
32100>>>>>                Get Server of hoInvokingObject to hoInvokingServer 
32101>>>>>                If (hoInvokingServer > 0 and IsInCallActionScope(hoInvokingObject)) Begin
32103>>>>>                    Get Data_Set of hoInvokingServer NavigateData.iTable to hoInvokingDD
32104>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to riNavRowId
32105>>>>>                    
32105>>>>>                    If (hoinvokingdd > 0 and not(IsSameRowId(CurrentRowId(hoInvokingDD), riNavRowId))) Begin
32107>>>>>                        Get pbNavigating of hoInvokingView to bPrevNav
32108>>>>>                        Set pbNavigating of hoInvokingView to True
32109>>>>>                        If (IsNullRowID(riNavRowId)) Begin
32111>>>>>                            Send Clear of hoInvokingDD
32112>>>>>                        End
32112>>>>>>
32112>>>>>                        Else Begin
32113>>>>>                            Send FindByRowId of hoInvokingDD NavigateData.iTable riNavRowId
32114>>>>>                        End
32114>>>>>>
32114>>>>>                        Set pbNavigating of hoInvokingView to bPrevNav
32115>>>>>                    End
32115>>>>>>
32115>>>>>                End
32115>>>>>>
32115>>>>>            End
32115>>>>>>
32115>>>>>            
32115>>>>>            If (bDynamicConstraints) Begin
32117>>>>>                // this re-establishes all existing constraints
32117>>>>>                Send EstablishConstrainFiles hoMainDD aViewStack (&hoStackDDOs) (&riStackRowIds)    
32118>>>>>                
32118>>>>>                // Now Set hew highest level constrain_file if needed.
32118>>>>>                Move False to bFindParent
32119>>>>>                // if fromParent we need a constraint
32119>>>>>                If (NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
32121>>>>>                    Move aViewStack[iStackSize-1].iMainTable to iParentTable
32122>>>>>                    // must be an immediate parent of the main DDO or this is an error          
32122>>>>>                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
32123>>>>>                    If (hoParentDD = 0) Begin
32125>>>>>                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
32126>>>>>>
32126>>>>>                    End
32126>>>>>>
32126>>>>>                    
32126>>>>>                    Set Constrain_File of hoMainDD to iParentTable
32127>>>>>                    
32127>>>>>                    // find the constraining parent record and its parents
32127>>>>>                    Move True to bFindParent
32128>>>>>                    Move aViewStack[iStackSize-1].riMainTable to ri
32129>>>>>                End
32129>>>>>>
32129>>>>>                // if fromMain and the parent view is fromParent or a manual constraint
32129>>>>>                // we need a constraint added here
32129>>>>>                Else If (NavigateData.eNavigateType = nfFromMain) Begin
32132>>>>>
32132>>>>>                    If (hoInvokingObject) Begin
32134>>>>>                        Boolean bIsDynamic bIsDynamicBase
32134>>>>>                        Handle hoWidgetObj hoWidgetObjDD
32134>>>>>                        
32134>>>>>                        If (hoWidgetObj <> 0) Begin
32136>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
32137>>>>>                            Get Server of hoWidgetObj to hoWidgetObjDD
32138>>>>>                            
32138>>>>>                            If (hoInvokingObjectDD and hoWidgetObjDD<>hoInvokingObjectDD) Begin
32140>>>>>                            
32140>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
32141>>>>>                                If (hoWidgetObjDD > 0) Begin
32143>>>>>                                    Get Main_File of hoWidgetObjDD to iParentTable
32144>>>>>                                End
32144>>>>>>
32144>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
32144>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
32144>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
32146>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
32146>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
32147>>>>>                                    If (hoParentDD = 0) Begin
32149>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
32150>>>>>>
32150>>>>>                                    End
32150>>>>>>
32150>>>>>                                    
32150>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
32151>>>>>                                    
32151>>>>>                                    // find the constraining parent record and its parents
32151>>>>>                                    Move True to bFindParent
32152>>>>>                                    // this is the parent record to refind
32152>>>>>                                    Get CurrentRowId of hoWidgetObjDD to ri
32153>>>>>                                End
32153>>>>>>
32153>>>>>                                Else If (hoWidgetObjDD > 0) Begin
32156>>>>>                                    // this is a navigate from we don't allow.
32156>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
32157>>>>>>
32157>>>>>                                End
32157>>>>>>
32157>>>>>                            End
32157>>>>>>
32157>>>>>                            Else Begin
32158>>>>>                                Send Refind_Records of hoInvokingObjectDD
32159>>>>>                                Get CurrentRowId of hoInvokingObjectDD to ri
32160>>>>>                                Move (SerializeRowID(ri)) to NavigateData.sRowID
32161>>>>>                            End
32161>>>>>>
32161>>>>>                        End
32161>>>>>>
32161>>>>>                        Else Begin
32162>>>>>                            
32162>>>>>                            Get Server of hoInvokingObject to hoInvokingObjectDD
32163>>>>>                            Get Server of hoInvokingView to hoInvokingViewDD
32164>>>>>                            // special fromMain case where the DDO is not the view's main_dd but is
32164>>>>>                            // a child DD that has a constraint. If so we only support this one level
32164>>>>>                            // deep and the DD must be constrained to the invoking view's main DD.
32164>>>>>                            // for example, mavigating from ZoomOrder's detail grid tp a detail zoom
32164>>>>>                            If (hoInvokingObjectDD and hoInvokingViewDD<>hoInvokingObjectDD) Begin
32166>>>>>                            
32166>>>>>                                Get Constrain_File of hoInvokingObjectDD to iConstrainFile
32167>>>>>                                If (hoInvokingViewDD > 0) Begin
32169>>>>>                                    Get Main_File of hoInvokingViewDD to iParentTable
32170>>>>>                                End
32170>>>>>>
32170>>>>>                                // if there is an invokingDD constraint, it is a manual constraint. We only support
32170>>>>>                                // navigating from this if that cosntraint parent is the invoking view's main dd
32170>>>>>                                If (iConstrainFile and iParentTable=iConstrainFile) Begin
32172>>>>>                                    // must be an immediate parent of the main DDO or this is an error          
32172>>>>>                                    Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
32173>>>>>                                    If (hoParentDD = 0) Begin
32175>>>>>                                        Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
32176>>>>>>
32176>>>>>                                    End
32176>>>>>>
32176>>>>>                                    
32176>>>>>                                    Set Constrain_File of hoMainDD to iParentTable
32177>>>>>                                    
32177>>>>>                                    // find the constraining parent record and its parents
32177>>>>>                                    Move True to bFindParent
32178>>>>>                                    // this is the parent record to refind
32178>>>>>                                    Get CurrentRowId of hoInvokingViewDD to ri
32179>>>>>                                End
32179>>>>>>
32179>>>>>                                Else If (hoInvokingViewDD > 0) Begin
32182>>>>>                                    // this is a navigate from we don't allow.
32182>>>>>                                    Error DFERR_PROGRAM ("Cannot navigate from this invoking manually constrained DDO for table# "+String(iParentTable))
32183>>>>>>
32183>>>>>                                End
32183>>>>>>
32183>>>>>                            End
32183>>>>>>
32183>>>>>                            
32183>>>>>                        End
32183>>>>>>
32183>>>>>                    End
32183>>>>>>
32183>>>>>                    // this is a more typical fromMain where invoking view is constrained amd
32183>>>>>                    // we want to use that constraint. 
32183>>>>>                    If  (not(bFindParent) and aViewStack[iStackSize-1].eNavigateType=nfFromParent and iStackSize>1) Begin
32185>>>>>                        Move aViewStack[iStackSize-2].iMainTable to iParentTable
32186>>>>>                        // must be an immediate parent of the main DDO or this is an error          
32186>>>>>                        Get ParentDDOForTable hoMainDD iParentTable to hoParentDD             
32187>>>>>                        If (hoParentDD = 0) Begin
32189>>>>>                            Error DFERR_PROGRAM ("Parent DDO not found for table# "+String(iParentTable))
32190>>>>>>
32190>>>>>                        End
32190>>>>>>
32190>>>>>                        // note constrain_file should already be set
32190>>>>>                        Move True to bFindParent
32191>>>>>                        Move aViewStack[iStackSize-2].riMainTable to ri
32192>>>>>                    End
32192>>>>>>
32192>>>>>                End
32192>>>>>>
32192>>>>>                
32192>>>>>            End
32192>>>>>>
32192>>>>>    
32192>>>>>            // Used to set ordering for a List. Do it here so any grid fills will use the right index.
32192>>>>>            // Let's do this before any finds occur on the new view. This can be used to set up custom
32192>>>>>            // constraints
32192>>>>>            Send NavigateForwardPreFindInit NavigateData hoInvokingObject
32193>>>>>
32193>>>>>            // Now rebuild the constraints
32193>>>>>            Send RebuildAllConstraints of hoMainDD
32194>>>>>        
32194>>>>>            // Now refind the parent if needed.
32194>>>>>            // This will only happen with dynamic constraints but this makes our intention clear.
32194>>>>>            If (bDynamicConstraints and bFindParent) Begin
32196>>>>>                // no autofill stops a child findfirst. We don't need that here  
32196>>>>>                Get FindByRowIdExNoAutoFill of hoParentDD iParentTable ri to bSuccess
32197>>>>>                // we also consider navigating forward from a null consrained parent an error
32197>>>>>                If (not(bSuccess) or IsNullRowID(ri)) Begin
32199>>>>>                    // This is kind of complex because it means that the constraining parent cannot be
32199>>>>>                    // reloaded. In such a case you probably should not be in the view at all and
32199>>>>>                    // should navigate back
32199>>>>>                    Move hoParentDD to hoRefindError
32200>>>>>                    Move retCannotRereadConstrainingParent to eRefindError    
32201>>>>>                End
32201>>>>>>
32201>>>>>            End
32201>>>>>>
32201>>>>>
32201>>>>>            If (hoRefindError=0) Begin
32203>>>>>                
32203>>>>>                // now find main file as needed
32203>>>>>                If ( (NavigateData.eNavigateType = nfFromMain or ;                      NavigateData.eNavigateType = nfFromChild or ;                      NavigateData.eNavigateType = nfUndefined)  ;                     and NavigateData.iTable=Main_File(hoMainDD) and iStackSize>0) Begin
32205>>>>>                    
32205>>>>>                    Move (DeserializeRowID(NavigateData.sRowID)) to ri
32206>>>>>                    If (IsNullRowID(ri) or NavigateData.bNewRecord) Begin
32208>>>>>                        // Assume Create New Record
32208>>>>>                        Send Clear to hoMainDD
32209>>>>>                    End
32209>>>>>>
32209>>>>>                    Else Begin
32210>>>>>                        // Populate the list around the passed row ID
32210>>>>>                        Get FindByRowIdEx of hoMainDD (Main_File(hoMainDD)) ri to bSuccess
32211>>>>>                        If not bSuccess Begin
32213>>>>>                            Send Clear of hoMainDD
32214>>>>>                            Move hoMainDD to hoRefindError
32215>>>>>                            Move retCannotRereadMain to eRefindError    
32216>>>>>                        End
32216>>>>>>
32216>>>>>                    End
32216>>>>>>
32216>>>>>                End
32216>>>>>>
32216>>>>>                Else If (eViewType=vtZoom and  NavigateData.eNavigateType = nfFromParent and iStackSize>0) Begin
32219>>>>>                    // Assume Create New Record
32219>>>>>                    Send Clear to hoMainDD
32220>>>>>                End
32220>>>>>>
32220>>>>>    
32220>>>>>                // finally, if a select view and we don't have a record tell the grid to
32220>>>>>                // do an init
32220>>>>>                If (eInitMode <> initStateReinitialize and hoRefindError=0 and eViewType=vtSelect) Begin
32222>>>>>                    Get HasRecord of hoMainDD to bOK
32223>>>>>                    If not bOK Begin
32225>>>>>                        Broadcast Recursive Send InitGrid NavigateData hoInvokingObject
32227>>>>>                    End
32227>>>>>>
32227>>>>>                End
32227>>>>>>
32227>>>>>    
32227>>>>>            End
32227>>>>>>
32227>>>>>        End
32227>>>>>>
32227>>>>>        
32227>>>>>        // Update the View Stack
32227>>>>>        Send PushView to (ViewStack(Self)) Self NavigateData.eNavigateType
32228>>>>>        Send UpdateInvokingViewDrillDownStyle 
32229>>>>>        
32229>>>>>
32229>>>>>        
32229>>>>>        
32229>>>>>        //  Cleanup navigation data
32229>>>>>        Get NamedValueRemove NavigateData.NamedValues "Init_Mode" to NavigateData.NamedValues
32230>>>>>        Send SetNavigateData NavigateData
32231>>>>>        
32231>>>>>        // if a find error, reverse the navigation. We assume that navigating to a view with
32231>>>>>        // records that cannot be found should be reversed. 
32231>>>>>        If hoRefindError Begin
32233>>>>>            If (eInitMode = initStateReinitialize or eInitMode = initStateReinitializeTopView) Begin
32235>>>>>                Set pbNavReinitError to True
32236>>>>>                If (pbStateHashInvalidError(Host(Self))) Begin
32238>>>>>                    Error DFERR_WEBAPP_INVALID_URL_REC
32239>>>>>>
32239>>>>>                End
32239>>>>>>
32239>>>>>            End
32239>>>>>>
32239>>>>>            Else Begin
32240>>>>>                Send OnNavigateForwardRefindError hoRefindError eRefindError
32241>>>>>            End
32241>>>>>>
32241>>>>>        End
32241>>>>>>
32241>>>>>        Else Begin
32242>>>>>            Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject    // Hook to modify the view before opening it 
32243>>>>>        End
32243>>>>>>
32243>>>>>        
32243>>>>>        //  We are done navigating now
32243>>>>>        Set pbNavigating to False
32244>>>>>        
32244>>>>>        // Update URL (check if still the topview, OnNavigateForward might have done a navigation)
32244>>>>>        Get TopViewHandle of (ViewStack(Self)) to hoTopView
32245>>>>>        If (eInitMode <> initStateReinitialize and hoTopView = Self) Begin 
32247>>>>>            Send UpdateStateHash (eInitMode = initStateReinitializeTopView or pbStateReplace(Self))
32248>>>>>                        
32248>>>>>            Send UpdatePageTitle
32249>>>>>        End
32249>>>>>>
32249>>>>>    End_Procedure
32250>>>>>    
32250>>>>>    
32250>>>>>    
32250>>>>>    // set ordering for a List. Do it here so any grid fills will use the right index.
32250>>>>>    // Let's do this before any finds occur on the new view
32250>>>>>    Procedure NavigateForwardPreFindInit tWebNavigateData NavigateData Handle hoInvokingObject
32252>>>>>        Integer eViewType
32252>>>>>        Get peViewType to eViewType
32253>>>>>        If (eViewType=vtSelect) Begin
32255>>>>>            Broadcast Recursive Send InitOrdering NavigateData hoInvokingObject
32257>>>>>        End
32257>>>>>>
32257>>>>>        Send OnNavigateForwardPreFindInit NavigateData hoInvokingObject
32258>>>>>    End_Procedure
32259>>>>>    
32259>>>>>    // This is called during NavigateForward after the automatic constraints have been applied but
32259>>>>>    // before the constraints have been rebuilt and any records have been found for the view.
32259>>>>>    // This primarily exists to give you a chance to apply any additional constraints for the view. You can
32259>>>>>    // also use this to set any finding properties such as piSortCol, etc.
32259>>>>>    // You should not use this to find DD records or fill the DDOs yourself - it won't work!
32259>>>>>    Procedure OnNavigateForwardPreFindInit  tWebNavigateData NavigateData Handle hoInvokingObject
32261>>>>>    End_Procedure
32262>>>>>    
32262>>>>>    // use to navigate to the start of the stack. If there is a default view it
32262>>>>>    // will navigate to there.
32262>>>>>    // if bUnconditional, do this without checking for changed states
32262>>>>>    Procedure NavigateBegin Handle hoInvokingObject Boolean bUnconditional
32264>>>>>        Boolean bOk
32264>>>>>        Handle hoTop hoDefault
32264>>>>>        
32264>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
32265>>>>>        
32265>>>>>        // reset the breadcrumb stack respecting the default view
32265>>>>>        Get Reset of (ViewStack(Self)) (hoDefault <> Self) bUnconditional to bOK
32266>>>>>        If (bOK) Begin
32268>>>>>            Send NavigateForward hoInvokingObject // note that we do not pass on the invoking object to preven the navigation logic from making wrong assumptions
32269>>>>>        End
32269>>>>>>
32269>>>>>    End_Procedure
32270>>>>>
32270>>>>>    // Send this to change the default caption that is shown for this view
32270>>>>>    // in a breadcrumb.
32270>>>>>    Procedure SetBreadcrumbCaption String sCaption
32272>>>>>        Send SetCaption of (ViewStack(Self)) Self sCaption
32273>>>>>    End_Procedure
32274>>>>>
32274>>>>>    // this gets the breadcrumb caption 
32274>>>>>    Function GetBreadcrumbCaption Returns String
32276>>>>>        String sCaption
32276>>>>>        Get GetCaption of (ViewStack(Self)) Self to sCaption
32277>>>>>        Function_Return sCaption
32278>>>>>    End_Function
32279>>>>>
32279>>>>>    // Send this to change the default caption that is shown for this view
32279>>>>>    // in a "heading". Typically used by a breadcrumb object when it is simply
32279>>>>>    // displaying a view heading rather than the entire breadcrumb.
32279>>>>>    Procedure SetHeaderCaption String sCaption
32281>>>>>        Send SetHeaderCaption of (ViewStack(Self)) Self sCaption
32282>>>>>        
32282>>>>>        Send UpdatePageTitle
32283>>>>>    End_Procedure
32284>>>>>
32284>>>>>    // this gets the breadcrumb heading scaption 
32284>>>>>    Function GetHeaderCaption Returns String
32286>>>>>        String sCaption
32286>>>>>        Get GetHeaderCaption of (ViewStack(Self)) Self to sCaption
32287>>>>>        Function_Return sCaption
32288>>>>>    End_Function
32289>>>>>
32289>>>>>    // if a view is changed, how do we close this?
32289>>>>>    // This uses peChangedViewAction and a corresponding
32289>>>>>    // Verify_Data_Loss_Msg / Verify_SaveClearCancel_msg to
32289>>>>>    // determine the action. Therefore setting the Verify_xxx_msg overrides
32289>>>>>    // the peChangedViewExitAction and force a non-verified abandoning of changes  
32289>>>>>    Function GetChangedViewExitAction Returns Integer
32291>>>>>        Integer iMsg eCloseAction
32291>>>>>        
32291>>>>>        Get peChangedViewExitAction to eCloseAction
32292>>>>>        If (eCloseAction=cveConfirmAbandonChanges) Begin
32294>>>>>            Get Verify_Data_Loss_Msg to iMsg
32295>>>>>            If (iMsg=0) Begin
32297>>>>>                Move cveAbandonChanges to eCloseAction
32298>>>>>            End
32298>>>>>>
32298>>>>>        End
32298>>>>>>
32298>>>>>        Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
32301>>>>>            Get Verify_SaveClearCancel_msg to iMsg
32302>>>>>            If (iMsg=0) Begin
32304>>>>>                Move cveAbandonChanges to eCloseAction
32305>>>>>            End
32305>>>>>>
32305>>>>>        End
32305>>>>>>
32305>>>>>        Function_Return eCloseAction
32306>>>>>    End_Function
32307>>>>>    
32307>>>>>
32307>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
32307>>>>>    // do not call this directly.
32307>>>>>    // This is used for Yes/No verifies
32307>>>>>    Procedure NavigateClose_Callback Integer eConfirmMode
32309>>>>>        If (eConfirmMode = cmYes) Begin
32311>>>>>            Send NavigateCloseExec False // means close no save
32312>>>>>        End
32312>>>>>>
32312>>>>>    End_Procedure
32313>>>>>
32313>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
32313>>>>>    Procedure NavigateCloseYNC_Callback Integer eConfirmMode
32315>>>>>        If (eConfirmMode = cmYes) Begin
32317>>>>>            Send NavigateCloseExec True
32318>>>>>        End
32318>>>>>>
32318>>>>>        Else If (eConfirmMode = cmNo) Begin
32321>>>>>            Send NavigateCloseExec False // means close no save
32322>>>>>        End
32322>>>>>>
32322>>>>>    End_Procedure
32323>>>>>    
32323>>>>>
32323>>>>>    // If a view is the current top view, you can send this message to it
32323>>>>>    // to close the view. If there is a view underneath in the view stack
32323>>>>>    // then it will be passed back navigation data from the callback object.
32323>>>>>    // This control must understand the GetNavigateBackData callback message.
32323>>>>>    // 
32323>>>>>    // If there is no special data to pass back to the view underneath in 
32323>>>>>    // the view stack then you should call NavigateCancel.
32323>>>>>    Procedure NavigateClose Handle hoCallback
32325>>>>>        Handle hoView
32325>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
32326>>>>>        Send NavigateCloseTo hoView hoCallback
32327>>>>>    End_Procedure
32328>>>>>
32328>>>>>    // NavigateCloseTo is passed the view to return to. Normally NavigateClose is used and this is for more
32328>>>>>    // advanced usage when closing several views but wanting to return a value to the view
32328>>>>>    // 1. When multi-level closes are used the navigateFrom type is always changed to nfUndefined meaning you must
32328>>>>>    //    handle the update yourself.
32328>>>>>    // 2. We only check for data-loss changes in the top view. If there are changes in views in between this and the destination
32328>>>>>    //    view, they are lost.
32328>>>>>    // Use this with care.
32328>>>>>    Procedure NavigateCloseTo Handle hoView Handle hoCallback
32330>>>>>        Handle hoMainDD
32330>>>>>        Boolean bCanPopView bChanged 
32330>>>>>        Integer eCloseAction iIndex
32330>>>>>        String sReason sNavigateDataCallbackObj sInvokingView
32330>>>>>        Integer eWebViewStyle
32330>>>>>
32330>>>>>        Get peWebViewStyle to eWebViewStyle
32331>>>>>        If (eWebViewStyle = wvsDesktop) Begin
32333>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
32334>>>>>>
32334>>>>>            Procedure_Return
32335>>>>>        End            
32335>>>>>>
32335>>>>>
32335>>>>>
32335>>>>>        If hoView Begin
32337>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
32338>>>>>            If (iIndex=-1) Begin
32340>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
32341>>>>>>
32341>>>>>                Procedure_Return
32342>>>>>            End
32342>>>>>>
32342>>>>>            Get WebObjectName of hoView to sInvokingView
32343>>>>>        End
32343>>>>>>
32343>>>>>        WebSet psNavigateBackView to sInvokingView
32344>>>>>        
32344>>>>>        Get WebObjectName of hoCallback to sNavigateDataCallbackObj
32345>>>>>        WebSet psNavigateDataCallbackObj to sNavigateDataCallbackObj
32346>>>>>
32346>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
32347>>>>>        
32347>>>>>        If (bCanPopView) Begin
32349>>>>>            Get IsViewChanged to bChanged
32350>>>>>            
32350>>>>>            If bChanged Begin
32352>>>>>                Get GetChangedViewExitAction to eCloseAction
32353>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
32355>>>>>                    Send VerifyRequest (RefProc(NavigateClose_Callback)) (RefFunc(Verify_Data_Loss_msg))
32356>>>>>                End
32356>>>>>>
32356>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
32359>>>>>                    Send VerifyRequest (RefProc(NavigateCloseYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
32360>>>>>                End
32360>>>>>>
32360>>>>>                Else If (eCloseAction=cveSave) Begin
32363>>>>>                    Send NavigateCloseExec True
32364>>>>>                End
32364>>>>>>
32364>>>>>                Else Begin
32365>>>>>                    Send NavigateCloseExec False
32366>>>>>                End
32366>>>>>>
32366>>>>>            End
32366>>>>>>
32366>>>>>            Else Begin            
32367>>>>>                Send NavigateCloseExec False
32368>>>>>            End
32368>>>>>>
32368>>>>>        End
32368>>>>>>
32368>>>>>        Else Begin
32369>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
32370>>>>>>
32370>>>>>        End
32370>>>>>>
32370>>>>>    End_Procedure
32371>>>>>    
32371>>>>>    // This actually performs the Navigate Close operation. This will close the current
32371>>>>>    // view and pop the view stack without returning any data to the invoking view.
32371>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
32371>>>>>    // been performed before we get here.
32371>>>>>    //
32371>>>>>    // Called via NavigateCloseTo, do not call this directly.
32371>>>>>    Procedure NavigateCloseExec Boolean bSave
32373>>>>>        Handle hoView hoCallback
32373>>>>>        String sNavigateDataCallbackObj sView
32373>>>>>        Boolean bErr
32373>>>>>        
32373>>>>>        If bSave Begin
32375>>>>>           Get SaveViewExec to bErr            
32376>>>>>           If bErr ;            Procedure_Return 
32379>>>>>        End
32379>>>>>>
32379>>>>>        
32379>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
32380>>>>>        If (Trim(sView) <> "") Begin
32382>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
32383>>>>>            WebGet psNavigateDataCallbackObj to sNavigateDataCallbackObj
32384>>>>>            If (sNavigateDataCallbackObj<>"") Begin
32386>>>>>                Get WebObjectByName sNavigateDataCallbackObj to hoCallback
32387>>>>>            End
32387>>>>>>
32387>>>>>            Send NavigateBackToHere of hoView False (If(hoCallback, hoCallback, Self))
32388>>>>>        End
32388>>>>>>
32388>>>>>        Else Begin
32389>>>>>            Send Hide   // If the view stack is empty, just hide this view
32390>>>>>        End
32390>>>>>>
32390>>>>>    End_Procedure
32391>>>>>
32391>>>>>    // this attempts a save and returns True if it failed.
32391>>>>>    // There should be no confirmation messages at this point.
32391>>>>>    // Unlike RequestSaveExec, this has to attempt a save at the view level.
32391>>>>>    // Currently it just saves the view's Server, which may not always be enough if
32391>>>>>    // have sub-DD like detail lines.
32391>>>>>    Function SaveViewExec Returns Boolean
32393>>>>>        Handle hoServer
32393>>>>>        Integer iRetVal
32393>>>>>        Boolean bRequestValidateAll bErr
32393>>>>>        Get Server to hoServer
32394>>>>>        If hoServer Begin
32396>>>>>            Get pbRequesteValidateAll to bRequestValidateAll
32397>>>>>            If bRequestValidateAll Begin
32399>>>>>                Get Request_Validate_All of hoServer to iRetVal
32400>>>>>            End
32400>>>>>>
32400>>>>>            Else Begin
32401>>>>>                Get Request_Validate of hoServer to iRetVal
32402>>>>>            End
32402>>>>>>
32402>>>>>            If (iRetVal=0) Begin
32404>>>>>                Move False to Err
32405>>>>>                Send Request_Save to hoServer
32406>>>>>                Move Err to iRetVal
32407>>>>>            End
32407>>>>>>
32407>>>>>        End
32407>>>>>>
32407>>>>>        Function_Return iRetVal
32408>>>>>    End_Function
32409>>>>>
32409>>>>>    // Save before navigate forward to some other view. Return 0 if ok.
32409>>>>>    // Upon completion a saved record must exist, else return non zero
32409>>>>>    Function SaveViewBeforeNavigate Returns Boolean
32411>>>>>        Handle hoServer
32411>>>>>        Boolean bChanged bErr bHasRec
32411>>>>>        Get Server to hoServer
32412>>>>>        Get IsViewChanged to bChanged
32413>>>>>        
32413>>>>>        If (bChanged) Begin
32415>>>>>           Get SaveViewExec to bErr
32416>>>>>        End
32416>>>>>>
32416>>>>>        Else Begin
32417>>>>>            // if nothing to save but a new record, we will attempt validation and save anyway. Most
32417>>>>>            // likely this will raise a validation error providing the user feedback that they cannot
32417>>>>>            // navigate forward without a valid save
32417>>>>>            If (hoServer) Begin
32419>>>>>                Get HasRecord of hoServer to bHasRec
32420>>>>>                If not bHasRec Begin
32422>>>>>                    Get SaveViewExec to bErr
32423>>>>>                End
32423>>>>>>
32423>>>>>            End
32423>>>>>>
32423>>>>>        End
32423>>>>>>
32423>>>>>        Function_Return bErr
32424>>>>>    End_Function
32425>>>>>
32425>>>>>
32425>>>>>    // Callback message in response to VerifyRequest Callback. Called via NavigateClose, 
32425>>>>>    // do not call this directly.
32425>>>>>    // This is used for Yes/No verifies
32425>>>>>    Procedure NavigateCancel_Callback Integer eConfirmMode
32427>>>>>        If (eConfirmMode = cmYes) Begin
32429>>>>>            Send NavigateCancelExec False
32430>>>>>        End
32430>>>>>>
32430>>>>>    End_Procedure
32431>>>>>
32431>>>>>    // This is used for Yes/No/Cancel verifies (Save, Clear, Cancel)
32431>>>>>    Procedure NavigateCancelYNC_Callback Integer eConfirmMode
32433>>>>>        If (eConfirmMode = cmYes) Begin
32435>>>>>            Send NavigateCancelExec True
32436>>>>>        End
32436>>>>>>
32436>>>>>        Else If (eConfirmMode = cmNo) Begin
32439>>>>>            Send NavigateCancelExec False // means close no save
32440>>>>>        End
32440>>>>>>
32440>>>>>    End_Procedure
32441>>>>>    
32441>>>>>
32441>>>>>    // If a view is the current top view, you can send this message to it
32441>>>>>    // to close the view. Typically this message is sent to a view by a 
32441>>>>>    // Cancel on the view.
32441>>>>>    Procedure NavigateCancel 
32443>>>>>        Handle hoView
32443>>>>>        Get InvokingViewHandle of (ViewStack(Self)) to hoView
32444>>>>>        Send NavigateCancelTo hoView
32445>>>>>    End_Procedure
32446>>>>>    
32446>>>>>    // If a view is the current top view, you can send this message to it
32446>>>>>    // to close the view and navigate down to the passed view. Typically this message is sent to
32446>>>>>    // a view by a breacrumb navigate back action
32446>>>>>    Procedure NavigateCancelTo Handle hoView
32448>>>>>        Boolean bCanPopView bChanged  bOk
32448>>>>>        Integer eCloseAction
32448>>>>>        String sReason sInvokingView
32448>>>>>        Integer eWebViewStyle iIndex
32448>>>>>
32448>>>>>        Get peWebViewStyle to eWebViewStyle
32449>>>>>        If (eWebViewStyle = wvsDesktop) Begin
32451>>>>>            Error DFERR_PROGRAM "Can't navigate back with a non-drill down view"
32452>>>>>>
32452>>>>>            Procedure_Return
32453>>>>>        End            
32453>>>>>>
32453>>>>>        
32453>>>>>        If hoView Begin
32455>>>>>            Get GetViewIndex of (ViewStack(Self)) hoView to iIndex
32456>>>>>            If (iIndex=-1) Begin
32458>>>>>                Error DFERR_PROGRAM "Target view not in view stack"
32459>>>>>>
32459>>>>>                Procedure_Return
32460>>>>>            End
32460>>>>>>
32460>>>>>            Get WebObjectName of hoView to sInvokingView
32461>>>>>        End
32461>>>>>>
32461>>>>>        WebSet psNavigateBackView to sInvokingView
32462>>>>>        
32462>>>>>        Get CanPopView of (ViewStack(Self)) Self (&sReason) to bCanPopView
32463>>>>>        
32463>>>>>        If (bCanPopView) Begin
32465>>>>>            
32465>>>>>            // Set the callback object that will be used by NavigateCloseExec
32465>>>>>            Get IsViewChanged to bChanged
32466>>>>>            If bChanged Begin
32468>>>>>                Get GetChangedViewExitAction to eCloseAction
32469>>>>>                If (eCloseAction=cveConfirmAbandonChanges) Begin
32471>>>>>                    Send VerifyRequest (RefProc(NavigateCancel_Callback)) (RefFunc(Verify_Data_Loss_msg))
32472>>>>>                End
32472>>>>>>
32472>>>>>                Else If (eCloseAction=cveConfirmSaveClearCancel) Begin
32475>>>>>                    Send VerifyRequest (RefProc(NavigateCancelYNC_Callback)) (RefFunc(Verify_SaveClearCancel_msg))
32476>>>>>                End
32476>>>>>>
32476>>>>>                Else If (eCloseAction=cveSave) Begin
32479>>>>>                    Send NavigateCancelExec True
32480>>>>>                End
32480>>>>>>
32480>>>>>                Else Begin
32481>>>>>                    Send NavigateCancelExec False
32482>>>>>                End
32482>>>>>>
32482>>>>>            End
32482>>>>>>
32482>>>>>            Else Begin            
32483>>>>>                Send NavigateCancelExec False
32484>>>>>            End
32484>>>>>>
32484>>>>>        End
32484>>>>>>
32484>>>>>        Else Begin
32485>>>>>            Error DFERR_PROGRAM ("View stack Navigate error: " + sReason)
32486>>>>>>
32486>>>>>        End
32486>>>>>>
32486>>>>>    End_Procedure
32487>>>>>
32487>>>>>    
32487>>>>>    // This actually performs the Navigate Close operation. This will close the current
32487>>>>>    // view and pop the view stack without returning any data to the invoking view.
32487>>>>>    // This operates like a cancel. All data loss checking and confirmation has already
32487>>>>>    // been performed before we get here.
32487>>>>>    //
32487>>>>>    // Called via NavigateCancel, do not call this directly.
32487>>>>>    Procedure NavigateCancelExec Boolean bSave
32489>>>>>        Handle hoView hoCallback
32489>>>>>        Boolean bErr
32489>>>>>        String sView
32489>>>>>
32489>>>>>        If bSave Begin
32491>>>>>           Get SaveViewExec to bErr            
32492>>>>>           If bErr ;            Procedure_Return
32495>>>>>           // If save was successful treat this as a close and not a cancel
32495>>>>>           Send NavigateCloseExec False 
32496>>>>>           Procedure_Return
32497>>>>>        End
32497>>>>>>
32497>>>>>
32497>>>>>//        // Navigate to the next view down in the view stack
32497>>>>>//        Send PopView to (ViewStack(Self))                  // removes this view
32497>>>>>//        Get TopViewHandle of (ViewStack(Self)) to hoView   // handle to the new top of view
32497>>>>>        WebGet psNavigateBackView to sView   // handle to the new top of view
32498>>>>>
32498>>>>>        If (Trim(sView) <> "") Begin
32500>>>>>            Get FindWebObject of (Owner(Self)) sView to hoView
32501>>>>>            Send NavigateBackToHere of hoView True 0
32502>>>>>        End
32502>>>>>>
32502>>>>>        Else Begin
32503>>>>>            Send Hide   // If the view stack is empty, just hide this view
32504>>>>>        End
32504>>>>>>
32504>>>>>    End_Procedure
32505>>>>>
32505>>>>>    // Loads default data for NavigateData for NavigateForward.
32505>>>>>    // This must be executed from the point of view
32505>>>>>    // of the invoking object, which is the object that calls this.
32505>>>>>    Procedure LoadDefaultNavigateForwardData Handle hoInvokIngObject tWebNavigateData ByRef NavigateData
32507>>>>>        Integer iFile iField
32507>>>>>        String sValue
32507>>>>>        Handle hoServer hoDDO
32507>>>>>        Boolean bChanged bDataBindable
32507>>>>>        RowID ri
32507>>>>>        
32507>>>>>        // step Populate the Navigate Data struct with the best guess values from
32507>>>>>        // this control's server DDO.
32507>>>>>        // If this is called from outside a view, like a main menu, this should
32507>>>>>        // delegate to cWebApp and return 0.
32507>>>>>        Get Server of hoInvokIngObject to hoServer
32508>>>>>        
32508>>>>>        If (hoServer) Begin
32510>>>>>            Get pbDataBindable of hoInvokIngObject to bDataBindable
32511>>>>>            Get Main_File of hoServer to iFile
32512>>>>>            
32512>>>>>            If (NavigateData.eNavigateType=nfFromParent) Begin
32514>>>>>
32514>>>>>                // Assertion: Check that the constraining table is set properly
32514>>>>>                If (iFile<>NavigateData.iTable) Begin
32516>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromParent"
32517>>>>>>
32517>>>>>                    Procedure_Return
32518>>>>>                End
32518>>>>>>
32518>>>>>
32518>>>>>                Get CurrentRowId of hoServer to ri
32519>>>>>                Move (SerializeRowID(ri)) to NavigateData.sRowID 
32520>>>>>            End
32520>>>>>>
32520>>>>>            Else If (NavigateData.eNavigateType=nfFromChild or NavigateData.eNavigateType=nfFromMain) Begin
32523>>>>>
32523>>>>>                // Assertion: Check that the table is set properly for a from main
32523>>>>>                If (NavigateData.eNavigateType=nfFromMain and NavigateData.iTable<>iFile) Begin
32525>>>>>                    // With the NavigateInitialize logic we don't always have the right invoking object where this is not an error but something we want to correct
32525>>>>>                    Move NavigateData.iTable to iFile
32526>>>>>//                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromMain"
32526>>>>>//                    Procedure_Return
32526>>>>>                End
32526>>>>>>
32526>>>>>                // Assertion: Check that the table is set properly for a from child
32526>>>>>                If (NavigateData.eNavigateType=nfFromChild and (NavigateData.iTable=0 or NavigateData.iTable=iFile)) Begin
32528>>>>>                    Error DFERR_PROGRAM "Assert: Bad NavigateData for fromChild"
32529>>>>>>
32529>>>>>                    Procedure_Return
32530>>>>>                End
32530>>>>>>
32530>>>>>
32530>>>>>                // use the DDO that owns the file 
32530>>>>>                Get Data_Set of hoServer NavigateData.iTable to hoDDO
32531>>>>>                If hoDDO Begin
32533>>>>>                    Get CurrentRowId of hoDDO to ri
32534>>>>>                    If (bDataBindable) Begin
32536>>>>>                        Get Data_File of hoInvokIngObject  to iFile
32537>>>>>                        If (iFile=NavigateData.iTable) Begin
32539>>>>>                            Get Data_Field of hoInvokIngObject to iField
32540>>>>>                            Move iField to NavigateData.iColumn
32541>>>>>                            WebGet pbChanged of hoInvokIngObject to bChanged
32542>>>>>                            // if changed we will do item_find (read) to seed this
32542>>>>>                            If bChanged Begin
32544>>>>>                                // note this deferred (a DDO read)
32544>>>>>                                Send Item_Find of hoServer GE iFile iField True False True
32545>>>>>                                Move (GetRowID(iFile)) to ri
32546>>>>>                            End
32546>>>>>>
32546>>>>>                        End
32546>>>>>>
32546>>>>>                    End
32546>>>>>>
32546>>>>>                    Move (SerializeRowID(ri)) to NavigateData.sRowID    // Store the resulting RowID
32547>>>>>                End
32547>>>>>>
32547>>>>>            End
32547>>>>>>
32547>>>>>            // If undefined we provide no extra information. Trying to guess what the developer wants
32547>>>>>            // to do will just make things too confusing. Use OnGetNavigateForwardData to set whatever you want 
32547>>>>>        End
32547>>>>>>
32547>>>>>    End_Procedure
32548>>>>>    
32548>>>>>    // loads default data for NavigateData for a NavigateClose
32548>>>>>    // This must be executed from the point of view
32548>>>>>    // of the invoking object, which is the object that calls this.
32548>>>>>    
32548>>>>>    Procedure LoadDefaultNavigateBackData Handle hoInvokingObject tWebNavigateData ByRef NavigateData
32550>>>>>        Integer iFile iField
32550>>>>>        Handle hoServer
32550>>>>>        Boolean bChanged bDataBindable
32550>>>>>        RowID ri
32550>>>>>        
32550>>>>>        // Populate the Navigate Data struct with the best guess values from
32550>>>>>        // this control's server DDO
32550>>>>>        // If this is called from outside a view, like a main menu, this should
32550>>>>>        // delegate to cWebApp and return 0.
32550>>>>>        Get Server of hoInvokingObject to hoServer
32551>>>>>        If (hoServer) Begin
32553>>>>>            Get pbDataBindable of hoInvokingObject to bDataBindable
32554>>>>>            Get CurrentRowId of hoServer to ri
32555>>>>>            Move (SerializeRowID(ri)) to NavigateData.sRowID 
32556>>>>>            Get Main_File of hoServer to NavigateData.iTable
32557>>>>>            
32557>>>>>            If (bDataBindable) Begin
32559>>>>>                Get Data_File of hoInvokingObject  to iFile
32560>>>>>                Get Data_Field of hoInvokingObject to iField
32561>>>>>                
32561>>>>>                Move iFile  to NavigateData.iTable
32562>>>>>                Move iField to NavigateData.iColumn
32563>>>>>            End
32563>>>>>>
32563>>>>>        End
32563>>>>>>
32563>>>>>    
32563>>>>>    End_Procedure
32564>>>>>    
32564>>>>>    
32564>>>>>    // Triggers an update of the state hash and pushes it to the history stack.
32564>>>>>    //
32564>>>>>    // Params:
32564>>>>>    //      bReplace    If true the new state will replace the existing state instead of pushing a 
32564>>>>>    //                  new history item.
32564>>>>>    Procedure UpdateStateHash Boolean bReplace
32566>>>>>        String sPrevHash sStateHash
32566>>>>>        
32566>>>>>        If (peApplicationStateMode(Host(Self)) <> asmOff) Begin
32568>>>>>            Get GenerateStateHash to sStateHash
32569>>>>>
32569>>>>>            If (bReplace) Begin
32571>>>>>                Get StateHash of (Host(Self)) to sPrevHash
32572>>>>>                If (sStateHash <> sPrevHash) Begin
32574>>>>>                    Send SetStateHash of (Host(Self)) sStateHash "" True
32575>>>>>                End
32575>>>>>>
32575>>>>>            End
32575>>>>>>
32575>>>>>            Else Begin
32576>>>>>                Send SetStateHash of (Host(Self)) sStateHash "" False
32577>>>>>            End
32577>>>>>>
32577>>>>>        End
32577>>>>>>
32577>>>>>    End_Procedure
