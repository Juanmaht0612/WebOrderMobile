23319>>>>>>>                        Function_Return False
23320>>>>>>>                    End
23320>>>>>>>>
23320>>>>>>>                    
23320>>>>>>>                    // Normally the expected record should now be in the DDO, but not always!
23320>>>>>>>                    // If a record has been deleted or is constraint invalid, we will have a mismatch.
23320>>>>>>>                    // If this happened, hoBadDDO should have been set or current rowid is null.
23320>>>>>>>                    // If not, we have a logic flaw 
23320>>>>>>>                    If (not(IsSameRowID(riRowID,riCrnt))) Begin
23322>>>>>>>                        // If mismatch but an error, we are ok.
23322>>>>>>>                        // If a mismtach and the current RowId is null, this is probably a child
23322>>>>>>>                        // relates to constraint failure that was cleared, we are ok.
23322>>>>>>>                        // Else we have a logic Error                    
23322>>>>>>>                        If (not(hoBadDDO) and not(IsNullRowID(riCrnt))) Begin
23324>>>>>>>                            Error DFERR_PROGRAM ("Client DDO " + aDDOs[i].sName + " cannot set the rowid on server(2")
23325>>>>>>>>
23325>>>>>>>                            Function_Return False
23326>>>>>>>                        End
23326>>>>>>>>
23326>>>>>>>                    End
23326>>>>>>>>
23326>>>>>>>                    
23326>>>>>>>                Loop
23327>>>>>>>>
23327>>>>>>>            End
23327>>>>>>>>
23327>>>>>>>        
23327>>>>>>>        End
23327>>>>>>>>
23327>>>>>>>        
23327>>>>>>>        If hoBadDDO Begin
23329>>>>>>>            Send OnSyncDDOsRefindError hoBadDDO
23330>>>>>>>        End
23330>>>>>>>>
23330>>>>>>>        
23330>>>>>>>        Function_Return True
23331>>>>>>>    End_Function
