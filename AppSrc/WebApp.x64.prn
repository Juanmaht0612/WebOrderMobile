2152>>>>>>>    
2152>>>>>>>    // Public Message: Get Msg_Popup_Modal to rval
2152>>>>>>>    //                 Send Popup_Modal
2152>>>>>>>    //
2152>>>>>>>    //  Allows any object to be used as a modal popup object.
2152>>>>>>>    //  This messages creates a modal object (Setting all properties as
2152>>>>>>>    //  required), activates via ui_accept, restores all properties, and
2152>>>>>>>    //  then returns the exit value.
2152>>>>>>>    //
2152>>>>>>>    Procedure Popup_Modal Returns Integer // force object to be modal and then pop it up!
2154>>>>>>>        Integer OldBMS OldAPS OldPS OldRS OldSS
2154>>>>>>>        Integer rVal
2154>>>>>>>        // If object is active we can't do anything. -1 means already active
2154>>>>>>>        If (Active_State(Self)) ;            Procedure_Return -1
2157>>>>>>>        
2157>>>>>>>        // Remember all important modal property settings.
2157>>>>>>>        Get Block_mouse_State            to OldBMS
2158>>>>>>>        Get Attach_parent_State          to OldAPS
2159>>>>>>>        Get Popup_State                  to OldPS
2160>>>>>>>        Get Ring_State                   to OldRS
2161>>>>>>>        Get Scope_State                  to OldSS
2162>>>>>>>        
2162>>>>>>>        Set Modal_State to True  // Set modal properties (can be augmented)
2163>>>>>>>        Get Msg_Popup to rVal
2164>>>>>>>        If rval ;            Move -2 to rVal      // did not activate
2167>>>>>>>        Else ;            Move StrMark to rVal // StrMark keeps track of UI value
2169>>>>>>>        // if 0- a stop_ui, if >0, ret value
2169>>>>>>>        Set Modal_State to False // Unset (in case of augmentation)
2170>>>>>>>        // restore all expected properties
2170>>>>>>>        Set Block_mouse_State   to OldBMS
2171>>>>>>>        Set Attach_parent_State to OldAPS
2172>>>>>>>        Set Popup_State         to OldPS
2173>>>>>>>        Set Ring_State          to OldRS
2174>>>>>>>        Set Scope_State         to OldSS
2175>>>>>>>        Procedure_Return rVal
2176>>>>>>>    End_Procedure
2177>>>>>>>    
2177>>>>>>>    Procedure Set Modal_State Integer Fg
2179>>>>>>>        Set Block_mouse_state to fg
2180>>>>>>>        Set Attach_parent_state to (not(fg))
2181>>>>>>>        // we used to set Exit_Application_Local_State to True - as of 19.1 we don't
2181>>>>>>>        If fg Begin
2183>>>>>>>            Set popup_state to True
2184>>>>>>>            Set ring_state to True
2185>>>>>>>            Set scope_state to True
2186>>>>>>>        End
2186>>>>>>>>
2186>>>>>>>        // this will block parent accelorator keys in modal objects
2186>>>>>>>        // by assigning the inheritance path directly to the desktop
2186>>>>>>>        // thereby skipping all inherited keys. Only do this if Key_path
2186>>>>>>>        // has not been tampered with (i.e. set by developer). If changed,
2186>>>>>>>        // its up to developer to make this right
2186>>>>>>>        // Note that 0 = no special path - use parent
2186>>>>>>>        // To override and get the old behavior do the following in your object:
2186>>>>>>>        //     Set Key_Path to (parent(self))
2186>>>>>>>        
2186>>>>>>>        If (Fg and key_path(Self)=0) ;  // if set to modal, and no special inheritance path            Set Key_path to Desktop                // set to desktop (skipping all objects)
2189>>>>>>>        Else If (not(Fg) and key_path(Self)=desktop) ;  // if non modal and on desktop            Set Key_path to 0                      // change to no special path
2193>>>>>>>    End_Procedure
2194>>>>>>>    
2194>>>>>>>    Function Modal_State Returns Integer
2196>>>>>>>        Function_Return (block_mouse_state(Self))
2197>>>>>>>    End_Function
2198>>>>>>>    
2198>>>>>>>    //  This will stop the current modal UI if a modal UI level
2198>>>>>>>    //  exists and it has not already been stopped.
2198>>>>>>>    //  This is smarter than Stop_ui (which should dnot be used) because it can
2198>>>>>>>    //  be sent multiple times and only the current UI is stopped.
2198>>>>>>>    //
2198>>>>>>>    Procedure Stop_Modal_UI
2200>>>>>>>        If ( Current_Modal_Object and ; // only if modal object exists            Private.stop_ui_state(Current_Modal_Object) ) Begin // and it needs stopping
2202>>>>>>>            Send stop_ui
2203>>>>>>>            Set private.stop_ui_state of Current_Modal_Object to False
2204>>>>>>>        End
2204>>>>>>>>
2204>>>>>>>    End_Procedure
2205>>>>>>>    
2205>>>>>>>    
2205>>>>>>>    
2205>>>>>>>    Procedure Create_Dialog Integer i1 Integer i2
2207>>>>>>>        Integer OldModalObj
2207>>>>>>>        Handle hoFocus
2207>>>>>>>        
2207>>>>>>>        // this is required by cCJGrids to make sure that the cell's edit control is removed before
2207>>>>>>>        // the modal object takes the focus. For all other objects, this does nothing.
2207>>>>>>>        Get Focus to hoFocus
2208>>>>>>>        If (hoFocus>Desktop) Begin
2210>>>>>>>            Send OnPreCreate_Dialog of hoFocus
2211>>>>>>>        End
2211>>>>>>>>
2211>>>>>>>        
2211>>>>>>>        // by keeping track of the old modal object we can properly nest
2211>>>>>>>        // modal popups
2211>>>>>>>        Move Current_Modal_Object to OldModalObj
2212>>>>>>>        Move Self to Current_Modal_Object
2213>>>>>>>        Set private.stop_ui_state to True
2214>>>>>>>        Send OnPreApplySkin False
2215>>>>>>>        Forward Send create_dialog i1 i2 // will activate and start a new UI
2217>>>>>>>        
2217>>>>>>>        // at this point the object may or may not be active. To handle
2217>>>>>>>        // this, DF will send deactivate_group to get rid of it if it is
2217>>>>>>>        // still active. It will send this after the procedure is complete.
2217>>>>>>>        // We know that the UI is stopped!
2217>>>>>>>        
2217>>>>>>>        Set private.stop_ui_state to False // since UI is stopped. Shut this off
2218>>>>>>>        Move OldModalObj to Current_Modal_Object // the prior modal level if any
2219>>>>>>>    End_Procedure
2220>>>>>>>    
2220>>>>>>>    Procedure Remove_Object
2222>>>>>>>        Forward Send remove_object
2224>>>>>>>        // If we are removing the current modal object we might need
2224>>>>>>>        // to stop the UI as well.
2224>>>>>>>        If (Current_Modal_Object = Self) ;            Send Stop_Modal_UI
2227>>>>>>>    End_Procedure
