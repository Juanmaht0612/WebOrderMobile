29644>>>>>>>>>    //  Called by the list / grid to determine the field value details based on the current 
29644>>>>>>>>>    //  environment values (global buffer or properties). It fills the tWebCell struct that is 
29644>>>>>>>>>    //  passed by reference with details needed by the JavaScript Engine to render the cell.
29644>>>>>>>>>    Procedure LoadGridCell tWebCell ByRef tCell
29646>>>>>>>>>        Integer iFile iField
29646>>>>>>>>>        String sValue
29646>>>>>>>>>        
29646>>>>>>>>>
29646>>>>>>>>>        Get Data_File  to iFile
29647>>>>>>>>>        Get Data_Field to iField
29648>>>>>>>>>        
29648>>>>>>>>>        If (iFile <> 0) Begin
29650>>>>>>>>>            //  Security check
29650>>>>>>>>>            If (FillDEOAllowed(Self)) Begin            
29652>>>>>>>>>                // If there is a data binding then get the file.field value....
29652>>>>>>>>>                Get_Field_Value iFile iField to sValue
29655>>>>>>>>>            End
29655>>>>>>>>>>
29655>>>>>>>>>        End
29655>>>>>>>>>>
29655>>>>>>>>>        Else Begin
29656>>>>>>>>>            // if there is no data binding then fire the calculated field event....
29656>>>>>>>>>            WebGet psValue to sValue
29657>>>>>>>>>            Send OnSetCalculatedValue (&sValue)         // calculated value
29658>>>>>>>>>        End
29658>>>>>>>>>>
29658>>>>>>>>>
29658>>>>>>>>>        // Convert the value into the correct format for transport....                    
29658>>>>>>>>>        Move (Trim(sValue)) to sValue                                            // make sure the value is trimmed
29659>>>>>>>>>        Get ConvertToTransport (RefFunc(psValue)) sValue cArgStr  to sValue
29660>>>>>>>>>        
29660>>>>>>>>>        // Give a chance to add custom tooltips & CSS Classnames
29660>>>>>>>>>        Send OnDefineTooltip (&tCell.sTooltip)
29661>>>>>>>>>        Send OnDefineCssClass (&tCell.sCssClassName)
29662>>>>>>>>>        
29662>>>>>>>>>        Move sValue to tCell.sValue
29663>>>>>>>>>    End_Procedure
29664>>>>>>>>>    
