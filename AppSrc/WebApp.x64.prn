34935>>>>>    // Synchronizes the current records with the passed row id's for each DDO in the
34935>>>>>    // passed collection of DDO structures. Each Structure in the collection belongs
34935>>>>>    // to a different view. The aDDOViews parameter is populated with the object handle
34935>>>>>    // of each view referenced in the aDDODefs collection
34935>>>>>    //
34935>>>>>    // During this process the view is tested for AllowViewAccess. If access is denied to
34935>>>>>    // any view in the stack then SynchronizeDDOs is aborted and the function returns False.
34935>>>>>    Procedure Call_PreSync tWebCallContext ByRef cctx
34937>>>>>        Boolean bAllowAccess
34937>>>>>        Integer i icDDODef
34937>>>>>        String sViewName
34937>>>>>        Handle[] aDDOViews
34938>>>>>        Handle hoInvokingObject
34938>>>>>         
34938>>>>>        Set pbSynchronizing to True
34939>>>>>        
34939>>>>>        Send NotifySyncWebApp
34940>>>>>         
34940>>>>>        // Iterate the DDODefs array and synchronize the DDOs for each view....
34940>>>>>        Move True to bAllowAccess
34941>>>>>        Move (SizeOfArray(cctx.request.Header.aDDOViews)) to icDDODef
34942>>>>>        
34942>>>>>        //  First get all the object references
34942>>>>>        For i from 0 to (icDDODef - 1)
34948>>>>>>
34948>>>>>            // Get the array of object handles to the views referenced in the request header's aDDODefs collection....
34948>>>>>            Get GetAjaxWebAppView of (phoWebControlLocator(Self)) cctx.request.Header.aDDOViews[i] to aDDOViews[i]
34949>>>>>        Loop
34950>>>>>>
34950>>>>>        Set paDDOViews to aDDOViews
34951>>>>>        
34951>>>>>        //  Now we can do the rest of the work
34951>>>>>        For i from 0 to (icDDODef - 1)
34957>>>>>>
34957>>>>>            If (aDDOViews[i] <> C_WebUnresolvedObject) Begin
34959>>>>>                // Test if access is allowed to the view...
34959>>>>>                Get Object_Label of aDDOViews[i] to sViewName
34960>>>>>                Get AllowViewAccess of (SessionManager(Self)) aDDOViews[i] sViewName to bAllowAccess
34961>>>>>
34961>>>>>                If (not(bAllowAccess)) Begin
34963>>>>>                    Error DFERR_WEBAPP_ACCESS_DENIED
34964>>>>>>
34964>>>>>                    Move True to cctx.bCancel
34965>>>>>                    Function_Return False
34966>>>>>                End
34966>>>>>>
34966>>>>>                
34966>>>>>                // Synchronize the view's DDOs with the DDOs in the request header
34966>>>>>                Get SyncDDOs of aDDOViews[i] to bAllowAccess
34967>>>>>                If (not(bAllowAccess)) Begin
34969>>>>>                    Move True to cctx.bCancel
34970>>>>>                    Function_Return False
34971>>>>>                End
34971>>>>>>
34971>>>>>                                
34971>>>>>                // Process the synchronized psValue and pbChanged properties for each control that has a data binding
34971>>>>>                Broadcast Recursive Send UpdateDataBinding to aDDOViews[i]
34973>>>>>                
34973>>>>>                // Send the Rights & Roles event hook to the view....
34973>>>>>                Send NotifySyncWebApp to aDDOViews[i]
34974>>>>>                
34974>>>>>                // Get the invoking object, as this might create dynamic objects which could sync their DDO's and we don't want that to happen later
34974>>>>>                Get GetInvokingObject of aDDOViews[i] to hoInvokingObject
34975>>>>>            End
34975>>>>>>
34975>>>>>        Loop 
34976>>>>>>
34976>>>>>        
34976>>>>>        Set pbSynchronizing to False
34977>>>>>    End_Procedure
34978>>>>>    
34978>>>>>    Procedure Call_PostSync tWebCallContext ByRef cctx
34980>>>>>        Integer i icDDODef
34980>>>>>        Handle[] aDDOViews
34981>>>>>        
34981>>>>>        // Iterate all the DDODefs in the Request and return the DDODefs for each one in the response
34981>>>>>        Get paDDOViews to aDDOViews
34982>>>>>        Move (SizeOfArray(aDDOViews)) to icDDODef
34983>>>>>        
34983>>>>>        For i from 0 to (icDDODef - 1)
34989>>>>>>
34989>>>>>            Send StoreDDOStates of aDDOViews[i]
34990>>>>>        Loop
34991>>>>>>
34991>>>>>    End_Procedure
