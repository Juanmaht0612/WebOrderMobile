17373>>>>>    Procedure AddHttpResponseHeader String sHeaderName String sHeaderValue
17375>>>>>        Send AddHttpResponseHeader of ghInetSession sHeaderName sHeaderValue
17376>>>>>    End_Procedure
17377>>>>>
17377>>>>>    // Gets a cookie value based on passed name.
17377>>>>>    //
17377>>>>>    // Params:
17377>>>>>    //  sName   Name of the cookie key.
17377>>>>>    // Returns:
17377>>>>>    //  The value of the cookie key.
17377>>>>>    //
17377>>>>>    Function GetCookie String sName Returns String
17379>>>>>        String sCookie sCookieUC sNameUC sValue
17379>>>>>        Integer iPos iPos2
17379>>>>>        
17379>>>>>        //  Get entire cookie string using ServerVariable method
17379>>>>>        Get ServerVariable "HTTP_COOKIE" to sCookie
17380>>>>>        
17380>>>>>        Move 0 to iPos
17381>>>>>        Move (Uppercase(sCookie)) to sCookieUC
17382>>>>>        Move (Uppercase(sName)) to sNameUC
17383>>>>>        
17383>>>>>        //  Loop over GET parameters
17383>>>>>        Repeat
17383>>>>>>
17383>>>>>            Increment iPos
17384>>>>>            
17384>>>>>            //  Determine position of the name
17384>>>>>            Move (Pos("=", sCookieUC, iPos)) to iPos2
17385>>>>>            
17385>>>>>            //  Check the name
17385>>>>>            If (Trim(Mid(sCookieUC, iPos2 - iPos, iPos)) = sNameUC) Begin
17387>>>>>                
17387>>>>>                //  Determine position of the value
17387>>>>>                Increment iPos2 //  Step over the =
17388>>>>>                Move (Pos(";", sCookie, iPos2)) to iPos
17389>>>>>                
17389>>>>>                If (iPos > 0) Begin
17391>>>>>                    Move (Mid(sCookie, iPos - iPos2, iPos2)) to sValue
17392>>>>>                End
17392>>>>>>
17392>>>>>                Else Begin
17393>>>>>                    Move ((Mid(sCookie, (Length(sCookie) - iPos2 + 1), iPos2))) to sValue
17394>>>>>                End
17394>>>>>>
17394>>>>>                
17394>>>>>                //  Unescape cookie value
17394>>>>>                Move (UrlDecode(sValue)) to sValue
17395>>>>>                
17395>>>>>                Function_Return sValue
17396>>>>>            End
17396>>>>>>
17396>>>>>            
17396>>>>>            Move (Pos(";", sCookie, iPos2)) to iPos
17397>>>>>        Until (not(iPos > 0)) 
17399>>>>>        
17399>>>>>        Function_Return ""
17400>>>>>    End_Function
17401>>>>>
17401>>>>>    
17401>>>>>    // Sets a cookie using the given name and value. The iExpires parameter determines the number 
17401>>>>>    // of hours before the cookie will expire. If 0 is passed the cookie will be Set as a session 
17401>>>>>    // cookie meaning that it will be cleared as soon as the browser is closed. Note that it is 
17401>>>>>    // advised to not use special characters and no "=" and ";" in the name and value.
17401>>>>>    //
17401>>>>>    // Params:
17401>>>>>    //  sName       Cookie key name.
17401>>>>>    //  sValue      New value for the cookie key.
17401>>>>>    //  iExpires    Number of hours before the cookie expires (0 = session).
17401>>>>>    //  sOptPath    Path for which the cookie should be stored ('' for the current path, '/' for 
17401>>>>>    //              the entire domain).
17401>>>>>    //  sOptDomain  Domain for which the cookie is set.
17401>>>>>    //  bOptSecure  If true the cookie is set as a secure cookie so it is only sent with HTTPS 
17401>>>>>    //              connections.
17401>>>>>    //  bOptHttpOnly    If true the cookie is set as a http only cookie so that it is not 
17401>>>>>    //                  accessible from JavaScript.
17401>>>>>    //
17401>>>>>    Procedure SetCookie String sName String sValue Integer iOptExpires String sOptPath String sOptDomain Boolean bOptSecure Boolean bOptHttpOnly String sOptSameSite
17403>>>>>        String sSetCookie sGMT sSameSite
17403>>>>>        DateTime dtExpires
17403>>>>>        
17403>>>>>        //  Encode the value and add it to the cookie string
17403>>>>>        Move (UrlEncode(sValue, True)) to sValue
17404>>>>>        Move (sName + "=" + sValue) to sSetCookie
17405>>>>>        
17405>>>>>        //  If an expiracy number of hours is set we add that to the cookie string
17405>>>>>        If (num_arguments >= 3) Begin
17407>>>>>            If (iOptExpires > 0) Begin
17409>>>>>                Move (DateAddHour(CurrentDateTime(), iOptExpires)) to dtExpires                
17410>>>>>                Get GMTString dtExpires to sGMT
17411>>>>>                Move (sSetCookie + "; Expires=" + sGMT) to sSetCookie
17412>>>>>            End
17412>>>>>>
17412>>>>>        End
17412>>>>>>
17412>>>>>        
17412>>>>>        //  Add path if needed
17412>>>>>        If (num_arguments >= 4) Begin
17414>>>>>            If (Trim(sOptPath) <> "") Begin
17416>>>>>                Move (UrlEncode(sOptPath, False)) to sOptPath
17417>>>>>                Move (sSetCookie + "; Path=" + sOptPath) to sSetCookie
17418>>>>>            End
17418>>>>>>
17418>>>>>        End
17418>>>>>>
17418>>>>>        
17418>>>>>        //  Add domain if needed
17418>>>>>        If (num_arguments >= 5) Begin
17420>>>>>            If (Trim(sOptDomain) <> "") Begin
17422>>>>>                Move (UrlEncode(sOptDomain, False)) to sOptDomain
17423>>>>>                Move (sSetCookie + "; Domain=" + sOptDomain) to sSetCookie
17424>>>>>            End
17424>>>>>>
17424>>>>>        End
17424>>>>>>
17424>>>>>        
17424>>>>>        //  Add secure if needed
17424>>>>>        If (num_arguments >= 6) Begin
17426>>>>>            If (bOptSecure) Begin
17428>>>>>                Move (sSetCookie + "; Secure") to sSetCookie
17429>>>>>            End
17429>>>>>>
17429>>>>>        End
17429>>>>>>
17429>>>>>        
17429>>>>>        //  Add httponly if needed
17429>>>>>        If (num_arguments >= 7) Begin
17431>>>>>            If (bOptHttpOnly) Begin
17433>>>>>                Move (sSetCookie + "; HttpOnly") to sSetCookie
17434>>>>>            End
17434>>>>>>
17434>>>>>        End
17434>>>>>>
17434>>>>>        
17434>>>>>        //  Add SameSite attribute
17434>>>>>        Move "Lax" to sSameSite
17435>>>>>        If (num_arguments >= 8) Begin
17437>>>>>            Move sOptSameSite to sSameSite
17438>>>>>        End
17438>>>>>>
17438>>>>>        Move (sSetCookie + "; SameSite=" + Trim(sSameSite)) to sSetCookie
17439>>>>>        
17439>>>>>        //  Add the Set-Cookie HTTP header
17439>>>>>        Send AddHttpResponseHeader of ghInetSession "Set-Cookie" sSetCookie
17440>>>>>    End_Procedure
17441>>>>>    
17441>>>>>    
17441>>>>>    //  Converts a datetime into a GMT string by converting it to the UTC time and and outputting 
17441>>>>>    //  it in the format Wdy, DD Mon YYYY HH:MM:SS GMT.
17441>>>>>    Function GMTString DateTime dtDate Returns String
17443>>>>>        String sGMT
17443>>>>>        Integer iUTCOffset iDay iMonth
17443>>>>>        
17443>>>>>        Move (SysConf (SYSCONF_UTC_TIME_OFFSET)) to iUTCOffset
17444>>>>>        Move (DateAddSecond(dtDate, iUTCOffset)) to dtDate
17445>>>>>        
17445>>>>>        Move (DateGetDayOfWeek(dtDate)) to iDay
17446>>>>>        If (iDay = 1) ;            Move ("Sun") to  sGMT
17449>>>>>        If (iDay = 2) ;            Move ("Mon") to  sGMT
17452>>>>>        If (iDay = 3) ;            Move ("Tue") to  sGMT
17455>>>>>        If (iDay = 4) ;            Move ("Wed") to  sGMT
17458>>>>>        If (iDay = 5) ;            Move ("Thu") to  sGMT
17461>>>>>        If (iDay = 6) ;            Move ("Fri") to  sGMT
17464>>>>>        If (iDay = 7) ;            Move ("Sat") to  sGMT
17467>>>>>        
17467>>>>>        Move (sGMT + ", " + Right("0" + String(DateGetDay(dtDate)), 2) + " ") to sGMT
17468>>>>>        
17468>>>>>        Move (DateGetMonth(dtDate)) to iMonth
17469>>>>>        If (iMonth = 1) ;            Move (sGMT + "Jan") to  sGMT
17472>>>>>        If (iMonth = 2) ;            Move (sGMT + "Feb") to  sGMT
17475>>>>>        If (iMonth = 3) ;            Move (sGMT + "Mar") to  sGMT
17478>>>>>        If (iMonth = 4) ;            Move (sGMT + "Apr") to  sGMT
17481>>>>>        If (iMonth = 5) ;            Move (sGMT + "May") to  sGMT
17484>>>>>        If (iMonth = 6) ;            Move (sGMT + "Jun") to  sGMT
17487>>>>>        If (iMonth = 7) ;            Move (sGMT + "Jul") to  sGMT
17490>>>>>        If (iMonth = 8) ;            Move (sGMT + "Aug") to  sGMT
17493>>>>>        If (iMonth = 9) ;            Move (sGMT + "Sep") to  sGMT
17496>>>>>        If (iMonth = 10) ;            Move (sGMT + "Oct") to  sGMT
17499>>>>>        If (iMonth = 11) ;            Move (sGMT + "Nov") to  sGMT
17502>>>>>        If (iMonth = 12) ;            Move (sGMT + "Dec") to  sGMT
17505>>>>>        
17505>>>>>        Move (sGMT + SFormat(" %1 %2:%3:%4 GMT", DateGetYear(dtDate), Right("0" + String(DateGetHour(dtDate)), 2), Right("0" + String(DateGetMinute(dtDate)), 2),Right("0" + String(DateGetSecond(dtDate)), 2))) to sGMT
17506>>>>>        
17506>>>>>        Function_Return sGMT
17507>>>>>    End_Function
17508>>>>>    
17508>>>>>   
17508>>>>>    
17508>>>>>End_Class
