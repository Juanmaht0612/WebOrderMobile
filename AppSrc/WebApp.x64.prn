23078>>>>>>>    Procedure AddDDOStructure Handle hoMain_DD
23080>>>>>>>        // If your view has two or more independant DDO Structures then send this message to add
23080>>>>>>>        // each additional DDO structure to the set of DDO structures that are synchronized with
23080>>>>>>>        // the client. Do not Send this to add the view's main DDO structure, that will be added
23080>>>>>>>        // automatically. Pass the Main_DD of the DDO structure as the parameter.
23080>>>>>>>        Handle[] aAdditionalDDOStructures
23081>>>>>>>        
23081>>>>>>>        Get paAdditionalDDOStructures to aAdditionalDDOStructures
23082>>>>>>>        Move hoMain_DD to aAdditionalDDOStructures[SizeOfArray(aAdditionalDDOStructures)]
23083>>>>>>>        Set paAdditionalDDOStructures to aAdditionalDDOStructures
23084>>>>>>>    End_Procedure
