21858>>>>>>>>>>>>>    //  Override the ShowControlError function called by the error system to show control errors. 
21858>>>>>>>>>>>>>    //  Returns true to let the error system know that this control can show errors.
21858>>>>>>>>>>>>>    Function ShowControlError Integer iErrNum String sErrText Returns Boolean
21860>>>>>>>>>>>>>        Boolean bInSync bRender
21860>>>>>>>>>>>>>        
21860>>>>>>>>>>>>>        Get IsInCallActionScope to bInSync
21861>>>>>>>>>>>>>        If (bInSync) Begin
21863>>>>>>>>>>>>>            Get IsControlRendered to bRender
21864>>>>>>>>>>>>>            If (bRender) Begin
21866>>>>>>>>>>>>>                Send ShowControlError iErrNum sErrText
21867>>>>>>>>>>>>>                Function_Return True        
21868>>>>>>>>>>>>>            End
21868>>>>>>>>>>>>>>
21868>>>>>>>>>>>>>        End
21868>>>>>>>>>>>>>>
21868>>>>>>>>>>>>>        
21868>>>>>>>>>>>>>        Function_Return False
21869>>>>>>>>>>>>>    End_Function
21870>>>>>>>>>>>>>    
21870>>>>>>>>>>>>>    
21870>>>>>>>>>>>>>    //  Displays a control error in an error balloon around the control. The error number is used 
21870>>>>>>>>>>>>>    //  as identifier to hide the error. The error will be cleared by a WebSet of psValue and the 
21870>>>>>>>>>>>>>    //  HideControlError / HideAllControlErrors procedures and by a succesfull server-side 
21870>>>>>>>>>>>>>    //  validation.
21870>>>>>>>>>>>>>    // 
21870>>>>>>>>>>>>>    //  Params:
21870>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
21870>>>>>>>>>>>>>    //      sErrText    Error description.
21870>>>>>>>>>>>>>    Procedure ShowControlError Integer iErrNum String sErrText
21872>>>>>>>>>>>>>        String[] aParams
21873>>>>>>>>>>>>>        
21873>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
21874>>>>>>>>>>>>>        Move sErrText   to aParams[1]
21875>>>>>>>>>>>>>        
21875>>>>>>>>>>>>>        WebSet pbHasControlError to True
21876>>>>>>>>>>>>>        Send ClientAction "showControlError" aParams
21877>>>>>>>>>>>>>    End_Procedure
21878>>>>>>>>>>>>>        
21878>>>>>>>>>>>>>    
21878>>>>>>>>>>>>>    //  Hides an error shown using ShowControlError based on its error number.
21878>>>>>>>>>>>>>    // 
21878>>>>>>>>>>>>>    //  Params:
21878>>>>>>>>>>>>>    //      iErrNum     Error number used as identifier.
21878>>>>>>>>>>>>>    Procedure HideControlError Integer iErrNum
21880>>>>>>>>>>>>>        String[] aParams
21881>>>>>>>>>>>>>        
21881>>>>>>>>>>>>>        Move iErrNum    to aParams[0]
21882>>>>>>>>>>>>>        
21882>>>>>>>>>>>>>        Send ClientAction "hideControlError" aParams
21883>>>>>>>>>>>>>    End_Procedure
21884>>>>>>>>>>>>>    
21884>>>>>>>>>>>>>    //  Hides all active control errors on this control.
21884>>>>>>>>>>>>>    Procedure HideAllControlErrors
21886>>>>>>>>>>>>>        Boolean bHas
21886>>>>>>>>>>>>>        
21886>>>>>>>>>>>>>        WebGet pbHasControlError to bHas
21887>>>>>>>>>>>>>        
21887>>>>>>>>>>>>>        If (bHas) Begin
21889>>>>>>>>>>>>>            Send ClientAction "hideAllControlErrors"
21890>>>>>>>>>>>>>            WebSet pbHasControlError to False
21891>>>>>>>>>>>>>        End
21891>>>>>>>>>>>>>>
21891>>>>>>>>>>>>>    End_Procedure
21892>>>>>>>>>>>>>    
21892>>>>>>>>>>>>>    
21892>>>>>>>>>>>>>    //  Called to determine if filling the DEO with data is allowed.
21892>>>>>>>>>>>>>    //
21892>>>>>>>>>>>>>    //  Params:
21892>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
21892>>>>>>>>>>>>>    Procedure AllowFillDEO Boolean ByRef bAllow
21894>>>>>>>>>>>>>        If (bAllow) Begin
21896>>>>>>>>>>>>>            Get IsControlAccessible False (pbNoFillIfHidden(Self)) to bAllow
21897>>>>>>>>>>>>>        End
21897>>>>>>>>>>>>>>
21897>>>>>>>>>>>>>    End_Procedure
21898>>>>>>>>>>>>>    
21898>>>>>>>>>>>>>    //  Called to determine if the DEO has permission to update the Data Dictionary with new value(s).
21898>>>>>>>>>>>>>    //
21898>>>>>>>>>>>>>    //  Params:
21898>>>>>>>>>>>>>    //      bAllow      ByRef boolean set to false if not allowed.
21898>>>>>>>>>>>>>    Procedure AllowUpdateDD Boolean ByRef bAllow
21900>>>>>>>>>>>>>        If (bAllow) Begin
21902>>>>>>>>>>>>>            Get IsControlAccessible True (pbNoUpdateIfHidden(Self)) to bAllow
21903>>>>>>>>>>>>>        End
21903>>>>>>>>>>>>>>
21903>>>>>>>>>>>>>    End_Procedure
