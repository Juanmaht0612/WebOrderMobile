23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// Used for storing non-scalar (advanced) synchronized properties during the AJAX Call. Next
23913>>>>>>>>>>>>>// to the tWebAdvSyncProp struct known by the client it also keeps track of 
23913>>>>>>>>>>>>>// changes and caches the deserialized value in a variant for repeative access.
23913>>>>>>>>>>>>>Struct tWebCacheAdvProp
23913>>>>>>>>>>>>>    Handle hoObj
23913>>>>>>>>>>>>>    tWebAdvSyncProp tSyncProp
23913>>>>>>>>>>>>>    tWebAdvSyncProp tSyncProp
23913>>>>>>>>>>>>>    tWebAdvProp tSvrProp    
23913>>>>>>>>>>>>>    tWebAdvProp tSvrProp    
23913>>>>>>>>>>>>>    Boolean bChanged
23913>>>>>>>>>>>>>    Boolean bDeserialized
23913>>>>>>>>>>>>>End_Struct
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// Sync Props Arrays
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>Global_Variable tWebSyncProps[][] gaSyncProps   // This is the main web properties buffer.
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// gaSyncChangedProps: Changed properties. There is an array member for each object in 
23913>>>>>>>>>>>>>// gaSyncProps. If an Object has changed properties then the pbChanged flag is Set to True.
23913>>>>>>>>>>>>>Global_Variable tWebChangedProps[][] gaSyncChangedProps
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// gaSyncObjectHandles: This stores the object handle for each member of gaSyncProps. Used as an index
23913>>>>>>>>>>>>>// to gaSyncProps (and gaSyncChangedProps). C_WebUnresolvedObject is stored for an unresolved object handle.
23913>>>>>>>>>>>>>Global_Variable Handle[][] gaSyncObjectHandles
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// gaAdvSyncProps: This is the buffer for advanced web properties.
23913>>>>>>>>>>>>>Global_Variable tWebCacheAdvProp[][] gaAdvSyncProps
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>// The basic web property handler implementation that has logic for storing and maintaining web 
23913>>>>>>>>>>>>>// properties in set of global variables. The global variables are used as an optimization as 
23913>>>>>>>>>>>>>// storing structs in web properties is inefficient in memory management. The subclasses 
23913>>>>>>>>>>>>>// (cWebServerPropHandler and cWebClientPropHandler) will actually store and load the web properties.
23913>>>>>>>>>>>>>
23913>>>>>>>>>>>>>Class cWebBasePropHandler is a cObject
23914>>>>>>>>>>>>>    
23914>>>>>>>>>>>>>    Procedure Construct_Object
23916>>>>>>>>>>>>>        Integer iIndex
23916>>>>>>>>>>>>>        
23916>>>>>>>>>>>>>        Forward Send Construct_Object
23918>>>>>>>>>>>>>        
23918>>>>>>>>>>>>>        //  Reserve index in global stores
23918>>>>>>>>>>>>>        Move (SizeOfArray(gaSyncProps)) to iIndex
23919>>>>>>>>>>>>>        Move (ResizeArray(gaSyncProps, iIndex + 1)) to gaSyncProps
23920>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps, iIndex + 1)) to gaSyncChangedProps
23921>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles, iIndex + 1)) to gaSyncObjectHandles
23922>>>>>>>>>>>>>        Move (ResizeArray(gaAdvSyncProps, iIndex + 1)) to gaAdvSyncProps
23923>>>>>>>>>>>>>        Property Integer piStoreIndex iIndex
23924>>>>>>>>>>>>>        
23924>>>>>>>>>>>>>        Property Boolean pbErrorObjNotFound True
23925>>>>>>>>>>>>>        
23925>>>>>>>>>>>>>        // Sync Props Arrays - Allocation Optimization Properties
23925>>>>>>>>>>>>>        // In order to optimize web properties we allocate in advance empty array 
23925>>>>>>>>>>>>>        // slots in gaSyncProps, gaSyncChangedProps and gaSyncObjectHandles.
23925>>>>>>>>>>>>>        
23925>>>>>>>>>>>>>        // piSize: This is a pointer to the last object in the gaSyncObjectHandles, gaSyncProps
23925>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. When this value equals the size of the arrays then more space
23925>>>>>>>>>>>>>        // is allocated in these arrays.
23925>>>>>>>>>>>>>        Property Integer piSize 0
23926>>>>>>>>>>>>>        
23926>>>>>>>>>>>>>        // piCapacity: This is the actual size of the gaSyncObjectHandles, gaSyncProps and gaSyncChangedProps
23926>>>>>>>>>>>>>        // arrays. When piObjectCount equals this value, more space is allocated in these arrays.
23926>>>>>>>>>>>>>        Property Integer piCapacity 0
23927>>>>>>>>>>>>>        
23927>>>>>>>>>>>>>        // piGrowthFactor: This is the size of the next jump in size of the gaSyncObjectHandles, gaSyncProps
23927>>>>>>>>>>>>>        // and gaSyncChangedProps arrays. This value is used to double the size increase each time more space
23927>>>>>>>>>>>>>        // is allocated in the arrays.
23927>>>>>>>>>>>>>        Property Integer piGrowthFactor 0
23928>>>>>>>>>>>>>        
23928>>>>>>>>>>>>>        // pbActive: When False, all calls to get or set a web property are ignored.
23928>>>>>>>>>>>>>        // This ensures that web properties are only accessed during an AJAX call.
23928>>>>>>>>>>>>>        // Otherwise, attempting to access web properties outside an AJAX call can 
23928>>>>>>>>>>>>>        // corrupt the web properties system.
23928>>>>>>>>>>>>>        Property Boolean pbActive False
23929>>>>>>>>>>>>>        
23929>>>>>>>>>>>>>        Property Handle phoWebControlLocator 0
23930>>>>>>>>>>>>>        Property Handle phoWebHost C_WebUnresolvedObject
23931>>>>>>>>>>>>>    End_Procedure
23932>>>>>>>>>>>>>    
23932>>>>>>>>>>>>>    
23932>>>>>>>>>>>>>    //
23932>>>>>>>>>>>>>    // Adds the passed object to the global web properties arrays. It is assumed that the object is a cWebObject.
23932>>>>>>>>>>>>>    //
23932>>>>>>>>>>>>>    // Returns:
23932>>>>>>>>>>>>>    //      The object's index to the global sync props array.
23932>>>>>>>>>>>>>    Function AddObjectToSyncProps Handle hoObject Returns Integer
23934>>>>>>>>>>>>>        String sObjectName
23934>>>>>>>>>>>>>        Integer iStoreIndex iSize iCapacity iGrowthFactor iObjectIndex
23934>>>>>>>>>>>>>        
23934>>>>>>>>>>>>>        Move -1 to iObjectIndex
23935>>>>>>>>>>>>>        
23935>>>>>>>>>>>>>        If (hoObject > 0) Begin
23937>>>>>>>>>>>>>            Get piStoreIndex to iStoreIndex
23938>>>>>>>>>>>>>            Get piSize to iSize
23939>>>>>>>>>>>>>            Get piCapacity to iCapacity
23940>>>>>>>>>>>>>            Get piGrowthFactor to iGrowthFactor
23941>>>>>>>>>>>>>            Get WebObjectName of hoObject to sObjectName
23942>>>>>>>>>>>>>            
23942>>>>>>>>>>>>>            // Determine if we need to increase the array sizes....
23942>>>>>>>>>>>>>            If (iSize = iCapacity) Begin
23944>>>>>>>>>>>>>                Move (iGrowthFactor + iGrowthFactor) to iGrowthFactor    // double the growth factor
23945>>>>>>>>>>>>>                Move (iCapacity + iGrowthFactor) to iCapacity            // increase the capacity
23946>>>>>>>>>>>>>    
23946>>>>>>>>>>>>>                Set piCapacity to iCapacity
23947>>>>>>>>>>>>>                Set piGrowthFactor to iGrowthFactor
23948>>>>>>>>>>>>>                
23948>>>>>>>>>>>>>                Move (ResizeArray(gaSyncProps[iStoreIndex], iCapacity)) to gaSyncProps[iStoreIndex]
23949>>>>>>>>>>>>>                Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]
23950>>>>>>>>>>>>>                Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]
23951>>>>>>>>>>>>>            End
23951>>>>>>>>>>>>>>
23951>>>>>>>>>>>>>            
23951>>>>>>>>>>>>>            // Add the passed object to gaSyncObjectHandles....
23951>>>>>>>>>>>>>            Set piSize       to (iSize + 1)
23952>>>>>>>>>>>>>            Move iSize       to iObjectIndex
23953>>>>>>>>>>>>>            Move hoObject    to gaSyncObjectHandles[iStoreIndex][iObjectIndex]
23954>>>>>>>>>>>>>            Move False       to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges    // False so far because we did not find the property yet
23955>>>>>>>>>>>>>            Move sObjectName to gaSyncProps[iStoreIndex][iObjectIndex].sO
23956>>>>>>>>>>>>>        End
23956>>>>>>>>>>>>>>
23956>>>>>>>>>>>>>        
23956>>>>>>>>>>>>>        Function_Return iObjectIndex
23957>>>>>>>>>>>>>    End_Function
23958>>>>>>>>>>>>>    
23958>>>>>>>>>>>>>    //
23958>>>>>>>>>>>>>    // Returns the value for non-scalar (advanced) web properties. These are stored separate from
23958>>>>>>>>>>>>>    // the scalar web properties. It looks for the 'synchronized' value in the gaAdvSyncProps store.
23958>>>>>>>>>>>>>    //
23958>>>>>>>>>>>>>    // Params:
23958>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
23958>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
23958>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
23958>>>>>>>>>>>>>    // Returns:
23958>>>>>>>>>>>>>    //      The property value as a variant.
23958>>>>>>>>>>>>>    //
23958>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
23958>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
23958>>>>>>>>>>>>>    // to be "out of scope".
23958>>>>>>>>>>>>>    Function GetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
23960>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
23960>>>>>>>>>>>>>        String sUC_PropName sReturnValue
23960>>>>>>>>>>>>>        Variant vReturnValue
23960>>>>>>>>>>>>>        Boolean bFoundProp bIsAjaxWebObject bIsObjectInScope
23960>>>>>>>>>>>>>            
23960>>>>>>>>>>>>>        // Test if we are active....
23960>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
23962>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
23962>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
23962>>>>>>>>>>>>>            // clients have loaded the webapp....
23962>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to vReturnValue
23963>>>>>>>>>>>>>            Function_Return vReturnValue
23964>>>>>>>>>>>>>        End
23964>>>>>>>>>>>>>>
23964>>>>>>>>>>>>>        
23964>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
23965>>>>>>>>>>>>>    
23965>>>>>>>>>>>>>        Get FindAdvPropCache hoObject pubProp.sName to iProp
23966>>>>>>>>>>>>>        If (iProp = -1) Begin
23968>>>>>>>>>>>>>            //  Use the raw property
23968>>>>>>>>>>>>>            Get pubprop.hmGetter of hoObject to vReturnValue
23969>>>>>>>>>>>>>        End
23969>>>>>>>>>>>>>>
23969>>>>>>>>>>>>>        Else Begin
23970>>>>>>>>>>>>>            If (not(gaAdvSyncProps[iStoreIndex][iProp].bDeserialized)) Begin
23972>>>>>>>>>>>>>                //  Initialize our variant with an advanced value of the right type to make valuetreedeserialize work (!IMPORTANT)
23972>>>>>>>>>>>>>                Get pubProp.hmGetter of hoObject to vReturnValue
23973>>>>>>>>>>>>>                ValueTreeDeserializeParameter gaAdvSyncProps[iStoreIndex][iProp].tSyncProp.tV to vReturnValue
23974>>>>>>>>>>>>>                
23974>>>>>>>>>>>>>                Move vReturnValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
23975>>>>>>>>>>>>>                Move True to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
23976>>>>>>>>>>>>>            End
23976>>>>>>>>>>>>>>
23976>>>>>>>>>>>>>            Else Begin
23977>>>>>>>>>>>>>                Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV to vReturnValue
23978>>>>>>>>>>>>>            End
23978>>>>>>>>>>>>>>
23978>>>>>>>>>>>>>        End
23978>>>>>>>>>>>>>>
23978>>>>>>>>>>>>>        Function_Return vReturnValue
23979>>>>>>>>>>>>>    End_Function
23980>>>>>>>>>>>>>    
23980>>>>>>>>>>>>>    
23980>>>>>>>>>>>>>    //
23980>>>>>>>>>>>>>    // Returns the value for scalar web properties. It looks for a synchronized value in the
23980>>>>>>>>>>>>>    // global gaSycnProps store.
23980>>>>>>>>>>>>>    //
23980>>>>>>>>>>>>>    // Params:
23980>>>>>>>>>>>>>    //      hoObject  - Is handle to the object which ownes the property.
23980>>>>>>>>>>>>>    //      hmGetter  - Is a handle to the property's getter message.
23980>>>>>>>>>>>>>    //      sPropName - Is the (case sensitive) property name.
23980>>>>>>>>>>>>>    // Returns:
23980>>>>>>>>>>>>>    //      The property value as a variant.
23980>>>>>>>>>>>>>    //
23980>>>>>>>>>>>>>    // Use the WebGet command instead of sending this message directly. hoObject must belong to the
23980>>>>>>>>>>>>>    // set of 'scoped views' in the CallAction otherwise the web property value is considered
23980>>>>>>>>>>>>>    // to be "out of scope".
23980>>>>>>>>>>>>>    Function GetScalarSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns String
23982>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSize iStoreIndex
23982>>>>>>>>>>>>>        String sUC_PropName sReturnValue
23982>>>>>>>>>>>>>        Boolean bFoundProp bIsObjectInScope
23982>>>>>>>>>>>>>            
23982>>>>>>>>>>>>>        // Test if we are active....
23982>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
23984>>>>>>>>>>>>>            // If not active then we just return the design time value of the property. This is
23984>>>>>>>>>>>>>            // safe because we can only get here when the WebApp is being initialized, before any
23984>>>>>>>>>>>>>            // clients have loaded the webapp....
23984>>>>>>>>>>>>>            Get pubProp.hmGetter of hoObject to sReturnValue
23985>>>>>>>>>>>>>            Function_Return sReturnValue
23986>>>>>>>>>>>>>        End
23986>>>>>>>>>>>>>>
23986>>>>>>>>>>>>>        
23986>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
23987>>>>>>>>>>>>>        
23987>>>>>>>>>>>>>        // get the sync props index for the passed object handle...
23987>>>>>>>>>>>>>        Move (Uppercase(pubProp.sName)) to sUC_PropName
23988>>>>>>>>>>>>>        Get piSize to iSize
23989>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
23989>>>>>>>>>>>>>        Get FindObjectIndex hoObject to iObjectIndex
23990>>>>>>>>>>>>>        
23990>>>>>>>>>>>>>        If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
23992>>>>>>>>>>>>>            // If iObjectIndex = -1 it means that this object does not currently have any web properties.
23992>>>>>>>>>>>>>            // It might also mean that this object is out of scope during this CallAction. An object is only in-scope
23992>>>>>>>>>>>>>            // if it is a global object cWebApp or its child objects, or the object is part of the stack of views\
23992>>>>>>>>>>>>>            // dialog that are passed in the cWebObject's paDDOViews property.
23992>>>>>>>>>>>>>            Get IsObjectInCallActionScope hoObject to bIsObjectInScope
23993>>>>>>>>>>>>>            
23993>>>>>>>>>>>>>            If (bIsObjectInScope) Begin
23995>>>>>>>>>>>>>                //  Use the raw property
23995>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
23996>>>>>>>>>>>>>            End
23996>>>>>>>>>>>>>>
23996>>>>>>>>>>>>>            Else Begin
23997>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppObjectOutOfScope, If(hoObject > 0, Name(hoObject), ""), "WebGet " + pubProp.sName, C_NewLine))
23998>>>>>>>>>>>>>>
23998>>>>>>>>>>>>>            End
23998>>>>>>>>>>>>>>
23998>>>>>>>>>>>>>        End
23998>>>>>>>>>>>>>>
23998>>>>>>>>>>>>>        Else Begin
23999>>>>>>>>>>>>>            // Search for the property name....
23999>>>>>>>>>>>>>            Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
24000>>>>>>>>>>>>>            Move False to bFoundProp
24001>>>>>>>>>>>>>            
24001>>>>>>>>>>>>>            For iProp from 0 to (icProp - 1)
24007>>>>>>>>>>>>>>
24007>>>>>>>>>>>>>                If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
24009>>>>>>>>>>>>>                    Move gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sV to sReturnValue
24010>>>>>>>>>>>>>                    
24010>>>>>>>>>>>>>                    // Send Hook for converting the value from format for transport.
24010>>>>>>>>>>>>>                    Get ConvertFromTransport of hoObject pubProp.hmGetter sReturnValue pubProp.eType to sReturnValue
24011>>>>>>>>>>>>>
24011>>>>>>>>>>>>>                    Move True to bFoundProp
24012>>>>>>>>>>>>>                End
24012>>>>>>>>>>>>>>
24012>>>>>>>>>>>>>                If (bFoundProp) ;                    Break
24015>>>>>>>>>>>>>            Loop
24016>>>>>>>>>>>>>>
24016>>>>>>>>>>>>>            
24016>>>>>>>>>>>>>            If (not(bFoundProp)) Begin
24018>>>>>>>>>>>>>                //  Use the raw property
24018>>>>>>>>>>>>>                Get pubprop.hmGetter of hoObject to sReturnValue
24019>>>>>>>>>>>>>            End
24019>>>>>>>>>>>>>>
24019>>>>>>>>>>>>>        End
24019>>>>>>>>>>>>>>
24019>>>>>>>>>>>>>        
24019>>>>>>>>>>>>>        Function_Return sReturnValue
24020>>>>>>>>>>>>>    End_Function
