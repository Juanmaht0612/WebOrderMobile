25453>>>>>>>>>>>>>>>
25453>>>>>>>>>>>>>>>        Property Boolean pbAutoTab False              // Automatically tab to the next control when the maxlenght is reached
25456>>>>>>>>>>>>>>>
25456>>>>>>>>>>>>>>>        Property String psInputMode ""                // Hints the browser as to what virtual keyboard should be used ("none", "text", "decimal", "numeric", "tel", "search", "email")
25459>>>>>>>>>>>>>>>                                                      // If empty it will automatically be set to "decimal" or "numeric" for numeric fields
