1872>>>>>>>    TimeSpan tsVar2
1872>>>>>>>    Integer iCrnt iOverflow
1872>>>>>>>    
1872>>>>>>>    If (not(IsTimeSpanValid(tsVar))) Begin
1874>>>>>>>        Error DFERR_INVALID_TimeSpan
1875>>>>>>>>
1875>>>>>>>        Function_Return tsVar2
1876>>>>>>>    End
1876>>>>>>>>
1876>>>>>>>    
1876>>>>>>>    Move (DateGetMilliSecond(tsVar)) to iCrnt
1877>>>>>>>    Move (iCrnt + iAdd) to iAdd
1878>>>>>>>    Move (ModAlt(iAdd,1000)) to iCrnt
1879>>>>>>>    Move (DateSetMilliSecond(tsVar,iCrnt)) to tsVar2
1880>>>>>>>    Move (iAdd/1000 + If(iAdd<0 and iCrnt<>0,-1,0)) to iOverflow
1881>>>>>>>    If (iOverflow) Begin
1883>>>>>>>        Move (SpanAddSecond(tsVar2,iOverflow)) to tsVar2
1884>>>>>>>    End
1884>>>>>>>>
1884>>>>>>>    
1884>>>>>>>    If (not(IsTimeSpanValid(tsVar2))) Begin
1886>>>>>>>        Error DFERR_INVALID_DATETIME
1887>>>>>>>>
1887>>>>>>>        Function_Return 0
1888>>>>>>>    End
1888>>>>>>>>
1888>>>>>>>    Function_Return tsVar2
1889>>>>>>>End_Function
1890>>>>>>>
1890>>>>>>>
1890>>>>>>>// Various Week of Year functions
1890>>>>>>>
1890>>>>>>>// Get day of week where weeks starts on iWeekDayStart
1890>>>>>>>//
1890>>>>>>>Function DateGetDayofWeek_WDS Global DateTime dValue Integer iWeekDayStart Returns Integer
1892>>>>>>>    Function_Return (Mod(DateGetDayOfWeek(dValue)-1 - (iWeekDayStart-1) + 7,7) + 1)
1893>>>>>>>End_Function
1894>>>>>>>
1894>>>>>>>// Simple Week of year where first day of week is passed and first week
1894>>>>>>>// is the week containing Jan 1.
1894>>>>>>>// pass what first day of week as 1=Sun, 2=Mon, etc.
1894>>>>>>>//
1894>>>>>>>Function DateGetWeekOfYear_WDS Global DateTime dValue Integer iWeekDayStart Returns Integer
1896>>>>>>>    Integer iDayWk iDays iWks
1896>>>>>>>    DateTime dtFirst
1896>>>>>>>    
1896>>>>>>>    If (IsNullDateTime(dValue) or not(IsDateValid(dValue))) Begin
1898>>>>>>>        Error DFERR_INVALID_DATETIME
1899>>>>>>>>
1899>>>>>>>        Function_Return 0
1900>>>>>>>    End
1900>>>>>>>>
1900>>>>>>>    
1900>>>>>>>    Move dValue to dtFirst
1901>>>>>>>    Move (DateSetDay(dtFirst,1)) to dtFirst
1902>>>>>>>    Move (DateSetMonth(dtFirst,1)) to dtFirst
1903>>>>>>>    // 0-6 where 0 = iWeekDateStart
1903>>>>>>>    Move (DateGetDayOfWeek_WDS(dtFirst,iWeekDayStart)-1) to iDayWk
1904>>>>>>>    Move (DateGetDayOfYear(dValue)) to iDays
1905>>>>>>>    Move ((iDays-1 + iDayWk)/7 + 1) to iWks
1906>>>>>>>    
1906>>>>>>>    Function_Return iWks
1907>>>>>>>End_Function
1908>>>>>>>
1908>>>>>>>// Simple Week of year where first day of week is Sunday and first week
1908>>>>>>>// is the week containing Jan 1.
1908>>>>>>>//
1908>>>>>>>Function DateGetWeekOfYear Global DateTime dValue Returns Integer
1910>>>>>>>    Function_Return (DateGetWeekOfYear_WDS(dValue,1))
1911>>>>>>>End_Function
1912>>>>>>>
1912>>>>>>>// Get day of week where weeks starts on Monday (ISO standard)
1912>>>>>>>//
1912>>>>>>>Function DateGetDayofWeekISO Global DateTime dValue Returns Integer
1914>>>>>>>    Function_Return (DateGetDayofWeek_WDS(dValue,2))
1915>>>>>>>End_Function
1916>>>>>>>
1916>>>>>>>// Return Year of Week for ISO week year
1916>>>>>>>//
1916>>>>>>>Function DateGetYearOfWeekISO Global DateTime dValue Returns Integer
1918>>>>>>>    // Create a new date object for the thursday of this week
1918>>>>>>>    Move (Date(dValue) - Mod(DateGetDayOfWeek(dValue) -1 + 6, 7)+ 3) to dValue
1919>>>>>>>    Function_Return (DateGetYear(dValue))
1920>>>>>>>End_Function
1921>>>>>>>
1921>>>>>>>// return Week of year according to ISO standards where
1921>>>>>>>// Monday is the first Day of a week and the first week of the year is the
1921>>>>>>>// week that has a Thursday (or, restated, has four of more days in the week).
1921>>>>>>>//
1921>>>>>>>Function DateGetWeekOfYearISO Global DateTime dValue Returns Integer
1923>>>>>>>    Integer iDayWk dayNr iWks
1923>>>>>>>    DateTime dtFirst target
1923>>>>>>>    DateTime firstThursday
1923>>>>>>>    Integer iDy iDiff
1923>>>>>>>    
1923>>>>>>>    If (IsNullDateTime(dValue) or not(IsDateValid(dValue))) Begin
1925>>>>>>>        Error DFERR_INVALID_DATETIME
1926>>>>>>>>
1926>>>>>>>        Function_Return 0
1927>>>>>>>    End
1927>>>>>>>>
1927>>>>>>>    
1927>>>>>>>    Move dValue to target
1928>>>>>>>    // ISO week date weeks start on monday
1928>>>>>>>    // so correct the day number
1928>>>>>>>    Move (DateGetDayOfWeek_WDS(dValue,2)-1) to dayNr
1929>>>>>>>    
1929>>>>>>>    // ISO 8601 states that week 1 is the week
1929>>>>>>>    // with the first thursday of that year.
1929>>>>>>>    // Set the target date to the thursday in the target week
1929>>>>>>>    Move (Date(dValue) - dayNr +3) to target
1930>>>>>>>    Move ((target)) to firstThursday
1931>>>>>>>    
1931>>>>>>>    // Set the target to the first thursday of the year
1931>>>>>>>    // First set the target to january first
1931>>>>>>>    Move (DateSetMonth(target,1)) to target
1932>>>>>>>    Move (DateSetDay(target,1)) to target
1933>>>>>>>    // Not a thursday? Correct the date to the next thursday
1933>>>>>>>    Move (DateGetDayOfWeek(target)-1) to iDy
1934>>>>>>>    If (iDy<> 4) Begin
1936>>>>>>>        Move (DateSetDay(target,mod(4 - iDy + 7,7)+1)) to target
1937>>>>>>>    End
1937>>>>>>>>
1937>>>>>>>    
1937>>>>>>>    // The weeknumber is the number of weeks between the
1937>>>>>>>    // first thursday of the year and the thursday in the target week
1937>>>>>>>    Move (Date(firstThursday) - Date(target)) to iDiff
1938>>>>>>>    Move (iDiff / 7 + 1) to iWks
1939>>>>>>>    
1939>>>>>>>    If (iDiff/7.0<>iDiff/7) ;        Increment iWks
1942>>>>>>>    
1942>>>>>>>    Function_Return iWks
1943>>>>>>>End_Function
