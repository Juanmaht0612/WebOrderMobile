33349>>>>>>>    Procedure OnHttpRequest String sVerb String sPath String sContentType String sAcceptType DWord iSize
33351>>>>>>>        Case Begin
33351>>>>>>>            Case (sVerb = "GET")
33353>>>>>>>                Send OnHttpGet sPath sAcceptType
33354>>>>>>>                Break
33355>>>>>>>            Case (sVerb = "POST")
33358>>>>>>>                Send OnHttpPost sPath sContentType sAcceptType iSize
33359>>>>>>>                Break
33360>>>>>>>            Case (sVerb = "PUT")
33363>>>>>>>                Send OnHttpPut sPath sContentType iSize
33364>>>>>>>                Break
33365>>>>>>>            Case (sVerb = "PATCH")
33368>>>>>>>                Send OnHttpPatch sPath sContentType iSize
33369>>>>>>>                Break
33370>>>>>>>            Case (sVerb = "DELETE")
33373>>>>>>>                Send OnHttpDelete sPath
33374>>>>>>>                Break
33375>>>>>>>        Case End
