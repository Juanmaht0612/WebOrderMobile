23445>>>>>>>    // Sent when a SyncDDos fails - which happens during a request resync process. 
23445>>>>>>>    // By default call standard OnRefindRecordError. This allows for customization
23445>>>>>>>    // This mainly exists for debugging purposes. There is not much you can do here because
23445>>>>>>>    // this is happening at a very low level. If you change this, be careful.
23445>>>>>>>    Procedure OnSyncDDOsRefindError Handle hoDD
23447>>>>>>>        Send OnRefindRecordError hoDD reoSyncDDOs retUndefined
23448>>>>>>>    End_Procedure
23449>>>>>>>
23449>>>>>>>    // Sent when a refind record fails during one of the refind records operation 
23449>>>>>>>    // By default it does nothing, but it can raise an error and allows for careful customization
23449>>>>>>>    //
23449>>>>>>>    // hoDDO is the DDO that had the refind failure.
23449>>>>>>>    // This failed because RowId record cannot be refound or the RowId record is not 
23449>>>>>>>    // constraint valid.
23449>>>>>>>    //
23449>>>>>>>    // eOperation tells you what operation caused this:
23449>>>>>>>    // 0 - reoUndefined: should not get called with this
23449>>>>>>>    // 1 - reoSyncDDOs: During a request resync 
23449>>>>>>>    // 2 - reoNavigateForward: After resync during a NavigateForward
23449>>>>>>>    // 3 - reoNavigateBack: After resync during a NavigateBack 
23449>>>>>>>    // 4 - reoRefreshRecord: during RefreshRecord.
23449>>>>>>>    //
23449>>>>>>>    // eReason tells you the type of record find failure. 
23449>>>>>>>    // These only apply to NavigateForward|Back
23449>>>>>>>    // 0 - retUndefined
23449>>>>>>>    // 1 - retCannotRereadMain: Failed rereading the main file
23449>>>>>>>    // 2 - retCannotRereadConstrainingParent: Failed rereading a constraining parent
23449>>>>>>>    // 
23449>>>>>>>    // If you place a breakpoint here, you've got a place where all refind errors
23449>>>>>>>    // are redirected - very useful for debugging.
23449>>>>>>>
23449>>>>>>>    Procedure OnRefindRecordError Handle hoDD Integer eOperation Integer eReason
23451>>>>>>>        Boolean bShowAllRefindErrors
23451>>>>>>>        
23451>>>>>>>        // pbShowAllRefindErrors is cWebApp property, set it true when debugging to see all
23451>>>>>>>        // errors. This assumes that a refind error during debugging is probably a programming bug.
23451>>>>>>>        
23451>>>>>>>        Get pbShowAllRefindErrors to bShowAllRefindErrors
23452>>>>>>>        If bShowAllRefindErrors Begin
23454>>>>>>>             Send CannotRefindRecordUnhandledError hoDD
23455>>>>>>>        End
23455>>>>>>>>
23455>>>>>>>    End_Procedure
23456>>>>>>>
23456>>>>>>>    // Sent when RefreshRecord fails. 
23456>>>>>>>    // By default call standard OnRefindRecordError. This allows for customization
23456>>>>>>>    Procedure OnRefreshRecordError Handle hoDD
23458>>>>>>>        Send OnRefindRecordError hoDD reoRefreshRecord retUndefined
23459>>>>>>>    End_Procedure
23460>>>>>>>End_Class
