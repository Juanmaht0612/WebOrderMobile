769>>>>>>>>>        
769>>>>>>>>>        Move -1 to iImage // assume inability to add
770>>>>>>>>>        
770>>>>>>>>>        Move (LoadImage(GetModuleHandleW(0), sImage, IMAGE_BITMAP, 0, 0, 0)) to hBitmap
771>>>>>>>>>        If (hBitmap =0) Begin // the bitmap was not in the EXE resource
773>>>>>>>>>            Get_File_Path sImage to sImage // find path in DFPATH, if appropriate
774>>>>>>>>>            If (sImage <>"") Begin // The image was found!
776>>>>>>>>>                Move (LoadImage(0, sImage, IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE)) to hBitmap
