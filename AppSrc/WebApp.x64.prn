6453>>>>>>>    Procedure Define_Tab_dialog_Mixin
6455>>>>>>>        
6455>>>>>>>        Set auto_top_item_state to 0 // don't change - keeps tab buttons
6456>>>>>>>        // from resetting to 0 each time they
6456>>>>>>>        // activated
6456>>>>>>>        
6456>>>>>>>        Property Integer Default_Tab 0 // tab to start/return to. -1 means no default
6457>>>>>>>        
6457>>>>>>>        // How to handle keyboard navigation
6457>>>>>>>        // SBM_NEVER  = don't skip tab in kbd navigation
6457>>>>>>>        // SBM_ALWAYS = skip tab in kbd navigation.
6457>>>>>>>        // SBM_SMART  = Use windows logic. If not on a tab and the page is
6457>>>>>>>        //              changed go to page else goto tab
6457>>>>>>>        //
6457>>>>>>>        Property Integer Skip_Button_Mode  SBM_Smart
6458>>>>>>>        
6458>>>>>>>        // If Skip_Button is NOT smart this determines if mouse navigation
6458>>>>>>>        // always give the tab the focus or never gives it the focus. If
6458>>>>>>>        // smart, use same logic as above
6458>>>>>>>        Property Integer Pointer_Only_State False
6459>>>>>>>        
6459>>>>>>>        // tab pages use this as their default rotate mode
6459>>>>>>>        Property Integer Rotate_Mode RM_None
6460>>>>>>>        
6460>>>>>>>        Property Integer In_Tab_Change_State False
6461>>>>>>>        
6461>>>>>>>        // setting this to true will make your tab pages work like they did in VDF6. When a page
6461>>>>>>>        // is hidden, it will be removed from the focus tree. Only do this if you need to to get
6461>>>>>>>        // an old app working properly.
6461>>>>>>>        Property Integer pbDeactivatePages False
6462>>>>>>>        
6462>>>>>>>        // this is used by tab pages to determine sizes for anchoring. It is used in conjunction
6462>>>>>>>        // with piLastClientSize in the tab page
6462>>>>>>>        Property Integer piOriginalClientSize -1
6463>>>>>>>        
6463>>>>>>>        // If entering via next navigation should we move to the Default_Tab tab page
6463>>>>>>>        Property Integer pbResetPageOnActivate False
6464>>>>>>>        
6464>>>>>>>        Property Integer Private.MultiLine_State  False
6465>>>>>>>        
6465>>>>>>>        Property Integer Private.TabWidth_Mode    twRaggedRight
6466>>>>>>>        
6466>>>>>>>        Property Integer private_peTabPosition    tpTop
6467>>>>>>>        
6467>>>>>>>        Property Integer private_peTabStyle       tsTabs
6468>>>>>>>        
6468>>>>>>>        Property Integer private_pbFlatSeparators False
6469>>>>>>>        
6469>>>>>>>        Property Integer pbHotTrack               True // design-time only
6470>>>>>>>        Property Handle phoImageList              // should be set to a cImageList instance to display images on tab-page labels. Design-time only
6471>>>>>>>        
6471>>>>>>>        //    Property integer Current_Tab -1
6471>>>>>>>        On_Key KLeftArrow Send  request_Previous_Tab PRIVATE
6472>>>>>>>        On_Key KRightArrow Send request_next_tab     PRIVATE
6473>>>>>>>        
6473>>>>>>>        On_Key Key_Ctrl+Key_TAB Send Request_Next_Tab
6474>>>>>>>        
