23073>>>>>>>        // append multiple DDO structures to the set of DDO structures that are synchronized at the client.
23073>>>>>>>        // Note: you do not need to add the View's Main_DD to this array. Its DDO structure is automatically
23073>>>>>>>        // added to the synchronized list.
23073>>>>>>>        Property Handle[] paAdditionalDDOStructures
23074>>>>>>>        
23074>>>>>>>        Property tWebDDODef ptDDOStates
