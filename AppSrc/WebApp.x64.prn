24049>>>>>>>>>>>>>    
24049>>>>>>>>>>>>>    //
24049>>>>>>>>>>>>>    // Stores the passed web properties array and sets up the object to work with
24049>>>>>>>>>>>>>    // this data.
24049>>>>>>>>>>>>>    //
24049>>>>>>>>>>>>>    // Params:
24049>>>>>>>>>>>>>    //      aSyncProps   - Is the set of web properties from the client
24049>>>>>>>>>>>>>    //
24049>>>>>>>>>>>>>    Procedure InitializeSyncProps tWebSyncProps[] aSyncProps
24051>>>>>>>>>>>>>        Integer iObj iProp iSize iCapacity iGrowthFactor iStoreIndex
24051>>>>>>>>>>>>>        Handle hoObject hoControlLocator
24051>>>>>>>>>>>>>        Handle[] aChildObjects
24052>>>>>>>>>>>>>        
24052>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
24053>>>>>>>>>>>>>        Get phoWebControlLocator to hoControlLocator
24054>>>>>>>>>>>>>        
24054>>>>>>>>>>>>>        // Set up the array size management properties....
24054>>>>>>>>>>>>>        Move (SizeOfArray(aSyncProps)) to iSize
24055>>>>>>>>>>>>>        Move 100                       to iGrowthFactor    // This is the initial growth factor of the arrays. It doubles each time the array is resized.
24056>>>>>>>>>>>>>        Move (iSize max iGrowthFactor) to iCapacity
24057>>>>>>>>>>>>>        
24057>>>>>>>>>>>>>        Set piSize to iSize
24058>>>>>>>>>>>>>        Set piGrowthFactor to iGrowthFactor
24059>>>>>>>>>>>>>        Set piCapacity to iCapacity
24060>>>>>>>>>>>>>        
24060>>>>>>>>>>>>>        // Preallocate space for sync properties (plus some growth)....
24060>>>>>>>>>>>>>        Move (ResizeArray(aSyncProps, iCapacity)) to aSyncProps
24061>>>>>>>>>>>>>        Move (ResizeArray(gaSyncObjectHandles[iStoreIndex], iCapacity)) to gaSyncObjectHandles[iStoreIndex]     // We do not clear the array first. That is because we will just overwrite the old values.
24062>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], 0)) to gaSyncChangedProps[iStoreIndex]               // This global array must be cleared first! We cannot guarantee that the old values will be fully overwritten.
24063>>>>>>>>>>>>>        Move (ResizeArray(gaSyncChangedProps[iStoreIndex], iCapacity)) to gaSyncChangedProps[iStoreIndex]       // now size it to the correct value
24064>>>>>>>>>>>>>        
24064>>>>>>>>>>>>>        // Iterate each member and find the object reference.....
24064>>>>>>>>>>>>>        For iObj from 0 to (iSize - 1)
24070>>>>>>>>>>>>>>
24070>>>>>>>>>>>>>            Get FindWebObject of hoControlLocator aSyncProps[iObj].sO to hoObject
24071>>>>>>>>>>>>>            
24071>>>>>>>>>>>>>            If (hoObject = C_WebUnresolvedObject) Begin
24073>>>>>>>>>>>>>                If (pbErrorObjNotFound(Self)) Begin
24075>>>>>>>>>>>>>                    Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, aSyncProps[iObj].sO))
24076>>>>>>>>>>>>>>
24076>>>>>>>>>>>>>                End
24076>>>>>>>>>>>>>>
24076>>>>>>>>>>>>>            End
24076>>>>>>>>>>>>>>
24076>>>>>>>>>>>>>            Else Begin
24077>>>>>>>>>>>>>//                Set piSyncObjectIndex of hoObject to iObj    // Cache the object's index in the object itself
24077>>>>>>>>>>>>>            End
24077>>>>>>>>>>>>>>
24077>>>>>>>>>>>>>            
24077>>>>>>>>>>>>>            // Populate the shadow structs....
24077>>>>>>>>>>>>>            Move hoObject to gaSyncObjectHandles[iStoreIndex][iObj]
24078>>>>>>>>>>>>>            Move False to gaSyncChangedProps[iStoreIndex][iObj].bContainsChanges
24079>>>>>>>>>>>>>        Loop
24080>>>>>>>>>>>>>>
24080>>>>>>>>>>>>>
24080>>>>>>>>>>>>>        // Store the web property data....
24080>>>>>>>>>>>>>        Move aSyncProps to gaSyncProps[iStoreIndex]
24081>>>>>>>>>>>>>    End_Procedure
24082>>>>>>>>>>>>>    
24082>>>>>>>>>>>>>    
24082>>>>>>>>>>>>>    //
24082>>>>>>>>>>>>>    // Sets the addressed web property to the passed value. (see also GetScalarSyncProp)
24082>>>>>>>>>>>>>    //
24082>>>>>>>>>>>>>    // Params:
24082>>>>>>>>>>>>>    //      hoObject   - Is handle to the object which owns the property.
24082>>>>>>>>>>>>>    //      hmGetter   - Is a handle to the property's getter message.
24082>>>>>>>>>>>>>    //      sPropName  - Is the (case sensitive) property name.
24082>>>>>>>>>>>>>    //      sPropValue - Is the property value.
24082>>>>>>>>>>>>>    //
24082>>>>>>>>>>>>>    // Use the WebSet command instead of sending this message.
24082>>>>>>>>>>>>>    //
24082>>>>>>>>>>>>>    Procedure SetSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Variant vPropValue
24084>>>>>>>>>>>>>        Integer iObjectIndex icProp iProp iSyncPropIndex iStoreIndex
24084>>>>>>>>>>>>>        Integer icObject iIndex iCount iSize
24084>>>>>>>>>>>>>        Boolean bFoundSyncProp bSaveProp bIsAjaxWebObject
24084>>>>>>>>>>>>>        String sUC_PropName sObject sPropValue
24084>>>>>>>>>>>>>        tWebValueTree tVT
24084>>>>>>>>>>>>>        tWebValueTree tVT
24084>>>>>>>>>>>>>        Variant vTest
24084>>>>>>>>>>>>>        
24084>>>>>>>>>>>>>        // Test if we are active....
24084>>>>>>>>>>>>>        Get Object_Label of hoObject to sObject
24085>>>>>>>>>>>>>
24085>>>>>>>>>>>>>        If (not(pbActive(Self))) Begin
24087>>>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppSynPropsNotReady, sObject, "WebSet " + pubProp.sName))
24088>>>>>>>>>>>>>>
24088>>>>>>>>>>>>>            Procedure_Return
24089>>>>>>>>>>>>>        End
24089>>>>>>>>>>>>>>
24089>>>>>>>>>>>>>
24089>>>>>>>>>>>>>
24089>>>>>>>>>>>>>        // Try to find the the sync prop in the published props array...
24089>>>>>>>>>>>>>        Get piStoreIndex to iStoreIndex
24090>>>>>>>>>>>>>        
24090>>>>>>>>>>>>>        //  Determine if advanced (struct / array) property
24090>>>>>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
24092>>>>>>>>>>>>>            //  Find advanced sync prop in the cache
24092>>>>>>>>>>>>>            Get FindAdvPropCache hoObject pubProp.sName to iProp
24093>>>>>>>>>>>>>            //  If not found then add it to the cache
24093>>>>>>>>>>>>>            If (iProp = -1) Begin
24095>>>>>>>>>>>>>                // Add the property....
24095>>>>>>>>>>>>>                Get AddToAdvPropCache hoObject pubProp.sName to iProp
24096>>>>>>>>>>>>>            End
24096>>>>>>>>>>>>>>
24096>>>>>>>>>>>>>            
24096>>>>>>>>>>>>>            //  Store the value and mark as changed
24096>>>>>>>>>>>>>            Move vPropValue to gaAdvSyncProps[iStoreIndex][iProp].tSvrProp.vV
24097>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bDeserialized
24098>>>>>>>>>>>>>            Move True       to gaAdvSyncProps[iStoreIndex][iProp].bChanged
24099>>>>>>>>>>>>>        End
24099>>>>>>>>>>>>>>
24099>>>>>>>>>>>>>        Else Begin
24100>>>>>>>>>>>>>            // get the sync props index for the passed object handle...
24100>>>>>>>>>>>>>            Move (Uppercase(pubProp.sName)) to sUC_PropName
24101>>>>>>>>>>>>>            Move False to bSaveProp
24102>>>>>>>>>>>>>            Get piSize to iSize
24103>>>>>>>>>>>>>//            Get piSyncObjectIndex of hoObject to iObjectIndex
24103>>>>>>>>>>>>>            Get FindObjectIndex hoObject to iObjectIndex
24104>>>>>>>>>>>>>            
24104>>>>>>>>>>>>>            If (iObjectIndex = -1 or iObjectIndex >= iSize) Begin
24106>>>>>>>>>>>>>                Get AddObjectToSyncProps hoObject to iObjectIndex
24107>>>>>>>>>>>>>            End
24107>>>>>>>>>>>>>>
24107>>>>>>>>>>>>>            
24107>>>>>>>>>>>>>            // Test iObjectIndex again as it might have changed (above)....
24107>>>>>>>>>>>>>            If (iObjectIndex <> -1) Begin
24109>>>>>>>>>>>>>                // Send Hook for converting the value to format for transport.
24109>>>>>>>>>>>>>                Get ConvertToTransport of hoObject pubProp.hmGetter vPropValue pubProp.eType  to sPropValue
24110>>>>>>>>>>>>>                
24110>>>>>>>>>>>>>                // Search for the property name....
24110>>>>>>>>>>>>>                Move (SizeOfArray(gaSyncProps[iStoreIndex][iObjectIndex].aP)) to icProp
24111>>>>>>>>>>>>>                Move False to bFoundSyncProp
24112>>>>>>>>>>>>>                
24112>>>>>>>>>>>>>                For iProp from 0 to (icProp - 1)
24118>>>>>>>>>>>>>>
24118>>>>>>>>>>>>>                    If (Uppercase(gaSyncProps[iStoreIndex][iObjectIndex].aP[iProp].sN) = sUC_PropName) Begin
24120>>>>>>>>>>>>>                        Move iProp to iSyncPropIndex
24121>>>>>>>>>>>>>                        Move True to bFoundSyncProp
24122>>>>>>>>>>>>>                    End
24122>>>>>>>>>>>>>>
24122>>>>>>>>>>>>>                    If (bFoundSyncProp) ;                        Break
24125>>>>>>>>>>>>>                Loop
24126>>>>>>>>>>>>>>
24126>>>>>>>>>>>>>                
24126>>>>>>>>>>>>>                If (bFoundSyncProp) Begin
24128>>>>>>>>>>>>>                    // Case 1: Object and Property found in gaSyncProps
24128>>>>>>>>>>>>>                    // Update the found property....
24128>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[iSyncPropIndex].sV
24129>>>>>>>>>>>>>                    Move True to bSaveProp
24130>>>>>>>>>>>>>                End
24130>>>>>>>>>>>>>>
24130>>>>>>>>>>>>>                Else Begin
24131>>>>>>>>>>>>>                    // Case 2: The Property needs to be added to sync props array
24131>>>>>>>>>>>>>                    // Add the property....
24131>>>>>>>>>>>>>                    Move pubProp.sName to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sN    // Use the original case of the property name
24132>>>>>>>>>>>>>                    Move sPropValue to gaSyncProps[iStoreIndex][iObjectIndex].aP[icProp].sV
24133>>>>>>>>>>>>>                    Move icProp to iSyncPropIndex
24134>>>>>>>>>>>>>                    Move True to bSaveProp
24135>>>>>>>>>>>>>                End
24135>>>>>>>>>>>>>>
24135>>>>>>>>>>>>>                
24135>>>>>>>>>>>>>                If (bSaveProp) Begin
24137>>>>>>>>>>>>>                    // Update the changed props array....
24137>>>>>>>>>>>>>                    Move True to gaSyncChangedProps[iStoreIndex][iObjectIndex].bContainsChanges     // Mark the object as changed
24138>>>>>>>>>>>>>                    Move (SearchArray(iSyncPropIndex, gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iIndex
24139>>>>>>>>>>>>>                    
24139>>>>>>>>>>>>>                    If (iIndex = -1) Begin
24141>>>>>>>>>>>>>                        // Add the property name to the changed props array....
24141>>>>>>>>>>>>>                        Move (SizeOfArray(gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex)) to iCount
24142>>>>>>>>>>>>>                        Move iSyncPropIndex to gaSyncChangedProps[iStoreIndex][iObjectIndex].aiIndex[iCount]
24143>>>>>>>>>>>>>                    End
24143>>>>>>>>>>>>>>
24143>>>>>>>>>>>>>                End
24143>>>>>>>>>>>>>>
24143>>>>>>>>>>>>>            End
24143>>>>>>>>>>>>>>
24143>>>>>>>>>>>>>            Else Begin
24144>>>>>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$WebAppTargetObjectNotFound, (sObject + " (WebSet " + pubProp.sName+")") ))
24145>>>>>>>>>>>>>>
24145>>>>>>>>>>>>>            End
24145>>>>>>>>>>>>>>
24145>>>>>>>>>>>>>        End
24145>>>>>>>>>>>>>>
24145>>>>>>>>>>>>>        
24145>>>>>>>>>>>>>    End_Procedure
