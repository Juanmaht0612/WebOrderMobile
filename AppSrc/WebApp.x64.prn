14454>>>>>>>>>>>
14454>>>>>>>>>>>    // This procedure should be used to set a specific error number and
14454>>>>>>>>>>>    // message for a particular field. This can be used with the Field_error
14454>>>>>>>>>>>    // message to generate this error during a validation.
14454>>>>>>>>>>>    Procedure Set Field_Error Integer iField Integer iErr String sMsg
14456>>>>>>>>>>>        Set Field_Error of (Field_Attributes(Self)) iField to iErr sMsg
14457>>>>>>>>>>>    End_Procedure
14458>>>>>>>>>>>
14458>>>>>>>>>>>    // Used to retreive the error number and message for a particular field
14458>>>>>>>>>>>    Function Field_Error_Number Integer iField Returns Integer
14460>>>>>>>>>>>        Function_Return (Field_Error_Number(Field_Attributes(Self),iField))
14461>>>>>>>>>>>    End_Function
14462>>>>>>>>>>>
14462>>>>>>>>>>>    Function Field_Error_Message Integer iField Returns String
14464>>>>>>>>>>>        Function_Return (Field_Error_Message(Field_Attributes(Self),iField))
14465>>>>>>>>>>>    End_Function
14466>>>>>>>>>>>
14466>>>>>>>>>>>    // This procedure is used to declare an error on a standard field
14466>>>>>>>>>>>    // validation violation like Range or Check.
14466>>>>>>>>>>>    // Can pass 1 to 4 params:
14466>>>>>>>>>>>    // iField -                  Standard usage. Generates field as defined
14466>>>>>>>>>>>    //                           for this field. If field=-1, General error
14466>>>>>>>>>>>    // iField SDefault           If no field error mess (or field=-1) use
14466>>>>>>>>>>>    //                           the default message
14466>>>>>>>>>>>    // iField sDefault sParam1 {sParam2} Replace occurances of @PARAM1 and
14466>>>>>>>>>>>    //                           @PARAM2 in text with these values
14466>>>>>>>>>>>    Procedure Field_Error Integer iField String sDefault ;            String sParam1 String sParam2
14468>>>>>>>>>>>        Integer iErr
14468>>>>>>>>>>>        String  sMess
14468>>>>>>>>>>>        If (iField >= 0) Begin
14470>>>>>>>>>>>            Get Field_Error_Number  iField to iErr
14471>>>>>>>>>>>            Get Field_Error_Message iField to sMess
14472>>>>>>>>>>>        End
14472>>>>>>>>>>>>
14472>>>>>>>>>>>        If (sMess="" and Num_Arguments>1) ;            Move sDefault to sMess
14475>>>>>>>>>>>        If (Num_Arguments = 4) ;            Send Data_Set_Error iField iErr sMess sParam1 sParam2
14478>>>>>>>>>>>        Else If (Num_Arguments = 3) ;            Send Data_Set_Error iField iErr sMess sParam1
14482>>>>>>>>>>>        Else ;            Send Data_Set_Error iField iErr sMess
14484>>>>>>>>>>>    End_Procedure
14485>>>>>>>>>>>
14485>>>>>>>>>>>    // Procedure Data_Set_Error
14485>>>>>>>>>>>    // This procedure is used to declare a data-set error. Pass error number
14485>>>>>>>>>>>    // and optional error message text.
14485>>>>>>>>>>>    // If iErr is 0, use the default error number.
14485>>>>>>>>>>>    // sParam1 and sParam2 are optional. If passed they are used as text
14485>>>>>>>>>>>    // replacements for @PARAM1 and @PARAM2.
14485>>>>>>>>>>>    // We pass iField (even though we don't use it) so that augmentations
14485>>>>>>>>>>>    // could support error logging down to a field level. If a non-field error
14485>>>>>>>>>>>    // is required the developer should pass negative values (e.g., -1)
14485>>>>>>>>>>>    // This will redirect errors locally if not already redirected
14485>>>>>>>>>>>    //
14485>>>>>>>>>>>    // Altered to additionally support %1 %2 replacements as well as
14485>>>>>>>>>>>    // replacements for @PARAM1 and @PARAM2. (vdf8.2)
14485>>>>>>>>>>>    Procedure Data_set_error Integer iField Integer iErr String sMess ;            String sParam1 String sParam2
14487>>>>>>>>>>>        Integer iOldField
14487>>>>>>>>>>>        Get Current_validate_field to iOldField
14488>>>>>>>>>>>        If (iField <> 0) ;            Set Current_Validate_field to iField
14491>>>>>>>>>>>
14491>>>>>>>>>>>        If (iErr = 0) ; // if no error is passes, used a default error            Move DD_DEFAULT_ERROR_NUMBER to iErr
14494>>>>>>>>>>>
14494>>>>>>>>>>>        If (sMess > "") Begin
14496>>>>>>>>>>>
14496>>>>>>>>>>>            // Support message replacements.. Up to two values
14496>>>>>>>>>>>            // altered to support @Param1/2 and %1 %2 messages
14496>>>>>>>>>>>            If (Num_Arguments>3) Begin
14498>>>>>>>>>>>                Move (Replaces("@PARAM1", sMess, sParam1)) to sMess
14499>>>>>>>>>>>                If (Num_Arguments>4) Begin
14501>>>>>>>>>>>                    Move (Replaces("@PARAM2", sMess, sParam2)) to sMess
14502>>>>>>>>>>>                    Move (SFormat(sMess,sParam1,sParam2)) to sMess
14503>>>>>>>>>>>                End
14503>>>>>>>>>>>>
14503>>>>>>>>>>>                Else Begin
14504>>>>>>>>>>>                    Move (SFormat(sMess,sParam1)) to sMess
14505>>>>>>>>>>>                End
14505>>>>>>>>>>>>
14505>>>>>>>>>>>            End
14505>>>>>>>>>>>>
14505>>>>>>>>>>>            Move Self to ghoErrorSource
14506>>>>>>>>>>>            Error iErr sMess
14507>>>>>>>>>>>>
14507>>>>>>>>>>>            Move 0 to ghoErrorSource
14508>>>>>>>>>>>        End
14508>>>>>>>>>>>>
14508>>>>>>>>>>>        Else ;            Send Operation_Not_Allowed iErr
14510>>>>>>>>>>>        Set Current_validate_field to iOldField
14511>>>>>>>>>>>        Move True to Err // make sure Err is still set
14512>>>>>>>>>>>    End_Procedure
14513>>>>>>>>>>>
14513>>>>>>>>>>>    // Augment to support Error_Report_Mode. Allows errors without error mess
14513>>>>>>>>>>>    // This will redirect errors locally if not already redirected
14513>>>>>>>>>>>    Procedure Operation_Not_Allowed Integer iErr
14515>>>>>>>>>>>        Integer bOK
14515>>>>>>>>>>>        Move Self to ghoErrorSource
14516>>>>>>>>>>>        Forward Send Operation_Not_Allowed iErr
14518>>>>>>>>>>>        Move 0 to ghoErrorSource
14519>>>>>>>>>>>    End_Procedure
14520>>>>>>>>>>>
14520>>>>>>>>>>>    // Local error handler. When errors are redirected to the DD this proce-
14520>>>>>>>>>>>    // dure handles the errors. If error_report_mode is NO-report it sets
14520>>>>>>>>>>>    // the err indicator and returns. Else it redirects the error to the
14520>>>>>>>>>>>    // main error handler first moving its ID to ghoErrorSource. This way the
14520>>>>>>>>>>>    // handler knows who sent this message and will get additional error info
14520>>>>>>>>>>>    // by calling Get Extended_error_message
14520>>>>>>>>>>>    Procedure Error_Report Integer iError Integer iLine String ErrMsg
14522>>>>>>>>>>>        Integer hoErrId
14522>>>>>>>>>>>        Integer bRedirect
14522>>>>>>>>>>>        If (Error_Processing_State(Self)) ;  // this prevents recursion            Procedure_Return
14525>>>>>>>>>>>        Set Error_Processing_State to True
14526>>>>>>>>>>>
14526>>>>>>>>>>>        // if no report mode, just set the err indicator to true.
14526>>>>>>>>>>>        If (Error_Report_Mode(Self)=DD_ERROR_NO_REPORT) ;            Move True to Err
14529>>>>>>>>>>>        Else Begin
14530>>>>>>>>>>>            Get Old_error_object_id to hoErrId  // the original error handler
14531>>>>>>>>>>>            If hoErrId Begin
14533>>>>>>>>>>>                Move (ghoErrorSource=0) to bRedirect
14534>>>>>>>>>>>                If bRedirect ;                    Move Self to ghoErrorSource // error handler can use this
14537>>>>>>>>>>>                Move hoErrID to Error_object_id
14538>>>>>>>>>>>                Send Error_Report to hoErrId iError iLine ErrMsg
14539>>>>>>>>>>>                Move Self to Error_object_id
14540>>>>>>>>>>>                If bRedirect ;                    Move 0 to ghoErrorSource
14543>>>>>>>>>>>            End
14543>>>>>>>>>>>>
14543>>>>>>>>>>>            Else ;                Send error_report of desktop iError iLine ErrMsg
14545>>>>>>>>>>>            //else forward send error_report iError iLine ErrMsg
14545>>>>>>>>>>>        End
14545>>>>>>>>>>>>
14545>>>>>>>>>>>        Set Error_Processing_State to False
14546>>>>>>>>>>>    End_Procedure
14547>>>>>>>>>>>
14547>>>>>>>>>>>    // This is called (by the system error handler) to get additional informa-
14547>>>>>>>>>>>    // tion about the error. Returns a multi line string with each line
14547>>>>>>>>>>>    // separated by a "\n". Return the file number, name, and if possible
14547>>>>>>>>>>>    // the field number and name.
14547>>>>>>>>>>>    Function Extended_Error_Message Returns String
14549>>>>>>>>>>>        String sExtMess
14549>>>>>>>>>>>        String sFile
14549>>>>>>>>>>>        Integer iFile iField
14549>>>>>>>>>>>        Get main_file to iFile
14550>>>>>>>>>>>        Get Current_Validate_Field to iField
14551>>>>>>>>>>>        Get ErrorMessageTableName iFile to sFile
14552>>>>>>>>>>>        Move (DD_FILE_TEXT* String(iFile) * "-" * sFile) to sExtMess
14553>>>>>>>>>>>        If (iField > 0) ;            Append sExtMess "\n" ;            (DD_FIELD_TEXT* String(iField) * "-" * Field_Label(Self,iField,DD_LABEL_LONG))
14557>>>>>>>>>>>        Set Current_Validate_Field to 0
14558>>>>>>>>>>>        Function_Return sExtMess
14559>>>>>>>>>>>    End_Function
14560>>>>>>>>>>>
14560>>>>>>>>>>>    Function Extended_Error_File Returns Integer
14562>>>>>>>>>>>        Function_Return (Main_File(Self))
14563>>>>>>>>>>>    End_Function
14564>>>>>>>>>>>
14564>>>>>>>>>>>    Function Extended_Error_Field Returns Integer
14566>>>>>>>>>>>        Function_Return (Current_Validate_Field(Self))
14567>>>>>>>>>>>    End_Function
14568>>>>>>>>>>>
14568>>>>>>>>>>>
14568>>>>>>>>>>>    // The following messages are used to control smart file mode exception
14568>>>>>>>>>>>    // handling. The message "Send Add_system_File file# Fg" allows you to
14568>>>>>>>>>>>    // add system files (or any other files not known to the dso structure)
14568>>>>>>>>>>>    // within define_fields. This allows you to not have to augment the msg
14568>>>>>>>>>>>    // reset_filemodes_for_lock. The only truly public messages here are
14568>>>>>>>>>>>    // Add_system_file and Remove_system_File (which s/b rarely used).
14568>>>>>>>>>>>
14568>>>>>>>>>>>    // Adds a system file for smart_file_mode handling. A second optional
14568>>>>>>>>>>>    // parameter may be passed to determine of the sys file should only be
14568>>>>>>>>>>>    // locked during a new save (and not during a delete or a save of an
14568>>>>>>>>>>>    // existing record). It is expected that this will be the only public
14568>>>>>>>>>>>    // message used to control smart filemode. All of the remaining sys file
14568>>>>>>>>>>>    // messages are considered advanced.
14568>>>>>>>>>>>    Procedure Add_System_File Integer iFile Integer iLock_Mode
14570>>>>>>>>>>>        Integer iobj iCnt iMode
14570>>>>>>>>>>>        If (Num_arguments = 1) ;            Move DD_Lock_on_All to iMode
14573>>>>>>>>>>>        Else ;            Move iLock_Mode     to iMode
14575>>>>>>>>>>>        Move (system_file_obj(Self)) to iObj
14576>>>>>>>>>>>        Get Item_Count  of iObj to iCnt
14577>>>>>>>>>>>        Set Array_Value of iObj iCnt to iFile
14578>>>>>>>>>>>        Increment iCnt
14579>>>>>>>>>>>        Set Array_Value of iObj iCnt to iMode
14580>>>>>>>>>>>    End_Procedure
14581>>>>>>>>>>>
14581>>>>>>>>>>>    // Return number of system files
14581>>>>>>>>>>>    Function System_File_Count Returns Integer
14583>>>>>>>>>>>        Function_Return (Item_Count(System_File_Obj(Self))/2)
14584>>>>>>>>>>>    End_Function
14585>>>>>>>>>>>
14585>>>>>>>>>>>    // Returns system file number for passed item.
14585>>>>>>>>>>>    Function System_File_Number Integer iItem Returns Integer
14587>>>>>>>>>>>        Function_Return (Integer_Value(System_File_Obj(Self),iItem*2))
14588>>>>>>>>>>>    End_Function
14589>>>>>>>>>>>
14589>>>>>>>>>>>    // Returns system flag to determine if file is only used during a new
14589>>>>>>>>>>>    // save (and not during an exiting save or a delete).
14589>>>>>>>>>>>    Function System_File_Lock_Mode Integer iItem Returns Integer
14591>>>>>>>>>>>        Function_Return (Integer_Value(System_File_Obj(Self),iItem*2+1))
14592>>>>>>>>>>>    End_Function
14593>>>>>>>>>>>
14593>>>>>>>>>>>    // Removes a system_file for smart_file_Mode handling. This remvoes the
14593>>>>>>>>>>>    // first occurance of the file (S/b the only occurance). We assume that
14593>>>>>>>>>>>    // this will be rarely used.
14593>>>>>>>>>>>    Procedure Remove_System_File Integer iFile
14595>>>>>>>>>>>        Integer iobj iCnt iItmCnt
14595>>>>>>>>>>>        Get System_file_Count to iItmCnt
14596>>>>>>>>>>>        Decrement iItmCnt
14597>>>>>>>>>>>        For iCnt from 0 to iItmCnt
14603>>>>>>>>>>>>
14603>>>>>>>>>>>            If (System_File_Number(Self,iCnt)=iFile) Begin
14605>>>>>>>>>>>                Move (system_file_obj(Self)) to iObj
14606>>>>>>>>>>>                Move (iCnt*2) to iCnt
14607>>>>>>>>>>>                Send Delete_Item to iObj iCnt
14608>>>>>>>>>>>                Send Delete_Item to iObj iCnt
14609>>>>>>>>>>>                Procedure_Return
14610>>>>>>>>>>>            End
14610>>>>>>>>>>>>
14610>>>>>>>>>>>        Loop
14611>>>>>>>>>>>>
14611>>>>>>>>>>>    End_Procedure
14612>>>>>>>>>>>
14612>>>>>>>>>>>    // These set messages, add_client_file, add_server_file and add_system_file
14612>>>>>>>>>>>    // were added to more easily support visual DD class modeling. They do the
14612>>>>>>>>>>>    // same thing the Send counterpart messages do
14612>>>>>>>>>>>
14612>>>>>>>>>>>    Procedure Set Add_Client_File Integer iFile
14614>>>>>>>>>>>        Send Add_Client_File iFile
14615>>>>>>>>>>>    End_Procedure
14616>>>>>>>>>>>
14616>>>>>>>>>>>    Procedure Set Add_Server_File Integer iFile
14618>>>>>>>>>>>        Send Add_Server_File iFile
14619>>>>>>>>>>>    End_Procedure
14620>>>>>>>>>>>
14620>>>>>>>>>>>    Procedure Set Add_System_File Integer iFile Integer iLock_Mode
14622>>>>>>>>>>>        // allow no arguments because the old message allowed this
14622>>>>>>>>>>>        If (Num_arguments=1) Begin
14624>>>>>>>>>>>            Send Add_System_File iFile
14625>>>>>>>>>>>        End
14625>>>>>>>>>>>>
14625>>>>>>>>>>>        Else Begin
14626>>>>>>>>>>>            Send Add_System_File iFile iLock_Mode
14627>>>>>>>>>>>        End
14627>>>>>>>>>>>>
14627>>>>>>>>>>>    End_Procedure
14628>>>>>>>>>>>
14628>>>>>>>>>>>    // The Set Field_Auto_Increment method replaces the need to use the Define_Auto_Incrmement
14628>>>>>>>>>>>    // command. This models more easily and it supports multiple auto-increment fields
14628>>>>>>>>>>>    Procedure Set Field_Auto_Increment Integer iField Integer iSysFile Integer iSysField
14630>>>>>>>>>>>        Integer[] AutoIncFields
14631>>>>>>>>>>>        tDDFileField[] SysFileFields
14631>>>>>>>>>>>        tDDFileField[] SysFileFields
14632>>>>>>>>>>>        Integer iIndex
14632>>>>>>>>>>>
14632>>>>>>>>>>>        If (iField=0 or (iSysFile<>0 and iSysField=0)) Begin
14634>>>>>>>>>>>            Error DFERR_PROGRAM "Auto-increment source or destination field is 0"
14635>>>>>>>>>>>>
14635>>>>>>>>>>>            Procedure_Return
14636>>>>>>>>>>>        End
14636>>>>>>>>>>>>
14636>>>>>>>>>>>        // setting the sysfile to 0 is valid. It can be used to clear an existing sysfile
14636>>>>>>>>>>>        If (iSysFile=0) Begin
14638>>>>>>>>>>>            Move 0 to iSysField
14639>>>>>>>>>>>        End
14639>>>>>>>>>>>>
14639>>>>>>>>>>>        Get pAutoIncrementFields to AutoIncFields
14640>>>>>>>>>>>        Get pAutoIncrementSysFileFields to SysFileFields
14641>>>>>>>>>>>        // the destination field array is a list of fields that have auto-incr info. There
14641>>>>>>>>>>>        // can only be zero or one entry per field arranged in no defined order.
14641>>>>>>>>>>>        // see if field is already defined. If not add this to the end.
14641>>>>>>>>>>>        Move (SearchArray(iField,AutoIncFields)) to iIndex
14642>>>>>>>>>>>        If (iIndex=-1) Begin
14644>>>>>>>>>>>            Move (SizeOfArray(SysFileFields)) to iIndex
14645>>>>>>>>>>>        End
14645>>>>>>>>>>>>
14645>>>>>>>>>>>        Move iField    to AutoIncFields[iIndex]
14646>>>>>>>>>>>        Move iSysFile  to SysFileFields[iIndex].iFile
14647>>>>>>>>>>>        Move iSysField to SysFileFields[iIndex].iField
14648>>>>>>>>>>>        Set pAutoIncrementFields to AutoIncFields
14649>>>>>>>>>>>        Set pAutoIncrementSysFileFields to SysFileFields
14650>>>>>>>>>>>    End_Procedure
14651>>>>>>>>>>>
14651>>>>>>>>>>>    // Get auto-increment system file/field value for a field. There really should be no
14651>>>>>>>>>>>    // reason to ever need this. Field is returned byref
14651>>>>>>>>>>>    Function Field_Auto_Increment Integer iField Integer ByRef iSysField Returns Integer
14653>>>>>>>>>>>        Integer iSysFile
14653>>>>>>>>>>>        Integer[] AutoIncFields
14654>>>>>>>>>>>        tDDFileField[] SysFileFields
14654>>>>>>>>>>>        tDDFileField[] SysFileFields
14655>>>>>>>>>>>        Integer iIndex
14655>>>>>>>>>>>
14655>>>>>>>>>>>        Get pAutoIncrementFields to AutoIncFields
14656>>>>>>>>>>>        Move (SearchArray(iField,AutoIncFields)) to iIndex
14657>>>>>>>>>>>        If (iIndex>-1) Begin
14659>>>>>>>>>>>            Get pAutoIncrementSysFileFields to SysFileFields
14660>>>>>>>>>>>            Move SysFileFields[iIndex].iFile to iSysFile
14661>>>>>>>>>>>            Move SysFileFields[iIndex].iField to iSysField
14662>>>>>>>>>>>        End
14662>>>>>>>>>>>>
14662>>>>>>>>>>>        Else Begin
14663>>>>>>>>>>>            Move 0 to iSysFile
14664>>>>>>>>>>>            Move 0 to iSysField
14665>>>>>>>>>>>        End
14665>>>>>>>>>>>>
14665>>>>>>>>>>>        Function_Return iSysFile
14666>>>>>>>>>>>    End_Function
14667>>>>>>>>>>>
14667>>>>>>>>>>>
14667>>>>>>>>>>>    // Augmented to set any system files defined via the Add_System_file
14667>>>>>>>>>>>    // message. This allows us to hide this procedure for the vast majority
14667>>>>>>>>>>>    // of cases.
14667>>>>>>>>>>>    Procedure Reset_Filemodes_For_Lock
14669>>>>>>>>>>>        Boolean bNewRec
14669>>>>>>>>>>>        Integer  iItmCnt iCnt iMode iFile
14669>>>>>>>>>>>        Integer iMain iMaster iOpts
14669>>>>>>>>>>>        Handle hoDD
14669>>>>>>>>>>>
14669>>>>>>>>>>>        Forward Send Reset_Filemodes_for_lock
14671>>>>>>>>>>>
14671>>>>>>>>>>>        Get System_File_Count to iItmCnt
14672>>>>>>>>>>>        If iItmCnt Begin
14674>>>>>>>>>>>            Move (not(HasRecord(Self))) to bNewRec
14675>>>>>>>>>>>            Decrement iItmCnt
14676>>>>>>>>>>>            For iCnt from 0 to iItmCnt
14682>>>>>>>>>>>>
14682>>>>>>>>>>>                Get System_File_Number         iCnt to iFile
14683>>>>>>>>>>>                Get System_File_Lock_Mode iCnt to iMode
14684>>>>>>>>>>>                If ( (iMode=DD_Lock_on_All) or ;                    (Operation_Mode=MODE_DELETING and (iMode iand DD_Lock_on_Delete) ) or ;                    (Operation_Mode=MODE_SAVING and ( (iMode iand DD_Lock_on_Save) or ;                    ( (iMode iand DD_Lock_on_New_Save) and bNewRec) ) ) ) Begin
14686>>>>>>>>>>>                    Set_Attribute DF_FILE_MODE of iFile to DF_FILEMODE_DEFAULT
14689>>>>>>>>>>>                End
14689>>>>>>>>>>>>
14689>>>>>>>>>>>            Loop
14690>>>>>>>>>>>>
14690>>>>>>>>>>>        End
14690>>>>>>>>>>>>
14690>>>>>>>>>>>
14690>>>>>>>>>>>        // augment to support DD magnaged alias tables.
14690>>>>>>>>>>>        // If an alias, set the alias to the proper alias no locks only if
14690>>>>>>>>>>>        // the master file is actually part of this DDO structure. This allows you
14690>>>>>>>>>>>        // to use alias files without the master being present (or even open). This will work without needing
14690>>>>>>>>>>>        // to set the Master|Alias DF_FILE_ALIAS attributes. If the file is master and part of the DDO structure
14690>>>>>>>>>>>        // it will already have its No_locks attribute cleared. If not part of the DD, its not needed.
14690>>>>>>>>>>>        //
14690>>>>>>>>>>>        Get MasterForAlias to iMaster
14691>>>>>>>>>>>        If iMaster Begin
14693>>>>>>>>>>>            Get Main_File to iMain
14694>>>>>>>>>>>            Get Data_Set iMaster to hoDD // is the master in the DD structure
14695>>>>>>>>>>>            If hoDD Begin
14697>>>>>>>>>>>                Get_Attribute DF_FILE_MODE of iMain to iOpts
14700>>>>>>>>>>>                Set_Attribute DF_FILE_MODE of iMain to (iOpts ior DF_FILEMODE_NO_LOCKS)
14703>>>>>>>>>>>                // note this will be reset to what it was when the transaction ends
14703>>>>>>>>>>>            End
14703>>>>>>>>>>>>
14703>>>>>>>>>>>        End
14703>>>>>>>>>>>>
14703>>>>>>>>>>>
14703>>>>>>>>>>>    End_Procedure
14704>>>>>>>>>>>
14704>>>>>>>>>>>    // Augmented to handle auto-increment fields if defined. The value from
14704>>>>>>>>>>>    // the auto-incre sys file is incremented, saved and moved to the new
14704>>>>>>>>>>>    // record. As of 17.0 this is no longer in Creating, which is called after
14704>>>>>>>>>>>    // AutoIncrement.
14704>>>>>>>>>>>    Procedure AutoIncrement
14706>>>>>>>>>>>        Integer iSrcFile iSrcField i iAutoFields
14706>>>>>>>>>>>        Integer iDestFile iDestField
14706>>>>>>>>>>>        Number nNum
14706>>>>>>>>>>>        Integer[] AutoIncFields
14707>>>>>>>>>>>        tDDFileField[] AutoIncSysFileFields
14707>>>>>>>>>>>        tDDFileField[] AutoIncSysFileFields
14708>>>>>>>>>>>        Handle hoOwner
14708>>>>>>>>>>>
14708>>>>>>>>>>>        Forward Send AutoIncrement
14710>>>>>>>>>>>
14710>>>>>>>>>>>        // this supports the older Define_Auto_Increment logic. Only one is supported
14710>>>>>>>>>>>        // this is exists for backwards compatibility
14710>>>>>>>>>>>        Get Auto_Increment_Source_File to iSrcFile
14711>>>>>>>>>>>        If iSrcFile Begin // do we have auto increment?
14713>>>>>>>>>>>            Get Auto_Increment_Source_Field  to iSrcField
14714>>>>>>>>>>>            Get Auto_Increment_Dest_Field    to iDestField
14715>>>>>>>>>>>            If (iSrcField and iDestField) Begin  // just in case of error
14717>>>>>>>>>>>                Get Main_file to iDestFile
14718>>>>>>>>>>>                Get_Field_Value iSrcFile iSrcField to nNum
14721>>>>>>>>>>>                Move (nNum+1) to nNum
14722>>>>>>>>>>>                Set_Field_Value iSrcFile  iSrcField  to nNum
14725>>>>>>>>>>>                Set_Field_Value iDestFile iDestField to nNum
14728>>>>>>>>>>>                // if the file's DD is a parent file in the structure, this will get saved as part of normal operations
14728>>>>>>>>>>>                // if the DD is not a parent file, it is a sysfile and we must save it
14728>>>>>>>>>>>                Get Which_Data_Set iSrcFile to hoOwner
14729>>>>>>>>>>>                If not hoOwner Begin
14731>>>>>>>>>>>                    SaveRecord iSrcFile
14732>>>>>>>>>>>                End
14732>>>>>>>>>>>>
14732>>>>>>>>>>>            End
14732>>>>>>>>>>>>
14732>>>>>>>>>>>        End
14732>>>>>>>>>>>>
14732>>>>>>>>>>>        // this supports the newer set syntax which support multiple fields. It is expected that you will
14732>>>>>>>>>>>        // use one syntax of the other, not both. If you use the old syntax, you cannot use the new one
14732>>>>>>>>>>>        Else Begin
14733>>>>>>>>>>>            Get pAutoIncrementFields to AutoIncFields
14734>>>>>>>>>>>            Move (SizeOfArray(AutoIncFields)) to iAutoFields
14735>>>>>>>>>>>            If (iAutoFields>0) Begin
14737>>>>>>>>>>>                Get pAutoIncrementSysFileFields to AutoIncSysFileFields
14738>>>>>>>>>>>                Get Main_file to iDestFile
14739>>>>>>>>>>>                For i from 0 to (iAutoFields-1)
14745>>>>>>>>>>>>
14745>>>>>>>>>>>                    // it is legal to set the sysfile to 0, this means it has been cleared and is not used
14745>>>>>>>>>>>                    If (AutoIncSysFileFields[i].iFile>0) Begin
14747>>>>>>>>>>>                        // we assume both the fields are valid and that they've already been tested when added
14747>>>>>>>>>>>                        Get_Field_Value AutoIncSysFileFields[i].iFile AutoIncSysFileFields[i].iField to nNum
14750>>>>>>>>>>>                        Move (nNum+1) to nNum
14751>>>>>>>>>>>                        Set_Field_Value AutoIncSysFileFields[i].iFile AutoIncSysFileFields[i].iField to nNum
14754>>>>>>>>>>>                        Set_Field_Value iDestFile AutoIncFields[i] to nNum
14757>>>>>>>>>>>                        // if the file's DD is a parent file in the structure, this will get saved as part of normal operations
14757>>>>>>>>>>>                        // if the DD is not a parent file, it is a sysfile and we must save it
14757>>>>>>>>>>>                        Get Which_Data_Set AutoIncSysFileFields[i].iFile to hoOwner
14758>>>>>>>>>>>                        If not hoOwner Begin
14760>>>>>>>>>>>                            SaveRecord AutoIncSysFileFields[i].iFile
14761>>>>>>>>>>>                        End
14761>>>>>>>>>>>>
14761>>>>>>>>>>>                    End
14761>>>>>>>>>>>>
14761>>>>>>>>>>>                Loop
14762>>>>>>>>>>>>
14762>>>>>>>>>>>            End
14762>>>>>>>>>>>>
14762>>>>>>>>>>>        End
14762>>>>>>>>>>>>
14762>>>>>>>>>>>
14762>>>>>>>>>>>    End_Procedure
14763>>>>>>>>>>>
14763>>>>>>>>>>>    // Augmented to fix a bug in the data-set C code. When a record is saved
14763>>>>>>>>>>>    // as part of a delete operation OnNewCurrentRecord is not called. It
14763>>>>>>>>>>>    // should be. We will do this in flex code for now.
14763>>>>>>>>>>>    Procedure Save_Main_File
14765>>>>>>>>>>>        RowID riRec
14765>>>>>>>>>>>        Integer iRec iMain
14765>>>>>>>>>>>        Boolean bRecnumTable bChanged
14765>>>>>>>>>>>
14765>>>>>>>>>>>        Get Main_File to iMain
14766>>>>>>>>>>>        Get_Attribute DF_FILE_CHANGED of iMain to bChanged
14769>>>>>>>>>>>        If bChanged Begin
14771>>>>>>>>>>>            Send OnSaveRecord // OnSaveRecord sent if there is something to save
14772>>>>>>>>>>>        End
14772>>>>>>>>>>>>
14772>>>>>>>>>>>
14772>>>>>>>>>>>        Forward Send Save_Main_File
14774>>>>>>>>>>>
14774>>>>>>>>>>>        If (Operation_Mode = MODE_DELETING) Begin  // during a delete the crnt
14776>>>>>>>>>>>            Get CurrentRowId to riRec             // rec of parents do not change
14777>>>>>>>>>>>            Send OnNewCurrentRecord riRec riRec  // so old and new are the same.
14778>>>>>>>>>>>            // for backwards compatibility reasons, we also send new_current_record if appropriate
14778>>>>>>>>>>>            Get_Attribute DF_FILE_RECNUM_TABLE of iMain to bRecnumTable
14781>>>>>>>>>>>            If (bRecnumTable) Begin
14783>>>>>>>>>>>                Get_Field_Value iMain 0 to iRec
14786>>>>>>>>>>>                Send New_Current_Record iRec iRec
14787>>>>>>>>>>>            End
14787>>>>>>>>>>>>
14787>>>>>>>>>>>        End
14787>>>>>>>>>>>>
14787>>>>>>>>>>>    End_Procedure
14788>>>>>>>>>>>
14788>>>>>>>>>>>    // Augmented to not clear if a system-file. The auto-latching of views
14788>>>>>>>>>>>    // may cause a sys file DD to get cleared. This corrects this. This really
14788>>>>>>>>>>>    // belongs in Data_set (C) but we will not risk this for now.
14788>>>>>>>>>>>    Procedure Clear_Main_File
14790>>>>>>>>>>>        Integer iFile iIsSys
14790>>>>>>>>>>>        Get Main_File to iFile
14791>>>>>>>>>>>        If iFile Begin
14793>>>>>>>>>>>            Get_Attribute DF_FILE_IS_SYSTEM_FILE of iFile to iIsSys
14796>>>>>>>>>>>            If iIsSys ;                Procedure_Return
14799>>>>>>>>>>>        End
14799>>>>>>>>>>>>
14799>>>>>>>>>>>        Forward Send Clear_main_file
14801>>>>>>>>>>>    End_Procedure
14802>>>>>>>>>>>
14802>>>>>>>>>>>    // Executes a request_find on the mainfile. This is easier that having to
14802>>>>>>>>>>>    // pass file number all the time. Useful for batch operations.
14802>>>>>>>>>>>    // If Index is 0, use find_by_recnum (it handles a recnum of 0 better)
14802>>>>>>>>>>>    Procedure Find Integer iMode Integer iIndex
14804>>>>>>>>>>>        Integer iFile
14804>>>>>>>>>>>        Integer iRec
14804>>>>>>>>>>>        Get Main_file to iFile
14805>>>>>>>>>>>        If (iIndex<>0 or iMode<>EQ) ;            Send request_find iMode iFile iIndex
14808>>>>>>>>>>>        Else Begin
14809>>>>>>>>>>>            // this would never happen with row ID
14809>>>>>>>>>>>            Get_Field_Value iFile 0 to iRec // get recnum value
14812>>>>>>>>>>>            Send find_by_recnum iFile iRec
14813>>>>>>>>>>>        End
14813>>>>>>>>>>>>
14813>>>>>>>>>>>    End_Procedure
14814>>>>>>>>>>>
14814>>>>>>>>>>>    // So many people make the mistake of using requeset_clear and request_
14814>>>>>>>>>>>    // clear_all that will support these are alteratives to clear and
14814>>>>>>>>>>>    // clear_all. The preferred messages remain Clear and Clear_all.
14814>>>>>>>>>>>    // This would not work if you nested DEOs within DSOs (no-one does).
14814>>>>>>>>>>>    Procedure Request_Clear
14816>>>>>>>>>>>        Send Clear
14817>>>>>>>>>>>    End_Procedure
14818>>>>>>>>>>>
14818>>>>>>>>>>>    Procedure Request_Clear_All
14820>>>>>>>>>>>        Send Clear_All
14821>>>>>>>>>>>    End_Procedure
14822>>>>>>>>>>>
14822>>>>>>>>>>>    // we want changed_state to always go through the
14822>>>>>>>>>>>    // Record_buffer object. From there it is sent to
14822>>>>>>>>>>>    // here. So if state or RB does not match we must
14822>>>>>>>>>>>    // send to the RB object...it will delegate to here
14822>>>>>>>>>>>
14822>>>>>>>>>>>    Procedure Set Changed_State Integer bState
14824>>>>>>>>>>>        Integer hRB
14824>>>>>>>>>>>        Move (record_buffer(Self)) to hRB
14825>>>>>>>>>>>        If (hRB and changed_state(hRB)<>bState) ;            Set changed_state of hRB to bState
14828>>>>>>>>>>>        Else ;            Forward Set changed_state to bState
14831>>>>>>>>>>>    End_Procedure
14832>>>>>>>>>>>
14832>>>>>>>>>>>    // this lets us use the new attach logic
14832>>>>>>>>>>>
14832>>>>>>>>>>>    // This is a smarter attach than the normal attach command. It only attaches data from a parent
14832>>>>>>>>>>>    // if 1) the DDO parent is connected to the structure and 2) if there is a record to attach. It will
14832>>>>>>>>>>>    // not attach empty records into a child. This should make the finding (and saving) more sensible when
14832>>>>>>>>>>>    // partial DD structures are used. For example, often a report does not all of the parent DDOs - however if
14832>>>>>>>>>>>    // they are not provided, finding can get messed up because blank data is being moved into the child before a
14832>>>>>>>>>>>    // find. This has been a problem since 3.0. This should just make it go away.
14832>>>>>>>>>>>    // as of 17.0, we get the related field info through the local DSO if needed
14832>>>>>>>>>>>
14832>>>>>>>>>>>    // as if 18.1 this is only called when there is an attachable relationship. This gives us a chance to do any
14832>>>>>>>>>>>    // customizations and to cancel the attach. We've left this to the flex level so we can fine tune attaches.
14832>>>>>>>>>>>    Function ShouldFieldAttach Integer iField Handle hoRelDD Returns Boolean
14834>>>>>>>>>>>        Boolean bDoAttach bChanged
14834>>>>>>>>>>>        Integer iFile iStat iRelFile iType
14834>>>>>>>>>>>        String sValue
14834>>>>>>>>>>>
14834>>>>>>>>>>>        Get Main_File to iFile
14835>>>>>>>>>>>        Get Main_File of hoRelDD to iRelFile
14836>>>>>>>>>>>
14836>>>>>>>>>>>        // before we attach check if Find mode and relfile is new and unchanged..if so skip.
14836>>>>>>>>>>>        // If operation_mode is 0, this is probably a Find (item_find sends attach_main_file for some reason).
14836>>>>>>>>>>>        Move True to bDoAttach
14837>>>>>>>>>>>        If (Operation_mode=MODE_FINDING or OPERATION_MODE=0) Begin
14839>>>>>>>>>>>            // we can test the file status to see if we have a record or not. If we have a record, we attach
14839>>>>>>>>>>>            Get_Attribute DF_FILE_STATUS  of iRelFile to iStat
14842>>>>>>>>>>>            If (iStat=DF_FILE_INACTIVE) Begin
14844>>>>>>>>>>>                // if no record, we need to look for changes. We can't just look at the file's changed state because the DD
14844>>>>>>>>>>>                // may have set defaults, which have been moved to the buffer. We should be able to check the DD's changed state
14844>>>>>>>>>>>                // because this is not set with default values. When doing a find entry_update this should be ok. If this were
14844>>>>>>>>>>>                // a save, this would cause problems (but this is not a save). Prior to 17.0 this was not an issue with windows
14844>>>>>>>>>>>                // applications because find entry_updates were done at the DEO level (unlike web applications).
14844>>>>>>>>>>>                Get Changed_State of hoRelDD to bChanged
14845>>>>>>>>>>>                Move bChanged to bDoAttach
14846>>>>>>>>>>>
14846>>>>>>>>>>>                // special Triumph workaround for Item_Find with blank inner segment. They were counting on the item_find attach_main_file
14846>>>>>>>>>>>                // which would slip through the "no-attach on find when parent is empty optimization". This was needed to force a string segment
14846>>>>>>>>>>>                // that was "" to get filled with spaces from the parent field. The child field was set to "" because of a constrained_clear
14846>>>>>>>>>>>                // in Item_find. This workaround is as narrow as possible. If an item_find attach_main_file (operation_mode=0) and this is
14846>>>>>>>>>>>                // an empty parent (bOk was just set to False), and the field is DF_Ascii and the child value is empty (no trailing spaces)
14846>>>>>>>>>>>                // then force an attach. Since the parent should be "", we can just Set_Field_value to "", which fills the field buffer.
14846>>>>>>>>>>>                // There is no real logic as to why this is being done other than to make it work like it used to with the least
14846>>>>>>>>>>>                // amount of side-effects.
14846>>>>>>>>>>>                If (not(bDoAttach) and OPERATION_MODE=0) Begin
14848>>>>>>>>>>>                    Get_Attribute DF_FIELD_TYPE of iFile iField to iType
14851>>>>>>>>>>>                    If (iType=DF_ASCII) Begin
14853>>>>>>>>>>>                        Get_Field_Value iFile iField to sValue
14856>>>>>>>>>>>                        // if no spaces, this probably was cleared via constrained_clear in Item_Find. We should update
14856>>>>>>>>>>>                        If (Ascii(Left(sValue,1))=0) Begin
14858>>>>>>>>>>>                            Set_Field_Value iFile iField to ""
14861>>>>>>>>>>>                        End
14861>>>>>>>>>>>>
14861>>>>>>>>>>>                    End
14861>>>>>>>>>>>>
14861>>>>>>>>>>>                End
14861>>>>>>>>>>>>
14861>>>>>>>>>>>
14861>>>>>>>>>>>            End
14861>>>>>>>>>>>>
14861>>>>>>>>>>>        End
14861>>>>>>>>>>>>
14861>>>>>>>>>>>        Function_Return bDoAttach
14862>>>>>>>>>>>    End_Function
14863>>>>>>>>>>>
14863>>>>>>>>>>>    // Notify all DEOs that a mask has changed.
14863>>>>>>>>>>>    //        this message is sent by set Field_Mask
14863>>>>>>>>>>>    Procedure Field_Mask_Changed Integer iField String sMask
14865>>>>>>>>>>>        Integer i iDEOs iDEO
14865>>>>>>>>>>>        Integer iMain_File
14865>>>>>>>>>>>        Get Main_File to iMain_File
14866>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iDEOs
14867>>>>>>>>>>>        Decrement iDEOs
14868>>>>>>>>>>>        For i from 0 to iDEOs
14874>>>>>>>>>>>>
14874>>>>>>>>>>>            Get Data_Set_User_Interface i to iDEO
14875>>>>>>>>>>>            If (Extended_DEO_State(iDEO)) ;                Send File_Field_Mask_Changed to iDEO ;                iMain_File iField sMask
14878>>>>>>>>>>>        Loop
14879>>>>>>>>>>>>
14879>>>>>>>>>>>    End_Procedure
14880>>>>>>>>>>>
14880>>>>>>>>>>>    // Notify all DEOs that a label has changed.
14880>>>>>>>>>>>    //   This message is sent by Set Field_Label_long & Field_Label_Short
14880>>>>>>>>>>>    Procedure Field_label_Changed Integer iField Boolean bLong String sLabel
14882>>>>>>>>>>>        Integer i iDEOs iDEO
14882>>>>>>>>>>>        Integer iMain_File
14882>>>>>>>>>>>        Get Main_File to iMain_File
14883>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iDEOs
14884>>>>>>>>>>>        Decrement iDEOs
14885>>>>>>>>>>>        For i from 0 to iDEOs
14891>>>>>>>>>>>>
14891>>>>>>>>>>>            Get Data_Set_User_Interface i to iDEO
14892>>>>>>>>>>>            If (Extended_DEO_State(iDEO)) ;                Send File_Field_Label_Changed to iDEO ;                iMain_File iField bLong sLabel
14895>>>>>>>>>>>        Loop
14896>>>>>>>>>>>>
14896>>>>>>>>>>>    End_Procedure
14897>>>>>>>>>>>
14897>>>>>>>>>>>    // Notify all DEOs that a field option has changed.
14897>>>>>>>>>>>    //   This message is sent by Set Field_Option
14897>>>>>>>>>>>    Procedure Field_Option_Changed Integer iField Integer iOptions Boolean bClear
14899>>>>>>>>>>>        Integer i iDEOs iDEO
14899>>>>>>>>>>>        Integer iMain_File
14899>>>>>>>>>>>        Get Main_File to iMain_File
14900>>>>>>>>>>>        Get Data_Set_User_Interface_Count to iDEOs
14901>>>>>>>>>>>        Decrement iDEOs
14902>>>>>>>>>>>        For i from 0 to iDEOs
14908>>>>>>>>>>>>
14908>>>>>>>>>>>            Get Data_Set_User_Interface i to iDEO
14909>>>>>>>>>>>            If (Extended_DEO_State(iDEO)) ;                Send File_Field_Option_Changed of iDEO ;                iMain_File iField iOptions bClear
14912>>>>>>>>>>>        Loop
14913>>>>>>>>>>>>
14913>>>>>>>>>>>    End_Procedure
14914>>>>>>>>>>>
14914>>>>>>>>>>>
14914>>>>>>>>>>>    //   Set, clear or toggle a field option
14914>>>>>>>>>>>    //   Multiple options can be passed as an expression
14914>>>>>>>>>>>    //   (e.g. Set Field_option 2 (dd_Retain IOR dd_NoEnter).
14914>>>>>>>>>>>    //   Unlike set Field_options this notifies DEOs of changes
14914>>>>>>>>>>>    // supports setting and clearing. e.g.:
14914>>>>>>>>>>>    //    Set Field_Option Field Customer.Name DD_NoEnter to True
14914>>>>>>>>>>>    // This new syntax is now the recommended syntax but the older syntax without
14914>>>>>>>>>>>    // the last parameter is supported (where true is the default). The old syntax is
14914>>>>>>>>>>>    // only supported for compatibility. This means that Field_Option_Clear should
14914>>>>>>>>>>>    // also be replaced with Field_Option
14914>>>>>>>>>>>    Procedure Set Field_Option Integer iField Integer iOption Boolean bSet
14916>>>>>>>>>>>        Boolean bSetTrue
14916>>>>>>>>>>>        Move (If(num_arguments>2, bSet, True)) to bSetTrue // support for old deprecated syntax
14917>>>>>>>>>>>        If bSetTrue Begin
14919>>>>>>>>>>>            Set Field_options iField to iOption
14920>>>>>>>>>>>        End
14920>>>>>>>>>>>>
14920>>>>>>>>>>>        Else Begin
14921>>>>>>>>>>>            Set Field_options iField to DD_CLEAR_FIELD_OPTIONS iOption
14922>>>>>>>>>>>        End
14922>>>>>>>>>>>>
14922>>>>>>>>>>>        If (Data_Set_User_Interface_Count(Self)) Begin
14924>>>>>>>>>>>            Send Field_Option_Changed iField iOption (not(bSetTrue))
14925>>>>>>>>>>>        End
14925>>>>>>>>>>>>
14925>>>>>>>>>>>    End_Procedure
14926>>>>>>>>>>>
14926>>>>>>>>>>>    Procedure Set File_Field_Option Integer iFile Integer iField Integer iOption Boolean bSet
14928>>>>>>>>>>>        Handle hoDD
14928>>>>>>>>>>>        Boolean bSetTrue
14928>>>>>>>>>>>        Move (If(num_arguments>3, bSet, True)) to bSetTrue // support for old deprecated syntax
14929>>>>>>>>>>>        Get Data_set iFile to hoDD
14930>>>>>>>>>>>        If hoDD Begin
14932>>>>>>>>>>>            Set Field_Option of hoDD iField iOption to bSetTrue
14933>>>>>>>>>>>        End
14933>>>>>>>>>>>>
14933>>>>>>>>>>>
14933>>>>>>>>>>>    End_Procedure
14934>>>>>>>>>>>
14934>>>>>>>>>>>    Procedure Set Field_Option_Clear Integer iField Integer iOptions
14936>>>>>>>>>>>        Set Field_Option iField iOptions to False
14937>>>>>>>>>>>    End_Procedure
14938>>>>>>>>>>>
14938>>>>>>>>>>>    Procedure Set File_Field_Option_Clear Integer iFile Integer iField Integer iOptions
14940>>>>>>>>>>>        Set File_Field_Option iFile iField iOptions to False
14941>>>>>>>>>>>    End_Procedure
14942>>>>>>>>>>>
14942>>>>>>>>>>>    Procedure Set Field_Option_Toggle Integer iField Integer iOption
14944>>>>>>>>>>>        Integer iOldOption
14944>>>>>>>>>>>        Get Field_Options iField to iOldOption
14945>>>>>>>>>>>        // if old and new have overlapping bits, we assume clear
14945>>>>>>>>>>>        Set Field_Option iField iOption to ((iOldOption iand iOption)=0)
14946>>>>>>>>>>>    End_Procedure
14947>>>>>>>>>>>
14947>>>>>>>>>>>    Procedure Set File_Field_Option_Toggle Integer iFile Integer iField Integer iOption
14949>>>>>>>>>>>        Handle hoDD
14949>>>>>>>>>>>        Get Data_set iFile to hoDD
14950>>>>>>>>>>>        If hoDD ;            Set Field_Option_Toggle of hoDD iField to iOption
14953>>>>>>>>>>>    End_Procedure
14954>>>>>>>>>>>
14954>>>>>>>>>>>    // This returns the main index for a field. This replaces the DSO message Field_Main_index which
14954>>>>>>>>>>>    // should no longer be used by DDOs. The old message has the problem that the DDO or DSO using
14954>>>>>>>>>>>    // this message may not be the owner of the field. So augmenting the owner DDO did not insure that
14954>>>>>>>>>>>    // all requests for this index would go through it. Now you can augment Field_Index and always
14954>>>>>>>>>>>    // be sure that any DDO requesting an index for a file (via file_field_index) will always go to
14954>>>>>>>>>>>    // the owner object.
14954>>>>>>>>>>>    Function Field_Index Integer iField Returns Integer
14956>>>>>>>>>>>        Integer iFile iIndex iOrder
14956>>>>>>>>>>>        // ordering takes precendence
14956>>>>>>>>>>>        Get ordering to iOrder
14957>>>>>>>>>>>        If (iOrder>=0);            Move iOrder to iIndex  //ordering takes precedence over main index
14960>>>>>>>>>>>        Else Begin
14961>>>>>>>>>>>            Get Main_file to iFile
14962>>>>>>>>>>>            Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex // main index field
14965>>>>>>>>>>>            If (iIndex=0 and iField>0) ; // If field is not recnum and there is no index, the                Move -1 to iIndex        // field has no main index
14968>>>>>>>>>>>        End
14968>>>>>>>>>>>>
14968>>>>>>>>>>>        Function_Return iIndex
14969>>>>>>>>>>>    End_Function
14970>>>>>>>>>>>
14970>>>>>>>>>>>    // In all cases, this message should be sent instead of Field_Main_Index. If
14970>>>>>>>>>>>    // augmentation was used in Field_Main_Index, use Field_Index to insure the owner object
14970>>>>>>>>>>>    // is called.
14970>>>>>>>>>>>
14970>>>>>>>>>>>    Function File_Field_Index Integer iFile Integer iField Returns Integer
14972>>>>>>>>>>>        Integer iIndex
14972>>>>>>>>>>>        Handle hoDD
14972>>>>>>>>>>>        Get Data_set iFile to hoDD
14973>>>>>>>>>>>        If (hoDD) ;            Get Field_Index of hoDD iField to iIndex
14976>>>>>>>>>>>        Else ;            Move -1 to iIndex
14978>>>>>>>>>>>        Function_Return iIndex
14979>>>>>>>>>>>    End_Function
14980>>>>>>>>>>>
14980>>>>>>>>>>>    // 12/1 change: Make sure all of the major DD operations update the DD with the value in
14980>>>>>>>>>>>    // the focus field. After the actual find, save, clar or delete, the DD buffer contains information that
14980>>>>>>>>>>>    // is not yet reflected in the DEOs (before refresh is called) we want to make sure that we
14980>>>>>>>>>>>    // don't try to get data from the DEO. Get Field_Current_Value now checks if operation_mode is
14980>>>>>>>>>>>    // non-zero. If it is, it always gets from the DD buffer.
14980>>>>>>>>>>>
14980>>>>>>>>>>>    Procedure Clear
14982>>>>>>>>>>>        Boolean bOpOk
14982>>>>>>>>>>>        Move (OPERATION_MODE=MODE_WAITING or OPERATION_MODE=MODE_VALIDATING) to bOpOk
14983>>>>>>>>>>>        If (OPERATION_MODE=MODE_WAITING) Begin
14985>>>>>>>>>>>            Send Update_Focus_Field_For_Operation MODE_CLEARING
14986>>>>>>>>>>>        End
14986>>>>>>>>>>>>
14986>>>>>>>>>>>        If (bOpOk) Begin
14988>>>>>>>>>>>            Send OnPreFind DDFindClear
14989>>>>>>>>>>>        End
14989>>>>>>>>>>>>
14989>>>>>>>>>>>        Forward Send Clear
14991>>>>>>>>>>>        If (bOpOk) Begin
14993>>>>>>>>>>>            Send DefaultParentAutofinds
14994>>>>>>>>>>>            Send OnPostFind DDFindClear True
14995>>>>>>>>>>>        End
14995>>>>>>>>>>>>
14995>>>>>>>>>>>    End_Procedure
14996>>>>>>>>>>>
14996>>>>>>>>>>>    Procedure Clear_All
14998>>>>>>>>>>>        Boolean bOpOk
14998>>>>>>>>>>>        Move (OPERATION_MODE=MODE_WAITING or OPERATION_MODE=MODE_VALIDATING) to bOpOk
14999>>>>>>>>>>>        If (OPERATION_MODE=MODE_WAITING) Begin
15001>>>>>>>>>>>            Send Update_Focus_Field_For_Operation MODE_CLEARINGALL
15002>>>>>>>>>>>        End
15002>>>>>>>>>>>>
15002>>>>>>>>>>>        Forward Send clear_all
15004>>>>>>>>>>>        If (bOpOk) Begin
15006>>>>>>>>>>>            Send DefaultParentAutofinds
15007>>>>>>>>>>>        End
