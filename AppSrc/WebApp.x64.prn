35389>>>>>                Move (ResizeArray(props.aAdvProps, icProp)) to props.aAdvProps
35390>>>>>                For iProp from 0 to (icProp - 1)
35396>>>>>>
35396>>>>>                    Move gaAdvSyncProps[iStoreIndex][iProp].tSvrProp to props.aAdvProps[iProp]
35397>>>>>                Loop
35398>>>>>>
35398>>>>>                
35398>>>>>                Send DataTypeToJson of hoJsonParser props
35399>>>>>                Get StringifyUtf8 of hoJsonParser to ucPropData
35400>>>>>                
35400>>>>>                Send StorePropValues of (ServerPropStore(Self)) sKey (&ucPropData)
35401>>>>>            End
35401>>>>>>
35401>>>>>            Else Begin
