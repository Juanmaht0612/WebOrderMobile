28176>>>>>>>>>>>>>>>        End
28176>>>>>>>>>>>>>>>>
28176>>>>>>>>>>>>>>>        Else Begin
28177>>>>>>>>>>>>>>>            Move (Lowercase(sSearch)) to sLowSearch
28178>>>>>>>>>>>>>>>            Move False to bRetVal
28179>>>>>>>>>>>>>>>
28179>>>>>>>>>>>>>>>            For iCount from 0 to (SizeOfArray(aValues) - 1)
28185>>>>>>>>>>>>>>>>
28185>>>>>>>>>>>>>>>                Move aValues[iCount] to sValue
28186>>>>>>>>>>>>>>>                If ((bFullText and ((bCase and sValue contains sSearch) or ;                    (not(bCase) and Lowercase(sValue) contains sLowSearch))) or ;                    (not(bFullText) and ((bCase and Left(sValue, iLen) = sSearch) or ;                    (not(bCase) and Lowercase(Left(sValue, iLen)) = sLowSearch)))) Begin
28188>>>>>>>>>>>>>>>                    Move True to bRetVal
28189>>>>>>>>>>>>>>>                End
28189>>>>>>>>>>>>>>>>
28189>>>>>>>>>>>>>>>            Loop
28190>>>>>>>>>>>>>>>>
28190>>>>>>>>>>>>>>>        End
28190>>>>>>>>>>>>>>>>
28190>>>>>>>>>>>>>>>        
28190>>>>>>>>>>>>>>>        Function_Return bRetVal
28191>>>>>>>>>>>>>>>    End_Function
28192>>>>>>>>>>>>>>>    
28192>>>>>>>>>>>>>>>    Procedure FindIncremental tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
28194>>>>>>>>>>>>>>>        Integer iIndex iLen eType iLength iDec iFile iField iItemIndex
28194>>>>>>>>>>>>>>>        Boolean bCase bOldRelate bNeedsRelate bSuccess bBreak bAllData bSupportsFilters bOrigActive bFilterApplied bOk bScanAll
28194>>>>>>>>>>>>>>>        String sLowSearch sRowId sValue sOrigFilter
28194>>>>>>>>>>>>>>>        String[] aEntryValues
28195>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
28197>>>>>>>>>>>>>>>        RowID riTest
28197>>>>>>>>>>>>>>>        Handle hoServer
28197>>>>>>>>>>>>>>>        
28197>>>>>>>>>>>>>>>        Get Server to hoServer
28198>>>>>>>>>>>>>>>        Get Data_File to iFile
28199>>>>>>>>>>>>>>>        Get Data_Field to iField
28200>>>>>>>>>>>>>>>        Get pbAllData to bAllData
28201>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
28202>>>>>>>>>>>>>>>        
28202>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
28204>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
28205>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
28206>>>>>>>>>>>>>>>            
28206>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_TYPE of iFile iField to eType
28209>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_LENGTH of iFile iField to iLength
28212>>>>>>>>>>>>>>>            Get_Attribute DF_FIELD_PRECISION of iFile iField to iDec
28215>>>>>>>>>>>>>>>            
28215>>>>>>>>>>>>>>>            Move (iLength - iDec) to iLength
28216>>>>>>>>>>>>>>>            
28216>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
28221>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
28224>>>>>>>>>>>>>>>            
28224>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
28225>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
28226>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
28227>>>>>>>>>>>>>>>            
28227>>>>>>>>>>>>>>>            //  Determine current filter settings
28227>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
28228>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
28229>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
28230>>>>>>>>>>>>>>>            Move (SizeOfArray(iaFiles) > 1) to bScanAll
28231>>>>>>>>>>>>>>>                            
28231>>>>>>>>>>>>>>>            Move (Length(sFilter)) to iLen
28232>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
28233>>>>>>>>>>>>>>>            Move False to bSuccess
28234>>>>>>>>>>>>>>>            
28234>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
28234>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
28236>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
28237>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
28239>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
28240>>>>>>>>>>>>>>>                End
28240>>>>>>>>>>>>>>>>
28240>>>>>>>>>>>>>>>            End
28240>>>>>>>>>>>>>>>>
28240>>>>>>>>>>>>>>>            
28240>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
28242>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
28244>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
28245>>>>>>>>>>>>>>>                End
28245>>>>>>>>>>>>>>>>
28245>>>>>>>>>>>>>>>                If (bScanAll or bFilterApplied) Begin
28247>>>>>>>>>>>>>>>                    Send Request_Read of hoServer FIRST_RECORD iFile iIndex
28248>>>>>>>>>>>>>>>                End
28248>>>>>>>>>>>>>>>>
28248>>>>>>>>>>>>>>>                Else Begin
28249>>>>>>>>>>>>>>>                    Set_Field_Value iFile iField to sFilter
28252>>>>>>>>>>>>>>>                    Send Request_Read of hoServer GE iFile iIndex
28253>>>>>>>>>>>>>>>                End
28253>>>>>>>>>>>>>>>>
28253>>>>>>>>>>>>>>>            End
28253>>>>>>>>>>>>>>>>
28253>>>>>>>>>>>>>>>            Else Begin
28254>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
28255>>>>>>>>>>>>>>>            End
28255>>>>>>>>>>>>>>>>
28255>>>>>>>>>>>>>>>            
28255>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData) and not(bBreak))
28259>>>>>>>>>>>>>>>                Move False to bBreak
28260>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
28261>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase False False to bOk
28262>>>>>>>>>>>>>>>                If (bOk) Begin
28264>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
28265>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
28266>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0]) 
28267>>>>>>>>>>>>>>>                    Increment iItemIndex
28268>>>>>>>>>>>>>>>                End
28268>>>>>>>>>>>>>>>>
28268>>>>>>>>>>>>>>>                Else Begin
28269>>>>>>>>>>>>>>>                    If (bScanAll or bFilterApplied) Begin
28271>>>>>>>>>>>>>>>                        Move False to bBreak
28272>>>>>>>>>>>>>>>                    End
28272>>>>>>>>>>>>>>>>
28272>>>>>>>>>>>>>>>                    Else Begin
28273>>>>>>>>>>>>>>>                        Move True to bBreak
28274>>>>>>>>>>>>>>>                    End
28274>>>>>>>>>>>>>>>>
28274>>>>>>>>>>>>>>>                    If (bBreak and eType = DF_BCD and Length(sFilter) < iLength) Begin
28276>>>>>>>>>>>>>>>                        Move (GetRowID(iFile)) to riTest
28277>>>>>>>>>>>>>>>                        
28277>>>>>>>>>>>>>>>                        Repeat
28277>>>>>>>>>>>>>>>>
28277>>>>>>>>>>>>>>>                            Move (sFilter + "0") to sFilter
28278>>>>>>>>>>>>>>>                            If (Length(sFilter) >= iLength) ;                                Break
28281>>>>>>>>>>>>>>>                            
28281>>>>>>>>>>>>>>>                            Set_Field_Value iFile iField to sFilter
28284>>>>>>>>>>>>>>>                            Send Request_Read of hoServer GE iFile iIndex
28285>>>>>>>>>>>>>>>                            Move (IsSameRowID(riTest, GetRowID(iFile))) to bBreak
28286>>>>>>>>>>>>>>>                        Until (not(bBreak))
28288>>>>>>>>>>>>>>>                    End                    
28288>>>>>>>>>>>>>>>>
28288>>>>>>>>>>>>>>>                End
28288>>>>>>>>>>>>>>>>
28288>>>>>>>>>>>>>>>
28288>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
28289>>>>>>>>>>>>>>>            Loop
28290>>>>>>>>>>>>>>>>
28290>>>>>>>>>>>>>>>            Move (not(Found) or bBreak) to bLast
28291>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
28292>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
28293>>>>>>>>>>>>>>>        End
28293>>>>>>>>>>>>>>>>
28293>>>>>>>>>>>>>>>    End_Procedure
28294>>>>>>>>>>>>>>>    
28294>>>>>>>>>>>>>>>    Procedure FindFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
28296>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
28296>>>>>>>>>>>>>>>        Boolean bCase bOldRelate bNeedsRelate bAllData bSuccess bSupportsFilters bOrigActive bFilterApplied bOk
28296>>>>>>>>>>>>>>>        String sLowSearch sRowId sValue sOrigFilter
28296>>>>>>>>>>>>>>>        String[] aEntryValues
28297>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
28299>>>>>>>>>>>>>>>        Handle hoServer
28299>>>>>>>>>>>>>>>        RowID riTest
28299>>>>>>>>>>>>>>>        
28299>>>>>>>>>>>>>>>        Get Server to hoServer
28300>>>>>>>>>>>>>>>        Get Data_File to iFile
28301>>>>>>>>>>>>>>>        Get Data_Field to iField
28302>>>>>>>>>>>>>>>        Get pbAllData to bAllData
28303>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
28304>>>>>>>>>>>>>>>
28304>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
28306>>>>>>>>>>>>>>>            Get pbCaseSensitive to bCase
28307>>>>>>>>>>>>>>>            
28307>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
28308>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
28313>>>>>>>>>>>>>>>            If (iIndex <= 0);                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
28316>>>>>>>>>>>>>>>            
28316>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
28317>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
28318>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
28319>>>>>>>>>>>>>>>            
28319>>>>>>>>>>>>>>>            //  Determine current filter settings
28319>>>>>>>>>>>>>>>            Get SupportsFilterExpressions hoServer to bSupportsFilters
28320>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
28321>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
28322>>>>>>>>>>>>>>>            
28322>>>>>>>>>>>>>>>            Move (Lowercase(sFilter)) to sLowSearch
28323>>>>>>>>>>>>>>>            Move False to bSuccess
28324>>>>>>>>>>>>>>>            
28324>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
28324>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
28326>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
28327>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
28329>>>>>>>>>>>>>>>                    Get ReadByRowIdEx of hoServer iFile riTest to bSuccess
28330>>>>>>>>>>>>>>>                End
28330>>>>>>>>>>>>>>>>
28330>>>>>>>>>>>>>>>            End
28330>>>>>>>>>>>>>>>>
28330>>>>>>>>>>>>>>>            
28330>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
28332>>>>>>>>>>>>>>>                If (bSupportsFilters) Begin
28334>>>>>>>>>>>>>>>                    Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
28335>>>>>>>>>>>>>>>                End
28335>>>>>>>>>>>>>>>>
28335>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
28336>>>>>>>>>>>>>>>            End
28336>>>>>>>>>>>>>>>>
28336>>>>>>>>>>>>>>>            Else Begin
28337>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
28338>>>>>>>>>>>>>>>            End
28338>>>>>>>>>>>>>>>>
28338>>>>>>>>>>>>>>>            
28338>>>>>>>>>>>>>>>            While (Found and (not(iItemIndex >= iPageSize) or bAllData))
28342>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
28343>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter bCase True False to bOk
28344>>>>>>>>>>>>>>>                If (bOk) Begin
28346>>>>>>>>>>>>>>>                    
28346>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
28347>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
28348>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
28349>>>>>>>>>>>>>>>                    
28349>>>>>>>>>>>>>>>                    Increment iItemIndex
28350>>>>>>>>>>>>>>>                End
28350>>>>>>>>>>>>>>>>
28350>>>>>>>>>>>>>>>                
28350>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex 
28351>>>>>>>>>>>>>>>            Loop
28352>>>>>>>>>>>>>>>>
28352>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
28353>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
28354>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
28355>>>>>>>>>>>>>>>        End
28355>>>>>>>>>>>>>>>>
28355>>>>>>>>>>>>>>>    End_Procedure
28356>>>>>>>>>>>>>>>
28356>>>>>>>>>>>>>>>    Procedure FindFilteredFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
28358>>>>>>>>>>>>>>>        Integer iIndex iFile iField iItemIndex
28358>>>>>>>>>>>>>>>        Boolean bOrigActive bOldRelate bNeedsRelate bAllData bSuccess bOk bFilterApplied
28358>>>>>>>>>>>>>>>        String sOrigFilter sFile sField sRowId sValue
28358>>>>>>>>>>>>>>>        String[] aEntryValues
28359>>>>>>>>>>>>>>>        Integer[] iaFiles iaFields
28361>>>>>>>>>>>>>>>        Handle hoServer
28361>>>>>>>>>>>>>>>        RowID riTest
28361>>>>>>>>>>>>>>>        
28361>>>>>>>>>>>>>>>        Get Server to hoServer
28362>>>>>>>>>>>>>>>        Get Data_File to iFile
28363>>>>>>>>>>>>>>>        Get Data_Field to iField
28364>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
28365>>>>>>>>>>>>>>>
28365>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
28367>>>>>>>>>>>>>>>            
28367>>>>>>>>>>>>>>>            // make sure we send DD messages to owner DDO
28367>>>>>>>>>>>>>>>            Get Which_Data_Set of hoServer iFile to hoServer
28368>>>>>>>>>>>>>>>            If (hoServer=0) Begin
28370>>>>>>>>>>>>>>>                Procedure_Return
28371>>>>>>>>>>>>>>>            End
28371>>>>>>>>>>>>>>>>
28371>>>>>>>>>>>>>>>            
28371>>>>>>>>>>>>>>>            Get piFindIndex to iIndex
28372>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
28377>>>>>>>>>>>>>>>            If (iIndex <= 0) ;                Error DFERR_PROGRAM C_$CouldNotFindAnIndex
28380>>>>>>>>>>>>>>>            
28380>>>>>>>>>>>>>>>            //  Determine current filter settings
28380>>>>>>>>>>>>>>>            Get piaDataFiles to iaFiles
28381>>>>>>>>>>>>>>>            Get piaDataFields to iaFields
28382>>>>>>>>>>>>>>>            Send ApplyFilterExpression hoServer iaFiles iaFields sFilter (&sOrigFilter) (&bOrigActive) (&bFilterApplied)
28383>>>>>>>>>>>>>>>            
28383>>>>>>>>>>>>>>>            // this will optimize No_relate. If your DF constraint does not
28383>>>>>>>>>>>>>>>            // need a post-relate test, we will disabled relates for this
28383>>>>>>>>>>>>>>>            Get No_Relate_State of hoServer to bOldRelate
28384>>>>>>>>>>>>>>>            Get DDOConstraintNeedsRelate of hoServer iIndex to bNeedsRelate
28385>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to (not(bNeedsRelate))
28386>>>>>>>>>>>>>>>            
28386>>>>>>>>>>>>>>>            Move False to bSuccess
28387>>>>>>>>>>>>>>>            
28387>>>>>>>>>>>>>>>            //  Find first record or if a page was selected do a refind and go from there.
28387>>>>>>>>>>>>>>>            If (iPage > 0 and Length(prevItem.sRowId) > 0) Begin
28389>>>>>>>>>>>>>>>                Move (DeserializeRowID(prevItem.sRowId)) to riTest    
28390>>>>>>>>>>>>>>>                If (not(IsNullRowID(riTest))) Begin
28392>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile riTest to bSuccess
28393>>>>>>>>>>>>>>>                End
28393>>>>>>>>>>>>>>>>
28393>>>>>>>>>>>>>>>            End
28393>>>>>>>>>>>>>>>>
28393>>>>>>>>>>>>>>>            
28393>>>>>>>>>>>>>>>            If (not(bSuccess)) Begin
28395>>>>>>>>>>>>>>>                Send Request_Read of hoServer FIRST_RECORD iFile iIndex
28396>>>>>>>>>>>>>>>            End
28396>>>>>>>>>>>>>>>>
28396>>>>>>>>>>>>>>>            Else Begin
28397>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex  
28398>>>>>>>>>>>>>>>            End
28398>>>>>>>>>>>>>>>>
28398>>>>>>>>>>>>>>>            
28398>>>>>>>>>>>>>>>            While (Found and not(iItemIndex >= iPageSize))
28402>>>>>>>>>>>>>>>                Move (ResizeArray(aEntryValues, 0)) to aEntryValues
28403>>>>>>>>>>>>>>>                Get CheckAllEntryItem (&aEntryValues) sFilter False True False to bOk
28404>>>>>>>>>>>>>>>                If (bOk) Begin
28406>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to aItems[iItemIndex].sRowId
28407>>>>>>>>>>>>>>>                    Move aEntryValues to aItems[iItemIndex].aValues
28408>>>>>>>>>>>>>>>                    Send OnSetCalculatedValue (&aItems[iItemIndex].aValues[0])
28409>>>>>>>>>>>>>>>                    
28409>>>>>>>>>>>>>>>                    Increment iItemIndex
28410>>>>>>>>>>>>>>>                End
28410>>>>>>>>>>>>>>>>
28410>>>>>>>>>>>>>>>                    
28410>>>>>>>>>>>>>>>                Send Request_Read of hoServer GT iFile iIndex
28411>>>>>>>>>>>>>>>            Loop
28412>>>>>>>>>>>>>>>>
28412>>>>>>>>>>>>>>>            Move (not(Found)) to bLast
28413>>>>>>>>>>>>>>>            
28413>>>>>>>>>>>>>>>            //  Restore filters
28413>>>>>>>>>>>>>>>            Send Clear of hoServer
28414>>>>>>>>>>>>>>>            Send DisregardFilterExpression hoServer sOrigFilter bOrigActive bFilterApplied
28415>>>>>>>>>>>>>>>            Set No_Relate_State of hoServer to bOldRelate
28416>>>>>>>>>>>>>>>        End
28416>>>>>>>>>>>>>>>>
28416>>>>>>>>>>>>>>>    End_Procedure
28417>>>>>>>>>>>>>>>
28417>>>>>>>>>>>>>>>    Procedure FindValidation Boolean bFullText tSelectionItem[] ByRef aItems Boolean ByRef bLast String sFilter tSelectionItem prevItem Integer iPageSize Integer iPage
28419>>>>>>>>>>>>>>>        Handle hoTable hoServer
28419>>>>>>>>>>>>>>>        Integer iCount iFound iLen iFile iField iItemIndex
28419>>>>>>>>>>>>>>>        Variant[][] aData
28420>>>>>>>>>>>>>>>        Boolean bCaseSensitive bAllData bOk
28420>>>>>>>>>>>>>>>        String sValue sDescription sCompareValue sCompareDescription
28420>>>>>>>>>>>>>>>        
28420>>>>>>>>>>>>>>>        Get Server to hoServer
28421>>>>>>>>>>>>>>>        Get Data_File to iFile
28422>>>>>>>>>>>>>>>        Get Data_Field to iField
28423>>>>>>>>>>>>>>>        Get pbAllData to bAllData
28424>>>>>>>>>>>>>>>        Move (SizeOfArray(aItems)) to iItemIndex
28425>>>>>>>>>>>>>>>
28425>>>>>>>>>>>>>>>        If ((hoServer <> 0) and (iFile <> 0)) Begin
28427>>>>>>>>>>>>>>>            Get File_Field_Table_Object of hoServer iFile iField to hoTable
28428>>>>>>>>>>>>>>>            If (hoTable <> 0) Begin
28430>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
28431>>>>>>>>>>>>>>>        
28431>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive  
28432>>>>>>>>>>>>>>>            
28432>>>>>>>>>>>>>>>                If (not(bCaseSensitive)) Begin
28434>>>>>>>>>>>>>>>                    Move (Lowercase(sFilter)) to sFilter
28435>>>>>>>>>>>>>>>                End
28435>>>>>>>>>>>>>>>>
28435>>>>>>>>>>>>>>>                
28435>>>>>>>>>>>>>>>                Move (SizeOfArray(aData)) to iCount
28436>>>>>>>>>>>>>>>                Move (Length(sFilter)) to iLen
28437>>>>>>>>>>>>>>>                
28437>>>>>>>>>>>>>>>                If (iPage > 0 and prevItem.sRowId > 0);                    Move (prevItem.sRowId + 1) to iFound
28440>>>>>>>>>>>>>>>            
28440>>>>>>>>>>>>>>>                While (iFound < iCount and (not(iItemIndex >= iPageSize) or bAllData))
28444>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][0])) to sValue
28445>>>>>>>>>>>>>>>                    Move (Trim(aData[iFound][1])) to sDescription
28446>>>>>>>>>>>>>>>                    Get Find_Code_Description of hoTable sValue to sDescription
28447>>>>>>>>>>>>>>>                    Move sValue to sCompareValue
28448>>>>>>>>>>>>>>>                    Move sDescription to sCompareDescription
28449>>>>>>>>>>>>>>>                    If (not(bCaseSensitive)) Begin
28451>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareValue)) to sCompareValue
28452>>>>>>>>>>>>>>>                        Move (Lowercase(sCompareDescription)) to sCompareDescription
28453>>>>>>>>>>>>>>>                    End
28453>>>>>>>>>>>>>>>>
28453>>>>>>>>>>>>>>>                    Move False to bOk
28454>>>>>>>>>>>>>>>                    If (bFullText) Begin
28456>>>>>>>>>>>>>>>                        Move (sCompareValue contains sFilter or sCompareDescription contains sFilter) to bOk
28457>>>>>>>>>>>>>>>                    End
28457>>>>>>>>>>>>>>>>
28457>>>>>>>>>>>>>>>                    Else Begin
28458>>>>>>>>>>>>>>>                        Move (Left(sCompareValue, iLen) = sFilter or Left(sCompareDescription, iLen) = sFilter) to bOk
28459>>>>>>>>>>>>>>>                    End
28459>>>>>>>>>>>>>>>>
28459>>>>>>>>>>>>>>>                    
28459>>>>>>>>>>>>>>>                    If (bOk) Begin
28461>>>>>>>>>>>>>>>                        Move (String(iFound)) to aItems[iItemIndex].sRowId
28462>>>>>>>>>>>>>>>                        Move sValue to aItems[iItemIndex].aValues[0]
28463>>>>>>>>>>>>>>>                        Move sDescription to aItems[iItemIndex].aValues[1]
28464>>>>>>>>>>>>>>>                        
28464>>>>>>>>>>>>>>>                        Increment iItemIndex
28465>>>>>>>>>>>>>>>                    End
28465>>>>>>>>>>>>>>>>
28465>>>>>>>>>>>>>>>                    
28465>>>>>>>>>>>>>>>                    Increment iFound
28466>>>>>>>>>>>>>>>                Loop
28467>>>>>>>>>>>>>>>>
28467>>>>>>>>>>>>>>>                Move (iFound >= iCount) to bLast
28468>>>>>>>>>>>>>>>            End
28468>>>>>>>>>>>>>>>>
28468>>>>>>>>>>>>>>>        End
28468>>>>>>>>>>>>>>>>
28468>>>>>>>>>>>>>>>    End_Procedure
28469>>>>>>>>>>>>>>>
28469>>>>>>>>>>>>>>>    Function RefindByRowIdentification String sRowIdentification tSelectionItem ByRef tOut Returns Boolean
28471>>>>>>>>>>>>>>>        Handle hoServer hoTable
28471>>>>>>>>>>>>>>>        Integer iFile iField iRow
28471>>>>>>>>>>>>>>>        Variant[][] aData
28472>>>>>>>>>>>>>>>        Boolean bSuccess bCaseSensitive bIsValidationTable
28472>>>>>>>>>>>>>>>        RowID rRowId
28472>>>>>>>>>>>>>>>        
28472>>>>>>>>>>>>>>>        Get Server to hoServer
28473>>>>>>>>>>>>>>>        Get Data_File to iFile
28474>>>>>>>>>>>>>>>        Get Data_Field to iField
28475>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
28476>>>>>>>>>>>>>>>                
28476>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
28478>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
28480>>>>>>>>>>>>>>>                Move (DeserializeRowID(sRowIdentification)) to rRowId    
28481>>>>>>>>>>>>>>>                If (not(IsNullRowID(rRowId))) Begin
28483>>>>>>>>>>>>>>>                    Get FindByRowIdEx of hoServer iFile rRowId to bSuccess
28484>>>>>>>>>>>>>>>                End
28484>>>>>>>>>>>>>>>>
28484>>>>>>>>>>>>>>>                If (bSuccess) Begin
28486>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
28487>>>>>>>>>>>>>>>                    Get_Field_Value iFile iField to tOut.aValues[0]
28490>>>>>>>>>>>>>>>                    Move (Trim(tOut.aValues[0])) to tOut.aValues[0]
28491>>>>>>>>>>>>>>>                    Function_Return True
28492>>>>>>>>>>>>>>>                End
28492>>>>>>>>>>>>>>>>
28492>>>>>>>>>>>>>>>            End
28492>>>>>>>>>>>>>>>>
28492>>>>>>>>>>>>>>>            Else Begin
28493>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
28494>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
28495>>>>>>>>>>>>>>>                Get pbCaseSensitive to bCaseSensitive
28496>>>>>>>>>>>>>>>            
28496>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
28502>>>>>>>>>>>>>>>>
28502>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sRowIdentification or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = sRowIdentification)) Begin
28504>>>>>>>>>>>>>>>                        If (not(bCaseSensitive)) Begin
28506>>>>>>>>>>>>>>>                            Move (Lowercase(aData[iRow][0])) to tOut.sRowId
28507>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][0]))) to tOut.aValues[0]
28508>>>>>>>>>>>>>>>                            Move (Lowercase(Trim(aData[iRow][1]))) to tOut.aValues[1]
28509>>>>>>>>>>>>>>>                        End
28509>>>>>>>>>>>>>>>>
28509>>>>>>>>>>>>>>>                        Else Begin
28510>>>>>>>>>>>>>>>                            Move aData[iRow][0] to tOut.sRowId
28511>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][0])) to tOut.aValues[0]
28512>>>>>>>>>>>>>>>                            Move (Trim(aData[iRow][1])) to tOut.aValues[1]
28513>>>>>>>>>>>>>>>                        End
28513>>>>>>>>>>>>>>>>
28513>>>>>>>>>>>>>>>                        Function_Return True
28514>>>>>>>>>>>>>>>                    End
28514>>>>>>>>>>>>>>>>
28514>>>>>>>>>>>>>>>                Loop
28515>>>>>>>>>>>>>>>>
28515>>>>>>>>>>>>>>>            End
28515>>>>>>>>>>>>>>>>
28515>>>>>>>>>>>>>>>        End
28515>>>>>>>>>>>>>>>>
28515>>>>>>>>>>>>>>>        Function_Return False
28516>>>>>>>>>>>>>>>    End_Function
28517>>>>>>>>>>>>>>>
28517>>>>>>>>>>>>>>>    Function RefindByValue String sValue tSelectionItem ByRef tOut Returns Boolean
28519>>>>>>>>>>>>>>>        Handle hoServer hoTable
28519>>>>>>>>>>>>>>>        String sDBValue
28519>>>>>>>>>>>>>>>        Integer iFile iField iRow iIndex
28519>>>>>>>>>>>>>>>        Variant[][] aData
28520>>>>>>>>>>>>>>>        Boolean bFound bCaseSensitive bIsValidationTable
28520>>>>>>>>>>>>>>>        
28520>>>>>>>>>>>>>>>        Get Server to hoServer
28521>>>>>>>>>>>>>>>        Get Data_File to iFile
28522>>>>>>>>>>>>>>>        Get Data_Field to iField
28523>>>>>>>>>>>>>>>        Get pbUseValidationTable to bIsValidationTable
28524>>>>>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
28525>>>>>>>>>>>>>>>        
28525>>>>>>>>>>>>>>>        Get piFindIndex to iIndex
28526>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Get_Attribute DF_FIELD_INDEX of iFile iField to iIndex
28531>>>>>>>>>>>>>>>        If (iIndex <= 0) ;            Error DFERR_PROGRAM C_$CouldNotFindAnIndex
28534>>>>>>>>>>>>>>>                
28534>>>>>>>>>>>>>>>        If (hoServer <> 0) Begin
28536>>>>>>>>>>>>>>>            If (not(bIsValidationTable)) Begin
28538>>>>>>>>>>>>>>>                Send Request_Clear of hoServer
28539>>>>>>>>>>>>>>>                Set_Field_Value iFile iField to sValue
28542>>>>>>>>>>>>>>>                Send Request_Read of hoServer GE iFile iIndex
28543>>>>>>>>>>>>>>>                Get_Field_Value iFile iField to sDBValue
28546>>>>>>>>>>>>>>>                
28546>>>>>>>>>>>>>>>                If (Found and (sDBValue = sValue or (not(bCaseSensitive) and Lowercase(sDBValue) = Lowercase(sValue)))) Begin
28548>>>>>>>>>>>>>>>                    Move (SerializeRowID(GetRowID(iFile))) to tOut.sRowId
28549>>>>>>>>>>>>>>>                    Move (Trim(sValue)) to tOut.aValues[0]
28550>>>>>>>>>>>>>>>                    Function_Return True
28551>>>>>>>>>>>>>>>                End
28551>>>>>>>>>>>>>>>>
28551>>>>>>>>>>>>>>>            End
28551>>>>>>>>>>>>>>>>
28551>>>>>>>>>>>>>>>            Else Begin
28552>>>>>>>>>>>>>>>                Get File_Field_Table_Object of hoServer iFile iField to hoTable
28553>>>>>>>>>>>>>>>                Get tabledata of hoTable to aData
28554>>>>>>>>>>>>>>>        
28554>>>>>>>>>>>>>>>                For iRow from 0 to (SizeOfArray(aData) - 1)
28560>>>>>>>>>>>>>>>>
28560>>>>>>>>>>>>>>>                    If (aData[iRow][0] = sValue or (not(bCaseSensitive) and Lowercase(aData[iRow][0]) = Lowercase(sValue))) Begin
28562>>>>>>>>>>>>>>>                        Move aData[iRow][0] to tOut.sRowId
28563>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][0])) to tOut.aValues[0]
28564>>>>>>>>>>>>>>>                        Move (Trim(aData[iRow][1])) to tOut.aValues[1]
28565>>>>>>>>>>>>>>>                        Function_Return True
28566>>>>>>>>>>>>>>>                    End
28566>>>>>>>>>>>>>>>>
28566>>>>>>>>>>>>>>>                Loop
28567>>>>>>>>>>>>>>>>
28567>>>>>>>>>>>>>>>            End
28567>>>>>>>>>>>>>>>>
28567>>>>>>>>>>>>>>>        End
28567>>>>>>>>>>>>>>>>
28567>>>>>>>>>>>>>>>        Function_Return False
28568>>>>>>>>>>>>>>>    End_Function
