7753>>>>>>>    
7753>>>>>>>    Procedure Set Combo_Value Integer iItem String sValue
7755>>>>>>>        Handle hoData hWnd
7755>>>>>>>        Integer iWinItem
7755>>>>>>>        String sOldVal sOldComboVal sWinValue
7755>>>>>>>        Boolean bSorted
7755>>>>>>>
7755>>>>>>>        Get Combo_Data_Object to hoData
7756>>>>>>>        If (hoData <> 0) Begin
7758>>>>>>>            Move (Rtrim (sValue)) to sValue // see Combo_Add_Item
7759>>>>>>>            Get Window_Handle to hWnd
7760>>>>>>>            // if windows exists make sure it is also up to date.
7760>>>>>>>            If (hWnd <> 0) Begin
7762>>>>>>>                Get Combo_Sort_State to bSorted
7763>>>>>>>                Get Value of hoData iItem to sOldComboVal // current value
7764>>>>>>>                If (bSorted) Begin
7766>>>>>>>                    Get WinCombo_Value iItem to sWinValue
7767>>>>>>>                    If (sOldComboVal = sWinValue) Begin
7769>>>>>>>                        Send Windows_Message CB_DELETESTRING iItem 0
7770>>>>>>>                        Send WinCombo_Add_Insert_Value CB_INSERTSTRING iItem sValue
7771>>>>>>>                    End
7771>>>>>>>>
7771>>>>>>>                    Else Begin
7772>>>>>>>                        Get WinCombo_Item_Matching sOldComboVal to iWinItem
7773>>>>>>>                        If (iWinItem <> -1) Begin
7775>>>>>>>                            Get Value to sOldVal // current value
7776>>>>>>>                            Send Windows_Message CB_DELETESTRING iWinItem 0
7777>>>>>>>                            Send WinCombo_Add_Insert_Value CB_INSERTSTRING iWinItem sValue
7778>>>>>>>                            Set Value to sOldVal // current value
7779>>>>>>>                        End
7779>>>>>>>>
7779>>>>>>>                        Else Begin
7780>>>>>>>                            Error DFERR_PROGRAM "Cannot replace value"
7781>>>>>>>>
7781>>>>>>>                            Procedure_Return
7782>>>>>>>                        End
7782>>>>>>>>
7782>>>>>>>                    End
7782>>>>>>>>
7782>>>>>>>                End
7782>>>>>>>>
7782>>>>>>>                Else Begin
7783>>>>>>>                    Get WinCombo_Value iItem to sWinValue
7784>>>>>>>                    If (sOldComboVal = sWinValue) Begin
7786>>>>>>>                        Send Windows_Message CB_DELETESTRING iItem 0
7787>>>>>>>                        Send WinCombo_Add_Insert_Value CB_INSERTSTRING iItem sValue
7788>>>>>>>                    End
7788>>>>>>>>
7788>>>>>>>                    Else Begin
7789>>>>>>>                        Error DFERR_PROGRAM "Cannot replace value"
7790>>>>>>>>
7790>>>>>>>                        Procedure_Return
7791>>>>>>>                    End
7791>>>>>>>>
7791>>>>>>>                End
7791>>>>>>>>
7791>>>>>>>            End
7791>>>>>>>>
7791>>>>>>>            Set Value of hoData iItem to sValue
7792>>>>>>>        End
7792>>>>>>>>
7792>>>>>>>    End_Procedure
7793>>>>>>>    
7793>>>>>>>    Function Combo_Value Integer item# Returns String
7795>>>>>>>        Integer dataobj
7795>>>>>>>        Get Combo_data_object to dataobj
7796>>>>>>>        If dataobj ;            Function_Return (Value(dataobj,item#))
7799>>>>>>>    End_Function
7800>>>>>>>    
7800>>>>>>>    Procedure Combo_Add_Item String sValue
7802>>>>>>>        Integer dataobj
7802>>>>>>>        Get Combo_data_object to dataobj
7803>>>>>>>        If dataobj Begin
7805>>>>>>>            // 14.1 change: Trailing spaces causes matching problems
7805>>>>>>>            // with entry_state=false combos. We are RTrim all because
7805>>>>>>>            // you probably never want spaces in the combo list
7805>>>>>>>            Move (Rtrim(sValue)) to sValue
7806>>>>>>>            Send add_item to dataobj msg_none sValue
7807>>>>>>>            If (Deferred_State(Self)=0 and Window_Handle(Self)) ;                Send WinCombo_Add_Insert_Value CB_ADDSTRING 0 sValue
7810>>>>>>>        End
7810>>>>>>>>
7810>>>>>>>    End_Procedure
7811>>>>>>>    
7811>>>>>>>    Procedure Combo_Insert_Item Integer iItem String sValue
7813>>>>>>>        Integer dataobj
7813>>>>>>>        Get Combo_data_object to dataobj
7814>>>>>>>        If dataobj Begin
7816>>>>>>>            Move (Rtrim(sValue)) to sValue // see Combo_Add_Item_Notes
7817>>>>>>>            Send insert_item to dataobj msg_none sValue iItem
7818>>>>>>>            If (Window_Handle(Self)) ;                Send WinCombo_Add_Insert_Value CB_INSERTSTRING iItem sValue
7821>>>>>>>        End
7821>>>>>>>>
7821>>>>>>>    End_Procedure
7822>>>>>>>    
7822>>>>>>>    // Internal: Send it the wrong values and watch the smoke!
7822>>>>>>>    Procedure WinCombo_Add_Insert_Value Integer mode Integer iItem String sValue
7824>>>>>>>        WString wsValue
7824>>>>>>>        
7824>>>>>>>        // trim trailing spaces. Should already be trimmed but just in case (14.1 change)
7824>>>>>>>        Move (sValue - Character(0)) to wsValue
7825>>>>>>>        Send Windows_Message Mode iItem (AddressOf(wsValue))
7826>>>>>>>    End_Procedure
7827>>>>>>>    
7827>>>>>>>    Procedure Combo_Delete_Item Integer iItem
7829>>>>>>>        Handle hoData hWnd
7829>>>>>>>        Boolean bSorted
7829>>>>>>>        String sWinValue sValue
7829>>>>>>>        Integer iWinItem
7829>>>>>>>
7829>>>>>>>        Get Combo_Data_Object to hoData
7830>>>>>>>        If (hoData <> 0) Begin
7832>>>>>>>            // if active, find item in the windows list and remove it there
7832>>>>>>>            Get Window_Handle to hWnd
7833>>>>>>>            If (hWnd <> 0) Begin
7835>>>>>>>                Get Combo_Sort_State to bSorted
7836>>>>>>>                Get Value of hoData iItem to sValue // value of the item to be deleted
7837>>>>>>>                If (bSorted) Begin
7839>>>>>>>                    Get WinCombo_Value iItem to sWinValue
7840>>>>>>>                    If (sWinValue = sValue) Begin
7842>>>>>>>                        Send Windows_Message CB_DELETESTRING iItem 0
7843>>>>>>>                    End
7843>>>>>>>>
7843>>>>>>>                    Else Begin
7844>>>>>>>                        // we must search for value because it is sorted and order of the data in the data object does
7844>>>>>>>                        // match with the data in the windows list and we cannot delete just an item
7844>>>>>>>                        Get WinCombo_Item_Matching sValue to iWinItem
7845>>>>>>>                        If (iWinItem <> -1) Begin
7847>>>>>>>                            // if item found (should be) remove it.
7847>>>>>>>                            Send Windows_Message CB_DELETESTRING iWinItem 0
7848>>>>>>>                        End
7848>>>>>>>>
7848>>>>>>>                        Else Begin
7849>>>>>>>                            Error DFERR_PROGRAM "Cannot find item to be deleted"
7850>>>>>>>>
7850>>>>>>>                            Procedure_Return
7851>>>>>>>                        End
7851>>>>>>>>
7851>>>>>>>                    End
7851>>>>>>>>
7851>>>>>>>                End
7851>>>>>>>>
7851>>>>>>>                Else Begin
7852>>>>>>>                    Get WinCombo_Value iItem to sWinValue
7853>>>>>>>                    If (sWinValue = sValue) Begin
7855>>>>>>>                        Send Windows_Message CB_DELETESTRING iItem 0
7856>>>>>>>                    End
7856>>>>>>>>
7856>>>>>>>                    Else Begin
7857>>>>>>>                        Error DFERR_PROGRAM "Cannot find item to be deleted"
7858>>>>>>>>
7858>>>>>>>                        Procedure_Return
7859>>>>>>>                    End
7859>>>>>>>>
7859>>>>>>>                End
7859>>>>>>>>
7859>>>>>>>            End
7859>>>>>>>>
7859>>>>>>>
7859>>>>>>>            Send Delete_Item of hoData iItem
7860>>>>>>>        End
7860>>>>>>>>
7860>>>>>>>    End_Procedure
7861>>>>>>>    
7861>>>>>>>    Procedure Combo_Delete_Data
7863>>>>>>>        Integer dataobj
7863>>>>>>>        Get Combo_data_object to dataobj
7864>>>>>>>        If dataobj Begin
7866>>>>>>>            Send Delete_Data to dataobj
7867>>>>>>>            If (Deferred_State(Self)=0 and Window_Handle(Self)) ;                Send Windows_Message CB_RESETCONTENT 0 0
7870>>>>>>>        End
7870>>>>>>>>
7870>>>>>>>    End_Procedure
7871>>>>>>>    
7871>>>>>>>    Function Combo_Item_Matching String sText Returns Integer
7873>>>>>>>        Integer dataobj item#
7873>>>>>>>        Get Combo_data_object to dataobj
7874>>>>>>>        If dataobj Begin
7876>>>>>>>            Move 0 to item#
7877>>>>>>>            Get item_matching of dataobj sText to item#
7878>>>>>>>            Function_Return item#
7879>>>>>>>        End
7879>>>>>>>>
7879>>>>>>>        Else ;            Function_Return -1
7881>>>>>>>    End_Function
7882>>>>>>>    
7882>>>>>>>    // Perform the item match in the window's control
7882>>>>>>>    //
7882>>>>>>>    Function WinCombo_Item_Matching String sText Returns Integer
7884>>>>>>>        Handle hWnd
7884>>>>>>>        Integer iItem iItems
7884>>>>>>>        Pointer pVoid
7884>>>>>>>        String sItem
7884>>>>>>>        WString wsText
7884>>>>>>>        
7884>>>>>>>        Get Window_Handle to hWnd
7885>>>>>>>        If hWnd Begin
7887>>>>>>>            
7887>>>>>>>            // CB_FINDSTRINGEXACT does not find blank items even though they can be added. If blank
7887>>>>>>>            // we must manually search for the first empty item
7887>>>>>>>            If (sText="") Begin
7889>>>>>>>                Get Combo_Item_Count to iItems
7890>>>>>>>                Move 0 to iItem
7891>>>>>>>                While (iItem<iItems)
7895>>>>>>>                    Get WinCombo_Value iItem to sItem
7896>>>>>>>                    If (sItem="") Begin
7898>>>>>>>                        Function_Return iItem
7899>>>>>>>                    End
7899>>>>>>>>
7899>>>>>>>                    Increment iItem
7900>>>>>>>                Loop
7901>>>>>>>>
7901>>>>>>>                Function_Return -1
7902>>>>>>>            End
7902>>>>>>>>
7902>>>>>>>            
7902>>>>>>>            Move (sText-Character(0)) to wsText // (1/31/2002) Trim trailing spaces and append 0 for C string
7903>>>>>>>            Move (SendMessage (hWnd, CB_FINDSTRINGEXACT, 0, AddressOf(wsText))) to iItem
7904>>>>>>>            If (iItem = CB_ERR) ;                Function_Return -1
7907>>>>>>>            Else ;                Function_Return iItem
7909>>>>>>>        End
7909>>>>>>>>
7909>>>>>>>    End_Function
7910>>>>>>>    
7910>>>>>>>    Procedure Set WinCombo_Current_Item Integer iTo
7912>>>>>>>        Send Windows_Message CB_SETCURSEL iTo 0
