7329>>>>>>>    // This explicitly hides/unhides this tab page.
7329>>>>>>>    //
7329>>>>>>>    Procedure DoHideTab Integer bHide
7331>>>>>>>        Integer bHidden
7331>>>>>>>        Set pbHidePage to bHide  // set explicit hidden value
7332>>>>>>>        Get Implicit_Hidden_State to bHidden // are we hidden by another parent tab page?
7333>>>>>>>        If not bHidden ; // if it is already hidden by a parent, the children will not change...            Broadcast Send DoImplicitTabHide bHide // else implicitly hide or un hide all decendants
7337>>>>>>>    End_Procedure
7338>>>>>>>    
7338>>>>>>>    // augment to only broadcast change if not already hidden by this page
7338>>>>>>>    //
7338>>>>>>>    Procedure DoImplicitTabHide Integer iState
7340>>>>>>>        Set Private.Implicit_Hidden_State to iState // = hidden by a parent
7341>>>>>>>        If not (pbHidePage(Self)) ;                // are we already hiding this page explicitly?            Broadcast Send DoImplicitTabHide iState // if not, we tell everyone
7345>>>>>>>    End_Procedure
7346>>>>>>>    
7346>>>>>>>    
7346>>>>>>>    // reverse any effects of hiding a tab. When removed, restore page
7346>>>>>>>    // to original unhidden state. There were problems with dbGroups not
7346>>>>>>>    // enabling themselves because the check current_shadow_state when they
7346>>>>>>>    // are activated. Hidden states were getting in the way
7346>>>>>>>    // Also, keep track of current clientsize for future paging and anchoring
7346>>>>>>>    //
7346>>>>>>>    Procedure Remove_Object
7348>>>>>>>        Set piLastClientSize to (client_size(Self)) // will get used next time tab is paged
7349>>>>>>>        If (pbHidePage(Self)) ;            Send DoHideTab False  // if explicitly hidden, un hide it before removing it.
7352>>>>>>>        Forward Send remove_object
7354>>>>>>>    End_Procedure
