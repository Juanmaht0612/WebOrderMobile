3154>>>>>    // augment right mouse down to pop up a floating panel. Only do this if
3154>>>>>    // the object successfully takes the focus.
3154>>>>>    //
3154>>>>>    Procedure Mouse_Down2 Integer iWindowNumber Integer iPosition
3156>>>>>        Integer obj rval iCur
3156>>>>>        Forward Send mouse_down2 iWindowNumber iPosition
3158>>>>>        // The item number should be 1 based, Hence a 0 is invalid. This can happen
3158>>>>>        // when you click in a grid to the right of the last column.
3158>>>>>        If (iWindowNumber>0) Begin
3160>>>>>            Get Floating_Menu_object to obj
3161>>>>>            If obj Begin
3163>>>>>                If (Focus(desktop)<>Self) Begin
3165>>>>>                    Get msg_Activate to rval
3166>>>>>                End
3166>>>>>>
3166>>>>>                
3166>>>>>                If ( focus(desktop)=Self) Begin
3168>>>>>                    Move (iWindowNumber-1+Top_Item(Self)) to iCur
3169>>>>>                    
3169>>>>>                    If (iCur < Item_Count(Self)) Begin // make sure the item is valud
3171>>>>>                        If (not(shadow_state(Self,iCur))) Begin
3173>>>>>                            If ( Item_window(Self)<>iWindowNumber ) Begin
3175>>>>>                                Set Current_Item to iCur
3176>>>>>                            End
3176>>>>>>
3176>>>>>                            If ( Item_window(Self)=iWindowNumber) Begin
3178>>>>>                                Send Popup to obj
3179>>>>>                            End
3179>>>>>>
3179>>>>>                        End
3179>>>>>>
3179>>>>>                    End
3179>>>>>>
3179>>>>>                End
3179>>>>>>
3179>>>>>            End
3179>>>>>>
3179>>>>>        End
3179>>>>>>
3179>>>>>    End_Procedure
3180>>>>>End_Class
