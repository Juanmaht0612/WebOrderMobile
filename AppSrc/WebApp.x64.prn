25960>>>>>>>>>>>>>>>>>>>
25960>>>>>>>>>>>>>>>>>>>// An instance of this class can be used as a broker object to
25960>>>>>>>>>>>>>>>>>>>// call several CLI releated methods.                         
25960>>>>>>>>>>>>>>>>>>>
25960>>>>>>>>>>>>>>>>>>>//Class cCLIHandler is a cObject
25960>>>>>>>>>>>>>>>>>>>Class cCLIHandler is an Array
25961>>>>>>>>>>>>>>>>>>>    
25961>>>>>>>>>>>>>>>>>>>    Procedure Construct_Object 
25963>>>>>>>>>>>>>>>>>>>        Forward Send Construct_object 
25965>>>>>>>>>>>>>>>>>>>        
25965>>>>>>>>>>>>>>>>>>>        Property String  psDriverID        ""
25966>>>>>>>>>>>>>>>>>>>    End_Procedure
25967>>>>>>>>>>>>>>>>>>>    
25967>>>>>>>>>>>>>>>>>>>    
25967>>>>>>>>>>>>>>>>>>>    
25967>>>>>>>>>>>>>>>>>>>    // The revsion of a CLI Connectivity Kit
25967>>>>>>>>>>>>>>>>>>>    Function CKRevision Returns String
25969>>>>>>>>>>>>>>>>>>>        String  sDriverID
25969>>>>>>>>>>>>>>>>>>>        String  sRevision
25969>>>>>>>>>>>>>>>>>>>        String  sVoid
25969>>>>>>>>>>>>>>>>>>>        Integer iRetval
25969>>>>>>>>>>>>>>>>>>>        
25969>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriverID
25970>>>>>>>>>>>>>>>>>>>        If (sDRiverID <> "") Begin
25972>>>>>>>>>>>>>>>>>>>            Move (Repeat(" ", 255)) to sRevision
25973>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDRiverID Function CLI_CKREVISION Callback 0 Passing sRevision sVoid 0 Result iRetval
25978>>>>>>>>>>>>>>>>>>>        End
25978>>>>>>>>>>>>>>>>>>>>
25978>>>>>>>>>>>>>>>>>>>        
25978>>>>>>>>>>>>>>>>>>>        Function_Return sRevision
25979>>>>>>>>>>>>>>>>>>>    End_Function
25980>>>>>>>>>>>>>>>>>>>    
25980>>>>>>>>>>>>>>>>>>>    
25980>>>>>>>>>>>>>>>>>>>    
25980>>>>>>>>>>>>>>>>>>>    // Extarct the Nth part of a a.b.c.d revsion string.
25980>>>>>>>>>>>>>>>>>>>    // Returns : The part version number or -1 if there is no such part number.
25980>>>>>>>>>>>>>>>>>>>    //
25980>>>>>>>>>>>>>>>>>>>    Function ExtractPartFromRevision Integer iPartNum String sRevision Returns Integer
25982>>>>>>>>>>>>>>>>>>>        Integer iPartRev
25982>>>>>>>>>>>>>>>>>>>        Integer iCurrentPart
25982>>>>>>>>>>>>>>>>>>>        Integer iSeparatorPos
25982>>>>>>>>>>>>>>>>>>>        
25982>>>>>>>>>>>>>>>>>>>        If (iPartNum > 4) ;            Function_Return -1
25985>>>>>>>>>>>>>>>>>>>        
25985>>>>>>>>>>>>>>>>>>>        Move 0 to iCurrentPart
25986>>>>>>>>>>>>>>>>>>>        Repeat
25986>>>>>>>>>>>>>>>>>>>>
25986>>>>>>>>>>>>>>>>>>>            Move (Pos(".", sRevision)) to iSeparatorPos
25987>>>>>>>>>>>>>>>>>>>            If (iSeparatorPos > 0) Begin
25989>>>>>>>>>>>>>>>>>>>                Move (Left(sRevision, iSeparatorPos - 1)) to iPartRev
25990>>>>>>>>>>>>>>>>>>>                Move (Right(sRevision, Length(sRevision) - iSeparatorPos)) to sRevision
25991>>>>>>>>>>>>>>>>>>>                Increment iCurrentPart
25992>>>>>>>>>>>>>>>>>>>            End
25992>>>>>>>>>>>>>>>>>>>>
25992>>>>>>>>>>>>>>>>>>>            Else If (sRevision <> "") Begin
25995>>>>>>>>>>>>>>>>>>>                Move sRevision to iPartRev
25996>>>>>>>>>>>>>>>>>>>                Move "" to sRevision
25997>>>>>>>>>>>>>>>>>>>                Increment iCurrentPart
25998>>>>>>>>>>>>>>>>>>>            End
25998>>>>>>>>>>>>>>>>>>>>
25998>>>>>>>>>>>>>>>>>>>            Else ;                Move -1 to iPartRev
26000>>>>>>>>>>>>>>>>>>>        Until (iCurrentPart >= iPartNum or iPartRev = -1)
26002>>>>>>>>>>>>>>>>>>>        
26002>>>>>>>>>>>>>>>>>>>        Function_Return iPartRev
26003>>>>>>>>>>>>>>>>>>>    End_Function
26004>>>>>>>>>>>>>>>>>>>    
26004>>>>>>>>>>>>>>>>>>>    
26004>>>>>>>>>>>>>>>>>>>    
26004>>>>>>>>>>>>>>>>>>>    // Returns the major revision of the CK
26004>>>>>>>>>>>>>>>>>>>    //
26004>>>>>>>>>>>>>>>>>>>    Function CKMajorRevision Returns Integer
26006>>>>>>>>>>>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 1, CKRevision(Self)))
26007>>>>>>>>>>>>>>>>>>>    End_Function
26008>>>>>>>>>>>>>>>>>>>    
26008>>>>>>>>>>>>>>>>>>>    
26008>>>>>>>>>>>>>>>>>>>    
26008>>>>>>>>>>>>>>>>>>>    // Returns the minor revision of the CK
26008>>>>>>>>>>>>>>>>>>>    //
26008>>>>>>>>>>>>>>>>>>>    Function CKMinorRevision Returns Integer
26010>>>>>>>>>>>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 2, CKRevision(Self)))
26011>>>>>>>>>>>>>>>>>>>    End_Function
26012>>>>>>>>>>>>>>>>>>>    
26012>>>>>>>>>>>>>>>>>>>    
26012>>>>>>>>>>>>>>>>>>>    
26012>>>>>>>>>>>>>>>>>>>    // Returns the release revision of the CK
26012>>>>>>>>>>>>>>>>>>>    //
26012>>>>>>>>>>>>>>>>>>>    Function CKReleaseRevision Returns Integer
26014>>>>>>>>>>>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 3, CKRevision(Self)))
26015>>>>>>>>>>>>>>>>>>>    End_Function
26016>>>>>>>>>>>>>>>>>>>    
26016>>>>>>>>>>>>>>>>>>>    
26016>>>>>>>>>>>>>>>>>>>    
26016>>>>>>>>>>>>>>>>>>>    // Returns the major revision of the CK
26016>>>>>>>>>>>>>>>>>>>    //
26016>>>>>>>>>>>>>>>>>>>    Function CKBuildRevision Returns Integer
26018>>>>>>>>>>>>>>>>>>>        Function_Return (ExtractPartFromRevision (Self, 4, CKRevision(Self)))
26019>>>>>>>>>>>>>>>>>>>    End_Function
26020>>>>>>>>>>>>>>>>>>>    
26020>>>>>>>>>>>>>>>>>>>    
26020>>>>>>>>>>>>>>>>>>>    
26020>>>>>>>>>>>>>>>>>>>    // Determines if the CK conforms to a passed minimal revsion.
26020>>>>>>>>>>>>>>>>>>>    //
26020>>>>>>>>>>>>>>>>>>>    Function IsMinimalRevision Integer iMajor Integer iMinor Integer iRelease Integer iBuild Returns Integer
26022>>>>>>>>>>>>>>>>>>>        If (iMajor < CKMajorRevision(Self)) ;            Function_Return (True)
26025>>>>>>>>>>>>>>>>>>>        Else If (iMajor = CKMajorRevision(Self)) Begin
26028>>>>>>>>>>>>>>>>>>>            If (iMinor < CKMinorRevision(Self)) ;                Function_Return (True)
26031>>>>>>>>>>>>>>>>>>>            Else If (iMinor = CKMinorRevision(Self)) Begin
26034>>>>>>>>>>>>>>>>>>>                If (iRelease < CKReleaseRevision(Self)) ;                    Function_Return (True)
26037>>>>>>>>>>>>>>>>>>>                Else If (iRelease = CKReleaseRevision(Self) and iBuild <= CKBuildRevision(Self)) ;                    Function_Return (True)
26041>>>>>>>>>>>>>>>>>>>            End
26041>>>>>>>>>>>>>>>>>>>>
26041>>>>>>>>>>>>>>>>>>>        End
26041>>>>>>>>>>>>>>>>>>>>
26041>>>>>>>>>>>>>>>>>>>        
26041>>>>>>>>>>>>>>>>>>>        Function_Return (False)
26042>>>>>>>>>>>>>>>>>>>    End_Function
26043>>>>>>>>>>>>>>>>>>>    
26043>>>>>>>>>>>>>>>>>>>    
26043>>>>>>>>>>>>>>>>>>>    
26043>>>>>>>>>>>>>>>>>>>    // Returns the Connectiivty Kit registration name.
