4853>>>>>    // 1. Modified to optimize painting and make scrolling work properly
4853>>>>>    // 2. Add Request_Status_Help for item changes.
4853>>>>>    Procedure Set Current_Item Integer Itm
4855>>>>>        Integer IsFoc
4855>>>>>        Integer oldst oldtop
4855>>>>>        Move (Focus(Desktop)=Self) to IsFoc
4856>>>>>        If IsFoc ;            Send Request_Status_Help False
4859>>>>>        Get dynamic_update_state to oldst
4860>>>>>        Set Dynamic_Update_State to False
4861>>>>>        Get top_item             to oldtop // we need to know if to-item changes
4862>>>>>        Forward Set Current_Item to Itm
4864>>>>>        // If dyn had been on, we pass 1 (refresh all) if we scrolled and a
4864>>>>>        // 2 (refresh dirty cells) if we did not scroll. Note that other
4864>>>>>        // processes might have dirtied the cells so that a "2" becomes
4864>>>>>        // equivalent to a "1"
4864>>>>>        If oldst ; // if top_Item changed we scrolled!            Move (If(Top_Item(Self)<>OldTop,1,2)) to OldSt
4867>>>>>        Set dynamic_update_State to OldSt
4868>>>>>        If IsFoc ;            Send Request_Status_Help True
4871>>>>>    End_Procedure
4872>>>>>    
4872>>>>>    Procedure Set New_Item Integer Itm
4874>>>>>        Integer IsFoc
4874>>>>>        Integer oldst oldtop
4874>>>>>        Move (Focus(Desktop)=Self) to IsFoc
4875>>>>>        If IsFoc ;            Send Request_Status_Help False
4878>>>>>        Get dynamic_update_state to oldst
4879>>>>>        Set Dynamic_Update_State to False
4880>>>>>        Get top_item             to oldtop // we need to know if to-item changes
4881>>>>>        Forward Set New_Item to Itm
4883>>>>>        // If dyn had been on, we pass 1 (refresh all) if we scrolled and a
4883>>>>>        // 2 (refresh dirty cells) if we did not scroll. Note that other
4883>>>>>        // processes might have dirtied the cells so that a "2" becomes
4883>>>>>        // equivalent to a "1"
4883>>>>>        If oldst ; // if top_Item changed we scrolled!            Move (If(Top_Item(Self)<>OldTop,1,2)) to OldSt
4886>>>>>        Set dynamic_update_State to OldSt
4887>>>>>        If IsFoc ;            Send Request_Status_Help True
4890>>>>>    End_Procedure
4891>>>>>    
4891>>>>>    // when active a grid does not repaint new items on the screen
4891>>>>>    // This forces a repaint when an item is added.
4891>>>>>    Procedure Add_Item Integer iMessage String sValue
4893>>>>>        Integer bOld
4893>>>>>        Get dynamic_update_state to bOld
4894>>>>>        Set Dynamic_Update_State to False
4895>>>>>        Forward Send add_item iMessage sValue
4897>>>>>        Set dynamic_update_State to bOld
4898>>>>>    End_Procedure
4899>>>>>    
4899>>>>>    //  Modified to works as follows:
4899>>>>>    //     If 0, turn DUS off
4899>>>>>    //     If 1, Invalidate all cells and make it "2"
4899>>>>>    //     If 2, repaint only invalid cells plus scroll bars. Not Header
4899>>>>>    //     If 3, repaint everything (including headers)
4899>>>>>    //  When complete a 1,2 or 3 will set this property to 1.
4899>>>>>    //
4899>>>>>    Procedure Set Dynamic_Update_State Integer st
4901>>>>>        If (St = 1) Begin
4903>>>>>            Send Scroll_Paint // this invalidates all cells
4904>>>>>            Move 2 to st      // Change state to only paint invalid cells
4905>>>>>        End                  // plus scroll bars
4905>>>>>>
4905>>>>>        Else ;            If (St = 3) ;                Move 1 to st // if 3, repaint EVERYTHING
4909>>>>>        // runtime understands 0,1,2. If 2, final prop value will be 1
4909>>>>>        Forward Set Dynamic_Update_State to st
4911>>>>>    End_Procedure
4912>>>>>    
4912>>>>>    // Return the column of the passed item
4912>>>>>    //
4912>>>>>    Function Column Integer Item# Returns Integer
4914>>>>>        If (Item#=CURRENT) Begin      // if the CURRENT symbol replace with current Item
4916>>>>>            Get Current_Item to Item#
4917>>>>>        End
4917>>>>>>
4917>>>>>        Function_Return (Mod(Item#,Line_Size(Self)))
4918>>>>>    End_Function
4919>>>>>    
4919>>>>>    // Return the column of the current-item
4919>>>>>    //
4919>>>>>    Function Current_Col Returns Integer
4921>>>>>        Function_Return (Column(Self,Current_Item(Self)))
4922>>>>>    End_Function
4923>>>>>    
4923>>>>>    // Support for Beginning_of_Data and End_of_Data
4923>>>>>    // Note that these messsages are Column sensitive. They do not
4923>>>>>    // switch columns.
4923>>>>>    
4923>>>>>    
4923>>>>>    // Jump to the first column
4923>>>>>    Procedure Beginning_of_Data
4925>>>>>        Set current_item to (Current_Col(Self))
4926>>>>>    End_Procedure
4927>>>>>    
4927>>>>>    // jump to the last column
4927>>>>>    Procedure End_of_Data
4929>>>>>        Integer col cols itmCnt
4929>>>>>        Get line_size   to cols        // columns in a row
4930>>>>>        Get Current_col to col         // the current column of the item
4931>>>>>        Get item_count  to itmCnt
4932>>>>>        Decrement ItmCnt
4933>>>>>        // Integer math at work.
4933>>>>>        Move ( (ItmCnt/cols)*cols+col) to col // column in last row
4934>>>>>        // if we had a case where the last item was not in the last column
4934>>>>>        // we could get an error. While unlikely we we check for this.
4934>>>>>        Set current_item to (itmCnt min col)
4935>>>>>    End_Procedure
4936>>>>>    
4936>>>>>    // 1. Is column sensitive. It will never scroll out of the
4936>>>>>    //    current column
4936>>>>>    // 2. Painting fixes and optimizations - no flickering
4936>>>>>    Procedure Scroll Integer eDirection Integer iNumLines
4938>>>>>        Integer oldst oldtop itm cols col col2 st items
4938>>>>>        Get Current_Item     to Itm       // current item
4939>>>>>        Get Line_Size        to cols      // number of columns
4940>>>>>        If (iNumLines = 0) ;                    // if iNumLines is not passed,            Get Displayable_Rows to Items  // use # displayable rows
4943>>>>>        Else ;            Move iNumLines to Items
4945>>>>>        Move (Items * Cols) to Items      // number of items we are scrolling
4946>>>>>        
4946>>>>>        // If we are at the end of the list jump to the last column
4946>>>>>        // Else if we are at the top of the list, jump to the first column
4946>>>>>        // Else do a normal scroll
4946>>>>>        
4946>>>>>        // We do this because the runtime scroll at the end of a page
4946>>>>>        // may change columns which forces a complete repaint.
4946>>>>>        If (eDirection=DOWNWARD_DIRECTION and (Itm+Items>Item_Count(Self)) ) ;            Send end_of_data
4949>>>>>        Else If (eDirection=UPWARD_DIRECTION and (Itm-Items<0) ) ;            Send Beginning_of_data
4953>>>>>        Else Begin
4954>>>>>            // This will always involve a top_item change. So we will shut
4954>>>>>            // off dynamic update and turn it back on with a 1 (which means
4954>>>>>            // first invalidate all cells)
4954>>>>>            Get dynamic_update_state to oldst
4955>>>>>            Set Dynamic_Update_State to False
4956>>>>>            //Forward Send scroll dir dist       // normal scroll
4956>>>>>            // if iNumLines is 0, pass 0 and it figures it out, else you must pass the
4956>>>>>            // number of items to scroll. Note inconsistency here. You are passed number of rows
4956>>>>>            // and forward # of items
4956>>>>>            Forward Send scroll eDirection (If(iNumLines=0,iNumLines,items))       // normal scroll
4958>>>>>            Set dynamic_update_State to OldSt
4959>>>>>        End
4959>>>>>>
4959>>>>>    End_Procedure
4960>>>>>    
4960>>>>>    //Focus change to object does not send notify_focus_change.
