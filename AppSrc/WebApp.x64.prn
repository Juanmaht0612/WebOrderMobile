26102>>>>>>>>>>>>>>>>>>>    // Convert a text to the corresponding
26102>>>>>>>>>>>>>>>>>>>    // Generate_Record_ID_Method attribute value
26102>>>>>>>>>>>>>>>>>>>    //
26102>>>>>>>>>>>>>>>>>>>    Function TextToRIMValue String sText Returns Integer
26104>>>>>>>>>>>>>>>>>>>        If (sText = "None") ;            Function_Return RIM_NONE
26107>>>>>>>>>>>>>>>>>>>        Else If (sText = "Identity Column") ;            Function_Return RIM_IDENTITY_COLUMN
26111>>>>>>>>>>>>>>>>>>>        Else If (sText = "Dispenser Table") ;            Function_Return RIM_DISPENSER_TABLE
26115>>>>>>>>>>>>>>>>>>>        Else If (sText = "External") ;            Function_Return RIM_EXTERNAL
26119>>>>>>>>>>>>>>>>>>>    End_Function
26120>>>>>>>>>>>>>>>>>>>    
26120>>>>>>>>>>>>>>>>>>>    
26120>>>>>>>>>>>>>>>>>>>    
26120>>>>>>>>>>>>>>>>>>>    // Convert a Generate_Record_ID_Method attribute value to the
26120>>>>>>>>>>>>>>>>>>>    // corresponding text.
26120>>>>>>>>>>>>>>>>>>>    //
26120>>>>>>>>>>>>>>>>>>>    Function RIMValueToText Integer iAttrValue Returns String
26122>>>>>>>>>>>>>>>>>>>        If (iAttrValue = RIM_NONE) ;            Function_Return "None"
26125>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RIM_IDENTITY_COLUMN) ;            Function_Return "Identity Column"
26129>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RIM_DISPENSER_TABLE) ;            Function_Return "Dispenser Table"
26133>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RIM_EXTERNAL) ;            Function_Return "External"
26137>>>>>>>>>>>>>>>>>>>    End_Function
26138>>>>>>>>>>>>>>>>>>>    
26138>>>>>>>>>>>>>>>>>>>    
26138>>>>>>>>>>>>>>>>>>>    
26138>>>>>>>>>>>>>>>>>>>    // Convert a text to the corresponding
26138>>>>>>>>>>>>>>>>>>>    // Generate_Record_ID_Method attribute value
26138>>>>>>>>>>>>>>>>>>>    //
26138>>>>>>>>>>>>>>>>>>>    Function TextToROValue String sText Returns Integer
26140>>>>>>>>>>>>>>>>>>>        If (sText = "No") ;            Function_Return RO_NO
26143>>>>>>>>>>>>>>>>>>>        Else If (sText = "Ignore Change") ;            Function_Return RO_IGNORECHANGE
26147>>>>>>>>>>>>>>>>>>>        Else If (sText = "Accept Change") ;            Function_Return RO_ACCEPTCHANGE
26151>>>>>>>>>>>>>>>>>>>        Else If (sText = "Error On Change") ;            Function_Return RO_ERRORONCHANGE
26155>>>>>>>>>>>>>>>>>>>    End_Function
26156>>>>>>>>>>>>>>>>>>>    
26156>>>>>>>>>>>>>>>>>>>    
26156>>>>>>>>>>>>>>>>>>>    
26156>>>>>>>>>>>>>>>>>>>    // Convert a Generate_Record_ID_Method attribute value to the
26156>>>>>>>>>>>>>>>>>>>    // corresponding text.
26156>>>>>>>>>>>>>>>>>>>    //
26156>>>>>>>>>>>>>>>>>>>    Function ROValueToText Integer iAttrValue Returns String
26158>>>>>>>>>>>>>>>>>>>        If (iAttrValue = RO_NO) ;            Function_Return "No"
26161>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RO_IGNORECHANGE) ;            Function_Return "Ignore Change"
26165>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RO_ACCEPTCHANGE) ;            Function_Return "Accept Change"
26169>>>>>>>>>>>>>>>>>>>        Else If (iAttrValue = RO_ERRORONCHANGE) ;            Function_Return "Error On Change"
26173>>>>>>>>>>>>>>>>>>>    End_Function
