24245>>>>>>>>>>>// Singleton object that is the central manager for all web properties handlers. It is accessed by
24245>>>>>>>>>>>// the cWebApp class when needed and WebSet and WebGet are handled here. It has forwards these 
24245>>>>>>>>>>>// operations to the handler objects for the different web property types. These handlers are 
24245>>>>>>>>>>>// created by this class and all share a generic API (cWebBasePropertyHandler). These different types 
24245>>>>>>>>>>>// are Client (web properties stored and used on the client), Server (web properties stored on the 
24245>>>>>>>>>>>// server bound to the page scope) and ServerSession (web properties stored on the server bound to 
24245>>>>>>>>>>>// the session lifetime).
24245>>>>>>>>>>>//
24245>>>>>>>>>>>
24245>>>>>>>>>>>
24245>>>>>>>>>>>
24245>>>>>>>>>>>Class cWebPropertyHost_mixin is a Mixin
24246>>>>>>>>>>>    Procedure Define_cWebPropertyHost_mixin
24248>>>>>>>>>>>        
24248>>>>>>>>>>>        Property String psSPKey ""                     // Web property storing the identifier key for server-side properties with a page lifetime
24251>>>>>>>>>>>        
24251>>>>>>>>>>>        //  Initialize and store handles to the three different handlers
24251>>>>>>>>>>>        Property Handle phoClientHandler C_WebUnresolvedObject
24252>>>>>>>>>>>        Property Handle phoServerHandler C_WebUnresolvedObject
24253>>>>>>>>>>>        Property Handle phoSessionHandler C_WebUnresolvedObject
24254>>>>>>>>>>>        Property Handle phoClientProtectedHandler C_WebUnresolvedObject
24255>>>>>>>>>>>        
24255>>>>>>>>>>>        Send InitPropertyManager
24256>>>>>>>>>>>    End_Procedure
24257>>>>>>>>>>>    
24257>>>>>>>>>>>    Procedure InitPropertyManager
24259>>>>>>>>>>>        Error DFERR_PROGRAM "Not implemented"
24260>>>>>>>>>>>>
24260>>>>>>>>>>>    End_Procedure
24261>>>>>>>>>>>    
24261>>>>>>>>>>>    //
24261>>>>>>>>>>>    //  Clear web properties between requests!
24261>>>>>>>>>>>    //
24261>>>>>>>>>>>    Procedure Call_ClearPropertyHost
24263>>>>>>>>>>>        Send ClearData of (phoClientHandler(Self))
24264>>>>>>>>>>>        Send ClearData of (phoServerHandler(Self))
24265>>>>>>>>>>>        Send ClearData of (phoSessionHandler(Self))
24266>>>>>>>>>>>    End_Procedure
24267>>>>>>>>>>>    
24267>>>>>>>>>>>    
24267>>>>>>>>>>>    //
24267>>>>>>>>>>>    //  Central WebGet handler for non-scalar (advanced) web properties.
24267>>>>>>>>>>>    //  Forwards the request to the handler for the specific web property type (Client, Server, ServerSession).
24267>>>>>>>>>>>    //
24267>>>>>>>>>>>    Function OwnerGetAdvSyncProp Handle hoObject tWebPropMetaData ByRef pubProp Returns Variant
24269>>>>>>>>>>>        Handle hoHandler
24269>>>>>>>>>>>        Boolean bIsAjaxWebObject
24269>>>>>>>>>>>        String sObject 
24269>>>>>>>>>>>        Variant vReturn
24269>>>>>>>>>>>        
24269>>>>>>>>>>>        // Test that the target object is a cWebObject....
24269>>>>>>>>>>>        Get IsAjaxWebObject of hoObject to bIsAjaxWebObject
24270>>>>>>>>>>>        
24270>>>>>>>>>>>        If (not(bIsAjaxWebObject)) Begin
24272>>>>>>>>>>>            Get Object_Label of hoObject to sObject
24273>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppNotWebObject, sObject, "WebGet " + pubProp.sName, C_NewLine+C_NewLine))
24274>>>>>>>>>>>>
24274>>>>>>>>>>>            Function_Return
24275>>>>>>>>>>>        End
24275>>>>>>>>>>>>
24275>>>>>>>>>>>        
24275>>>>>>>>>>>        //  Get and call handler
24275>>>>>>>>>>>        Get PropertyHandler hoObject pubProp.eMode to hoHandler
24276>>>>>>>>>>>        If (hoHandler = -1) Begin
24278>>>>>>>>>>>            Get Object_Label of hoObject to sObject
24279>>>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Property '%2' of object '%1' is not a valid web property for %3.%4Check the web property meta value.", pubProp.sName, sObject, "WebGet", C_NewLine+C_NewLine))        
24280>>>>>>>>>>>>
24280>>>>>>>>>>>            Function_Return
24281>>>>>>>>>>>        End
24281>>>>>>>>>>>>
24281>>>>>>>>>>>        
24281>>>>>>>>>>>        Get GetAdvSyncProp of hoHandler hoObject (&pubProp) to vReturn  
24282>>>>>>>>>>>        Function_Return vReturn  
24283>>>>>>>>>>>    End_Function
