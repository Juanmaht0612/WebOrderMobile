23439>>>>>>>            If (Main_File(hoParentDD)=iParentTable) Begin
23441>>>>>>>                Function_Return hoParentDD
23442>>>>>>>            End
23442>>>>>>>>
23442>>>>>>>        Loop
23443>>>>>>>>
23443>>>>>>>        Function_Return 0
23444>>>>>>>    End_Function
