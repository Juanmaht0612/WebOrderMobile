9939>>>    Function RegistryKeyString Returns String
9941>>>        String sCompany sProduct sVersion sProgram
9941>>>        
9941>>>        Get psCompany to sCompany
9942>>>        Get psProduct to sProduct
9943>>>        Get psVersion to sVersion
9944>>>        Get psProgram to sProgram
9945>>>        
9945>>>        If (sCompany = "") ;            Move "Data Access Worldwide" to sCompany
9948>>>        If (sProduct = "") ;            Move "DataFlex Applications" to sProduct
9951>>>        If (sVersion = "") ;            Move C_DFVersion             to sVersion
9954>>>        If (sProgram ="") ;            Move (Module_Name(desktop))   to sProgram
9957>>>        
9957>>>        Function_Return ("SOFTWARE\" +sCompany +"\" +sProduct +"\" +sVersion +"\" +sProgram)
9958>>>    End_Function
