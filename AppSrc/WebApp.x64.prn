6552>>>>>>>        Get Window_Handle to hWnd
6553>>>>>>>        If hWnd Begin
6555>>>>>>>            Move (GetWindowLongPtr(hWnd, GWL_STYLE)) to iStyle
6556>>>>>>>            If bMultiLine ;                Move (AddBitValue(TCS_MULTILINE, iStyle))    to iStyle
6559>>>>>>>            Else ;                Move (RemoveBitValue(TCS_MULTILINE, iStyle)) to iStyle
6561>>>>>>>            Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle)) to iVoid
6562>>>>>>>        End
6562>>>>>>>>
6562>>>>>>>    End_Procedure
