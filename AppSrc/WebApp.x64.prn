18215>>>>>>>>>        Get phoHost to hoHost
18216>>>>>>>>>        
18216>>>>>>>>>        If (hoHost = C_WebUnresolvedObject) Begin
18218>>>>>>>>>            Delegate Get FindHost to hoHost
