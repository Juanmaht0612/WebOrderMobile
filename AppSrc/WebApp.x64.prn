26251>>>>>>>>>>>>>>>>>>>        Integer iVoid
26251>>>>>>>>>>>>>>>>>>>        
26251>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26252>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26254>>>>>>>>>>>>>>>>>>>            Move (Repeat(" ", 1024)) to sTableComment
26255>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_TABLECOMMENT Callback 0 Passing sTableComment sVoid iIndex Result iVoid
26260>>>>>>>>>>>>>>>>>>>        End
26260>>>>>>>>>>>>>>>>>>>>
26260>>>>>>>>>>>>>>>>>>>        
26260>>>>>>>>>>>>>>>>>>>        Function_Return sTableComment
26261>>>>>>>>>>>>>>>>>>>    End_Function
26262>>>>>>>>>>>>>>>>>>>    
26262>>>>>>>>>>>>>>>>>>>    // Enumerate the columns in a table
26262>>>>>>>>>>>>>>>>>>>    //
26262>>>>>>>>>>>>>>>>>>>    Function EnumerateColumns String sLogin String sTableName Returns Integer
26264>>>>>>>>>>>>>>>>>>>        String  sDriver
26264>>>>>>>>>>>>>>>>>>>        Integer iNumColumns
26264>>>>>>>>>>>>>>>>>>>        Integer iVoid
26264>>>>>>>>>>>>>>>>>>>        
26264>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26265>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") ;            Call_Driver 0 sDriver Function CLI_ENUMERATE_COLUMNS Callback 0 Passing sLogin sTablename iVoid Result iNumColumns
26272>>>>>>>>>>>>>>>>>>>        
26272>>>>>>>>>>>>>>>>>>>        Function_Return iNumColumns
26273>>>>>>>>>>>>>>>>>>>    End_Function
26274>>>>>>>>>>>>>>>>>>>    
26274>>>>>>>>>>>>>>>>>>>    
26274>>>>>>>>>>>>>>>>>>>    
26274>>>>>>>>>>>>>>>>>>>    // Returns the name of the column enumerated at the given position
26274>>>>>>>>>>>>>>>>>>>    //
26274>>>>>>>>>>>>>>>>>>>    Function ColumnName Integer iIndex Returns String
26276>>>>>>>>>>>>>>>>>>>        String  sDriver
26276>>>>>>>>>>>>>>>>>>>        String  sColumnName
26276>>>>>>>>>>>>>>>>>>>        String  sVoid
26276>>>>>>>>>>>>>>>>>>>        Integer iVoid
26276>>>>>>>>>>>>>>>>>>>        
26276>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26277>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26279>>>>>>>>>>>>>>>>>>>            Move (Repeat(" ", 255)) to sColumnName
26280>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_COLUMNNAME Callback 0 Passing sColumnName sVoid iIndex Result iVoid
26285>>>>>>>>>>>>>>>>>>>        End
26285>>>>>>>>>>>>>>>>>>>>
26285>>>>>>>>>>>>>>>>>>>        
26285>>>>>>>>>>>>>>>>>>>        Function_Return sColumnName
26286>>>>>>>>>>>>>>>>>>>    End_Function
26287>>>>>>>>>>>>>>>>>>>    
26287>>>>>>>>>>>>>>>>>>>    // Convert a DataFlex date to a SQL date using the dummy zero date value.
26287>>>>>>>>>>>>>>>>>>>    //
26287>>>>>>>>>>>>>>>>>>>    Function CLIDFDateToSQLDate String sDriver Date dDFDate Returns String
26289>>>>>>>>>>>>>>>>>>>        
26289>>>>>>>>>>>>>>>>>>>        Integer iDriverIndex
26289>>>>>>>>>>>>>>>>>>>        
26289>>>>>>>>>>>>>>>>>>>        String sSQLDate
26289>>>>>>>>>>>>>>>>>>>        Integer iOrgDateFmt
26289>>>>>>>>>>>>>>>>>>>        Integer iOrgDateSep
26289>>>>>>>>>>>>>>>>>>>        
26289>>>>>>>>>>>>>>>>>>>        // Change date format to military, SQL dates are military dates
26289>>>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
26292>>>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
26295>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
26298>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
26301>>>>>>>>>>>>>>>>>>>        
26301>>>>>>>>>>>>>>>>>>>        If (Integer(dDFDate) = 0) Begin
26303>>>>>>>>>>>>>>>>>>>            // Return the dummy zero date
26303>>>>>>>>>>>>>>>>>>>            Get DriverIndex sDriver to iDriverIndex
26304>>>>>>>>>>>>>>>>>>>            If (iDriverIndex <> 0) Begin
26306>>>>>>>>>>>>>>>>>>>                Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sSQLDate
26309>>>>>>>>>>>>>>>>>>>            End
26309>>>>>>>>>>>>>>>>>>>>
26309>>>>>>>>>>>>>>>>>>>            Else Begin
26310>>>>>>>>>>>>>>>>>>>                Move '0001-01-01' to sSQLDate
26311>>>>>>>>>>>>>>>>>>>            End
26311>>>>>>>>>>>>>>>>>>>>
26311>>>>>>>>>>>>>>>>>>>        End
26311>>>>>>>>>>>>>>>>>>>>
26311>>>>>>>>>>>>>>>>>>>        Else Begin
26312>>>>>>>>>>>>>>>>>>>            Move dDFDate to sSQLDate
26313>>>>>>>>>>>>>>>>>>>        End
26313>>>>>>>>>>>>>>>>>>>>
26313>>>>>>>>>>>>>>>>>>>        
26313>>>>>>>>>>>>>>>>>>>        // Change date format back to original
26313>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
26316>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
26319>>>>>>>>>>>>>>>>>>>        
26319>>>>>>>>>>>>>>>>>>>        Function_Return sSQLDate
26320>>>>>>>>>>>>>>>>>>>    End_Function
26321>>>>>>>>>>>>>>>>>>>    
26321>>>>>>>>>>>>>>>>>>>    
26321>>>>>>>>>>>>>>>>>>>    
26321>>>>>>>>>>>>>>>>>>>    // Convert a SQL date to a DataFlex date using the dummy zero date value.
26321>>>>>>>>>>>>>>>>>>>    Function CLISQLDateToDFDate String sDriver String sSQLDate Returns Date
26323>>>>>>>>>>>>>>>>>>>        
26323>>>>>>>>>>>>>>>>>>>        Integer iDriverIndex
26323>>>>>>>>>>>>>>>>>>>        
26323>>>>>>>>>>>>>>>>>>>        Date dDFDate
26323>>>>>>>>>>>>>>>>>>>        String sDummyDateValue
26323>>>>>>>>>>>>>>>>>>>        Integer iOrgDateFmt
26323>>>>>>>>>>>>>>>>>>>        Integer iOrgDateSep
26323>>>>>>>>>>>>>>>>>>>        
26323>>>>>>>>>>>>>>>>>>>        // Change date format to military, SQL dates are military dates
26323>>>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_FORMAT to iOrgDateFmt
26326>>>>>>>>>>>>>>>>>>>        Get_Attribute DF_DATE_SEPARATOR to iOrgDateSep
26329>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to DF_DATE_MILITARY
26332>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to (Ascii('-'))
26335>>>>>>>>>>>>>>>>>>>        
26335>>>>>>>>>>>>>>>>>>>        // We only need to convert if the date is the dummy zero date value
26335>>>>>>>>>>>>>>>>>>>        Get DriverIndex sDriver to iDriverIndex
26336>>>>>>>>>>>>>>>>>>>        If (iDriverIndex <> 0) Begin
26338>>>>>>>>>>>>>>>>>>>            Get_Attribute DF_DRIVER_DUMMY_ZERO_DATE_VALUE of iDriverIndex to sDummyDateValue
26341>>>>>>>>>>>>>>>>>>>        End
26341>>>>>>>>>>>>>>>>>>>>
26341>>>>>>>>>>>>>>>>>>>        Else Begin
26342>>>>>>>>>>>>>>>>>>>            Move '0001-01-01' to sDummyDateValue
26343>>>>>>>>>>>>>>>>>>>        End
26343>>>>>>>>>>>>>>>>>>>>
26343>>>>>>>>>>>>>>>>>>>        If (sDummyDateValue = sSQLDate) ;            Move 0 to dDFDate
26346>>>>>>>>>>>>>>>>>>>        Else ;            Move sSQLDate to dDFDate
26348>>>>>>>>>>>>>>>>>>>        
26348>>>>>>>>>>>>>>>>>>>        // Change date format back to original
26348>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_FORMAT to iOrgDateFmt
26351>>>>>>>>>>>>>>>>>>>        Set_Attribute DF_DATE_SEPARATOR to iOrgDateSep
26354>>>>>>>>>>>>>>>>>>>        
26354>>>>>>>>>>>>>>>>>>>        Function_Return dDFDate
26355>>>>>>>>>>>>>>>>>>>    End_Function
26356>>>>>>>>>>>>>>>>>>>    
26356>>>>>>>>>>>>>>>>>>>    Function DriverIndex String sDriver Returns Integer
26358>>>>>>>>>>>>>>>>>>>        
26358>>>>>>>>>>>>>>>>>>>        String  sCurrentDriver
26358>>>>>>>>>>>>>>>>>>>        Integer iNumberOfDrivers iDriver iCount
26358>>>>>>>>>>>>>>>>>>>        
26358>>>>>>>>>>>>>>>>>>>        Move 0 to iDriver
26359>>>>>>>>>>>>>>>>>>>        
26359>>>>>>>>>>>>>>>>>>>        Get_Attribute DF_NUMBER_DRIVERS to iNumberOfDrivers
26362>>>>>>>>>>>>>>>>>>>        For iCount from 1 to iNumberOfDrivers
26368>>>>>>>>>>>>>>>>>>>>
26368>>>>>>>>>>>>>>>>>>>            
26368>>>>>>>>>>>>>>>>>>>            Get_Attribute DF_DRIVER_NAME of iCount to sCurrentDriver
26371>>>>>>>>>>>>>>>>>>>            If ( Uppercase(sCurrentDriver) = Uppercase(sDriver) ) Begin
26373>>>>>>>>>>>>>>>>>>>                Move iCount to iDriver
26374>>>>>>>>>>>>>>>>>>>            End
26374>>>>>>>>>>>>>>>>>>>>
26374>>>>>>>>>>>>>>>>>>>        Loop
26375>>>>>>>>>>>>>>>>>>>>
26375>>>>>>>>>>>>>>>>>>>        
26375>>>>>>>>>>>>>>>>>>>        Function_Return iDriver
26376>>>>>>>>>>>>>>>>>>>        
26376>>>>>>>>>>>>>>>>>>>    End_Function
26377>>>>>>>>>>>>>>>>>>>    
26377>>>>>>>>>>>>>>>>>>>    
26377>>>>>>>>>>>>>>>>>>>    // Redirect an exisitng connection. The existing connection
26377>>>>>>>>>>>>>>>>>>>    // will point to another database but all tables will stay
26377>>>>>>>>>>>>>>>>>>>    // open!
26377>>>>>>>>>>>>>>>>>>>    Function RedirectConnection String sOldConnection String sNewConnection Returns Integer
26379>>>>>>>>>>>>>>>>>>>        String  sDriver
26379>>>>>>>>>>>>>>>>>>>        String  sVoid
26379>>>>>>>>>>>>>>>>>>>        Integer iResult
26379>>>>>>>>>>>>>>>>>>>        Integer iVoid
26379>>>>>>>>>>>>>>>>>>>        
26379>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26380>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26382>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_REDIRECTCONNECTION Callback 0 Passing sOldConnection sNewConnection iVoid Result iResult
26387>>>>>>>>>>>>>>>>>>>        End
26387>>>>>>>>>>>>>>>>>>>>
26387>>>>>>>>>>>>>>>>>>>        Function_Return iResult
26388>>>>>>>>>>>>>>>>>>>    End_Function
26389>>>>>>>>>>>>>>>>>>>    
26389>>>>>>>>>>>>>>>>>>>    // Redirect a connection of a connection ID
26389>>>>>>>>>>>>>>>>>>>    // sConnectionId must contain a valid ConnectionId ("DFCONNID=MyID")
26389>>>>>>>>>>>>>>>>>>>    // sConnectString must contain a valid connectstring ("SERVER=MyServer;DATABASE=MyDatabase;UID=MyName;PWD=MyPassword")
26389>>>>>>>>>>>>>>>>>>>    //
26389>>>>>>>>>>>>>>>>>>>    // RedirectIDConnectString will redirect from the old connection (Server/Database the connectionId currently points to)
26389>>>>>>>>>>>>>>>>>>>    // to the new connection (Server/Database specified in sConnectString)
26389>>>>>>>>>>>>>>>>>>>    // All opened tables will be moved from old connection to new connection. (Tables must have identical structure in both connections)
26389>>>>>>>>>>>>>>>>>>>    //
26389>>>>>>>>>>>>>>>>>>>    // If bKeepLoggedIn = false, the new connection will be logged in, the old connection will be logged out
26389>>>>>>>>>>>>>>>>>>>    // If bKeepLoggedIn = true, connections will remain open and re-used on next redirectIdConnection
26389>>>>>>>>>>>>>>>>>>>    //
26389>>>>>>>>>>>>>>>>>>>    // Returns:
26389>>>>>>>>>>>>>>>>>>>    //     0 when the redirection was successful.
26389>>>>>>>>>>>>>>>>>>>    //     1 if the connection ID does not exist or can not be found.
26389>>>>>>>>>>>>>>>>>>>    //     2 login into the new connection failed.
26389>>>>>>>>>>>>>>>>>>>    //
26389>>>>>>>>>>>>>>>>>>>    Function RedirectIdConnectString String sConnectionId String sConnectString Boolean bKeepLoggedIn Returns Integer
26391>>>>>>>>>>>>>>>>>>>        String  sDriver
26391>>>>>>>>>>>>>>>>>>>        String  sVoid
26391>>>>>>>>>>>>>>>>>>>        Integer iResult
26391>>>>>>>>>>>>>>>>>>>        
26391>>>>>>>>>>>>>>>>>>>        Integer iOption
26391>>>>>>>>>>>>>>>>>>>        
26391>>>>>>>>>>>>>>>>>>>        // iOption
26391>>>>>>>>>>>>>>>>>>>        // 0 = RedirectConnection
26391>>>>>>>>>>>>>>>>>>>        // 1 = RedirectIdConnectString
26391>>>>>>>>>>>>>>>>>>>        // 2 = RedirectIdConnectStringKeepLoggedIn
26391>>>>>>>>>>>>>>>>>>>        If (bKeepLoggedIn) Begin
26393>>>>>>>>>>>>>>>>>>>            Move 2 to iOption
26394>>>>>>>>>>>>>>>>>>>        End
26394>>>>>>>>>>>>>>>>>>>>
26394>>>>>>>>>>>>>>>>>>>        Else Begin
26395>>>>>>>>>>>>>>>>>>>            Move 1 to iOption
26396>>>>>>>>>>>>>>>>>>>        End
26396>>>>>>>>>>>>>>>>>>>>
26396>>>>>>>>>>>>>>>>>>>        
26396>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26397>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26399>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_REDIRECTCONNECTION Callback 0 Passing sConnectionId sConnectString iOption Result iResult
26404>>>>>>>>>>>>>>>>>>>        End
26404>>>>>>>>>>>>>>>>>>>>
26404>>>>>>>>>>>>>>>>>>>        Function_Return iResult
26405>>>>>>>>>>>>>>>>>>>    End_Function
26406>>>>>>>>>>>>>>>>>>>    
26406>>>>>>>>>>>>>>>>>>>    
26406>>>>>>>>>>>>>>>>>>>    // Create a DataFlex side connection id that can be used later on.
26406>>>>>>>>>>>>>>>>>>>    //
26406>>>>>>>>>>>>>>>>>>>    Function CreateConnectionID String sID String sConnStr Integer iOpt Returns Integer
26408>>>>>>>>>>>>>>>>>>>        String  sDriver
26408>>>>>>>>>>>>>>>>>>>        Integer iResult
26408>>>>>>>>>>>>>>>>>>>        Integer iOptions
26408>>>>>>>>>>>>>>>>>>>        
26408>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26409>>>>>>>>>>>>>>>>>>>        If (Num_Arguments = 2) ;            Move 0 to iOptions
26412>>>>>>>>>>>>>>>>>>>        Else ;            Move iOpt to iOptions
26414>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26416>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_CREATECONNECTIONID Callback 0 Passing sID sConnStr iOptions Result iResult
26421>>>>>>>>>>>>>>>>>>>        End
26421>>>>>>>>>>>>>>>>>>>>
26421>>>>>>>>>>>>>>>>>>>        Function_Return iResult
26422>>>>>>>>>>>>>>>>>>>    End_Function
26423>>>>>>>>>>>>>>>>>>>    
26423>>>>>>>>>>>>>>>>>>>    
26423>>>>>>>>>>>>>>>>>>>    
26423>>>>>>>>>>>>>>>>>>>    // Delete a DataFlex side connection id.
26423>>>>>>>>>>>>>>>>>>>    //
26423>>>>>>>>>>>>>>>>>>>    Function DeleteConnectionID String sID Integer iIndex Returns Integer
26425>>>>>>>>>>>>>>>>>>>        String  sDriver
26425>>>>>>>>>>>>>>>>>>>        Integer iResult
26425>>>>>>>>>>>>>>>>>>>        String sVoid
26425>>>>>>>>>>>>>>>>>>>        
26425>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriver
26426>>>>>>>>>>>>>>>>>>>        If (sDriver <> "") Begin
26428>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriver Function CLI_DELETECONNECTIONID Callback 0 Passing sID sVoid iIndex Result iResult
26433>>>>>>>>>>>>>>>>>>>        End
26433>>>>>>>>>>>>>>>>>>>>
26433>>>>>>>>>>>>>>>>>>>        Function_Return iResult
26434>>>>>>>>>>>>>>>>>>>    End_Function
26435>>>>>>>>>>>>>>>>>>>    
26435>>>>>>>>>>>>>>>>>>>End_Class
26436>>>>>>>>>>>>>>>>>
