19361>>>>>    // Sent by each cWebControl object. Stores the control's name & object handle a global arrays
19361>>>>>    // for fast lookup of cWebControl object names.
19361>>>>>    Procedure RegisterWebControl Handle hoWebControl
19363>>>>>        tWebControlMapItem[] aItems
19363>>>>>        tWebControlMapItem[] aItems
19364>>>>>        tWebControlMapItem newItem
19364>>>>>        tWebControlMapItem newItem
19364>>>>>        Integer iPos
19364>>>>>        
19364>>>>>        Move hoWebControl to newItem.hoObj
19365>>>>>        Get WebObjectName of hoWebControl to newItem.sName
19366>>>>>        Get paWebControls to aItems
19367>>>>>        
19367>>>>>        Move (BinarySearchArray(newItem, aItems, False)) to iPos
19368>>>>>        
19368>>>>>        If (iPos <> -1) Begin
19370>>>>>            Error DFERR_PROGRAM (SFormat("Web object with name '%1' already exists!", newItem.sName))
19371>>>>>>
19371>>>>>        End
19371>>>>>>
19371>>>>>        Else Begin
19372>>>>>            Move (InsertInArray(aItems, BinarySearchInsertPos(), newItem)) to aItems
19373>>>>>            Set paWebControls to aItems
19374>>>>>        End
19374>>>>>>
19374>>>>>    End_Procedure
