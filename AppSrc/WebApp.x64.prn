2056>>>>>>>    
2056>>>>>>>    //  Dummy. Only data-file awre object do this automatically.
2056>>>>>>>    Function Help_Datafile Returns String
2058>>>>>>>    End_Function
2059>>>>>>>    
2059>>>>>>>    // This message is sent to an object by the help system. It is up to
2059>>>>>>>    // the object to return a context value. Depending on the type of
2059>>>>>>>    // context requested (context_type) different values are returned.
2059>>>>>>>    //
2059>>>>>>>    //     Context_type = HELP_CONTEXT_ID
2059>>>>>>>    //       Returns the object's help context Id. Will delegate to the
2059>>>>>>>    //       desktop searching for an id. Uses Help_ID property
2059>>>>>>>    //
2059>>>>>>>    //     Context_type = HELP_CONTEXT_KEYWORD
2059>>>>>>>    //       Returns the object's help keyword Id. Will delegate to the
2059>>>>>>>    //       desktop searching for an id. Uses Help_Keyword property
2059>>>>>>>    //
2059>>>>>>>    //     Context_type = HELP_CONTEXT_ID_OR_KEY
2059>>>>>>>    //       Returns the object's help ID. This can be a context integer ID or
2059>>>>>>>    //       a keyword string id. It first looks for the object context_id. If
2059>>>>>>>    //       this is non-zero, it returns the id. Otherwise, it checks the object
2059>>>>>>>    //       keyword id. If an Id exists it returns it. Else it delegates. Uses
2059>>>>>>>    //       properties help_id and help_keyword.
2059>>>>>>>    //
2059>>>>>>>    //     Context_type = HELP_CONTEXT_DATAFILE
2059>>>>>>>    //       returns the data file and field for the object requesting help.
2059>>>>>>>    //       It returns a string in "FILE.FIELD" format. Blank if no File
2059>>>>>>>    //
2059>>>>>>>    //     Context_type = HELP_CONTEXT_ERROR
2059>>>>>>>    //       Not actually used by DEOs (although it could be). It returns
2059>>>>>>>    //       error context (most likely an error number). Is used by the
2059>>>>>>>    //       error system.
2059>>>>>>>    //
2059>>>>>>>    Function Help_Context Integer Context_Type Returns String
2061>>>>>>>        
2061>>>>>>>        Integer ID
2061>>>>>>>        String  rVal
2061>>>>>>>        
2061>>>>>>>        If (Context_Type = HELP_CONTEXT_ID) Begin
2063>>>>>>>            Get Help_ID to ID
2064>>>>>>>            If (ID = 0) ;                Delegate Get Help_Context Context_type to ID
2068>>>>>>>            Move ID to rVal
2069>>>>>>>        End
2069>>>>>>>>
2069>>>>>>>        Else If (Context_Type = HELP_CONTEXT_KEYWORD) Begin
2072>>>>>>>            Get Help_Keyword to rVal
2073>>>>>>>            If (rval = '') ;                Delegate Get Help_Context Context_Type to rVal
2077>>>>>>>        End
2077>>>>>>>>
2077>>>>>>>        Else If (Context_Type = HELP_CONTEXT_ID_OR_KEY) Begin
2080>>>>>>>            Get Help_ID to ID         // 1st try for a context integer ID.
2081>>>>>>>            If (ID = 0) Begin          // If no ID check for a keyword.
2083>>>>>>>                Get Help_Keyword to rVal
2084>>>>>>>                If (rVal = '') ;                    Delegate Get Help_Context Context_Type to rVal
2088>>>>>>>            End
2088>>>>>>>>
2088>>>>>>>            Else ;                Move ID to rVal
2090>>>>>>>        End
2090>>>>>>>>
2090>>>>>>>        Else If (Context_Type = HELP_CONTEXT_DATAFILE) Begin
2093>>>>>>>            Get Help_DataFile to rVal
2094>>>>>>>        End
2094>>>>>>>>
2094>>>>>>>        
2094>>>>>>>        Function_Return rVal
2095>>>>>>>        
2095>>>>>>>    End_Function
2096>>>>>>>    
2096>>>>>>>    // return context-type and the context string (by ref) for this one object. The content type to search for is determined by
2096>>>>>>>    // eContext. Usually it will be HELP_CONTEXT_ANY which returns any help context (html page first, id next, keyword last).
2096>>>>>>>    //
2096>>>>>>>    Function HtmlHelpObjectContext Integer eContext String ByRef sContext Returns Integer
2098>>>>>>>        Integer eContextFound iId
2098>>>>>>>        String  sTopic sKeyword
2098>>>>>>>        
2098>>>>>>>        Get psHtmlHelpTopic to sTopic
2099>>>>>>>        Get Help_ID         to iId
2100>>>>>>>        Get Help_Keyword    to sKeyword
2101>>>>>>>        
2101>>>>>>>        If (sTopic<>"" and (eContext = HELP_CONTEXT_ANY or eContext = HELP_CONTEXT_HTMLPAGE)) Begin
2103>>>>>>>            Move HELP_CONTEXT_HTMLPAGE to eContextFound
2104>>>>>>>            Move sTopic to sContext
2105>>>>>>>        End
2105>>>>>>>>
2105>>>>>>>        Else If (iId<>0 and (eContext = HELP_CONTEXT_ANY or eContext = HELP_CONTEXT_ID)) Begin
2108>>>>>>>            Move HELP_CONTEXT_ID to eContextFound
2109>>>>>>>            Move (String(iId)) to sContext
2110>>>>>>>        End
2110>>>>>>>>
2110>>>>>>>        Else If (sKeyword<>"" and (eContext = HELP_CONTEXT_ANY or eContext = HELP_CONTEXT_KEYWORD)) Begin
2113>>>>>>>            Move HELP_CONTEXT_KEYWORD to eContextFound
2114>>>>>>>            Move sKeyword to sContext
2115>>>>>>>        End
2115>>>>>>>>
2115>>>>>>>        Else Begin
2116>>>>>>>            Move HELP_CONTEXT_NONE to eContextFound
2117>>>>>>>            Move "" to sContext
2118>>>>>>>        End
2118>>>>>>>>
2118>>>>>>>        Function_Return eContextFound // and sContext is returned by reference
2119>>>>>>>    End_Function
2120>>>>>>>    
2120>>>>>>>    // Return context-type and the context string (by ref). Delegate until some kind of context is found
2120>>>>>>>    // This message gets augmented at the desktop and at the panel class to stop delegation
2120>>>>>>>    // This is what is no called when you request html help.
2120>>>>>>>    Function HtmlHelpContext Integer eContext String ByRef sContext Returns Integer
2122>>>>>>>        Integer eContextFound
2122>>>>>>>        Get HtmlHelpObjectContext eContext (&sContext) to eContextFound // context for this one object
2123>>>>>>>        If (eContextFound=HELP_CONTEXT_NONE) Begin
2125>>>>>>>            Delegate Get HtmlHelpContext eContext (&sContext) to eContextFound
2127>>>>>>>        End
2127>>>>>>>>
2127>>>>>>>        Function_Return eContextFound  // and sContext is returned by reference
2128>>>>>>>    End_Function
2129>>>>>>>    
2129>>>>>>>    
2129>>>>>>>End_Class
2130>>>>>>>
2130>>>>>>>
2130>>>>>>>Class DataFile_Help_Mixin is a Mixin
2131>>>>>>>    Function Help_Datafile Returns String
2133>>>>>>>        Integer file# field#
2133>>>>>>>        String rVal
