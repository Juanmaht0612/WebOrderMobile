33890>>>>>>>>>                        Send OnFileChunk sFieldname (&ucChunk) 
33891>>>>>>>>>                    End
33891>>>>>>>>>>
33891>>>>>>>>>                    Else Begin
33892>>>>>>>>>                        If (parsedata.iChunkRead > 0 and  SizeOfArray(parsedata.ucCurrentChunk) > parsedata.iChunkRead) Begin
33894>>>>>>>>>                            Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk))) to ucChunk
33895>>>>>>>>>                            Send OnFileChunk sFieldname (&ucChunk)
33896>>>>>>>>>                        End
33896>>>>>>>>>>
33896>>>>>>>>>                        Else If (SizeOfArray(parsedata.ucCurrentChunk) > 0) Begin
33899>>>>>>>>>                            Send OnFileChunk sFieldname (&parsedata.ucCurrentChunk)
33900>>>>>>>>>                        End
33900>>>>>>>>>>
33900>>>>>>>>>                    End
33900>>>>>>>>>>
33900>>>>>>>>>                    
33900>>>>>>>>>                    //  The file is done
33900>>>>>>>>>                    Send OnFileFinished sFieldname
33901>>>>>>>>>                    
33901>>>>>>>>>                End
33901>>>>>>>>>>
33901>>>>>>>>>                Else Begin
33902>>>>>>>>>                    //  This is an ordinary field
33902>>>>>>>>>                    Get FindToken (&parsedata) ucNewLine True True to iOffset
33903>>>>>>>>>                    Send SkipNewLine (&parsedata)
33904>>>>>>>>>                    
33904>>>>>>>>>                    Move (ResizeArray(ucValue, 0)) to ucValue
33905>>>>>>>>>                    
33905>>>>>>>>>                    While (parsedata.iBoundPos < 0 and ShouldParseContinue(Self, &parsedata))
33909>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
33910>>>>>>>>>                        
33910>>>>>>>>>                        Send ReadChunk (&parsedata)            
33911>>>>>>>>>                    End
33912>>>>>>>>>>
33912>>>>>>>>>                    
33912>>>>>>>>>                    If (parsedata.iBoundPos > 0) Begin
33914>>>>>>>>>                        //  Cut off newline
33914>>>>>>>>>                        Move (parsedata.iBoundPos - 1) to iOffset
33915>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 10) ;                            Decrement iOffset
33918>>>>>>>>>                        If (Integer(parsedata.ucCurrentChunk[iOffset]) = 13) ;                            Decrement iOffset
33921>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, iOffset))) to ucValue
33922>>>>>>>>>                    End
33922>>>>>>>>>>
33922>>>>>>>>>                    Else Begin
33923>>>>>>>>>                        Move (AppendArray(ucValue, CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk)))) to ucValue
33924>>>>>>>>>                        Send ReadChunk (&parsedata)
33925>>>>>>>>>                    End
33925>>>>>>>>>>
33925>>>>>>>>>                    
33925>>>>>>>>>                    Send OnField sFieldname ucValue
33926>>>>>>>>>                End
33926>>>>>>>>>>
33926>>>>>>>>>            End
33926>>>>>>>>>>
33926>>>>>>>>>            Else Begin
