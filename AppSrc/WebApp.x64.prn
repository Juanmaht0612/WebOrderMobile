18134>>>>>>>>>        
18134>>>>>>>>>        // Published Methods:
18134>>>>>>>>>        // The set of published procedures and functions in this object. This comprises
18134>>>>>>>>>        // the legal call interface of this object i.e. client calls. When CallAction is
18134>>>>>>>>>        // received from the client, the name of the action method must match one of these
18134>>>>>>>>>        // published methods otherwise it will be ignored. This makes resolving the action
18134>>>>>>>>>        // method easier and closes a possible security hole if any action could be called.
18134>>>>>>>>>        // - Procedure Set is not supported.
18134>>>>>>>>>        // - You cannot publish a Procedure and a Function with the same name in the same object.
18134>>>>>>>>>        //
18134>>>>>>>>>        // These  arrays should contain matching members. i.e. the i'th member
18134>>>>>>>>>        // of each array should pertain to the same published method. The data
18134>>>>>>>>>        // is stored in separate arrays instead of an array of struct in order
18134>>>>>>>>>        // to allow fast searches in each array.
18134>>>>>>>>>        Property Handle[]  paPubMethodHandles       // handle to the procedure or function
18135>>>>>>>>>        Property String[]  paPubMethodNames         // name of the method
18136>>>>>>>>>        Property Boolean[] paPubMethodIsFunction    // true if the published method is a function, False if it is a procedure.
18137>>>>>>>>>        
18137>>>>>>>>>        // Array of nested child cWebControl object handles. This is iterated during the
18137>>>>>>>>>        // SerializeToJSON call. See Also paChildWebControlNames
18137>>>>>>>>>        Property Handle[] paChildWebControls
18138>>>>>>>>>
18138>>>>>>>>>        Property Boolean pbDataBindable False    // True if the object supports the cWebBaseDEO interface (i.e. Entry_Item, Data_File & Data_Field)
18139>>>>>>>>>        
18139>>>>>>>>>        Property Handle phoActionJsonData C_WebUnresolvedObject // cJsonObject handle representing the action data during a server action.
18140>>>>>>>>>        
18140>>>>>>>>>        Property String psJSClass ""             // JavaScript class name of client-side object
18141>>>>>>>>>        
18141>>>>>>>>>        Property Handle phoWebNeighborhood C_WebUnresolvedObject  // object handle of this object's container WebView, WebDialog or cWebApp object.
18142>>>>>>>>>
18142>>>>>>>>>
18142>>>>>>>>>        // Dynamic object properties:
18142>>>>>>>>>        // A cWebObject can be a dynamic object. In that case, some additional properties
18142>>>>>>>>>        // will be set. These properties should be used with caution. Dynamic object rely 
18142>>>>>>>>>        // on certain hooks in the regular flow of an application, so changes in these 
18142>>>>>>>>>        // properties can stop an application from functioning.      
18142>>>>>>>>>        Property String psDynamicObjectId           // The (unique) ID of the dynamic object
18143>>>>>>>>>        
18143>>>>>>>>>        Property Handle phoOwner C_WebUnresolvedObject  // The owner object of this (dynamic) web object
18144>>>>>>>>>        
18144>>>>>>>>>        Property Handle phoHost C_WebUnresolvedObject   // The host of this web object (cWebApp or cLocalWebControlHost)
18145>>>>>>>>>        
18145>>>>>>>>>        Property Boolean pbGhost False  // Ghost objects do not communicate to the client
18146>>>>>>>>>
18146>>>>>>>>>        Set peNeighborhood to nhNo
18147>>>>>>>>>        Set psJSClass to "df.WebObject"
18148>>>>>>>>>        Send RegisterThisWebObject
