6601>>>>>>>        Integer iPage icPage
6601>>>>>>>        
6601>>>>>>>        If (eTabStyle <> private_peTabStyle(Self)) Begin
6603>>>>>>>            If (eTabStyle <> tsTabs) Begin
6605>>>>>>>                Set peTabPosition to tpTop // Buttons can only appear across the top!
6606>>>>>>>            End
6606>>>>>>>>
6606>>>>>>>            Set private_peTabStyle to eTabStyle
6607>>>>>>>            Get Window_Handle to hWnd
6608>>>>>>>            If hWnd Begin
6610>>>>>>>                Move (GetWindowLongPtr(hWnd, GWL_STYLE)) to iStyle
6611>>>>>>>                Move (RemoveBitValue(TCS_BUTTONS, iStyle)) to iStyle
6612>>>>>>>                Move (RemoveBitValue(TCS_FLATBUTTONS, iStyle)) to iStyle
6613>>>>>>>                
6613>>>>>>>                If (eTabStyle <> tsTabs) ;                    Move (AddBitValue(TCS_BUTTONS, iStyle)) to iStyle
6616>>>>>>>                If (eTabStyle = tsFlatButtons) ;                    Move (AddBitValue(TCS_FLATBUTTONS, iStyle)) to iStyle
6619>>>>>>>                Move (SetWindowLongPtr(hWnd, GWL_STYLE, iStyle)) to iVoid
6620>>>>>>>                
6620>>>>>>>                If (eTabStyle = tsFlatButtons) Begin // windows creates flat separators by default, and we may not want them!
6622>>>>>>>                    Send Windows_Message TCM_SETEXTENDEDSTYLE TCS_EX_FLATSEPARATORS (If(private_pbFlatSeparators(Self), TCS_EX_FLATSEPARATORS, 0))
6623>>>>>>>                End
6623>>>>>>>>
6623>>>>>>>            End
6623>>>>>>>>
6623>>>>>>>        End
6623>>>>>>>>
6623>>>>>>>    End_Procedure
