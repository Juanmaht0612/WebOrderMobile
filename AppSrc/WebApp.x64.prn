2146>>>>>>>    
2146>>>>>>>    Procedure Define_Modal_Mixin
2148>>>>>>>        Property Integer private.stop_ui_state False
2149>>>>>>>        // This can only be used with the CD_Popup_Object command. If true
2149>>>>>>>        // the command will destroy the object it created.
