26174>>>>>>>>>>>>>>>>>>>    // Return the text f the last error geneated by the driver.
26174>>>>>>>>>>>>>>>>>>>    //
26174>>>>>>>>>>>>>>>>>>>    Function LastDriverError Returns String
26176>>>>>>>>>>>>>>>>>>>        String  sDriverID
26176>>>>>>>>>>>>>>>>>>>        String  sLastError
26176>>>>>>>>>>>>>>>>>>>        String  sLastErrorLength
26176>>>>>>>>>>>>>>>>>>>        Integer iLastErrorLength
26176>>>>>>>>>>>>>>>>>>>        Integer iVoid
26176>>>>>>>>>>>>>>>>>>>        
26176>>>>>>>>>>>>>>>>>>>        // Initialize
26176>>>>>>>>>>>>>>>>>>>        Move "" to sLastError
26177>>>>>>>>>>>>>>>>>>>        
26177>>>>>>>>>>>>>>>>>>>        Get psDriverID to sDriverID
26178>>>>>>>>>>>>>>>>>>>        If (sDriverID <> "") Begin
26180>>>>>>>>>>>>>>>>>>>            // Get the text of the last error
26180>>>>>>>>>>>>>>>>>>>            Move (Repeat(Character(" "), 14)) to sLastErrorlength
26181>>>>>>>>>>>>>>>>>>>            Call_Driver 0 sDriverID Function CLI_GETDRIVERATTRIBUTE Callback 0 Passing sLastErrorLength iVoid DRVR_LASTERRORTEXTLENGTH Result iVoid
26186>>>>>>>>>>>>>>>>>>>            Move (Left(sLastErrorLength, Pos(Character(0), sLastErrorLength) - 1)) to iLastErrorLength
26187>>>>>>>>>>>>>>>>>>>            
26187>>>>>>>>>>>>>>>>>>>            If (iLastErrorLength > 0) Begin
26189>>>>>>>>>>>>>>>>>>>                Move (Repeat(Character(" "), iLastErrorLength + 1)) to sLastError
26190>>>>>>>>>>>>>>>>>>>                Call_Driver 0 sDriverID Function CLI_GETDRIVERATTRIBUTE Callback 0 Passing sLastError iVoid DRVR_LASTERRORTEXT Result iVoid
26195>>>>>>>>>>>>>>>>>>>                Move (Left(sLastError, Pos(Character(0), sLastError) - 1)) to sLastError
26196>>>>>>>>>>>>>>>>>>>            End
26196>>>>>>>>>>>>>>>>>>>>
26196>>>>>>>>>>>>>>>>>>>        End
26196>>>>>>>>>>>>>>>>>>>>
26196>>>>>>>>>>>>>>>>>>>        
26196>>>>>>>>>>>>>>>>>>>        Function_Return sLastError
26197>>>>>>>>>>>>>>>>>>>    End_Function
26198>>>>>>>>>>>>>>>>>>>    
26198>>>>>>>>>>>>>>>>>>>    
26198>>>>>>>>>>>>>>>>>>>    
