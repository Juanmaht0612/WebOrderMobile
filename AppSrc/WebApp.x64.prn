16539>>>>>>>    Procedure Set_File_Data String sName Integer iFileNr
16541>>>>>>>        Integer iCount
16541>>>>>>>        Move (UpperCase(sName)) to sName
16542>>>>>>>        Get find_element sName to iCount // search for Dups
16543>>>>>>>        If (iCount >= 0) ; // if found, we have an error            Error 900 (SFormat(C_$FileNameAlreadyExists, sName))
16546>>>>>>>        Else Begin
16547>>>>>>>            Get File_Count to iCount
16548>>>>>>>            Set Value            iCount to sName
