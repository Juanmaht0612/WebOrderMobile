29003>>>>>>>>>>>    Procedure RemoveTag String sTag
29005>>>>>>>>>>>        String[] aTags
29006>>>>>>>>>>>        Boolean bCaseSensitive
29006>>>>>>>>>>>        Integer i
29006>>>>>>>>>>>        
29006>>>>>>>>>>>        Get GetTags to aTags
29007>>>>>>>>>>>        Get pbCaseSensitive to bCaseSensitive
29008>>>>>>>>>>>        
29008>>>>>>>>>>>        If (not(bCaseSensitive)) ;            Move (Uppercase(sTag)) to sTag
29011>>>>>>>>>>>            
29011>>>>>>>>>>>        For i from 0 to (SizeOfArray(aTags) - 1)
29017>>>>>>>>>>>>
29017>>>>>>>>>>>            If ((bCaseSensitive and aTags[i]= sTag) or (not(bCaseSensitive) and Uppercase(aTags[i]) = sTag)) Begin
29019>>>>>>>>>>>                Move (RemoveFromArray(aTags, i)) to aTags
29020>>>>>>>>>>>                Decrement i
29021>>>>>>>>>>>            End
29021>>>>>>>>>>>>
29021>>>>>>>>>>>        Loop
29022>>>>>>>>>>>>
29022>>>>>>>>>>>        
29022>>>>>>>>>>>        Send UpdateTags aTags
29023>>>>>>>>>>>    End_Procedure
