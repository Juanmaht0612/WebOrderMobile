8280>>>>>>>    
8280>>>>>>>    // Retrieve header information associated with the previous request.
8280>>>>>>>    Function QueryInfo DWord dwInfoLevel Returns String
8282>>>>>>>        Handle hRequestHandle
8282>>>>>>>        WString wResult
8282>>>>>>>        Integer iBufferSize iRes iVoid
8282>>>>>>>
8282>>>>>>>        Get RequestHandle to hRequestHandle
8283>>>>>>>        
8283>>>>>>>        If (hRequestHandle) Begin
8285>>>>>>>            Move 200 to iBufferSize
8286>>>>>>>            Move (Repeat(" ", iBufferSize)) to wResult
8287>>>>>>>            Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes
8288>>>>>>>            
8288>>>>>>>            If (not(iRes) and GetLastError() = 122) Begin //  Insufficient buffersize, retry with received iBufferSize value
8290>>>>>>>                Increment iBufferSize      
8291>>>>>>>                
8291>>>>>>>                Move (Repeat(" ", iBufferSize)) to wResult
8292>>>>>>>                Move (WinAPI_HttpQueryInfo(hRequestHandle, dwInfoLevel, AddressOf(wResult), AddressOf(iBufferSize), 0)) to iRes  
8293>>>>>>>            End
8293>>>>>>>>
8293>>>>>>>            
8293>>>>>>>            If (not(iRes)) Begin
8295>>>>>>>                Move (ShowLastError()) to iVoid
8296>>>>>>>            End
8296>>>>>>>>
8296>>>>>>>        End
8296>>>>>>>>
8296>>>>>>>        
8296>>>>>>>        Function_Return (CString(wResult))
8297>>>>>>>    End_Function
8298>>>>>>>    
8298>>>>>>>    // Returns the statustext returned by the previous request.
8298>>>>>>>    Function ResponseStatusText Returns String
8300>>>>>>>        String sStatus
8300>>>>>>>        
8300>>>>>>>        Get QueryInfo HTTP_QUERY_STATUS_TEXT to sStatus
8301>>>>>>>        
8301>>>>>>>        Function_Return sStatus
8302>>>>>>>    End_Function
8303>>>>>>>    
8303>>>>>>>End_Class
