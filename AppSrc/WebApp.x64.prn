11640>>>>>>>>>>>
11640>>>>>>>>>>>        Get Main_File to iFile
11641>>>>>>>>>>>        Get_Attribute DF_FILE_SQL_TABLE_NAME of iFile to sFile
11644>>>>>>>>>>>        Get_Attribute DF_FIELD_SQL_COLUMN_NAME of iFile iField to sField
11647>>>>>>>>>>>        Get SQLIdentifierQuote iFile to sIdentifierQuote
11648>>>>>>>>>>>
11648>>>>>>>>>>>        Function_Return (sIdentifierQuote + sFile + sIdentifierQuote + '.' + sIdentifierQuote + sField + sIdentifierQuote)
11649>>>>>>>>>>>    End_Function
11650>>>>>>>>>>>
11650>>>>>>>>>>>    // returns the name of the Field suitable for an SQL where statement ("Column")
