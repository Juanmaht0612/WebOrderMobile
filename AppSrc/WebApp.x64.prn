33601>>>>>            Get RequestDataUChar -1 to ucData
33602>>>>>            If (SizeOfArray(ucData) > 0) Begin
33604>>>>>                Get Create (RefClass(cJsonObject)) to cctx.hoJsonRequest
33605>>>>>            
33605>>>>>                //  Parse & validate request JSON
33605>>>>>                Get ParseUtf8 of cctx.hoJsonRequest ucData to bSuccess
33606>>>>>                If (bSuccess) Begin
33608>>>>>                    Move ucEmpty to ucData
33609>>>>>                
33609>>>>>                    //  Assemble the response JSON
33609>>>>>                    Get Create (RefClass(cJsonObject)) to cctx.hoJsonResponse
33610>>>>>                    Send InitializeJsonType of cctx.hoJsonResponse jsonTypeObject
33611>>>>>                    
33611>>>>>                    Send ErrorQueueEnd
33612>>>>>                    Get ErrorCount to iErrorCount
33613>>>>>                    
33613>>>>>                    If (iErrorCount = 0) Begin
33615>>>>>                        //  Reset error logging before going into application code
33615>>>>>                        Set pbAllErrorsToEventLog to bOrigEV
33616>>>>>                        
33616>>>>>                        Send ProcessRequest of (Host(Self)) (&cctx)
33617>>>>>                        
33617>>>>>                        //  Restart error queuing and logging after application code
33617>>>>>                        Send ErrorQueueStart 
33618>>>>>                        Set pbAllErrorsToEventLog to bLogErrors
33619>>>>>                        
33619>>>>>                        
33619>>>>>                        If (cctx.iFatalErrorCode= 0) Begin
33621>>>>>                            Send AddHttpResponseHeader "Cache-Control" "no-cache"
33622>>>>>                            Send AddHttpResponseHeader "Content-Type" "application/json; charset=utf-8"
33623>>>>>                            
33623>>>>>                            Get StringifyUtf8 of cctx.hoJsonResponse to ucData
33624>>>>>                            Send OutputUChar ucData  
33625>>>>>                        End
33625>>>>>>
33625>>>>>                        Else Begin
33626>>>>>                            Send ReportFatalError cctx.iFatalErrorCode "Fatal error"  0 cctx.sFatalError
33627>>>>>                        End
33627>>>>>>
33627>>>>>                    
33627>>>>>                        Send Destroy of cctx.hoJsonResponse
33628>>>>>                    End
33628>>>>>>
33628>>>>>                    Else  Begin
33629>>>>>                        Send ReportDataFlexErrors 
33630>>>>>                    End
33630>>>>>>
33630>>>>>                End
33630>>>>>>
33630>>>>>                Else Begin
33631>>>>>                    Get psParseError of cctx.hoJsonRequest to sReason
33632>>>>>                    Send ReportFatalError 400 "Bad request" 0 ("Unable to parse request data: " + sReason)
33633>>>>>                    
33633>>>>>                    If (bLogErrors) Begin
