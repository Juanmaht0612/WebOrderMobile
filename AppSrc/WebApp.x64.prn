6731>>>>>>>    
6731>>>>>>>    
6731>>>>>>>    //  No Param or 0 - Kbd Navigation
6731>>>>>>>    //              1 - Mouse Navigation
6731>>>>>>>    //              2 - Force to Button
6731>>>>>>>    //              3 - Force to Dialog
6731>>>>>>>    //
6731>>>>>>>    Procedure Request_Previous_Tab Integer Mode
6733>>>>>>>        Integer tab# Mde oldTab#
6733>>>>>>>        
6733>>>>>>>        If (num_arguments = 0) ;            Move 0 to Mde
6736>>>>>>>        Else ;            Move Mode to Mde
6738>>>>>>>        
6738>>>>>>>        Get Current_item to oldtab#
6739>>>>>>>        Move Oldtab# to tab#
6740>>>>>>>        Repeat
6740>>>>>>>>
6740>>>>>>>            Decrement tab#
6741>>>>>>>            If (tab# < 0) ;                Move (Button_Count(Self)-1) to tab#
6744>>>>>>>            If (tab# = OldTab#) ;                Procedure_Return
6747>>>>>>>        Until (not(Item_Shadow_State(Self,tab#)))
6749>>>>>>>        Send Request_Switch_to_Tab tab# Mde
6750>>>>>>>    End_Procedure
6751>>>>>>>    
6751>>>>>>>    Procedure Request_Next_Tab Integer Mode
6753>>>>>>>        Integer tab# oldtab# Mde
6753>>>>>>>        
6753>>>>>>>        If (num_arguments = 0) ;            Move 0 to Mde
6756>>>>>>>        Else ;            Move Mode to Mde
6758>>>>>>>        
6758>>>>>>>        Get Current_item to oldtab#
6759>>>>>>>        Move OldTab# to tab#
6760>>>>>>>        Repeat
6760>>>>>>>>
6760>>>>>>>            Increment tab#
6761>>>>>>>            If (tab#>=Button_Count(Self)) ;                Move 0 to tab#
6764>>>>>>>            If (Tab# = OldTab#) ;                Procedure_Return
6767>>>>>>>        Until (not(Item_Shadow_State(Self,tab#)))
6769>>>>>>>        Send Request_Switch_to_Tab tab# Mde
6770>>>>>>>    End_Procedure
6771>>>>>>>    
6771>>>>>>>    //  PonterMode parameter (required):
6771>>>>>>>    //      0 - Keyboard Navigation
6771>>>>>>>    //      1 - Mouse Navigation
6771>>>>>>>    //      2 - Force to Button
6771>>>>>>>    //      3 - Force to Dialog
6771>>>>>>>    //
6771>>>>>>>    Procedure Request_Switch_To_Tab Integer tab# Integer PointerMode
6773>>>>>>>        Integer rval foc ctb Skipmode
6773>>>>>>>        
6773>>>>>>>        If (Item_Shadow_State(Self,tab#)) ;            Procedure_Return
6776>>>>>>>        Get Skip_Button_Mode to SkipMode // 0 to button, 1=dialog, 1=smrt
6777>>>>>>>        If (PointerMode = 0) Begin // Kbd Navigation mode
6779>>>>>>>            If (SkipMode = SBM_SMART) Begin // if smartmode....figure it out
6781>>>>>>>                Get Focus of desktop to Foc
6782>>>>>>>                Get Current_Tab to ctb
6783>>>>>>>                If ( ctb=tab# or Foc=Self ) ;                    Move 0 to PointerMode
6786>>>>>>>                Else ;                    Move 1 to PointerMode
6788>>>>>>>            End
6788>>>>>>>>
6788>>>>>>>            Else ;                Move SkipMode to PointerMode // 0 to button, 1=dialog
6790>>>>>>>        End
6790>>>>>>>>
6790>>>>>>>        Else If (PointerMode = 1) Begin // Mouse Navigation
6793>>>>>>>            If (SkipMode = SBM_SMART) Begin // if smartmode....figure it out
6795>>>>>>>                Get Focus of desktop to Foc
6796>>>>>>>                Get Current_Tab to ctb
6797>>>>>>>                If ( ctb=tab# or Foc=Self ) ;                    Move 0 to PointerMode
6800>>>>>>>                Else ;                    Move 1 to PointerMode
6802>>>>>>>            End
6802>>>>>>>>
6802>>>>>>>            Else ;                Get Pointer_only_State to PointerMode // 0=tab, 1=dialog
6804>>>>>>>        End
6804>>>>>>>>
6804>>>>>>>        Else ; // its 2 or 3, if 3 to dialog, if 2 to button            Move (PointerMode=3) to Pointermode
6806>>>>>>>        Get Tab_Change tab# PointerMode to rval
6807>>>>>>>    End_Procedure
6808>>>>>>>    
6808>>>>>>>    //  PointerMode: 0 - button takes focus
6808>>>>>>>    //               1 - dialog takes focus
6808>>>>>>>    //               2 - no-one takes focus, just add to focus tree
6808>>>>>>>    //
6808>>>>>>>    // Rule: If the tab dialog object has the focus ;
6808>>>>>>>    //          give the keep the focus in the dialog object.
6808>>>>>>>    //       else if switching pages
6808>>>>>>>    //          Give the focus to the new page
6808>>>>>>>    //       else (tab dialog<>focus, same page)
6808>>>>>>>    //          give the tab the focus
6808>>>>>>>    //
6808>>>>>>>    
6808>>>>>>>    Function Tab_Change Integer totab Integer PointerMode Returns Integer
6810>>>>>>>        Integer tabobj rval fromtab fromobj toobj focobj oldst
6810>>>>>>>        Integer iCnt
6810>>>>>>>        Get In_Tab_Change_State to OldSt
6811>>>>>>>        Set In_Tab_Change_State to True
6812>>>>>>>        Get current_Item to fromtab             // from tab item
6813>>>>>>>        
6813>>>>>>>        Get Item_Count to iCnt
6814>>>>>>>        If (ICnt = 0) ;            Function_Return 1
6817>>>>>>>        If (totab>iCnt) ;            Move fromtab to totab
6820>>>>>>>        
6820>>>>>>>        Get tab_page_id fromtab to fromobj // from tab page
6821>>>>>>>        Get tab_page_id totab   to toobj   // to tab page
6822>>>>>>>        
6822>>>>>>>        // Activate & Roll up correct Tab
6822>>>>>>>        If (FromTab<>ToTab) Begin
6824>>>>>>>            If (ContainsFocus(Self)) ;      // if focus is here, it is in the active page (from page). We                Get Msg_Activate to rval   // need to move the focus to the safety of the tab dialog button
6827>>>>>>>            If not Rval Begin
6829>>>>>>>                Set Current_item to totab // first set to new tab
6830>>>>>>>                If (current_item(Self)<>totab) ;                    Move 1 to rval
6833>>>>>>>            End
6833>>>>>>>>
6833>>>>>>>        End
6833>>>>>>>>
6833>>>>>>>        
6833>>>>>>>        // deactivate existing tab page if required
6833>>>>>>>        If (rval=0 and ;            fromobj and fromObj<>toObj and active_state(fromobj)) Begin
6835>>>>>>>            Get Deactivate_Tab fromtab fromobj to rval
6836>>>>>>>            If rVal ;                         // if deactivate failed restore                Set Current_Item to fromTab   // original tab and exit
6839>>>>>>>        End
6839>>>>>>>>
6839>>>>>>>        
6839>>>>>>>        // At this point new tab is current item (and maybe focus)
6839>>>>>>>        // and new page is not yet active
6839>>>>>>>        
6839>>>>>>>        // before we can activate the page object we must make sure it is not hidden
6839>>>>>>>        If (rval=0 and ToObj) ;            Send DoHideTab ToObj False // this will set the active page as non shadowed (required to make kbd navigation work)
6842>>>>>>>        
6842>>>>>>>        // Add focus of new tab page if required
6842>>>>>>>        If (rval=0 and ;            toobj and active_state(toobj)=0) Begin
6844>>>>>>>            Set focus_mode of toobj to focusable
6845>>>>>>>            Get msg_add_focus of toobj Self to rval
6846>>>>>>>        End
6846>>>>>>>>
6846>>>>>>>        Else ;            Send rotate_up to toobj // this is the only change
6848>>>>>>>        
6848>>>>>>>        // after new page appears, hide the old one
6848>>>>>>>        If (rval=0 and FromObj<>0 and FromObj<>ToObj) ;            Send DoHideTab FromObj True // this will set the active page as non shadowed (required to make kbd navigation work)
6851>>>>>>>        
6851>>>>>>>        
6851>>>>>>>        // Activate either Tab dialog, Tab page, or nothing
6851>>>>>>>        //
6851>>>>>>>        If (rval=0 and ;            pointerMode<>2) Begin
6853>>>>>>>            If (Toobj=0 or PointerMode=0) ;                Move Self to focObj
6856>>>>>>>            Else ;                Move ToObj to focobj
6858>>>>>>>            
6858>>>>>>>            If (focus(desktop)<>focobj) ;                Get Msg_activate of focobj to rval
6861>>>>>>>            
6861>>>>>>>        End
6861>>>>>>>>
6861>>>>>>>        Set In_Tab_Change_State to OldSt
6862>>>>>>>        
6862>>>>>>>        Function_Return rval
6863>>>>>>>    End_Function
6864>>>>>>>    
6864>>>>>>>    Function Deactivate_Tab Integer tab# Integer tabpageobj Returns Integer
6866>>>>>>>        Integer rval
6866>>>>>>>        // normally this is false and this procedure does nothing. If the property
6866>>>>>>>        // pbDeactivatePages is set true, the page is deactivated when it is hidden
6866>>>>>>>        // which is what previous VDFs did. Only do this if you have to.
6866>>>>>>>        If (pbDeactivatePages(Self)) ;            Get Msg_Deactivate of tabpageobj 0 to rval
6869>>>>>>>        Function_Return rval
6870>>>>>>>    End_Function
6871>>>>>>>    
6871>>>>>>>    Procedure DoHideTab Integer hPage Integer bHide
6873>>>>>>>        // if page is not active (old style pages via pbDeactivatePages) then we
6873>>>>>>>        // don't do the hide step
6873>>>>>>>        If (Active_state(hPage)) ;            Send DoHideTab of hPage bHide
6876>>>>>>>    End_Procedure
6877>>>>>>>    
6877>>>>>>>    //  Display passed tab page. If no value (or -1) use default tab
6877>>>>>>>    //  display = add to focus tree if needed, rotate up, do not activate
6877>>>>>>>    //
6877>>>>>>>    Procedure Request_Tab_Display Integer iTab
6879>>>>>>>        Integer iTb bFail
6879>>>>>>>        If (button_count(Self)) Begin
6881>>>>>>>            If (Num_arguments=0 or iTab=-1) ;                Get default_tab to iTb // this can be -1, which means do nothing
6884>>>>>>>            Else ;                Move iTab to iTb
6886>>>>>>>            // if there is no default tab and we don't have any tab displayed
6886>>>>>>>            // then we will force the first tab to get displayed. Without this 1st
6886>>>>>>>            // time activatation may not display a page.
6886>>>>>>>            If (iTb<0 and current_tab(Self)<0) ;                Move 0 to iTb
6889>>>>>>>            If (iTb>=0) ;                Get Tab_Change iTb 2 to bFail // 2 means don't take focus
6892>>>>>>>        End
6892>>>>>>>>
6892>>>>>>>    End_Procedure
6893>>>>>>>    
6893>>>>>>>    // Augment to add the default tab page to the focus tree
6893>>>>>>>    //
6893>>>>>>>    Procedure Add_Focus Handle hoParent Returns Integer
6895>>>>>>>        Integer rval
6895>>>>>>>        Forward Get MSG_add_focus hoParent to rval
6897>>>>>>>        If not rval ;            Send Request_tab_display // make sure dflt tab is rotated up
6900>>>>>>>        Procedure_Return rval
6901>>>>>>>    End_Procedure
6902>>>>>>>    
6902>>>>>>>    // Most tab navigation events are controlled by the class and activate
6902>>>>>>>    // messages are sent in the middle of these events. When this occurs the
6902>>>>>>>    // private property In_tab_change_state is true. In some cases of
6902>>>>>>>    // keyboard navigation from outside the object activate is called directly.
6902>>>>>>>    // This should never happen with no active tab page (because add_focus
6902>>>>>>>    // takes care of this). In such a case, we must decide if activate should
6902>>>>>>>    // keep the focus (the tab) or give it to the page. If smart mode or always
6902>>>>>>>    // mode go the tab button else go to button (normal activate behavior)
6902>>>>>>>    //
6902>>>>>>>    Procedure Activate Returns Integer
6904>>>>>>>        Integer iTab iDflt bFail
6904>>>>>>>        If (active_state(Self) and Object_shadow_state(Self)) ;            Procedure_Return 1
6907>>>>>>>        
6907>>>>>>>        Forward Get MSG_Activate to bFail // this will give button the focus
6909>>>>>>>        // if this is not part of tab_change we might want to give the page the
6909>>>>>>>        // focus
6909>>>>>>>        If (bFail=0 and In_Tab_Change_State(Self)=0) Begin
6911>>>>>>>            Get current_tab to iTab
6912>>>>>>>            // If we need to reset the page on forward navigate (or activate)
6912>>>>>>>            // use the default tab as the page to move to
6912>>>>>>>            If (pbResetPageOnActivate(Self)) Begin
6914>>>>>>>                Get Default_tab to iDflt
6915>>>>>>>                If (iDflt>=0) ;                    Move iDflt to iTab
6918>>>>>>>            End
6918>>>>>>>>
6918>>>>>>>            If (iTab>-1 and ; // if tab is not yet active (should not happen)                (Skip_Button_Mode(Self)<>SBM_NEVER ) ) Begin
6920>>>>>>>                Send Request_switch_to_tab iTab 3  // force to page
6921>>>>>>>            End
6921>>>>>>>>
6921>>>>>>>        End
6921>>>>>>>>
6921>>>>>>>        Procedure_Return bFail
6922>>>>>>>    End_Procedure
6923>>>>>>>    
6923>>>>>>>    
6923>>>>>>>    Procedure Rebuild_Tab_Pointers
6925>>>>>>>        // after a delete (or in the future an insert) we can call this to
6925>>>>>>>        // make sure that pointers between dialog and pages is correct. This
6925>>>>>>>        // can be safely called at any point.
6925>>>>>>>        Integer iItm hTabPg iItems
6925>>>>>>>        Get Button_Count to iItems
6926>>>>>>>        Decrement iItems
6927>>>>>>>        For iItm from 0 to iItems
6933>>>>>>>>
6933>>>>>>>            Get tab_page_id iItm to hTabPg
6934>>>>>>>            Set Tab_Button_item of hTabPg to iItm
6935>>>>>>>        Loop
6936>>>>>>>>
6936>>>>>>>    End_Procedure
6937>>>>>>>    
6937>>>>>>>    Procedure Delete_Tab_Item Integer iTab
6939>>>>>>>        // The order that these messages are sent are important and somewhat trial and error.
6939>>>>>>>        // We must notify the windows control that the button has been removed.
6939>>>>>>>        Integer hTabPg iIc bOld
6939>>>>>>>        Get Item_Count to iIC
6940>>>>>>>        Decrement iIC
6941>>>>>>>        If (iIC>0) Begin // don't allow last tab to be deleted
6943>>>>>>>            // If activate is sent to the tab-dialog, this will force the button to take
6943>>>>>>>            // the focus by setting in_tab_change_state to true. See procedure activate in this class
6943>>>>>>>            Get in_tab_change_state to bOld
6944>>>>>>>            Set in_tab_change_state to True
6945>>>>>>>            Get tab_page_id iTab to hTabPg
6946>>>>>>>            Send windows_Message TCM_DELETEITEM iTab 0
6947>>>>>>>            Send Deactivate to hTabPg 0
6948>>>>>>>            Send delete_item iTab
6949>>>>>>>            Send Rebuild_Tab_Pointers
6950>>>>>>>            // if not active, do switch tab (it does an activate). Note: The above windows message and
6950>>>>>>>            // deactivate will do nothing when the object is not active
6950>>>>>>>            If (active_state(Self)) Begin
6952>>>>>>>                Send Request_Switch_to_Tab (If(iTab=iIC, iTab-1, iTab)) 3
6953>>>>>>>                Set current_item to (current_item(Self))
6954>>>>>>>            End
6954>>>>>>>>
6954>>>>>>>            // this is a double check and should not happen. If the focus is in the page
6954>>>>>>>            // we are in trouble. If it is sending activate will force focus to tab dialog (button)
6954>>>>>>>            If (containsFocus(hTabPg)) ;                Send Activate
6957>>>>>>>            Send destroy of hTabPg
6958>>>>>>>            Set in_tab_change_state to bOld
6959>>>>>>>        End
6959>>>>>>>>
6959>>>>>>>    End_Procedure
6960>>>>>>>    
6960>>>>>>>    Procedure Set WinValue Integer iItem String sVal
6962>>>>>>>        // This must get called to change an active tab button.
6962>>>>>>>        WString wsText
6962>>>>>>>        tWinTcItem TcItem
6962>>>>>>>        tWinTcItem TcItem
6962>>>>>>>        
6962>>>>>>>        // if active tab page - update the window control
6962>>>>>>>        If (Window_Handle(Self)) Begin
6964>>>>>>>            Move (sVal+Character(0)) to wsText      // Convert to wide
6965>>>>>>>            
6965>>>>>>>            Move TVIF_TEXT to TcItem.mask
6966>>>>>>>            Move (AddressOf(wsText)) to TcItem.pszText
6967>>>>>>>            Send Windows_Message TCM_SETITEM iItem (AddressOf(TcItem))
6968>>>>>>>        End
6968>>>>>>>>
6968>>>>>>>    End_Procedure
6969>>>>>>>    
6969>>>>>>>    // Private: this gets called to make sure that this page is active. Called during
6969>>>>>>>    //          next/prior object id. For this to work the ID must be in the focus tree
6969>>>>>>>    //
6969>>>>>>>    Procedure DoActivePage Handle hId
6971>>>>>>>        If not (Active_state(hid)) Begin
6973>>>>>>>            Set focus_mode of hId to focusable
6974>>>>>>>            Send add_focus of hId Self
6975>>>>>>>            Send DoHideTab hId True
6976>>>>>>>        End
6976>>>>>>>>
6976>>>>>>>    End_Procedure
6977>>>>>>>    
6977>>>>>>>    // Return the Prior tab. Skip tab pages where the button is shadowed
6977>>>>>>>    //
6977>>>>>>>    Function PriorTabId Returns Handle
6979>>>>>>>        Integer iTab iFirstTab
6979>>>>>>>        Handle  hId
6979>>>>>>>        Get Current_item to iFirstTab
6980>>>>>>>        Move iFirstTab to iTab
6981>>>>>>>        Repeat
6981>>>>>>>>
6981>>>>>>>            Decrement iTab
6982>>>>>>>            If (iTab<0) ;                Move (Button_Count(Self)-1) to iTab
6985>>>>>>>            If (iTab=iFirstTab) ;                Function_Return 0 // loop, no next ID
6988>>>>>>>        Until (not(Item_Shadow_State(Self,iTab)))
6990>>>>>>>        Get Tab_page_Id iTab to hId
6991>>>>>>>        Send DoactivePage hId  // make sure this is in the focus tree
6992>>>>>>>        Function_Return hId
6993>>>>>>>    End_Function
6994>>>>>>>    
6994>>>>>>>    // Return the next tab. Skip tab pages where the button is shadowed
6994>>>>>>>    //
6994>>>>>>>    Function NextTabId Returns Handle
6996>>>>>>>        Integer iTab iFirstTab
6996>>>>>>>        Handle  hId
6996>>>>>>>        Get Current_item to iFirstTab
6997>>>>>>>        Move iFirstTab to iTab
6998>>>>>>>        Repeat
6998>>>>>>>>
6998>>>>>>>            Increment iTab
6999>>>>>>>            If (iTab>=Button_Count(Self)) ;                Move 0 to iTab
7002>>>>>>>            If (iTab=iFirstTab) ;                Function_Return 0
7005>>>>>>>        Until (not(Item_Shadow_State(Self,iTab)))
7007>>>>>>>        Get Tab_page_Id iTab to hId
7008>>>>>>>        Send DoactivePage hId  // make sure this is in the focus tree
7009>>>>>>>        Function_Return hId
7010>>>>>>>    End_Function
7011>>>>>>>    
7011>>>>>>>    // augmented to create smarter next and previous behavior for tab buttons.
7011>>>>>>>    //
7011>>>>>>>    Procedure Next
7013>>>>>>>        Integer iItem eRotate
7013>>>>>>>        Handle  hId
7013>>>>>>>        Get current_item to iItem
7014>>>>>>>        Forward Send next // do normal next, try to give object in dialog the focus
7016>>>>>>>        // if focus is still on the same button, we failed...no object could take focus.
7016>>>>>>>        If (focus(desktop)=Self and current_item(Self)=iItem) Begin
7018>>>>>>>            // do the "next" befst thing. If rotatable, go to next tab button,
7018>>>>>>>            // else leave the tab dialog and go to next object
7018>>>>>>>            Get Rotate_mode to eRotate
7019>>>>>>>            If (eRotate=RM_Rotate_in_ring or ;                (eRotate=RM_Rotate and iItem<Button_count(Self)-1)) ;                Send request_next_tab // it is rotable, go to next tab page
7022>>>>>>>            Else Begin
7023>>>>>>>                // navigate out of this tab dialog.
7023>>>>>>>                Get next_object_id 1 to hId
7024>>>>>>>                If hID ;                    Send activate of hId
7027>>>>>>>            End
7027>>>>>>>>
7027>>>>>>>        End
7027>>>>>>>>
7027>>>>>>>    End_Procedure
7028>>>>>>>    
7028>>>>>>>    Procedure Previous
7030>>>>>>>        Integer iItem eRotate
7030>>>>>>>        Get current_item to iItem
7031>>>>>>>        Get Rotate_mode to eRotate
7032>>>>>>>        If (eRotate=RM_NONE or eRotate=RM_RING or iItem=0) ;            Forward Send previous
7036>>>>>>>        Else  ;            Send request_previous_tab
7038>>>>>>>    End_Procedure
7039>>>>>>>    
7039>>>>>>>    
7039>>>>>>>    // event called when Beginning_of_Panel is called by panel (usually view)
7039>>>>>>>    // by default, switch to the default tab (which is 0).
7039>>>>>>>    //
7039>>>>>>>    Procedure OnBeginningOfPanel Integer hoPanel
7041>>>>>>>        If (Button_Count(Self) and Default_Tab(Self)>=0) ; // note if default tab is -1,            Send Request_Tab_display                       // this behavior is stopped
7044>>>>>>>    End_Procedure
7045>>>>>>>    
7045>>>>>>>    // special for tab dialog. Note this must augment (and not replace) the next_object_id
7045>>>>>>>    // logic defined in standard_object_mixin,
7045>>>>>>>    // If descend (fg=0) we want to return
7045>>>>>>>    // the current tab page (it's the next object).
7045>>>>>>>    //
7045>>>>>>>    Function Next_Object_Id Integer fg Returns Integer
7047>>>>>>>        Integer hId rVal
7047>>>>>>>        If (fg=0) Begin            // if descend, next object is current tab page
7049>>>>>>>            Get Current_tab to hId // there should almost always be a current tab (unless no tabs)
7050>>>>>>>            If (hId<>-1) ;                Function_Return (Tab_page_id(Self,hId))
7053>>>>>>>            Move 1 to fg // odd case of no current tab, do a next level id
7054>>>>>>>        End
7054>>>>>>>>
7054>>>>>>>        Forward Get next_object_id FG to rval
7056>>>>>>>        Function_Return rval
7057>>>>>>>    End_Function
7058>>>>>>>End_Class
7059>>>>>>>
7059>>>>>>>
7059>>>>>>>Class Tab_Page_Mixin is a Mixin
7060>>>>>>>    
7060>>>>>>>    Procedure Define_Tab_Page_Mixin
7062>>>>>>>        Integer obj mode clr
7062>>>>>>>        Handle hoTD
7062>>>>>>>        
7062>>>>>>>        Property Integer Tab_Button_Item -1
7063>>>>>>>        
7063>>>>>>>        Property Integer Rotate_Mode RM_None
7064>>>>>>>        
7064>>>>>>>        Property Integer private_piImageIndex
7065>>>>>>>        
7065>>>>>>>        Property Integer private_pbHighlightTab
7066>>>>>>>        
7066>>>>>>>        Property Integer pbInsideActivate False // system maintained, prevents activation recursion
7067>>>>>>>        
7067>>>>>>>        Delegate Get Rotate_mode to Mode
7069>>>>>>>        Set Rotate_mode to Mode
7070>>>>>>>        Set Ring_state to True  // do not change this
7071>>>>>>>        
7071>>>>>>>        // system maintained. Determines if tab page is explicitly hidden within this dialog
7071>>>>>>>        Property Integer pbHidePage False
7072>>>>>>>        
7072>>>>>>>        // private: see GetContainerSize for docs on this
7072>>>>>>>        Property Integer piLastClientSize -1
7073>>>>>>>        
7073>>>>>>>        Set Border_Style to Border_None
7074>>>>>>>        Set Popup_State to True
7075>>>>>>>        Set Attach_parent_state to True
7076>>>>>>>        
7076>>>>>>>        Delegate Get Color to clr
7078>>>>>>>        Set Color to Clr
7079>>>>>>>        Delegate Get TextColor to clr
7081>>>>>>>        Set TextColor to Clr
7082>>>>>>>        
7082>>>>>>>        Move Self to obj
7083>>>>>>>        Set Label to '' // forces tab button to get created
7084>>>>>>>        
7084>>>>>>>        // handles case of dynamically create tab page
7084>>>>>>>        Get Parent to hoTD // the tab dialog
7085>>>>>>>        If (Active_state(hoTD) and Item_count(hoTD)=1) ;            Send Auto_Page Self
7088>>>>>>>    End_Procedure
7089>>>>>>>    
7089>>>>>>>    Procedure Page Integer iState
7091>>>>>>>        Integer cxy
7091>>>>>>>        
7091>>>>>>>        If (iState=1 and GuiLocation(Self)=0) ;            Send Auto_Page Self
7094>>>>>>>        Forward Send Page iState
7096>>>>>>>        // if paging and we've not set the original tab dialog size, do it now.
7096>>>>>>>        If (iState =1) Begin
7098>>>>>>>            If (piOriginalClientSize(Parent(Self)) = -1) Begin
7100>>>>>>>                Get Client_Size to cxy
7101>>>>>>>                Delegate Set piOriginalClientSize to cxy // this is the first page, so store the size.
7103>>>>>>>            End
7103>>>>>>>>
7103>>>>>>>        End
7103>>>>>>>>
7103>>>>>>>    End_Procedure
7104>>>>>>>    
7104>>>>>>>    
7104>>>>>>>    // This needs to get the client size relative to the last time the object was un-paged. If an object
7104>>>>>>>    // has never been unpaged, you need to get the size of the orignal tab dialog (the first time it was paged).
7104>>>>>>>    // The first time a tab page is paged, the tab-dialog's original size is set in piOriginalClientSize. This
7104>>>>>>>    // is what you want to use for any tab page the FIRST time it is paged (since all of the sizes of its
7104>>>>>>>    // child objects are set relative to that size). Any time a tab page is unpaged, you want your new frame
7104>>>>>>>    // of reference to be the size of client at the time the page is being unpaged (because that's what all of
7104>>>>>>>    // the current size of the child objects are set to). So, anytime a tab page is removed (see remove_object)
7104>>>>>>>    // the size of the client is recorded in piLastClientSize. This property defaults to -1, which means that
7104>>>>>>>    // the object has never been paged (or resized) so you should use the original tab dialog size (see page).
7104>>>>>>>    Function GetContainerClientSize Returns Integer
7106>>>>>>>        Integer iClientSize
7106>>>>>>>        Get piLastClientSize to iClientSize // if anything but -1, this is our new starting point for anchors
7107>>>>>>>        // if -1, we've never set it (never unpaged it)...so use the tab-dialog's orignal size
7107>>>>>>>        If (iClientSize=-1) ;            Delegate Get piOriginalClientSize to iClientSize
7111>>>>>>>        Function_Return iClientSize
7112>>>>>>>    End_Function
7113>>>>>>>    
7113>>>>>>>    Procedure Activate Returns Integer
7115>>>>>>>        Integer bFail
7115>>>>>>>        Integer iTab iCurTab
7115>>>>>>>        Handle  hId
7115>>>>>>>        Get tab_button_item to iTab   // this page's tab item #
7116>>>>>>>        Delegate Get Current_item to iCurTab   // the current tab number
7118>>>>>>>        // If we have a button and it is not yet active then this
7118>>>>>>>        // activate was sent directly. We need to make it go through
7118>>>>>>>        // the dialog logic (which will send activate here again with
7118>>>>>>>        // tab_active_state set true)
7118>>>>>>>        If ( iTab>=0 and iTab<>iCurTab ) ;            Delegate Send Request_switch_to_tab iTab 0 // 0=kbd Navigation
7122>>>>>>>        Else Begin
7123>>>>>>>            // if the page already contains the focus and we are not already in the
7123>>>>>>>            // middle of a tab change, then we want to give the focus to the button
7123>>>>>>>            // if pbInsideActivate is true, then we tried to give an child object the focus but it failed
7123>>>>>>>            If (pbInsideActivate(Self) or (ContainsFocus(Self) and In_tab_change_state(Self)=0)) ;                Delegate Get Tab_Change iTab 0 to bFail // 0=force to button
7127>>>>>>>            Else Begin
7128>>>>>>>                Set pbInsideActivate to True // recursion protection
7129>>>>>>>                // Let's just see where the next focus would end up
7129>>>>>>>                Get next_object_id 0 to hId
7130>>>>>>>                If (hId=0 or hId=Self or hId=parent(Self)) ; // if nothing to take the focus, force to button                    Delegate Get Tab_Change iTab 0 to bFail // 0=force to button
7134>>>>>>>                Else ; // This can recurse if there are no focusable children. If it does above will force to button                    Get MSG_Activate of hId to bFail // do a normal page activate. Focus will be in page somehwere
7136>>>>>>>                Set pbInsideActivate to False
7137>>>>>>>            End
7137>>>>>>>>
7137>>>>>>>        End
7137>>>>>>>>
7137>>>>>>>        // we will return a success even if it fails. next/previous navigation should decide where the next object
7137>>>>>>>        // should be. If this does not work, don't allow switch to keep trying
7137>>>>>>>        Procedure_Return 0 //bFail
7138>>>>>>>    End_Procedure
7139>>>>>>>    
7139>>>>>>>    
7139>>>>>>>    // Private: needed by navigation (next_object_id). Normally this checks to see if the object is
7139>>>>>>>    // a container and if it contains the focus. If it does, navigation will keep looking for
7139>>>>>>>    // another object to give the focus. With tab-pages a focus change will occur because activate
7139>>>>>>>    // to a tab page means, try to go to the button. So we override the standard behavior here
7139>>>>>>>    // and force it to say the focus will change.
7139>>>>>>>    //
7139>>>>>>>    Function ContainerFocusWillNotChange Returns Integer
7141>>>>>>>        Function_Return 0
7142>>>>>>>    End_Function
7143>>>>>>>    
7143>>>>>>>    
7143>>>>>>>    Procedure Set Value Integer iItem String sValue
7145>>>>>>>        Integer co id
7145>>>>>>>        Forward Set value iItem to sValue
7147>>>>>>>        Move Self to co
7148>>>>>>>        Get tab_button_item to id
7149>>>>>>>        If (id = -1) Begin
7151>>>>>>>            Delegate Get add_tab_item sValue co to id
7153>>>>>>>            Set Tab_button_item to id
7154>>>>>>>        End
7154>>>>>>>>
7154>>>>>>>        Else ;            Delegate Set Value id to sValue
7157>>>>>>>    End_Procedure
7158>>>>>>>    
7158>>>>>>>    // This is called anytime navigation (next_object_id & proir_object_id) would
7158>>>>>>>    // cause a "wrap" condition in a tab page. This function must return the object Id
7158>>>>>>>    // to naviagte to.
7158>>>>>>>    // Depending on the rotate_mode and skip_button_mode we need to return different target
7158>>>>>>>    // IDs.
7158>>>>>>>    //
7158>>>>>>>    Function OnChildWrapping Integer hoDest Integer bDown Returns Integer
7160>>>>>>>        Integer eRotate eSkip
7160>>>>>>>        Integer iPage
7160>>>>>>>        Handle  hId
7160>>>>>>>        Boolean bHasFoc
7160>>>>>>>        
7160>>>>>>>        Get rotate_mode to eRotate
7161>>>>>>>        Get Skip_button_mode to eSkip
7162>>>>>>>        Delegate Get current_Item to iPage
7164>>>>>>>        
7164>>>>>>>        Get ContainsFocus to bHasFoc // does this tab page already conatin the focus?
7165>>>>>>>        
7165>>>>>>>        // if not has focus and a ring, we have no focusable objects in here
7165>>>>>>>        // either go to tab button or get out
7165>>>>>>>        If not bHasFoc Begin
7167>>>>>>>            If (eSkip=SBM_ALWAYS) Begin
7169>>>>>>>                If bDown ;                    Delegate Get Next_object_id 1 to hId
7173>>>>>>>                Else ;                    Delegate Get Prior_object_id 0 to hId
7176>>>>>>>            End
7176>>>>>>>>
7176>>>>>>>            Else ;                Move Self to hId // will force to button
7178>>>>>>>            Function_Return hId
7179>>>>>>>        End
7179>>>>>>>>
7179>>>>>>>        
7179>>>>>>>        If (eRotate=RM_NONE) Begin
7181>>>>>>>            If bDown ;  // if down, leave the tab dialog object                Delegate Get Next_Object_id  1 to hId
7185>>>>>>>            Else Begin  // if up either go to prior object, or, move to the tab button
7186>>>>>>>                If (eSkip=SBM_ALWAYS) ;                    Delegate Get Prior_Object_id 0 to hId
7190>>>>>>>                Else ;                    Move Self to  hId // will force to button
7192>>>>>>>            End
7192>>>>>>>>
7192>>>>>>>        End
7192>>>>>>>>
7192>>>>>>>        
7192>>>>>>>        Else If (eRotate=RM_RING) Begin
7195>>>>>>>            // with rings assume the tab buttons are skipped unless they are
7195>>>>>>>            // specifically forced to tab button. So in this case, a sbm_smart w/
7195>>>>>>>            // rings will skip the tab.
7195>>>>>>>            If (eSkip<>SBM_NEVER) ;                Move hoDest to hId // let next object Id do whatever it does normally
7198>>>>>>>            Else ;                Move Self to  hId  // will force to button
7200>>>>>>>        End
7200>>>>>>>>
7200>>>>>>>        
7200>>>>>>>        Else Begin // if here either rotate or rotate in ring
7201>>>>>>>            If bDown Begin
7203>>>>>>>                If (eRotate=RM_Rotate_in_ring or iPage< (Button_count(Self)-1) ) ;                    Delegate Get NextTabId to hId
7207>>>>>>>                Else ;                    Delegate Get Next_Object_id 1 to hId
7210>>>>>>>            End
7210>>>>>>>>
7210>>>>>>>            Else Begin // if up
7211>>>>>>>                If (eSkip<>SBM_NEVER and (eRotate=RM_Rotate_in_ring or iPage>0)) Begin
7213>>>>>>>                    Delegate Get PriorTabId to hId
7215>>>>>>>                End
7215>>>>>>>>
7215>>>>>>>                Else Begin
7216>>>>>>>                    If (eSkip=SBM_ALWAYS) ;                        Delegate Get Prior_Object_id 0 to hId
7220>>>>>>>                    Else ;                        Move Self to hId // will force to button
7222>>>>>>>                End
7222>>>>>>>>
7222>>>>>>>            End
7222>>>>>>>>
7222>>>>>>>        End
7222>>>>>>>>
7222>>>>>>>        Function_Return hid
7223>>>>>>>    End_Function
