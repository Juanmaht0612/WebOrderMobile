2571>>>>>>>
2571>>>>>>>// replace key procedure to properly check numeric keyboard values
2571>>>>>>>Procedure Private.Key for cUIObject Integer iKy Returns Integer
2573>>>>>>>    Integer iRet iCh iType iSep
2573>>>>>>>    // if up or down arrow, always pass it through. These can be generated
2573>>>>>>>    // by non key events and we want them to work.  Fixes bug where sending
2573>>>>>>>    // up or down in grids might not work because the last key-pressed was
2573>>>>>>>    // something different and invalid
2573>>>>>>>    
2573>>>>>>>    // if key is up-arrow, dn-arrow or a contrl key, let runtime handle it
2573>>>>>>>    // If not (iKy=kUparrow or iKy=kDownarrow) begin
2573>>>>>>>    If not (iKy=kUparrow or iKy=kDownarrow or (iKy iand key_ctrl)) Begin
2575>>>>>>>        
2575>>>>>>>        Get Form_DataType CURRENT to iType
2576>>>>>>>        
2576>>>>>>>        // only special check non mask date and all numerics.
2576>>>>>>>        // for some reason mask numerics allow bad character to slip
2576>>>>>>>        // in. We can filter them here.
2576>>>>>>>        //If ( iType<=DATE_WINDOW or iType=MASK_CURRENCY_WINDOW or iType=MASK_NUMERIC_WINDOW) Begin
2576>>>>>>>        // we will pass through all strings and all masks. As of 8.2, masks will figure out if a character is valid
2576>>>>>>>        
2576>>>>>>>        // We only need to test non-mask dates and windows.
2576>>>>>>>        If ( iType<=DATE_WINDOW) Begin
2578>>>>>>>            
2578>>>>>>>            // convert to DF key. If ascii, ret ascii/Char value else ret DF key value
2578>>>>>>>            Get dfkey iKy to iCh
2579>>>>>>>            // char is ok if between '0' and '9 or above 255 or a BS (8)
2579>>>>>>>            If ( (iCh<48 and iCh <> 8) or (iCh>57 and iCh<=255)) Begin // Changed by FVDV for Backspace support
2581>>>>>>>                If (iType = DATE_WINDOW) Begin // date type
2583>>>>>>>                    Get_Attribute DF_DATE_SEPARATOR to iSep //check for date separator
2586>>>>>>>                    If (iSep <> iCh) ;                        Procedure_Return 0
2589>>>>>>>                End
2589>>>>>>>>
2589>>>>>>>                Else Begin // numeric type. 32=" ", 45="-"
2590>>>>>>>                    If (iCh<>32 and iCh<>45) Begin
2592>>>>>>>                        Get_Attribute DF_DECIMAL_SEPARATOR to iSep
2595>>>>>>>                        If (iSep <> iCh) ;                            Procedure_Return 0
2598>>>>>>>                    End
2598>>>>>>>>
2598>>>>>>>                End
2598>>>>>>>>
2598>>>>>>>            End
2598>>>>>>>>
2598>>>>>>>        End
2598>>>>>>>>
2598>>>>>>>    End
2598>>>>>>>>
2598>>>>>>>    // this means the key is ok
2598>>>>>>>    Set Windows_override_state to False
2599>>>>>>>    Procedure_Return 0
2600>>>>>>>End_Procedure
