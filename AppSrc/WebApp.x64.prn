5410>>>>>        If (iItem <> iLastItem) ;            Send OnChange
5413>>>>>    End_Procedure
5414>>>>>    
5414>>>>>    // The following procedures should be moved to C code. This resolves
5414>>>>>    // certain issues with mapping DF list controls to windows controls.
5414>>>>>    // Users are encouraged to only use two modes of list selection:
5414>>>>>    //     select_mode = MULTI_SELECT | SINGLE_SELECT
5414>>>>>    // DO NOT use NO_Select - it won't work right.
5414>>>>>    //
5414>>>>>    // Special functionality to Note:
5414>>>>>    //
5414>>>>>    // 1.  Set Select_Count to TRUE : If multi-select sets all select-states to TRUE
5414>>>>>    //                            if single-select sets current item to TRUE
5414>>>>>    //   Set Select_Count to FALSE: Sets all items to false
5414>>>>>    //
5414>>>>>    // 2. Space bar no Longer toggles select state. If you want this. Create the following:
5414>>>>>    //      on_key key_space send toggle_Current_item
5414>>>>>    //
5414>>>>>    // 3. There is no message that is fired every time the select-state changes.
5414>>>>>    //
5414>>>>>    // 4. There is no message that ALWAYS gets sent when an object's select_state is
5414>>>>>    //    toggled (e.g. marking range via shift+mouse). Do not use set select_state or
5414>>>>>    //    item_changed_state for multi-select augmentations. With single select lists
5414>>>>>    //    you CAN use set current_item or set Select_State
5414>>>>>    
5414>>>>>    // when paging non-multi lists the select-state item is lost. This fixes this
5414>>>>>    //
5414>>>>>    Procedure Page Integer bState
5416>>>>>        Integer iCur bSel
5416>>>>>        Get current_item to iCur
5417>>>>>        If (item_count(Self)) Begin
5419>>>>>            Get select_state iCur to bSel   // remember what it was
5420>>>>>            Forward Send page bState // if single select, select state will be lost
5422>>>>>            // if paged, and non multi-select and the current item was selected, then
5422>>>>>            // set select_state again to force it to be correct.
5422>>>>>            If (bSel and window_handle(Self) and select_mode(Self)<>MULTI_SELECT) ;                Set select_state iCur to True // reinstae what was
5425>>>>>        End
5425>>>>>>
5425>>>>>        Else ;            Forward Send page bState
5428>>>>>    End_Procedure
5429>>>>>    
5429>>>>>    // Set Select_Count is supposed to clear or select all items. This fixes
5429>>>>>    // it to do the following:
5429>>>>>    //   If F               - clear all selected items
5429>>>>>    //   if T and Multi     - Select all items
5429>>>>>    //   If T and not Multi - Set select-state of current item to True
5429>>>>>    //
5429>>>>>    Procedure Set Select_Count Integer bState
5431>>>>>        Integer i iCnt
5431>>>>>        Get item_count to iCnt
5432>>>>>        // if true and single item. Just set the one item
5432>>>>>        If (bState and iCnt and select_mode(Self)<>MULTI_SELECT) ;            Set select_state (current_item(Self)) to True
5435>>>>>        Else Begin
5436>>>>>            Decrement iCnt
5437>>>>>            For i from 0 to iCnt
5443>>>>>>
5443>>>>>                Set select_state i to bState
5444>>>>>            Loop
5445>>>>>>
5445>>>>>        End
5445>>>>>>
5445>>>>>    End_Procedure
5446>>>>>    
5446>>>>>    // The internal Select_Count gets hopelessly out of synch with the
5446>>>>>    // select count in the windows control. Here is what we must do:
5446>>>>>    // 1. If no-window control -find the count the hard way. Count them!
5446>>>>>    // 2. If window control and Multi select: Forward get count
5446>>>>>    //                 this works because when paged, DF just gets the LB_SELCOUNT property
5446>>>>>    //                 which is right)
5446>>>>>    // 3. If window control and not multi: Will either be 0 or 1. Check current_item to
5446>>>>>    //                 see if it is selected. We can't use LB_SELCOUNT because it returns -1
5446>>>>>    //
5446>>>>>    Function Select_Count Returns Integer
5448>>>>>        Integer iCnt i iSel
5448>>>>>        Get item_count to iCnt
5449>>>>>        If (window_handle(Self)) Begin
5451>>>>>            If (select_mode(Self)=MULTI_SELECT) ;                Forward Get select_count to iSel
5455>>>>>            Else If iCnt ;                Move (If(Select_state(Self,current_item(Self)),1,0)) to iSel
5459>>>>>        End
5459>>>>>>
5459>>>>>        Else Begin
5460>>>>>            Decrement iCnt
5461>>>>>            For i from 0 to iCnt
5467>>>>>>
5467>>>>>                If (select_state(Self,i)) ;                    Increment iSel
5470>>>>>            Loop
5471>>>>>>
5471>>>>>        End
5471>>>>>>
5471>>>>>        Function_Return iSel
5472>>>>>    End_Function
5473>>>>>    
5473>>>>>    
5473>>>>>    // Correct select-states for paged lists.
5473>>>>>    // When the list is not paged  it is fine.
5473>>>>>    // When paged, and singlethe only way to get the item selected is to set
5473>>>>>    // its current_item. The only way to clear a selected item is to
5473>>>>>    // send the windows message LB_SERCURSEL
5473>>>>>    // when multi, we need to send windows messages LB_SETSEL
5473>>>>>    //
5473>>>>>    Procedure Set Select_State Integer iItm Integer bSt
5475>>>>>        Integer cnt i sc
5475>>>>>        // if not paged, just forward..RT handles this find
5475>>>>>        If (window_handle(Self)=0) ;            Forward Set select_state iItm to bSt
5479>>>>>        Else Begin // if paged
5480>>>>>            //...only change if a change is needed
5480>>>>>            If (Select_State(Self,iItm)<>bSt)  Begin
5482>>>>>                If (select_mode(Self)=MULTI_SELECT) ; // if multi-select                    Send windows_message LB_SETSEL bSt iItm
5485>>>>>                Else  Begin // single item, auto or no select.
5486>>>>>                    // if setting, we must set current_item. If clearing, we
5486>>>>>                    // must clear all (-1)
5486>>>>>                    Send windows_message LB_SETCURSEL (If(bSt,iItm,-1)) 0
5487>>>>>                End
5487>>>>>>
5487>>>>>            End
5487>>>>>>
5487>>>>>        End
5487>>>>>>
5487>>>>>    End_Procedure
5488>>>>>    
5488>>>>>    Procedure toggle_Current_item
5490>>>>>        Integer iCur
5490>>>>>        Get current_item to iCur
5491>>>>>        Set select_state iCur to (not(select_state(Self,iCur)))
5492>>>>>    End_Procedure
5493>>>>>End_Class
