29024>>>>>>>>>>>    Procedure AddTag String sTag
29026>>>>>>>>>>>        String[] aTags
29027>>>>>>>>>>>        
29027>>>>>>>>>>>        Send RemoveTag sTag
29028>>>>>>>>>>>        
29028>>>>>>>>>>>        Get GetTags to aTags
29029>>>>>>>>>>>        Move sTag to aTags[SizeOfArray(aTags)]
29030>>>>>>>>>>>        Send UpdateTags aTags
29031>>>>>>>>>>>    End_Procedure
29032>>>>>>>>>>>        
29032>>>>>>>>>>>    Procedure InsertTagBefore String sNextTag String sInsertTag
29034>>>>>>>>>>>        Send InsertTagRelative sNextTag True sInsertTag
29035>>>>>>>>>>>    End_Procedure
29036>>>>>>>>>>>    
29036>>>>>>>>>>>    Procedure InsertTagAfter String sPrevTag String sInsertTag
29038>>>>>>>>>>>        Send InsertTagRelative sPrevTag False sInsertTag
29039>>>>>>>>>>>    End_Procedure
29040>>>>>>>>>>>        
29040>>>>>>>>>>>    Procedure InsertTagRelative String sRelativeTag Boolean bToLeft String sInsertTag
29042>>>>>>>>>>>        Integer iIndex iOffset
29042>>>>>>>>>>>        Boolean bAdded bCaseSensitive
29042>>>>>>>>>>>        String sNormalizedInsertTag sNormalizedCacheTag
29042>>>>>>>>>>>        String[] asTags
29043>>>>>>>>>>>        Handle hoSelectionSource
29043>>>>>>>>>>>        
29043>>>>>>>>>>>        // We need to trim both parameters to be sure we comply to the client parsing.
29043>>>>>>>>>>>        Move (Trim(sRelativeTag)) to sRelativeTag
29044>>>>>>>>>>>        Move (Trim(sInsertTag)) to sInsertTag
29045>>>>>>>>>>>        
29045>>>>>>>>>>>        Get phoSelectionSource to hoSelectionSource
29046>>>>>>>>>>>        
29046>>>>>>>>>>>        // Lower if specified.
29046>>>>>>>>>>>        Get pbCaseSensitive of hoSelectionSource to bCaseSensitive
29047>>>>>>>>>>>        If (not(bCaseSensitive)) Begin
29049>>>>>>>>>>>            Move (Uppercase(sRelativeTag)) to sRelativeTag
29050>>>>>>>>>>>            Move (Uppercase(sInsertTag)) to sNormalizedInsertTag
29051>>>>>>>>>>>        End
29051>>>>>>>>>>>>
29051>>>>>>>>>>>        Else ;            Move sInsertTag to sNormalizedInsertTag
29053>>>>>>>>>>>        
29053>>>>>>>>>>>        // Skip if both are the same or if any is empty.
29053>>>>>>>>>>>        If (sRelativeTag = sNormalizedInsertTag or ;            Length(sRelativeTag) = 0 or ;            Length(sNormalizedInsertTag) = 0) ;            Procedure_Return
29056>>>>>>>>>>>            
29056>>>>>>>>>>>        // Set the offset
29056>>>>>>>>>>>        Move (If(bToLeft, 0, 1)) to iOffset
29057>>>>>>>>>>>        
29057>>>>>>>>>>>        // Initialize the tags
29057>>>>>>>>>>>        Move False to bAdded
29058>>>>>>>>>>>        Get GetTags to asTags
29059>>>>>>>>>>>        
29059>>>>>>>>>>>        // Loop the tags till we find our target; if not found we insert it at the end [not(bBreak)].
29059>>>>>>>>>>>        While (iIndex < SizeOfArray(asTags))
29063>>>>>>>>>>>            // Normalize current tag; the relative is already normalized.
29063>>>>>>>>>>>            Move asTags[iIndex] to sNormalizedCacheTag
29064>>>>>>>>>>>            If (not(bCaseSensitive)) ;                Move (Uppercase(sNormalizedCacheTag)) to sNormalizedCacheTag
29067>>>>>>>>>>>            
29067>>>>>>>>>>>            // If it is the tag we insert it and skip the inserted tag and the next othrwise it would cause recursion.
29067>>>>>>>>>>>            If (sNormalizedCacheTag = sRelativeTag) Begin
29069>>>>>>>>>>>                Move (InsertInArray(asTags, iIndex + iOffset, sInsertTag)) to asTags
29070>>>>>>>>>>>                Move True to bAdded
29071>>>>>>>>>>>                Move (iIndex + 2) to iIndex
29072>>>>>>>>>>>            End
29072>>>>>>>>>>>>
29072>>>>>>>>>>>            // If we find the same instances we remove it since the client would do it either way.
29072>>>>>>>>>>>            Else If (sNormalizedCacheTag = sNormalizedInsertTag) Begin
29075>>>>>>>>>>>                Move (RemoveFromArray(asTags, iIndex)) to asTags
29076>>>>>>>>>>>            End
29076>>>>>>>>>>>>
29076>>>>>>>>>>>            Else ;                Increment iIndex
29078>>>>>>>>>>>        Loop
29079>>>>>>>>>>>>
29079>>>>>>>>>>>        
29079>>>>>>>>>>>        If (not(bAdded)) ;            Move sInsertTag to asTags[SizeOfArray(asTags)]
29082>>>>>>>>>>>            
29082>>>>>>>>>>>        // Update the tags.
29082>>>>>>>>>>>        Send UpdateTags asTags
29083>>>>>>>>>>>    End_Procedure
