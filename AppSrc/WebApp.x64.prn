17235>>>>>    // Interface to support attaching and detaching WBOs and WebApps from sessions
17235>>>>>    
17235>>>>>    // Clear the contents of all open files, except system files
17235>>>>>    Procedure DoDetachAllTables
17237>>>>>        Handle hFile
17237>>>>>        Integer bIsSys
17237>>>>>        Move 0 to hFile
17238>>>>>        Repeat
17238>>>>>>
17238>>>>>            Get_Attribute DF_FILE_NEXT_OPENED of hFile to hFile
17241>>>>>            If (hFile>0) Begin
17243>>>>>                Get_Attribute DF_FILE_IS_SYSTEM_FILE of hFile to bIsSys
17246>>>>>                If not bIsSys ;                    Clear hFile // do not clear system files
17249>>>>>            End
17249>>>>>>
17249>>>>>        Until (hFile=0)
17251>>>>>    End_Procedure
17252>>>>>    
17252>>>>>    Procedure DoDetachProcess
17254>>>>>        Integer eAttachStatus
17254>>>>>        Integer bOldQueueErrors bOldAllErrorsToHtml
17254>>>>>        Integer i iWBOs eWebAppEndPointEnvironment
17254>>>>>        Handle hWBO
17254>>>>>        
17254>>>>>        // See notes about change in DoAttachProcess.
17254>>>>>
17254>>>>>        // Set error handling settings to report all errors, but not to html
17254>>>>>        Get pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
17255>>>>>        Get pbQueueErrors     of ghInetSession to bOldQueueErrors
17256>>>>>        Set pbAllErrorsToHtml of ghInetSession to False // no error output to html
17257>>>>>        Set pbQueueErrors     of ghInetSession to False // do not queue errors, report them.
17258>>>>>
17258>>>>>        // the status before a detach should always C_asAttached. Check
17258>>>>>        Get peAttachStatus to eAttachStatus
17259>>>>>        If (eAttachStatus<>C_asAttached) ;            Send LogEvent 101 (SFormat(C_$WrongDoDetachStatus, eAttachStatus))
17262>>>>>
17262>>>>>        Set peAttachStatus to C_asDetaching
17263>>>>>        
17263>>>>>        // User hook
17263>>>>>        Send OnDetachProcess
17264>>>>>        
17264>>>>>        // send DoDetachProcess to all legacy WBOs
17264>>>>>        Get WBOCount to iWBOs
17265>>>>>        Decrement iWBOs
17266>>>>>        For i from 0 to iWBOs
17272>>>>>>
17272>>>>>            Get WBOHandle i to hWBO
17273>>>>>            Send DoDetachProcess of hWBO
17274>>>>>        Loop
17275>>>>>>
17275>>>>>        
17275>>>>>        // For ASP we do not wait for OnReleaseProcess, since that does not get triggered after each detach
17275>>>>>        Get CurrentWebAppEnvironment of ghInetSession to eWebAppEndPointEnvironment
17276>>>>>        If (eWebAppEndPointEnvironment = WebAppEnvASP) Begin
17278>>>>>            Set peAttachStatus to C_asDetached
17279>>>>>        End
17279>>>>>>
17279>>>>>        
17279>>>>>
17279>>>>>        // restore error handling settings
17279>>>>>        Set pbQueueErrors     of ghInetSession to bOldQueueErrors
17280>>>>>        Set pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
17281>>>>>    End_Procedure
17282>>>>>    
17282>>>>>
17282>>>>>    Function DoAttachProcess Returns Integer
17284>>>>>        Integer eAttachStatus
17284>>>>>        Integer bOldQueueErrors bOldAllErrorsToHtml
17284>>>>>        Integer iWBOs i iError
17284>>>>>        Handle hWBO
17284>>>>>        
17284>>>>>        // We used to send OnAttachProcess to all Web objects but not send this to Web service objects. 
17284>>>>>        // This seems like too much and too little. We now Send OnAttachProcess
17284>>>>>        // to just the cWebApp object for all types of calls (WO, WSO, HTTP). However, we still send it for
17284>>>>>        // WO (asp) calls, for the sake of backwards compatibility. Unless you use a cWebBusinessProcess this does
17284>>>>>        // nothing. In addition, we used to Send DoDetachAllTables
17284>>>>>        // to clear all tables with old style WebApps. We no longer do that for any type of webapp. The messages is
17284>>>>>        // still there so if you need to do this you can do this yourself in OnAttachProcess. 
17284>>>>>
17284>>>>>        // Set error handling settings to report all errors, but not to html
17284>>>>>        Get pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
17285>>>>>        Get pbQueueErrors     of ghInetSession to bOldQueueErrors
17286>>>>>        Set pbAllErrorsToHtml of ghInetSession to False // no error output to html
17287>>>>>        Set pbQueueErrors     of ghInetSession to False // do not queue errors, report them.
17288>>>>>
17288>>>>>        Get peAttachStatus to eAttachStatus
17289>>>>>        If (eAttachStatus<>C_asDetached and eAttachStatus<>C_asUndefined) Begin
17291>>>>>            Send LogEvent 102 (SFormat(C_$WrongDoAttachStatus, eAttachStatus))
17292>>>>>            Function_Return 1
17293>>>>>        End
17293>>>>>>
17293>>>>>
17293>>>>>        Set peAttachStatus to C_asAttaching
17294>>>>>
17294>>>>>        // send DoAttachProcess to all legacy WBOs.
17294>>>>>        Get WBOCount to iWBOs
17295>>>>>        Decrement iWBOs
17296>>>>>        For i from 0 to iWBOs
17302>>>>>>
17302>>>>>            Get WBOHandle i to hWBO
17303>>>>>            // note that cWebAspClassicObjects will get this but do nothing. cWebBusinessProcess will
17303>>>>>            // get this and do stuff which should be considered private and legacy.
17303>>>>>            Send DoAttachProcess of hWBO
17304>>>>>        Loop
17305>>>>>>
17305>>>>>        
17305>>>>>            Set peAttachStatus to C_asAttached
17306>>>>>                
17306>>>>>        // restore error handling settings
17306>>>>>        Set pbQueueErrors     of ghInetSession to bOldQueueErrors
17307>>>>>        Set pbAllErrorsToHtml of ghInetSession to bOldAllErrorsToHtml
17308>>>>>        
17308>>>>>        Function_Return 0
17309>>>>>    End_Function
17310>>>>>    
17310>>>>>    Procedure DoReleaseProcess
17312>>>>>        // User hook
17312>>>>>        Send OnReleaseProcess
17313>>>>>        
17313>>>>>        Set peAttachStatus to C_asDetached
17314>>>>>    End_Procedure
