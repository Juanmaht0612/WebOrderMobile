25095>>>>>>>
25095>>>>>>>    // Send this to the stack view to Navigate Back down the View Stack to this view.
25095>>>>>>>    // The target view can be in any position in the current view stack, but 
25095>>>>>>>    // it must belong to the current view stack.
25095>>>>>>>    //
25095>>>>>>>    // Each view in the view stack, above the target view, will be tested for
25095>>>>>>>    // data loss (pending saves). If one of the higher views requires a save
25095>>>>>>>    // then it will be activated instead and the "save changes" message will
25095>>>>>>>    // be shown.
25095>>>>>>>    //
25095>>>>>>>    // Typically, this message will be called by a breadcrumb navigation control.
25095>>>>>>>    //
25095>>>>>>>    Procedure NavigateBack Handle hoTargetView Boolean bUnconditional
25097>>>>>>>        Handle hoView hoInvokingView hoTopView  
25097>>>>>>>        Integer iIndex
25097>>>>>>>        Boolean bTopChanged
25097>>>>>>>        Integer iStackViews
25097>>>>>>>        tWebViewInfo[] aViewStack
25097>>>>>>>        tWebViewInfo[] aViewStack
25098>>>>>>>        
25098>>>>>>>        Get TopViewHandle to hoTopView
25099>>>>>>>        If not hoTopView Begin
25101>>>>>>>            Procedure_Return
25102>>>>>>>        End
25102>>>>>>>>
25102>>>>>>>        
25102>>>>>>>        Get GetViewIndex hoTargetView to iIndex
25103>>>>>>>        If (iIndex=-1) Begin
25105>>>>>>>            Error DFERR_PROGRAM "Target view not in view stack"
25106>>>>>>>>
25106>>>>>>>            Procedure_Return
25107>>>>>>>        End
25107>>>>>>>>
25107>>>>>>>
25107>>>>>>>        If bUnconditional Begin
25109>>>>>>>            Move hoTargetView to hoView
25110>>>>>>>        End
25110>>>>>>>>
25110>>>>>>>        Else Begin
25111>>>>>>>            Get InvokingViewHandle to hoInvokingView
25112>>>>>>>    
25112>>>>>>>            If (hoTargetView = hoInvokingView) Begin
25114>>>>>>>                Send NavigateCancel of hoTopView
25115>>>>>>>                Procedure_Return
25116>>>>>>>            End
25116>>>>>>>>
25116>>>>>>>    
25116>>>>>>>            // If we are not the current top then make sure we are not popping off
25116>>>>>>>            // any views that have pending changes (should save)...
25116>>>>>>>            Get IsViewChanged of hoTopView to bTopChanged
25117>>>>>>>            Get CanCloseViews hoTargetView True to hoView
25118>>>>>>>            If (hoView = hoTargetView and bTopChanged) Begin
25120>>>>>>>               Send NavigateCancelTo of hoTopView hoView 
25121>>>>>>>               Procedure_Return
25122>>>>>>>            End
25122>>>>>>>>
25122>>>>>>>            Else If (bTopChanged) Begin
25125>>>>>>>               Move hoTopView to hoView 
25126>>>>>>>            End
25126>>>>>>>>
25126>>>>>>>    
25126>>>>>>>            If (hoView <> hoTargetView) Begin
25128>>>>>>>                Send CantCloseChangedViewError
25129>>>>>>>            End
25129>>>>>>>>
25129>>>>>>>        End
25129>>>>>>>>
25129>>>>>>>        // finish the navigation back to the view
25129>>>>>>>        If (hoView <> hoTopView) Begin
25131>>>>>>>            Send NavigateBackToHere of hoView True 0
25132>>>>>>>        End
25132>>>>>>>>
25132>>>>>>>    End_Procedure
25133>>>>>>>
25133>>>>>>>    // navigate back to named view.
25133>>>>>>>    Procedure NavigateBackByName String sViewName
25135>>>>>>>        Handle hoView hoTopView
25135>>>>>>>        If (sViewName <> "") Begin
25137>>>>>>>            Get WebObjectByName sViewName to hoView
25138>>>>>>>            Get TopViewHandle to hoTopView
25139>>>>>>>            If (hoView > 0 and hoView <> hoTopView) Begin
25141>>>>>>>                Send NavigateBack hoView False
25142>>>>>>>            End
25142>>>>>>>>
25142>>>>>>>        End
25142>>>>>>>>
25142>>>>>>>    End_Procedure
