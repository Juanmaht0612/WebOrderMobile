32624>>>>>    
32624>>>>>    // Generates the view state hash for the drill-down model. Recursively calls its invoking view
32624>>>>>    // (if it is in sync) to get the entire view stack in the hash.
32624>>>>>    //
32624>>>>>    // Returns:
32624>>>>>    //      View state hash including hashes of invoking views.
32624>>>>>    Function GenerateStateHash_DrillDown Returns String
32626>>>>>        String sInvokingHash sViewHash sHash sName sId sCustom sRowId
32626>>>>>        Boolean bInScope
32626>>>>>        Handle hoInvokingView hoDefault hoMain hoInvokingObject
32626>>>>>        tWebNavigateData navData
32626>>>>>        tWebNavigateData navData
32626>>>>>        Integer eViewType eStateMode
32626>>>>>        RowID rRowId
32626>>>>>        
32626>>>>>        Get InvokingViewHandleByView of (ViewStack(Self)) Self to hoInvokingView
32627>>>>>        Get peStateMode to eStateMode
32628>>>>>        Get GetDefaultView of (Host(Self)) to hoDefault
32629>>>>>        
32629>>>>>        
32629>>>>>        If (eStateMode <> vsmOff) Begin
32631>>>>>            Get peViewType to eViewType
32632>>>>>            
32632>>>>>            
32632>>>>>            //  For zoom views or record views we look at the main DD
32632>>>>>            If (eStateMode = vsmRecord or (eViewType = vtZoom and eStateMode = vsmDefault)) Begin
32634>>>>>                Get Main_DD to hoMain
32635>>>>>                
32635>>>>>                If (hoMain > 0) Begin
32637>>>>>                    Get CurrentRowId of hoMain to rRowId
32638>>>>>                    
32638>>>>>                    Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sId
32639>>>>>                End
32639>>>>>>
32639>>>>>            End
32639>>>>>>
32639>>>>>            Else If (eStateMode = vsmDefault) Begin
32642>>>>>                //  For other views we we look at the navigation data (if eStatEMode is default)
32642>>>>>                Get GetNavigateData to navData
32643>>>>>                
32643>>>>>                Case Begin
32643>>>>>                    Case (navData.eNavigateType = nfFromParent)
32645>>>>>                    Case (navData.eNavigateType = nfFromChild)
32648>>>>>                    Case (navData.eNavigateType = nfFromMain) 
32651>>>>>                        If (hoInvokingView = C_WebUnresolvedObject) Begin
32653>>>>>                            Function_Return ""
32654>>>>>                        End
32654>>>>>>
32654>>>>>                        
32654>>>>>                        If (navData.bNewRecord) Begin
32656>>>>>                            Move "" to sId    
32657>>>>>                        End
32657>>>>>>
32657>>>>>                        Else Begin
32658>>>>>                            Move navData.sRowID to sRowId
32659>>>>>                        End
32659>>>>>>
32659>>>>>                        
32659>>>>>                        Get GenerateStateHashRecordId of hoInvokingView navData.iTable (DeserializeRowID(sRowId)) to sId
32660>>>>>                        
32660>>>>>                        Case Break
32661>>>>>                Case End
32661>>>>>            End
32661>>>>>>
32661>>>>>        
32661>>>>>            Get GetInvokingObject to hoInvokingObject
32662>>>>>            Get StateHashKey hoInvokingObject to sName
32663>>>>>            
32663>>>>>            If (sName <> "") Begin
32665>>>>>                Send OnDefineCustomStateHash (&sCustom)
32666>>>>>            
32666>>>>>                Get ConcatViewStateHash of (Host(Self)) sName sId sCustom to sViewHash
32667>>>>>            End
32667>>>>>>
32667>>>>>        End
32667>>>>>>
32667>>>>>        
32667>>>>>        If (hoInvokingView <> C_WebUnresolvedObject) Begin
32669>>>>>            Get IsInCallActionScope of hoInvokingView to bInScope
32670>>>>>            If (bInScope) Begin
32672>>>>>                Get GenerateStateHash_DrillDown of hoInvokingView to sInvokingHash
32673>>>>>                WebSet psInvokingStateHash to sInvokingHash
32674>>>>>            End
32674>>>>>>
32674>>>>>            Else Begin
32675>>>>>                WebGet psInvokingStateHash to sInvokingHash 
32676>>>>>            End
32676>>>>>>
32676>>>>>            
32676>>>>>        End
32676>>>>>>
32676>>>>>        
32676>>>>>        If (eStateMode <> vsmOff) Begin
32678>>>>>            Get AppendStateHash of (Host(Self)) sInvokingHash sViewHash to sHash
32679>>>>>        End
32679>>>>>>
32679>>>>>        Else Begin
32680>>>>>            Move sInvokingHash to sHash
32681>>>>>        End
32681>>>>>>
32681>>>>>        
32681>>>>>        Function_Return sHash
32682>>>>>    End_Function
32683>>>>>    
32683>>>>>
32683>>>>>    // Restores the view state for desktop style by performing a find if needed.
32683>>>>>    //
32683>>>>>    // Params:
32683>>>>>    //      sRecordId       Record id.
32683>>>>>    //      bManualEnter    True if the state was changed manually so a find should be done (the
32683>>>>>    //                      back button won't cause a find on desktop-style).
32683>>>>>    Procedure RestoreViewState_Desktop String sRecordId Boolean bManualEnter
32685>>>>>        String sRowId
32685>>>>>        Integer iPos
32685>>>>>        Handle hoMain
32685>>>>>        RowID rRowId
32685>>>>>        Boolean bValid
32685>>>>>        
32685>>>>>        If (pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
32687>>>>>            If (bManualEnter) Begin
32689>>>>>                Get Main_DD to hoMain
32690>>>>>                
32690>>>>>                If (hoMain > 0) Begin
32692>>>>>                    Get HashRecordIdToRowId (Main_File(hoMain)) sRecordId (&rRowId) to bValid  
32693>>>>>                    If (bValid and not(IsSameRowID(CurrentRowId(hoMain), rRowId))) Begin
32695>>>>>                        Send FindByRowId of hoMain (Main_File(hoMain)) rRowId
32696>>>>>                    End
32696>>>>>>
32696>>>>>                    Else If (not(bValid)) Begin
32699>>>>>                        
32699>>>>>                        If (pbStateHashInvalidError(Host(Self))) Begin
32701>>>>>                            Error DFERR_WEBAPP_INVALID_URL_REC
32702>>>>>>
32702>>>>>                        End
32702>>>>>>
32702>>>>>                        Send Clear of hoMain
32703>>>>>                    End
32703>>>>>>
32703>>>>>                End
32703>>>>>>
32703>>>>>            End
32703>>>>>>
32703>>>>>            Else Begin
32704>>>>>                Send UpdateStateHash True
32705>>>>>            End
32705>>>>>>
32705>>>>>        End
32705>>>>>>
32705>>>>>    End_Procedure
32706>>>>>    
32706>>>>>    
32706>>>>>    // Generates the view state hash for desktop-style.
32706>>>>>    //
32706>>>>>    // Returns:
32706>>>>>    //      View state string.
32706>>>>>    Function GenerateStateHash_Desktop Returns String
32708>>>>>        String sState sName sCustom sRowId sRecordId
32708>>>>>        Handle hoMain
32708>>>>>        RowID rRowId
32708>>>>>        Integer eStateMode
32708>>>>>        
32708>>>>>        Get peStateMode to eStateMode
32709>>>>>        
32709>>>>>        If (eStateMode = vsmOff) Begin
32711>>>>>            Function_Return ""
32712>>>>>        End
32712>>>>>>
32712>>>>>        
32712>>>>>        If ((eStateMode = vsmDefault or eStateMode = vsmRecord) and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self)) Begin
32714>>>>>            Get Main_DD to hoMain
32715>>>>>            If (hoMain > 0) Begin
32717>>>>>                Get CurrentRowId of hoMain to rRowId
32718>>>>>                
32718>>>>>                Get GenerateStateHashRecordId (Main_File(hoMain)) rRowId to sRecordId
32719>>>>>            End
32719>>>>>>
32719>>>>>        End
32719>>>>>>
32719>>>>>        
32719>>>>>        Get psStateViewName to sName
32720>>>>>        
32720>>>>>        Send OnDefineCustomStateHash (&sCustom)
32721>>>>>        
32721>>>>>        Get ConcatViewStateHash of (Host(Self)) sName sRecordId sCustom to sState
32722>>>>>        
32722>>>>>        Function_Return sState
32723>>>>>    End_Function
32724>>>>>    
32724>>>>>    
32724>>>>>    // Generates the current state hash for this view.
32724>>>>>    //
32724>>>>>    // Returns:
32724>>>>>    //      State hash for this view (for drill-down this includes invoking view hashes).
32724>>>>>    Function GenerateStateHash Returns String
32726>>>>>        Integer eViewStyle
32726>>>>>        String sResult
32726>>>>>        
32726>>>>>        Get peWebViewStyle to eViewStyle
32727>>>>>        If (eViewStyle = wvsDesktop) Begin
32729>>>>>            Get GenerateStateHash_Desktop to sResult    
32730>>>>>        End
32730>>>>>>
32730>>>>>        Else If (eViewStyle = wvsDrillDown or eViewStyle = wvsDialog) Begin
32733>>>>>            Get GenerateStateHash_DrillDown to sResult
32734>>>>>        End
32734>>>>>>
32734>>>>>        
32734>>>>>        Function_Return sResult
32735>>>>>    End_Function
32736>>>>>    
32736>>>>>    // Updates the page title with the current view title (if pbUpdateApplicationTitle of cWebApp 
32736>>>>>    // is true).
32736>>>>>    Procedure UpdatePageTitle
32738>>>>>        String sViewTitle
32738>>>>>        Boolean bUpdate
32738>>>>>        
32738>>>>>        WebGet pbUpdateApplicationTitle of (Host(Self)) to bUpdate
32739>>>>>        
32739>>>>>        If (bUpdate) Begin
32741>>>>>            If (peWebViewStyle(Self) = wvsDrillDown) Begin
32743>>>>>                Get GetHeaderCaption to sViewTitle
32744>>>>>            End
32744>>>>>>
32744>>>>>            Else Begin
32745>>>>>                WebGet psCaption to sViewTitle
32746>>>>>            End
32746>>>>>>
32746>>>>>            
32746>>>>>            Send UpdatePageTitle of (Host(Self)) Self sViewTitle
32747>>>>>        End    
32747>>>>>>
32747>>>>>    End_Procedure
32748>>>>>    
32748>>>>>    
32748>>>>>    // Default refresh logic that updates the state hash when the record changes.
32748>>>>>    // 
32748>>>>>    // Params:
32748>>>>>    //      eMode   The refresh mode.
32748>>>>>    Procedure Refresh Integer eMode
32750>>>>>        String sName sHash sView 
32750>>>>>        Integer eViewType eViewStyle eStateMode iIndex
32750>>>>>        tWebNavigateData navData
32750>>>>>        tWebNavigateData navData
32750>>>>>        
32750>>>>>        Forward Send Refresh eMode
32752>>>>>                
32752>>>>>        // if application style is wvsNone it is a basic non-framework application that does handle web-views at
32752>>>>>        // all - refresh should do nothing. This allows web lookups to get added to a basic webapp. While
32752>>>>>        // compiled, we don't want to use them.        
32752>>>>>        If (peApplicationStyle(Host(Self)) = wvsNone or peApplicationStateMode(Host(Self)) = asmOff) ;            Procedure_Return
32755>>>>>        
32755>>>>>        If (not(AppSynching(Owner(Self)))) Begin
32757>>>>>            If (phoLoadView(Host(Self)) <> Self and phoCurrentShowView(Host(Self)) <> Self and not(pbNavigating(Self)) and not(pbInitForShow(Self))) Begin
32759>>>>>                Get peViewType to eViewType
32760>>>>>                Get peWebViewStyle to eViewStyle
32761>>>>>                Get peStateMode to eStateMode
32762>>>>>                
32762>>>>>                If (eViewStyle = wvsDrillDown) Begin
32764>>>>>                    If (eStateMode = vsmRecord or (eViewStyle = wvsDrillDown and eViewType = vtZoom and eStateMode = vsmDefault)) Begin
32766>>>>>                        //  Check if still initializing (we can't check if the name is in the URL because the statehash might not be up-to-date)
32766>>>>>                        Get GetNavigateData to navData
32767>>>>>                        Get NamedValueIndex navData.NamedValues "Init_Mode" to iIndex
32768>>>>>                        If (iIndex < 0) Begin
32770>>>>>                            Send UpdateStateHash True
32771>>>>>                        End
32771>>>>>>
32771>>>>>                    End
32771>>>>>>
32771>>>>>                End
32771>>>>>>
32771>>>>>                Else Begin
32772>>>>>                    If (eStateMode = vsmRecord or (eStateMode = vsmDefault and pbStateRestoreRecord(Host(Self)) and pbStateRestoreRecord(Self))) Begin
32774>>>>>                        Get psStateViewName to sName
32775>>>>>                        Get StateHash of (Host(Self)) to sHash
32776>>>>>                        Send ParseViewStateHash sHash (&sView)        
32777>>>>>                        
32777>>>>>                        If (lowercase(sName) = Lowercase(sView)) Begin
32779>>>>>                            Send UpdateStateHash True
32780>>>>>                        End
32780>>>>>>
