28736>>>>>>>>>>>>>            If (pbAutoCreate(hoSelectionSource)) Begin
28738>>>>>>>>>>>>>                Get CreateItem of hoSelectionSource (&oNewItem) oNewItem.aValues[0] to bSuccess
28739>>>>>>>>>>>>>                If (not(bSuccess)) ;                    Procedure_Return
