30988>>>>>>>
30988>>>>>>>    // Attempt to find the field from the server's MainFile that relates to iRelatedFile
30988>>>>>>>    Function RelatingField Integer iRelatedFile Returns Integer
30990>>>>>>>        Integer iField iRelFile iNumFields iIndex iMainfile
30990>>>>>>>        Handle hoServer
30990>>>>>>>        Boolean bDDRelates
30990>>>>>>>        Get Server to hoServer
30991>>>>>>>        Get Main_File of hoServer to iMainfile
30992>>>>>>>        Get pbUseDDRelates of hoServer to bDDRelates
30993>>>>>>>        Get_Attribute DF_FILE_NUMBER_FIELDS of iMainFile to iNumFields
30996>>>>>>>        For iField from 1 to iNumFields
31002>>>>>>>>
31002>>>>>>>            
31002>>>>>>>            // find first field that relates to the related file and has an index.
31002>>>>>>>            If (bDDRelates) Begin
31004>>>>>>>                Get Field_Related_File of hoServer iField to iRelFile
31005>>>>>>>            End
31005>>>>>>>>
31005>>>>>>>            Else Begin
31006>>>>>>>                Get_Attribute DF_FIELD_RELATED_FILE of iMainFile  iField to iRelFile
31009>>>>>>>            End
31009>>>>>>>>
31009>>>>>>>            
31009>>>>>>>            If (iRelFile=iRelatedFile) Begin
31011>>>>>>>                
31011>>>>>>>                If (bDDRelates) Begin
31013>>>>>>>                    Get Field_Related_Field of hoServer iField to iIndex
31014>>>>>>>                End
31014>>>>>>>>
31014>>>>>>>                Else Begin
31015>>>>>>>                    Get_Attribute DF_FIELD_INDEX of iMainFile iField to iIndex
31018>>>>>>>                End
31018>>>>>>>>
31018>>>>>>>                
31018>>>>>>>                If (iIndex>0) Begin
31020>>>>>>>                    Function_Return iField
31021>>>>>>>                End
31021>>>>>>>>
31021>>>>>>>            End
31021>>>>>>>>
31021>>>>>>>        Loop
31022>>>>>>>>
31022>>>>>>>        Function_Return -1
31023>>>>>>>    End_Function
