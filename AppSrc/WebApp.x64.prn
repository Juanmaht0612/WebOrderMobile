30524>>>>>>>
30524>>>>>>>    // RegisterColumn:
30524>>>>>>>    
30524>>>>>>>    // Registers a column object in the columns collection.
30524>>>>>>>    Procedure RegisterColumn Handle hoColumn
30526>>>>>>>        Integer iSize
30526>>>>>>>        Handle[] hoColumnObjects
30527>>>>>>>        Get phoColumnObjects to hoColumnObjects
30528>>>>>>>        Move (SizeOfArray(hoColumnObjects)) to iSize
30529>>>>>>>        Move hoColumn to hoColumnObjects[iSize]
30530>>>>>>>        Set piColumnId of hoColumn to iSize
30531>>>>>>>        Set phoColumnObjects to hoColumnObjects
30532>>>>>>>    End_Procedure
30533>>>>>>>    
30533>>>>>>>    
30533>>>>>>>    // Sent by DDO when there is a clear/find/save/delete.
30533>>>>>>>    //
30533>>>>>>>    // eMode - Determines the type of DDO operation which generated this refresh message. 
30533>>>>>>>    //         It may be one of the following:
30533>>>>>>>    //         Mode_Clear:             Used only for DEOs attached to the DDO that was the
30533>>>>>>>    //                                 "origin" of a Clear operation, (i.e., the DDO received
30533>>>>>>>    //                                 the original Clear message). All other DDOs Send their 
30533>>>>>>>    //                                 DEOs the refresh message passing mode_find_or_clear_set.  
30533>>>>>>>    //         Mode_Find_or_Clear_Set: Used for DEOs attached to DDOs which have Found and/or cleared records.  
30533>>>>>>>    //         Mode_Clear_All:         Used for DEOs attached to any DDO that participated in a clear_all operation.  
30533>>>>>>>    //         Mode_Delete:            Used for DEOs attached to any DDO that performed a successful deletion. 
30533>>>>>>>    //                                 DDOs that were merely updated as the result of a deletion Use Mode_Find_or_Clear_Set.  
30533>>>>>>>    //         Mode_Save:              Used for DEOs attached to any DDO involved in a successful Save operation. 
30533>>>>>>>    Procedure Refresh Integer eMode
30535>>>>>>>        Integer iMainFile
30535>>>>>>>        Integer eDDStatus
30535>>>>>>>        Handle hoDDO
30535>>>>>>>        Boolean bActive bAppSynching bMainFound
30535>>>>>>>        Boolean bRowDisplay bInClearGrid bDataAware 
30535>>>>>>>        Integer eDBGridType
30535>>>>>>>        String sCurrentRowID
30535>>>>>>>        RowID riCurrentRowID riID
30535>>>>>>>        Integer iCurrentRowIndex
30535>>>>>>>        
30535>>>>>>>        Get Active_State to bActive
30536>>>>>>>        Get AppSynching to bAppSynching
30537>>>>>>>        Get pbDataAware to bDataAware
30538>>>>>>>        Get peDbGridType to eDBGridType
30539>>>>>>>
30539>>>>>>>        If (bDataAware and bActive and not(bAppSynching)) Begin
30541>>>>>>>            Get ReadingServer to hoDDO                  // hoDDO cannot be 0 otherwise we would never receive Refresh!
30542>>>>>>>            Get Main_File of hoDDO to iMainFile
30543>>>>>>>        
30543>>>>>>>            Get DDRefreshTableStatus iMainFile to eDDStatus
30544>>>>>>>            Move (eDDStatus <> ddrtsNone) to bMainFound     // True = a main dd find or constrained child dd find has occurred
30545>>>>>>>            Get pbNotifyingExternalDD to bRowDisplay                 // True = we are simply responding to a change of the current row ID on the client
30546>>>>>>>            
30546>>>>>>>            // Get the current row's row id
30546>>>>>>>            WebGet psCurrentRowId to sCurrentRowID
30547>>>>>>>            Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
30548>>>>>>>            WebGet piCurrentRowIndex to iCurrentRowIndex
30549>>>>>>>        
30549>>>>>>>            // Handle the case where there is no selected row and we've done a save or delete on the main file.
30549>>>>>>>            // We don't know what to do in this case so we will refresh the grid. This could happen if the save
30549>>>>>>>            // is occuring from an external source (e.g., create a new record directly in the DD)
30549>>>>>>>            If (iCurrentRowIndex=-1 and (eMode = MODE_SAVE or eMode = MODE_DELETE) and bMainFound and (not(bRowDisplay))) Begin
30551>>>>>>>                Move MODE_FIND_OR_CLEAR_SET to eMode
30552>>>>>>>            End
30552>>>>>>>>
30552>>>>>>>
30552>>>>>>>            // If this is a clear on the grid's main file and it is not grid insert/append row, all we can do is clear and refresh the grid
30552>>>>>>>            Get pbInClearGrid to bInClearGrid
30553>>>>>>>            If (bInClearGrid) Begin
30555>>>>>>>                Move MODE_FIND_OR_CLEAR_SET to eMode
30556>>>>>>>            End
30556>>>>>>>>
30556>>>>>>>
30556>>>>>>>            If (eMode = MODE_CLEAR and bMainFound and sCurrentRowID <> "") Begin
30558>>>>>>>                //  HW: Added check for empty current row id which prevents recursive clearing with two grids on a single DD.
30558>>>>>>>                // special case with clear. If this comes from some other DEO (which is unusual)
30558>>>>>>>                // and the curent row has a record, then we need to insert a row for the
30558>>>>>>>                // cleared row.
30558>>>>>>>                If (not(bRowDisplay)) Begin
30560>>>>>>>                    Send AppendNewRow
30561>>>>>>>                End
30561>>>>>>>>
30561>>>>>>>                
30561>>>>>>>                Send UpdateCurrentRowID
30562>>>>>>>            End
30562>>>>>>>>
30562>>>>>>>            
30562>>>>>>>            Else If (eMode = MODE_DELETE or eMode = MODE_SAVE or bRowDisplay or not(bMainFound)) Begin
30565>>>>>>>                // Perform necessary actions for Save or Delete of a Grid Row
30565>>>>>>>                If (hoDDO = OPERATION_ORIGIN) Begin    // OPERATION_ORIGIN is the DDO that is the origin of the Save, Delete, find or clear
30567>>>>>>>                    // if a save notification and the save's DD is the same as the grid's
30567>>>>>>>                    // we are saving the main record and it may now be out of order
30567>>>>>>>                    If (eMode = MODE_SAVE) Begin
30569>>>>>>>                        WebSet pbUnOrdered to True
30570>>>>>>>                    End
30570>>>>>>>>
30570>>>>>>>                End
30570>>>>>>>>
30570>>>>>>>
30570>>>>>>>                Send UpdateCurrentRowID
30571>>>>>>>            End
30571>>>>>>>>
30571>>>>>>>            
30571>>>>>>>            Else If (eMode = MODE_CLEAR_ALL) Begin
30574>>>>>>>                Send UpdateCurrentRowID
30575>>>>>>>                If (eDBGridType<>gtManual) Begin
30577>>>>>>>                    Send ClearFilter
30578>>>>>>>                    Send EmptyGridRefresh
30579>>>>>>>                End
30579>>>>>>>>
30579>>>>>>>            End
30579>>>>>>>>
30579>>>>>>>            Else If (eMode = MODE_FIND_OR_CLEAR_SET) Begin
30582>>>>>>>                // If we got here then refresh the entire grid
30582>>>>>>>                Move (GetRowID(iMainFile)) to riID
30583>>>>>>>                Send UpdateCurrentRowID
30584>>>>>>>                If (eDBGridType<>gtManual) Begin
30586>>>>>>>                    Send GridRefresh
30587>>>>>>>                End
30587>>>>>>>>
30587>>>>>>>                Send ReadByRowId of hoDDO iMainFile riID
30588>>>>>>>            End
30588>>>>>>>>
30588>>>>>>>        End
30588>>>>>>>>
30588>>>>>>>    End_Procedure
30589>>>>>>>    
30589>>>>>>>    /*    Refresh event during intialization of FlexTron controls. Latches onto the current record buffer     which may not have been recently found.    */
30589>>>>>>>    Procedure InitialRefresh
30591>>>>>>>        Boolean bActive bAppSynching bDataAware
30591>>>>>>>        Integer eDBGridType iMainFile
30591>>>>>>>        Handle  hoDDO
30591>>>>>>>        RowID riID
30591>>>>>>>        
30591>>>>>>>        Get Active_State to bActive
30592>>>>>>>        Get AppSynching to bAppSynching
30593>>>>>>>        Get pbDataAware to bDataAware
30594>>>>>>>        Get peDbGridType to eDBGridType
30595>>>>>>>
30595>>>>>>>        If (bDataAware and bActive and not(bAppSynching)) Begin
30597>>>>>>>            Get ReadingServer to hoDDO                  // hoDDO cannot be 0 otherwise we would never receive Refresh!
30598>>>>>>>            Get Main_File of hoDDO to iMainFile
30599>>>>>>>            
30599>>>>>>>            // If we got here then refresh the entire grid
30599>>>>>>>            Move (GetRowID(iMainFile)) to riID
30600>>>>>>>            Send UpdateCurrentRowID
30601>>>>>>>            If (eDBGridType<>gtManual) Begin
30603>>>>>>>                Send GridRefresh
30604>>>>>>>            End
30604>>>>>>>>
30604>>>>>>>            Send ReadByRowId of hoDDO iMainFile riID
30605>>>>>>>        End
30605>>>>>>>>
30605>>>>>>>    End_Procedure
30606>>>>>>>    
30606>>>>>>>    
30606>>>>>>>    // Does nothing in cWebList. See ClearSelectedRow in cWebGrid class.
30606>>>>>>>    // returns True.
30606>>>>>>>    Function ClearSelectedRow Returns Boolean
30608>>>>>>>        Function_Return True
30609>>>>>>>    End_Function  
30610>>>>>>>    
30610>>>>>>>    // Does nothing in cWebList. cWebList is read only. See SaveSelectedRow in cWebGrid class.
30610>>>>>>>    Function SaveSelectedRow Returns Integer
30612>>>>>>>        Function_Return sroSucceed
30613>>>>>>>    End_Function
30614>>>>>>>    
30614>>>>>>>    // Delete Logic to delete the current row pointed to by psCurrentRowId.
30614>>>>>>>    // returns True if the delete was successful.
30614>>>>>>>    Function DeleteSelectedRow Returns Integer
30616>>>>>>>        Handle hoDD
30616>>>>>>>        Handle hmVerify
30616>>>>>>>        RowID riCurrentRowID riTestRowID
30616>>>>>>>        String sCurrentRowID
30616>>>>>>>        Integer iOrdering iMainFile
30616>>>>>>>        Boolean bReverseOrdering
30616>>>>>>>        Boolean bDataAware
30616>>>>>>>        Integer iReturn
30616>>>>>>>
30616>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
30617>>>>>>>        Get pbDataAware to bDataAware
30618>>>>>>>        
30618>>>>>>>        // db-aware handling
30618>>>>>>>        If (bDataAware) Begin
30620>>>>>>>            Get Server to hoDD
30621>>>>>>>            If (hoDD <> 0) Begin
30623>>>>>>>                Move (DeserializeRowID(sCurrentRowID)) to riCurrentRowID
30624>>>>>>>                Get CurrentRowId of hoDD to riTestRowID
30625>>>>>>>                
30625>>>>>>>                If (not(IsSameRowID(riCurrentRowID, riTestRowID))) Begin
30627>>>>>>>                    Error DFERR_PROGRAM "Assert: Server DDO's current record does not match psCurrentRowId"
30628>>>>>>>>
30628>>>>>>>                    Function_Return sroFail
30629>>>>>>>                End
30629>>>>>>>>
30629>>>>>>>                
30629>>>>>>>                // Verify that we are allowed to delete
30629>>>>>>>                If (Read_Only_State(hoDD) or not(pbAllowDeleteRow(Self)) or not(Can_Delete(hoDD))) Begin
30631>>>>>>>                    Function_Return sroFail         // the view should not allow this to happen
30632>>>>>>>                End
30632>>>>>>>>
30632>>>>>>>            End
30632>>>>>>>>
30632>>>>>>>        End
30632>>>>>>>>
30632>>>>>>>        
30632>>>>>>>        Get Verify_Delete_msg to hmVerify
30633>>>>>>>        If (hmVerify) Begin
30635>>>>>>>            WebSet pbDeleteCallbackActive to True
30636>>>>>>>            Send VerifyRequest (RefProc(RequestDeleteCallBack)) (RefFunc(Verify_Delete_Msg))
30637>>>>>>>            Function_Return sroPending
30638>>>>>>>        End
30638>>>>>>>>
30638>>>>>>>        Else Begin
30639>>>>>>>            Send RequestDeleteExec
30640>>>>>>>            // we actually don't know if this will work or not, since this finds another row. For now, we say success
30640>>>>>>>        End
30640>>>>>>>>
30640>>>>>>>        Function_Return sroSucceed
30641>>>>>>>    End_Function
30642>>>>>>>    
30642>>>>>>>    // This event is triggered by Request_Delete. It is intended to be implemented on grids having 
30642>>>>>>>    // pbDataAware set to false to process the delete. If the delete cannot be performed return 
30642>>>>>>>    // false to cancel the grid from removing the row from the display. Returning false when 
30642>>>>>>>    // pbDataAware is set to true will also cancel the delete from being sent to the DDO.
30642>>>>>>>    Function OnDeleteRow String sCurrentRowID Returns Boolean
30644>>>>>>>        Function_Return True
30645>>>>>>>    End_Function        
30646>>>>>>>
30646>>>>>>>    
30646>>>>>>>    Procedure RequestDeleteExec
30648>>>>>>>        Handle hoDD
30648>>>>>>>        String sCurrentRowID
30648>>>>>>>        Integer iOrdering iMainFile
30648>>>>>>>        Boolean bReverseOrdering
30648>>>>>>>        Boolean bDataAware bContinue
30648>>>>>>>
30648>>>>>>>        WebGet psCurrentRowId to sCurrentRowID
30649>>>>>>>        Get OnDeleteRow sCurrentRowID to bContinue
30650>>>>>>>        
30650>>>>>>>        // db-aware
30650>>>>>>>        Get pbDataAware to bDataAware
30651>>>>>>>        
30651>>>>>>>        If (bDataAware) Begin
30653>>>>>>>            If (bContinue) Begin
30655>>>>>>>                // Perform the db-aware delete
30655>>>>>>>                Get Server to hoDD
30656>>>>>>>                Send Request_Delete to hoDD       // Perform the delete
30657>>>>>>>                            
30657>>>>>>>                If (Err) Begin
30659>>>>>>>                    Procedure_Return
30660>>>>>>>                End
30660>>>>>>>>
30660>>>>>>>                
30660>>>>>>>                Send RemoveRow sCurrentRowID      // Tell the client to remove the deleted row.
30661>>>>>>>                
30661>>>>>>>                // Select the next logical row
30661>>>>>>>                Get IndexOrder to iOrdering
30662>>>>>>>                WebGet pbReverseOrdering to bReverseOrdering
30663>>>>>>>                Get Main_File of hoDD to iMainFile
30664>>>>>>>        
30664>>>>>>>                If (bReverseOrdering) Begin
30666>>>>>>>                    Send Establish_Find_Direction of hoDD LT iMainFile iOrdering 
30667>>>>>>>                End
30667>>>>>>>>
30667>>>>>>>                Else Begin
30668>>>>>>>                    Send Establish_Find_Direction of hoDD GT iMainFile iOrdering 
30669>>>>>>>                End
30669>>>>>>>>
30669>>>>>>>                
30669>>>>>>>                Send Locate_Next of hoDD    // Try to find the row below the deleted row.
30670>>>>>>>                
30670>>>>>>>                If (not(Found)) Begin
30672>>>>>>>                    // If the row below the deleted row was not found then it means we deleted the
30672>>>>>>>                    // last row. Now we will try to load the new last row. If there are no remaining
30672>>>>>>>                    // rows in the dataset then the buffer will be automatically cleared (which is 
30672>>>>>>>                    // what we want)
30672>>>>>>>                    If (bReverseOrdering) Begin
30674>>>>>>>                        Send Request_Read of hoDD FIRST_RECORD iMainFile iOrdering
30675>>>>>>>                    End
30675>>>>>>>>
30675>>>>>>>                    Else Begin
30676>>>>>>>                        Send Request_Read of hoDD LAST_RECORD iMainFile iOrdering
30677>>>>>>>                    End
30677>>>>>>>>
30677>>>>>>>                End
30677>>>>>>>>
30677>>>>>>>                
30677>>>>>>>                If (Found) Begin
30679>>>>>>>                    Send Request_Assign of hoDD iMainFile
30680>>>>>>>                End
30680>>>>>>>>
30680>>>>>>>                Else Begin
30681>>>>>>>                    Send ClearGrid
30682>>>>>>>                End
30682>>>>>>>>
30682>>>>>>>                
30682>>>>>>>                Send UpdateCurrentRowID
30683>>>>>>>            End
30683>>>>>>>>
30683>>>>>>>        End 
30683>>>>>>>>
30683>>>>>>>        Else Begin
30684>>>>>>>            //  Non DB-Aware handling
30684>>>>>>>             If (bContinue) Begin
30686>>>>>>>                Send RemoveRow sCurrentRowID      // Tell the client to remove the deleted row.
30687>>>>>>>            End
30687>>>>>>>>
30687>>>>>>>        End
30687>>>>>>>>
30687>>>>>>>    End_Procedure
30688>>>>>>>    
30688>>>>>>>    // Client action to remove the passed row from the cache. 
30688>>>>>>>    Procedure RemoveRow String sRowID
30690>>>>>>>        String[] aParams
30691>>>>>>>        
30691>>>>>>>        Move sRowID to aParams[0]
30692>>>>>>>        Send ClientAction "removeRow" aParams    
30693>>>>>>>    End_Procedure
30694>>>>>>>
30694>>>>>>>    // Returns true if you can move off of the selected row.
30694>>>>>>>    // Does nothing in cWebList. cWebList is read only. See AllowChangeSelectedRow in cWebGrid class.
30694>>>>>>>    Function AllowChangeSelectedRow String sGotoRow String sToRowID Returns Boolean
30696>>>>>>>        Function_Return True
30697>>>>>>>    End_Function
30698>>>>>>>
30698>>>>>>>    // these don't do anything with lists
30698>>>>>>>    Procedure AppendNewRow    
30700>>>>>>>    End_Procedure
30701>>>>>>>
30701>>>>>>>    // these don't do anything with lists
30701>>>>>>>    Procedure InsertNewRow    
30703>>>>>>>    End_Procedure
30704>>>>>>>    
30704>>>>>>>    Function IndexOrder Returns Integer
30706>>>>>>>        // returns the sort order for subsequent DDO Request_Read calls.
30706>>>>>>>        Integer iOrdering iColumnOrdering eDbGridType iConstrainFile
30706>>>>>>>        String iSortColumn
30706>>>>>>>        Handle hoColumn hoDD
30706>>>>>>>        
30706>>>>>>>        
30706>>>>>>>        
30706>>>>>>>        // if DD has an ordering we must use this
30706>>>>>>>        Get Server to hoDD
30707>>>>>>>        If (hoDD > 0) Begin
30709>>>>>>>            Get Ordering of hoDD to iOrdering    // get the sort index from the DDO (if this has been set)
30710>>>>>>>            If (iOrdering<>-1) Begin
30712>>>>>>>                Function_Return iOrdering
30713>>>>>>>            End
30713>>>>>>>>
30713>>>>>>>        End
30713>>>>>>>>
30713>>>>>>>            
30713>>>>>>>        Get piOrdering to iOrdering
30714>>>>>>>        If (hoDD > 0) Begin
30716>>>>>>>            // this is the ordering as defined by the grid
30716>>>>>>>            Get Constrain_File of hoDD to iConstrainFile
30717>>>>>>>            // if ordering is not specified and we have a constraining parent
30717>>>>>>>            // we want to limit the constraint to the best choice for a constrained find
30717>>>>>>>            If (iOrdering=-1 and iConstrainFile) Begin
30719>>>>>>>                Get ConstrainedIndexOrder iConstrainFile to iOrdering
30720>>>>>>>            End
30720>>>>>>>>
30720>>>>>>>        End
30720>>>>>>>>
30720>>>>>>>        // if a static grid, use the grid's ordering, if dynamic we use
30720>>>>>>>        // the column ordering if we are sorting by a grid column, else use grid ordering
30720>>>>>>>        Get peDbGridType to eDbGridType
30721>>>>>>>        If (eDbGridType=gtAutomatic) Begin
30723>>>>>>>            // If we are sorting by a grid column then use that
30723>>>>>>>            WebGet piSortColumn to iSortColumn
30724>>>>>>>            
30724>>>>>>>            If (iSortColumn <> -1) Begin
30726>>>>>>>                Get GetColumnObject iSortColumn to hoColumn
30727>>>>>>>                If (hoColumn) Begin
30729>>>>>>>                    Get ColumnIndexOrder of hoColumn to iColumnOrdering      // returns -1 if there is no default index
30730>>>>>>>                    If (iColumnOrdering<>-1) Begin
30732>>>>>>>                        Move iColumnOrdering to iOrdering
30733>>>>>>>                    End
30733>>>>>>>>
30733>>>>>>>                End
30733>>>>>>>>
30733>>>>>>>            End
30733>>>>>>>>
30733>>>>>>>        End
30733>>>>>>>>
30733>>>>>>>        Function_Return iOrdering
30734>>>>>>>    End_Function
30735>>>>>>>    
30735>>>>>>>    
30735>>>>>>>    // return best index for constrained find. Return -1 which asks the runtime
30735>>>>>>>    // to make this choice as normally there is only one choice. 
30735>>>>>>>    // This is suitable for augmentation.
30735>>>>>>>    Function ConstrainedIndexOrder Integer iConstrainFile Returns Integer
30737>>>>>>>        Function_Return -1 // the runtime knows best
30738>>>>>>>    End_Function
30739>>>>>>>    
30739>>>>>>>    
30739>>>>>>>    Procedure UpdateCurrentRowID
30741>>>>>>>        // Sets the web property psCurrentRowId for pbDataAware=True grid.
30741>>>>>>>        Handle hoDD
30741>>>>>>>        RowID riRowID
30741>>>>>>>        
30741>>>>>>>        // assert pbDataAware=True
30741>>>>>>>        If (not(pbDataAware(Self))) Begin
30743>>>>>>>            Error DFERR_PROGRAM "Assert: UpdateCurrentRowID called for non-data aware grid"
30744>>>>>>>>
30744>>>>>>>        End
30744>>>>>>>>
30744>>>>>>>        
30744>>>>>>>        Get Server to hoDD
30745>>>>>>>        
30745>>>>>>>        If (hoDD = 0) Begin
30747>>>>>>>            // This will probably never happen
30747>>>>>>>            Move (NullRowID()) to riRowID
30748>>>>>>>        End
30748>>>>>>>>
30748>>>>>>>        Else Begin
30749>>>>>>>            Get CurrentRowId of hoDD to riRowID
30750>>>>>>>        End
30750>>>>>>>>
30750>>>>>>>        
30750>>>>>>>        WebSet psCurrentRowId to (SerializeRowID(riRowID))
30751>>>>>>>    End_Procedure
30752>>>>>>>
30752>>>>>>>
30752>>>>>>>    // in sub-classes that support auto-server, which uses the
30752>>>>>>>    // invoking server, the server used for reading the grid may
30752>>>>>>>    // be different than the server defined in this view.
30752>>>>>>>    Function ReadingServer Returns Handle
30754>>>>>>>        Handle hoDD
30754>>>>>>>        Get Server to hoDD
30755>>>>>>>        Function_Return hoDD
30756>>>>>>>    End_Function
30757>>>>>>>
30757>>>>>>>    // This handles translation of find modes to make reverse ordering
30757>>>>>>>    // work. Pass the mode and return the mode, translated if reverse ordering is needed
30757>>>>>>>    Function FindMode Integer eFindMode Boolean bReverseOrdering Returns Integer
30759>>>>>>>        If (bReverseOrdering) Begin
30761>>>>>>>            Case Begin
30761>>>>>>>                Case (eFindMode=GE) ;                    Move (LE) to eFindMode
30764>>>>>>>                Case (eFindMode=GT) ;                    Move (LT) to eFindMode
30768>>>>>>>                Case (eFindMode=LT) ;                    Move (GT) to eFindMode
30772>>>>>>>                Case (eFindMode=LE) ;                    Move (GE) to eFindMode
30776>>>>>>>                Case (eFindMode=FIRST_RECORD) ;                    Move (LAST_RECORD) to eFindMode
30780>>>>>>>                Case (eFindMode=LAST_RECORD) ;                    Move (FIRST_RECORD) to eFindMode
30784>>>>>>>            Case End
30784>>>>>>>        End
30784>>>>>>>>
30784>>>>>>>        Function_Return eFindMode
30785>>>>>>>    End_Function
30786>>>>>>>
30786>>>>>>>    Procedure EstablishDDFindMode Integer eFindMode Handle hoServer Integer iOrdering Boolean bReverseOrdering
30788>>>>>>>        Integer iFile
30788>>>>>>>        Get FindMode eFindMode bReverseOrdering to eFindMode  // mode might change if reverse ordering
30789>>>>>>>        Get Main_File of hoServer to iFile
30790>>>>>>>        Send Establish_Find_Direction of hoServer eFindMode iFile iOrdering
30791>>>>>>>    End_Procedure
30792>>>>>>>
30792>>>>>>>    Function ReadDDFirstRecord Handle hoDD Integer iOrdering Boolean bReverseOrdering  Returns RowID
30794>>>>>>>        Integer iFile eFindMode
30794>>>>>>>        // because this uses request_read it cannot be used inside of refresh
30794>>>>>>>        If (OPERATION_MODE<>0) Begin
30796>>>>>>>            Error DFERR_PROGRAM ("assertion failed: ReadDDFirstRecord is called when DD is busy")
30797>>>>>>>>
30797>>>>>>>        End
30797>>>>>>>>
30797>>>>>>>        Get Main_File of hoDD to iFile
30798>>>>>>>        Get FindMode FIRST_RECORD bReverseOrdering to eFindMode
30799>>>>>>>        Send Request_Read of hoDD eFindMode iFile  iOrdering
30800>>>>>>>        Function_Return (GetRowID(iFile))
30801>>>>>>>    End_Function
30802>>>>>>>    
30802>>>>>>>    
30802>>>>>>>    Function ReadDDLastRecord Handle hoDD Integer iOrdering Boolean bReverseOrdering  Returns RowID
30804>>>>>>>        Integer iFile eFindMode
30804>>>>>>>        // because this uses request_read it cannot be used inside of refresh
30804>>>>>>>        If (OPERATION_MODE<>0) Begin
30806>>>>>>>            Error DFERR_PROGRAM ("assertion failed: ReadDDFirstRecord is called when DD is busy")
30807>>>>>>>>
30807>>>>>>>        End
30807>>>>>>>>
30807>>>>>>>        Get Main_File of hoDD to iFile
30808>>>>>>>        Get FindMode LAST_RECORD bReverseOrdering to eFindMode
30809>>>>>>>        Send Request_Read of hoDD eFindMode iFile iOrdering
30810>>>>>>>        Function_Return (GetRowID(iFile))
30811>>>>>>>    End_Function
30812>>>>>>>    
30812>>>>>>>    Function ReadDDRecordInBuffer Handle hoDD Integer iOrdering Boolean bReverseOrdering Returns Boolean
30814>>>>>>>        Boolean bFound
30814>>>>>>>        RowID riId
30814>>>>>>>        Integer iFile
30814>>>>>>>        
30814>>>>>>>        Send EstablishDDFindMode Ge  hoDD iOrdering bReverseOrdering
30815>>>>>>>        Send Locate_Next of hoDD
30816>>>>>>>        Move (Found) to bFound
30817>>>>>>>        If not bFound Begin
30819>>>>>>>            Get ReadDDLastRecord hoDD iOrdering bReverseOrdering to riId
30820>>>>>>>        End
30820>>>>>>>>
30820>>>>>>>        Else Begin
30821>>>>>>>            Get Main_File of hoDD to iFile
30822>>>>>>>            Move (GetRowID(iFile)) to riId
30823>>>>>>>        End
30823>>>>>>>>
30823>>>>>>>        Function_Return (not(IsNullRowID(riId)))
30824>>>>>>>    End_Function
30825>>>>>>>
30825>>>>>>>    // finds the record in the buffer and rebuilds the list. If the
30825>>>>>>>    // buffer record is not found, most likely due to a failed constraint), it
30825>>>>>>>    // search for the next record (where next is determined by reverse ordering).
30825>>>>>>>    // If there is no record, it will attemot to find the prior record. 
30825>>>>>>>    Procedure FindDDRecordInBuffer 
30827>>>>>>>        Boolean bReverseOrdering bFound
30827>>>>>>>        Integer iOrdering
30827>>>>>>>        Handle hoDD
30827>>>>>>>
30827>>>>>>>        Get ReadingServer to hoDD
30828>>>>>>>        Get IndexOrder to iOrdering
30829>>>>>>>        WebGet pbReverseOrdering to bReverseOrdering
30830>>>>>>>        
30830>>>>>>>        Get ReadDDRecordInBuffer hoDD iOrdering bReverseOrdering to bFound
30831>>>>>>>        
30831>>>>>>>        Get Server to hoDD
30832>>>>>>>        If bFound Begin
30834>>>>>>>            Send Request_Assign of hoDD
30835>>>>>>>        End
30835>>>>>>>>
30835>>>>>>>        Else Begin
30836>>>>>>>            Send ClearGrid
30837>>>>>>>        End
30837>>>>>>>>
30837>>>>>>>    End_Procedure
30838>>>>>>>    
30838>>>>>>>    
30838>>>>>>>    // Clears the DD and creates an empty grid.
30838>>>>>>>    // The Clear DD behavior can work different ways with grids. Most of the time, a clear to a DD should
30838>>>>>>>    // just open up a new row for editing. This is consistent with what clear does everyhwere else. However, there are
30838>>>>>>>    // times when you need to create an empty grid. This will mostly happen when there are no valid records to display so you
30838>>>>>>>    // need to create an empty grid. That's what this message is for.
30838>>>>>>>    // For now this is public, but it needs to be used carefully. If you are clearing grids when there are records that could be
30838>>>>>>>    // displayed, you are fighting a normal grid behavior.
30838>>>>>>>    Procedure ClearGrid
30840>>>>>>>        Boolean bInClearGrid bDataAware
30840>>>>>>>        Handle hoDD
30840>>>>>>>        
30840>>>>>>>        Get pbDataAware to bDataAware
30841>>>>>>>        
30841>>>>>>>        If (bDataAware) Begin
30843>>>>>>>            Get pbInClearGrid to bInClearGrid
30844>>>>>>>            Set pbInClearGrid to True
30845>>>>>>>            Get Server to hoDD
30846>>>>>>>            Send Clear of hoDD
30847>>>>>>>            Set pbInClearGrid to bInClearGrid
30848>>>>>>>        End
30848>>>>>>>>
30848>>>>>>>        Else Begin
30849>>>>>>>            Send EmptyGridRefresh
30850>>>>>>>        End
30850>>>>>>>>
30850>>>>>>>    End_Procedure
30851>>>>>>>    
30851>>>>>>>    
30851>>>>>>>    // Appends a row to the end of the list. It will update the user interface if needed. Should
30851>>>>>>>    // only be used on a manually loaded list (pbDataAware = false or peDbGridType = gtManual). 
30851>>>>>>>    // Implemented as a client-action meaning that it works asynchronously.
30851>>>>>>>    //
30851>>>>>>>    // Params:
30851>>>>>>>    //  tRow    Filled tWebRow struct with the new row data.
30851>>>>>>>    Procedure DataSetAppendRow tWebRow tRow
30853>>>>>>>        String[] aParams
30854>>>>>>>        tWebRow[] aRows
30854>>>>>>>        tWebRow[] aRows
30855>>>>>>>        Handle hoJson
30855>>>>>>>        
30855>>>>>>>        Move tRow to aRows[0]
30856>>>>>>>        
30856>>>>>>>        //  Convert data to JSON
30856>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
30857>>>>>>>        Send DataTypeToJson of hoJson aRows
30858>>>>>>>        
30858>>>>>>>        Send ClientActionEx "dataSetAppendRow" aParams hoJson
30859>>>>>>>        Send Destroy of hoJson
30860>>>>>>>    End_Procedure
30861>>>>>>>    
30861>>>>>>>    // Inserts a new row into the list before the row with the provided rowid. If the rowid is not
30861>>>>>>>    // found it will append the row to the end of list. Should only be used on a manually loaded
30861>>>>>>>    // list (pbDataAware = false or peDbGridType = gtManual). Implemented as a client-action 
30861>>>>>>>    // meaning that it works asynchronously.
30861>>>>>>>    //
30861>>>>>>>    // Params:
30861>>>>>>>    //  sRowIdBefore    RowID of the row before which the new row should be inserted.
30861>>>>>>>    //  tRow            Filled tWebRow struct with the new row data.
30861>>>>>>>    Procedure DataSetInsertRowBefore String sRowIdBefore tWebRow tRow
30863>>>>>>>        String[] aParams
30864>>>>>>>        tWebRow[] aRows
30864>>>>>>>        tWebRow[] aRows
30865>>>>>>>        Handle hoJson
30865>>>>>>>        
30865>>>>>>>        Move tRow to aRows[0]
30866>>>>>>>        
30866>>>>>>>        //  Convert data to JSON
30866>>>>>>>        Get Create (RefClass(cJsonObject)) to hoJson
30867>>>>>>>        Send DataTypeToJson of hoJson aRows
30868>>>>>>>
30868>>>>>>>        Move sRowIdBefore to aParams[0]
30869>>>>>>>        
30869>>>>>>>        Send ClientActionEx "dataSetInsertRowBefore" aParams hoJson
30870>>>>>>>        Send Destroy of hoJson
30871>>>>>>>    End_Procedure
30872>>>>>>>    
30872>>>>>>>    // Inserts a new row into the list after the row with the provided rowid. If the rowid is not
30872>>>>>>>    // found it will append the row to the end of list. Should only be used on a manually loaded
30872>>>>>>>    // list (pbDataAware = false or peDbGridType = gtManual). Implemented as a client-action 
30872>>>>>>>    // meaning that it works asynchronously.
30872>>>>>>>    //
30872>>>>>>>    // Params:
30872>>>>>>>    //  sRowIdBefore    RowID of the row before which the new row should be inserted.
30872>>>>>>>    //  tRow            Filled tWebRow struct with the new row data.
30872>>>>>>>    Procedure DataSetInsertRowAfter String sRowIdAfter tWebRow tRow
30874>>>>>>>        String[] aParams
