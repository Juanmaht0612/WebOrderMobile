33859>>>>>>>>>                
33859>>>>>>>>>                //  If a filename is passed we are handling a file
33859>>>>>>>>>                If (iOffset >= 0) Begin
33861>>>>>>>>>                    Get ExtractField (&parsedata) (StringToUCharArray('"')) True to sFilename
33862>>>>>>>>>                    
33862>>>>>>>>>                    //  There might be a content-type, if so it should be before a possible boundpos
33862>>>>>>>>>                    Move "" to sFileContentType
33863>>>>>>>>>                    Get FindToken (&parsedata) (StringToUCharArray('Content-Type:')) False True to iOffset
33864>>>>>>>>>                    
33864>>>>>>>>>                    If (iOffset >= 0) Begin
33866>>>>>>>>>                        Move (iOffset + SizeOfString('Content-Type:')) to parsedata.iChunkRead
33867>>>>>>>>>                        Get ExtractField (&parsedata) ucNewLine True to sFileContentType
33868>>>>>>>>>                        Move (Trim(sFileContentType)) to sFileContentType
33869>>>>>>>>>                    End
33869>>>>>>>>>>
33869>>>>>>>>>                    Send SkipNewLine (&parsedata)
33870>>>>>>>>>                    
33870>>>>>>>>>                    Move False to bAbort
33871>>>>>>>>>                    Send OnFileStart sFieldname sFilename sFileContentType (&bAbort)
33872>>>>>>>>>                    If (bAbort) Begin
33874>>>>>>>>>                        Function_Return False
33875>>>>>>>>>                    End
33875>>>>>>>>>>
33875>>>>>>>>>                    
33875>>>>>>>>>                    //  Loop over data sending chunks until boundary or end of request
33875>>>>>>>>>                    While (parsedata.iBoundPos < 0 and ShouldParseContinue(Self, &parsedata))
33879>>>>>>>>>                        If (parsedata.iChunkRead > 0) Begin
33881>>>>>>>>>                            Move (CopyArray(parsedata.ucCurrentChunk, parsedata.iChunkRead, SizeOfArray(parsedata.ucCurrentChunk))) to ucChunk
