34421>>>>>>>>>Class cCryptographerEx is a cObject
34422>>>>>>>>>    
34422>>>>>>>>>    Procedure Construct_Object
34424>>>>>>>>>        Forward Send Construct_Object
34426>>>>>>>>>        
34426>>>>>>>>>        Property String     psProvider  MS_ENHANCED_PROV
34427>>>>>>>>>        Property Integer    piProvider  PROV_RSA_FULL
34428>>>>>>>>>        Property Integer    piCipher    CALG_RC4
34429>>>>>>>>>        Property Integer    piHash      CALG_MD5
34430>>>>>>>>>        
34430>>>>>>>>>        // Private properties
34430>>>>>>>>>        Property Handle     Private_phProv
34431>>>>>>>>>        
34431>>>>>>>>>        // Block cipher properties
34431>>>>>>>>>        Property UChar[]    paKey
34432>>>>>>>>>        Property UChar[]    paIV
34433>>>>>>>>>        Property Integer    piKeyAlg        PLAINTEXTKEYBLOB
34434>>>>>>>>>        Property Integer    piKeyType       CALG_AES_256
34435>>>>>>>>>        Property Integer    piKeyPadding    PKCS5_PADDING
34436>>>>>>>>>        Property Integer    piKeyMode       CRYPT_MODE_CBC
34437>>>>>>>>>        Property Integer    piBlockSize     16
34438>>>>>>>>>    End_Procedure
34439>>>>>>>>>    
34439>>>>>>>>>    
34439>>>>>>>>>    // Acquire key container handle
34439>>>>>>>>>    Function AcquireContext Returns Handle
34441>>>>>>>>>        Integer iProvider
34441>>>>>>>>>        WString wProvider
34441>>>>>>>>>        Handle hProv
34441>>>>>>>>>        Boolean bOk
34441>>>>>>>>>        Pointer pProv
34441>>>>>>>>>        
34441>>>>>>>>>        Move 0 to hProv
34442>>>>>>>>>        Get piProvider to iProvider
34443>>>>>>>>>        Get psProvider to wProvider
34444>>>>>>>>>        
34444>>>>>>>>>        //  Determine address to be passed as provider
34444>>>>>>>>>        If (Trim(wProvider) <> "") Begin
34446>>>>>>>>>            Move (AddressOf(wProvider)) to pProv
34447>>>>>>>>>        End
34447>>>>>>>>>>
34447>>>>>>>>>        Else Begin
34448>>>>>>>>>            Move 0 to pProv
34449>>>>>>>>>        End
34449>>>>>>>>>>
34449>>>>>>>>>        
34449>>>>>>>>>        //  Acquire Crypto Context. Note: pProv is pointer to UTF16 string.
34449>>>>>>>>>        Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_VERIFYCONTEXT)) to bOk
34450>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
34452>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET ior CRYPT_VERIFYCONTEXT)) to bOk
34453>>>>>>>>>        End
34453>>>>>>>>>>
34453>>>>>>>>>        
34453>>>>>>>>>        If (not(bOk) or hProv = 0) Begin
34455>>>>>>>>>            // Fallback to original
34455>>>>>>>>>            Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,0)) to bOk
34456>>>>>>>>>            
34456>>>>>>>>>            If (not(bOk) or hProv = 0) Begin
34458>>>>>>>>>                Move (CryptAcquireContextW(AddressOf(hProv),0,pProv,iProvider,CRYPT_NEWKEYSET)) to bOk
34459>>>>>>>>>            End
34459>>>>>>>>>>
34459>>>>>>>>>        End
34459>>>>>>>>>>
34459>>>>>>>>>        Set Private_phProv to hProv
34460>>>>>>>>>        
34460>>>>>>>>>        Function_Return hProv
34461>>>>>>>>>    End_Function
34462>>>>>>>>>    
34462>>>>>>>>>    // Releases key container handle
34462>>>>>>>>>    Function ReleaseContext Handle hProv Returns Boolean
34464>>>>>>>>>        Function_Return (CryptReleaseContext(hProv,0))
34465>>>>>>>>>    End_Function
34466>>>>>>>>>    
34466>>>>>>>>>    // Creates hash object
34466>>>>>>>>>    Function CreateHash Handle hProv Returns Handle
34468>>>>>>>>>        Integer iAlgorithm
34468>>>>>>>>>        Handle hHash
34468>>>>>>>>>        Boolean bOk
34468>>>>>>>>>        
34468>>>>>>>>>        Move 0 to hHash
34469>>>>>>>>>        Get piHash to iAlgorithm
34470>>>>>>>>>        Move (CryptCreateHash(hProv,iAlgorithm,0,0,AddressOf(hHash))) to bOk
34471>>>>>>>>>        
34471>>>>>>>>>        Function_Return hHash
34472>>>>>>>>>    End_Function
34473>>>>>>>>>    
34473>>>>>>>>>    // Destroys the hash object
34473>>>>>>>>>    Function DestroyHash Handle hHash Returns Boolean
34475>>>>>>>>>        Function_Return (CryptDestroyHash(hHash))
34476>>>>>>>>>    End_Function
34477>>>>>>>>>    
34477>>>>>>>>>    // Adds data to hash object
34477>>>>>>>>>    Function HashData Handle hHash UChar[] ucData Returns Boolean
34479>>>>>>>>>        Function_Return (CryptHashData(hHash,AddressOf(ucData), SizeOfArray(ucData),0))
34480>>>>>>>>>    End_Function
34481>>>>>>>>>    
34481>>>>>>>>>    // Generates session key
34481>>>>>>>>>    Function DeriveKey Handle hProv Handle hHash Returns Handle
34483>>>>>>>>>        Integer iAlgorithm
34483>>>>>>>>>        Handle hKey
34483>>>>>>>>>        Boolean bOk
34483>>>>>>>>>        
34483>>>>>>>>>        Move 0 to hKey
34484>>>>>>>>>        Get piCipher to iAlgorithm
34485>>>>>>>>>        Move (CryptDeriveKey(hProv,iAlgorithm,hHash,CRYPT_EXPORTABLE,AddressOf(hKey))) to bOk
34486>>>>>>>>>        
34486>>>>>>>>>        Function_Return hKey
34487>>>>>>>>>    End_Function
34488>>>>>>>>>    
34488>>>>>>>>>    // Imports a plain text key
34488>>>>>>>>>    Function ImportPlainTextKey Handle hProv UChar[] ucaKey Returns Handle
34490>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
34490>>>>>>>>>        tPLAINTEXTKEYBLOB blobhead
34490>>>>>>>>>        Boolean   bSuccess
34490>>>>>>>>>        Handle    hKey
34490>>>>>>>>>        Integer   iHeadSize iKeySize
34490>>>>>>>>>        UChar[]   ucaKeyblob
34491>>>>>>>>>        Integer iVoid
34491>>>>>>>>>        
34491>>>>>>>>>        Move (SizeOfType(tPLAINTEXTKEYBLOB)) to iHeadSize
34492>>>>>>>>>        Move (SizeOfArray(ucaKey)) to iKeySize
34493>>>>>>>>>        
34493>>>>>>>>>        Move PLAINTEXTKEYBLOB to blobhead.hdr.bType
34494>>>>>>>>>        Move CUR_BLOB_VERSION   to blobhead.hdr.bVersion
34495>>>>>>>>>        Get piCipher            to blobhead.hdr.aiKeyAlg
34496>>>>>>>>>        Move iKeySize           to blobhead.dwKeySize
34497>>>>>>>>>        
34497>>>>>>>>>        Move (ResizeArray(ucaKeyblob, iHeadSize)) to ucaKeyblob
34498>>>>>>>>>        Move (CopyMemory(AddressOf(ucaKeyblob), AddressOf(blobhead), iHeadSize)) to iVoid
34499>>>>>>>>>        Move (AppendArray(ucaKeyblob, ucaKey)) to ucaKeyblob
34500>>>>>>>>>        
34500>>>>>>>>>        Move 0 to hKey
34501>>>>>>>>>        Move (CryptImportKey(hProv, AddressOf(ucaKeyblob), SizeOfArray(ucaKeyblob), 0, 0, AddressOf(hKey))) to bSuccess
34502>>>>>>>>>        If (not(bSuccess)) Begin
34504>>>>>>>>>            Move (ShowLastError()) to iVoid
34505>>>>>>>>>        End
34505>>>>>>>>>>
34505>>>>>>>>>        
34505>>>>>>>>>        Function_Return hKey
34506>>>>>>>>>    End_Function
34507>>>>>>>>>    
34507>>>>>>>>>    // Destroys the key
34507>>>>>>>>>    Function DestroyKey Handle hKey Returns Boolean
34509>>>>>>>>>        Function_Return (CryptDestroyKey(hKey))
34510>>>>>>>>>    End_Function
34511>>>>>>>>>    
34511>>>>>>>>>    // Retrieves key data
34511>>>>>>>>>    Function KeyParameter Handle hKey Integer iQuery Returns Integer
34513>>>>>>>>>        Integer iBuffer iLen
34513>>>>>>>>>        Boolean bOk
34513>>>>>>>>>        
34513>>>>>>>>>        Move (SizeOfType(Integer)) to iLen
34514>>>>>>>>>        Move (CryptGetKeyParam(hKey,iQuery,AddressOf(iBuffer),AddressOf(iLen),0)) to bOk
34515>>>>>>>>>        Function_Return iBuffer
34516>>>>>>>>>    End_Function
34517>>>>>>>>>    
34517>>>>>>>>>    // Retrieves a hash value
34517>>>>>>>>>    Function HashValue Handle lhHash Returns UChar[]
34519>>>>>>>>>        UChar[] ucHash
34520>>>>>>>>>        Integer liResult
34520>>>>>>>>>        DWord   dwDataLen
34520>>>>>>>>>        
34520>>>>>>>>>        Move 0 to dwDataLen
34521>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,0,AddressOf(dwDataLen),0)) to liResult
34522>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
34525>>>>>>>>>        
34525>>>>>>>>>        Move (ResizeArray(ucHash, dwDataLen, 0)) to ucHash
34526>>>>>>>>>        Move (CryptGetHashParam(lhHash,HP_HASHVAL,AddressOf(ucHash),AddressOf(dwDataLen),0)) to liResult
34527>>>>>>>>>        If (liResult = 0) ;            Function_Return ""
34530>>>>>>>>>        
34530>>>>>>>>>        Function_Return ucHash
34531>>>>>>>>>    End_Function
34532>>>>>>>>>
34532>>>>>>>>>    // Encrypts data
34532>>>>>>>>>    Function Encrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
34534>>>>>>>>>        Handle hProv hHash hKey
34534>>>>>>>>>        Integer iAlgorithm iDataLen iCipherLen iErr
34534>>>>>>>>>        Boolean bOk
34534>>>>>>>>>        
34534>>>>>>>>>        Get AcquireContext to hProv
34535>>>>>>>>>        If (hProv) Begin
34537>>>>>>>>>            Get CreateHash hProv to hHash
34538>>>>>>>>>            If (hHash) Begin
34540>>>>>>>>>                Get HashData hHash ucPassword to bOk
34541>>>>>>>>>                If (bOk) Begin
34543>>>>>>>>>                    Get piCipher to iAlgorithm
34544>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
34545>>>>>>>>>                End
34545>>>>>>>>>>
34545>>>>>>>>>                Get DestroyHash hHash to bOk
34546>>>>>>>>>            End
34546>>>>>>>>>>
34546>>>>>>>>>            
34546>>>>>>>>>            If (hKey) Begin
34548>>>>>>>>>                //  First call to determine resulting data size
34548>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
34549>>>>>>>>>                Move (SizeOfArray(ucData)) to iCipherLen
34550>>>>>>>>>                Move (CryptEncrypt(hKey, 0, True, 0, 0, AddressOf(iCipherLen), iDataLen)) to bOk
34551>>>>>>>>>                
34551>>>>>>>>>                //  Reserve space in string
34551>>>>>>>>>                If (iDataLen < iCipherLen) Begin
34553>>>>>>>>>                    Move (ResizeArray(ucData, iCipherLen, 0)) to ucData
34554>>>>>>>>>                End
34554>>>>>>>>>>
34554>>>>>>>>>                
34554>>>>>>>>>                //  Call to really decrypt
34554>>>>>>>>>                Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen),SizeOfArray(ucData))) to bOk
34555>>>>>>>>>                //If (not(bOk)) Begin
34555>>>>>>>>>                //Move "" to sData
34555>>>>>>>>>                //Move (GetLastError()) to iErr
34555>>>>>>>>>                //End
34555>>>>>>>>>                
34555>>>>>>>>>                Get DestroyKey hKey to bOk
34556>>>>>>>>>            End 
34556>>>>>>>>>>
34556>>>>>>>>>            Get ReleaseContext hProv to bOk
34557>>>>>>>>>        End 
34557>>>>>>>>>>
34557>>>>>>>>>        Function_Return ucData
34558>>>>>>>>>    End_Function
34559>>>>>>>>>    
34559>>>>>>>>>    // Decrypts data
34559>>>>>>>>>    Function Decrypt UChar[] ucPassword UChar[] ucData Returns UChar[]
34561>>>>>>>>>        Handle hProv hHash hKey
34561>>>>>>>>>        Integer iAlgorithm iDataLen
34561>>>>>>>>>        Boolean bOk
34561>>>>>>>>>        
34561>>>>>>>>>        Get AcquireContext to hProv
34562>>>>>>>>>        If (hProv) Begin
34564>>>>>>>>>            Get CreateHash hProv to hHash
34565>>>>>>>>>            If (hHash) Begin
34567>>>>>>>>>                Get HashData hHash ucPassword to bOk
34568>>>>>>>>>                If (bOk) Begin
34570>>>>>>>>>                    Get piCipher to iAlgorithm
34571>>>>>>>>>                    Get DeriveKey hProv hHash to hKey
34572>>>>>>>>>                End
34572>>>>>>>>>>
34572>>>>>>>>>                Get DestroyHash hHash to bOk
34573>>>>>>>>>            End
34573>>>>>>>>>>
34573>>>>>>>>>            
34573>>>>>>>>>            If (hKey) Begin
34575>>>>>>>>>                Move (SizeOfArray(ucData)) to iDataLen
34576>>>>>>>>>                Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iDataLen))) to bOk
34577>>>>>>>>>                //  Resulting data can be shorter as the input string, in that case we shorten the result string
34577>>>>>>>>>                If (SizeOfArray (ucData) > iDataLen) Begin
34579>>>>>>>>>                    Move (ResizeArray(ucData, iDataLen)) to ucData
34580>>>>>>>>>                End
34580>>>>>>>>>>
34580>>>>>>>>>                
34580>>>>>>>>>                Get DestroyKey hKey to bOk
34581>>>>>>>>>            End
34581>>>>>>>>>>
34581>>>>>>>>>            Get ReleaseContext hProv to bOk
34582>>>>>>>>>        End
34582>>>>>>>>>>
34582>>>>>>>>>        Function_Return ucData
34583>>>>>>>>>    End_Function
34584>>>>>>>>>    
34584>>>>>>>>>    // Creates a key
34584>>>>>>>>>    Function CreateKey Handle hProv Returns Handle
34586>>>>>>>>>        Integer iAlg iType iByte iLength iSize
34586>>>>>>>>>        CryptoBlob keyBlob
34586>>>>>>>>>        CryptoBlob keyBlob
34586>>>>>>>>>        Boolean bOk
34586>>>>>>>>>        Handle hKey
34586>>>>>>>>>        UChar[] aKey
34587>>>>>>>>>
34587>>>>>>>>>        Get paKey to aKey
34588>>>>>>>>>        Get piKeyAlg to iAlg
34589>>>>>>>>>        Get piKeyType to iType
34590>>>>>>>>>        Move iAlg                   to keyBlob.header.bType
34591>>>>>>>>>        Move CUR_BLOB_VERSION       to keyBlob.header.bVersion
34592>>>>>>>>>        Move iType                  to keyBlob.header.aiKeyAlg
34593>>>>>>>>>        Move (SizeOfArray(aKey))    to keyBlob.cbKeySize
34594>>>>>>>>>        
34594>>>>>>>>>        Move (SizeOfArray(aKey)-1) to iLength
34595>>>>>>>>>        For iByte from 0 to iLength
34601>>>>>>>>>>
34601>>>>>>>>>            Move aKey[iByte] to keyBlob.rgbKeyData[iByte]
34602>>>>>>>>>        Loop
34603>>>>>>>>>>
34603>>>>>>>>>        
34603>>>>>>>>>        Move 0 to hKey
34604>>>>>>>>>        Move (CryptImportKey(hProv,AddressOf(keyBlob),SizeOfType(CryptoBlob),0,0,AddressOf(hKey))) to bOk
34605>>>>>>>>>        Function_Return hKey
34606>>>>>>>>>    End_Function
34607>>>>>>>>>    
34607>>>>>>>>>    // Sets the key parameters
34607>>>>>>>>>    Function SetKeyParameters Handle hKey Returns Boolean
34609>>>>>>>>>        Integer iPadding iMode
34609>>>>>>>>>        Boolean bOk
34609>>>>>>>>>        UChar[] aIV
34610>>>>>>>>>        
34610>>>>>>>>>        //Move (SizeOfArray(aIV)-1) to iLength
34610>>>>>>>>>        //For iByte from 0 to iLength
34610>>>>>>>>>        //    Move iByte to aIV[iByte]
34610>>>>>>>>>        //Loop
34610>>>>>>>>>
34610>>>>>>>>>        // Set initialization vector
34610>>>>>>>>>        Get paIV to aIV
34611>>>>>>>>>        Move (CryptSetKeyParam(hKey,KP_IV,AddressOf(aIV),0)) to bOk
34612>>>>>>>>>        If (bOk) Begin
34614>>>>>>>>>            // Set padding
34614>>>>>>>>>            Get piKeyPadding to iPadding
34615>>>>>>>>>            Move (CryptSetKeyParam(hKey,KP_PADDING,AddressOf(iPadding),0)) to bOk
34616>>>>>>>>>            If (bOk) Begin
34618>>>>>>>>>                // Set move
34618>>>>>>>>>                Get piKeyMode to iMode
34619>>>>>>>>>                Move (CryptSetKeyParam(hKey,KP_MODE,AddressOf(iMode),0)) to bOk
34620>>>>>>>>>            End
34620>>>>>>>>>>
34620>>>>>>>>>        End
34620>>>>>>>>>>
34620>>>>>>>>>        Function_Return bOk        
34621>>>>>>>>>    End_Function
34622>>>>>>>>>    
34622>>>>>>>>>    // Encrypts using block cipher
34622>>>>>>>>>    Function BlockEncrypt UChar[] ucData Returns UChar[]
34624>>>>>>>>>        Handle hProv hKey
34624>>>>>>>>>        Integer iLen iSize iBlocks
34624>>>>>>>>>        Boolean bOk
34624>>>>>>>>>        
34624>>>>>>>>>        Get AcquireContext to hProv
34625>>>>>>>>>        If (hProv) Begin
34627>>>>>>>>>            // Create key
34627>>>>>>>>>            Get CreateKey hProv to hKey
34628>>>>>>>>>            If (hKey) Begin
34630>>>>>>>>>                Get SetKeyParameters hKey to bOk
34631>>>>>>>>>                If (bOk) Begin
34633>>>>>>>>>                    // Buffer for block ciphers can be up to block length larger
34633>>>>>>>>>                    Get piBlockSize to iSize
34634>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
34635>>>>>>>>>                    
34635>>>>>>>>>                    Move ((iLen/iSize)+1) to iBlocks
34636>>>>>>>>>                    Move (ResizeArray(ucData,iBlocks*iSize)) to ucData
34637>>>>>>>>>                    Move (CryptEncrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen),SizeOfArray(ucData))) to bOk
34638>>>>>>>>>                End
34638>>>>>>>>>>
34638>>>>>>>>>                Get DestroyKey hKey to bOk
34639>>>>>>>>>            End
34639>>>>>>>>>>
34639>>>>>>>>>            Get ReleaseContext hProv to bOk
34640>>>>>>>>>        End
34640>>>>>>>>>>
34640>>>>>>>>>        Function_Return ucData
34641>>>>>>>>>    End_Function
34642>>>>>>>>>    
34642>>>>>>>>>    // Decrypts using block cipher
34642>>>>>>>>>    Function BlockDecrypt UChar[] ucData Returns UChar[]
34644>>>>>>>>>        Handle hProv hKey
34644>>>>>>>>>        Integer iLen
34644>>>>>>>>>        Boolean bOk
34644>>>>>>>>>        
34644>>>>>>>>>        Get AcquireContext to hProv
34645>>>>>>>>>        If (hProv) Begin
34647>>>>>>>>>            // Create key
34647>>>>>>>>>            Get CreateKey hProv to hKey
34648>>>>>>>>>            If (hKey) Begin
34650>>>>>>>>>                Get SetKeyParameters hKey to bOk
34651>>>>>>>>>                If (bOk) Begin
34653>>>>>>>>>                    Move (SizeOfArray(ucData)) to iLen
34654>>>>>>>>>                    Move (CryptDecrypt(hKey,0,True,0,AddressOf(ucData),AddressOf(iLen))) to bOk
34655>>>>>>>>>                    Move (ResizeArray(ucData,iLen)) to ucData
34656>>>>>>>>>                End
34656>>>>>>>>>>
34656>>>>>>>>>                Get DestroyKey hKey to bOk
34657>>>>>>>>>            End
34657>>>>>>>>>>
34657>>>>>>>>>            Get ReleaseContext hProv to bOk
34658>>>>>>>>>        End
34658>>>>>>>>>>
34658>>>>>>>>>        Function_Return ucData
34659>>>>>>>>>    End_Function
