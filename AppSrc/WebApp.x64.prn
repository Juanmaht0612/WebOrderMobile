23539>>>>>>>>>>>    // Desktop-style implementation of the restorestate logic. It finds out which view should be
23539>>>>>>>>>>>    // shown and calls ShowView, the callback messages will do further processing. If the state 
23539>>>>>>>>>>>    // hash is empty we show the default view.
23539>>>>>>>>>>>    //
23539>>>>>>>>>>>    // Params:
23539>>>>>>>>>>>    //      sStateHash      The full state hash.
23539>>>>>>>>>>>    //      bManualEnter    If true the state hash is entered by the user and a record should be 
23539>>>>>>>>>>>    //                      found.
23539>>>>>>>>>>>    Procedure RestoreState_Desktop String sStateHash Boolean bManualEnter
23541>>>>>>>>>>>        Boolean bDefault
23541>>>>>>>>>>>        Integer iPos
23541>>>>>>>>>>>        String sView
23541>>>>>>>>>>>        Handle hoView
23541>>>>>>>>>>>        
23541>>>>>>>>>>>        Move True to bDefault
23542>>>>>>>>>>>        
23542>>>>>>>>>>>        If (Trim(sStateHash) <> "") Begin
23544>>>>>>>>>>>            Send ParseViewStateHash sStateHash (&sView)
23545>>>>>>>>>>>            
23545>>>>>>>>>>>            Get ViewByStateHashName sView to hoView
23546>>>>>>>>>>>            
23546>>>>>>>>>>>            If (hoView > 0) Begin
23548>>>>>>>>>>>                If (bManualEnter) Begin
23550>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback_ManualEnter)) Self
23551>>>>>>>>>>>                End
23551>>>>>>>>>>>>
23551>>>>>>>>>>>                Else Begin
23552>>>>>>>>>>>                    Send Showview hoView (RefProc(RestoreState_Desktop_Callback)) Self
23553>>>>>>>>>>>                End
23553>>>>>>>>>>>>
23553>>>>>>>>>>>                Move False to bDefault
23554>>>>>>>>>>>            End
23554>>>>>>>>>>>>
23554>>>>>>>>>>>            Else Begin
23555>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
23557>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
23558>>>>>>>>>>>>
23558>>>>>>>>>>>                End
23558>>>>>>>>>>>>
23558>>>>>>>>>>>                Else  Begin
23559>>>>>>>>>>>                    Get GetDefaultView to hoView
23560>>>>>>>>>>>                    If (hoView > 0) Begin
23562>>>>>>>>>>>                        Send Show of hoView
23563>>>>>>>>>>>                        Send UpdateStateHash of hoView True
23564>>>>>>>>>>>                    End
23564>>>>>>>>>>>>
23564>>>>>>>>>>>                End
23564>>>>>>>>>>>>
23564>>>>>>>>>>>                Procedure_Return
23565>>>>>>>>>>>            End
23565>>>>>>>>>>>>
23565>>>>>>>>>>>        End
23565>>>>>>>>>>>>
23565>>>>>>>>>>>        
23565>>>>>>>>>>>        //  Else we just show the default view
23565>>>>>>>>>>>        If (bDefault) Begin
23567>>>>>>>>>>>            Get GetDefaultView to hoView
23568>>>>>>>>>>>            If (hoView > 0) Begin
23570>>>>>>>>>>>                Send Show of hoView
23571>>>>>>>>>>>            End
23571>>>>>>>>>>>>
23571>>>>>>>>>>>        End
23571>>>>>>>>>>>>
23571>>>>>>>>>>>    End_Procedure
23572>>>>>>>>>>>    
23572>>>>>>>>>>>    // Drill-down version of the restorestate implementation. It parses the state hash into the 
23572>>>>>>>>>>>    // separate pieces and restores the entire view stack. It loops over the views in the state
23572>>>>>>>>>>>    // hash and checks if they are already properly initialized, if not it will reinitialize the
23572>>>>>>>>>>>    // view and rest of the stack from that point on,  if it is properly initialized it won't do
23572>>>>>>>>>>>    // anything for this step.
23572>>>>>>>>>>>    //
23572>>>>>>>>>>>    // Params:
23572>>>>>>>>>>>    //      sStateHash      Full state hash string.
23572>>>>>>>>>>>    //      bManualEnter    True if the string is manually entered (not used in drill-down).
23572>>>>>>>>>>>    Procedure RestoreState_DrillDown String sStateHash Boolean bManualEnter
23574>>>>>>>>>>>        String sViewName sState sMainID sCustomState
23574>>>>>>>>>>>        String[] asStates asViews asMainIDs asCustomStates asParams
23579>>>>>>>>>>>        Integer iState iNavType iPos iStack iStateTo eViewStyle eTopViewStyle iCount iLastViewIndex iFirstDialogIndex
23579>>>>>>>>>>>        Handle hoView hoStackView hoTopView hoPrevView hoDefaultView hoInvoking hjObjectDef
23579>>>>>>>>>>>        Handle[] ahViews ahInvokingObjects
23581>>>>>>>>>>>        Integer[] aeNavType
23582>>>>>>>>>>>        Boolean bAllowAccess bOverrideState bReinitialize bOK bIsLoaded bViewShown bErr bSuccess bIsTopView bHandled
23582>>>>>>>>>>>        tWebViewInfo[] aViewStack
23582>>>>>>>>>>>        tWebViewInfo[] aViewStack
23583>>>>>>>>>>>        
23583>>>>>>>>>>>        Move False to bViewShown
23584>>>>>>>>>>>        Move False to bReinitialize
23585>>>>>>>>>>>        Move False to bErr
23586>>>>>>>>>>>        Move 0 to iStack
23587>>>>>>>>>>>        WebGet paViewStack of (ViewStack(Self)) to aViewStack    
23589>>>>>>>>>>>        
23589>>>>>>>>>>>        Get GetDefaultView to hoDefaultView
23590>>>>>>>>>>>        
23590>>>>>>>>>>>        //  Split into separate view state hashes
23590>>>>>>>>>>>        Get ParseStateHash sStateHash to asStates
23591>>>>>>>>>>>        
23591>>>>>>>>>>>        //  Resize arrays (for performance and byref calls)
23591>>>>>>>>>>>        Move (ResizeArray(asViews, SizeOfArray(asStates))) to asViews
23592>>>>>>>>>>>        Move (ResizeArray(asMainIDs, SizeOfArray(asStates))) to asMainIDs
23593>>>>>>>>>>>        Move (ResizeArray(asCustomStates, SizeOfArray(asStates))) to asCustomStates
23594>>>>>>>>>>>        Move (ResizeArray(ahViews, SizeOfArray(asStates))) to ahViews
23595>>>>>>>>>>>        Move (ResizeArray(ahInvokingObjects, SizeOfArray(asStates))) to ahInvokingObjects
23596>>>>>>>>>>>        Move (ResizeArray(aeNavType, SizeOfArray(asStates))) to aeNavType
23597>>>>>>>>>>>        
23597>>>>>>>>>>>        //  Start at global level
23597>>>>>>>>>>>        Move Self to hoInvoking
23598>>>>>>>>>>>        If (hoDefaultView <> C_WebUnresolvedObject and peStateMode(hoDefaultView) = vsmOff) Begin
23600>>>>>>>>>>>            Move hoDefaultView to hoInvoking
23601>>>>>>>>>>>            
23601>>>>>>>>>>>            Get AllowViewAccess hoDefaultView to bAllowAccess
23602>>>>>>>>>>>            
23602>>>>>>>>>>>            If (not(bAllowAccess)) Begin
23604>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
23605>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
23608>>>>>>>>>>>                    
23608>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
23609>>>>>>>>>>>            End
23609>>>>>>>>>>>>
23609>>>>>>>>>>>        End
23609>>>>>>>>>>>>
23609>>>>>>>>>>>                
23609>>>>>>>>>>>        //  Parse URL and validate view names
23609>>>>>>>>>>>        Move (SizeOfArray(asStates) - 1) to iStateTo
23610>>>>>>>>>>>        For iState from 0 to iStateTo
23616>>>>>>>>>>>>
23616>>>>>>>>>>>            Send ParseViewStateHash asStates[iState] (&asViews[iState]) (&asMainIDs[iState]) (&asCustomStates[iState])
23617>>>>>>>>>>>            
23617>>>>>>>>>>>            //  Search on previous view
23617>>>>>>>>>>>            Get FindNavPathByKey of hoInvoking asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
23618>>>>>>>>>>>            
23618>>>>>>>>>>>            //  The exception for the default view
23618>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject and iState <= 1 and hoInvoking = hoDefaultView) Begin
23620>>>>>>>>>>>                Get FindNavPathByKey of Self asViews[iState] (&ahInvokingObjects[iState]) (&aeNavType[iState]) to ahViews[iState]
23621>>>>>>>>>>>                Move Self to hoInvoking
23622>>>>>>>>>>>            End
23622>>>>>>>>>>>>
23622>>>>>>>>>>>            
23622>>>>>>>>>>>            //  If not found we have an invalid URL
23622>>>>>>>>>>>            If (ahViews[iState] = C_WebUnresolvedObject) Begin
23624>>>>>>>>>>>                //  Gracefull error and fallback to default view
23624>>>>>>>>>>>                Get Reset of (ViewStack(Self)) False True to bOK
23625>>>>>>>>>>>                If (hoDefaultView > 0) Begin
23627>>>>>>>>>>>                    Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
23628>>>>>>>>>>>                End
23628>>>>>>>>>>>>
23628>>>>>>>>>>>                
23628>>>>>>>>>>>                If (pbStateHashInvalidError(Self)) Begin
23630>>>>>>>>>>>                    Error DFERR_WEBAPP_INVALID_URL
23631>>>>>>>>>>>>
23631>>>>>>>>>>>                End
23631>>>>>>>>>>>>
23631>>>>>>>>>>>                Else If (hoDefaultView > 0) Begin
23634>>>>>>>>>>>                    Send UpdateStateHash of hoDefaultView True
23635>>>>>>>>>>>                End
23635>>>>>>>>>>>>
23635>>>>>>>>>>>                Procedure_Return
23636>>>>>>>>>>>            End
23636>>>>>>>>>>>>
23636>>>>>>>>>>>            
23636>>>>>>>>>>>            Get AllowViewAccess ahViews[iState] to bAllowAccess
23637>>>>>>>>>>>            
23637>>>>>>>>>>>            If (not(bAllowAccess)) Begin
23639>>>>>>>>>>>                Get ViewAccessDenied hoDefaultView True to bHandled
23640>>>>>>>>>>>                If (bHandled) ;                    Procedure_Return
23643>>>>>>>>>>>                    
23643>>>>>>>>>>>                Move (ResizeArray(asStates, 0)) to asStates
23644>>>>>>>>>>>                Move -1 to iStateTo
23645>>>>>>>>>>>            End
23645>>>>>>>>>>>>
23645>>>>>>>>>>>            
23645>>>>>>>>>>>            Move ahViews[iState] to hoInvoking
23646>>>>>>>>>>>        Loop    
23647>>>>>>>>>>>>
23647>>>>>>>>>>>        
23647>>>>>>>>>>>        
23647>>>>>>>>>>>        //  Loop over parsed states and compare to view stack
23647>>>>>>>>>>>        For iState from 0 to iStateTo
23653>>>>>>>>>>>>
23653>>>>>>>>>>>            Move hoView to hoPrevView
23654>>>>>>>>>>>            
23654>>>>>>>>>>>            Move ahViews[iState] to hoView    
23655>>>>>>>>>>>            Move asMainIDs[iState] to sMainID
23656>>>>>>>>>>>            Move asCustomStates[iState] to sCustomState
23657>>>>>>>>>>>            Get peWebViewStyle of hoView to eViewStyle
23658>>>>>>>>>>>            
23658>>>>>>>>>>>            If (eViewStyle <> wvsDialog) Begin
23660>>>>>>>>>>>                Move iState to iLastViewIndex
23661>>>>>>>>>>>            End
23661>>>>>>>>>>>>
23661>>>>>>>>>>>            Else If (eViewStyle = wvsDialog and iFirstDialogIndex = 0) Begin
23664>>>>>>>>>>>                Move iState to iFirstDialogIndex
23665>>>>>>>>>>>            End
23665>>>>>>>>>>>>
23665>>>>>>>>>>>            
23665>>>>>>>>>>>            //  If we where not reinitializing yet we check if we can get away with doing nothing
23665>>>>>>>>>>>            If (not(bReinitialize)) Begin
23667>>>>>>>>>>>                Move True to bReinitialize
23668>>>>>>>>>>>                
23668>>>>>>>>>>>                //  If the default view has vsmOff set then it will be on the stack but not in the hash, so we jump one step
23668>>>>>>>>>>>                If (hoDefaultView > 0 and peStateMode(hoDefaultView) = vsmOff and iStack = 0 and SizeOfArray(aViewStack) > 0) Begin
23670>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
23671>>>>>>>>>>>                    If (hoStackView = hoDefaultView) Begin
23673>>>>>>>>>>>                        Increment iStack
23674>>>>>>>>>>>                        Move hoDefaultView to hoPrevView
23675>>>>>>>>>>>                    End
23675>>>>>>>>>>>>
23675>>>>>>>>>>>                End
23675>>>>>>>>>>>>
23675>>>>>>>>>>>                
23675>>>>>>>>>>>                //  Check if stack matches hash
23675>>>>>>>>>>>                If (iStack < SizeOfArray(aViewStack)) Begin
23677>>>>>>>>>>>                    Get WebObjectByName aViewStack[iStack].sViewName to hoStackView
23678>>>>>>>>>>>                    
23678>>>>>>>>>>>                    If (hoView = hoStackView) Begin
23680>>>>>>>>>>>                        Get NeedReinitialize of hoView sMainID to bReinitialize
23681>>>>>>>>>>>                    End
23681>>>>>>>>>>>>
23681>>>>>>>>>>>                    
23681>>>>>>>>>>>                    //  If it didn't we need to close stuff to the level where it matched
23681>>>>>>>>>>>                    If (bReinitialize) Begin
23683>>>>>>>>>>>                        Get TopViewHandle of (ViewStack(Self)) to hoTopView
23684>>>>>>>>>>>                        
23684>>>>>>>>>>>                        //  We just rudely close views here, no checks, this is what entering the new URL would basically do as well!
23684>>>>>>>>>>>                        Send Hide of hoTopView
23685>>>>>>>>>>>                        Send PopDownToView of (ViewStack(Self)) hoPrevView
23686>>>>>>>>>>>                    End
23686>>>>>>>>>>>>
23686>>>>>>>>>>>                End
23686>>>>>>>>>>>>
23686>>>>>>>>>>>            End
23686>>>>>>>>>>>>
23686>>>>>>>>>>>            
23686>>>>>>>>>>>            //  If the stack didn't match the state hash we need to reinitialize.
23686>>>>>>>>>>>            If (bReinitialize) Begin
23688>>>>>>>>>>>                If (iStack = 0) Begin
23690>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
23691>>>>>>>>>>>                    
23691>>>>>>>>>>>                    If (hoDefaultView <> hoView and hoDefaultView > 0) Begin
23693>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
23694>>>>>>>>>>>                    End
23694>>>>>>>>>>>>
23694>>>>>>>>>>>                    
23694>>>>>>>>>>>                End
23694>>>>>>>>>>>>
23694>>>>>>>>>>>                
23694>>>>>>>>>>>                // Check if this is the top view
23694>>>>>>>>>>>                If (iState = (SizeOfArray(asStates) -1)) Begin
23696>>>>>>>>>>>                    Move True to bIsTopView
23697>>>>>>>>>>>                    
23697>>>>>>>>>>>                    //If the top view is a dialog we should render the first actual view too
23697>>>>>>>>>>>                    If (eViewStyle = wvsDialog) Begin
23699>>>>>>>>>>>                        Move iLastViewIndex to iCount
23700>>>>>>>>>>>                        //We need to know what view should be rendered behind the dialog
23700>>>>>>>>>>>                        While (iCount < iState)
23704>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
23705>>>>>>>>>>>                            Increment iCount
23706>>>>>>>>>>>                        Loop    
23707>>>>>>>>>>>>
23707>>>>>>>>>>>                    End
23707>>>>>>>>>>>>
23707>>>>>>>>>>>                    
23707>>>>>>>>>>>                End
23707>>>>>>>>>>>>
23707>>>>>>>>>>>                Else Begin
23708>>>>>>>>>>>                    Move False to bIsTopView
23709>>>>>>>>>>>                End
23709>>>>>>>>>>>>
23709>>>>>>>>>>>                
23709>>>>>>>>>>>                //  Actually initialize the view
23709>>>>>>>>>>>                Get NavigateInitialize of hoView ahInvokingObjects[iState] bIsTopView asStates[iState] aeNavType[iState] to bSuccess
23710>>>>>>>>>>>                If (not(bSuccess)) Begin
23712>>>>>>>>>>>                    //  Fallback to default view (error is already shown)
23712>>>>>>>>>>>                    Get Reset of (ViewStack(Self)) False True to bOK
23713>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
23715>>>>>>>>>>>                        Get NavigateInitialize of hoDefaultView Self True "" ntNavigateBegin to bSuccess
23716>>>>>>>>>>>                    End
23716>>>>>>>>>>>>
23716>>>>>>>>>>>                    
23716>>>>>>>>>>>                    If (hoDefaultView > 0) Begin
23718>>>>>>>>>>>                        Send UpdateStateHash of hoDefaultView True
23719>>>>>>>>>>>                    End
23719>>>>>>>>>>>>
23719>>>>>>>>>>>                    Procedure_Return
23720>>>>>>>>>>>                End
23720>>>>>>>>>>>>
23720>>>>>>>>>>>            End
23720>>>>>>>>>>>>
23720>>>>>>>>>>>            
23720>>>>>>>>>>>            Move True to bViewShown
23721>>>>>>>>>>>            Increment iStack
23722>>>>>>>>>>>      
23722>>>>>>>>>>>        Loop    
23723>>>>>>>>>>>>
23723>>>>>>>>>>>        
23723>>>>>>>>>>>        //  If no view is shown we show the default view..
23723>>>>>>>>>>>        If (not(bViewShown)) Begin
23725>>>>>>>>>>>            Get Reset of (ViewStack(Self)) False True to bOK
23726>>>>>>>>>>>            Get NavigateInitialize of hoDefaultView Self (SizeOfArray(asStates) <= 0) "" ntNavigateBegin to bSuccess
23727>>>>>>>>>>>        End
23727>>>>>>>>>>>>
23727>>>>>>>>>>>        
23727>>>>>>>>>>>        //  We only serialize the last view in the stack right away
23727>>>>>>>>>>>        If (hoView <> C_WebUnresolvedObject) Begin
23729>>>>>>>>>>>            
23729>>>>>>>>>>>            If (not(bReinitialize)) Begin
23731>>>>>>>>>>>                Get TopViewHandle of (ViewStack(Self)) to hoTopView
23732>>>>>>>>>>>                If (hoView <> hoTopView) Begin
23734>>>>>>>>>>>                    If (hoTopView > 0) Begin
23736>>>>>>>>>>>                        Send Hide of hoTopView
23737>>>>>>>>>>>                        Get peWebViewStyle of hoTopView to eTopViewStyle
23738>>>>>>>>>>>                    End
23738>>>>>>>>>>>>
23738>>>>>>>>>>>                    Send PopDownToView of (ViewStack(Self)) hoView
23739>>>>>>>>>>>                    Send UpdateInvokingViewDrillDownStyle of hoView
23740>>>>>>>>>>>                    
23740>>>>>>>>>>>                    Get pbOverrideStateOnShow of hoView to bOverrideState
23741>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to False
23742>>>>>>>>>>>                    
23742>>>>>>>>>>>                    Get peWebViewStyle of hoView to eViewStyle
23743>>>>>>>>>>>                    // When navigating from a regular view to a dialog we should restore more views
23743>>>>>>>>>>>                    // Restore everything up untill the first actual view
23743>>>>>>>>>>>                    If (eTopViewStyle = wvsDrillDown and eViewStyle = wvsDialog) Begin
23745>>>>>>>>>>>                        Move iLastViewIndex to iCount
23746>>>>>>>>>>>                        //Start from the last actual view and move up from there on.
23746>>>>>>>>>>>                        While (iCount <= iStateTo)
23750>>>>>>>>>>>                            Send ShowView to (Host(Self)) ahViews[iCount]
23751>>>>>>>>>>>                            Increment iCount
23752>>>>>>>>>>>                        Loop
23753>>>>>>>>>>>>
23753>>>>>>>>>>>                    End
23753>>>>>>>>>>>>
23753>>>>>>>>>>>                    Else Begin
23754>>>>>>>>>>>                        Send ShowView to (Host(Self)) hoView        // Send ShowView so we do not clear the entire viewstack    
23755>>>>>>>>>>>                    End
23755>>>>>>>>>>>>
23755>>>>>>>>>>>                                    
23755>>>>>>>>>>>                    Set pbOverrideStateOnShow of hoView to bOverrideState
23756>>>>>>>>>>>                End
23756>>>>>>>>>>>>
23756>>>>>>>>>>>            
23756>>>>>>>>>>>            End
23756>>>>>>>>>>>>
23756>>>>>>>>>>>            Else Begin
23757>>>>>>>>>>>                Get IsViewLoaded hoView to bIsLoaded
23758>>>>>>>>>>>                If (not(bIsLoaded)) Begin
23760>>>>>>>>>>>                    Set phoLoadView to hoView   //  Set phoLoadView as ClientActions sent by OnLoad must be marked as load view client actions
23761>>>>>>>>>>>                    
23761>>>>>>>>>>>                    Get SerializeObject of hoView to hjObjectDef
23762>>>>>>>>>>>                    Send ClientActionEarly "createView" asParams hjObjectDef               
23763>>>>>>>>>>>                    Send Destroy of hjObjectDef
23764>>>>>>>>>>>                    Set phoLoadView to C_WebUnresolvedObject
23765>>>>>>>>>>>                End
23765>>>>>>>>>>>>
23765>>>>>>>>>>>            End
23765>>>>>>>>>>>>
23765>>>>>>>>>>>        End    
23765>>>>>>>>>>>>
23765>>>>>>>>>>>    End_Procedure
23766>>>>>>>>>>>    
23766>>>>>>>>>>>    // Splits a view state hash string into the different pieces that it can contain.
23766>>>>>>>>>>>    //
23766>>>>>>>>>>>    // Params:
23766>>>>>>>>>>>    //      sStateHash              Complete view state hash.
23766>>>>>>>>>>>    //      ByRef sView             Will receive the view name.
23766>>>>>>>>>>>    //      Byref sOptRecordId      (optional) Will receive the record id.
23766>>>>>>>>>>>    //      ByRef sOptCustomHash    (optional) Will receive the custom hash.
23766>>>>>>>>>>>    Procedure ParseViewStateHash String sStateHash String ByRef sView String ByRef sOptRecordId String ByRef sOptCustomHash
23768>>>>>>>>>>>        String[] asParts
23769>>>>>>>>>>>        
23769>>>>>>>>>>>        //  Cut off possible "/" prefix
23769>>>>>>>>>>>        If (Left(sStateHash, 1) = "/") Begin
23771>>>>>>>>>>>            Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
23772>>>>>>>>>>>        End
23772>>>>>>>>>>>>
23772>>>>>>>>>>>        
23772>>>>>>>>>>>        Move "" to sView
23773>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "-")) to asParts
23774>>>>>>>>>>>        
23774>>>>>>>>>>>        If (num_arguments > 3) Begin        
23776>>>>>>>>>>>            Move "" to sOptCustomHash
23777>>>>>>>>>>>
23777>>>>>>>>>>>            If (SizeOfArray(asParts) > 2) Begin 
23779>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[2] to sOptCustomHash
23780>>>>>>>>>>>            End
23780>>>>>>>>>>>>
23780>>>>>>>>>>>        End
23780>>>>>>>>>>>>
23780>>>>>>>>>>>        
23780>>>>>>>>>>>        If (num_arguments > 2) Begin
23782>>>>>>>>>>>            Move "" to sOptRecordId
23783>>>>>>>>>>>            
23783>>>>>>>>>>>            If (SizeOfArray(asParts) > 1) Begin
23785>>>>>>>>>>>                Get UnescapeViewStatePartial asParts[1] to sOptRecordId
23786>>>>>>>>>>>            End
23786>>>>>>>>>>>>
23786>>>>>>>>>>>        End
23786>>>>>>>>>>>>
23786>>>>>>>>>>>        If (SizeOfArray(asParts) > 0) Begin
23788>>>>>>>>>>>            Get UnescapeViewStatePartial asParts[0] to sView
23789>>>>>>>>>>>        End
23789>>>>>>>>>>>>
23789>>>>>>>>>>>        
23789>>>>>>>>>>>    End_Procedure
23790>>>>>>>>>>>    
23790>>>>>>>>>>>    // Concatenates the different parts of a view state hash into a single string. Some characters 
23790>>>>>>>>>>>    // will be escaped.
23790>>>>>>>>>>>    //
23790>>>>>>>>>>>    // Params:
23790>>>>>>>>>>>    //      sView       The view name.
23790>>>>>>>>>>>    //      sRecordId   The record id.
23790>>>>>>>>>>>    //      sCustomHash Custom hash part.
23790>>>>>>>>>>>    Function ConcatViewStateHash String sView String sRecordId String sCustomHash Returns String
23792>>>>>>>>>>>        String sResult
23792>>>>>>>>>>>        
23792>>>>>>>>>>>        Get EscapeViewStatePartial sView to sView
23793>>>>>>>>>>>        Move sView to sResult
23794>>>>>>>>>>>        
23794>>>>>>>>>>>        If (sRecordId <> "" or sCustomHash <> "") Begin
23796>>>>>>>>>>>            Get EscapeViewStatePartial sRecordId to sRecordId
23797>>>>>>>>>>>            Move (sResult + "-" + sRecordId) to sResult
23798>>>>>>>>>>>            
23798>>>>>>>>>>>            If (sCustomHash <> "") Begin
23800>>>>>>>>>>>                Get EscapeViewStatePartial sCustomHash to sCustomHash
23801>>>>>>>>>>>                Move (sResult + "-" + sCustomHash) to sResult
23802>>>>>>>>>>>            End
23802>>>>>>>>>>>>
23802>>>>>>>>>>>        End
23802>>>>>>>>>>>>
23802>>>>>>>>>>>        
23802>>>>>>>>>>>        Function_Return sResult
23803>>>>>>>>>>>    End_Function
23804>>>>>>>>>>>    
23804>>>>>>>>>>>    // Splits a drill-down style state hash into an array of separate view state hashes.
23804>>>>>>>>>>>    //
23804>>>>>>>>>>>    // Params:
23804>>>>>>>>>>>    //      sStateHash  Full state hash.
23804>>>>>>>>>>>    // Returns:
23804>>>>>>>>>>>    //      Array of view state hashes.
23804>>>>>>>>>>>    Function ParseStateHash String sStateHash Returns String[]
23806>>>>>>>>>>>        String[] aViewStateHashes
23807>>>>>>>>>>>        Integer i
23807>>>>>>>>>>>        
23807>>>>>>>>>>>        Move (StrSplitToArray(sStateHash, "/")) to aViewStateHashes
23808>>>>>>>>>>>        
23808>>>>>>>>>>>        //  Remove empty parts
23808>>>>>>>>>>>        For i from 0 to (SizeOfArray(aViewStateHashes) - 1)
23814>>>>>>>>>>>>
23814>>>>>>>>>>>            If (Trim(aViewStateHashes[i]) = "") Begin
23816>>>>>>>>>>>                Move (RemoveFromArray(aViewStateHashes, i)) to aViewStateHashes
23817>>>>>>>>>>>            End
23817>>>>>>>>>>>>
23817>>>>>>>>>>>        Loop
23818>>>>>>>>>>>>
23818>>>>>>>>>>>        
23818>>>>>>>>>>>        Function_Return aViewStateHashes
23819>>>>>>>>>>>    End_Function
23820>>>>>>>>>>>    
23820>>>>>>>>>>>    // Appends a view state hash to a drill-down style state hash.
23820>>>>>>>>>>>    //
23820>>>>>>>>>>>    // Params:
23820>>>>>>>>>>>    //      sStateHash      Existing state hash.
23820>>>>>>>>>>>    //      sViewStateHash  View state hash to append.
23820>>>>>>>>>>>    // Returns:
23820>>>>>>>>>>>    //      The extended state has string.
23820>>>>>>>>>>>    Function AppendStateHash String sStateHash String sViewStateHash Returns String
23822>>>>>>>>>>>        If (sStateHash <> "") Begin
23824>>>>>>>>>>>            Move (sStateHash + "/" + sViewStateHash) to sStateHash
23825>>>>>>>>>>>        End
23825>>>>>>>>>>>>
23825>>>>>>>>>>>        Else Begin
23826>>>>>>>>>>>            Move sViewStateHash to sStateHash
23827>>>>>>>>>>>        End
23827>>>>>>>>>>>>
23827>>>>>>>>>>>        
23827>>>>>>>>>>>        Function_Return sStateHash
23828>>>>>>>>>>>    End_Function
23829>>>>>>>>>>>    
23829>>>>>>>>>>>    //  Escapes disallowed characters in a view state partial with their hexadecimal values between
23829>>>>>>>>>>>    //  ~ characters. The / and - are escaped because they are used to concatenate the different 
23829>>>>>>>>>>>    // pieces.
23829>>>>>>>>>>>    //
23829>>>>>>>>>>>    // Params:
23829>>>>>>>>>>>    //      sHash   The partial hash to escape.
23829>>>>>>>>>>>    // Returns:
23829>>>>>>>>>>>    //      The escaped partial view state hash.
23829>>>>>>>>>>>    Function EscapeViewStatePartial String sHash Returns String
23831>>>>>>>>>>>        //  Encode characters used elsewhere in URLs
23831>>>>>>>>>>>        Move (Replaces("-", Replaces("/", sHash, "~2f~"), "~5f~")) to sHash
23832>>>>>>>>>>>        
23832>>>>>>>>>>>        Move (UrlEncode(sHash, True)) to sHash
23833>>>>>>>>>>>        
23833>>>>>>>>>>>        Function_Return sHash
23834>>>>>>>>>>>    End_Function    
23835>>>>>>>>>>>    
23835>>>>>>>>>>>    // Unescapes a view state partial that has been escaped by EscapeViewStatePartial.
23835>>>>>>>>>>>    //
23835>>>>>>>>>>>    // Params:
23835>>>>>>>>>>>    //      sHash   The partial hash to unescape.
23835>>>>>>>>>>>    // Returns:
23835>>>>>>>>>>>    //      The unescaped partial view state hash.
23835>>>>>>>>>>>    Function UnescapeViewStatePartial String sHash Returns String
23837>>>>>>>>>>>        Move (UrlDecode(sHash)) to sHash
23838>>>>>>>>>>>        
23838>>>>>>>>>>>        //  Decode characters used elsehwere in urls
23838>>>>>>>>>>>        Move (Replaces("~5f~", Replaces("~2f~", sHash, "/"), "-")) to sHash
23839>>>>>>>>>>>        
23839>>>>>>>>>>>        Function_Return sHash
23840>>>>>>>>>>>    End_Function 
23841>>>>>>>>>>>    
23841>>>>>>>>>>>    // Converts a state hash into a URL. By default the hash is added to the URL a location hash 
23841>>>>>>>>>>>    // (behind the #). Override when a customized URL format is used.
23841>>>>>>>>>>>    //
23841>>>>>>>>>>>    // Params:
23841>>>>>>>>>>>    //      ByRef sHashUrl      Contains the hash when coming in, should contain the URL when going out.    
23841>>>>>>>>>>>    Procedure StateHashToUrl String ByRef sHashUrl
23843>>>>>>>>>>>        String sBaseHref
23843>>>>>>>>>>>        
23843>>>>>>>>>>>        If (pbStateAsUrlHash(Self)) Begin
23845>>>>>>>>>>>            If (Left(sHashUrl, 1) <> "#") Begin
23847>>>>>>>>>>>                Move ("#" + sHashUrl) to sHashUrl 
23848>>>>>>>>>>>            End
23848>>>>>>>>>>>>
23848>>>>>>>>>>>        End
23848>>>>>>>>>>>>
23848>>>>>>>>>>>        
23848>>>>>>>>>>>        WebGet psBaseHref to sBaseHref
23849>>>>>>>>>>>        Move (sBaseHref + sHashUrl) to sHashUrl
23850>>>>>>>>>>>    End_Procedure
23851>>>>>>>>>>>    
23851>>>>>>>>>>>    // Updates the state hash by pushing a new history item or replacing the existing one. Looks at
23851>>>>>>>>>>>    // peApplicationStateMode to see what it should do.
23851>>>>>>>>>>>    //
23851>>>>>>>>>>>    // Params:
23851>>>>>>>>>>>    //      sStateHash      New state hash.
23851>>>>>>>>>>>    //      sTitle          New page title.
23851>>>>>>>>>>>    //      bReplace        If true the current state is replaced, if false a new history item is 
23851>>>>>>>>>>>    //                      pushed.
23851>>>>>>>>>>>    Procedure SetStateHash String sStateHash String sTitle Boolean bReplace
23853>>>>>>>>>>>        tWebValueTree vt
23853>>>>>>>>>>>        tWebValueTree vt
23853>>>>>>>>>>>       
23853>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
23855>>>>>>>>>>>            Move sStateHash to vt.v
23856>>>>>>>>>>>            
23856>>>>>>>>>>>            If (bReplace) Begin
23858>>>>>>>>>>>                Send HistoryReplaceState "" sTitle vt
23859>>>>>>>>>>>            End
23859>>>>>>>>>>>>
23859>>>>>>>>>>>            Else Begin
23860>>>>>>>>>>>                Send HistoryPushState "" sTitle vt
23861>>>>>>>>>>>            End
23861>>>>>>>>>>>>
23861>>>>>>>>>>>            WebSet psCurrentAppState to sStateHash
23862>>>>>>>>>>>        End
23862>>>>>>>>>>>>
23862>>>>>>>>>>>        
23862>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
23864>>>>>>>>>>>            Send StateHashToUrl (&sStateHash)
23865>>>>>>>>>>>            If (bReplace) Begin
23867>>>>>>>>>>>                Send HistoryReplaceState sStateHash sTitle
23868>>>>>>>>>>>            End
23868>>>>>>>>>>>>
23868>>>>>>>>>>>            Else Begin
23869>>>>>>>>>>>                Send HistoryPushState sStateHash sTitle
23870>>>>>>>>>>>            End
23870>>>>>>>>>>>>
23870>>>>>>>>>>>        End
23870>>>>>>>>>>>>
23870>>>>>>>>>>>    End_Procedure
23871>>>>>>>>>>>
23871>>>>>>>>>>>    // Determines the current state hash. Depending on peApplicationState it looks at the location 
23871>>>>>>>>>>>    // hash or a property.
23871>>>>>>>>>>>    //
23871>>>>>>>>>>>    // Returns:
23871>>>>>>>>>>>    //      The current application state hash (since it was last updated).
23871>>>>>>>>>>>    Function StateHash Returns String
23873>>>>>>>>>>>        String sStateHash
23873>>>>>>>>>>>        
23873>>>>>>>>>>>        // When the hash is not part of the URL but we do support history then the state hash is
23873>>>>>>>>>>>        // stored in a web property unad updated by SetStateHash and HistoryPopState.
23873>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryOnly) Begin
23875>>>>>>>>>>>            WebGet psCurrentAppState to sStateHash
23876>>>>>>>>>>>        End
23876>>>>>>>>>>>>
23876>>>>>>>>>>>        
23876>>>>>>>>>>>        // When the hash is part of the URL we can always read it from the URL. Note that this 
23876>>>>>>>>>>>        // doesn't reflect changes made during this request.
23876>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls) Begin
23878>>>>>>>>>>>            WebGet psLocationHash to sStateHash
23879>>>>>>>>>>>            
23879>>>>>>>>>>>            If (Left(sStateHash, 1) = "#") Begin
23881>>>>>>>>>>>                Move (Right(sStateHash, Length(sStateHash) - 1)) to sStateHash
23882>>>>>>>>>>>            End
23882>>>>>>>>>>>>
23882>>>>>>>>>>>        End 
23882>>>>>>>>>>>>
23882>>>>>>>>>>>        Function_Return sStateHash
23883>>>>>>>>>>>    End_Function
23884>>>>>>>>>>>    
23884>>>>>>>>>>>    // Restores the passed state hash and updates the history.
23884>>>>>>>>>>>    //
23884>>>>>>>>>>>    // Params:
23884>>>>>>>>>>>    //  sStateHash  State hash to restore.
23884>>>>>>>>>>>    //  bReplace    If true the current history item is replaced (instead of adding a new history item).
23884>>>>>>>>>>>    Procedure NavigateToStateHash String sStateHash Boolean bReplace
23886>>>>>>>>>>>        Send SetStateHash sStateHash "" bReplace
23887>>>>>>>>>>>        Send RestoreState sStateHash
23888>>>>>>>>>>>    End_Procedure
23889>>>>>>>>>>>    
23889>>>>>>>>>>>    // Server-Action
23889>>>>>>>>>>>    //
23889>>>>>>>>>>>    //  This overrides LocationHasChange in cWebHostAPI_mixin!
23889>>>>>>>>>>>    //
23889>>>>>>>>>>>    // Called by the client when the location hash changes (hashchange browser event) and triggers
23889>>>>>>>>>>>    // a restorestate if needed and calls OnLocationHashChange.
23889>>>>>>>>>>>    // 
23889>>>>>>>>>>>    // Params:
23889>>>>>>>>>>>    //      sHash       New location hash.
23889>>>>>>>>>>>    Procedure LocationHashChange String sHash
23891>>>>>>>>>>>        String sStateHash
23891>>>>>>>>>>>        
23891>>>>>>>>>>>        If (peApplicationStateMode(Self) = asmHistoryAndUrls and pbStateAsUrlHash(Self)) Begin
23893>>>>>>>>>>>            Get StateHash to sStateHash
23894>>>>>>>>>>>            Send RestoreState sStateHash True
23895>>>>>>>>>>>        End
