10518>>>>>>>>>    // Returns true if this is a user error (i.e. "find past end of file")
10518>>>>>>>>>    Function IsUserError Integer iError Returns Boolean
10520>>>>>>>>>        Integer[] aUserErrors
10521>>>>>>>>>        Get paUserErrors to aUserErrors
10522>>>>>>>>>        Function_Return (BinarySearchArray(iError, aUserErrors) <> -1)
10523>>>>>>>>>    End_Function
10524>>>>>>>>>    
10524>>>>>>>>>        // returns true if this is an unhandled error (i.e., not a user error
10524>>>>>>>>>    Function IsUnhandledError Integer iError Returns Boolean
10526>>>>>>>>>        Integer[] UserErrors
10527>>>>>>>>>        Get paUserErrors to UserErrors
10528>>>>>>>>>        Function_Return (SearchArray(iError,UserErrors)=-1)
10529>>>>>>>>>    End_Function
10530>>>>>>>>>    
10530>>>>>>>>>    Procedure AddUserError Integer iError
10532>>>>>>>>>        // adds a user error to the collection of defined 'user errors'
10532>>>>>>>>>        Integer[] aUserErrors
10533>>>>>>>>>        Get paUserErrors to aUserErrors
10534>>>>>>>>>        
10534>>>>>>>>>        If (BinarySearchArray(iError, aUserErrors) = -1) Begin
10536>>>>>>>>>            Move (InsertInArray(aUserErrors, BinarySearchInsertPos(), iError)) to aUserErrors         // Keep the array sorted. Makes searching fast, adding slower.
10537>>>>>>>>>            Set paUserErrors to aUserErrors
10538>>>>>>>>>        End
10538>>>>>>>>>>
10538>>>>>>>>>    End_Procedure
10539>>>>>>>>>    
10539>>>>>>>>>    Procedure RemoveUserError Integer iError
10541>>>>>>>>>        // Removes the passed error number from the set of user errors.
10541>>>>>>>>>        Integer iIndex
10541>>>>>>>>>        Integer[] aUserErrors
10542>>>>>>>>>        
10542>>>>>>>>>        Get paUserErrors to aUserErrors
10543>>>>>>>>>        Move (BinarySearchArray(iError, aUserErrors)) to iIndex
10544>>>>>>>>>        
10544>>>>>>>>>        If (iIndex <> -1) Begin
10546>>>>>>>>>            Move (RemoveFromArray(aUserErrors, iIndex)) to aUserErrors
10547>>>>>>>>>            Set paUserErrors to aUserErrors
10548>>>>>>>>>        End
10548>>>>>>>>>>
10548>>>>>>>>>    End_Procedure
10549>>>>>>>>>    
