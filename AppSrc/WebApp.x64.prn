18242>>>>>>>>>    
18242>>>>>>>>>    // Initializes a dynamic property. Dynamic properties hold
18242>>>>>>>>>    // the values of properties for dynamic objects that are
18242>>>>>>>>>    // different from their class-defined values. 
18242>>>>>>>>>    //
18242>>>>>>>>>    //This should be compared to setting properties inside object definition:
18242>>>>>>>>>    // Object oButton is a cWebButton
18242>>>>>>>>>    //     Set psCaption to ...
18242>>>>>>>>>    //     Set piColumnIndex to ...
18242>>>>>>>>>    // End_Object
18242>>>>>>>>>    Procedure InitDynamicProp String sPropName Variant vPropValue
18244>>>>>>>>>        String sName
18244>>>>>>>>>        Integer iPubPropIndex
18244>>>>>>>>>        Handle hoOwner hmSetter
18244>>>>>>>>>        Boolean bIsDynamicObject
18244>>>>>>>>>        tWebPropMetaData pubProp
18244>>>>>>>>>        tWebPropMetaData pubProp
18244>>>>>>>>>        
18244>>>>>>>>>        Get IsDynamicObject to bIsDynamicObject
18245>>>>>>>>>        
18245>>>>>>>>>        If (bIsDynamicObject) Begin
18247>>>>>>>>>            Get FindWebPropertyMetaByName sPropName to pubProp
18248>>>>>>>>>            
18248>>>>>>>>>            If (pubProp.hmGetter > 0) Begin        
18250>>>>>>>>>                Get Owner to hoOwner
18251>>>>>>>>>                Set pubProp.hmSetter to vPropValue
18252>>>>>>>>>                Send SetDynamicProp of hoOwner (Self) pubProp vPropValue
18253>>>>>>>>>            End
18253>>>>>>>>>>
18253>>>>>>>>>            Else Begin
18254>>>>>>>>>                Get Name to sName
18255>>>>>>>>>                Error DFERR_PROGRAM (SFormat(C_$PropertyDoesNotExist, sPropName, sName))
18256>>>>>>>>>>
18256>>>>>>>>>            End        
18256>>>>>>>>>>
18256>>>>>>>>>        End
18256>>>>>>>>>>
18256>>>>>>>>>        Else Begin
18257>>>>>>>>>            Get Name to sName
18258>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Object '%1' is not a dynamic object", sName))
18259>>>>>>>>>>
18259>>>>>>>>>        End
18259>>>>>>>>>>
18259>>>>>>>>>    End_Procedure
18260>>>>>>>>>    
18260>>>>>>>>>    // Retrieves the action data for a server action as value tree. Available to support older 
18260>>>>>>>>>    // controls working with value trees, this function performs the conversion from JSON handle.
18260>>>>>>>>>    Function ptActionData Returns tWebValueTree
18262>>>>>>>>>        Handle hoJsonObj
18262>>>>>>>>>        tWebValueTree result
18262>>>>>>>>>        tWebValueTree result
18262>>>>>>>>>        
18262>>>>>>>>>        Get phoActionJsonData to hoJsonObj
18263>>>>>>>>>        If (hoJsonObj <> C_WebUnresolvedObject) Begin
18265>>>>>>>>>            If (IsOfJsonType(hoJsonObj, jsonTypeObject)) Begin
18267>>>>>>>>>                Set pbRequireAllMembers of hoJsonObj to False
18268>>>>>>>>>                Get JsonToDataType of hoJsonObj to result
18269>>>>>>>>>            End
18269>>>>>>>>>>
18269>>>>>>>>>        End
18269>>>>>>>>>>
18269>>>>>>>>>        
18269>>>>>>>>>        Function_Return result
18270>>>>>>>>>    End_Function
18271>>>>>>>>>    
18271>>>>>>>>>    
18271>>>>>>>>>    // Adds a client action to the array of client actions that is returned to the client. The 
18271>>>>>>>>>    // action will address this web object on the client.
18271>>>>>>>>>    // Interface for requesting a client side action to be sent back in the CallAction response.
18271>>>>>>>>>    // sName        - Name of the method to call on client
18271>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
18271>>>>>>>>>    // vActionData  - [optional] Additional struct with action data sent to the client. This can be
18271>>>>>>>>>    //              any struct that is serializable to JSON using DataTypeToJson.
18271>>>>>>>>>    Procedure ClientAction String sName String[] aOptParams Variant vActionData
18273>>>>>>>>>        Handle hoJsonObj
18273>>>>>>>>>        
18273>>>>>>>>>        If (num_arguments > 2) Begin
18275>>>>>>>>>            Get Create (RefClass(cJsonObject)) to hoJsonObj
18276>>>>>>>>>            Send DataTypeToJson of hoJsonObj vActionData
18277>>>>>>>>>            
18277>>>>>>>>>            Send ClientActionEx sName aOptParams hoJsonObj
18278>>>>>>>>>            Send Destroy of hoJsonObj    
18279>>>>>>>>>        End
18279>>>>>>>>>>
18279>>>>>>>>>        Else If (num_arguments > 1) Begin
18282>>>>>>>>>            Send ClientActionEx sName aOptParams
18283>>>>>>>>>        End
18283>>>>>>>>>>
18283>>>>>>>>>        Else Begin
18284>>>>>>>>>            Send ClientActionEx sName
18285>>>>>>>>>        End
18285>>>>>>>>>>
18285>>>>>>>>>    End_Procedure
18286>>>>>>>>>    
18286>>>>>>>>>    // Adds a client action to the array of client actions that is returned to the client. The 
18286>>>>>>>>>    // action will address this web object on the client.
18286>>>>>>>>>    // Interface for requesting a client side action to be sent back in the CallAction response.
18286>>>>>>>>>    // sName        - Name of the method to call on client
18286>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
18286>>>>>>>>>    // vActionData  - [optional] Additional struct with action data sent to the client. This can be
18286>>>>>>>>>    //              any struct that is serializable to JSON using DataTypeToJson.
18286>>>>>>>>>    Procedure ClientActionEarly String sName String[] aOptParams Handle hjActionData
18288>>>>>>>>>        tWebClientAction tClientAction
18288>>>>>>>>>        tWebClientAction tClientAction
18288>>>>>>>>>        
18288>>>>>>>>>        Move ctExecEarly to tClientAction.eType
18289>>>>>>>>>        
18289>>>>>>>>>        Move sName   to tClientAction.sName
18290>>>>>>>>>        Get WebObjectName to tClientAction.sTarget
18291>>>>>>>>>        
18291>>>>>>>>>        If (num_arguments > 1) Begin
18293>>>>>>>>>            Move aOptParams to tClientAction.aParams
18294>>>>>>>>>        End
18294>>>>>>>>>>
18294>>>>>>>>>        
18294>>>>>>>>>        Move 0 to tClientAction.iAttached
18295>>>>>>>>>        If (num_arguments > 2) Begin
18297>>>>>>>>>            Get AddResponseAttachment of (Host(Self)) hjActionData to tClientAction.iAttached
18298>>>>>>>>>        End
18298>>>>>>>>>>
18298>>>>>>>>>
18298>>>>>>>>>        Send AddClientAction of (Owner(Self)) tClientAction
18299>>>>>>>>>    End_Procedure
18300>>>>>>>>>    
18300>>>>>>>>>    // Extended ClientAction API. Adds a client action to the response that will be executed on the
18300>>>>>>>>>    // client. A client action executes a JavaScript function on a specific object. If no object
18300>>>>>>>>>    // (window. or this.) is specified it will be executed on the JavaScript object presentation of
18300>>>>>>>>>    // this web object. Client actions are asynchronous!
18300>>>>>>>>>    // sName        - Name of the method to call on the client (can contain object specification
18300>>>>>>>>>    //              like this. or window.)
18300>>>>>>>>>    // aParams      - [optional] Parameters to pass to the client method
18300>>>>>>>>>    // hoOptJsonAttachment  - Handle to a cJsonObject that is sent as attachment and will be 
18300>>>>>>>>>    //                      available as _tActionData on the client during the ClientAction.
18300>>>>>>>>>    Procedure ClientActionEx String sName String[] aOptParams Handle hoOptJsonAttachment
18302>>>>>>>>>        tWebClientAction tClientAction
18302>>>>>>>>>        tWebClientAction tClientAction
18302>>>>>>>>>        
18302>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
18305>>>>>>>>>        Get OwnerActionState of (Owner(Self)) Self to tClientAction.eType
18306>>>>>>>>>        
18306>>>>>>>>>        Move sName   to tClientAction.sName
18307>>>>>>>>>        Get WebObjectName to tClientAction.sTarget
18308>>>>>>>>>        
18308>>>>>>>>>        If (num_arguments > 1) Begin
18310>>>>>>>>>            Move aOptParams to tClientAction.aParams
18311>>>>>>>>>        End
18311>>>>>>>>>>
18311>>>>>>>>>        
18311>>>>>>>>>        Move 0 to tClientAction.iAttached
18312>>>>>>>>>        If (num_arguments > 2) Begin
18314>>>>>>>>>            Get AddResponseAttachment of (Host(Self)) hoOptJsonAttachment to tClientAction.iAttached
18315>>>>>>>>>        End
18315>>>>>>>>>>
18315>>>>>>>>>
18315>>>>>>>>>        Send AddClientAction of (Owner(Self)) tClientAction
18316>>>>>>>>>    End_Procedure
18317>>>>>>>>>    
18317>>>>>>>>>    // This procedure cancels all client actions with the specified name for this object. In some 
18317>>>>>>>>>    // cases only the last client action really makes sense for the component. An example is a 
18317>>>>>>>>>    // gridRefresh where sending multiple refreshes immediately after each other are just 
18317>>>>>>>>>    // inefficient.
18317>>>>>>>>>    // sName - Name of the method to call on client
18317>>>>>>>>>    Procedure CancelClientAction String sName
18319>>>>>>>>>        If (pbGhost(Self)) ;            Procedure_Return
18322>>>>>>>>>        Send OwnerCancelClientAction of (Owner(Self)) Self sName
18323>>>>>>>>>    End_Procedure
18324>>>>>>>>>    
18324>>>>>>>>>    /*    Converts a web property value from the unlocalized string format into the proper format, before    returning it as a string which will then be in the localized format.    */
18324>>>>>>>>>    Function ConvertFromTransport Handle hmGetter String sValue Integer eType Returns String
18326>>>>>>>>>        Date dateVal
18326>>>>>>>>>        Real realVal
18326>>>>>>>>>        DateTime datetimeVal
18326>>>>>>>>>        Number numberVal
18326>>>>>>>>>        Time timeVal
18326>>>>>>>>>        Currency currencyVal
18326>>>>>>>>>        TimeSpan timespanVal
18326>>>>>>>>>        Decimal decimalVal
18326>>>>>>>>>        Float floatVal        
18326>>>>>>>>>        
18326>>>>>>>>>        Case Begin
18326>>>>>>>>>            Case (eType = cArgDate)
18328>>>>>>>>>                CvtLocalization Off
18329>>>>>>>>>                Move sValue to dateVal
18330>>>>>>>>>                CvtLocalization On
18331>>>>>>>>>                Function_Return dateVal
18332>>>>>>>>>            Case (eType = cArgReal)
18335>>>>>>>>>                CvtLocalization Off
18336>>>>>>>>>                Move sValue to realVal
18337>>>>>>>>>                CvtLocalization On
18338>>>>>>>>>                Function_Return realVal
18339>>>>>>>>>            Case (eType = cArgTime)
18342>>>>>>>>>                CvtLocalization Off
18343>>>>>>>>>                Move sValue to timeVal
18344>>>>>>>>>                CvtLocalization On
18345>>>>>>>>>                Function_Return timeVal
18346>>>>>>>>>            Case (eType = cArgDateTime)
18349>>>>>>>>>                ConvertFromXml xsDatetime sValue to datetimeVal
18350>>>>>>>>>                Function_Return datetimeVal
18351>>>>>>>>>            Case (eType = cArgFloat)
18354>>>>>>>>>                CvtLocalization Off
18355>>>>>>>>>                Move sValue to floatVal
18356>>>>>>>>>                CvtLocalization On
18357>>>>>>>>>                Function_Return floatVal
18358>>>>>>>>>            Case (eType = cArgNum)
18361>>>>>>>>>                CvtLocalization Off
18362>>>>>>>>>                Move sValue to numberVal
18363>>>>>>>>>                CvtLocalization On
18364>>>>>>>>>                Function_Return numberVal
18365>>>>>>>>>            Case (eType = cArgCurrency)
18368>>>>>>>>>                CvtLocalization Off
18369>>>>>>>>>                Move sValue to currencyVal
18370>>>>>>>>>                CvtLocalization On
18371>>>>>>>>>                Function_Return currencyVal
18372>>>>>>>>>            Case (eType = cArgTimeSpan)
18375>>>>>>>>>                CvtLocalization Off
18376>>>>>>>>>                Move sValue to timespanVal
18377>>>>>>>>>                CvtLocalization On
18378>>>>>>>>>                Function_Return timespanVal
18379>>>>>>>>>            Case (eType = cArgDecimal)
18382>>>>>>>>>                CvtLocalization Off
18383>>>>>>>>>                Move sValue to decimalVal
18384>>>>>>>>>                CvtLocalization On
18385>>>>>>>>>                Function_Return decimalVal
18386>>>>>>>>>            Case Else
18386>>>>>>>>>                Function_Return sValue
18387>>>>>>>>>        Case End
18387>>>>>>>>>    End_Function
18388>>>>>>>>>
18388>>>>>>>>>
18388>>>>>>>>>    /*    Converts web property values to a transportable format (string) in a fixed unlocalized format.     Do this it first makes sure the value is converted to its actual type before converting it     into a string.    */
18388>>>>>>>>>    Function ConvertToTransport Handle hmGetter Variant vValue Integer eType  Returns String
18390>>>>>>>>>        String sValue
18390>>>>>>>>>        Date dateVal
18390>>>>>>>>>        Real realVal
18390>>>>>>>>>        DateTime datetimeVal
18390>>>>>>>>>        Number numberVal
18390>>>>>>>>>        Time timeVal
18390>>>>>>>>>        Currency currencyVal
18390>>>>>>>>>        TimeSpan timespanVal
18390>>>>>>>>>        Decimal decimalVal
18390>>>>>>>>>        Float floatVal
18390>>>>>>>>>        
18390>>>>>>>>>        Case Begin
18390>>>>>>>>>            Case (eType = cArgDate)
18392>>>>>>>>>                Move vValue to dateVal
18393>>>>>>>>>                CvtLocalization Off
18394>>>>>>>>>                Move dateVal to sValue
18395>>>>>>>>>                Cvtlocalization On
18396>>>>>>>>>                Break
18397>>>>>>>>>            Case (eType = cArgReal)
18400>>>>>>>>>                Move vValue to realVal
18401>>>>>>>>>                CvtLocalization Off
18402>>>>>>>>>                Move realVal to sValue
18403>>>>>>>>>                Cvtlocalization On
18404>>>>>>>>>                Break
18405>>>>>>>>>            Case (eType = cArgTime)
18408>>>>>>>>>                Move vValue to timeVal
18409>>>>>>>>>                CvtLocalization Off
18410>>>>>>>>>                Move timeVal to sValue
18411>>>>>>>>>                Cvtlocalization On
18412>>>>>>>>>                Break
18413>>>>>>>>>            Case (eType = cArgDateTime)
18416>>>>>>>>>                Move vValue to datetimeVal
18417>>>>>>>>>                ConvertToXml xsDatetime datetimeVal to sValue
18418>>>>>>>>>                Break
18419>>>>>>>>>            Case (eType = cArgFloat)
18422>>>>>>>>>                Move vValue to floatVal
18423>>>>>>>>>                CvtLocalization Off
18424>>>>>>>>>                Move floatVal to sValue
18425>>>>>>>>>                Cvtlocalization On
18426>>>>>>>>>                Break
18427>>>>>>>>>            Case (eType = cArgNum)
18430>>>>>>>>>                Move vValue to numberVal
18431>>>>>>>>>                CvtLocalization Off
18432>>>>>>>>>                Move numberVal to sValue
18433>>>>>>>>>                CvtLocalization On
18434>>>>>>>>>                Break
18435>>>>>>>>>            Case (eType = cArgCurrency)
18438>>>>>>>>>                Move vValue to currencyVal
18439>>>>>>>>>                CvtLocalization Off
18440>>>>>>>>>                Move currencyVal to sValue
18441>>>>>>>>>                Cvtlocalization On
18442>>>>>>>>>                Break
18443>>>>>>>>>            Case (eType = cArgTimeSpan)
18446>>>>>>>>>                Move vValue to timespanVal
18447>>>>>>>>>                CvtLocalization Off
18448>>>>>>>>>                Move timespanVal to sValue
18449>>>>>>>>>                Cvtlocalization On
18450>>>>>>>>>                Break
18451>>>>>>>>>            Case (eType = cArgDecimal)
18454>>>>>>>>>                Move vValue to decimalVal
18455>>>>>>>>>                CvtLocalization Off
18456>>>>>>>>>                Move decimalVal to sValue
18457>>>>>>>>>                Cvtlocalization On
18458>>>>>>>>>                Break
18459>>>>>>>>>            Case Else
18459>>>>>>>>>                CvtLocalization Off
18460>>>>>>>>>                Move vValue to sValue
18461>>>>>>>>>                CvtLocalization On
18462>>>>>>>>>        Case End
18462>>>>>>>>>        
18462>>>>>>>>>        Function_Return sValue
18463>>>>>>>>>    End_Function
18464>>>>>>>>>
18464>>>>>>>>>    Function DEO_Object Returns Boolean
18466>>>>>>>>>        // all web objects should understand this message. Will be set True in sub-classes
18466>>>>>>>>>        Function_Return False
18467>>>>>>>>>    End_Function
18468>>>>>>>>>
18468>>>>>>>>>    
18468>>>>>>>>>    // Returns the addressed web property value. (see also SetSyncProp)
18468>>>>>>>>>    // Forwards the message to the central singleton ghoSyncPropHandler after having determined if 
18468>>>>>>>>>    // it is scalar or non scalar property type. This separation is made here as non scalars are 
18468>>>>>>>>>    // passed as variants and doing so with scalar types (especially string) will perform
18468>>>>>>>>>    // unnessecary conversions. The function return type is variant but when returning a string
18468>>>>>>>>>    // value the runtime does only convert it the return value is actually placed in a variant
18468>>>>>>>>>    // variable (which is very unlikely).
18468>>>>>>>>>    // hoObject  - Is handle to the object which ownes the property.
18468>>>>>>>>>    // hmSetter  - Is a handle to the property's setter message.
18468>>>>>>>>>    // sPropName - Is the (case sensitive) property name.
18468>>>>>>>>>    // Returns   - The property value as a string.
18468>>>>>>>>>    //
18468>>>>>>>>>    // Use the WebGet command instead of sending this message.
18468>>>>>>>>>    Function GetSyncProp Handle hoObject Handle hmSetter String sPropName Returns Variant
18470>>>>>>>>>        Variant vReturn
18470>>>>>>>>>        String sReturn sObject
18470>>>>>>>>>        tWebPropMetaData pubProp
18470>>>>>>>>>        tWebPropMetaData pubProp
18470>>>>>>>>>        
18470>>>>>>>>>        //  Find property index
18470>>>>>>>>>        Get FindWebPropertyMetaBySetter hmSetter to pubProp
18471>>>>>>>>>        
18471>>>>>>>>>        If (pubProp.hmGetter <= 0) Begin
18473>>>>>>>>>            Get Object_Label to sObject
18474>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppPropertyNotPublished, "WebGet", sPropName, sObject, C_NewLine+C_NewLine))        
18475>>>>>>>>>>
18475>>>>>>>>>            Function_Return
18476>>>>>>>>>        End
18476>>>>>>>>>>
18476>>>>>>>>>        
18476>>>>>>>>>        //  Switch between scalar and non-scalar (advanced) web properties
18476>>>>>>>>>        If (pubProp.eType = cArgArray or pubProp.eType = cArgStruct) Begin
18478>>>>>>>>>            Get OwnerGetAdvSyncProp of (Owner(Self)) hoObject (&pubProp) to vReturn
18479>>>>>>>>>            Function_Return vReturn
18480>>>>>>>>>        End
18480>>>>>>>>>>
18480>>>>>>>>>        Else Begin
18481>>>>>>>>>            Get OwnerGetSyncProp of (Owner(Self)) hoObject (&pubProp) to sReturn  
18482>>>>>>>>>            Function_Return sReturn // Explicitly return a string to prevent conversion (this wins from the return type, confirmed in runtime @DF20)
18483>>>>>>>>>        End
18483>>>>>>>>>>
18483>>>>>>>>>        
18483>>>>>>>>>        Function_Return sReturn
18484>>>>>>>>>    End_Function
18485>>>>>>>>>
18485>>>>>>>>>    
18485>>>>>>>>>    // This method is received by the Web Control that is the target of a CallAction that is sent
18485>>>>>>>>>    // from the client. The requested action must belong to the control's collection of published
18485>>>>>>>>>    // methods.
18485>>>>>>>>>    Function HandleAction String sAction String[] aParams Handle hoAttachment Returns String
18487>>>>>>>>>        Integer iIndex i icParameters
18487>>>>>>>>>        Integer eDataType
18487>>>>>>>>>        Boolean bAllow
18487>>>>>>>>>        String sReturnVal
18487>>>>>>>>>        Handle[] aPubMethodHandles
18488>>>>>>>>>        String[] aPubMethodNames
18489>>>>>>>>>        Boolean[] aPubMethodIsFunction
18490>>>>>>>>>        Boolean bInScope
18490>>>>>>>>>        
18490>>>>>>>>>        //  Security Check: Only allow actions if object is in scope!
18490>>>>>>>>>        Get IsInCallActionScope to bInScope
18491>>>>>>>>>        If (not(bInScope)) Begin
18493>>>>>>>>>            Error DFERR_PROGRAM (SFormat("Object '%2' being accessed by server action '%1' not in scope!", sAction, Object_Label(Self)))
18494>>>>>>>>>>
18494>>>>>>>>>            Function_Return ""
18495>>>>>>>>>        End
18495>>>>>>>>>>
18495>>>>>>>>>        
18495>>>>>>>>>        //  Get published methods
18495>>>>>>>>>        Get paPubMethodHandles    to aPubMethodHandles    
18496>>>>>>>>>        Get paPubMethodNames      to aPubMethodNames      
18497>>>>>>>>>        Get paPubMethodIsFunction to aPubMethodIsFunction
18498>>>>>>>>>        
18498>>>>>>>>>        // Lookup the passed action....
18498>>>>>>>>>        Move (SearchArray(Uppercase(sAction), aPubMethodNames)) to iIndex
18499>>>>>>>>>        
18499>>>>>>>>>        If (iIndex = -1) Begin
18501>>>>>>>>>            // Unregistered methods cannot be called by client (security)
18501>>>>>>>>>            Error DFERR_PROGRAM (SFormat(C_$WebAppMethodNotPublished, sAction, Object_Label(Self)))
18502>>>>>>>>>>
18502>>>>>>>>>        End
18502>>>>>>>>>>
18502>>>>>>>>>        Else Begin            
18503>>>>>>>>>            //  Perform security check
18503>>>>>>>>>            Move True to bAllow
18504>>>>>>>>>            Send AllowServerAction (&bAllow) aPubMethodNames[iIndex] aPubMethodHandles[iIndex] aPubMethodIsFunction[iIndex] (&aParams)
18505>>>>>>>>>            If (not(bAllow)) Begin
18507>>>>>>>>>                
18507>>>>>>>>>                Error DFERR_WEBAPP_ACTION_NOT_ALLOWED (SFormat(C_$WebAppMethodNotAllowed, aPubMethodNames[iIndex], Object_Label(Self)))
18508>>>>>>>>>>
18508>>>>>>>>>                Function_Return ""
18509>>>>>>>>>            End
18509>>>>>>>>>>
18509>>>>>>>>>            
18509>>>>>>>>>            
18509>>>>>>>>>            //  Store the action data in a property so it is accessible for the action method
18509>>>>>>>>>            Set phoActionJsonData to hoAttachment
18510>>>>>>>>>            
18510>>>>>>>>>            // Get the parameter count....
18510>>>>>>>>>            Move (SizeOfArray(aParams)) to icParameters
18511>>>>>>>>>            
18511>>>>>>>>>            // Special Case: OnChange
18511>>>>>>>>>            If (Uppercase(sAction) = "ONCHANGE") Begin
18513>>>>>>>>>                // If the action is an OnChange event then we must test if the data type is a number, 
18513>>>>>>>>>                // Date or DateTime. If so we must convert each parameter value from the universal 
18513>>>>>>>>>                // transfer format
18513>>>>>>>>>                Get peDataType to eDataType   // If the object supports psValue it should also support peDataType. If not peDataType will get delegated to ghoWebApp and return typeASCII.
18514>>>>>>>>>                // Note: For efficienty we do not WebGet peDataType! In other words we do not
18514>>>>>>>>>                // get the "synchronized copy of peDataType (if there is one). This is much more
18514>>>>>>>>>                // efficient but it also assumes that a control's peDataType does not change 
18514>>>>>>>>>                // dynamically. This should be OK....
18514>>>>>>>>>                For i from 0 to (icParameters - 1)
18520>>>>>>>>>>
18520>>>>>>>>>                    Move (ConvertFromClient(eDataType, aParams[i])) to aParams[i]
18521>>>>>>>>>                Loop
18522>>>>>>>>>>
18522>>>>>>>>>            End
18522>>>>>>>>>>
18522>>>>>>>>>           
18522>>>>>>>>>            // Call the action
18522>>>>>>>>>            If (aPubMethodIsFunction[iIndex]) Begin
18524>>>>>>>>>                Case Begin
18524>>>>>>>>>                    Case (icParameters = 0)
18526>>>>>>>>>                        Get aPubMethodHandles[iIndex] to sReturnVal     // calls the function
18527>>>>>>>>>                        Case Break
18528>>>>>>>>>                    Case (icParameters = 1)
18531>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] to sReturnVal
18532>>>>>>>>>                        Case Break
18533>>>>>>>>>                    Case (icParameters = 2)
18536>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] to sReturnVal
18537>>>>>>>>>                        Case Break
18538>>>>>>>>>                    Case (icParameters = 3)
18541>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] to sReturnVal
18542>>>>>>>>>                        Case Break
18543>>>>>>>>>                    Case (icParameters = 4)
18546>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] to sReturnVal
18547>>>>>>>>>                        Case Break
18548>>>>>>>>>                    Case (icParameters = 5)
18551>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] to sReturnVal
18552>>>>>>>>>                        Case Break
18553>>>>>>>>>                    Case (icParameters = 6)
18556>>>>>>>>>                        Get aPubMethodHandles[iIndex] aParams[0] aParams[1] aParams[2] aParams[3] aParams[4] aParams[5] to sReturnVal
18557>>>>>>>>>                        Case Break
