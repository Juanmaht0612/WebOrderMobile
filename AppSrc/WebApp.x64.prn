2521>>>>>>>        Get protoType_object to pObjId
2522>>>>>>>        Get Data_File  of pObjID Item# to File#
2523>>>>>>>        If File# Begin
2525>>>>>>>            Get Data_Field of pObjID Item# to Field#
2526>>>>>>>            Get_Attribute DF_Field_Length of file# field# to Margin
2529>>>>>>>            Get_Attribute DF_Field_Type of file# field#   to datatype
2532>>>>>>>            Move ASCII_WINDOW to wintype
2533>>>>>>>            If (datatype=DF_BCD) Begin
2535>>>>>>>                Get_Attribute DF_Field_Precision of file# field# to Wintype
2538>>>>>>>                If WinType ;                    Increment margin
2541>>>>>>>            End
2541>>>>>>>>
2541>>>>>>>            Else If (datatype=DF_DATE) Begin
2544>>>>>>>                Move DATE_WINDOW to wintype
2545>>>>>>>                Move 10 to margin
2546>>>>>>>            End
2546>>>>>>>>
2546>>>>>>>            Else If (datatype=DF_DATETIME) Begin
2549>>>>>>>                // if someone is using datetime, it is best that they use a mask. If nothing
2549>>>>>>>                // is provided, we will use an ascii window. DEOs will change this to mask_datetime_window but
2549>>>>>>>                // not DEOs will not. Don't set datetime mask here because there would be no way for the
2549>>>>>>>                // DD logic to figure out if the type was changed in the Deo object. The DD Deosassume that
2549>>>>>>>                // datetime /w ascii_window is the unassigned value and that it is safe to chane it.
2549>>>>>>>                Move Ascii_Window to wintype // if no mask set, we will just use non-maks ascii window
2550>>>>>>>                Move 26 to margin // should be enough for "mm/dd/yyyy hh:mm:ss.fff pm"
2551>>>>>>>            End
2551>>>>>>>>
2551>>>>>>>            Set Form_Margin   Item# to Margin
2552>>>>>>>            Get Form_datatype item# to Formtype
2553>>>>>>>            If ( (Formtype=MASK_NUMERIC_WINDOW or ;                FormType=MASK_CURRENCY_WINDOW) and ;                Form_Mask(Self,item#)='') Begin
2555>>>>>>>                If (WinType > 0) ;                    Subtract (WinType+1) from Margin
2558>>>>>>>                If (Formtype = MASK_CURRENCY_WINDOW) ;                    Set Currency_Mask Item# to Margin wintype
2561>>>>>>>                Else ;                    Set Numeric_Mask Item# to Margin wintype
2563>>>>>>>            End
2563>>>>>>>>
2563>>>>>>>            Else If (FormType <= ascii_window) ; // only auto-set if non mask. If type is a mask                Set Form_DataType Item# to wintype // we assume it was defined.
2567>>>>>>>        End
2567>>>>>>>>
2567>>>>>>>        Else ;            Set Form_Margin   Item# to (form_width(Self,Item#))
2569>>>>>>>    End_Procedure
