10107>>>    Procedure DoOpenWorkspace String sWorkspace
10109>>>        // Tries to open in this order:
10109>>>        // 1) if absolute path, use that; otherwise
10109>>>        // 2) try to open in the path of the EXE; otherwise
10109>>>        // 3) load it via the Registered list
10109>>>        
10109>>>        Integer eOpened
10109>>>        String sError sWSFile
10109>>>        Handle hoWorkspace
10109>>>        Boolean bChangingWorkspace
10109>>>        
10109>>>        // As soon as an open is attempted, the application's object psAutoOpenWorkspace property
10109>>>        // is cleared. This way any attempt to manually open a workspace during its construction,
10109>>>        // which includes OnCreate, will stop the object from attempting to automatically open the
10109>>>        // workspace. This was added to make psAutoOpenWorkspace compatible with older applications.
10109>>>        // Typically these application will open a workspace in OnCreate. If this happens we assume
10109>>>        // that there should be no automatic opening of a worskpace.
10109>>>        Set psAutoOpenWorkspace to ""
10110>>>        
10110>>>        Get phoWorkspace to hoWorkspace
10111>>>        
10111>>>        Get pbWorkspaceOpened of hoWorkspace to bChangingWorkspace
10112>>>        If (bChangingWorkspace and ghoConnection) Begin
10114>>>            Send AutoDisconnect
10115>>>        End
10115>>>>
10115>>>        
10115>>>        Get OpenWorkspaceFile of hoWorkspace sWorkspace to eOpened
10116>>>        If (eOpened = wsWorkspaceFileNotFound) Begin
10118>>>            If (IsRegistered(hoWorkspace, sWorkspace) =True) Begin
10120>>>                Get OpenWorkspace of hoWorkspace sWorkspace to eOpened
10121>>>            End
10121>>>>
10121>>>        End
10121>>>>
10121>>>        If (eOpened <> wsWorkspaceOpened) Begin
10123>>>            Get OpenWorkspaceErrorMessage of hoWorkspace eOpened to sError
10124>>>            Get psWorkspaceWSFile of hoWorkspace to sWSFile
10125>>>            Error DFERR_CAPPLICATION (SFormat(C_$TheProgramCannotRun, sWorkspace) + ":\n\n" + If(sWSFile<>"",sWSfile+"\n\n","") +sError)
10126>>>>
10126>>>            Abort
10127>>>>
10127>>>        End
10127>>>>
10127>>>        Else Begin
10128>>>            Send AutoConnect
10129>>>            Send OnWorkspaceOpened
10130>>>        End
10130>>>>
10130>>>    End_Procedure
10131>>>    
10131>>>    Procedure AutoConnect
10133>>>        If (ghoConnection) Begin
10135>>>            Send AutoConnect of ghoConnection
10136>>>        End
10136>>>>
10136>>>    End_Procedure
10137>>>    
10137>>>    Procedure AutoDisconnect
10139>>>        If (ghoConnection) Begin
10141>>>            Send AutoDisconnect of ghoConnection
10142>>>        End
10142>>>>
10142>>>    End_Procedure
10143>>>    
