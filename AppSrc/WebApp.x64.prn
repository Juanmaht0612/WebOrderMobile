29587>>>>>>>>>    // Augmented to apply a pbSortable value for columns that are not already set
29587>>>>>>>>>    Procedure Attach_Deo_To_Server
29589>>>>>>>>>        Integer iIndex iSortable eDataType eFooterDataType iPrecision iFooterPrecision
29589>>>>>>>>>        Boolean bClientSortable
29589>>>>>>>>>        String sMask sFooterMask
29589>>>>>>>>>
29589>>>>>>>>>        Forward Send Attach_Deo_To_Server
29591>>>>>>>>>        
29591>>>>>>>>>        Get peDataType to eDataType
29592>>>>>>>>>        Get peFooterDataType to eFooterDataType
29593>>>>>>>>>        If (eFooterDataType = C_WebDefault) Begin
29595>>>>>>>>>            Set peFooterDataType to eDataType
29596>>>>>>>>>        End
29596>>>>>>>>>>
29596>>>>>>>>>        
29596>>>>>>>>>        Get psMask to sMask
29597>>>>>>>>>        Get psFooterMask to sFooterMask
29598>>>>>>>>>        If (sFooterMask = "") Begin
29600>>>>>>>>>            Set psFooterMask to sMask
29601>>>>>>>>>        End
29601>>>>>>>>>>
29601>>>>>>>>>         
29601>>>>>>>>>        Get piPrecision to iPrecision
29602>>>>>>>>>        Get piFooterPrecision to iFooterPrecision
29603>>>>>>>>>        If (iFooterPrecision = C_WebDefault) Begin
29605>>>>>>>>>            Set piFooterPrecision to iPrecision
29606>>>>>>>>>        End
29606>>>>>>>>>>
29606>>>>>>>>>
29606>>>>>>>>>        // need to set piDefaultIndex and pbSortable (if not explicitly set)
29606>>>>>>>>>        // find out who does the sorting, the client or the server
29606>>>>>>>>>        Delegate Get ClientSortable to bClientSortable
29608>>>>>>>>>        Get pbSortable to iSortable
29609>>>>>>>>>        
29609>>>>>>>>>        If (bClientSortable) Begin
29611>>>>>>>>>            // if client sorting, we dont care about piDefaultIndex
29611>>>>>>>>>            // and if  pbSortable is undefined, true is a good default
29611>>>>>>>>>            If (iSortable = C_WebDefault) Begin
29613>>>>>>>>>                Set pbSortable to True
29614>>>>>>>>>            End
29614>>>>>>>>>>
29614>>>>>>>>>        End
29614>>>>>>>>>>
29614>>>>>>>>>        Else Begin
29615>>>>>>>>>            
29615>>>>>>>>>            // if server sorting, we will set piDefaultIndex
29615>>>>>>>>>            // and if pbSortable is undefined, set it based on having an index
29615>>>>>>>>>            Get piDefaultIndex to iIndex
29616>>>>>>>>>            
29616>>>>>>>>>            If (iIndex = -1) Begin
29618>>>>>>>>>                Get DefaultIndex to iIndex
29619>>>>>>>>>                Set piDefaultIndex to iIndex 
29620>>>>>>>>>            End
29620>>>>>>>>>>
29620>>>>>>>>>            
29620>>>>>>>>>            // If the pbSortable is undefined, set a proper default for it
29620>>>>>>>>>            If (iSortable = C_WebDefault) Begin
29622>>>>>>>>>                Set pbSortable to (iIndex <> -1)
29623>>>>>>>>>            End
29623>>>>>>>>>>
29623>>>>>>>>>        End
29623>>>>>>>>>>
29623>>>>>>>>>
29623>>>>>>>>>    End_Procedure
