Use cWebModalDialog.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebForm.pkg
Use cWebWidgetConfigurationWizard.pkg
Use cWebCombo.pkg

Object oWidgetConfigList is a cWebWidgetConfigurationWizard
    Set psCaption to "ListWidgetConfig"
    Set piMinWidth to 500
    Set piMinHeight to 200
    Set pbServerOnSubmit to True    // enable the OnSubmit event
    
    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12
        
        Object oSelectDataSet is a cWebCombo
            Set pbAddEmptyItem to False
            Set piColumnIndex to 0
            Set piColumnSpan to 0
            Set psLabel to "DataSet:"
            Set pbServerOnChange to True
            
            Procedure OnFill
                Send AddComboItem "SalesPersons" "Sales Persons"
                Send AddComboItem "Customers" "Customers"
                Send AddComboItem "Inventory" "Inventory"
            End_Procedure
            
            Procedure OnChange String sNewValue String sOldValue
                If (sNewValue = "Inventory") Begin
                    WebSet pbRender of oAlertlevel to True
                End
                Else Begin
                    WebSet pbRender of oAlertlevel to False
                End
                
            End_Procedure
        End_Object
           
        Object oSortTypeTop is a cWebRadio
            Set psCaption to "Top 5"
            Set psRadioValue to "Top"
            Set piColumnSpan to 6
            Set psLabel to "Show: "
            Set pbShowLabel to True
            Set psGroupName to "SortType"
        End_Object
        
        Object oSortTypeBottom is a cWebRadio
            Set psCaption to "Bottom 5"
            Set psRadioValue to "Bottom"
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set psGroupName to "SortType"
        End_Object
        
        Object oShowModeTotals is a cWebRadio
            Set psCaption to "Totals"
            Set psRadioValue to "total"
            Set piColumnSpan to 6
            Set psLabel to "Compare using: "
            Set pbShowLabel to True
            Set psGroupName to "ShowMode"
        End_Object
        
        Object oShowModeDifference is a cWebRadio
            Set psCaption to "Difference"
            Set psRadioValue to "difference"
            Set piColumnSpan to 6
            Set piColumnIndex to 6
            Set psGroupName to "ShowMode"
        End_Object
        
        Object oAlertlevel is a cWebForm
            Set piColumnSpan to 0
            Set psLabel to "Alert when stock is below:"
            Set piLabelOffset to 240
            Set pbRender to False
        End_Object
    End_Object 
    
    Object oBottomPanel is a cWebPanel
        Set piColumnCount to 6
        Set peRegion to prBottom

        Object oOkButton is a cWebButton
            Set psCaption to C_$OK
            Set piColumnSpan to 1
            Set piColumnIndex to 4

            Procedure OnClick
                Send Ok
            End_Procedure
        End_Object 

        Object oCancelButton is a cWebButton
            Set psCaption to C_$Cancel
            Set piColumnSpan to 1
            Set piColumnIndex to 5

            Procedure OnClick
                Send Cancel
            End_Procedure
        End_Object 
    End_Object 

    Procedure OnSubmit
        Send Ok
    End_Procedure
    
    Procedure Ok
        Forward Send Ok
    End_Procedure

    Procedure Cancel
        Forward Send Cancel
    End_Procedure
    
    Procedure OnPopulateWizard tWidgetConfigProp[] aConfigurableProps tWidgetConfigPropValue[] aCurPropValues
        String sDataSet sSortType sMode
        Integer iAlertLevel
        
        Get GetPropValue aCurPropValues '' "psDataSet" to sDataSet
        Get GetPropValue aCurPropValues '' "psSortType" to sSortType
        Get GetPropValue aCurPropValues '' "psMode" to sMode
        Get GetPropValue aCurPropValues '' "piLowInventoryAlertLevel" to iAlertLevel
        
        WebSet psValue of oSelectDataSet to sDataSet
        WebSet psValue of oSortTypeTop to sSortType
        WebSet psValue of oShowModeTotals to sMode
        WebSet psValue of oAlertlevel to iAlertLevel
        
        If (sDataSet = "Inventory") Begin
            Set pbRender of oAlertlevel to True
        End
        Else Begin
            Set pbRender of oAlertlevel to False
        End
        
    End_Procedure
    
    Procedure OnGetConfigValues tWidgetConfigPropValue[] ByRef aNewPropValues
        String sDataSet sSortType sMode
        Integer iAlertLevel
        
        WebGet psValue of oSelectDataSet to sDataSet
        WebGet psValue of oSortTypeTop to sSortType
        WebGet psValue of oShowModeTotals to sMode
        WebGet psValue of oAlertlevel to iAlertLevel
        
        Send SetPropValue (&aNewPropValues) "" "psDataSet" sDataSet
        Send SetPropValue (&aNewPropValues) "" "psSortType" sSortType
        Send SetPropValue (&aNewPropValues) "" "psMode" sMode
        Send SetPropValue (&aNewPropValues) "" "piLowInventoryAlertLevel" iAlertLevel 
    End_Procedure
End_Object