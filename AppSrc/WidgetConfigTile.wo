Use cWebModalDialog.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebWidgetConfigurationWizard.pkg

Object oWidgetConfigTile is a cWebWidgetConfigurationWizard
    Set psCaption to "Widget Config | Statistics Tile "
    Set piMinWidth to 500
    Set piMinHeight to 200
    Set pbServerOnSubmit to True
    Set pbFocusFirstOnShow to False
    
    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12
        
        Object oTileTypeRadio1 is a cWebRadio
            Set piColumnSpan to 0
            Set psCaption to "Total revenue"
            Set psRadioValue to "TotalRevenue"
            Set pbServerOnSelect to True
            
            Procedure OnSelect
                WebSet pbRender of oAlertLevel to False
            End_Procedure
        End_Object
        
        Object oTileTypeRadio2 is a cWebRadio
            Set piColumnSpan to 0
            Set psCaption to "Total Order Count"
            Set psRadioValue to "OrderTotals"
            Set pbServerOnSelect to True
            
            Procedure OnSelect
                WebSet pbRender of oAlertLevel to False
            End_Procedure
        End_Object
        
        Object oTileTypeRadio3 is a cWebRadio
            Set piColumnSpan to 0
            Set psCaption to "Low Inventory Product Total"
            Set psRadioValue to "LowInventory"
            Set pbServerOnSelect to True
            
            Procedure OnSelect
                WebSet pbRender of oAlertLevel to True
            End_Procedure
        End_Object
        
        Object oAlertLevel is a cWebForm
            Set piColumnSpan to 0
            Set psLabel to "Alert when stock is below:"
            Set piLabelOffset to 240
            Set pbRender to False
        End_Object
    End_Object 
    
    Object oBottomPanel is a cWebPanel
        Set piColumnCount to 6
        Set peRegion to prBottom

        Object oOkButton is a cWebButton
            Set psCaption to C_$OK
            Set piColumnSpan to 1
            Set piColumnIndex to 4

            Procedure OnClick
                Send Ok
            End_Procedure
        End_Object 

        Object oCancelButton is a cWebButton
            Set psCaption to C_$Cancel
            Set piColumnSpan to 1
            Set piColumnIndex to 5

            Procedure OnClick
                Send Cancel
            End_Procedure
        End_Object 
    End_Object 

    Procedure OnSubmit
        Send Ok
    End_Procedure
    
    Procedure Ok
        //  Do some calculations / saves / validations here ..
        Forward Send Ok
    End_Procedure

    Procedure Cancel
        Forward Send Cancel
    End_Procedure
    
    Procedure OnPopulateWizard tWidgetConfigProp[] aConfigurableProps tWidgetConfigPropValue[] aCurPropValues
        String sTileType
        Integer iLowInventoryAlertLevel
        
        Get GetPropValue aCurPropValues '' "psTileType" to sTileType
        Get GetPropValue aCurPropValues '' "piLowInventoryAlertLevel" to iLowInventoryAlertLevel
        
        WebSet pbRender of oAlertLevel to False
        
        If (sTileType = "") Begin
            Move "OrderEarnings" to sTileType
        End
        Else If (sTileType = "LowInventory") Begin
            WebSet psValue of oAlertLevel to iLowInventoryAlertLevel
            WebSet pbRender of oAlertLevel to True
        End

        WebSet psValue of oTileTypeRadio1 to sTileType
    End_Procedure
    
    Procedure OnGetConfigValues tWidgetConfigPropValue[] ByRef aNewPropValues
        String sTileType sObjectId
        Integer iLowInventoryAlertLevel
        
        WebGet psValue of oTileTypeRadio1 to sTileType
        WebGet psValue of oAlertLevel to iLowInventoryAlertLevel
        
        Send SetPropValue (&aNewPropValues) "" "psTileType" sTileType
        Send SetPropValue (&aNewPropValues) "" "piLowInventoryAlertLevel" iLowInventoryAlertLevel
    End_Procedure
End_Object