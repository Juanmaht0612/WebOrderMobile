Use cWebModalDialog.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebWidgetConfigurationWizard.pkg
Use cWebCombo.pkg
Use cWebSpacer.pkg
Use Classes\cDateTimeHandler.pkg
Use EnumDynamicTimeZoneInformation.h.pkg
Use SystemTimeToTzSpecificLocalTimeEx.h.pkg

Object oWidgetConfigTimezone is a cWebWidgetConfigurationWizard
    Set psCaption to "Widget Config"
    Set piMinWidth to 500
    Set piMinHeight to 200
    Set pbServerOnSubmit to True    // enable the OnSubmit event
    
    Object oMainPanel is a cWebPanel
        Set piColumnCount to 12
        
        Object oTimeZoneCombo is a cWebCombo
            Set psLabel to "Available TimeZones"
            Set peLabelPosition to lpTop
            Set pbServerOnChange to True
            Set piColumnIndex to 0
            Set piColumnSpan to 0
            
            Procedure OnFill
                String[] asTzNames
                Integer iIndex
                
                Get RetrieveAllTimeZoneNames to asTzNames
                
                For iIndex from 0 to ((SizeOfArray(asTzNames)) - 1)
                    Send AddComboItem asTzNames[iIndex] asTzNames[iIndex]
                Loop
            End_Procedure
        End_Object
        
        Object oSpacer is a cWebSpacer
            Set piHeight to 32
        End_Object
        
        Object o12Hour is a cWebRadio
            Set psRadioValue to True
            Set psCaption to "12H Clock"
            Set piColumnSpan to 6
            Set pbShowLabel to True
            Set psLabel to "Use:"
            Set piLabelOffset to 60
        End_Object
        
        Object o24Hour is a cWebRadio
            Set psRadioValue to False
            Set psCaption to "24H Clock"
            Set piColumnSpan to 6
            Set piColumnIndex to 6
        End_Object
    End_Object 
    
    Object oBottomPanel is a cWebPanel
        Set piColumnCount to 6
        Set peRegion to prBottom

        Object oOkButton is a cWebButton
            Set psCaption to C_$OK
            Set piColumnSpan to 1
            Set piColumnIndex to 4

            Procedure OnClick
                Send Ok
            End_Procedure
        End_Object 

        Object oCancelButton is a cWebButton
            Set psCaption to C_$Cancel
            Set piColumnSpan to 1
            Set piColumnIndex to 5

            Procedure OnClick
                Send Cancel
            End_Procedure
        End_Object 
    End_Object 

    Procedure OnSubmit
        Send Ok
    End_Procedure
    
    Procedure Ok
        //  Do some calculations / saves / validations here ..
        Forward Send Ok
    End_Procedure

    Procedure Cancel
        Forward Send Cancel
    End_Procedure

    Procedure OnPopulateWizard tWidgetConfigProp[] aConfigurableProps tWidgetConfigPropValue[] aCurPropValues
        String sTzName
        Boolean bUse12Hour
        
        Get GetPropValue aCurPropValues '' "psTimezoneKey" to sTzName
        Get GetPropValue aCurPropValues '' "pbUse12Hour" to bUse12Hour
        
        If (sTzName = "") Begin
           Move "W. Europe Standard Time" to sTzName
        End
        
        WebSet psValue of oTimeZoneCombo to sTzName
        WebSet psValue of o12Hour to bUse12Hour
    End_Procedure

    Procedure OnGetConfigValues tWidgetConfigPropValue[]  ByRef aNewPropValues
        String sTzName
        Boolean bUse12Hour
        
        WebGet psValue of oTimeZoneCombo to sTzName
        WebGet psValue of o12Hour to bUse12Hour
        
        Send SetPropValue (&aNewPropValues) "" "psTimezoneKey" sTzName
        Send SetPropValue (&aNewPropValues) "" "pbUse12Hour" bUse12Hour
    End_Procedure
        
    Function RetrieveAllTimeZoneNames Returns String[]
        tDynamicTimeZoneInformation tzDynamicInfo
        Integer iIndex iRetval
        String sKeyName
        String[] asTzNames
        
        Move 0 to iIndex
        
        While (iIndex < ERROR_NO_MORE_ITEMS)
            Move (WinAPI_EnumDynamicTimeZoneInformation (iIndex, AddressOf (tzDynamicInfo))) to iRetval
            
            If (iRetval = ERROR_SUCCESS) Begin
                Move (PointerToWString (AddressOf (tzDynamicInfo.TimeZoneKeyName))) to sKeyName
                Move sKeyName to asTzNames[-1]                
            End
            
            Increment iIndex
        Loop
        
        Function_Return asTzNames
    End_Function
End_Object